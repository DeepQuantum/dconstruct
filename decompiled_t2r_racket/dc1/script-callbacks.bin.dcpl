(define (activated-chronological-mode-callback) 
    (spawn-persistent-script "ss-chronological" "ss-chronological-1" unparented)
)

(define (update-player-facts arg_0) 
    (define var_0 (get-object-anim-state arg_0))
    (fact-set arg_0 speed (new-boxed-value 6 (get-object-speed arg_0)))
    (fact-set arg_0 joypad-move-stick-intensity (new-boxed-value 6 (get-joypad-stick-intensity move 0.20 1.00)))
    (fact-set arg_0 anim-state (new-boxed-value 7 var_0))
    (fact-set arg_0 idle^move? (new-boxed-value 1 (&& (|| (|| (|| (|| (|| (|| (== var_0 idle-run-l) (== var_0 idle-run-fl)) (== var_0 idle-run-f)) (== var_0 idle-run-fr)) (== var_0 idle-run-r)) (== var_0 idle-run-bl)) (== var_0 idle-run-b)) (== var_0 idle-run-br))))
    (fact-set arg_0 move^idle? (new-boxed-value 1 (&& (|| (|| (== var_0 run-idle) (== var_0 run-idle-m)) (== var_0 run-idle-short-l)) (== var_0 run-idle-short-r))))
)

(define (deactivated-chronological-mode-callback) 
    (kill-entity ss-chronological-1)
)

