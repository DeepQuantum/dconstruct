                    (say npc-nor-scar-burial-flee-2 vox-igc-scrmb-gam-glt-bridge-mid-001 2 0)
                
                lambda 
                    (wait-for sees-player-grass)
                
                lambda 
                    (send-event player-hides-in-grass ss-vox-glt-bridge-1)
                
            }
            track music {
                lambda 
                    (wait-boolean reached-truck? 1 self)
                
                lambda 
                    (play-music-stinger *music-playlist-e3-under-car-stealth* 0)
                
            }
            track hud {
                lambda 
                    (wait-for in-grass)
                
            }
            track hud-safeguard {
                lambda 
                    (wait-for running-in)
                
            }
        }
        block update {
            track main {
                lambda 
                    (joypad-disable-commands prone-toggle)
                
                lambda 
                    (player-disable-flinches)
                
            }
        }
    }
}
