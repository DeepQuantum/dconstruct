                    (npc-move-to npc-forward-torchman-1 (get-spline-point-locator spl-forward-torchman-1 4) 0 1 0 0 0 0)
                
                lambda 
                    (wait-for second-patrol-prep)
                
                lambda 
                    (let loop () (when (not (signal-raised? second-patrol-whistle 0)) 
                        (npc-look-aim-at-locator npc-forward-torchman-2 (get-spawner-locator pos-torchman-aim-1 1) -1.00 1)
                        (if (not (signal-raised? second-patrol-whistle 0))) 
                            (wait 0.30)
                        
                        (if (not (signal-raised? second-patrol-whistle 0))) 
                            (npc-look-aim-at-locator npc-forward-torchman-2 (get-spawner-locator pos-torchman-aim-2 1) -1.00 1)
                        
                        (if (not (signal-raised? second-patrol-whistle 0))) 
                            (wait 0.30)
                        
                        (if (not (signal-raised? second-patrol-whistle 0))) 
                            (npc-look-aim-at-locator npc-forward-torchman-2 (get-spawner-locator pos-torchman-aim-3 1) -1.00 1)
                        
                        (if (not (signal-raised? second-patrol-whistle 0))) 
                            (wait 0.30)
                        
                        (if (not (signal-raised? second-patrol-whistle 0))) 
                            (npc-look-aim-at-locator npc-forward-torchman-2 (get-spawner-locator pos-torchman-aim-2 1) -1.00 1)
                        
                        (if (not (signal-raised? second-patrol-whistle 0))) 
                            (wait 0.30)
                        
                     (loop)))
                
            }
            track second-torchman-vox {
                lambda 
                    (wait-for second-patrol-whistle)
                
                lambda 
                    (send-event torchman-whistle ss-vox-glt-forest-1)
                
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda 
                    (spawn-entity npc-glt-forest-dead-militia-1 0 0)
                
                lambda 
                    (animate_ npc-glt-forest-dead-militia-1 dead-hanging-body--male (#%alloc-array single-frame 16 0 1))
                
                lambda 
                    (animate_ obj-glt-forest-noose-1 dead-hanging-body--rope (#%alloc-array single-frame 16 0 1))
                
                lambda 
                    (spawn-entity npc-glt-forest-dead-militia-2 0 0)
                
                lambda 
                    (animate_ npc-glt-forest-dead-militia-2 dead-hanging-body-02--male (#%alloc-array single-frame 16 0 1))
                
                lambda 
                    (animate_ obj-glt-forest-noose-2 dead-hanging-body-02--rope (#%alloc-array single-frame 16 0 1))
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
