statescript {
    options {
        player
    }
    state task-check {
        block start {
            track main {
                lambda 
                    (if (task-complete? greenlight glt-stripmall-enter)) 
                        (go already-complete 1)
                    
                
                lambda 
                    (if (task-active? greenlight glt-stripmall-enter)) 
                        (go stripmall 1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-active? greenlight glt-stripmall-enter)) 
                        (go stripmall 1)
                    
                
            }
        }
    }
    state stripmall {
        block update {
            track main {
                lambda 
                    (set-tension-mode 3)
                
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
