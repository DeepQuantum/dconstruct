                    (let loop () (when (and (or (object-anim-reached-fadeout? player (get-symbol exit-anim boat) 0.60 2) (< (get-animation-fade player (get-symbol exit-anim boat)) 1.00)) (not (not (get-animation-playing? player (get-symbol exit-anim boat) 2)))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (send-event exit-anim-done boat)
                
                lambda 
                    (boat-clear-exit-vars)
                
                lambda 
                    (go wait-for-events 1)
                
            }
        }
    }
}
