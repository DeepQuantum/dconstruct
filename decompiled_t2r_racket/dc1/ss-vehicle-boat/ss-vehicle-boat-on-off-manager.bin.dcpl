statescript {
    options {
        player
        boat
    }
    declarations {
        f32 desired-player-wind-force = 0.00
    }
    state --all-- {
        block event enter {
            track main {
                lambda 
                    (if (not (player-in-state? Jump))) 
                        (player-force-shorter-jumps)
                        (player-force-jump-at (get-spawner-position boat-jump-target-1 1))
                        (player-force-shorter-jumps)
                        (wait-one-frame)
                        (let loop () (when (player-in-state? Jump) 
                            (player-force-shorter-jumps)
                            (wait-one-frame)
                         (loop)))
                    
                
            }
        }
        block event player-enter-boat-startup {
            track main {
                lambda 
                    (set-region-enabled rgn-flo-mall-force-jump-to-boat-1 0 0)
                
            }
        }
        block event player-exit-boat-startup {
            track main {
                lambda 
                    (set-region-enabled rgn-flo-mall-force-jump-to-boat-1 1 0)
                
            }
        }
        block event player-enter-boat-driving {
            track main {
                lambda 
                    (set-region-enabled rgn-flo-mall-force-jump-to-boat-1 0 0)
                
            }
        }
    }
    state initial-check {
        block start {
            track main {
                lambda 
                    (if (player-on-boat?)) 
                        (go on-boat 1)
                     else 
                        (go off-boat 1)
                    
                
            }
        }
    }
    state on-boat {
        block start {
            track main {
                lambda 
                    (broadcast-event player-entered-boat)
                
                lambda 
                    (let loop () (when (player-on-boat?) 
                        (wait 0.10)
                     (loop)))
                
                lambda 
                    (go off-boat 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (set-walk-type walk-tense)
                
                lambda 
                    (set-run-type run-tense)
                
                lambda 
                    (set-sprint-type sprint-tense)
                
                lambda 
                    (set-float desired-player-wind-force (curve-scale 1.00 8.00 0.00 -4.00 (boat-get-speed boat) 3) self)
                
                lambda 
                    (set-cloth-wind player 0.00 0.00 (get-float desired-player-wind-force self))
                
                lambda 
                    (if (get-boolean lock-player-in-boat? boat)) 
                        (joypad-disable-commands jump prone-toggle)
                    
                
                lambda 
                    (if (== (get-player-weapon-id) trap-bomb)) 
                        (joypad-disable-commands object-quick-throw object-quick-throw-hold object-throw object-throw-hold)
                    
                
            }
        }
        block event player-climb-jump {
            track main {
                lambda 
                    (define var_5 (alloc-vector (deref (cast f32* (get-joypad-stick-ws move))) (deref (cast f32* (+ (get-joypad-stick-ws move) 4))) (deref (cast f32* (+ (get-joypad-stick-ws move) 8))) 1.00 1))
                    (player-force-move-stick-dir var_5)
                    (joypad-set-stick-scale move 1.00)
                    (wait-one-frame)
                    (let loop () (when (and 1 (< (- (get-current-time 0) (get-current-time 0)) 0.70)) 
                        (player-force-move-stick-dir var_5)
                        (joypad-set-stick-scale move 1.00)
                        (wait-one-frame)
                     (loop)))
                
            }
        }
    }
    state off-boat {
        block start {
            track main {
                lambda 
                    (broadcast-event player-exited-boat)
                
                lambda 
                    (set-float desired-player-wind-force 0.00 self)
                
                lambda 
                    (set-cloth-wind player 0.00 0.00 (get-float desired-player-wind-force self))
                
                lambda 
                    (let loop () (when (not (player-on-boat?)) 
                        (wait 0.10)
                     (loop)))
                
                lambda 
                    (go on-boat 1)
                
            }
        }
    }
}
