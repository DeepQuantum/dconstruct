statescript {
    options {
        player
    }
    declarations {
        timer tut-clear-timer = nullptr
        timer tut-delay-timer = nullptr
        bound-frame boat-starting-distance = nullptr
    }
    state initial {
        block start {
            track main {
                lambda 
                    (if (get-svar-as-boolean boat-drive-tutorial-shown)) 
                        (go done 1)
                    
                
                lambda 
                    (print-symbol (hud-get-current-message-cipher 4) self)
                
                lambda 
                    (if (hud-tutorial-active? 4)) 
                        (let loop () (when (and (== (hud-get-current-message-cipher 4) HUD_FLO_TUTORIAL_BOAT_MID) (not (== (hud-get-current-message-cipher 4) HUD_INTERACTABLE_DRIVE))) 
                            (wait 0.10)
                         (loop)))
                        (hud2-clear-tutorials 0)
                    
                
            }
        }
        block event player-enter-boat-driving {
            track main {
                lambda 
                    (if (not (get-svar-as-boolean boat-drive-tutorial-shown))) 
                        (set-bound-frame boat-starting-distance (get-object-locator boat) self)
                        (if (get-boolean motor-running? boat)) 
                            (start-timer tut-delay-timer 0.50 self 1)
                         else 
                            (start-timer tut-delay-timer 2.00 self 1)
                        
                    
                
            }
        }
        block event player-changed-state {
            track main {
                lambda 
                    (stop-timer tut-delay-timer self)
                
            }
        }
        block event tut-delay-timer {
            track main {
                lambda 
                    (go yeet-yaat-boat-shat 1)
                
            }
        }
    }
    state yeet-yaat-boat-shat {
        block start {
            track main {
                lambda 
                    (mark-tutorial-unlocked-by-cipher-id MENU_TUTORIAL_BOAT_CONTROLS 1)
                
                lambda 
                    (define var_1)
                    (if (is-alternative-boat-controls-enabled?)) 
                        (set! var_1 *stack-boat-driving-alternate*)
                     else 
                        (set! var_1 *stack-boat-driving*)
                    
                    (hud2-play-prompt-stack-tutorial var_1 -1.00 0 0 0)
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (and (and (> (distance-between-locators (get-object-locator boat) (get-bound-frame boat-starting-distance self)) 7.00) (> (boat-get-speed boat) 4.00)) (not (timer-running? tut-clear-timer self)))) 
                        (start-timer tut-clear-timer 5.00 self 1)
                    
                
            }
        }
        block event player-exit-boat-driving {
            track main {
                lambda 
                    (go initial 1)
                
            }
        }
        block event tut-clear-timer {
            track main {
                lambda 
                    (set-svar-as-boolean boat-drive-tutorial-shown 1)
                
                lambda 
                    (go clear-tut 1)
                
            }
        }
    }
    state clear-tut {
        block start {
            track main {
                lambda 
                    (let loop () (when (and (== (hud-get-current-message-cipher 4) HUD_FLO_TUTORIAL_BOAT_MID) (not (== (hud-get-current-message-cipher 4) HUD_INTERACTABLE_DRIVE))) 
                        (wait 0.10)
                     (loop)))
                
                lambda 
                    (hud2-clear-tutorials 0)
                
                lambda 
                    (go done 1)
                
            }
        }
    }
}
