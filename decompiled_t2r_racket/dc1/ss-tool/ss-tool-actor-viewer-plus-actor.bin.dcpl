                                (set-boolean step-through-frame? 1 self)
                                (set-animation-speed (get-symbol actor self) 1.00 2 0)
                            
                            (if (shared-joypad-active? debug-script-hold-right)) 
                                (if (== (get-int32 step-delay? self) (get-int32 step-delay-max? self))) 
                                    (set-int32 step-delay? 0 self)
                                    (set-int32 step-delay-max? 3 self)
                                    (set-boolean step-through-frame? 1 self)
                                    (set-animation-speed (get-symbol actor self) 1.00 2 0)
                                 else 
                                    (++ step-delay? self)
                                
                            
                            (if (shared-joypad-active? debug-script-press-left)) 
                                (if (and (not (get-boolean is-waiting? self)) (== var_1 0.00))) 
                                    (set-int32 step-delay? 0 self)
                                    (set-int32 step-delay-max? 23 self)
                                    (set-boolean step-through-frame? 1 self)
                                    (set-animation-speed (get-symbol actor self) -1.00 2 0)
                                
                            
                            (if (shared-joypad-active? debug-script-hold-left)) 
                                (if (== (get-int32 step-delay? self) (get-int32 step-delay-max? self))) 
                                    (set-int32 step-delay? 0 self)
                                    (set-int32 step-delay-max? 3 self)
                                    (set-boolean step-through-frame? 1 self)
                                    (set! var_5 (set-animation-speed (get-symbol actor self) -1.00 2 0))
                                 else 
                                    (set! var_5 (++ step-delay? self))
                                
                            
                        
                    
                
            }
        }
    }
}
