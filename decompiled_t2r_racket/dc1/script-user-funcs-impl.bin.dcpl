    (alloc-quat (+ (* var_3 (* var_4 var_2)) (* var_0 (* var_1 var_5))) (+ (* var_3 (* var_1 var_2)) (* var_0 (* var_4 var_5))) (- (* var_0 (* var_4 var_2)) (* var_3 (* var_1 var_5))) (- (* var_0 (* var_1 var_2)) (* var_3 (* var_4 var_5))) 0)
)

(define (wait-until-anim-frame arg_0 arg_1 arg_2 arg_3) 
    (define var_1)
    (if (object-spawned? arg_0)) 
        (let loop () (when (not (object-anim-reached-frame? arg_0 arg_1 arg_2 arg_3)) 
            (wait-one-frame)
         (loop)))
        (set! var_1 1)
     else 
        (define var_4 (dc:format "wait-until-anim-frame: %s is not spawned, continuing" (string-debug arg_0)))
        (display var_4 8)
        (display-error var_4)
        (set! var_1 1)
    
    var_1
)

(define (wait-snpc-swap-for-npc arg_0 arg_1 arg_2 arg_3 arg_4 arg_5) 
    (wait-entity-swap arg_0 arg_1 arg_2 arg_3 arg_4 arg_5)
)

