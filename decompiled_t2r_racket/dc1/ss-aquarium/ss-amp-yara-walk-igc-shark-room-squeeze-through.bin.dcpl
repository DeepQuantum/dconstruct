                    (door-disable-systemic-high-contrast-mode-update door-aqu-shark-room-1 1)
                
                lambda 
                    (animate-done obj-amp-shark-room-display-case-1 amp-shark-room-squeeze-through--display-case ap-amp-yara-walk-shark-room-squeeze-through-1 0 0 2)
                
                lambda 
                    (animate-done door-aqu-shark-room-1 amp-shark-room-squeeze-through--door ap-amp-yara-walk-shark-room-squeeze-through-1 0 0 2)
                
                lambda 
                    (if (task-continue-active? amputation amp-yara-walk-alice-fetch default)) 
                        (go yara-scared-idle 1)
                    
                
            }
        }
    }
}
