statescript {
    options {
        player
        yara
        amp-script
    }
    declarations {
        symbol yara-active-explore-rgn = nullptr
        f32 yara-explore-player-dist = 6.00
        bool light-gobo-set-up? = nullptr
    }
    state --all-- {
        block event spawn-rain-gobo-light {
            track main {
                lambda 
                    (if (not (get-boolean light-gobo-set-up? self))) 
                        (spawn-light-process-gobo-particle rt-proj-Shape-2 gobo-drips-amp)
                        (set-boolean light-gobo-set-up? 1 self)
                    
                
            }
        }
    }
    state task-check {
        block start {
            track main {
                lambda 
                    (if (task-complete? amputation amp-levs-missing-a)) 
                        (go complete 1)
                    
                
                lambda 
                    (if (task-range-active? amputation amp-yara-walk-gift-shop amputation amp-levs-missing-a)) 
                        (send-event spawn-rain-gobo-light (get-self-id))
                    
                
                lambda 
                    (if (task-active? amputation amp-yara-walk-gift-shop)) 
                        (if (== default (task-get-active-continue))) 
                            (go upper-floor-wait-for-dropdown 1)
                         else 
                            (go lower-floor-explore 1)
                        
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-active? amputation amp-yara-walk-gift-shop)) 
                        (send-event spawn-rain-gobo-light (get-self-id))
                        (go upper-floor-wait-for-dropdown 1)
                    
                
            }
        }
    }
    state upper-floor-wait-for-dropdown {
        block start {
            track main {
                lambda 
                    (disable-action-pack tap-squeeze-through-488)
                
                lambda 
                    (npc-request-lead-spline yara spl-amp-yara-lead-3 player *amp-yara-slow-walk-lead-settings* 0 0)
                
                lambda 
                    (set-region-enabled rgn-amp-gift-shop-explore-3 0 0)
                
            }
        }
        block event enter {
            track main {
                lambda 
                    (send-event dropdown-started ss-amp-yara-walk-igc-map-1)
                
                lambda 
                    (go yara-to-lower-floor 1)
                
            }
        }
    }
    state yara-to-lower-floor {
        block start {
            track main {
                lambda 
                    (if (not (get-boolean igc-played? ss-amp-yara-walk-igc-map-1))) 
                        (wait 1.00)
                        (stop-animating yara 0 0.80 0 0)
                        (wait-npc-turn-to yara (get-object-position player) 0 0)
                        (wait 2.00)
                    
                
                lambda 
                    (npc-request-explore yara rgn-amp-gift-shop-explore-5 0 *ps-buddy-explore-near-player-prefer-paps-and-caps* (get-float yara-explore-player-dist self) 0 *default-ai-explore-follow-settings* 0)
                
                lambda 
                    (go lower-floor-explore 1)
                
            }
        }
    }
    state lower-floor-explore {
        block start {
            track walk-around {
                lambda 
                    (if (and (task-continue-active? amputation amp-yara-walk-gift-shop lower-floor) (task-continue-active? amputation amp-yara-walk-gift-shop shark-investigate-cine-intro--DEBUG))) 
                        (set-region-enabled rgn-hint-amp-yara-walk-gift-shop-squeezethrough-1 0 0)
                        (enable-action-pack tap-squeeze-through-488 1)
                        (for ([var_3 amp--gift-shop-explore-regions]) 
                            (define var_4)
                            (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 7))) 
                                (set! var_4 (deref (cast u64* var_3)))
                             else (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 5))) 
                                (set! var_4 (deref (cast u64* var_3)))
                             else (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 4))) 
                                (set! var_4 (deref (cast u64* var_3)))
                             else 
                                (set! var_4 0)
                            
                            (if (player-in-region? var_4 2)) 
                                (npc-request-explore yara var_4 0 *ps-buddy-explore-near-player-prefer-paps-and-caps* (get-float yara-explore-player-dist self) 0 *default-ai-explore-follow-settings* 0)
                            
                        )
                    
                
            }
        }
        block event player-examined-shirt {
            track main {
                lambda 
                    (set-region-enabled rgn-amp-gift-shop-explore-3 1 0)
                
                lambda 
                    (npc-request-explore yara rgn-amp-gift-shop-explore-3 0 *ps-buddy-explore-near-player-prefer-paps-and-caps* (get-float yara-explore-player-dist self) 0 *default-ai-explore-follow-settings* 0)
                
            }
        }
        block event enter {
            track main {
                lambda 
                    (if (darray-contains? amp--gift-shop-explore-regions (new-boxed-value 7 (event-arg-symbol 1)))) 
                        (set-symbol yara-active-explore-rgn (event-arg-symbol 1) self)
                        (npc-request-explore yara (get-symbol yara-active-explore-rgn self) 0 *ps-buddy-explore-near-player-prefer-paps-and-caps* (get-float yara-explore-player-dist self) 0 *default-ai-explore-follow-settings* 0)
                    
                
            }
        }
        block event on-set-active-continue {
            track main {
                lambda 
                    (if (task-continue-active? amputation amp-yara-walk-gift-shop lower-floor)) 
                        (send-event turn-off hint-waypoint-amp-gift-shop-squeezethrough-1)
                        (enable-action-pack tap-squeeze-through-488 1)
                    
                
            }
        }
    }
}
