(define (update-ferris-wheel-gondola-haptic) 
    (if (== (get-int32 swing-haptic self) 0)) 
        (set-int32 swing-haptic (play-hfx-id fob-ferris-wheel-swing 0 2) self)
    
    (hfx-continue (get-int32 swing-haptic self))
    (track-ferris-wheel-gondola-speed)
    (hfx-ramp-internal (get-int32 swing-haptic self) 0 0 (alloc-parameter-ramp-internal (* (get-float gondola-speed self) 30.00) 0.00 (/ 256.00 48000.00) 0.00 1 0.00 0) 1)
)

(define (track-ferris-wheel-gondola-speed) 
    (set-float gondola-speed (* (vector-magnitude (get-object-angular-velocity obj-aqu-ferris-wheel-gondola-1)) (get-delta-time)) self)
    (if (and (>= (get-float gondola-speed self) 0.00) (> (get-float gondola-speed self) (* (get-float gondola-speed-prev self) 1.60)))) 
        (set-float gondola-speed (get-float gondola-speed-prev self) self)
    
    (set-float gondola-speed-prev (get-float gondola-speed self) self)
)

