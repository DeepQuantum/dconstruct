                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) (get-spawner-locator cin-fob-aquarium-flashback-1-intro-b-1 1))
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 1 8))))) 28)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 1 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_0) (* 1 8))) 8))) 0.00)
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 2 8))))) 30)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 2 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_0) (* 2 8))) 8))) 1.50)
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 3 8))))) 29)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 3 8))) 8))) 0)
                    (set! (deref (cast u8* (+ (deref (+ (deref var_0) (* 3 8))) 8))) 4)
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 4 8))))) 24)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 4 8))) 8))) 0)
                    (set! (deref (cast i32* (+ (deref (+ (deref var_0) (* 4 8))) 8))) 14)
                    (wait-animate_ player abby=cin-fob-aquarium-flashback-1-intro-b var_0)
                
                lambda 
                    (camera-fade-out-animated 2.00 0)
                
                lambda 
                    (wait-until-anim-fully-faded-out owen owen=cin-fob-aquarium-flashback-1-intro-b=010)
                
                lambda 
                    (task-complete! forward-base fob-aquarium-flashback-1-intro-b)
                
                lambda 
                    (go complete 1)
                
            }
            track audio {
                lambda 
                    (wait-until-cin-maya-frame 74.00 0)
                
                lambda 
                    (play-sound-at-joint sfx-swim-surface player headb 0 0)
                
                lambda 
                    (play-sound-at-joint sfx-water-shed-waist player headb 0 0)
                
            }
            track camera-water-adjust-disable {
                lambda 
                    (let loop () (when (cinematic-playing? cin-fob-aquarium-flashback-1-intro-b) 
                        (disable-camera-adjust-to-water-surface)
                        (wait-one-frame)
                     (loop)))
                
            }
            track haptics {
                lambda 
                    (if (joypad-has-haptics? 2)) 
                        (play-hfx-id exit-water-rumble-settings 0 2)
                    
                
            }
        }
    }
