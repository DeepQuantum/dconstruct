                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 1 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_0) (* 1 8))) 8))) 0.50)
                    (wait-animate_ jesse res-downhill-ellie-car-combat--jesse var_0)
                
                lambda 
                    (set-boolean start-fresh? 0 ss-res-downhill-jesse-controller-1)
                
                lambda 
                    (next-jesse-anim res-downhill-jesse-grab-idle--jesse ap-res-downhill-jesse-grab-1 0)
                
                lambda 
                    (send-event play-car-defend-starting-sound ss-snd-res-downhill-defend-car-1)
                
                lambda 
                    (go complete 1)
                
            }
            track gunshot {
                lambda 
                    (wait-for anim-start)
                
                lambda 
                    (wait-frames 70)
                
                lambda 
                    (wait-spawn-entity npc-res-downhill-car-defend-1 0)
                
                lambda 
                    (npc-unholster-weapon npc-res-downhill-car-defend-1 4 -1.00 0)
                
                lambda 
                    (animate-done npc-res-downhill-car-defend-1 res-downhill-ellie-car-combat--male ap-res-downhill-jesse-car-enter-1 0 0 2)
                
                lambda 
                    (wait-until-anim-frame player res-downhill-ellie-car-combat--ellie 86.00 2)
                
                lambda 
                    (play-music-stinger *music-playlist-res-downhill-glass-shot* 0)
                
                lambda 
                    (send-event spawn-npcs ss-res-downhill-start-npcs-1)
                
                lambda 
                    (send-event mirror-shot ss-res-downhill-truck-partials-1)
                
                lambda 
                    (npc-make-aware-of npc-res-downhill-car-defend-1 player 2 0)
                
                lambda 
                    (fire-weapon-at-target npc-res-downhill-car-defend-1 pos-res-downhill-truck-rearview-1 0 0 0 0)
                
                lambda 
                    (set-all-windshield-cracks 0.10 1)
                
                lambda 
                    (wait 0.30)
                
                lambda 
                    (fire-weapon-at-target npc-res-downhill-car-defend-1 pos-res-downhill-truck-rearview-2 0 0 0 0)
                
                lambda 
                    (wait 0.50)
                
                lambda 
                    (fire-weapon-at-target npc-res-downhill-car-defend-1 pos-res-downhill-truck-rearview-3 0 0 0 0)
                
                lambda 
                    (stop-animating npc-res-downhill-car-defend-1 2 0.00 0 0)
                
            }
            track flashlight {
                lambda 
                    (wait-until-anim-frame player res-downhill-ellie-car-combat--ellie 17.00 2)
                
                lambda 
                    (turn-off-flashlight player 0)
                
            }
            track render-setting {
                lambda 
                    (wait-until-anim-frame player res-downhill-ellie-car-combat--ellie 50.00 2)
                
                lambda 
                    (let loop () (when 1 
                        (override-render-settings *res-rs-res-029-ambshad-qrt* 1.00 -1.00 0 32767 0 1 0 1.00)
                        (override-render-settings *res-rs-res-024-car-contrast* 1.00 -1.00 0 32767 0 1 0 1.00)
                        (override-render-settings *res-rs-res-025-fgdarken* 1.00 -1.00 0 32767 0 1 0 1.00)
                        (wait-one-frame)
                     (loop)))
                
            }
            track vox {
                lambda 
                    (wait-for anim-start)
                
                lambda 
                    (say player vox-igc-ell-igc-res-downhill-ellie-car-combat-001 2 0)
                
                lambda 
                    (wait-say vox-res-downhill-jesse-in-car-fake-1 vox-igc-jes-igc-res-downhill-ellie-car-combat-001 2 0)
                
            }
            track snd-design {
                lambda 
                    (wait-for anim-start)
                
                lambda 
                    (play-sound-at-joint sfx-igc-res-downhill-jesse-car-starting obj-jeep-res-downhill-escape-1 hood_center_a 0 0)
                
                lambda 
                    (wait-until-anim-frame player res-downhill-ellie-car-combat--ellie 16.00 2)
                
                lambda 
                    (play-sound-at-joint sfx-igc-res-downhill-ellie-car-combat-open obj-jeep-res-downhill-escape-1 door_f_r 0 0)
                
            }
            track remove-silencer {
                lambda 
                    (if (get-player-weapon-have-silencer? pistol-beretta)) 
                        (wait-frames 105)
                        (player-instant-unequip-silencer)
                    
                
            }
            track haptics {
                lambda 
                    (if (joypad-has-haptics? 2)) 
                        (wait-until-anim-frame player res-downhill-ellie-car-combat--ellie 86.00 2)
                        (play-hfx-id soft-boom-haptic 0 2)
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (for ([var_1 all-enemy-npcs]) 
                        (define var_2)
                        (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 7))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 5))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else 
                            (set! var_2 0)
                        
                        (npc-suppress-threat-audio var_2)
                    )
                
                lambda 
                    (suppress-spot-player-stinger)
                
                lambda 
                    (hud2-hide-health-ammo/f 0 0)
                
                lambda 
                    (override-render-settings *res-rs-res-025-carlights* 0.50 -1.00 0 32767 0 1 0 1.00)
                
                lambda 
                    (override-render-settings *res-rs-res-029-ssao-off* 0.50 -1.00 0 32767 0 1 0 1.00)
                
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda 
                    (set-all-windshield-cracks 0.10 1)
                
                lambda 
                    (if (spawner-exists? rt-carfire-1Shape-1)) 
                        (turn-off-light rt-carfire-1Shape-1 0)
                    
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
