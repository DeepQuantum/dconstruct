                        (if (< (get-float input-speed self) 1.00)) 
                            (set-float input-speed (+ (get-float input-speed self) 0.00) self)
                        
                     else 
                        (set-float input-speed (- (get-float input-speed self) 0.00) self)
                        (clamp-var input-speed 0.00 1.00 self)
                        (if (> (get-float input-speed self) 0.30)) 
                         else 
                            (set-float filtered-speed 0.30 self)
                            (if (and (and (< (get-float input-speed self) 0.30) (> (get-animation-phase player 2 0) 0.95)) (not (get-boolean requested-exit self)))) 
