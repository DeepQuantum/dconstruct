                        (go end-crank 1)
                    
                
                lambda 
                    (set-animation-speed player (get-float filtered-speed self) 2 0)
                
                lambda 
                    (set-animation-speed obj-orrery-1 (get-float filtered-speed self) 2 0)
                
                lambda 
                    (set-planet-speed (get-float input-speed self))
                
                lambda 
                    (set-animation-speed obj-gravity-table-crank-1 (get-float filtered-speed self) 2 0)
                
                lambda 
                    (if (joypad-has-haptics? 2)) 
                        (hfx-ramp-internal (get-int32 crank-haptic-pid self) 0 0 (alloc-parameter-ramp-internal (* 0.33 (evaluate-point-curve (lookup-symbol *orrery-rumble-curve* point-curve) (get-animation-phase player 2 0))) 0.00 (/ 256.00 48000.00) 0.00 1 0.00 0) 1)
                        (hfx-ramp-internal (get-int32 crank-haptic-pid self) 0 2 (alloc-parameter-ramp-internal (evaluate-point-curve (lookup-symbol *orrery-haptic-pan-curve* point-curve) (get-animation-phase player 2 0)) 0.00 (/ 256.00 48000.00) 0.00 1 0.00 0) 1)
                        (hfx-continue (get-int32 crank-haptic-pid self))
                     else 
                        (rumble (* 0.60 (evaluate-point-curve (lookup-symbol *orrery-rumble-curve* point-curve) (get-animation-phase player 2 0))))
                    
                
            }
        }
