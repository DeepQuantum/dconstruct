        }
        block event player-requested-interact {
            track main {
                lambda 
                    (go (check-museum-interacts (event-arg-symbol 0)) 1)
                
            }
        }
        block event picking-up-hat {
            track main {
                lambda 
                    (go wait-for-event 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (make-player-poi/f 20.00)
                
            }
        }
        block end {
            track main {
                lambda 
                    (debug-shut-off-player-poi)
                
            }
        }
    }
    state wait-optional-convo {
        block start {
            track main {
                lambda 
                    (interactable-adopt-settings joel int-convo-template-1)
                
                lambda 
                    (conversation-interactable-enable joel 1)
                
                lambda 
                    (wait 15.00)
                
                lambda 
                    (conversation-interactable-disable joel)
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
        block event player-requested-interact {
            track main {
                lambda 
                    (conversation-interactable-disable joel)
                
                lambda 
                    (go int-compsognathus-optional-convo 1)
                
            }
        }
        block event player-requested-interact {
            track main {
                lambda 
                    (go (check-museum-interacts (event-arg-symbol 0)) 1)
                
            }
        }
        block end {
            track main {
                lambda 
                    (conversation-interactable-disable joel)
                
                lambda 
                    (interactable-clear-adopted-settings joel)
                
                lambda 
                    (set-boolean is-conversation-happening? 1 self)
                
            }
        }
    }
    state done {
        block start {
            track main {
                lambda 
                    (set-boolean is-conversation-happening? 0 self)
                
            }
        }
    }
}
