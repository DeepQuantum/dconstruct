statescript {
    options {
        player
    }
    declarations {
        i32 num-successive-strikes = 0
        bool momentum-active = nullptr
        symbol npc-attacked-with-momentum = #0000000000000000
    }
    state tracking {
        block start {
            track main {
                lambda 
                    (hud-challenge-update-progress-count 0 2)
                
            }
        }
        block update {
            track main {
                lambda 
                    (set-boolean momentum-active (timer-running? pain-killer-timer ss-pain-killers) self)
                
                lambda 
                    (if (and (get-boolean momentum-active self) (== (get-int32 num-successive-strikes self) 0))) 
                        (send-event momentum-first-strike-complete self)
                    
                
                lambda 
                    (if (and (not (get-boolean momentum-active self)) (== (get-int32 num-successive-strikes self) 1))) 
                        (send-event reset-succesive-strikes self)
                    
                
            }
        }
        block event momentum-first-strike-complete {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EC: Player got first momentum strike") 19)
                    
                
                lambda 
                    (set-int32 num-successive-strikes 1 self)
                
                lambda 
                    (if (and (!= *encounter-tweaks* nullptr) (>= (deref (cast f32* (+ *encounter-tweaks* 88))) 0.00))) 
                        (wait (deref (cast f32* (+ *encounter-tweaks* 88))))
                     else 
                        (wait 0.50)
                    
                
                lambda 
                    (hud-challenge-update-progress-count 1 2)
                
            }
        }
        block event momentum-free-strike-complete {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EC: Player just did successive momentum free strike!") 19)
                    
                
                lambda 
                    (set-int32 num-successive-strikes 2 self)
                
                lambda 
                    (hud-challenge-update-progress-count 2 2)
                
                lambda 
                    (go completed 1)
                
            }
        }
        block event reset-succesive-strikes {
            track main {
                lambda 
                    (wait 0.50)
                
                lambda 
                    (if (== (get-int32 num-successive-strikes self) 1)) 
                        (set-int32 num-successive-strikes 0 self)
                        (hud-challenge-update-progress-count 0 2)
                    
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (send-event challenge-complete ss-challenges-controller-1)
                
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EC: Challenge complete %s" (string-debug (get-self-id))) 19)
                    
                
            }
        }
    }
