                    (menu2-legend-set-button-disabled (get-symbol w-reward-page self) MENU_PROMPT_CONTINUE_BUTTON (not (&& var_2 var_6)))
                    (if (or (and var_2 var_6) (joypad-command-active-and-enabled? continue-button 2))) 
