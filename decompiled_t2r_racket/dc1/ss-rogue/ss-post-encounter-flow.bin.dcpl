                        (define var_6 (menu2-push-message-box hudMenuStack "t2r-meta-challenges/message-box-ok-meta-challenge-unlock" (deref (cast u64* (+ (deref (+ (+ (deref (deref (+ (deref (deref *meta-set*)) (* var_2 72)))) (* var_1 184)) 64)) 16))) (deref (cast u64* (+ (deref (+ (+ (deref (deref (+ (deref (deref *meta-set*)) (* var_2 72)))) (* var_1 184)) 64)) 24))) 0 0 2 1))
                        (post-encounter-flow-set-page-heading var_6 1)
