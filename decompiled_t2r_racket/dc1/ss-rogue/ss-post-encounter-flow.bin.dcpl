                            (if (not (is-final-build?))) 
                                (display (dc:format "DEB-PEF: Meta Back Pressed") 19)
                            
                            (if (and (and (and (get-boolean run-completed-post self) (get-boolean run-failed-post self)) (rogue-is-daily-run)) (rogue-daily-run-score-post-failed?))) 
                                (go show-leaderboard-post-score-failed 1)
                             else 
                                (go show-leaderboard 1)
                            
                        
                     else (if (and (!= (menu2-get-top-page-in-stack hudMenuStack 0) (get-symbol w-meta-update-page self)) (! (get-boolean waiting-for-pause-card? self)))) 
                    
                
                lambda 
                    (if (and (and (joypad-command-active-and-enabled? continue-button 2) (joypad-command-active-and-enabled? continue-button 0)) (get-boolean wait-for-anim self))) 
                        (stop-timer-if-running anim-wait-timer self)
                        (set-boolean wait-for-anim 0 self)
                    
                
                lambda 
                    (if (get-boolean waiting-for-challenge-update-anim self)) 
                        (joypad-disable-commands menu-up-hold menu-down-hold menu-up menu-down menu-stick-up-wide menu-stick-up-hold-wide menu-stick-down-wide menu-stick-down-hold-wide)
                    
                
                lambda 
                    (if (not (get-boolean waiting-for-challenge-update-anim self))) 
                        (joypad-disable-all-commands-except menu-up-hold menu-down-hold menu-up menu-down menu-stick-up-wide menu-stick-up-hold-wide menu-stick-down-wide menu-stick-down-hold-wide)
                    
                
                lambda 
                    (joypad-disable-all-commands-except continue-button menu-back menu-left menu-right menu-stick-left menu-stick-right menu-prev-tab menu-next-tab)
                
                lambda 
                    (disable-inventory)
                
            }
        }
    }
    state show-rewards {
