statescript {
    options {
        player
    }
    declarations {
        i32 current-kill-count = 0
        bool is-holding-breath = nullptr
    }
    state tracking {
        block start {
            track main {
                lambda 
                    (hud-challenge-update-progress-count (get-int32 current-kill-count self) (tag-int32 num-kills-required self))
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (object-spawned? ss-player-hold-breath-aim-controller)) 
                        (if (and (not (get-boolean is-holding-breath self)) (script-in-state? ss-player-hold-breath-aim-controller do-aim-hold-breath))) 
                            (set-boolean is-holding-breath 1 self)
                            (if (not (is-final-build?))) 
                                (display (dc:format "DEB-EC: Player is holding breath") 19)
                            
                        
                        (if (and (get-boolean is-holding-breath self) (not (script-in-state? ss-player-hold-breath-aim-controller do-aim-hold-breath)))) 
                            (send-event reset-is-holding-breath self)
                        
                        (if (not (player-is-aiming?))) 
                            (set-boolean is-holding-breath 0 self)
                        
                    
                
            }
        }
        block event reset-is-holding-breath {
            track main {
                lambda 
                    (wait 0.75)
                
                lambda 
                    (if (and (get-boolean is-holding-breath self) (not (script-in-state? ss-player-hold-breath-aim-controller do-aim-hold-breath)))) 
                        (set-boolean is-holding-breath 0 self)
                        (if (not (is-final-build?))) 
                            (display (dc:format "DEB-EC: Player is no longer holding breath") 19)
                        
                    
                
            }
        }
        block event npc-attacked {
            track main {
                lambda 
                    (define var_1 (event::get-attack-info (get-event)))
                    (define var_2 (event-arg-symbol 1))
                    (get-object-health var_2)
                    (if (and (and (== player (deref (cast u64* (+ var_1 8)))) (darray-contains? rogue-headshot-joint-group (new-boxed-value 7 (event-get-attack-joint)))) (&& (&& (!= (deref (cast i32* (+ var_1 48))) 0) (!= (deref (cast i32* (+ var_1 48))) 4)) (!= (deref (cast i32* (+ var_1 48))) 6)))) 
                        (++ current-kill-count self)
                        (if (not (is-final-build?))) 
                            (display (dc:format "DEB-EC: Player just killed %s with headshot while breath held" (string-debug var_2)) 19)
                        
                        (if (and (!= *encounter-tweaks* nullptr) (>= (deref (cast f32* (+ *encounter-tweaks* 88))) 0.00))) 
                            (wait (deref (cast f32* (+ *encounter-tweaks* 88))))
                         else 
                            (wait 0.50)
                        
                        (hud-challenge-update-progress-count (get-int32 current-kill-count self) (tag-int32 num-kills-required self))
                        (if (>= (get-int32 current-kill-count self) (tag-int32 num-kills-required self))) 
                            (set! var_7 (go completed 1))
                        
                    
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (send-event challenge-complete ss-challenges-controller-1)
                
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EC: Challenge complete %s" (string-debug (get-self-id))) 19)
                    
                
            }
        }
    }
