statescript {
    options {
        player
    }
    declarations {
        f32 speed-multiplier = 1.10
        f32 difficulty-based-speed = 1.10
        bool rubber-banding-enabled? = nullptr
        bool ragdoll-allowed? = true
    }
    state --all-- {
        block event Attack {
            track main {
                lambda 
                    (broadcast-event ratking-attacked)
                
            }
        }
    }
    state task-check {
        block start {
            track main {
                lambda 
                    (if (task-complete? medicine med-hospital-basement-back-rooms)) 
                        (go setup 1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-complete? medicine med-hospital-basement-back-rooms)) 
                        (go setup 1)
                    
                
            }
        }
    }
    state setup {
        block start {
            track main {
                lambda 
                    (set-update-bucket obj-player-death-gore-1 Attach)
                
                lambda 
                    (set-update-bucket obj-player-death-gore-2 Attach)
                
                lambda 
                    (set-update-bucket obj-player-death-gore-3 Attach)
                
                lambda 
                    (set-float difficulty-based-speed (deref (cast f32* (+ (get-difficulty-detail-enemies) 164))) self)
                
                lambda 
                    (wait 0.50)
                
                lambda 
                    (go walk 1)
                
            }
        }
    }
    state walk {
        block update {
            track main {
                lambda 
                    (override-pipe-bomb-detonation-time 0.60)
                
                lambda 
                    (if (get-boolean rubber-banding-enabled? self)) 
                        (npc-set-movement-speed-scale self (get-float speed-multiplier self))
                     else 
                        (npc-set-movement-speed-scale self (get-float difficulty-based-speed self))
                    
                
                lambda 
                    (npc-make-aware-of self player 2 0)
                
                lambda 
                    (if (distance-between-objects-less-than? self player 12.00)) 
                        (melee-fact-set-bool player near-ratking? 1)
                     else 
                        (melee-fact-set-bool player near-ratking? 0)
                    
                
                lambda 
                    (if (and (npc-alive? npc-superstalker-2) (== (get-script-state ss-med-ratking-igc-split-1) complete))) 
                        (if (distance-between-objects-less-than? player npc-superstalker-2 5.00)) 
                            (melee-fact-set-bool npc-ratking-bloater-1 bloater-disable-charge 1)
                         else 
                            (melee-fact-set-bool npc-ratking-bloater-1 bloater-disable-charge 0)
                        
                    
                
                lambda 
                    (if (get-boolean ragdoll-allowed? self)) 
                        (enable-power-ragdoll self *ratking-ragdoll-control-settings* 0.20)
                    
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (melee-fact-remove player near-ratking?)
                
                lambda 
                    (disable-power-ragdoll self 0.00)
                
                lambda 
                    (set-boolean ragdoll-allowed? 0 self)
                
                lambda 
                    (go done 1)
                
            }
        }
    }
}
