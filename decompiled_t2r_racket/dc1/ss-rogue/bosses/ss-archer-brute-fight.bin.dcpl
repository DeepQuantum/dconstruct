                        (if (!= (deref (cast i32* (event::get-attack-info (get-event)))) 4)) 
                            (set! var_4 (set-boolean brute-attacked-while-on-fire? 1 self))
                        
                    
                
                lambda 
                    (go allow-explosive-shot 1)
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (define var_0 (event-arg-symbol 0))
                    (if (== var_0 (get-symbol brute self))) 
                        (if (npc-alive? (get-symbol archer self))) 
                            (hud-boss-reset)
                            (set! var_2 (hud-boss-add-new-bar scar-health-bar-archer 1 HUD_ROGUE_BOSS_ARCHER "hud/rogue/t2r-boss-seraphite-archer.png"))
                         else 
                            (set! var_2 (hud-boss-fade-out))
                        
                     else (if (== var_0 (get-symbol archer self))) 
                        (if (npc-alive? (get-symbol brute self))) 
                            (hud-boss-reset)
                            (set! var_2 (hud-boss-add-new-bar scar-health-bar-brute 1 HUD_ROGUE_BOSS_BRUTE "hud/rogue/t2r-boss-seraphite-brute.png"))
                         else 
                            (set! var_2 (hud-boss-fade-out))
                        
                    
                
            }
        }
    }
    state cleanup {
        block start {
            track main {
                lambda 
                    (npc-set-global-combat-params *default-global-combat-params*)
                
                lambda 
                    (hud-boss-fade-out)
                
                lambda 
                    (go done 1)
                
            }
        }
    }
    state done {
        block start {
            track main {
                lambda 
                    (hud-boss-destroy)
                
            }
        }
    }
}
