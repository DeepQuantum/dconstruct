statescript {
    options {
        player
    }
    declarations {
        u64 fx-handle = nullptr
        f32 fx-radius = 1.00
        f32 dot-radius = 3.00
        bool always-active = nullptr
        f32 base-damage-per-sec = 3.00
        timer damage-tick-timer = nullptr
    }
    state --all-- {
        block update {
            track main {
                lambda 
                    (debug-draw-sphere (get-object-position self) (get-float dot-radius self) 2 0.00 0 1)
                
            }
        }
        block event damage-tick-timer {
            track main {
                lambda 
                    (if (and (not (character-in-struggle? self 16)) (<= (distance-between-objects player self) (get-float dot-radius self)))) 
                        (player-take-melee-damage self (floor (get-float base-damage-per-sec self)) 1 1)
                    
                
                lambda 
                    (start-timer damage-tick-timer 1.00 self 1)
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (stop-timer damage-tick-timer self)
                
            }
        }
    }
    state initial {
        block start {
            track main {
                lambda 
                    (start-timer damage-tick-timer 1.00 self 1)
                
            }
        }
    }
}
