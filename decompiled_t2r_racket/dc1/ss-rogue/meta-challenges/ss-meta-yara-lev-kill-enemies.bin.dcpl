statescript {
    options {
        player
    }
    declarations {
        i32 kills-required = 8
    }
    state tracking {
        block start {
            track main {
                lambda 
                    (if (and (== (get-svar encounter-depth) 0) (rogue-player-in-hub?))) 
                        (set-svar meta-yara-lev-kills-count 0)
                    
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (if (== (event-arg-symbol 1) lev)) 
                        (increment-svar meta-yara-lev-kills-count 1)
                        (t2r-meta-trial-updates-add meta-yara-lev-kill-enemies)
                        (if (>= (get-svar meta-yara-lev-kills-count) (get-int32 kills-required self))) 
                            (go completed 1)
                        
                    
                
            }
        }
        block event force-meta-complete {
            track main {
                lambda 
                    (go completed 1)
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (if (print-meta-debug)) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "Buddy Lev gets 8 kills in one run") 19)
                        
                        (debug-draw-string-2d (alloc-point 315.00 400.00 0.00 0) "Challenge Completed" 7 5.00 4.00 1 0 0 1.00)
                    
                
                lambda 
                    (request-meta-complete-notification meta-yara-lev-kill-enemies)
                
                lambda 
                    (log-event "meta trial complete" 0 "lev kill enemies" 0 0)
                
                lambda 
                    (set-svar-as-boolean meta-yara-lev-kill-enemies 1)
                
                lambda 
                    (set-svar-as-boolean player-skins-yara-player-walk-zipped 1)
                
                lambda 
                    (t2r-meta-trial-updates-add meta-yara-lev-kill-enemies)
                
                lambda 
                    (kill-entity self)
                
            }
        }
    }
}
