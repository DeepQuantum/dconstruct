statescript {
    options {
        player
    }
    state wait-for-bill {
        block start {
            track main {
                lambda 
                    (if (== (rogue-get-player-character) 11)) 
                        (go tracking 1)
                    
                
            }
        }
    }
    state tracking {
        block event dead-drop-deposited {
            track main {
                lambda 
                    (increment-svar meta-dead-drop-complete-for-bill-skin-count 1)
                
                lambda 
                    (t2r-meta-trial-updates-add meta-dead-drop-complete-for-bill-skin)
                
                lambda 
                    (if (>= (get-svar meta-dead-drop-complete-for-bill-skin-count) 3)) 
                        (go completed 1)
                    
                
            }
        }
        block event rogue-run-complete {
            track main {
                lambda 
                    (set-svar meta-dead-drop-complete-for-bill-skin-count 0)
                
            }
        }
        block event run-failed-disable-win {
            track main {
                lambda 
                    (set-svar meta-dead-drop-complete-for-bill-skin-count 0)
                
            }
        }
        block event force-meta-complete {
            track main {
                lambda 
                    (go completed 1)
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (if (print-meta-debug)) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "Part 1 Unlock Bill ALT Skin Trial Complete") 19)
                        
                        (debug-draw-string-2d (alloc-point 315.00 400.00 0.00 0) "Challenge Completed" 7 5.00 4.00 1 0 0 1.00)
                    
                
                lambda 
                    (request-meta-complete-notification meta-dead-drop-complete-for-bill-skin)
                
                lambda 
                    (log-event "meta trial complete" 0 "part 1 bill skin unlock" 0 0)
                
                lambda 
                    (set-svar-as-boolean meta-dead-drop-complete-for-bill-skin 1)
                
                lambda 
                    (set-svar-as-boolean player-skins-bill-alt-1 1)
                
                lambda 
                    (increment-svar meta-num-skins-unlocked 1)
                
                lambda 
                    (t2r-meta-trial-updates-add meta-dead-drop-complete-for-bill-skin)
                
                lambda 
                    (set-stat-gte trophy-rogue-complete-part-i 1)
                
                lambda 
                    (kill-entity self)
                
            }
        }
    }
}
