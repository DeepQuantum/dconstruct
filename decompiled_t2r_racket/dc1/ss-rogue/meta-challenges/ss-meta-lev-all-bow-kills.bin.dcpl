statescript {
    options {
        player
    }
    declarations {
        bool encounter-all-bow-kill = true
        i32 bow-kills = 0
    }
    state tracking {
        block event npc-died {
            track main {
                lambda 
                    (if (and (and (== (event-arg-symbol 1) player) (!= (event-arg-symbol 2) bow-ellie)) (!= (event-arg-symbol 2) crossbow))) 
                        (set-boolean encounter-all-bow-kill 0 self)
                     else (if (and (or (== (event-arg-symbol 1) player) (== (event-arg-symbol 2) bow-ellie)) (== (event-arg-symbol 2) crossbow))) 
                        (set-int32 bow-kills (+ (get-int32 bow-kills self) 1) self)
                    
                
            }
        }
        block event encounter-combat-complete {
            track main {
                lambda 
                    (if (and (get-boolean encounter-all-bow-kill self) (> (get-int32 bow-kills self) 0))) 
                        (go completed 1)
                    
                
            }
        }
        block event force-meta-complete {
            track main {
                lambda 
                    (go completed 1)
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (if (print-meta-debug)) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "Lev Complete an encounter with all bow kills Trial Complete") 19)
                        
                        (debug-draw-string-2d (alloc-point 315.00 400.00 0.00 0) "Challenge Completed" 7 5.00 4.00 1 0 0 1.00)
                    
                
                lambda 
                    (request-meta-complete-notification meta-lev-all-bow-kills)
                
                lambda 
                    (log-event "meta trial complete" 0 "lev all bow kills" 0 0)
                
                lambda 
                    (broadcast-event meta-challenge-complete-abby)
                
                lambda 
                    (set-svar-as-boolean meta-lev-all-bow-kills 1)
                
                lambda 
                    (set-svar-as-boolean player-skins-lev-player-abby-jacket 1)
                
                lambda 
                    (increment-svar meta-num-skins-unlocked 1)
                
                lambda 
                    (t2r-meta-trial-updates-add meta-lev-all-bow-kills)
                
                lambda 
                    (set-stat-bit trophy-complete-abby-faction-tracks 1)
                
                lambda 
                    (kill-entity self)
                
            }
        }
    }
}
