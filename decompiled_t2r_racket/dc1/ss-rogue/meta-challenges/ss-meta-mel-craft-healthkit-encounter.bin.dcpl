statescript {
    options {
        player
    }
    declarations {
        i32 healthkit-craft-count = 0
        i32 healthkit-craft-required = 4
    }
    state tracking {
        block event player-craft-item {
            track main {
                lambda 
                    (define var_0 (event-arg-symbol 0))
                    (lookup-recipe-output-amount (item-id-to-recipe-id var_0))
                    (if (== var_0 health-kit)) 
                        (+=i healthkit-craft-count 1 self)
                        (if (>= (get-int32 healthkit-craft-count self) (get-int32 healthkit-craft-required self))) 
                            (set! var_2 (go completed 1))
                        
                    
                
            }
        }
        block event force-meta-complete {
            track main {
                lambda 
                    (go completed 1)
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (if (print-meta-debug)) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "Mel Craft 4 health kits in one encounter trial completed") 19)
                        
                        (debug-draw-string-2d (alloc-point 315.00 400.00 0.00 0) "Challenge Completed" 7 5.00 4.00 1 0 0 1.00)
                    
                
                lambda 
                    (request-meta-complete-notification meta-mel-craft-healthkit-encounter)
                
                lambda 
                    (log-event "meta trial complete" 0 "mel craft healthkit encounter" 0 0)
                
                lambda 
                    (set-svar-as-boolean meta-mel-craft-healthkit-encounter 1)
                
                lambda 
                    (t2r-meta-trial-updates-add meta-mel-craft-healthkit-encounter)
                
                lambda 
                    (kill-entity self)
                
            }
        }
    }
}
