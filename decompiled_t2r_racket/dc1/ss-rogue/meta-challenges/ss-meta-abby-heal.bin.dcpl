statescript {
    options {
        player
    }
    declarations {
        i32 encounter-heal-count = 0
    }
    state tracking {
        block event character-healed {
            track main {
                lambda 
                    (+=i encounter-heal-count (event-arg-int32 0) self)
                
                lambda 
                    (if (>= (get-int32 encounter-heal-count self) 50)) 
                        (go completed 1)
                    
                
            }
        }
        block event rogue-encounter-complete {
            track main {
                lambda 
                    (if (>= (get-int32 encounter-heal-count self) 50)) 
                        (go completed 1)
                    
                
            }
        }
        block event run-complete {
            track main {
                lambda 
                    (if (>= (get-int32 encounter-heal-count self) 50)) 
                        (go completed 1)
                    
                
            }
        }
        block event force-meta-complete {
            track main {
                lambda 
                    (go completed 1)
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (if (print-meta-debug)) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "Abby Heal Trial Complete") 19)
                        
                        (debug-draw-string-2d (alloc-point 315.00 400.00 0.00 0) "Challenge Completed" 7 5.00 4.00 1 0 0 1.00)
                    
                
                lambda 
                    (request-meta-complete-notification meta-abby-heal)
                
                lambda 
                    (log-event "meta trial complete" 0 "abby heal" 0 0)
                
                lambda 
                    (broadcast-event meta-challenge-complete-abby)
                
                lambda 
                    (set-svar-as-boolean meta-abby-heal 1)
                
                lambda 
                    (set-svar-as-boolean player-skins-abby-nd 1)
                
                lambda 
                    (increment-svar meta-num-skins-unlocked 1)
                
                lambda 
                    (t2r-meta-trial-updates-add meta-abby-heal)
                
                lambda 
                    (kill-entity self)
                
            }
        }
    }
}
