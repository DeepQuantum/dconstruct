statescript {
    options {
        player
    }
    declarations {
        i32 healthkit-craft-required = 8
    }
    state tracking {
        block start {
            track main {
                lambda 
                    (if (and (== (get-svar encounter-depth) 0) (rogue-player-in-hub?))) 
                        (set-svar meta-mel-healthkit-craft-count 0)
                    
                
            }
        }
        block event player-craft-item {
            track main {
                lambda 
                    (define var_0 (event-arg-symbol 0))
                    (if (== var_0 health-kit)) 
                        (increment-svar meta-mel-healthkit-craft-count (lookup-recipe-output-amount (item-id-to-recipe-id var_0)))
                        (t2r-meta-trial-updates-add meta-mel-craft-healthkit-run)
                        (if (>= (get-svar meta-mel-healthkit-craft-count) (get-int32 healthkit-craft-required self))) 
                            (set! var_3 (go completed 1))
                        
                    
                
            }
        }
        block event force-meta-complete {
            track main {
                lambda 
                    (go completed 1)
                
            }
        }
        block event rogue-run-complete {
            track main {
                lambda 
                    (set-svar meta-mel-healthkit-craft-count 0)
                
            }
        }
        block event run-failed-disable-win {
            track main {
                lambda 
                    (set-svar meta-mel-healthkit-craft-count 0)
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (if (print-meta-debug)) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "Mel Craft 8 health kits in a run trial complete") 19)
                        
                        (debug-draw-string-2d (alloc-point 315.00 400.00 0.00 0) "Challenge Completed" 7 5.00 4.00 1 0 0 1.00)
                    
                
                lambda 
                    (request-meta-complete-notification meta-mel-craft-healthkit-run)
                
                lambda 
                    (log-event "meta trial complete" 0 "mel craft healthkit run" 0 0)
                
                lambda 
                    (broadcast-event meta-challenge-complete-abby)
                
                lambda 
                    (set-svar-as-boolean meta-mel-craft-healthkit-run 1)
                
                lambda 
                    (set-svar-as-boolean player-skins-mel-player-aquarium 1)
                
                lambda 
                    (increment-svar meta-num-skins-unlocked 1)
                
                lambda 
                    (t2r-meta-trial-updates-add meta-mel-craft-healthkit-run)
                
                lambda 
                    (kill-entity self)
                
            }
        }
    }
}
