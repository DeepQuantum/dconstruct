statescript {
    options {
        player
    }
    state tracking {
        block event dead-drop-deposited {
            track main {
                lambda 
                    (increment-svar meta-dead-drop-complete-for-bill-count 1)
                
                lambda 
                    (t2r-meta-trial-updates-add meta-dead-drop-complete-for-bill)
                
                lambda 
                    (if (>= (get-svar meta-dead-drop-complete-for-bill-count) 3)) 
                        (go completed 1)
                    
                
            }
        }
        block event force-meta-complete {
            track main {
                lambda 
                    (go completed 1)
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (if (print-meta-debug)) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "Part 1 Unlock Bill Trial Complete") 19)
                        
                        (debug-draw-string-2d (alloc-point 315.00 400.00 0.00 0) "Challenge Completed" 7 5.00 4.00 1 0 0 1.00)
                    
                
                lambda 
                    (request-meta-complete-notification meta-dead-drop-complete-for-bill)
                
                lambda 
                    (log-event "meta trial complete" 0 "part 1 bill unlock" 0 0)
                
                lambda 
                    (set-svar-as-boolean meta-dead-drop-complete-for-bill 1)
                
                lambda 
                    (player-unlock-character bill 1)
                
                lambda 
                    (t2r-meta-trial-updates-add meta-dead-drop-complete-for-bill)
                
                lambda 
                    (kill-entity self)
                
            }
        }
    }
}
