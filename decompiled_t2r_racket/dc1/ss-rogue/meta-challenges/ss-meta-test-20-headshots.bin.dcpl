statescript {
    options {
        player
    }
    declarations {
        i32 current-headshot-count = 0
    }
    state tracking {
        block update {
            track main {
                lambda 
                    (if (>= (get-int32 current-headshot-count self) (tag-int32 num-headshots-needed self))) 
                        (go completed 1)
                    
                
            }
        }
        block event npc-attacked {
            track main {
                lambda 
                    (define var_1 (event::get-attack-info (get-event)))
                    (event-arg-symbol 1)
                    (if (and (and (== player (deref (cast u64* (+ var_1 8)))) (deref (cast u8* (+ var_1 98)))) (&& (&& (!= (deref (cast i32* (+ var_1 48))) 0) (!= (deref (cast i32* (+ var_1 48))) 4)) (!= (deref (cast i32* (+ var_1 48))) 6)))) 
                        (set! var_3 (++ current-headshot-count self))
                    
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "META Challenge Complete") 19)
                    
                
                lambda 
                    (kill-entity self)
                
            }
        }
    }
}
