statescript {
    options {
        player
    }
    state tracking {
        block start {
            track main {
                lambda 
                    (if (and (== (get-svar encounter-depth) 0) (rogue-player-in-hub?))) 
                        (set-svar meta-bomb-arrow-kills-count 0)
                    
                
            }
        }
        block event npc-attacked {
            track main {
                lambda 
                    (if (event-attack-source? player)) 
                        (define var_2 (event::get-attack-info (get-event)))
                        (define var_3 (event-arg-symbol 1))
                        (print-symbol (deref (cast u64* (+ var_2 72))) self)
                        (print-boolean (npc-alive? var_3) self)
                        (if (and (and (not (npc-alive? var_3)) (== (deref (cast u64* (+ var_2 72))) bow-ellie)) (== (deref (cast i32* var_2)) 2))) 
                            (set-svar meta-bomb-arrow-kills-count (+ (get-svar meta-bomb-arrow-kills-count) 1))
                            (t2r-meta-trial-updates-add meta-lev-bomb-arrow-kills)
                            (if (>= (get-svar meta-bomb-arrow-kills-count) 7)) 
                                (set! var_7 (go completed 1))
                            
                        
                    
                
            }
        }
        block event force-meta-complete {
            track main {
                lambda 
                    (go completed 1)
                
            }
        }
        block event rogue-run-complete {
            track main {
                lambda 
                    (set-svar meta-bomb-arrow-kills-count 0)
                
            }
        }
        block event run-failed-disable-win {
            track main {
                lambda 
                    (set-svar meta-bomb-arrow-kills-count 0)
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (if (print-meta-debug)) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "Lev 7 kills with bomb arrows in one run Trial Complete") 19)
                        
                        (debug-draw-string-2d (alloc-point 315.00 400.00 0.00 0) "Challenge Completed" 7 5.00 4.00 1 0 0 1.00)
                    
                
                lambda 
                    (request-meta-complete-notification meta-lev-bomb-arrow-kills)
                
                lambda 
                    (log-event "meta trial complete" 0 "lev bomb arrow kills" 0 0)
                
                lambda 
                    (broadcast-event meta-challenge-complete-abby)
                
                lambda 
                    (set-svar-as-boolean meta-lev-bomb-arrow-kills 1)
                
                lambda 
                    (set-svar-as-boolean player-skins-lev-player-santa-barbara 1)
                
                lambda 
                    (increment-svar meta-num-skins-unlocked 1)
                
                lambda 
                    (t2r-meta-trial-updates-add meta-lev-bomb-arrow-kills)
                
                lambda 
                    (kill-entity self)
                
            }
        }
    }
}
