statescript {
    options {
        player
    }
    state tracking {
        block event vendor-purchase {
            track main {
                lambda 
                    (define var_1)
                    (if (is-player-ellie? player)) 
                        (set! var_1 *vendor-book-ellie*)
                     else 
                        (set! var_1 *vendor-book-abby*)
                    
                    (if (!= (deref (cast i32* (+ (+ (deref (deref (+ (+ (deref var_1) (* (event-arg-int32 1) 32)) 24))) (* (event-arg-int32 0) 152)) 32))) 9)) 
                        (increment-svar meta-jesse-num-items-purchased 1)
                        (t2r-meta-trial-updates-add meta-jesse-purchase-items)
                        (if (not (is-final-build?))) 
                            (display (dc:format "purchased item") 19)
                        
                        (if (not (is-final-build?))) 
                            (display (dc:format (int-to-string (get-svar meta-jesse-num-items-purchased))) 19)
                        
                        (if (== (get-svar meta-jesse-num-items-purchased) 10)) 
                            (set! var_4 (go completed 1))
                        
                    
                
            }
        }
        block event force-meta-complete {
            track main {
                lambda 
                    (go completed 1)
                
            }
        }
        block event rogue-run-complete {
            track main {
                lambda 
                    (set-svar meta-jesse-num-items-purchased 0)
                
            }
        }
        block event run-failed-disable-win {
            track main {
                lambda 
                    (set-svar meta-jesse-num-items-purchased 0)
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (if (print-meta-debug)) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "Jesse purchase 15 items Trial Complete") 19)
                        
                        (debug-draw-string-2d (alloc-point 315.00 400.00 0.00 0) "Challenge Completed" 7 5.00 4.00 1 0 0 1.00)
                    
                
                lambda 
                    (request-meta-complete-notification meta-jesse-purchase-items)
                
                lambda 
                    (log-event "meta trial complete" 0 "jesse purchase items" 0 0)
                
                lambda 
                    (broadcast-event meta-challenge-complete-ellie)
                
                lambda 
                    (set-svar-as-boolean meta-jesse-purchase-items 1)
                
                lambda 
                    (set-svar-as-boolean player-skins-jesse-festival 1)
                
                lambda 
                    (increment-svar meta-num-skins-unlocked 1)
                
                lambda 
                    (t2r-meta-trial-updates-add meta-jesse-purchase-items)
                
                lambda 
                    (kill-entity self)
                
            }
        }
    }
