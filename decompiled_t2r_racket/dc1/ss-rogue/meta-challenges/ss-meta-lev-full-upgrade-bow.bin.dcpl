statescript {
    options {
        player
    }
    state tracking {
        block start {
            track main {
                lambda 
                    (let loop () (when 1 
                        (if (player-has-all-available-upgrades? bow-ellie)) 
                            (go completed 1)
                        
                        (wait 0.10)
                     (loop)))
                
            }
        }
        block event force-meta-complete {
            track main {
                lambda 
                    (go completed 1)
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (if (print-meta-debug)) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "Lev Fully upgrade the bow Trial Complete") 19)
                        
                        (debug-draw-string-2d (alloc-point 315.00 400.00 0.00 0) "Challenge Completed" 7 5.00 4.00 1 0 0 1.00)
                    
                
                lambda 
                    (request-meta-complete-notification meta-lev-full-upgrade-bow)
                
                lambda 
                    (log-event "meta trial complete" 0 "lev full upgrade bow" 0 0)
                
                lambda 
                    (set-svar-as-boolean meta-lev-full-upgrade-bow 1)
                
                lambda 
                    (t2r-meta-trial-updates-add meta-lev-full-upgrade-bow)
                
                lambda 
                    (kill-entity self)
                
            }
        }
    }
