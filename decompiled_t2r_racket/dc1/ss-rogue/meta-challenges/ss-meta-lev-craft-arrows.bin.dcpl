statescript {
    options {
        player
    }
    state tracking {
        block start {
            track main {
                lambda 
                    (if (and (== (get-svar encounter-depth) 0) (rogue-player-in-hub?))) 
                        (set-svar meta-arrow-craft-count 0)
                    
                
            }
        }
        block event player-craft-item {
            track main {
                lambda 
                    (define var_0 (event-arg-symbol 0))
                    (increment-svar meta-arrow-craft-count (lookup-recipe-output-amount (item-id-to-recipe-id var_0)))
                    (t2r-meta-trial-updates-add meta-lev-craft-arrows)
                    (if (and (and (== var_0 ammo-arrow-explosive) (== var_0 ammo-arrow)) (>= (get-svar meta-arrow-craft-count) 20))) 
                        (set! var_4 (go completed 1))
                    
                
            }
        }
        block event force-meta-complete {
            track main {
                lambda 
                    (go completed 1)
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (if (print-meta-debug)) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "Lev Craft 20 arrows of any type in one run") 19)
                        
                        (debug-draw-string-2d (alloc-point 315.00 400.00 0.00 0) "Challenge Completed" 7 5.00 4.00 1 0 0 1.00)
                    
                
                lambda 
                    (request-meta-complete-notification meta-lev-craft-arrows)
                
                lambda 
                    (log-event "meta trial complete" 0 "lev craft arrows" 0 0)
                
                lambda 
                    (broadcast-event meta-challenge-complete-abby)
                
                lambda 
                    (set-svar-as-boolean meta-lev-craft-arrows 1)
                
                lambda 
                    (set-svar-as-boolean player-skins-lev-player-white-shirt 1)
                
                lambda 
                    (increment-svar meta-num-skins-unlocked 1)
                
                lambda 
                    (t2r-meta-trial-updates-add meta-lev-craft-arrows)
                
                lambda 
                    (kill-entity self)
                
            }
        }
    }
}
