                        (if (not (is-final-build?))) 
                            (display (dc:format "DEB-SK: Mirror not active, enabling...") 19)
                        
                        (net-set-mirror-mode-enabled 1)
                        (toggle-mirror-mode)
                    
                
            }
        }
        block end {
            track main {
                lambda 
                    (if (is-mirror-enabled?)) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "DEB-SK: [on] Mirror active, disabling...") 19)
                        
                        (net-set-mirror-mode-enabled 0)
                    
                
            }
        }
    }
    state --script-- {
        block end {
            track main {
                lambda 
                    (if (is-mirror-enabled?)) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "DEB-SK: [--script--] Mirror active, disabling...") 19)
                        
                        (net-set-mirror-mode-enabled 0)
                    
                
            }
        }
    }
