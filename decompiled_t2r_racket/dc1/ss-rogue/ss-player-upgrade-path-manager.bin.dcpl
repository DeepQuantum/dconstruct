statescript {
    options {
        player
    }
    declarations {
        i32 selection-index = 0
    }
    state wait-for-display {
        block event display-upgrade-path-selection {
            track main {
                lambda 
                    (set-int32 selection-index 0 self)
                
                lambda 
                    (populate-paths-obtained)
                
                lambda 
                    (populate-paths-available 3)
                
                lambda 
                    (if (and (> (darray-count paths-available) 0) (< (darray-count paths-obtained) 5))) 
                        (go display 1)
                    
                
            }
        }
    }
    state display {
        block update {
            track main {
                lambda 
                    (joypad-disable-all-commands-except debug-script-press-right debug-script-press-left debug-script-press-up debug-script-press-down debug-script-press-x)
                
                lambda 
                    (display-paths-available (get-int32 selection-index self))
                
                lambda 
                    (if (joypad-command-active? debug-script-press-right 6)) 
                        (if (>= (+ (get-int32 selection-index self) 1) (darray-count paths-available))) 
                            (set-int32 selection-index 0 self)
                         else 
                            (+=i selection-index 1 self)
                        
                    
                
                lambda 
                    (if (joypad-command-active? debug-script-press-left 6)) 
                        (if (< (- (get-int32 selection-index self) 1) 0)) 
                            (set-int32 selection-index (- (darray-count paths-available) 1) self)
                         else 
                            (-=i selection-index 1 self)
                        
                    
                
                lambda 
                    (if (joypad-command-active? debug-script-press-x 6)) 
                        (go give-item 1)
                    
                
            }
        }
    }
    state give-item {
        block start {
            track main {
                lambda 
                    (define var_1 (darray-at paths-available (get-int32 selection-index self)))
                    (define var_2)
                    (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 7))) 
                        (set! var_2 (deref (cast u64* var_1)))
                     else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 5))) 
                        (set! var_2 (deref (cast u64* var_1)))
                     else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                        (set! var_2 (deref (cast u64* var_1)))
                     else 
                        (set! var_2 0)
                    
                    (define var_3 (ddict-get paths-manuals var_2))
                    (define var_4)
                    (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 7))) 
                        (set! var_4 (deref (cast u64* var_3)))
                     else (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 5))) 
                        (set! var_4 (deref (cast u64* var_3)))
                     else (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 4))) 
                        (set! var_4 (deref (cast u64* var_3)))
                     else 
                        (set! var_4 0)
                    
                    (player-inventory-add-item-quantity var_4 1)
                
                lambda 
                    (if (not (is-final-build?))) 
                        (define var_2 (darray-at paths-available (get-int32 selection-index self)))
                        (define var_3)
                        (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 7))) 
                            (set! var_3 (deref (cast u64* var_2)))
                         else (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 5))) 
                            (set! var_3 (deref (cast u64* var_2)))
                         else (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 4))) 
                            (set! var_3 (deref (cast u64* var_2)))
                         else 
                            (set! var_3 0)
                        
                        (define var_4 (ddict-get paths-manuals var_3))
                        (define var_5)
                        (if (and var_4 (== (deref (cast u16* (+ var_4 12))) 7))) 
                            (set! var_5 (deref (cast u64* var_4)))
                         else (if (and var_4 (== (deref (cast u16* (+ var_4 12))) 5))) 
                            (set! var_5 (deref (cast u64* var_4)))
                         else (if (and var_4 (== (deref (cast u16* (+ var_4 12))) 4))) 
                            (set! var_5 (deref (cast u64* var_4)))
                         else 
                            (set! var_5 0)
                        
                        (display (dc:format "ITEM GIVEN: %s" (string-debug var_5)) 19)
                    
                
                lambda 
                    (populate-paths-obtained)
                
                lambda 
                    (broadcast-event player-upgrade-path-selected)
                
                lambda 
                    (go wait-for-display 1)
                
            }
        }
    }
}
