        (set! var_112 var_149)
     else 
        (set! var_112 0)
    
    var_112
)

statescript {
    options {
        player
    }
    declarations {
        f32 picked-item-probability = 0.30
        bool ready-for-deposit = nullptr
        bool items-deposited = nullptr
        i32 num-dead-drops-deposited-this-run = 0
        i32 deposit-item-count = 2
        symbol deposit-item-type = none
        symbol deposit-item-group-name = none
        symbol reward-item-type = none
        symbol reward-item-group-name = none
        symbol current-reward-weapon = none
        symbol current-reward-recipe = none
        symbol deposit-spawner = int-dead-drop-deposit-1
        bool player-has-deposit-items = nullptr
        symbol reward-weapon-name = none
        symbol recipe-spawner = none
        symbol chosen-weapon = nullptr
        i32 ammo-amount = nullptr
    }
    state --all-- {
        block event designer-menu-changed {
            track main {
                lambda 
                    (if (and (!= *encounter-tweaks* nullptr) (deref (cast u8* (+ *encounter-tweaks* 142))))) 
                        (set! (deref (cast u8* (+ *encounter-tweaks* 142))) 0)
                        (pick-deposit-item)
                        (check-and-swap-stun-smoke-bomb)
                    
                
                lambda 
                    (if (and (!= *encounter-tweaks* nullptr) (deref (cast u8* (+ *encounter-tweaks* 143))))) 
                        (set! (deref (cast u8* (+ *encounter-tweaks* 143))) 0)
                        (darray-clear (get-symbol grp-dead-drop-recipes-appeared ss-rogue-run-1))
                    
                
            }
        }
    }
    state initial {
        block start {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-DD: %i - %i" (get-svar encounter-depth) (% (get-svar encounter-depth) 2)) 19)
                    
                
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-DD: DEAD DROP DEFICIT %i" (get-svar dead-drop-deficit)) 19)
                    
                
                lambda 
                    (set-int32 num-dead-drops-deposited-this-run (get-svar num-dead-drops-deposited-this-run) self)
                
                lambda 
                    (if (rogue-player-in-hub?)) 
                        (go collect-reward 1)
                    
                
                lambda 
                    (if (and (== (get-svar encounter-depth) 0) (== (rogue-get-player-character) 8))) 
                        (increment-svar dead-drop-deficit 1)
                        (if (not (is-final-build?))) 
                            (display (dc:format "DEB-DD: PLAYER MANNY DISABLING 1ST DEAD DROP...DEAD DROP DEFICIT INCREASED %i" (get-svar dead-drop-deficit)) 19)
                        
                        (go complete 1)
                     else (if (and (== (% (get-svar encounter-depth) 2) 1) (== (rogue-get-player-character) 11))) 
                        (define var_7 (get-svar encounter-index))
                        (define var_8 (run--get-connected-indices-at-index var_7))
                        (define var_10)
                        (if (== (darray-count var_8) 1)) 
                            (define var_11 (darray-at var_8 0))
                            (define var_12)
                            (if (and var_11 (== (deref (cast u16* (+ var_11 12))) 1))) 
                                (set! var_12 (deref (cast u8* var_11)))
                             else (if (and var_11 (== (deref (cast u16* (+ var_11 12))) 2))) 
                                (set! var_12 (deref (cast i32* var_11)))
                             else (if (and var_11 (== (deref (cast u16* (+ var_11 12))) 3))) 
                                (set! var_12 (deref (cast u32* var_11)))
                             else (if (and var_11 (== (deref (cast u16* (+ var_11 12))) 4))) 
                                (set! var_12 (deref (cast i64* var_11)))
                             else (if (and var_11 (== (deref (cast u16* (+ var_11 12))) 5))) 
                                (set! var_12 (deref (cast u64* var_11)))
                             else (if (and var_11 (== (deref (cast u16* (+ var_11 12))) 6))) 
                                (set! var_12 (cast i32 (deref (cast f32* var_11))))
                             else 
                                (set! var_12 0)
                            
                            (set! var_10 var_12)
                         else 
                            (set! var_10 -1)
                        
                        (define var_13 (encounter--get-run-structure))
                        (if (&& (|| (&& (&& (&& (>= var_10 0) (< var_10 (encounter--get-total-encounters-generated))) (!= (encounter--get-mode-at var_13 var_7) 3)) (!= logging-camp (encounter--get-id-at var_13 var_7))) (== (encounter--get-mode-at var_13 var_10) 3)) (== logging-camp (encounter--get-id-at var_13 var_10)))) 
                            (set-svar dead-drop-deficit (- (get-svar dead-drop-deficit) 1))
                            (if (not (is-final-build?))) 
                                (display (dc:format "DEB-DD: BILL SPECIAL CASE. CURRENTLY IN ENCOUNTER %dTH & THE NEXT CAN'T HAVE DEAD DROP!" (+ 1 (get-svar encounter-depth))) 19)
                            
                            (if (not (is-final-build?))) 
                                (display (dc:format "DEB-DD: SPAWNING DEAD DROP EARLY..") 19)
                            
                            (go run-setup 1)
                         else (if (and (== (% (get-svar encounter-depth) 2) 1) (<= (get-svar dead-drop-deficit) 0))) 
                            (if (not (is-final-build?))) 
                                (display (dc:format "DEB-DD: NO DEAD DROP IN ENCOUNTERS 2, 4 & 6") 19)
                            
                            (go complete 1)
                         else (if (and (== (rogue-get-current-task-game-mode) 3) (== (rogue-get-current-task-game-mode) 4))) 
                            (increment-svar dead-drop-deficit 1)
                            (if (not (is-final-build?))) 
                                (display (dc:format "DEB-DD: MODE CAPTURE OR BOSS...DEAD DROP DEFICIT INCREASED %i" (get-svar dead-drop-deficit)) 19)
                            
                            (go complete 1)
                         else (if (custom-run--are-dead-drops-enabled?)) 
                            (if (not (is-final-build?))) 
                                (display (dc:format "DEB-DD: SPAWNING DEAD DROP..") 19)
                            
                            (go run-setup 1)
                         else 
                            (increment-svar dead-drop-deficit 1)
                            (if (not (is-final-build?))) 
                                (display (dc:format "DEB-DD: DEAD DROP DEFICIT INCREASED %i" (get-svar dead-drop-deficit)) 19)
                            
                            (go complete 1)
                        
                    
                
            }
        }
    }
    state run-setup {
        block start {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-DD: WAITING FOR DEAD DROP SPAWN CALL") 19)
                    
                
                lambda 
                    (if (== (encounter--get-total-encounters-completed) 0)) 
                        (set-svar-as-boolean dead-drop-deposited 0)
                    
                
                lambda 
                    (if (and (== (get-svar encounter-depth) 0) (== (get-svar encounter-depth) 1))) 
                        (set-int32 deposit-item-count 1 self)
                    
                
                lambda 
                    (if (and (!= *encounter-tweaks* nullptr) (> (deref (cast i32* (+ *encounter-tweaks* 144))) 0))) 
                        (set-int32 deposit-item-count (deref (cast i32* (+ *encounter-tweaks* 144))) self)
                    
                
                lambda 
                    (define var_2 (encounter--get-master-seed-for-task (task-get-current-node-id) (task-get-current-subnode-id)))
                    (if (> var_2 0)) 
                        (set! var_3 (rogue-set-prng-category-seed rng-dead-drop var_2))
                    
                
            }
        }
        block event spawn-dead-drop {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-DD: request to spawn dead drop") 19)
                    
                
                lambda 
                    (darray-clear grp-dead-drop-deposit-spawners)
                
                lambda 
                    (darray-clear grp-valid-dead-drop-deposit-spawners)
                
                lambda 
                    (for ([var_3 (get-spawners-by-tag-int32 rogue-dead-drop-deposit-spawner 1 0 0)]) 
                        (define var_4)
                        (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 7))) 
                            (set! var_4 (deref (cast u64* var_3)))
                         else (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 5))) 
                            (set! var_4 (deref (cast u64* var_3)))
                         else (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 4))) 
                            (set! var_4 (deref (cast u64* var_3)))
                         else 
                            (set! var_4 0)
                        
                        (darray-append grp-dead-drop-deposit-spawners (new-boxed-value 7 var_4) 1)
                    )
                
                lambda 
                    (if (== (darray-count grp-dead-drop-deposit-spawners) 0)) 
                        (increment-svar dead-drop-deficit 1)
                        (if (not (is-final-build?))) 
                            (display (dc:format "DEB-DD: No Dead Drop Spawner deficit increased %i" (get-svar dead-drop-deficit)) 19)
                        
                        (go complete 1)
                    
                
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-DD Found %i Dead Drop Spawner" (darray-count grp-dead-drop-deposit-spawners)) 19)
                    
                
                lambda 
                    (if (or (!= *encounter-tweaks* nullptr) (deref (cast u8* (+ *encounter-tweaks* 148))))) 
                        (if (and (!= *encounter-tweaks* nullptr) (deref (cast u8* (+ *encounter-tweaks* 149))))) 
                            (if (not (is-final-build?))) 
                                (display (dc:format "DEB-DD Debug Spawn All Dead Drop") 19)
                            
                            (for ([var_3 grp-dead-drop-deposit-spawners]) 
                                (define var_4)
                                (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 7))) 
                                    (set! var_4 (deref (cast u64* var_3)))
                                 else (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 5))) 
                                    (set! var_4 (deref (cast u64* var_3)))
                                 else (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 4))) 
                                    (set! var_4 (deref (cast u64* var_3)))
                                 else 
                                    (set! var_4 0)
                                
                                (spawn-dead-drop-deposit var_4)
                                (pick-deposit-item)
                            )
                            (go display-required-item 1)
                         else (if (and (get-svar-as-boolean main-unlock-dead-drop) (rogue-is-daily-run))) 
                            (if (and (find-available-dead-drop-reward-recipe) (find-available-dead-drop-reward-weapon))) 
                                (if (not (is-final-build?))) 
                                    (display (dc:format "DEB-DD: Dead drop eligible for spawn") 19)
                                
                                (group-random grp-dead-drop-deposit-spawners)
                                (for ([var_14 grp-dead-drop-deposit-spawners]) 
                                    (define var_15)
                                    (if (and var_14 (== (deref (cast u16* (+ var_14 12))) 7))) 
                                        (set! var_15 (deref (cast u64* var_14)))
                                     else (if (and var_14 (== (deref (cast u16* (+ var_14 12))) 5))) 
                                        (set! var_15 (deref (cast u64* var_14)))
                                     else (if (and var_14 (== (deref (cast u16* (+ var_14 12))) 4))) 
                                        (set! var_15 (deref (cast u64* var_14)))
                                     else 
                                        (set! var_15 0)
                                    
                                    (if (> (get-locator-distance (get-spawner-locator var_15 1) (get-object-locator player)) 15.00)) 
                                        (darray-append var_15 (new-boxed-value 7 grp-valid-dead-drop-deposit-spawners) 1)
                                    
                                )
                                (define var_23)
                                (if (! (== (darray-count grp-valid-dead-drop-deposit-spawners) 0))) 
                                    (set! var_23 (group-random grp-valid-dead-drop-deposit-spawners))
                                
                                (if (not (is-final-build?))) 
                                    (display (dc:format "DEB-DD: Found dead drop spawner: %s" (string-debug var_23)) 19)
                                
                                (spawn-dead-drop-deposit var_23)
                                (if (> (get-svar dead-drop-deficit) 0)) 
                                    (set-svar dead-drop-deficit (- (get-svar dead-drop-deficit) 1))
                                    (if (not (is-final-build?))) 
                                        (display (dc:format "DEB-DD: DEAD DROP DEFICIT DECREASED %i" (get-svar dead-drop-deficit)) 19)
                                    
                                
                                (pick-deposit-item)
                                (go display-required-item 1)
                             else 
                                (increment-svar dead-drop-deficit 1)
                                (if (not (is-final-build?))) 
                                    (display (dc:format "DEB-DD: Dead drop wasn't spawned. Deficit increased %i" (get-svar dead-drop-deficit)) 19)
                                
                            
                        
                    
                
            }
        }
    }
    state display-required-item {
        block start {
            track main {
                lambda 
                    (set-boolean ready-for-deposit 1 self)
                
                lambda 
                    (check-and-swap-stun-smoke-bomb)
                
            }
        }
        block end {
            track main {
                lambda 
                    (set-boolean ready-for-deposit 0 self)
                
            }
        }
        block event dead-drop-deposit {
            track main {
                lambda 
                    (if (wait-deposit-items)) 
                        (go item-deposited 1)
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (player-has-deposit-items?)) 
                        (set-boolean player-has-deposit-items 1 self)
                     else 
                        (set-boolean player-has-deposit-items 0 self)
                    
                
            }
        }
        block event player-upgrade-enabled {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-DD: player upgraded to smoke bomb") 19)
                    
                
                lambda 
                    (check-and-swap-stun-smoke-bomb)
                
            }
        }
    }
    state item-deposited {
        block start {
            track main {
                lambda 
                    (set-boolean items-deposited 1 self)
                
                lambda 
                    (hud2-play-tutorial HUD_ROGUE_DEAD_DROP_DEPOSITED 5.00 none "html/lockbox.png" 1 0 0 0)
                
            }
        }
        block end {
            track main {
                lambda 
                    (set-boolean items-deposited 0 self)
                
                lambda 
                    (listen-mode-set-buddy-draw-mode (get-symbol deposit-spawner self) 0)
                
                lambda 
                    (listen-mode-visible (get-symbol deposit-spawner self) 0 1 -1.00)
                
            }
        }
    }
    state  {
    }
    state collect-reward {
        block event player-requested-interact {
            track main {
                lambda 
                    (if (and (or (== (event-arg-symbol 0) int-map-table-1) (get-svar-as-boolean dead-drop-wait-pick-up-recipe)) (get-svar-as-boolean dead-drop-wait-pick-up-weapon))) 
                        (hud2-play-tutorial HUD_ROGUE_COLLECT_DEAD_DROP_REWARD 4.00 none 0 3 0 0 0)
                    
                
            }
        }
        block event player-pickup {
            track main {
                lambda 
                    (if (is-firearm? (event-arg-symbol 1))) 
                        (set-svar-as-boolean dead-drop-wait-pick-up-weapon 0)
                    
                
            }
        }
        block event player-next-task {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (define var_2)
                        (if (get-svar-as-boolean dead-drop-wait-pick-up-recipe)) 
                            (set! var_2 "recipe")
                         else 
                            (set! var_2 "nothing")
                        
                        (define var_4)
                        (if (get-svar-as-boolean dead-drop-wait-pick-up-weapon)) 
                            (set! var_4 "weapon")
                         else 
                            (set! var_4 "nothing")
                        
                        (display (dc:format "DEB-DD: Player starting next task.. %s & %s left behind! Cleared." var_2 var_4) 19)
                    
                
                lambda 
                    (remove-dead-drop-weapon)
                
                lambda 
                    (set-svar-as-boolean dead-drop-wait-pick-up-recipe 0)
                
                lambda 
                    (set-svar-as-boolean dead-drop-wait-pick-up-weapon 0)
                
                lambda 
                    (set-svar-as-boolean dead-drop-deposited 0)
                
            }
        }
    }
}
