        (if (not (is-final-build?))) 
            (display (dc:format "DEB-DD:     New Count:     %d" (+ 1 (deref (cast i32* (+ (+ (deref *t2r-dead-drop-item-info-array*) (* var_132 32)) 16))))) 19)
        
        (if (not (is-final-build?))) 
            (display (dc:format "DEB-DD:     Index:         %d" var_132) 19)
        
        (define var_149)
        (if (not (darray-contains? grp-picked-deposit-item-index (new-boxed-value 7 var_132)))) 
            (set! var_149 (darray-append grp-picked-deposit-item-index (new-boxed-value 7 var_132) 1))
         else 
