statescript {
    options {
        player
    }
    declarations {
        i32 map-table = 0
        i32 encounter-index = 0
        symbol w-map-info-panel = canvas.hudRoot.hudMenuStack.t2r-hud-rogue/t2r-map-table-limited
        symbol w-map-info-panel-ref = canvas.hudRoot.hudMenuStack.t2r-hud-rogue/t2r-map-table-limited.reference
        symbol w-level-name-text = nullptr
        symbol w-enemy-faction-text = nullptr
        symbol w-encounter-type = nullptr
        symbol w-mods-group = nullptr
        symbol w-animGroup = nullptr
        symbol w-encounter-info-card = nullptr
        symbol w-encounter-info-card-header = nullptr
        symbol w-encounter-info-card-body-0 = nullptr
        symbol w-encounter-info-card-body-1 = nullptr
        symbol w-encounter-info-card-anchored-root = nullptr
        symbol w-encounter-info-card-anchored = nullptr
        symbol w-encounter-info-card-anchored-header = nullptr
        symbol w-encounter-info-card-anchored-body-0 = nullptr
        symbol w-encounter-info-card-anchored-body-1 = nullptr
        symbol info-card-header-cipher = HUD_ROGUE_TITLE_ASSAULT
        symbol info-card-body-cipher-0 = HUD_TUTORIAL_ROGUE_ASSAULT_INTRO_01
        symbol info-card-body-cipher-1 = #0000000000000000
        bool encounter-info-card-showing? = nullptr
        u64 info-card-tts-call = nullptr
        timer encounter-info-card-fade-timer = nullptr
        string str-temp-character-name = nullptr
        timer map-table-instructions-cooldown = nullptr
        bool first-hover? = true
        bool is-assault? = nullptr
        bool zoomed-out? = nullptr
        bool exiting-map? = nullptr
    }
    state initial {
        block start {
            track main {
                lambda 
                    (let loop () (when (not (is-script-running? ss-encounter-manager-1)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (set-symbol w-map-info-panel (template--get-widget-root (deref (cast u64* (template--get-current-run-template)))) self)
                
                lambda 
                    (set-symbol w-map-info-panel-ref (symbol-concat-string (get-symbol w-map-info-panel self) ".reference") self)
                
                lambda 
                    (set-symbol w-animGroup (gui2-find-widget-path "anim-group" self) self)
                
                lambda 
                    (set-symbol w-level-name-text (gui2-find-widget-path "mapTableLevelName" (get-symbol w-map-info-panel self)) self)
                
                lambda 
                    (set-symbol w-enemy-faction-text (gui2-find-widget-path "mapTableEnemies" (get-symbol w-map-info-panel self)) self)
                
                lambda 
                    (set-symbol w-encounter-type (gui2-find-widget-path "mapTableEncounterType" (get-symbol w-map-info-panel self)) self)
                
                lambda 
                    (set-symbol w-mods-group (gui2-find-widget-path "modifiersGroup" (get-symbol w-map-info-panel-ref self)) self)
                
                lambda 
                    (update-focused-map-photo)
                
                lambda 
                    (set-symbol w-encounter-info-card-anchored-root (gui2-find-widget-path "anim-group.fader.infoCardRoot" self) self)
                
                lambda 
                    (set-symbol w-encounter-info-card-anchored (gui2-find-widget-path "fader.infoCard" (get-symbol w-encounter-info-card-anchored-root self)) self)
                
                lambda 
                    (set-symbol w-encounter-info-card-anchored-header (gui2-find-widget-path "titleBar.title0" (get-symbol w-encounter-info-card-anchored self)) self)
                
                lambda 
                    (set-symbol w-encounter-info-card-anchored-body-0 (gui2-find-widget-path "text0" (get-symbol w-encounter-info-card-anchored self)) self)
                
                lambda 
                    (set-symbol w-encounter-info-card-anchored-body-1 (gui2-find-widget-path "text1" (get-symbol w-encounter-info-card-anchored self)) self)
                
                lambda 
                    (gui2-set-widget-state-immediate (get-symbol w-encounter-info-card-anchored-root self) off 0 0 0)
                
                lambda 
                    (gui2-assign-to-category (get-symbol w-map-info-panel self) 2097152)
                
                lambda 
                    (gui2-set-widget-state-immediate (get-symbol w-animGroup self) off 0 0 0)
                
                lambda 
                    (go initial-delay 1)
                
            }
        }
    }
    state initial-delay {
        block start {
            track main {
                lambda 
                    (wait 0.25)
                
                lambda 
                    (gui2-go-widget-state (get-symbol w-animGroup self) active 0 0 0)
                
                lambda 
                    (go ready-for-buttons 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (hud2-hide-health-ammo/f 0 0)
                
            }
        }
        block event photo-focused {
            track main {
                lambda 
                    (on-photo-focused)
                
            }
        }
        block event rogue-fading-into-map-encounter {
            track main {
                lambda 
                    (go disabled 1)
                
            }
        }
    }
    state disabled {
        block start {
            track main {
                lambda 
                    (gui2-go-widget-state (get-symbol w-animGroup self) off 0 0 0)
                
            }
        }
        block update {
            track main {
                lambda 
                    (hud2-hide-health-ammo/f 0 0)
                
            }
        }
    }
    state ready-for-buttons {
        block start {
            track main {
                lambda 
                    (start-timer map-table-instructions-cooldown 25.00 self 1)
                
                lambda 
                    (play-accessibility-control-regained-control-sound)
                
                lambda 
                    (update-map-encounter-info-card (encounter--get-mode-at (encounter--get-run-structure) (get-int32 encounter-index self)) (encounter--map-mystery-active-at-index (get-int32 encounter-index self)))
                
            }
        }
        block update {
            track main {
                lambda 
                    (use-esc-for-back/f)
                
                lambda 
                    (hud2-hide-health-ammo/f 0 0)
                
                lambda 
                    (if (and (timer-done? map-table-instructions-cooldown self) (not (text-to-speech-playing?)))) 
                        (start-timer map-table-instructions-cooldown 15.00 self 1)
                    
                
                lambda 
                    (if (joypad-command-active? menu-inspect 6)) 
                        (send-event show-rl-encounter-info self)
                    
                
                lambda 
                    (if (and (and (and (get-boolean encounter-info-card-showing? self) (not (get-boolean zoomed-out? self))) (not (timer-running? encounter-info-card-fade-timer self))) (not (get-boolean exiting-map? self)))) 
                        (set-symbol w-encounter-info-card (gui2-show-attachable-widget/f (get-symbol w-map-info-panel self) "hud-pause-cards/t2r-rogue-map-encounter-info" (string-to-symbol (dc:format "obj-map-table-fg-photo-1-%d" (get-int32 encounter-index self))) 0 0 -1 0.17 0) self)
                        (gui2-assign-to-category (get-symbol w-encounter-info-card self) 2097152)
                        (set-symbol w-encounter-info-card-header (gui2-build-widget-path (get-symbol w-encounter-info-card self) "fader.titleBar.title0" 0 0 0 0 0 0 0) self)
                        (set-symbol w-encounter-info-card-body-0 (gui2-build-widget-path (get-symbol w-encounter-info-card self) "fader.text0" 0 0 0 0 0 0 0) self)
                        (set-symbol w-encounter-info-card-body-1 (gui2-build-widget-path (get-symbol w-encounter-info-card self) "fader.text1" 0 0 0 0 0 0 0) self)
                        (gui2-set-widget-text-cipher (get-symbol w-encounter-info-card-header self) (get-symbol info-card-header-cipher self))
                        (gui2-set-widget-text-cipher (get-symbol w-encounter-info-card-body-0 self) (get-symbol info-card-body-cipher-0 self))
                        (gui2-set-widget-text-cipher (get-symbol w-encounter-info-card-body-1 self) (get-symbol info-card-body-cipher-1 self))
                    
                
            }
        }
        block event rogue-fading-into-map-encounter {
            track main {
                lambda 
                    (go disabled 1)
                
            }
        }
        block event rl-hub-exit-map-table {
            track main {
                lambda 
                    (set-boolean exiting-map? 1 self)
                
            }
        }
        block event photo-focused {
            track main {
                lambda 
                    (on-photo-focused)
                
                lambda 
                    (if (get-boolean encounter-info-card-showing? self)) 
                        (set-boolean encounter-info-card-showing? 0 self)
                    
                
                lambda 
                    (update-map-encounter-info-card (encounter--get-mode-at (encounter--get-run-structure) (event-arg-int32 0)) (encounter--map-mystery-active-at-index (event-arg-int32 0)))
                
            }
        }
        block event show-rl-encounter-info {
            track main {
                lambda 
                    (play-hfx-id hfx-ui-cycle 0 2)
                
                lambda 
                    (play-sound sfx-select-cycle 0)
                
                lambda 
                    (set-boolean encounter-info-card-showing? (not (get-boolean encounter-info-card-showing? self)) self)
                
                lambda 
                    (if (get-boolean zoomed-out? self)) 
                        (define var_3)
                        (if (get-boolean encounter-info-card-showing? self)) 
                            (set! var_3 active)
                         else 
                            (set! var_3 off)
                        
                        (gui2-go-widget-state (get-symbol w-encounter-info-card-anchored-root self) var_3 0 0 0)
                    
                
                lambda 
                    (if (get-boolean encounter-info-card-showing? self)) 
                        (set-uint64 info-card-tts-call (speak-text-to-speech-raw (concat-boxed-arrays (generate-text-to-speech-formatted (new-boxed-value 7 (get-symbol info-card-header-cipher self)) 0) (generate-text-to-speech-formatted (new-boxed-value 7 (get-symbol info-card-body-cipher-0 self)) 0) (generate-text-to-speech-formatted (new-boxed-value 7 (get-symbol info-card-body-cipher-1 self)) 0) 0 0 0 0 0) 0 0 1) self)
                     else 
                        (kill-text-to-speech-call (get-uint64 info-card-tts-call self))
                    
                
            }
        }
        block event change-map-view {
            track main {
                lambda 
                    (set-boolean zoomed-out? (event-arg-boolean 0) self)
                
                lambda 
                    (if (and (get-boolean zoomed-out? self) (get-boolean encounter-info-card-showing? self))) 
                        (wait 0.20)
                        (gui2-go-widget-state (get-symbol w-encounter-info-card-anchored-root self) active 0 0 0)
                     else 
                        (start-timer encounter-info-card-fade-timer 0.20 self 1)
                        (gui2-go-widget-state (get-symbol w-encounter-info-card-anchored-root self) off 0 0 0)
                    
                
            }
        }
    }
}
