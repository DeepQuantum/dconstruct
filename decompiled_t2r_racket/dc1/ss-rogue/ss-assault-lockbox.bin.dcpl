                    (set-symbol new-interactable (spawn-entity-at (get-symbol interactable self) (get-joint-locator (get-symbol new-lockbox self) interact) 0) self)
                
                lambda 
                    (parent-bound-frame (get-object-locator (get-symbol new-interactable self)) (get-symbol new-lockbox self) 0)
                
                lambda 
                    (if (and (is-level-loaded? t2r-assault-level-pat-jackson-mainstreet-layout-1) (== (get-symbol selected-spawner self) rogue-lockbox-spawner-170))) 
                        (interactable-set-interaction-region (get-symbol new-interactable self) interact-region-lockbox-spawner-170)
                     else (if (and (is-level-loaded? t2r-assault-level-pat-jackson-mainstreet-layout-2) (== (get-symbol selected-spawner self) rogue-lockbox-spawner-185))) 
                        (interactable-set-interaction-region (get-symbol new-interactable self) interact-region-lockbox-spawner-185)
                    
                
                lambda 
                    (set-high-contrast-mode-type (get-symbol new-lockbox self) 2)
                
                lambda 
                    (rogue-mark-always-visible-in-listen-mode (get-symbol new-lockbox self))
                
                lambda 
                    (log-event "supply-drop" 0 "spawned" 0 0)
                
                lambda 
                    (set-boolean lockbox-spawned 1 self)
                
                lambda 
                    (set-boolean lockbox-unopened 1 self)
                
                lambda 
                    (ddict-set (get-symbol lockbox-ddict self) (get-symbol new-interactable self) (new-boxed-value 7 (get-symbol new-lockbox self)))
                
                lambda 
                    (if (not (== (rogue-get-current-task-game-mode) 3))) 
                        (start-timer loot-spawn-visible-timer 7.50 self 1)
                    
                
                lambda 
                    (go wait-for-loot 1)
                
            }
        }
    }
    state wait-for-loot {
        block update {
            track main {
                lambda 
                    (if (and (and (player-listen-mode-active?) (timer-running? loot-spawn-visible-timer self)) (is-no-return-hud-listen-mode-markers-enabled?))) 
                        (if (and (and (and (and (not (get-boolean player-in-backpack? self)) (is-navigation-assistance-accessibility?)) (== (get-symbol selected-goal ss-rogue-navigation-goal-1) supply-box)) (not (get-boolean force-hide-marker? ss-rogue-navigation-goal-1))) (not (is-rogue-in-post-encounter-flow?)))) 
                            (for ([element (get-symbol lockbox-ddict self)]) 
                                (define var_13 (ddict-get (get-symbol lockbox-ddict self) element))
                                (define var_14)
                                (if (and var_13 (== (deref (cast u16* (+ var_13 12))) 7))) 
                                    (set! var_14 (deref (cast u64* var_13)))
                                 else (if (and var_13 (== (deref (cast u16* (+ var_13 12))) 5))) 
                                    (set! var_14 (deref (cast u64* var_13)))
                                 else (if (and var_13 (== (deref (cast u16* (+ var_13 12))) 4))) 
                                    (set! var_14 (deref (cast u64* var_13)))
                                 else 
                                    (set! var_14 0)
                                
                                (define var_16 (gui2-show-attachable-widget/f canvas.hudRoot.rootFullscreen.attachableWidgets "hud-buddy-status/rogue-attachable" var_14 0 (alloc-vector 0.00 1.00 0.00 1.00 0) 6 0.25 0))
                                (define var_17 (gui2-find-widget-path "icon0" var_16))
                                (define var_19)
                                (if (is-navigation-assistance-accessibility?)) 
                                    (set! var_19 256)
                                 else 
                                    (set! var_19 32768)
                                
                                (gui2-assign-to-category var_16 var_19)
                                (gui2-set-widget-image var_17 "hud/interactions/marker-lootbox.png")
                                (gui2-set-widget-palette-tint var_17 t2-white)
                                (if (and (is-navigation-assistance-accessibility?) (== (get-symbol selected-goal ss-rogue-navigation-goal-1) supply-box))) 
                                    (set! var_22 (gui2-set-widget-alpha var_16 1.00))
                                 else (if (tension-mode-is? 3)) 
                                    (set! var_22 (gui2-set-widget-alpha var_16 0.25))
                                 else 
                                    (set! var_22 (gui2-set-widget-alpha var_16 1.00))
                                
                            )
                        
                     else (if (and (and (and (is-navigation-assistance-accessibility?) (== (get-symbol selected-goal ss-rogue-navigation-goal-1) supply-box)) (not (get-boolean force-hide-marker? ss-rogue-navigation-goal-1))) (not (is-rogue-in-post-encounter-flow?)))) 
                    
                
            }
        }
    }
    state opened-lockbox {
        block start {
            track interacting-lockbox {
                lambda 
                    (wait 0.50)
                
                lambda 
                    (define var_2)
                    (if (get-boolean lockbox-is-wood self)) 
                        (set! var_2 (get-symbol lockbox-open-anim-wood self))
                     else 
                        (set! var_2 (get-symbol lockbox-open-anim self))
                    
                    (define var_5 (#%alloc-array single-frame 16 2 1))
                    (set! (deref (cast i32* (deref (+ (deref var_5) (* 0 8))))) 10)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_5) (* 0 8))) 8))) 0)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_5) (* 0 8))) 8))) (get-object-locator (get-symbol interacting-lockbox self)))
                    (set! (deref (cast i32* (deref (+ (deref var_5) (* 1 8))))) 28)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_5) (* 1 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_5) (* 1 8))) 8))) 0.30)
                    (animate_ (get-symbol interacting-lockbox self) var_2 var_5)
                
                lambda 
                    (wait 0.10)
                
                lambda 
                    (signal box-opened 0)
                
            }
            track player {
                lambda 
                    (broadcast-event lockbox-opened)
                
                lambda 
                    (log-event "supply-drop" 0 "opened" 0 0)
                
                lambda 
                    (player-simulate-pickup (offset-locator (get-object-locator (get-symbol interacting-lockbox self)) (alloc-vector 0.00 0.50 0.00 1.00 0)) 1 0 0 1)
                
            }
            track loot {
                lambda 
                    (wait-for box-opened)
                
                lambda 
                    (set-boolean lockbox-unopened 0 self)
                
                lambda 
                    (cleanup-pickups)
                
                lambda 
                    (populate-pickups)
                
                lambda 
                    (listen-mode-set-buddy-draw-mode (get-symbol interacting-lockbox self) 0)
                
                lambda 
                    (listen-mode-visible (get-symbol interacting-lockbox self) 0 1 -1.00)
                
                lambda 
                    (set-high-contrast-mode-type (get-symbol interacting-lockbox self) 1)
                
                lambda 
                    (ddict-set (get-symbol lockbox-ddict self) (ddict-get-key-with-value (get-symbol lockbox-ddict self) (get-symbol interacting-lockbox self)) (new-boxed-value 0 0))
                
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (if (! (== (ddict-key-count (get-symbol lockbox-ddict self)) 0))) 
                        (go wait-for-loot 1)
                    
                
            }
            track haptics {
                lambda 
                    (if (joypad-has-haptics? 2)) 
                        (wait-for box-opened)
                        (play-hfx-id unlock-crate-haptic 0 2)
                    
                
            }
        }
    }
}
