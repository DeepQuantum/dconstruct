                    (wait 0.25)
                
                lambda 
                    (if (and (== (get-boolean player-in-map-table? self) 1) (== (get-boolean player-entering? self) 1))) 
                        (if (== (player-flashlight-on?) 1)) 
                            (turn-off-flashlight player 0)
                        
                        (go entering-map 1)
                     else (if (and (== (get-boolean player-in-map-table? self) 1) (== (get-boolean player-exiting? self) 1))) 
                        (go exiting-map 1)
                     else (if (and (and (== (get-boolean player-in-map-table? self) 1) (== (get-boolean player-entering? self) 0)) (== (get-boolean player-exiting? self) 0))) 
                        (if (== (player-flashlight-on?) 1)) 
                            (turn-off-flashlight player 0)
                        
                        (go idle-map 1)
                     else 
                        (go idle 1)
                    
                
            }
        }
    }
}
