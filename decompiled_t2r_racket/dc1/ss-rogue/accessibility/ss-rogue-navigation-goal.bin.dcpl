            }
        }
        block update {
            track main {
                lambda 
                    (if (> (darray-count (wave-manager-get-npc-alive-group ss-wave-manager-1)) 0)) 
                        (if (not (get-boolean first-combat-goal-loc-set? self))) 
                            (set-point enemy-centroid-loc (get-group-centroid (wave-manager-get-npc-alive-group ss-wave-manager-1)) self)
                        
                        (if (and (not (== (get-symbol closest-enemy self) 0)) (not (npc-alive? (get-symbol closest-enemy self))))) 
                            (set-symbol closest-enemy *invalid-symbol* self)
                        
                        (update-rogue-nav-assist-combat-goal-closest-enemy)
                        (update-rogue-nav-assist-ideal-combat-post (get-symbol closest-enemy self))
                        (define var_10)
                        (if (== (get-nav-assist-combat-icon-placement) at-true-combat-goal)) 
                            (set! var_10 1)
                         else (if (== (get-nav-assist-combat-icon-placement) at-centroid-on-swap-true-goal-on-L3)) 
                            (set! var_10 1)
                         else (if (== (get-nav-assist-combat-icon-placement) at-live-enemy-centroid)) 
                            (set! var_10 1)
                         else 
                            (set! var_10 0)
                        
                        (if (and (and (and (or var_10 (not (hide-nav-assist-icon-after-delay?))) (hide-nav-assist-icon-after-delay?)) (timer-done? hide-and-fade-marker-timer self)) (get-boolean combat-wave-spawn-icon-done? self))) 
                            (set-point staggered-combat-post-loc (get-point current-combat-post-loc self) self)
                        
                        (if (timer-done? update-combat-goal-timer self)) 
                            (set-rogue-navigation-goal-with-breadcrum! (get-point staggered-combat-post-loc self) (get-float update-combat-goal-time self))
                            (start-timer update-combat-goal-timer (get-float update-combat-goal-time self) self 1)
                        
                     else 
                        (set-symbol closest-enemy *invalid-symbol* self)
                        (clear-rogue-navigation-goal!)
                    
                
            }
        }
        block event wm-new-wave-spawned {
            track main {
                lambda 
                    (set-boolean combat-wave-spawn-icon-done? 0 self)
                
                lambda 
                    (if (== (get-nav-assist-combat-icon-placement) at-centroid-on-swap-true-goal-on-L3)) 
                        (set-boolean show-combat-icon-at-true-goal? 0 self)
                        (set-boolean first-combat-goal-loc-set? 0 self)
                        (set-point enemy-centroid-loc (get-group-centroid (wave-manager-get-npc-alive-group ss-wave-manager-1)) self)
                    
                
                lambda 
                    (if (hide-nav-assist-icon-after-delay?)) 
                        (start-timer hide-marker-timer (get-float hide-marker-time self) self 1)
                        (start-timer hide-and-fade-marker-timer (get-float hide-and-fade-marker-time self) self 1)
                    
                
            }
        }
    }
}
