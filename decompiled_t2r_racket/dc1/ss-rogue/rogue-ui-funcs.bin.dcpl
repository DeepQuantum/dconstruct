(define (rogue-ui--get-map-photo-data arg_0) 
    (define i 0)
    (define var_0)
    (let loop () (when (< i (deref (cast i32* (+ *map-photo-data* 8)))) 
        (define var_1)
        (if (== (deref (cast u64* (deref (+ (deref *map-photo-data*) (* i 8))))) arg_0)) 
            (set! var_1 (deref (+ (deref *map-photo-data*) (* i 8))))
            (deref (+ (deref *map-photo-data*) (* i 8)))
        
        (set! var_0 var_1)
        (set! i (+ i 1))
     (loop)))
    var_0
)

