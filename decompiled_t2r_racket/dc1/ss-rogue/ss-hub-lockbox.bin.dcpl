                        (speak-text-to-speech-formatted (new-boxed-value 7 HUD_NOTIFICATION_NEW_UPGRADE_BRANCH_SUBTITLE) 1 0 1)
                        (speak-text-to-speech-formatted (new-boxed-value 7 var_47) 1 0 1)
                        (speak-text-to-speech-formatted (new-boxed-value 7 MENU_PROMPT_TAKE_BUTTON) 1 0 1)
                        (let loop () (when (and (joypad-command-active? menu-select 6) (not (gui2-widget-is-currently-mouse-hovered-and-clicked? var_35 0))) 
                            (wait-one-frame)
                         (loop)))
                        (menu2-pop-page hudMenuStack menu/message-box-encounter-rewards)
                        (let loop () (when (and (joypad-command-active? menu-select 6) (not (gui2-widget-is-currently-mouse-hovered-and-clicked? var_35 0))) 
                            (wait-one-frame)
                         (loop)))
                        (set! var_107 (signal manual-collected 0))
                     else 
                        (set! var_107 (menu2-pop-page hudMenuStack menu/message-box-encounter-rewards))
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (player-disable-move-stick)
                
                lambda 
                    (hud2-hide-health-ammo/f 0 0)
                
            }
        }
    }
    state done {
        block start {
            track main {
                lambda 
                    (set-high-contrast-mode-type (get-symbol new-lockbox self) 1)
                
                lambda 
                    (broadcast-event lockbox-done)
                
            }
        }
    }
}
