    state dumpster-puzzle {
        block start {
            track start {
                lambda 
                    (if (not (get-boolean vox-dumpster-start-done self))) 
                        (let loop () (when (not (player-in-state? PushPull)) 
                            (wait 0.10)
                         (loop)))
                        (wait 0.80)
                        (signal dina-1 0)
                        (set-boolean vox-dumpster-start-done 1 self)
                        (wait-say dina vox-igc-din-gam-wat-explore-start-dumpster-sp-001 2 0)
                        (wait 0.50)
                    
                
            }
            track progress {
                lambda 
                    (if (not (get-boolean vox-dumpster-progress-done self))) 
                        (let loop () (when (not (player-in-state? PushPull)) 
                            (wait 0.10)
                         (loop)))
                        (if (not (get-boolean vox-dumpster-start-done self))) 
                            (wait-for dina-1)
                        
                        (let loop () (when (not (> (get-player-speed) 0.00)) 
                            (wait 0.10)
                         (loop)))
                        (wait 1.00)
                        (set-boolean vox-dumpster-progress-done 1 self)
                        (wait-say player vox-igc-ell-gam-wat-explore-start-dumpster-sp-001 2 0)
                        (wait 0.80)
                        (wait-say dina vox-igc-din-gam-wat-explore-start-dumpster-sp-003 2 0)
                        (wait 0.20)
                        (if (and (and (and (> (get-player-speed) 0.10) (not (get-boolean vox-dumpster-progress self))) (get-boolean vox-dumpster-progress self)) (player-in-state? PushPull))) 
                            (wait-say player vox-igc-ell-gam-wat-explore-start-dumpster-sp-002 2 0)
                        
                    
                
            }
            track success {
                lambda 
                    (if (not (get-boolean vox-dumpster-puzzle-complete self))) 
                        (wait-boolean vox-dumpster-is-stuck 0 self)
                        (let loop () (when (and (< (get-player-speed) 0.00) (not (! (player-in-state? PushPull)))) 
                            (wait 0.10)
                         (loop)))
                        (set-boolean vox-dumpster-puzzle-complete 1 self)
                        (if (get-boolean vox-dumpster-progress-done self)) 
                            (if (player-in-state? Move)) 
                                (wait-say player vox-igc-ell-gam-wat-explore-start-dumpster-sp-003 2 0)
                                (wait 0.60)
                            
                            (say dina vox-igc-din-gam-wat-explore-start-dumpster-sp-004 2 0)
                        
                    
                
                lambda 
                    (go dumpster-cache-start 1)
                
            }
            track exit {
                lambda 
                    (wait-boolean vox-near-dumpster-puzzle 0 self)
                
                lambda 
                    (if (task-complete? watchtower wat-explore-start)) 
                        (go done 1)
                    
                
                lambda 
                    (go select-convo 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (send-event pause-hint hint-waypoint-wat-motel-3)
                
            }
        }
    }
    state dumpster-cache-start {
        block start {
            track vox {
                lambda 
                    (if (not (get-boolean vox-dumpster-cache-start-done self))) 
                        (if (task-continue-active? watchtower wat-explore-start dumpster-puzzle-done)) 
                            (wait 1.50)
                         else 
                            (wait-boolean vox-dumpster-under-window 1 self)
                            (let loop () (when (not (player-in-state? Jump)) 
                                (wait 0.10)
                             (loop)))
                            (wait 0.20)
                            (let loop () (when (not (player-in-state? Move)) 
                                (wait 0.10)
                             (loop)))
                            (wait 0.50)
                        
                        (set-boolean vox-dumpster-cache-start-done 1 self)
                        (wait-say player vox-igc-ell-gam-wat-explore-start-dumpster-spj-005 2 0)
                        (wait 0.50)
                        (wait-say dina vox-igc-din-gam-wat-explore-start-dumpster-spj-005 2 0)
                    
                
                lambda 
                    (if (not (get-boolean vox-secret-room-done self))) 
                        (go dumpster-cache-exit 1)
                    
                
            }
            track exit {
                lambda 
                    (wait-boolean vox-near-dumpster-puzzle 0 self)
                
                lambda 
                    (if (task-complete? watchtower wat-explore-start)) 
                        (go done 1)
                    
                
                lambda 
                    (go select-convo 1)
                
            }
            track bad-convo-timing {
                lambda 
                    (if (not (get-boolean vox-dumpster-cache-start-done self))) 
                        (wait-boolean vox-in-secret-room 1 self)
                        (set-boolean vox-dumpster-cache-start-done 1 self)
                        (go dumpster-cache-exit 1)
                    
                
            }
        }
    }
    state dumpster-cache-exit {
        block start {
            track vox {
                lambda 
                    (if (not (get-boolean vox-secret-room-done self))) 
                        (wait-boolean vox-in-secret-room 1 self)
                        (let loop () (when (not (> (get-int32 vox-picked-up-items self) 0)) 
                            (wait 0.10)
                         (loop)))
                        (wait-boolean vox-in-secret-room 0 self)
                        (wait 2.00)
                        (set-boolean vox-secret-room-done 1 self)
                        (if (> (get-int32 vox-picked-up-items self) 1)) 
                            (wait-say dina vox-igc-din-gam-wat-explore-start-dumpster-sp-006 2 0)
                            (wait 0.60)
                            (if (and (> (get-int32 vox-picked-up-items self) 2) (get-boolean vox-picked-up-trap-bomb self))) 
                                (wait-say player vox-igc-ell-gam-wat-freeway-after-bridge-sp-004 2 0)
                                (wait 0.50)
                             else (if (and (> (get-int32 vox-picked-up-items self) 0) (< (get-int32 vox-picked-up-items self) 3))) 
                                (wait-say player vox-igc-ell-gam-wat-explore-start-dumpster-sp-006 2 0)
                            
                            (if (and (> (get-int32 vox-picked-up-items self) 5) (get-boolean vox-picked-up-trap-bomb self))) 
                                (wait-say player vox-igc-ell-gam-wat-explore-start-dumpster-sp-009 2 0)
                            
                        
                    
                
            }
            track trap-bomb {
                lambda 
                    (wait-for-event player-requested-interact "" 0 0 0 0 0 0 0 0)
                
                lambda 
                    (wait-for-event entering-investigate 0 0 0 0 0 0 0 0 0)
                
                lambda 
                    (wait 1.50)
                
                lambda 
                    (wait-say player vox-igc-ell-gam-wat-explore-start-slf-001 2 0)
                
                lambda 
                    (wait 0.30)
                
                lambda 
                    (let loop () (when (not (player-in-state? Investigate)) 
                        (wait 0.10)
                     (loop)))
                
                lambda 
                    (if (not (signal-raised? done-with-trap-bomb 0))) 
                        (wait-say player vox-igc-ell-gam-wat-explore-start-slf-002 2 0)
                        (wait 3.00)
                        (if (player-in-state? Investigate)) 
                            (if (not (signal-raised? done-with-trap-bomb 0))) 
                                (wait-say player vox-igc-ell-gam-wat-explore-start-slf-003 2 0)
                                (wait 0.50)
                                (wait-say player vox-igc-ell-gam-wat-explore-start-slf-004 2 0)
                            
                        
                    
                
            }
            track done-with-trap-bomb {
                lambda 
                    (wait-for-event exiting-investigate "" 0 0 0 0 0 0 0 0)
                
                lambda 
                    (signal done-with-trap-bomb 0)
                
            }
            track exit {
                lambda 
                    (wait-boolean vox-near-dumpster-puzzle 0 self)
                
                lambda 
                    (if (task-complete? watchtower wat-explore-start)) 
                        (go done 1)
                    
                
                lambda 
                    (go select-convo 1)
                
            }
        }
    }
    state see-blood {
        block start {
            track vox {
                lambda 
                    (if (is-speaking? player)) 
                        (stop-speaking player)
                        (wait 0.60)
                    
                
                lambda 
                    (conversation-interactable-disable dina)
                
                lambda 
                    (say player vox-igc-ell-gam-wat-explore-start-apartments-runner-slf-001 2 0)
                
                lambda 
                    (wait 0.35)
                
                lambda 
                    (stop-speaking dina)
                
                lambda 
                    (let loop () (when (not (! (is-speaking? player))) 
                        (wait 0.10)
                     (loop)))
                
                lambda 
                    (signal start-tension 0)
                
                lambda 
                    (wait 0.20)
                
                lambda 
                    (wait-say player vox-igc-ell-gam-wat-explore-start-apartments-runner-slf-002 2 0)
                
                lambda 
                    (signal dina-unholster 0)
                
                lambda 
                    (wait 1.10)
                
                lambda 
                    (wait-say dina vox-igc-din-gam-wat-explore-start-apartments-runner-slf-001 2 0)
                
                lambda 
                    (wait-boolean vox-player-in-house 0 self)
                
                lambda 
                    (wait 0.70)
                
                lambda 
                    (signal end-tension 0)
                
                lambda 
                    (wait 4.00)
                
                lambda 
                    (go wait-for-event 1)
                
            }
            track player-behavior {
                lambda 
                    (wait-for start-tension)
                
                lambda 
                    (player-unholster-weapon-by-slot 2 1 0.00)
                
                lambda 
                    (let loop () (when (not (signal-raised? end-tension 0)) 
                        (player-disable-auto-holster)
                        (disallow-normal-tension)
                        (set-run-type run-tense)
                        (set-walk-type walk-tense)
                        (set-sprint-type sprint-uneasy)
                        (wait-one-frame)
                     (loop)))
                
            }
            track dina-behavior {
                lambda 
                    (wait-for dina-unholster)
                
                lambda 
                    (npc-unholster-pistol dina 1 0 -1.00 0)
                
                lambda 
                    (npc-request-follow-close dina player 0 0 0)
                
                lambda 
                    (wait-for tension-end)
                
                lambda 
                    (npc-request-explore-close dina 0 0 0)
                
            }
        }
        block event vox-runner-ambush {
            track main {
                lambda 
                    (npc-request-explore-close dina 0 0 0)
                
                lambda 
                    (go runner-ambush 1)
                
            }
        }
        block end {
            track main {
                lambda 
                    (set-boolean vox-ambush-done 1 self)
                
            }
        }
    }
    state runner-ambush {
        block start {
            track main {
                lambda 
                    (conversation-interactable-disable dina)
                
                lambda 
                    (wait 0.35)
                
                lambda 
                    (stop-speaking player)
                
                lambda 
                    (stop-speaking dina)
                
                lambda 
                    (wait-for-event npc-died 0 0 0 0 0 0 0 0 0)
                
                lambda 
                    (wait 4.00)
                
                lambda 
                    (define var_0 (get-boolean vox-player-killed-runner self))
                    (if (== var_0 1)) 
                        (wait-say dina vox-igc-din-gam-wat-explore-start-apartments-runner-sp-002 2 0)
                        (set! var_1 (wait-say player vox-igc-ell-gam-wat-explore-start-apartments-runner-sp-003 2 0))
                     else (if (== var_0 0)) 
                        (wait-say dina vox-igc-din-gam-wat-explore-start-apartments-runner-sp-004 2 0)
                        (set! var_1 (wait-say player vox-igc-ell-gam-wat-explore-start-apartments-runner-sp-005 2 0))
                    
                
                lambda 
                    (wait-say dina vox-igc-din-gam-wat-explore-start-apartments-runner-sp-003 2 0)
                
                lambda 
                    (wait-say player vox-igc-ell-gam-wat-explore-start-apartments-runner-sp-006 2 0)
                
                lambda 
                    (wait-boolean vox-player-in-house 0 self)
                
                lambda 
                    (wait 4.00)
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (set-boolean vox-player-killed-runner 1 self)
                
            }
        }
    }
    state wlf-rules-setup {
        block start {
            track vox {
                lambda 
                    (send-event wlf-rules ss-wat-capitol-hill-dina-start-1)
                
                lambda 
                    (wait 2.00)
                
                lambda 
                    (let loop () (when (not (locator-in-region? (get-object-locator dina) rgn-vox-wat-near-wlf-rules-1 player)) 
                        (wait 0.10)
                     (loop)))
                
                lambda 
                    (set-boolean vox-wlf-rules-setup 1 self)
                
                lambda 
                    (send-event turn-off interact-loc-wat-wlf-rules-1)
                
                lambda 
                    (npc-look-at-spawner dina pos-wat-start-wlf-rules-1 -1.00)
                
                lambda 
                    (wait-say dina vox-igc-din-gam-wat-explore-start-rules-sp-001 2 0)
                
                lambda 
                    (wait 0.80)
                
                lambda 
                    (wait-say dina vox-igc-din-gam-wat-explore-start-rules-sp-002 2 0)
                
                lambda 
                    (wait 0.70)
                
                lambda 
                    (interactable-enable int-wat-start-wlf-rules-1)
                
                lambda 
                    (signal int-switched 0)
                
                lambda 
                    (wait 1.00)
                
                lambda 
                    (npc-clear-look-at dina)
                
                lambda 
                    (wait 5.00)
                
                lambda 
                    (go wait-for-event 1)
                
            }
            track exit {
                lambda 
                    (let loop () (when 1 
                        (wait-boolean vox-player-at-wlf-rules 0 self)
                        (if (not (signal-raised? int-switched 0))) 
                            (go wait-for-event 1)
                        
                        (wait 0.25)
                     (loop)))
                
            }
        }
        block event player-requested-interact {
            track main {
                lambda 
                    (go wlf-rules-convo-1 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (send-event pause-hint hint-waypoint-wat-motel-3)
                
            }
        }
        block end {
            track main {
                lambda 
                    (npc-clear-look-at dina)
                
                lambda 
                    (send-event conversation-done ss-wat-capitol-hill-dina-start-1)
                
            }
        }
    }
    state wlf-rules-convo-1 {
        block start {
            track vox {
                lambda 
                    (set-boolean disable-auto-gestures 1 self)
                
                lambda 
                    (set-boolean disable-auto-gestures-player 1 self)
                
                lambda 
                    (send-event conversation-start ss-wat-capitol-hill-dina-start-1)
                
                lambda 
                    (interactable-disable int-wat-start-wlf-rules-1)
                
                lambda 
                    (set-boolean vox-wlf-rules-done 1 self)
                
                lambda 
                    (signal narrative-mode-start 0)
                
                lambda 
                    (player-look-at-point (get-spawner-position pos-wat-start-wlf-rules-1 1) 3.00)
                
                lambda 
                    (npc-look-at-spawner dina pos-wat-start-wlf-rules-1 3.00)
                
                lambda 
                    (conv-gesture player 27 12)
                
                lambda 
                    (wait-say player vox-igc-ell-gam-wat-explore-start-rules-sp-001 2 0)
                
                lambda 
                    (wait 0.60)
                
                lambda 
                    (npc-look-at-object dina player targHead 3.00)
                
                lambda 
                    (wait-say dina vox-igc-din-gam-wat-explore-start-rules-sp-003 2 0)
                
                lambda 
                    (send-event turn-on interact-loc-wat-wlf-rules-1)
                
                lambda 
                    (wait 0.40)
                
                lambda 
                    (npc-look-at-spawner dina pos-wat-start-wlf-rules-1 3.00)
                
                lambda 
                    (conv-gesture dina 39 12)
                
                lambda 
                    (wait-say dina vox-igc-din-gam-wat-explore-start-rules-sp-004 2 0)
                
                lambda 
                    (signal narrative-mode-end 0)
                
                lambda 
                    (send-event conversation-done ss-wat-capitol-hill-dina-start-1)
                
                lambda 
                    (wait 1.50)
                
                lambda 
                    (conv-gesture dina 21 12)
                
                lambda 
                    (wait-say dina vox-igc-din-gam-wat-explore-start-rules-sp-005 2 0)
                
                lambda 
                    (wait 0.70)
                
                lambda 
                    (player-look-at-object dina headb 2.00)
                
                lambda 
                    (wait-say dina vox-igc-din-gam-wat-explore-start-rules-sp-006 2 0)
                
                lambda 
                    (wait 0.30)
                
                lambda 
                    (wait-say dina vox-igc-din-gam-wat-explore-start-rules-sp-007 2 0)
                
                lambda 
                    (wait 0.60)
                
                lambda 
                    (player-look-at-object dina headb 2.00)
                
                lambda 
                    (send-event conversation-start ss-wat-capitol-hill-dina-start-1)
                
                lambda 
                    (wait-say player vox-igc-ell-gam-wat-explore-start-rules-sp-002 2 0)
                
                lambda 
                    (wait 0.60)
                
                lambda 
                    (wait-say dina vox-igc-din-gam-wat-explore-start-rules-sp-008 2 0)
                
                lambda 
                    (set-boolean disable-auto-gestures 0 self)
                
                lambda 
                    (set-boolean disable-auto-gestures-player 0 self)
                
                lambda 
                    (go wait-for-event 1)
                
            }
            track narrative-mode {
                lambda 
                    (wait-for narrative-mode-start)
                
                lambda 
                    (let loop () (when (! (signal-raised? narrative-mode-end 0)) 
                        (player-set-narrative-mode/f 1 *camera-remap-close *default-narrative-mode-settings*)
                        (wait-one-frame)
                     (loop)))
                
            }
        }
        block update {
            track main {
                lambda 
                    (suspend-idle-gestures/f player)
                
                lambda 
                    (suspend-idle-gestures/f dina)
                
                lambda 
                    (npc-disable-dialog-look dina 0.00)
                
                lambda 
                    (if (get-boolean disable-auto-gestures self)) 
                        (npc-disable-dialog-look-gestures dina 0.00)
                    
                
                lambda 
                    (if (get-boolean disable-auto-gestures-player self)) 
                        (player-disable-dialog-look-gestures 0.00)
                    
                
                lambda 
                    (send-event pause-hint hint-waypoint-wat-motel-3)
                
            }
        }
        block end {
            track main {
                lambda 
                    (npc-clear-look-at dina)
                
                lambda 
                    (player-clear-look-at)
                
                lambda 
                    (send-event conversation-done ss-wat-capitol-hill-dina-start-1)
                
            }
        }
    }
}
