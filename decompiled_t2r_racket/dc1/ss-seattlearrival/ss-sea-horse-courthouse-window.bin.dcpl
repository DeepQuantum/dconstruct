                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 3 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_0) (* 3 8))) 8))) 0.50)
                    (wait-animate_ player sea-hub-court-window-end--ellie var_0)
                
                lambda 
                    (teleport-character horse ch-sea-hub-courthouse-exit-1)
                
                lambda 
                    (camera-fade-out-animated 2.00 0)
                
                lambda 
                    (set-focusable-ignore player 0)
                
                lambda 
                    (set-svar-as-boolean sea-horse-court-window 1)
                
                lambda 
                    (task-set-active-continue! courthouse-entry 0 0 0 0.00 0 0)
                
                lambda 
                    (go complete 1)
                
            }
            track rumble {
                lambda 
                    (if (not (joypad-has-haptics? 2))) 
                        (wait-rumble 0.20 2.00)
                    
                
            }
            track haptics {
                lambda 
                    (if (joypad-has-haptics? 2)) 
                        (play-hfx-id generic-pull-release-soft-haptic 0 2)
                    
                
            }
            track vox {
                lambda 
                    (say dina vox-igc-din-igc-sea-hub-court-window-001 2 0)
                
                lambda 
                    (say player vox-igc-ell-igc-sea-hub-court-window-001 2 0)
                
            }
            track hud {
                lambda 
                    (hud2-signal-interactable-hold-success)
                
            }
            track birds {
                lambda 
                    (set-visible flee-sea-bird-checkpoint-1 0)
                
                lambda 
                    (set-visible flee-sea-bird-checkpoint-2 0)
                
                lambda 
                    (set-visible flee-sea-bird-coffee-1 0)
                
                lambda 
                    (set-visible flee-sea-bird-coffee-2 0)
                
                lambda 
                    (set-visible flee-sea-bird-coffee-3 0)
                
                lambda 
                    (set-visible flee-sea-bird-court-1 0)
                
                lambda 
                    (set-visible flee-sea-bird-court-2 0)
                
                lambda 
                    (set-visible flee-sea-bird-court-3 0)
                
                lambda 
                    (set-visible flee-sea-bird-court-4 0)
                
                lambda 
                    (set-visible flee-sea-bird-court-5 0)
                
                lambda 
                    (set-visible flee-sea-bird-court-6 0)
                
                lambda 
                    (set-visible flee-sea-bird-court-7 0)
                
                lambda 
                    (set-visible flee-sea-bird-court-8 0)
                
                lambda 
                    (set-visible flee-sea-bird-court-9 0)
                
                lambda 
                    (set-visible flee-sea-bird-tailgate-1 0)
                
                lambda 
                    (set-visible flee-sea-bird-tailgate-2 0)
                
                lambda 
                    (set-visible flee-sea-bird-tailgate-3 0)
                
            }
        }
        block end {
            track main {
                lambda 
                    (if (not (get-svar-as-boolean sea-horse-court-window))) 
                        (set-svar sea-horse-court-load 0)
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (override-render-settings *sea-rs-sea-hub-igc-into-courthouse* 1.00 1.00 0 32767 0 1 0 1.00)
                
                lambda 
                    (disable-pause-menu/f)
                
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda 
                    (interactable-disable int-sea-horse-court-window-1)
                
                lambda 
                    (animate-done obj-sea-horse-court-window-1 sea-hub-court-window-end--window pos-sea-horse-court-window-1 0 0 2)
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
