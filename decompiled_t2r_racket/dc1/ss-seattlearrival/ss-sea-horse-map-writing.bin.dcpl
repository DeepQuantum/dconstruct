            track main {
                lambda 
                    (if (get-boolean acquired-holster self)) 
                        (set-boolean acquired-holster 0 self)
                        (send-event complete-poi self (new-boxed-value 2 6) (new-boxed-value 6 0.60))
                    
                
            }
        }
        block event left-truck {
            track main {
                lambda 
                    (if (> (get-int32 convoy-count self) 0)) 
                        (send-event complete-poi self (new-boxed-value 2 10) (new-boxed-value 6 0.60))
                    
                
            }
        }
        block event done-with-investigate {
            track main {
                lambda 
                    (wait 0.70)
                
                lambda 
                    (send-event enter-poi self (new-boxed-value 2 6))
                
            }
        }
        block event kill-map-sooner {
            track main {
                lambda 
                    (if (has-collected-treasure? collectible-sea-hub-map 0)) 
                        (mark-treasure-examined-by-id collectible-sea-hub-map 0)
                        (if (get-boolean is-completed? self)) 
                            (hud2-request-new-item-notification map-mark-update 0.00 0)
                         else 
                            (hud2-request-new-item-notification map-location-update 0.00 0)
                        
                    
                
                lambda 
                    (kill-entity (get-symbol temp-map self))
                
                lambda 
                    (kill-entity (get-symbol temp-marker self))
                
                lambda 
                    (joypad-force-command horse-dismount)
                
                lambda 
                    (interactable-enable horse)
                
                lambda 
                    (set-boolean looked? 0 self)
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (timer-running? kill-map-sooner self)) 
                        (disable-systemic-horse-rider-gestures/f player)
                        (set-player-horse-move-settings/f *horse-move-settings-trot*)
                        (player-investigate-on-tap/f)
                        (disable-interactable-interaction)
                        (if (not (get-boolean looked? self))) 
                            (player-investigate-no-enter/f)
                        
                        (if (> (get-timer-value kill-map-sooner self) 0.10)) 
                            (joypad-disable-commands horse-dismount)
                        
                    
                
                lambda 
                    (if (timer-running? kill-map self)) 
                        (disable-systemic-horse-rider-gestures/f player)
                        (set-player-horse-move-settings/f *horse-move-settings-trot*)
                        (disable-interactable-system)
                        (player-set-narrative-mode/f 0 0 *sea-writing-narrative-mode-settings*)
                        (player-allow-no-weapon-aim)
                        (player-disable-unholstering)
                        (player-disable-auto-unholster-on-aim)
                        (joypad-disable-commands horse-dismount aim-hold aim-press aim aim-hold-long interact inventory-open inventory-hold toggle-map inventory-press inventory-open-release)
                        (define var_2)
                        (if (joypad-command-active? horse-perch-exit 6)) 
                            (set! var_2 1)
                         else (if (joypad-command-active? interact-circle 6)) 
                            (set! var_2 1)
                         else 
                            (set! var_2 0)
                        
                        (if (and (and var_2 (player-on-horse? horse 1 1 1)) (! (get-boolean off-horse-once self)))) 
                            (set-boolean off-horse-once 1 self)
                            (if (> (get-timer-value kill-map self) 1.50)) 
                                (stop-timer kill-map self)
                                (clear-gesture-instantly player -1)
                                (animate_ (get-symbol temp-map self) ellie-map-sketch-horse-exit--map (#%alloc-array single-frame 16 0 1))
                                (animate_ (get-symbol temp-marker self) ellie-map-sketch-horse-exit--marker (#%alloc-array single-frame 16 0 1))
                                (start-timer kill-map-sooner 1.50 self 1)
                                (gesture_ player sea-map-horse-quick-exit-gesture (alloc-gesture-play-params))
                            
                        
                        (if (! (&& (player-in-state? Move) (player-on-horse? horse 1 1 1)))) 
                            (stop-timer kill-map self)
                            (clear-gesture-instantly player -1)
                            (kill-entity (get-symbol temp-map self))
                            (kill-entity (get-symbol temp-marker self))
                            (interactable-enable horse)
                            (if (has-collected-treasure? collectible-sea-hub-map 0)) 
                                (mark-treasure-examined-by-id collectible-sea-hub-map 0)
                                (if (get-boolean is-completed? self)) 
                                    (hud2-request-new-item-notification map-mark-update 0.00 0)
                                 else 
                                    (hud2-request-new-item-notification map-location-update 0.00 0)
                                
                            
                        
                    
                
                lambda 
                    (if (and (entity-exists? temp-map) (entity-exists? temp-marker))) 
                        (disable-interactable-interaction)
                    
                
            }
        }
    }
    state show-pos {
        block start {
            track main {
                lambda 
                    (if (script-in-state? ss-sea-horse-hotel-generator tutorial-map)) 
                        (set-table-shader-material-values-param *sea-horse-map-WLF* 0.00)
                        (set-table-shader-material-values-param *sea-horse-map-need-gas* 0.00)
                     else 
                        (set-table-shader-material-values-param *sea-horse-map-WLF* 0.25)
                        (set-table-shader-material-values-param *sea-horse-map-need-gas* 0.25)
                    
                
            }
        }
        block event designer-menu-changed {
            track main {
                lambda 
                    (if (deref (cast u8* *mburro-test*))) 
                        (for ([var_1 sea-horse-map-Q-layers]) 
                            (define var_2)
                            (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 7))) 
                                (set! var_2 (deref (cast u64* var_1)))
                             else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 5))) 
                                (set! var_2 (deref (cast u64* var_1)))
                             else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                                (set! var_2 (deref (cast u64* var_1)))
                             else 
                                (set! var_2 0)
                            
                            (set-table-shader-material-values-param var_2 0.25)
                        )
                     else 
                        (for ([var_5 sea-horse-map-Q-layers]) 
                            (define var_6)
                            (if (and var_5 (== (deref (cast u16* (+ var_5 12))) 7))) 
                                (set! var_6 (deref (cast u64* var_5)))
                             else (if (and var_5 (== (deref (cast u16* (+ var_5 12))) 5))) 
                                (set! var_6 (deref (cast u64* var_5)))
                             else (if (and var_5 (== (deref (cast u16* (+ var_5 12))) 4))) 
                                (set! var_6 (deref (cast u64* var_5)))
                             else 
                                (set! var_6 0)
                            
                            (define var_10)
                            (if (get-svar-bit sea-horse-poi-check (darray-find sea-horse-map-Q-layers (new-boxed-value 7 var_6) 0))) 
                                (set! var_10 0.25)
                             else 
                                (set! var_10 0.00)
                            
                            (set-table-shader-material-values-param var_6 var_10)
                        )
                    
                
                lambda 
                    (if (deref (cast u8* (+ *mburro-test* 1)))) 
                        (for ([var_1 sea-horse-map-X-layers]) 
                            (define var_2)
                            (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 7))) 
                                (set! var_2 (deref (cast u64* var_1)))
                             else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 5))) 
                                (set! var_2 (deref (cast u64* var_1)))
                             else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                                (set! var_2 (deref (cast u64* var_1)))
                             else 
                                (set! var_2 0)
                            
                            (set-table-shader-material-values-param var_2 0.25)
                        )
                     else 
                        (for ([var_5 sea-horse-map-X-layers]) 
                            (define var_6)
                            (if (and var_5 (== (deref (cast u16* (+ var_5 12))) 7))) 
                                (set! var_6 (deref (cast u64* var_5)))
                             else (if (and var_5 (== (deref (cast u16* (+ var_5 12))) 5))) 
                                (set! var_6 (deref (cast u64* var_5)))
                             else (if (and var_5 (== (deref (cast u16* (+ var_5 12))) 4))) 
                                (set! var_6 (deref (cast u64* var_5)))
                             else 
                                (set! var_6 0)
                            
                            (define var_10)
                            (if (get-svar-bit sea-horse-poi-check (darray-find sea-horse-map-X-layers (new-boxed-value 7 var_6) 0))) 
                                (set! var_10 0.25)
                             else 
                                (set! var_10 0.00)
                            
                            (set-table-shader-material-values-param var_6 var_10)
                        )
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (not (player-in-state? Investigate))) 
                        (set-single-shader-instance-param (get-symbol my-map self) blendOffset2 -1.00)
                        (go cross-off 1)
                    
                
                lambda 
                    (update-sea-hub-map-chevron pos-sea-hub-map-top-1 pos-sea-hub-map-bot-1)
                
                lambda 
                    (if (> (get-state-time self) 0.65)) 
                        (camera-override-near-clip/f 0.01)
                    
                
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
