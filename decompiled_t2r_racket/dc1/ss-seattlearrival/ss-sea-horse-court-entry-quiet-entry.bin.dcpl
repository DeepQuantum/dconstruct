statescript {
    options {
        player
    }
    state task-check {
        block start {
            track main {
                lambda 
                    (if (task-complete? seattle-arrival sea-hub-explore)) 
                        (go complete 1)
                    
                
                lambda 
                    (if (task-active? seattle-arrival sea-hub-explore)) 
                        (go wait-enter-courthouse 1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-active? seattle-arrival sea-hub-explore)) 
                        (go wait-enter-courthouse 1)
                    
                
            }
        }
    }
    state wait-enter-courthouse {
        block event entered-courthouse {
            track main {
                lambda 
                    (go stealthy-entrance 1)
                
            }
        }
    }
    state stealthy-entrance {
        block start {
            track main {
                lambda 
                    (set-focusable-ignore player 1)
                
                lambda 
                    (let loop () (when (not (player-in-state? Move)) 
                        (player-force-crouch)
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (player-force-crouch)
                
                lambda 
                    (set-focusable-ignore player 0)
                
                lambda 
                    (go swap-weapon-tutorial 1)
                
            }
        }
    }
    state swap-weapon-tutorial {
        block start {
            track main {
                lambda 
                    (wait 0.50)
                
                lambda 
                    (if (> (npc-group-alive-count all-infected-npcs) 0)) 
                        (wait-gui2-show-pause-card *tutorial-weapon-slotting* 0 1 2)
                    
                
                lambda 
                    (go wait-enter-courthouse 1)
                
            }
        }
    }
}
