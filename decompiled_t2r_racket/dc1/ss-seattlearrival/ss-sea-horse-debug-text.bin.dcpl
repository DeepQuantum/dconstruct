statescript {
    options {
        player
    }
    declarations {
        string vc1 = 
        string vc2 = 
        string vc3 = 
        string vc4 = 
        string hex = 
        f32 x-pos = 1013.00
        f32 x-s = 10.00
        f32 y-pos = 25.00
    }
    state task-check {
        block start {
            track main {
                lambda 
                    (if (task-complete? seattle-arrival sea-hub-explore)) 
                        (go already-complete 1)
                    
                
                lambda 
                    (if (task-active? seattle-arrival sea-hub-explore)) 
                        (go draw-text 1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-active? seattle-arrival sea-hub-explore)) 
                        (go draw-text 1)
                    
                
            }
        }
    }
    state draw-text {
        block start {
            track main {
                lambda 
                    (set-string vc1 (sea-horse-debug-letter (get-svar-as-boolean sea-horse-dome-stealth-infected)) self)
                
                lambda 
                    (set-string vc2 (sea-horse-debug-letter (get-svar-as-boolean vox-sea-hub-leave-court-house)) self)
                
                lambda 
                    (set-string vc3 (sea-horse-debug-letter (get-svar-as-boolean sea-horse-mil-jacket-found)) self)
                
                lambda 
                    (set-string vc4 (sea-horse-debug-letter (get-svar-as-boolean sea-horse-code-found)) self)
                
                lambda 
                    (set-string hex (sea-horse-debug-hex (get-svar sea-horse-poi-count)) self)
                
            }
        }
        block event recheck {
            track main {
                lambda 
                    (set-string vc1 (sea-horse-debug-letter (get-svar-as-boolean sea-horse-dome-stealth-infected)) self)
                
                lambda 
                    (set-string vc2 (sea-horse-debug-letter (get-svar-as-boolean vox-sea-hub-leave-court-house)) self)
                
                lambda 
                    (set-string vc3 (sea-horse-debug-letter (get-svar-as-boolean sea-horse-mil-jacket-found)) self)
                
                lambda 
                    (set-string vc4 (sea-horse-debug-letter (get-svar-as-boolean sea-horse-code-found)) self)
                
                lambda 
                    (set-string hex (sea-horse-debug-hex (get-svar sea-horse-poi-count)) self)
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (is-focus-test?)) 
                        (debug-draw-string-2d (alloc-point (get-float x-pos self) (get-float y-pos self) 0.00 0) (get-string vc1 self) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point (+ (get-float x-pos self) (get-float x-s self)) (get-float y-pos self) 0.00 0) (get-string vc2 self) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point (+ (get-float x-pos self) (* 2.00 (get-float x-s self))) (get-float y-pos self) 0.00 0) (get-string hex self) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point (+ (get-float x-pos self) (* 3.00 (get-float x-s self))) (get-float y-pos self) 0.00 0) (get-string vc3 self) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point (+ (get-float x-pos self) (* 4.00 (get-float x-s self))) (get-float y-pos self) 0.00 0) (get-string vc4 self) 1 0.00 1.00 1 0 0 1.00)
                    
                
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
