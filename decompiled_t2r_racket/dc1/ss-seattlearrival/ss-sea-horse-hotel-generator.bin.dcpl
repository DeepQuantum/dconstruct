                        (override-render-settings *sea-rs-sea-hub-igc-generator-east-two* 1.00 1.00 0 32767 0 1 0 1.00)
                    
                
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda 
                    (interactable-disable int-sea-hub-hotel-generator-1)
                
                lambda 
                    (animate-start obj-sea-horse-checkpoint-gate-4 sea-hub-open-checkpoint-gate--gate pos-sea-horse-checkpoint-open-1 0)
                
                lambda 
                    (player-remove-key-item gas-canister-full)
                
                lambda 
                    (player-remove-key-item gas-canister-empty)
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
