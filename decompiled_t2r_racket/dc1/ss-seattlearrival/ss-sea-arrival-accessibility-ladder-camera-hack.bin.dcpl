statescript {
    options {
        player
        sea-arrival-accessibility
    }
    declarations {
    }
    state wait-for-ladder-mount {
        block event player-changed-state {
            track main {
                lambda 
                    (if (and (and (== (event-arg-symbol 0) Ladder) (== (event-arg-symbol 1) Move)) (player-in-region? self 2))) 
                        (go adjust-camera 1)
                    
                
            }
        }
    }
    state adjust-camera {
        block start {
            track main {
                lambda 
                    (if (is-auto-traversal-accessibility?)) 
                        (camera-look-at-locator (get-spawner-locator (tag-symbol camera-look-at self) 1) 1.00 5.00)
                    
                
                lambda 
                    (let loop () (when (not (not (player-in-state? Ladder))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (go wait-for-ladder-mount 1)
                
            }
        }
    }
}
