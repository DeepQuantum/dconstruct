                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 2 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_0) (* 2 8))) 8))) 0.50)
                    (animate_ sea-hub-court-garage-door-light-object-1 sea-hub-court-garage-door-success--ellie--light-skel var_0)
                
                lambda 
