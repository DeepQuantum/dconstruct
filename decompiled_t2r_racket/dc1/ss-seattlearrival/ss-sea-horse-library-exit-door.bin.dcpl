                lambda 
                    (if (is-ultrawide?)) 
                        (wait-until-anim-frame player sea-hub-court-garage-door-success--ellie 585.00 2)
                        (set-boolean uw-fix? 1 self)
                        (wait-until-anim-frame player sea-hub-court-garage-door-success--ellie 868.00 2)
                        (set-boolean uw-fix? 0 self)
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (== (get-boolean uw-fix? self) 0)) 
                        (camera-override-near-clip/f 0.01)
                    
                
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda 
