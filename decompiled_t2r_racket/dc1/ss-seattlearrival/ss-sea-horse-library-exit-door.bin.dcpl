                    (wait-animate_ player sea-hub-court-garage-door-success--ellie var_0)
                
                lambda 
                    (stop-animating dina 2 0.50 sea-hub-court-garage-door-success--dina 0)
                
                lambda 
                    (camera-fade-out-animated 2.00 0)
                
                lambda 
                    (send-event hotel-hint ss-sea-horse-crit-hints-1)
                
                lambda 
                    (player-disable-dialog-look-gestures 4.00)
                
                lambda 
                    (npc-request-explore dina 0 0 *buddy-post-selector-set* 12.00 0 *default-ai-explore-follow-settings* 0)
                
                lambda 
                    (kill-entity sea-hub-court-garage-door-light-object-1)
                
                lambda 
