                lambda 
                    (wait-until-anim-frame obj-sea-horse-court-roller-door-1 sea-hub-court-garage-door-success--door 46.00 2)
                
                lambda 
                    (play-sound-at-position sfx-igc-sea-hub-court-garage-door-success--chain-2 (get-spawner-position pos-snd-court-exit-door-chain-1 1) 0 0)
                
            }
