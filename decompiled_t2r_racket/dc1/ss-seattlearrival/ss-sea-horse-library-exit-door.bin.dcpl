            }
            track light {
                lambda 
                    (wait-frames 230)
                
                lambda 
                    (wait-set-light-process-intensity rt-igc-garage-doorShape 30.00 0.00 4.40)
                
            }
            track rumble {
                lambda 
                    (if (not (joypad-has-haptics? 2))) 
                        (wait-rumble 0.20 1.60)
                        (wait-frames 128)
                        (wait-rumble 0.20 1.30)
                        (wait-rumble 0.10 5.50)
                    
                
            }
            track haptics {
                lambda 
                    (if (joypad-has-haptics? 2)) 
                        (set-int32 push-haptic-pid (play-hfx-id push-object-haptic-effect 0 2) self)
                        (let loop () (when (not (object-anim-reached-frame? player sea-hub-court-garage-door-success--ellie 48.00 2)) 
                            (hfx-continue (get-int32 push-haptic-pid self))
                            (wait-one-frame)
                         (loop)))
                        (wait-until-anim-frame player sea-hub-court-garage-door-success--ellie 176.00 2)
                        (set-int32 push-haptic-pid (play-hfx-id push-object-haptic-effect 0 2) self)
                        (let loop () (when (not (object-anim-reached-frame? player sea-hub-court-garage-door-success--ellie 215.00 2)) 
                            (hfx-continue (get-int32 push-haptic-pid self))
                            (wait-one-frame)
                         (loop)))
                        (play-hfx-id boom-haptic 0 2)
                        (wait-until-anim-frame player sea-hub-court-garage-door-success--ellie 368.00 2)
                        (play-hfx-id soft-boom-haptic 0 2)
                        (wait-until-anim-frame player sea-hub-court-garage-door-success--ellie 445.00 2)
                        (play-hfx-id high-five-haptic 0 2)
                        (wait-until-anim-frame player sea-hub-court-garage-door-success--ellie 484.00 2)
                        (play-hfx-id high-five-haptic 0 2)
                    
                
            }
