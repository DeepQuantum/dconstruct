                             else (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 5))) 
                                (set! var_3 (deref (cast u64* var_2)))
                             else (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 4))) 
                                (set! var_3 (deref (cast u64* var_2)))
                             else 
                                (set! var_3 0)
                            
                            (if (npc-alive? var_3)) 
                                (if (not (locator-in-region? (alloc-bound-frame (npc-get-entity-position var_3 player) 0 0 0 0) rgn-joe-opening-room-1 player))) 
                                    (set! var_8 (set-boolean end-flank-tutorial 1 self))
                                
                            
                        )
                        (wait 0.25)
                     (loop)))
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (not (get-boolean end-flank-tutorial self))) 
                        (for ([var_2 joe-npcs-first-wave]) 
                            (define var_3)
                            (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 7))) 
                                (set! var_3 (deref (cast u64* var_2)))
                             else (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 5))) 
                                (set! var_3 (deref (cast u64* var_2)))
                             else (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 4))) 
                                (set! var_3 (deref (cast u64* var_2)))
                             else 
                                (set! var_3 0)
                            
                            (if (npc-alive? var_3)) 
                                (if (not (locator-in-region? (alloc-bound-frame (npc-get-entity-position var_3 player) 0 0 0 0) rgn-joe-opening-room-1 player))) 
                                    (set! var_8 (set-boolean end-flank-tutorial 1 self))
                                
                            
                        )
                        (if (player-is-aiming?)) 
                            (set-float last-player-aim (get-current-time 0) self)
                        
                    
                
                lambda 
                    (if (and (not (== (get-symbol dina-kill-npc self) 0)) (npc-alive? (get-symbol dina-kill-npc self)))) 
                        (if (npc-can-see? (get-symbol dina-kill-npc self) dina)) 
                            (npc-set-targeting-params (get-symbol dina-kill-npc self) always-target-buddies)
                         else 
                            (npc-set-targeting-params (get-symbol dina-kill-npc self) always-target-player)
                        
                    
                
                lambda 
                    (if (and (or (or (or (timer-running? flank-prot-timer self) (player-is-aiming?)) (player-in-state? Move)) (player-in-state? Prone)) (not 0))) 
                        (stop-timer flank-prot-timer self)
                    
                
                lambda 
                    (disallow-normal-tension)
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (if (darray-contains? joe-npcs-first-wave (new-boxed-value 7 (event-arg-symbol 0)))) 
                        (if (not (player-in-region? rgn-joe-opening-room-1 2))) 
                            (set-boolean end-flank-tutorial 1 self)
                        
                        (if (== (npc-group-alive-count joe-npcs-first-wave) 1)) 
                            (for ([var_6 joe-npcs-first-wave]) 
                                (define var_7)
                                (if (and var_6 (== (deref (cast u16* (+ var_6 12))) 7))) 
                                    (set! var_7 (deref (cast u64* var_6)))
                                 else (if (and var_6 (== (deref (cast u16* (+ var_6 12))) 5))) 
                                    (set! var_7 (deref (cast u64* var_6)))
                                 else (if (and var_6 (== (deref (cast u16* (+ var_6 12))) 4))) 
                                    (set! var_7 (deref (cast u64* var_6)))
                                 else 
                                    (set! var_7 0)
                                
                                (if (npc-alive? var_7)) 
                                    (if (not (npc-buddy-has-kill-token? dina))) 
                                        (npc-buddy-give-kill-token dina)
                                    
                                    (set-symbol dina-kill-npc var_7 self)
                                    (npc-set-perfect-aim dina 1)
                                    (npc-force-target dina var_7)
                                    (unleash-buddy-against-npc dina var_7)
                                    (npc-set-targeting-params var_7 always-target-buddies)
                                    (npc-set-combat-params var_7 *joe-pistol-aggressive-combat-params*)
                                
                            )
                        
                    
                
            }
        }
        block event npc-attacked {
            track main {
                lambda 
                    (if (and (darray-contains? joe-npcs-first-wave (new-boxed-value 7 (event-arg-symbol 1))) (not (player-in-region? rgn-joe-opening-room-1 2)))) 
                        (set-boolean end-flank-tutorial 1 self)
                    
                
            }
        }
        block event player-fired-weapon {
            track main {
                lambda 
                    (if (not (player-in-region? rgn-joe-opening-room-1 2))) 
                        (set-boolean end-flank-tutorial 1 self)
                    
                
            }
        }
        block event player-threw-projectile {
            track main {
                lambda 
                    (if (and (or (or (not (player-in-region? rgn-joe-opening-room-1 2)) (== (event-arg-symbol 2) molotov)) (== (event-arg-symbol 2) stun-bomb)) (== (event-arg-symbol 2) smoke-bomb))) 
                        (set-boolean end-flank-tutorial 1 self)
                    
                
            }
        }
        block event player-died {
            track main {
                lambda 
                    (if (> (get-post-death-tip-age TIP_GENERAL_FLANK_THEM) 180.00)) 
                        (promote-post-death-tip TIP_GENERAL_FLANK_THEM 1)
                    
                
            }
        }
        block event one-time-flank-protection {
            track main {
                lambda 
                    (if (and (get-boolean flank-protection self) (not (get-boolean end-flank-tutorial self)))) 
                        (start-timer flank-prot-timer 3.00 self 1)
                        (set-boolean flank-protection 1 self)
                    
                
            }
        }
        block end {
            track main {
                lambda 
                    (if (entity-exists? dina)) 
                        (npc-force-target dina 0)
                    
                
            }
        }
    }
    state combat-done {
        block start {
            track main {
                lambda 
                    (if (not (get-boolean from-task-in? self))) 
                        (npc-set-perfect-aim dina 0)
                        (npc-enable-reload dina 1)
                        (npc-set-script-high-priority dina)
                        (npc-clear-zone dina)
                        (npc-cancel-fire-command dina)
                        (npc-clear-look-aim-at dina)
                        (npc-clear-look-at dina)
                        (send-event allow-idle-in-cover dina)
                        (send-event default-idle-in-cover dina)
                    
                
                lambda 
                    (if (and (get-boolean from-task-in? self) (not (get-svar-as-boolean joe-classroom-done)))) 
                        (for ([var_3 joe-npcs-first-wave]) 
                            (define var_4)
                            (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 7))) 
                                (set! var_4 (deref (cast u64* var_3)))
                             else (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 5))) 
                                (set! var_4 (deref (cast u64* var_3)))
                             else (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 4))) 
                                (set! var_4 (deref (cast u64* var_3)))
                             else 
                                (set! var_4 0)
                            
                            (if (is-npc-in-checkpoint? var_4)) 
                                (spawn-npc var_4 0 0)
                            
                        )
                    
                
                lambda 
                    (for ([var_1 joe-npcs-first-wave]) 
                        (define var_2)
                        (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 7))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 5))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else 
                            (set! var_2 0)
                        
                        (if (npc-alive? var_2)) 
                            (npc-clear-zone var_2)
                            (npc-set-script-low-priority var_2)
                        
                    )
                
                lambda 
                    (if (and (task-continue-active? jordan-escape joe-school-fight default) (task-continue-active? jordan-escape joe-school-fight classroom-done))) 
                        (let loop () (when (not (player-in-region? rgn-joe-corridor-start-1 2)) 
                            (wait-one-frame)
                         (loop)))
                        (if (get-svar-as-boolean joe-classroom-done)) 
                            (task-set-active-continue-safely! corridor-start 1 0)
                            (go done 1)
                        
                    
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (if (and (darray-contains? joe-npcs-first-wave (new-boxed-value 7 (event-arg-symbol 0))) (== (npc-group-alive-count joe-npcs-first-wave) 0))) 
                        (set-svar-as-boolean joe-classroom-done 1)
                        (go done 1)
                    
                
            }
        }
    }
}
