                lambda 
                    (go complete 1)
                
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda 
                    (animate-done door-open-single-glass-1 joe-school-dina-door-key-courtyard-success--door ap-joe-dina-door-key-courtyard-1 0 0 2)
                
            }
        }
    }
}
