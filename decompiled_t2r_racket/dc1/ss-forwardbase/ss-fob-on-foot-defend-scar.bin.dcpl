    }
    state clean-up {
        block start {
            track main {
                lambda 
                    (if (>= (get-int32 group-index self) 0)) 
                        (define var_2 (darray-at fob-defend-assault-positions (get-int32 group-index self)))
                        (define var_3)
                        (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 7))) 
                            (set! var_3 (deref (cast u64* var_2)))
                         else (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 5))) 
                            (set! var_3 (deref (cast u64* var_2)))
                         else (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 4))) 
                            (set! var_3 (deref (cast u64* var_2)))
                         else 
                            (set! var_3 0)
                        
                        (darray-find-remove fob-defend-assault-positions-taken (new-boxed-value 7 var_3) 0)
                    
                
                lambda 
                    (if (get-boolean ready-for-assault self)) 
                        (-- num-assaulters-ready ss-fob-on-foot-defend-v2-1)
                    
                
                lambda 
                    (go done 1)
                
            }
        }
    }
}
