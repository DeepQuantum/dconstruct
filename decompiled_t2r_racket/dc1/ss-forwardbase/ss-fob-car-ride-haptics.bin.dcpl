    (set-float display-speed (* (get-float velocity self) 2.23) self)
    (/ (get-float display-speed self) (get-float max-display-speed self))
)

(define (get-rpm-target-phase) 
    (define var_1)
    (if (get-boolean breaking? self)) 
        (set! var_1 (curve-scale 0.00 (get-float break-speed self) 0.00 0.35 (get-float display-speed self) 4))
     else (if (< (get-float display-speed self) 25.00)) 
        (set! var_1 (curve-scale 0.00 20.00 0.00 0.32 (get-float display-speed self) 4))
     else (if (< (get-float display-speed self) 40.00)) 
        (set! var_1 (curve-scale 20.00 40.00 0.20 0.35 (get-float display-speed self) 4))
     else (if (< (get-float display-speed self) 50.00)) 
        (set! var_1 (curve-scale 40.00 50.00 0.25 0.35 (get-float display-speed self) 4))
     else (if (< (get-float display-speed self) 80.00)) 
        (set! var_1 (curve-scale 50.00 100.00 0.25 0.50 (get-float display-speed self) 4))
     else 
        (set! var_1 0)
    
    var_1
)

(define (update-car-velocity) 
    (set-bound-frame pos (get-object-locator (get-symbol car-object self)) self)
    (set-float velocity (/ (get-locator-distance (get-bound-frame pos self) (get-bound-frame pos-prev self)) (get-delta-time)) self)
    (set-bound-frame pos-prev (get-bound-frame pos self) self)
)

(define (update-speedometer-display) 
    (var-approach-target speedometer-phase (get-speedometer-target-phase) 0.00 0.00 1.00)
    (var-approach-target rpm-phase (get-rpm-target-phase) 0.00 0.00 1.00)
    (define var_6)
    (if (get-boolean pavement? self)) 
        (set! var_6 1.00)
     else 
        (set! var_6 1.30)
    
    (hfx-ramp-internal (get-int32 car-rumble self) 0 0 (alloc-parameter-ramp-internal (* (lerp-scale 0.00 60.00 0.02 0.15 (get-float display-speed self)) var_6) 0.00 (/ 256.00 48000.00) 0.00 1 0.00 0) 1)
    (hfx-ramp-internal (get-int32 car-rumble self) 0 1 (alloc-parameter-ramp-internal (lerp-scale 0.00 1.00 30.00 60.00 (get-float rpm-phase self)) 0.00 (/ 256.00 48000.00) 0.00 1 0.00 0) 1)
)

