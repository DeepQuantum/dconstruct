(define (test-in-left-plus-front-range?) 
    (&& (float-in-range? (get-float view-angle self) -90.00 0.00) (not (get-boolean in-deadzone self)))
)

(define (test-update-deadzone-state) 
    (set-boolean in-deadzone (&& (float-in-range? (get-float view-angle self) (get-float origin-angle self) (get-float adjusted-origin-angle self)) (float-in-range? (get-float view-angle self) (get-float adjusted-target-angle self) (get-float target-angle self))) self)
)

(define (test-in-front-plus-right-range?) 
    (&& (float-in-range? (get-float view-angle self) 0.00 90.00) (not (get-boolean in-deadzone self)))
)

(define (test-update-zone-data arg_0 arg_1) 
    (set-float origin-angle arg_0 self)
    (set-float target-angle arg_1 self)
    (set-float adjusted-origin-angle (+ arg_0 (get-float deadzone-angle self)) self)
    (set-float adjusted-target-angle (- arg_1 (get-float deadzone-angle self)) self)
)

(define (test-in-right-plus-back-range?) 
    (&& (float-in-range? (get-float view-angle self) 90.00 180.00) (not (get-boolean in-deadzone self)))
)

(define (test-update-blend-amount) 
    (set-float blend-amount (/ (- (get-float view-angle self) (get-float adjusted-origin-angle self)) (- (get-float adjusted-target-angle self) (get-float adjusted-origin-angle self))) self)
    (define var_7)
    (if (> (get-float blend-amount self) 1.00)) 
        (set! var_7 (set-float blend-amount 1.00 self))
     else (if (< (get-float blend-amount self) 0.00)) 
        (set! var_7 (set-float blend-amount 0.00 self))
     else 
        (set! var_7 0)
    
    var_7
)

(define (test-in-back-plus-left-range?) 
    (&& (float-in-range? (get-float view-angle self) -180.00 -90.00) (not (get-boolean in-deadzone self)))
)

