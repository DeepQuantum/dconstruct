                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 0 8))))) 10)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) 0)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) (get-joint-parented-bound-frame obj-fob-car-test-1 body_up))
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 1 8))))) 14)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 1 8))) 8))) 0)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 1 8))) 8))) apReference-truck)
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 2 8))))) 28)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 2 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_0) (* 2 8))) 8))) 0.50)
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 3 8))))) 31)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 3 8))) 8))) 0)
                    (set! (deref (cast u8* (+ (deref (+ (deref var_0) (* 3 8))) 8))) 1)
                    (animate_ mel fob-car-ride-convo-spline--mel var_0)
                
                lambda 
                    (set-symbol camera-a *camera-strafe-fob-car-look-forward* self)
                
                lambda 
                    (set-symbol camera-b *camera-strafe-fob-car-look-right* self)
                
                lambda 
                    (set-symbol zoom-camera-a *camera-strafe-fob-car-look-forward-zoom* self)
                
                lambda 
                    (set-symbol zoom-camera-b *camera-strafe-fob-car-look-right-zoom* self)
                
                lambda 
                    (wait 1.00)
                
                lambda 
                    (send-event enable-camera-parenting obj-fob-car-test-1)
                
                lambda 
                    (test-update-view-angle)
                
                lambda 
                    (go camera-set 1)
                
            }
        }
    }
    state camera-set {
        block update {
            track main {
                lambda 
                    (joypad-set-stick-scale camera 0.33)
                
                lambda 
                    (test-update-view-angle)
                
                lambda 
                    (test-update-deadzone-state)
                
                lambda 
                    (if (test-in-left-plus-front-range?)) 
                        (test-update-zone-data -90.00 0.00)
                        (set-symbol camera-a *camera-strafe-fob-car-close-look-left* self)
                        (set-symbol camera-b *camera-strafe-fob-car-look-forward* self)
                        (set-symbol zoom-camera-a *camera-strafe-fob-car-close-look-left-zoom* self)
                        (set-symbol zoom-camera-b *camera-strafe-fob-car-look-forward-zoom* self)
                     else (if (test-in-front-plus-right-range?)) 
                        (test-update-zone-data 0.00 90.00)
                        (set-symbol camera-a *camera-strafe-fob-car-look-forward* self)
                        (set-symbol camera-b *camera-strafe-fob-car-look-right* self)
                        (set-symbol zoom-camera-a *camera-strafe-fob-car-look-forward-zoom* self)
                        (set-symbol zoom-camera-b *camera-strafe-fob-car-look-right-zoom* self)
                     else (if (test-in-right-plus-back-range?)) 
                        (test-update-zone-data 90.00 180.00)
                        (set-symbol camera-a *camera-strafe-fob-car-look-right* self)
                        (set-symbol camera-b *camera-strafe-fob-car-look-backward* self)
                        (set-symbol zoom-camera-a *camera-strafe-fob-car-look-right-zoom* self)
                        (set-symbol zoom-camera-b *camera-strafe-fob-car-look-backward-zoom* self)
                     else (if (test-in-back-plus-left-range?)) 
                        (test-update-zone-data -180.00 -90.00)
                        (set-symbol camera-a *camera-strafe-fob-car-look-backward* self)
                        (set-symbol camera-b *camera-strafe-fob-car-close-look-left* self)
                        (set-symbol zoom-camera-a *camera-strafe-fob-car-look-backward-zoom* self)
                        (set-symbol zoom-camera-b *camera-strafe-fob-car-close-look-left-zoom* self)
                    
                
                lambda 
                    (test-update-blend-amount)
                
                lambda 
                    (set-car-camera (get-symbol camera-a self) (get-symbol camera-b self) (get-float blend-amount self))
                
                lambda 
                    (set-car-zoom-camera (get-symbol zoom-camera-a self) (get-symbol zoom-camera-b self) (get-float blend-amount self))
                
                lambda 
                    (define var_1)
                    (if (joypad-command-active? aim 6)) 
                        (set! var_1 1)
                     else 
                        (set! var_1 0)
                    
                    (if var_1) 
                        (camera-set-overlay *camera-remap-strafe-fob-car-zoom* 1 0.50)
                     else 
                        (camera-set-overlay *camera-remap-strafe-fob-car* 1 0.50)
                    
                
            }
        }
    }
}
