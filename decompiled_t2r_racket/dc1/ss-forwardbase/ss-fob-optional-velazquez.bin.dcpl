(define (*give-player-pistol-xcaliber* arg_0 arg_1) 
    (define var_1)
    (if (and arg_0 (> (get-animation-phase player 0 arg_1) 0.50))) 
        (log-event "player-found-weapon" 1 "pistol-xcaliber" 0 0)
        (give-player-weapon pistol-xcaliber (deref (cast i32* (+ (get-difficulty-detail-resources) 156))) 0)
        (player-inv-selection-replace-item (weapon-slot-to-player-inv-selection-slot 2) pistol-xcaliber)
        (set-visible investigate-weapon-xcaliber-1 0)
        (interactable-disable investigate-weapon-xcaliber-1)
        (set-visible (player-get-weapon-instance 2) 1)
        (enable-collision-gamedriven investigate-weapon-xcaliber-1 0 0.00)
        (hud2-request-new-item-notification pistol-xcaliber 0.00 0)
        (set! var_1 1)
     else 
        (set! var_1 0)
    
    var_1
)

