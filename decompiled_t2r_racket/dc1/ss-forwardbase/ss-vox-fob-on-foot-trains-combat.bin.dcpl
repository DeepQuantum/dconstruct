                        (wait-say manny vox-igc-man-gam-fob-on-foot-trains-combat-done-sp-003 2 0)
                        (send-event mel-start-lead ss-fob-on-foot-trains-combat-1)
                     else (if (tension-mode-is? 3)) 
                        (wait-say player vox-igc-abb-gam-fob-on-foot-trains-combat-pr-009 2 0)
                        (wait-say manny vox-igc-man-gam-fob-on-foot-trains-combat-pr-006 2 0)
                     else 
                        (wait-say player vox-igc-abb-gam-fob-on-foot-trains-combat-wh-007 2 0)
                    
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
    }
    state mel-hints-exit {
        block start {
            track main {
                lambda 
                    (set-boolean vox-exit-callout 1 self)
                
                lambda 
                    (wait 0.50)
                
                lambda 
                    (wait-say mel vox-igc-mel-gam-fob-on-foot-trains-combat-wh-002 2 0)
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
    }
    state train-yard-climb-to-exit {
        block start {
            track main {
                lambda 
                    (let loop () (when (not (! (player-in-state? Ladder))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (if (and (get-boolean player-exit-trainyard ss-fob-on-foot-trains-combat-1) (not (player-in-region? rgn-vox-fob-trains-exit-boxes-1 2)))) 
                        (go wait-for-event 1)
                    
                
                lambda 
                    (set-boolean vox-exit-callout 1 self)
                
                lambda 
                    (if (> (num-living-enemy-npcs) 0)) 
                        (if (tension-mode-is? 3)) 
                            (wait-say player vox-igc-abb-gam-fob-on-foot-trains-combat-pr-010 2 0)
                        
                     else 
                        (wait-say player vox-igc-abb-gam-fob-on-foot-trains-combat-done-sp-006 2 0)
                    
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
    }
    state cmon-girl {
        block start {
            track main {
                lambda 
                    (set-boolean vox-cmon-girl 1 self)
                
                lambda 
                    (npc-look-at-object mel alice targHead 5.00)
                
                lambda 
                    (wait 0.50)
                
                lambda 
                    (wait-say mel vox-igc-mel-gam-fob-on-foot-call-alice-001 2 0)
                
                lambda 
                    (npc-clear-look-at mel)
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
    }
    state mel-spots-fob {
        block start {
            track main {
                lambda 
                    (set-boolean vox-mel-spots-fob 1 self)
                
                lambda 
                    (wait-until-done-speaking mel)
                
                lambda 
                    (wait-for mel-turned)
                
                lambda 
                    (wait 0.30)
                
                lambda 
                    (signal point 0)
                
                lambda 
                    (if (distance-between-objects-greater-than? player int-fob-on-foot-enter-gas-1 5.00 1)) 
                        (wait-say mel vox-igc-mel-gam-fob-on-foot-trains-combat-done-sp-002 2 0)
                        (if (not (< (get-camera-angle-to-locator (get-spawner-locator look-fob-trains-forward-base-1 1)) 15.00))) 
                            (interactable-enable look-fob-trains-forward-base-1)
                        
                        (wait 0.50)
                    
                
                lambda 
                    (set-boolean mel-idle-at-door 1 ss-fob-on-foot-trains-combat-1)
                
                lambda 
                    (go wait-for-event 1)
                
            }
            track performance {
                lambda 
                    (wait-npc-turn-to mel (get-spawner-position pos-trains-exit-fob-direction-1 1) 0 0)
                
                lambda 
                    (signal mel-turned 0)
                
                lambda 
                    (npc-look-at-point mel (get-spawner-position pos-trains-exit-fob-direction-1 1) 5.00)
                
                lambda 
                    (wait-for point)
                
                lambda 
                    (point-to-point mel (get-spawner-position pos-trains-exit-fob-direction-1 1) 12 0)
                
            }
        }
        block update {
            track main {
                lambda 
                    (suppress-move-performances mel)
                
            }
        }
    }
    state manny-hears-scars {
        block start {
            track main {
                lambda 
                    (set-boolean vox-manny-hears-scars 1 self)
                
                lambda 
                    (set-boolean vox-mel-spots-fob 1 self)
                
                lambda 
                    (wait-say vox-fob-on-foot-defend-scar-whistler-1 vox-event-ai-gen-enmy-invstgt-start-annc-whstl 2 0)
                
                lambda 
                    (wait 0.50)
                
                lambda 
                    (say vox-fob-on-foot-defend-scar-whistler-2 vox-event-ai-gen-enmy-invstgt-start-pair-whstl 2 0)
                
                lambda 
                    (wait 1.00)
                
                lambda 
                    (wait-say manny vox-igc-man-gam-fob-on-foot-trains-combat-done-slf-004 2 0)
                    (if (or (and (or (distance-between-objects-less-than? player manny 12.00) (distance-between-objects-greater-than? player int-fob-on-foot-enter-gas-1 4.00 1)) (! (facing-point-xz? (get-object-locator player) (get-object-locator int-fob-on-foot-enter-gas-1) 120.00))) (distance-between-objects-greater-than? player int-fob-on-foot-enter-gas-1 4.00 1))) 
                        (if (! (facing-point-xz? (get-object-locator player) (get-object-locator int-fob-on-foot-enter-gas-1) 120.00))) 
                            (wait-say manny vox-igc-man-gam-fob-on-foot-trains-combat-done-sp-005 2 0)
                            (wait 0.50)
                        
                    
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
    }
}
