                             else (if (and var_7 (== (deref (cast u16* (+ var_7 12))) 4))) 
                                (set! var_8 (deref (cast u64* var_7)))
                             else 
                                (set! var_8 0)
                            
                            (if (npc-alive? var_8)) 
                                (npc-set-script-low-priority var_8)
                            
                        )
                    
                
            }
        }
        block event exit-igc-start {
            track main {
                lambda 
                    (set-boolean exit-igc-start 1 self)
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-complete? santa-barbara san-streets-resort-pool)) 
                        (go cleanup 1)
                    
                
            }
        }
    }
    state combat-done {
        block start {
            track main {
                lambda 
                    (let loop () (when (not (can-set-combat-checkpoints?)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (set-combat-checkpoint santa-barbara san-streets-resort-pool combat-done 0 0)
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-complete? santa-barbara san-streets-resort-pool)) 
                        (go cleanup 1)
                    
                
            }
        }
    }
    state cleanup {
        block start {
            track main {
                lambda 
                    (group-kill-entity san-pool-outside-npcs 0)
                
                lambda 
                    (group-kill-entity san-pool-inside-npcs 0)
                
                lambda 
                    (group-kill-entity san-pool-inside-reinf 0)
                
                lambda 
                    (group-kill-entity san-pool-upstairs-npcs 0)
                
                lambda 
                    (group-kill-entity san-pool-landing-npcs 0)
                
                lambda 
                    (group-kill-entity san-pool-landing-reinf 0)
                
                lambda 
                    (group-kill-entity san-pool-landing-reinf-2 0)
                
                lambda 
                    (group-kill-entity san-pool-chained-infected 0)
                
                lambda 
                    (group-kill-entity san-pool-landing-pursuers 0)
                
                lambda 
                    (for ([var_1 san-pool-hardpoints]) 
                        (define var_2)
                        (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 7))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 5))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else 
                            (set! var_2 0)
                        
                        (set-hardpoint-disabled var_2)
                    )
                
                lambda 
                    (go done 1)
                
            }
        }
    }
}
