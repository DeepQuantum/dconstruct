statescript {
    options {
        player
    }
    declarations {
        i32 struggle-haptic = -1
    }
    state wait-meatshield {
        block start {
            track main {
                lambda 
                    (let loop () (when (not (player-in-meatshield-sequence? 1)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
