    state struggling {
        block start {
            track main {
                lambda 
                    (let loop () (when (and (or (player-in-state? GrappleNpc) (player-in-state? GunMoveGrappleNpc)) (not (> (- (get-current-time 0) (get-current-time 0)) 3.00))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (let loop () (when (and (or (player-in-meatshield-sequence? 1) (player-in-state? GrappleNpc)) (player-in-state? GunMoveGrappleNpc)) 
                        (if (< (get-int32 struggle-haptic self) 0)) 
                            (set-int32 struggle-haptic (play-hfx-id meatshield-struggle-haptic 0 2) self)
                        
                        (hfx-continue (get-int32 struggle-haptic self))
                        (hfx-set-gain-scale (get-int32 struggle-haptic self) (lerp-scale 0.00 1.00 0.20 2.00 (get-meatshield-struggle-percentage)))
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (if (> (get-int32 struggle-haptic self) -1)) 
                        (hfx-stop (get-int32 struggle-haptic self))
                    
                
                lambda 
