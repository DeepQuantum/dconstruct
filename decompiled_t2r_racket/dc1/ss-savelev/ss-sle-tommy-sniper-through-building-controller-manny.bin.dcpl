                    (wait-npc-move-to-spawner manny pos-sniper-manny-elevator-wait-1 2 1 0 0 0 0 0)
                
                lambda 
                    (wait 1.00)
                
                lambda 
                    (go aim-at-door 1)
                
            }
        }
    }
    state aim-at-door {
        block start {
            track progression {
                lambda 
                    (set-boolean manny-waiting-at-elevator 1 ss-vox-sle-tommy-sniper-through-building-1)
                
                lambda 
                    (wait-boolean player-interacted-with-elevator 1 self)
                
                lambda 
                    (go clean-up 1)
                
            }
            track looks {
                lambda 
                    (let loop () (when 1 
                        (let loop () (when (and (is-speaking? manny) (not (> (- (get-current-time 0) (get-current-time 0)) (random-float-range 3.00 6.00 0)))) 
                            (wait-one-frame)
                         (loop)))
                        (npc-clear-look-aim-at manny)
                        (wait-one-frame)
                        (npc-look-at-object manny player headb -1.00)
                        (wait (random-float-range 1.50 2.50 0))
                     (loop)))
                
            }
        }
        block end {
            track main {
                lambda 
                    (npc-clear-look-aim-at manny)
                
            }
        }
    }
    state clean-up {
        block start {
            track main {
                lambda 
                    (npc-weapon-down manny)
                
                lambda 
                    (npc-clear-aim-at manny)
                
                lambda 
                    (npc-cancel-fire-command manny)
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
