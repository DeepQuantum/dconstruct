                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) (get-spawner-locator cin-sle-tommy-winning-2 1))
                    (animate_ door-tommy-fight-restaurant-left-1 door=cin-sle-tommy-winning var_0)
                
                lambda 
                    (define var_0 (#%alloc-array single-frame 16 1 1))
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 0 8))))) 10)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) 0)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) (get-spawner-locator cin-sle-tommy-winning-2 1))
                    (animate_ obj-sle-tommy-winning-restaurant-railing-2 restaurant-railing=cin-sle-tommy-winning var_0)
                
                lambda 
                    (define var_0 (#%alloc-array single-frame 16 1 1))
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 0 8))))) 10)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) 0)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) (get-spawner-locator cin-sle-tommy-winning-2 1))
                    (animate_ npc-tommy-fight-1 tommy=cin-sle-tommy-winning var_0)
                
                lambda 
                    (define var_0 (#%alloc-array single-frame 16 1 1))
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 0 8))))) 10)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) 0)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) (get-spawner-locator cin-sle-tommy-winning-2 1))
                    (wait-animate_ player abby=cin-sle-tommy-winning var_0)
                
                lambda 
                    (go clean-up 1)
                
            }
            track holster {
                lambda 
                    (wait-until-cin-frame 5.00 0)
                
                lambda 
                    (holster-player-weapon 4 1.00)
                
            }
            track rumble {
                lambda 
                    (if (joypad-has-haptics? 2)) 
                        (sle-tommy-winning-cine-haptics)
                     else 
                        (sle-tommy-winning-cine-rumble)
                    
                
            }
            track progression {
                lambda 
                    (task-complete! save-lev sle-tommy-sniper-fight-escape)
                
            }
            track ocean-control {
                lambda 
                    (wait-until-cin-maya-frame 607.00 0)
                
                lambda 
                    (send-event switch-on-foam ss-sle-storm-surge-ocean-manager-1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (suppress-spot-player-stinger)
                
            }
        }
    }
    state task-in-setup {
        block start {
            track main {
                lambda 
                    (change-object-material player (get-current-abby-head-material) objects/characters/abby/abby-head-face-blood:default 0)
                
                lambda 
                    (door-enable-systemic door-tommy-fight-restaurant-left-1 0)
                
                lambda 
                    (door-enable-systemic door-tommy-fight-restaurant-right-1 0)
                
                lambda 
                    (set-visible (get-weapon-id player 0) 0)
                
                lambda 
                    (set-visible (get-weapon-id player 1) 0)
                
                lambda 
                    (door-open door-tommy-fight-restaurant-right-1 1)
                
                lambda 
                    (door-open door-tommy-fight-restaurant-left-1 1)
                
                lambda 
                    (spawn-particles-at-joint save-lev-bm-abby player root 0 0 root 2 0 2 0)
                
                lambda 
                    (go player-cine 1)
                
            }
        }
    }
    state clean-up {
        block start {
            track main {
                lambda 
                    (camera-fade-out-animated 0.00 0)
                
                lambda 
                    (if (is-focus-test?)) 
                        (wait-show-questionnaire save-lev-tommy-sniper-questionnaire)
                    
                
                lambda 
                    (kill-entity npc-tommy-fight-1)
                
                lambda 
                    (task-complete! save-lev sle-tommy-winning)
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
    state player-cine {
        block start {
            track main {
                lambda 
                    (kill-flashlight player)
                
                lambda 
                    (camera-enable-animated 0.00 -1.00 1 1000 0 0 0)
                
                lambda 
                    (define var_0 (#%alloc-array single-frame 16 1 1))
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 0 8))))) 10)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) 0)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) (get-spawner-locator cin-sle-tommy-winning-1 1))
                    (animate_ door-tommy-fight-restaurant-right-1 door=cin-sle-tommy-winning var_0)
                
                lambda 
                    (define var_0 (#%alloc-array single-frame 16 1 1))
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 0 8))))) 10)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) 0)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) (get-spawner-locator cin-sle-tommy-winning-1 1))
                    (animate_ obj-sle-tommy-winning-restaurant-railing-1 restaurant-railing=cin-sle-tommy-winning var_0)
                
                lambda 
                    (wait-animate_ player abby=cin-sle-tommy-winning (#%alloc-array single-frame 16 0 1))
                
                lambda 
                    (if (is-focus-test?)) 
                        (wait-show-questionnaire save-lev-tommy-sniper-questionnaire)
                    
                
                lambda 
                    (if (and (is-cinematic-select?) (is-director-commentary-enabled?))) 
                        (let loop () (when (not (> (- (current-time 1) (current-time 1)) 4.00)) 
                            (joypad-disable-all-commands)
                            (wait-one-frame)
                         (loop)))
                    
                
                lambda 
                    (task-complete! save-lev sle-tommy-winning)
                
                lambda 
                    (camera-fade-out-animated 0.00 0)
                
                lambda 
                    (go complete 1)
                
            }
            track holster {
                lambda 
                    (wait-until-cin-frame 5.00 0)
                
                lambda 
                    (holster-player-weapon 4 1.00)
                
            }
            track rumble {
                lambda 
                    (if (joypad-has-haptics? 2)) 
                        (sle-tommy-winning-cine-haptics)
                     else 
                        (sle-tommy-winning-cine-rumble)
                    
                
            }
            track ocean-control {
                lambda 
                    (wait-until-cin-maya-frame 607.00 0)
                
                lambda 
                    (send-event switch-on-foam ss-sle-storm-surge-ocean-manager-1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (suppress-spot-player-stinger)
                
            }
        }
    }
