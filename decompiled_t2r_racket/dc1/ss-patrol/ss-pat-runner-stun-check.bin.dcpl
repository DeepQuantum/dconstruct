statescript {
    options {
        player
        pat-supermarket-script
        pat-supermarket-infected-script
    }
    state first-state {
        block event Attack {
            track main {
                lambda 
                    (if (and (or (npc-is-stunned? self) (== (deref (cast u64* (+ (event::get-attack-info (get-event)) 72))) brick)) (== (deref (cast u64* (+ (event::get-attack-info (get-event)) 72))) bottle))) 
                        (hud-play-tutorial PAT_STUNNED_ENEMIES 4.00 2 melee-attack 0.50 0 0 0)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-complete? patrol pat-supermarket-clicker-combat)) 
                        (go complete 1)
                    
                
            }
        }
    }
}
