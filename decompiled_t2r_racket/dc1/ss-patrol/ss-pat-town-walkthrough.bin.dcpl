                    (wait-say dina vox-igc-din-igc-pat-town-walkthrough-open-door-001 2 0)
                
            }
            track snd-design {
                lambda 
                    (wait-until-anim-frame player igc-stream-pat-town-walkthrough-open-door--ellie 920.00 2)
                
                lambda 
                    (play-sound-at-joint sfx-wood-door-latch door-exterior-c-front-1 handle_front 0 0)
                
            }
            track door {
                lambda 
                    (wait-until-anim-frame dina igc-stream-pat-town-walkthrough-open-door--dina 813.00 2)
                
                lambda 
                    (stop-animating door-exterior-c-front-1 2 0.00 0 0)
                
                lambda 
                    (door-close door-exterior-c-front-1 1)
                
            }
            track render {
                lambda 
                    (wait-until-anim-frame player igc-stream-pat-town-walkthrough-open-door--ellie 40.00 2)
                
                lambda 
                    (set-region-enabled rr-pat-interior-1 1 0)
                
            }
            track  {
            }
            track music {
                lambda 
                    (play-music-stinger *music-playlist-pat-town-walkthrough-silent-end* 0)
                
            }
            track haptics {
                lambda 
                    (if (joypad-has-haptics? 2)) 
                        (wait-until-anim-frame player igc-stream-pat-town-walkthrough-open-door--ellie 616.00 2)
                        (play-hfx-id door-open-haptic 0 2)
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (player-allow-no-weapon-aim)
                
                lambda 
                    (player-set-narrative-mode/f 0 0 *pat-jackson-post-graveyard-narrative-mode-settings*)
                
                lambda 
                    (set-tension-mode 1)
                
                lambda 
                    (gui2-disable-categories/f 16777216)
                
            }
        }
        block event player-requested-interact {
            track main {
                lambda 
                    (if (== (event-arg-symbol 0) int-joels-house-door-interact-1)) 
                        (interactable-disable int-joels-house-door-interact-1)
                        (door-disable-systemic-high-contrast-mode-update door-exterior-c-front-1 1)
                        (set-boolean enter-house-anim 1 self)
                    
                
            }
        }
        block event walking-near-joels-door {
            track main {
                lambda 
                    (npc-request-lead-spline dina spl-pat-packing-dina-by-door-1 player *pat-town-walkthrough-lead-settings-behind-player* 0 0)
                
            }
        }
    }
    state complete {
        block start {
            track main {
                lambda 
                    (door-disable-systemic-high-contrast-mode-update door-exterior-c-front-1 1)
                
            }
        }
    }
}
