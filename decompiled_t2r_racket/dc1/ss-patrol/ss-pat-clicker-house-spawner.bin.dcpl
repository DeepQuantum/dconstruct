statescript {
    options {
        player
        pat-suburbs-script
    }
    state task-check {
        block start {
            track main {
                lambda 
                    (if (task-complete? patrol pat-suburbs-explore)) 
                        (go complete 1)
                     else (if (task-continue-active? patrol pat-suburbs-explore clicker-house-ground-floor)) 
                        (go spawn-ground-clickers 1)
                     else (if (task-continue-active? patrol pat-suburbs-explore clicker-house-ground-floor-done)) 
                        (go complete 1)
                     else (if (task-active? patrol pat-suburbs-explore)) 
                        (go wait-clicker-house 1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-active? patrol pat-suburbs-explore)) 
                        (go wait-clicker-house 1)
                    
                
            }
        }
    }
    state wait-clicker-house {
        block update {
            track main {
                lambda 
                    (if (task-continue-active? patrol pat-suburbs-explore clicker-house-ground-floor)) 
                        (go spawn-ground-clickers 1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-complete? patrol pat-suburbs-explore)) 
                        (go complete 1)
                    
                
            }
        }
    }
    state spawn-ground-clickers {
        block start {
            track main {
                lambda 
                    (wait-spawn-npc-group-async clicker-house-clickers 0 0)
                
                lambda 
                    (npc-set-patrol-route npc-pat-clicker-ground-floor-1 spl-pat-clicker-ground-floor-1 -1)
                
                lambda 
                    (npc-set-patrol-route npc-pat-clicker-ground-floor-2 spl-pat-clicker-ground-floor-2 -1)
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (if (== (npc-group-alive-count clicker-house-clickers) 0)) 
                        (go combat-done 1)
                    
                
            }
        }
    }
    state combat-done {
        block start {
            track main {
                lambda 
                    (let loop () (when (and (or (or (or (player-in-state? Fall) (player-in-state? Explosion)) (player-in-state? Death)) 0) (not (not 0))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (set-svar-as-boolean pat-clicker-house-cleared 1)
                
                lambda 
                    (task-set-active-continue-safely! clicker-house-ground-floor-done 0 0)
                
                lambda 
                    (send-event inventory-snapshot ss-crafting-stats)
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
