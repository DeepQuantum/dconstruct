statescript {
    options {
        player
        pat-const
    }
    state task-check {
        block start {
            track main {
                lambda 
                    (if (task-complete? patrol pat-supermarket-carcass)) 
                        (go complete 1)
                     else (if (task-range-active? patrol pat-tower-approach patrol pat-supermarket-carcass)) 
                        (go set-ammo-count 1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-active? patrol pat-tower-approach)) 
                        (go set-ammo-count 1)
                    
                
            }
        }
    }
    state set-ammo-count {
        block start {
            track main {
                lambda 
                    (if (< (get-total-ammo rifle-remington-bolt) 3)) 
                        (set-total-ammo rifle-remington-bolt 3)
                    
                
                lambda 
                    (set-player-weapon-clip-ammo 1 rifle-remington-bolt)
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
