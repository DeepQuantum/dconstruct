statescript {
    options {
        player
        player-horse
    }
    state task-check {
        block start {
            track main {
                lambda 
                    (if (task-complete? patrol pat-supermarket-mixed-combat)) 
                        (go complete 1)
                    
                
                lambda 
                    (if (task-range-active? patrol pat-supermarket-carcass patrol pat-supermarket-mixed-combat)) 
                        (go disable-idles 1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-active? patrol pat-supermarket-carcass)) 
                        (go disable-idles 1)
                    
                
            }
        }
    }
    state disable-idles {
        block start {
            track main {
                lambda 
                    (let loop () (when (not (entity-exists? player-horse)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (send-event suspend-idle-gestures player-horse (new-boxed-value 1 1))
                
            }
        }
        block end {
            track main {
                lambda 
                    (send-event suspend-idle-gestures player-horse (new-boxed-value 1 0))
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-complete? patrol pat-supermarket-mixed-combat)) 
                        (go complete 1)
                    
                
