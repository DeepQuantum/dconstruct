statescript {
    options {
        player
        pat-path-script
    }
    state task-check {
        block start {
            track main {
                lambda 
                    (if (task-complete? patrol pat-tower-exit)) 
                        (go complete 1)
                    
                
                lambda 
                    (if (task-range-active? patrol pat-tower-railing patrol pat-tower-enter)) 
                        (go downstairs-narrative-mode 1)
                    
                
                lambda 
                    (if (task-range-active? patrol pat-tower-upper-floor patrol pat-tower-exit)) 
                        (go upstairs-narrative-mode 1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-active? patrol pat-tower-railing)) 
                        (go downstairs-narrative-mode 1)
                    
                
            }
        }
    }
    state downstairs-narrative-mode {
        block start {
            track main {
                lambda 
                    (holster-player-weapon 0 1.00)
                
            }
        }
        block update {
            track main {
                lambda 
                    (player-set-narrative-mode/f 2 0 *pat-tower-downstairs-narrative-mode-settings*)
                
                lambda 
                    (joypad-disable-commands sprint-hold sprint-press sprint-release)
                
            }
        }
        block event upstairs {
            track main {
                lambda 
                    (go upstairs-narrative-mode 1)
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-active? patrol pat-tower-untie-horses)) 
                        (go complete 1)
                    
                
            }
        }
    }
    state upstairs-narrative-mode {
        block update {
            track main {
                lambda 
                    (player-set-narrative-mode/f 1 0 *pat-tower-upstairs-narrative-mode-settings*)
                
            }
        }
        block event downstairs {
            track main {
                lambda 
                    (go downstairs-narrative-mode 1)
                
            }
        }
    }
}
