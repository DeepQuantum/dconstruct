    state show-tutorial {
        block start {
            track main {
                lambda 
                    (define var_1)
                    (if (== (joypad-button-from-input gen:flashlight) 1024)) 
                        (set! var_1 1)
                     else (if (== (joypad-button-from-input gen:flashlight) 16384)) 
