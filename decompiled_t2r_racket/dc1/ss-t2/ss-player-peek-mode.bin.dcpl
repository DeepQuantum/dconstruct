        }
    }
    state active {
        block update {
            track main {
                lambda 
                    (if (not (deref (cast u8* (+ *player-prototypes* 6))))) 
                        (go inactive 1)
                    
                
                lambda 
                    (if (deref (cast u8* (+ *player-prototypes* 6)))) 
                        (joypad-disable-commands listen-hold)
                        (if (and (player-in-state? Move) (joypad-command-active? peek-hold 6))) 
                            (go peek-mode 1)
                        
                    
                
                lambda 
                    (define var_3)
                    (if (> (- (get-float render-settings-strength self) (/ (get-delta-time) (get-float RENDER-SETTINGS-FADE-TIME self))) 0.00)) 
                        (set! var_3 (- (get-float render-settings-strength self) (/ (get-delta-time) (get-float RENDER-SETTINGS-FADE-TIME self))))
                     else 
                        (set! var_3 0.00)
                    
                    (define var_7)
                    (if (< var_3 1.00)) 
                        (if (> (- (get-float render-settings-strength self) (/ (get-delta-time) (get-float RENDER-SETTINGS-FADE-TIME self))) 0.00)) 
                            (set! var_7 (- (get-float render-settings-strength self) (/ (get-delta-time) (get-float RENDER-SETTINGS-FADE-TIME self))))
                         else 
                            (set! var_7 0.00)
                        
                     else 
                        (set! var_7 1.00)
                    
                    (set-float render-settings-strength var_7 self)
                
                lambda 
                    (apply-peek-mode-render-settings)
                
            }
        }
    }
    state peek-mode {
        block start {
            track main {
                lambda 
                    (set-float offset-anim-x 0.00 self)
                
                lambda 
                    (set-float offset-anim-y 0.00 self)
                
                lambda 
                    (set-bound-frame camera-constraint-ref-frame (set-locator-rotation (unparent-bound-frame (get-object-locator player)) (get-locator-rotation (camera-locator 0))) self)
                
                lambda 
                    (define var_0 (alloc-gesture-play-params))
                    (set! (deref (cast i32* (+ var_0 36))) 19)
                    (set! (deref (cast i32* (+ var_0 116))) 1)
                    (set! (deref (cast u8* (+ var_0 34))) 1)
                    (set! (deref (cast u8* (+ var_0 112))) 1)
                    (gesture_ player ellie-peek-mode-base-gesture var_0)
                
            }
        }
        block update {
            track main {
                lambda 
                    (joypad-disable-all-commands-except peek crouch-press camera)
                
                lambda 
                    (var-approach-target target-input (get-joypad-stick-x move 0.20 1.00) 0.04 -1.00 1.00)
                
                lambda 
                    (set-follow-camera-constraints 60.00 20.00 20.00 (rotate-locator-axis-angle (get-bound-frame camera-constraint-ref-frame self) (alloc-vector 0.00 1.00 0.00 1.00 0) (lerp-scale -1.00 1.00 10.00 -10.00 (get-float target-input self))))
                
                lambda 
                    (player-force-facing/f (get-z-vec-from-bound-frame (get-bound-frame camera-constraint-ref-frame self)))
                
                lambda 
                    (if (not (player-is-crouched?))) 
                        (joypad-force-command crouch-press)
                     else 
                        (joypad-disable-commands crouch-press)
                    
                
                lambda 
                    (apply-peek-mode-camera-lerp)
                
                lambda 
                    (ss-player-peek-mode--animate-partials)
                
                lambda 
                    (camera-set-overlay *camera-remap-peek-mode* 1 (get-float CAMERA-FADE-IN-TIME self) 2 2.00)
                
                lambda 
