                lambda 
                    (if (not (deref (cast u8* (+ *player-prototypes* 6))))) 
                        (if (or (player-in-state? Move) (player-in-state? Script))) 
                            (if (and (not 0) (not (joypad-command-active? peek-hold 6)))) 
                                (clear-gesture player 2 -1.00 0)
                                (clear-gesture player 1 -1.00 0)
                                (go active 1)
                            
                         else (if (not (joypad-command-active? peek-hold 6))) 
                        
                    
                
            }
        }
    }
}
