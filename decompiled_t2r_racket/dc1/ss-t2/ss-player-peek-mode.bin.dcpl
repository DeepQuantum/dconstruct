        f32 target-input = 0.00
    }
    state inactive {
        block start {
            track main {
                lambda 
                    (if (deref (cast u8* (+ *player-prototypes* 6)))) 
                        (go active 1)
                    
                
            }
        }
        block event designer-menu-changed {
            track main {
                lambda 
                    (if (deref (cast u8* (+ *player-prototypes* 6)))) 
                        (go active 1)
                    
                
