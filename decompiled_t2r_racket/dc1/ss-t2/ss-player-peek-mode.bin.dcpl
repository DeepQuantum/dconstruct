statescript {
    options {
        player
    }
    declarations {
        f32 CAMERA-FADE-IN-TIME = 2.00
        f32 CAMERA-SNAPPINESS-LEFT = 2.50
        f32 CAMERA-SNAPPINESS-RIGHT = 3.00
        f32 CAMERA-SNAPPINESS-RETURN-X = 2.00
        f32 CAMERA-SNAPPINESS-Y = 2.50
        f32 CAMERA-SNAPPINESS-RETURN-Y = 1.50
        f32 RENDER-SETTINGS-FADE-TIME = 3.00
