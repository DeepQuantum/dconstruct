                     else (if (== silencer-recipe (event-arg-symbol 0))) 
                        (promote-post-death-tip TIP_USE_SILENCER 0)
                     else (if (== dragons-breath-recipe (event-arg-symbol 0))) 
                        (mark-tutorial-unlocked-by-cipher-id MENU_TUTORIAL_SHOOTING_SWITCH_AMMO 1)
                        (promote-post-death-tip TIP_USE_DRAGONS_BREATH 0)
                     else (if (== bomb-arrow-recipe (event-arg-symbol 0))) 
                        (mark-tutorial-unlocked-by-cipher-id MENU_TUTORIAL_SHOOTING_SWITCH_AMMO 1)
                        (promote-post-death-tip TIP_USE_EXPLOSIVE_ARROWS 0)
                     else (if (== melee-upgrade-recipe (event-arg-symbol 0))) 
                        (promote-post-death-tip TIP_UPGRADE_MELEE_WEAPON_2 0)
                     else (if (== strike-painkillers (event-arg-symbol 0))) 
                        (promote-post-death-tip TIP_PLAYER_UPGRADE_ADRENALINE_RUSH 0)
                    
                
            }
        }
        block event tension-changed {
            track main {
                lambda 
                    (if (tension-mode-is? 3)) 
                        (set-float combat-start-time (get-current-time 0) self)
                     else (if (and (tension-mode-is? 2) (tension-mode-is? 1))) 
                        (set-float combat-start-time -1.00 self)
                        (set-boolean used-listen-mode-this-combat? 0 self)
                    
                
            }
        }
        block event nor-chase-fail {
            track main {
                lambda 
                    (promote-post-death-tip TIP_FIND_NORA_KEEP_UP 1)
                
            }
        }
    }
}
