                                (define var_8 (alloc-gesture-play-params))
                                (set! (deref (cast i32* (+ var_8 36))) 19)
                                (set! (deref (cast i32* (+ var_8 116))) 1)
                                (set! (deref (cast u8* (+ var_8 34))) 1)
                                (set! (deref (cast u8* (+ var_8 112))) 1)
                                (gesture_ player ellie-guitar-string-4-gesture var_8)
                                (rumble-curve 0.05 0.00 0.10 4 0)
                                (fire-string-sound 1 21)
                                (wait (* (tag-float tempo self) 0.50))
                                (define var_10 (alloc-gesture-play-params))
