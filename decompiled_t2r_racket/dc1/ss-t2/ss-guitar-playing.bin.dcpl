    state wait-interact {
        block start {
            track main {
                lambda 
                    (if (not (tag-specified? skip-anim-start self))) 
                        (animate-start (tag-symbol guitar self) (tag-symbol enter-anim-guitar self) (get-symbol ap self) 0)
                    
                
            }
        }
        block event force-skip-entry {
            track main {
                lambda 
                    (set-boolean enable-camera? (event-arg-boolean 0) self)
                
                lambda 
                    (set-high-contrast-mode-type (get-self-id) 6)
                
                lambda 
                    (go guitar-idle 1)
                
            }
        }
        block event force-enter {
            track main {
                lambda 
                    (set-high-contrast-mode-type (get-self-id) 6)
                
                lambda 
                    (go guitar-enter 1)
                
            }
        }
        block event show-wheel-early {
            track main {
                lambda 
                    (set-symbol menu-name (hud2-push-menu-page "hud-minigames/hud-guitar/guitar-root") self)
                
                lambda 
                    (gui2-assign-to-category (get-symbol menu-name self) 1048576)
                
                lambda 
                    (send-event setup-menu-vars (get-symbol menu-name self) (new-boxed-value 7 (get-self-id)) (new-boxed-value 7 guitar-wheel-strings))
                
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (send-event next-chord-changed (get-symbol menu-name self) (new-boxed-value 2 -1) (new-boxed-value 6 1.00))
                
                lambda 
                    (if (get-boolean needs-tuning? self)) 
                        (set-chord-wheel-strings "e" "b" "g" "d" "a" "E" -1)
                     else (if (get-boolean extc? self)) 
                        (set-chord-wheel-strings "C" "G" "D|minor|" "A|minor|" "E|minor|" "F" -1)
                     else (if (get-boolean joel? self)) 
                        (set-chord-wheel-strings "b|flat|" "c" "e|flat|" "f" "g" "a|flat|" -1)
                     else (if (get-boolean just-notes? self)) 
                        (set-chord-wheel-strings "g" "a" "c" "d" "e" "f" -1)
                     else 
                        (define var_5)
                        (if (get-boolean free-mode? self)) 
                            (set! var_5 0)
                         else 
                            (set! var_5 -1)
                        
                        (set-chord-wheel-strings "B" "F|sharp|" "C|sharp||minor|" "G|sharp||minor|" "D|sharp||minor|" "E" var_5)
                    
                
            }
        }
        block event player-requested-interact {
            track main {
                lambda 
                    (log-event "played-guitar" 1 "" 0 0)
                
                lambda 
                    (go guitar-enter 1)
                
            }
        }
    }
