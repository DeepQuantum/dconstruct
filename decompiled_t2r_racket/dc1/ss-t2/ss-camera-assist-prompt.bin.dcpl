statescript {
    options {
        player
    }
    declarations {
        f32 time-running = 0.00
        f32 time-still = 0.00
        f32 time-running-and-camera = 0.00
    }
    state task-check {
        block start {
            track main {
                lambda 
                    (if (task-complete? patrol-jackson pat-jackson-cornerstore)) 
                        (go complete 1)
                    
                
                lambda 
                    (if (task-range-active? patrol-jackson pat-jackson-home-grab-backpack patrol-jackson pat-jackson-cornerstore)) 
                        (go check-no-right-stick 1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-active? patrol-jackson pat-jackson-home-grab-backpack)) 
                        (go check-no-right-stick 1)
                    
                
            }
        }
    }
    state check-no-right-stick {
        block start {
            track main {
                lambda 
                    (if (and (is-camera-assist-enabled?) (is-navigation-assistance-accessibility?))) 
                        (go complete 1)
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (and (or (or (! (is-camera-animated?)) (player-in-state? Move)) (player-in-state? GunMove)) (player-in-state? RideHorse))) 
                        (define var_7)
                        (if (and (joypad-command-active? camera 6) (joypad-command-active? move 6))) 
                            (set! var_7 time-running-and-camera)
                         else (if (joypad-command-active? move 6)) 
                            (set! var_7 time-running)
                         else 
                            (set! var_7 time-still)
                        
                        (+=f var_7 (get-delta-time) self)
                    
                
            }
        }
        block event trigger-camera-prompt {
            track main {
                lambda 
                    (define var_0 (get-float time-running self))
                    (define var_1 (get-float time-running-and-camera self))
                    (if (and (< (/ var_1 (+ var_0 var_1)) 0.04) (> (+ var_0 var_1) 25.00))) 
                        (set! var_2 (go show-prompt 1))
                     else 
                        (set! var_2 (go no-prompt 1))
                    
                
            }
        }
    }
    state show-prompt {
        block start {
            track main {
                lambda 
                    (log-event "camera-assist-prompt-triggered" 0 "" 0 0)
                
                lambda 
                    (menu2-push-message-box ingame "menu/message-box-yes-no_ingame" HUD_CAM_ASSIST_PROMPT_TITLE HUD_CAM_ASSIST_PROMPT 0 camera_assist_prompt 2 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (joypad-disable-all-commands-except menu-left menu-right menu-stick-right menu-stick-left menu-select)
                
            }
        }
        block event messageBoxOk {
            track main {
                lambda 
                    (go complete 1)
                
            }
        }
        block event messageBoxCancel {
            track main {
                lambda 
                    (go complete 1)
                
            }
        }
        block event popped {
            track main {
                lambda 
                    (go complete 1)
                
            }
        }
    }
    state no-prompt {
        block start {
            track main {
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
