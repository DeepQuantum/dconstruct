statescript {
    options {
        player
    }
    declarations {
        bool convo-stopped = nullptr
        bool someone-talking = nullptr
        bool stop-convo = nullptr
        bool convo-full-stop = nullptr
        bool mid-convo = nullptr
        bool skip-lines = nullptr
        bool player-bantering = nullptr
        bool completed-convo = nullptr
        bool play-return-transition = nullptr
        bool play-transition = true
        symbol cur-speaker = #0000000000000000
        symbol cur-convo = #0000000000000000
        bool playing-transition? = nullptr
        bool did-line-finish? = nullptr
        bool stop-transition? = nullptr
        symbol next-speaker = #0000000000000000
        bool skip-transition? = nullptr
        bool vox-interrupt-requested? = nullptr
        symbol emotional-state = neutral
        bool line-interrupted = nullptr
    }
    state first-state {
        block  {
        }
        block event restart-convo {
            track main {
                lambda 
                    (go restart-convo 1)
                
            }
        }
    }
    state restart-convo {
        block start {
            track main {
                lambda 
                    (convo-restart?)
                
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
