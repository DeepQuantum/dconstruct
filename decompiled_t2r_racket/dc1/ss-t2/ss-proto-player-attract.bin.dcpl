statescript {
    options {
        player
        sp-all
    }
    state inactive {
        block update {
            track main {
                lambda 
                    (if (and (deref (cast u8* (+ (get-current-player-upgrades) 10))) (== (get-player-weapon-id) whistle))) 
                        (give-player-weapon whistle 0 0)
                        (go active 1)
                    
                
            }
        }
    }
    state active {
        block update {
            track main {
                lambda 
                    (if (not (player-has-weapon? whistle))) 
                        (go inactive 1)
                    
                
                lambda 
                    (if (and (and (and (not (player-in-state? DebugFly)) (not (cinematic-playing? 0))) (joypad-command-active? attract 6)) (== (get-player-weapon-id) whistle))) 
                        (go attracting 1)
                    
                
            }
        }
    }
    state attracting {
        block start {
            track main {
                lambda 
                    (script-caption player "*whistle*" 3.00 0 1)
                
                lambda 
                    (if (and (faction-investigating? 3) (faction-investigating? 6))) 
                        (define var_2 (get-closest-living-npc-in-group all-enemy-npcs player 0))
                        (if (and (npc-alive? var_2) (distance-between-objects-less-than? player var_2 30.00))) 
                            (set! var_5 (npc-make-aware-of var_2 player 2 0))
                        
                    
                
                lambda 
                    (play-sound-at-position sfx-dis-ellie-whistle (get-joint-position player heada) 0 0)
                
                lambda 
                    (audio-gameplay-event distraction (get-object-position player) player)
                
                lambda 
                    (let loop () (when (not (not (joypad-command-active? attract 6))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (go active 1)
                
            }
        }
    }
}
