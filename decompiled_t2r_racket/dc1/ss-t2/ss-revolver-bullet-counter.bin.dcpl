(define (refresh-revolver-bullet-array) 
    (darray-clear revolver-additional-joint-mods-darray)
    (define i 0)
    (let loop () (when (< i 6) 
        (if (>= i (get-int32 bullet-count self))) 
            (darray-append revolver-additional-joint-mods-darray (darray-at revolver-bullet-darray i) 0)
        
        (if (>= i (get-int32 shell-count self))) 
            (darray-append revolver-additional-joint-mods-darray (darray-at revolver-shell-darray i) 0)
        
        (set! i (+ i 1))
     (loop)))
    i
)

