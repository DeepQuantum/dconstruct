                            (set-svar revolver-bullet-count (get-player-weapon-ammo-in-clip pistol-revolver-taurus))
                        
                        (if (and (!= (get-svar revolver-shell-count) 0) (> (get-svar revolver-shell-count) (get-svar revolver-bullet-count)))) 
                            (set-int32 shell-count (get-svar revolver-shell-count) self)
                         else 
