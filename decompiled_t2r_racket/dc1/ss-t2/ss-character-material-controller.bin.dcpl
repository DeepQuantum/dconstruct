statescript {
    options {
        player
    }
    declarations {
        bool task-continued? = nullptr
    }
    state task-check {
        block start {
            track main {
                lambda 
                    (let loop () (when (not (object-spawned? player)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (apply-material-story-from-list *master-material-story-list* 0)
                
                lambda 
                    (if (is-japan?)) 
                        (set-table-shader-material-values-param *militia-hanging-hide-guts* 0.00)
                        (set-table-shader-material-values-param *militia-hanging-tucked-guts* 1.00)
                        (set-table-shader-material-values-param *jordan-polaroid-censor* 1.00)
                        (set-table-shader-material-values-param *wat-rocket-dick-censor* 1.00)
                     else 
                        (set-table-shader-material-values-param *militia-hanging-hide-guts* 1.00)
                        (set-table-shader-material-values-param *militia-hanging-tucked-guts* 0.00)
                        (set-table-shader-material-values-param *jordan-polaroid-censor* 0.00)
                        (set-table-shader-material-values-param *wat-rocket-dick-censor* 0.00)
                    
                
                lambda 
                    (global-skin-settings-manager)
                
                lambda 
                    (set-boolean task-continued? 0 self)
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (and (or (! (is-rogue-mode?)) (== (player-get-skin-id ellie) ellie-astro)) (== (player-get-skin-id ellie) ellie-astro-no-backpack))) 
                        (set-mesh-visible/f player ellie-head-astro)
                        (set-mesh-visible/f player ellie-astro-hair)
                        (set-mesh-invisible/f player ellie-head-visor-up)
                        (set-mesh-invisible/f player ellie-astro-hair-visor-up)
                        (set-mesh-invisible/f player ellie-astro-visor)
                     else (if (and (or (is-rogue-mode?) (== (player-get-skin-id ellie) ellie-astro)) (== (player-get-skin-id ellie) ellie-astro-no-backpack))) 
                        (set-mesh-invisible/f player ellie-head-astro)
                        (set-mesh-visible/f player ellie-astro-hair)
                        (set-mesh-visible/f player ellie-head-visor-up)
                        (set-mesh-visible/f player ellie-astro-hair-visor-up)
                        (set-mesh-visible/f player ellie-astro-visor)
                    
                
                lambda 
                    (handle-material-designer-menu)
                
                lambda 
                    (player-disable-systemic-sweat)
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (set-boolean task-continued? 1 self)
                
                lambda 
                    (go relay 1)
                
            }
        }
    }
    state relay {
        block start {
            track main {
                lambda 
                    (go task-check 1)
                
            }
        }
    }
}
