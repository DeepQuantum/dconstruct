                    (set! (deref (cast u64* (+ (deref (+ (deref var_2) (* 4 8))) 8))) 0)
                    (set! (deref (cast u8* (+ (deref (+ (deref var_2) (* 4 8))) 8))) (get-boolean mirrored self))
                    (set! (deref (cast i32* (deref (+ (deref var_2) (* 5 8))))) 81)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_2) (* 5 8))) 8))) 0)
                    (set! (deref (cast u8* (+ (deref (+ (deref var_2) (* 5 8))) 8))) 1)
                    (set! (deref (cast i32* (deref (+ (deref var_2) (* 6 8))))) 13)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_2) (* 6 8))) 8))) 0)
                    (set! (deref (cast i32* (+ (deref (+ (deref var_2) (* 6 8))) 8))) 2)
                    (set! (deref (cast i32* (deref (+ (deref var_2) (* 7 8))))) 88)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_2) (* 7 8))) 8))) 0)
                    (set! (deref (cast u8* (+ (deref (+ (deref var_2) (* 7 8))) 8))) 1)
                    (set! (deref (cast i32* (deref (+ (deref var_2) (* 8 8))))) 84)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_2) (* 8 8))) 8))) 0)
                    (set! (deref (cast u8* (+ (deref (+ (deref var_2) (* 8 8))) 8))) 1)
                    (animate_ (get-symbol closest-horse self) (get-symbol horse-anim self) var_2)
                
                lambda 
                    (horse-play-looping-stirrups-partial 1.40 2 (get-symbol closest-horse self))
                
                lambda 
                    (log-event "player-pet-horse" 1 "" 0 0)
                
                lambda 
                    (define var_1 (#%alloc-array single-frame 16 7 1))
                    (set! (deref (cast i32* (deref (+ (deref var_1) (* 0 8))))) 10)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 0 8))) 8))) 0)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 0 8))) 8))) (get-object-locator (get-symbol closest-horse self)))
                    (set! (deref (cast i32* (deref (+ (deref var_1) (* 1 8))))) 28)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 1 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_1) (* 1 8))) 8))) 0.70)
                    (set! (deref (cast i32* (deref (+ (deref var_1) (* 2 8))))) 27)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 2 8))) 8))) 0)
                    (set! (deref (cast u8* (+ (deref (+ (deref var_1) (* 2 8))) 8))) 2)
                    (set! (deref (cast i32* (deref (+ (deref var_1) (* 3 8))))) 30)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 3 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_1) (* 3 8))) 8))) 1.00)
                    (set! (deref (cast i32* (deref (+ (deref var_1) (* 4 8))))) 44)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 4 8))) 8))) 0)
                    (set! (deref (cast u8* (+ (deref (+ (deref var_1) (* 4 8))) 8))) (get-boolean mirrored self))
                    (set! (deref (cast i32* (deref (+ (deref var_1) (* 5 8))))) 81)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 5 8))) 8))) 0)
                    (set! (deref (cast u8* (+ (deref (+ (deref var_1) (* 5 8))) 8))) 1)
                    (set! (deref (cast i32* (deref (+ (deref var_1) (* 6 8))))) 13)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 6 8))) 8))) 0)
                    (set! (deref (cast i32* (+ (deref (+ (deref var_1) (* 6 8))) 8))) 3)
                    (wait-animate_ player (get-symbol player-anim self) var_1)
                
                lambda 
                    (go allow-petting 1)
                
            }
            track abort {
                lambda 
                    (wait 2.50)
                
                lambda 
                    (let loop () (when (and (not (joypad-command-active? horse-pet 6)) (not (> (get-joypad-stick-intensity move 0.20 1.00) 0.10))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (go allow-petting 1)
                
            }
            track vox {
                lambda 
                    (if (not (== (deref (cast f32* (+ (lookup-symbol (get-symbol info-set self) horse-petting-info-set) 16))) -1.00))) 
                        (wait-until-anim-frame player (get-symbol player-anim self) (deref (cast f32* (+ (lookup-symbol (get-symbol info-set self) horse-petting-info-set) 16))) 2)
                        (wait-say player (deref (cast u64* (+ (lookup-symbol (get-symbol info-set self) horse-petting-info-set) 24))) 2 0)
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (and (!= *horse* nullptr) (deref (cast u8* *horse*)))) 
                        (debug-draw-chosen-petting-anim 1)
                    
                
            }
        }
        block end {
            track main {
                lambda 
                    (stop-animating (get-symbol closest-horse self) 1 1.40 horse-mm-tail--part 0)
                
                lambda 
                    (if (get-animation-playing? (get-symbol closest-horse self) (get-symbol horse-anim self) 2)) 
                        (stop-animating (get-symbol closest-horse self) 2 1.40 (get-symbol horse-anim self) 0)
                    
                
                lambda 
                    (if (get-animation-playing? player (get-symbol player-anim self) 2)) 
                        (stop-animating player 2 1.40 (get-symbol player-anim self) 0)
                    
                
                lambda 
                    (if (get-boolean moving-to-entry? self)) 
                        (cancel-player-move-to)
                    
                
                lambda 
                    (set-boolean moving-to-entry? 0 self)
                
                lambda 
                    (set-symbol closest-horse *invalid-symbol* self)
                
            }
        }
    }
}
