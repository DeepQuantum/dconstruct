                        (set! (deref (cast u64* (+ (deref (+ (deref var_3) (* 0 8))) 8))) var_5)
                        (set! (deref (cast i32* (deref (+ (deref var_3) (* 1 8))))) 13)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_3) (* 1 8))) 8))) 0)
                        (set! (deref (cast i32* (+ (deref (+ (deref var_3) (* 1 8))) 8))) 2)
                        (set! (deref (cast i32* (deref (+ (deref var_3) (* 2 8))))) 54)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_3) (* 2 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_3) (* 2 8))) 8))) 0.25)
                        (set! (deref (cast i32* (deref (+ (deref var_3) (* 3 8))))) 32)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_3) (* 3 8))) 8))) 0)
                        (set! (deref (cast u8* (+ (deref (+ (deref var_3) (* 3 8))) 8))) 1)
                        (set! (deref (cast i32* (deref (+ (deref var_3) (* 4 8))))) 28)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_3) (* 4 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_3) (* 4 8))) 8))) 0.30)
                        (set! (deref (cast i32* (deref (+ (deref var_3) (* 5 8))))) 30)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_3) (* 5 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_3) (* 5 8))) 8))) 0.30)
                        (set! (deref (cast i32* (deref (+ (deref var_3) (* 6 8))))) 3)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_3) (* 6 8))) 8))) 0)
                        (set! (deref (cast u8* (+ (deref (+ (deref var_3) (* 6 8))) 8))) 1)
                        (set! (deref (cast i32* (deref (+ (deref var_3) (* 7 8))))) 4)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_3) (* 7 8))) 8))) 0)
                        (set! (deref (cast u8* (+ (deref (+ (deref var_3) (* 7 8))) 8))) 1)
                        (wait-animate_ self var_2 var_3)
                        (darray-find-remove chained-infected-yank-anims (new-boxed-value 7 var_2) 0)
                        (wait-one-frame)
                    
                
                lambda 
                    (go chained 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (npc-set-chain-for-melee self (get-spawner-locator (tag-symbol chain-center self) 1) (tag-float chain-length self))
                
                lambda 
                    (if (npc-in-meatshield? self)) 
                        (broadcast-event unchain-infected (new-boxed-value 7 (get-self-id)))
                        (go unchained 1)
                    
                
                lambda 
                    (if (not (npc-using-skill? self 11))) 
                        (override-murmuration-event/f self vox-event-npc-murmur-igc-san-streets-chained-infected)
                        (set-heart-rate self 1.00)
                    
                
                lambda 
                    (set-float chain-distance (get-locator-distance-xz (get-object-locator self) (get-spawner-locator (tag-symbol chain-center self) 1)) self)
                
            }
        }
        block event tension-changed {
            track main {
                lambda 
                    (if (! (tension-mode-is? 2))) 
                        (npc-set-hearing-multiplier self 0.50)
                        (if (npc-alive? npc-san-pool-outside-6)) 
                            (set-focusable-ignore npc-san-pool-outside-6 0)
                        
                    
                
            }
        }
        block event unchained {
            track main {
                lambda 
                    (go unchained 1)
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (if (== (event-arg-symbol 0) (get-self-id))) 
                        (go dead 1)
                    
                
            }
        }
        block event encounter-combat-complete {
            track main {
                lambda 
                    (if (is-rogue-mode?)) 
                        (npc-set-excluded-from-tension-calculation (get-self-id) 1)
                    
                
            }
        }
    }
    state unchained {
        block start {
            track main {
                lambda 
                    (fact-set self override-max-travel-dist (new-boxed-value 6 25.00))
                
                lambda 
                    (if (is-rogue-mode?)) 
                        (npc-set-excluded-from-tension-calculation (get-self-id) 0)
                    
                
                lambda 
                    (npc-set-chain-for-melee self (get-spawner-locator (tag-symbol chain-center self) 1) -1.00)
                
                lambda 
                    (enable-action-pack (tag-symbol disable-tap self) 1)
                
                lambda 
                    (enable-action-pack (tag-symbol disable-tap-1 self) 1)
                
                lambda 
                    (set-svar-as-boolean (tag-symbol svar-released self) 1)
                
                lambda 
                    (npc-set-can-cause-combat-tension self 1)
                
                lambda 
                    (fact-set self is-chained (new-boxed-value 1 0))
                
                lambda 
                    (if (npc-alive? self)) 
                        (npc-clear-zone self)
                        (if (npc-runner? self)) 
                            (npc-set-infected-params self *infected-runner-params*)
                         else 
                            (npc-set-infected-params self *infected-clicker-params*)
                        
                        (npc-set-hearing-multiplier self 1.00)
                        (wait 6.00)
                        (if (npc-clicker? self)) 
                            (npc-set-targeting-params self clicker)
                         else 
                            (npc-set-targeting-params self default-infected)
                        
                    
                
            }
            track reset {
                lambda 
                    (if (is-rogue-mode?)) 
                        (fact-remove self override-max-expansion-radius)
                        (let loop () (when (not (! (npc-using-skill? self 11))) 
                            (wait-one-frame)
                         (loop)))
                        (wait 0.50)
                        (set-focusable-ignore self 0)
                        (enable-cover-aps-in-sphere (get-object-position (tag-symbol chain-center self)) (+ (tag-float chain-length self) 0.75))
                     else 
                        (enable-cover-aps-in-sphere (get-object-position (tag-symbol chain-center self)) 2.75)
                    
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (if (== (event-arg-symbol 0) (get-self-id))) 
                        (go dead 1)
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (is-focusable-ignore? self)) 
                        (set-float chain-distance (get-locator-distance-xz (get-object-locator self) (get-spawner-locator (tag-symbol chain-center self) 1)) self)
                        (for ([var_6 all-human-enemy-npcs]) 
                            (define var_7)
                            (if (and var_6 (== (deref (cast u16* (+ var_6 12))) 7))) 
                                (set! var_7 (deref (cast u64* var_6)))
                             else (if (and var_6 (== (deref (cast u16* (+ var_6 12))) 5))) 
                                (set! var_7 (deref (cast u64* var_6)))
                             else (if (and var_6 (== (deref (cast u16* (+ var_6 12))) 4))) 
                                (set! var_7 (deref (cast u64* var_6)))
                             else 
                                (set! var_7 0)
                            
                            (if (npc-alive? var_7)) 
                                (if (and (distance-between-objects-less-than? var_7 self 15.00) (> (get-float chain-distance self) (tag-float chain-length self)))) 
                                    (set-focusable-ignore self 0)
                                
                            
                        )
                     else (if (not (get-boolean humans-aware-of-loose-infected self))) 
                        (for ([var_15 all-human-enemy-npcs]) 
                            (define var_16)
                            (if (and var_15 (== (deref (cast u16* (+ var_15 12))) 7))) 
                                (set! var_16 (deref (cast u64* var_15)))
                             else (if (and var_15 (== (deref (cast u16* (+ var_15 12))) 5))) 
                                (set! var_16 (deref (cast u64* var_15)))
                             else (if (and var_15 (== (deref (cast u16* (+ var_15 12))) 4))) 
                                (set! var_16 (deref (cast u64* var_15)))
                             else 
                                (set! var_16 0)
                            
                            (if (npc-alive? var_16)) 
                                (if (npc-is-aware-of? var_16 self)) 
                                    (set-boolean humans-aware-of-loose-infected 1 self)
                                
                            
                        )
                    
                
            }
        }
    }
    state dead {
        block start {
            track main {
                lambda 
                    (npc-set-can-cause-combat-tension self 0)
                
                lambda 
                    (enable-action-pack (tag-symbol disable-tap self) 1)
                
                lambda 
                    (enable-action-pack (tag-symbol disable-tap-1 self) 1)
                
                lambda 
                    (if (is-rogue-mode?)) 
                        (enable-cover-aps-in-sphere (get-object-position (tag-symbol chain-center self)) (+ (tag-float chain-length self) 0.75))
                     else 
                        (enable-cover-aps-in-sphere (get-object-position (tag-symbol chain-center self)) 2.75)
                    
                
                lambda 
                    (if (get-boolean humans-aware-of-loose-infected self)) 
                        (define var_2 (get-closest-in-group all-human-enemy-npcs (tag-symbol chain-center self) 0 1 1 0))
                        (if (== (npc-get-awareness var_2 player) 0)) 
                            (if (not (npc-is-perception-disabled? var_2))) 
                                (set! var_4 (npc-make-aware-of-at var_2 player (get-spawner-position (tag-symbol chain-interact self) 1) 4 0 0))
                            
                        
                    
                
            }
        }
    }
}
