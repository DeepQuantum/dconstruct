                    (play-sound-at-bound-frame sfx-chain-rope-yank (get-object-locator self) 0 0)
                
                lambda 
                    (say self vox-eff-gen-inf-chain-choke 2 0)
                
                lambda 
                    (if (not (object-anim-playing? self clikr-idle-stun-front 0))) 
                        (if (== (darray-count chained-infected-yank-anims) 0)) 
                            (group-copy chained-infected-yank-anims-static chained-infected-yank-anims)
                        
                        (define var_2 (group-random chained-infected-yank-anims))
                        (define var_3 (#%alloc-array single-frame 16 8 1))
                        (set! (deref (cast i32* (deref (+ (deref var_3) (* 0 8))))) 10)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_3) (* 0 8))) 8))) 0)
                        (define var_5)
