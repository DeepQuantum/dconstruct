                    (player-look-at-object exa-med-dogs-playing-poker-1 root 2.00)
                
                lambda 
                    (wait 1.20)
                
                lambda 
                    (wait-say player vox-igc-abb-gam-med-flooded-street-rapids-building-painting-sp-001 2 0)
                
                lambda 
                    (wait 0.10)
                
                lambda 
                    (wait-say lev vox-igc-lev-gam-med-flooded-street-rapids-building-painting-sp-002 2 0)
                
                lambda 
                    (wait 0.50)
                
                lambda 
                    (wait-say player vox-igc-abb-gam-med-flooded-street-rapids-building-painting-sp-002 2 0)
                
                lambda 
                    (go poker-dogs-2 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (player-set-narrative-mode/f 0 *camera-remap-close* *optional-conversation-narrative-mode-settings*)
                
            }
        }
    }
    state poker-dogs-2 {
        block start {
            track main {
                lambda 
                    (wait 1.50)
                
                lambda 
                    (wait-say lev vox-igc-lev-gam-med-flooded-street-rapids-building-painting-sp-003 2 0)
                
                lambda 
                    (wait 0.60)
                
                lambda 
                    (wait-say player vox-igc-abb-gam-med-flooded-street-rapids-building-painting-slf-003 2 0)
                
                lambda 
                    (go compartment-syndrome 1)
                
            }
        }
    }
    state compartment-syndrome {
        block start {
            track main {
                lambda 
                    (let loop () (when (not (! (is-any-major-character-speaking?))) 
                        (wait 0.10)
                     (loop)))
                
                lambda 
                    (let loop () (when (not (> (get-player-speed) 0.20)) 
                        (wait 0.10)
                     (loop)))
                
                lambda 
                    (wait 3.00)
                
                lambda 
                    (if (< (get-int32 vox-med-flooded-street-swim-gate self) 3)) 
                        (wait-say lev vox-igc-lev-gam-med-flooded-street-swim-sp-001 2 0)
                        (wait 0.80)
                        (wait-say player vox-igc-abb-gam-med-flooded-street-swim-sp-001 2 0)
                        (if (< (get-int32 vox-med-flooded-street-swim-gate self) 3)) 
                            (wait 0.60)
                            (wait-say lev vox-igc-lev-gam-med-flooded-street-swim-sp-002 2 0)
                            (wait 0.60)
                            (wait-say player vox-igc-abb-gam-med-flooded-street-swim-sp-002 2 0)
                        
                        (if (< (get-int32 vox-med-flooded-street-swim-gate self) 3)) 
                            (wait 0.40)
                            (wait-say lev vox-igc-lev-gam-med-flooded-street-swim-sp-003 2 0)
                            (wait 0.60)
                            (wait-say player vox-igc-abb-gam-med-flooded-street-swim-sp-003 2 0)
                        
                        (if (< (get-int32 vox-med-flooded-street-swim-gate self) 3)) 
                            (wait 0.30)
                            (wait-say player vox-igc-abb-gam-med-flooded-street-swim-sp-004 2 0)
                        
                    
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
        block event vox-climb-rapids {
            track main {
                lambda 
                    (if (not (get-boolean vox-climb-rapids-1 self))) 
                        (set-boolean vox-climb-rapids-1 1 self)
                        (go climb-rapids 1)
                    
                
            }
        }
    }
}
