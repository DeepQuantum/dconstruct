statescript {
    options {
        player
        lev
    }
    declarations {
        bool combat-done = nullptr
    }
    state wait-for-combat-done {
        block start {
            track main {
                lambda 
                    (if (task-continue-active? medicine med-infected-building-corridor-fight combat-done)) 
                        (go lev-explore 1)
                    
                
                lambda 
                    (wait-boolean combat-done 1 self)
                
                lambda 
                    (go lev-explore 1)
                
            }
        }
    }
    state lev-explore {
        block start {
            track main {
                lambda 
                    (npc-unholster-weapon lev 4 -1.00 0)
                
                lambda 
                    (npc-request-explore lev (get-self-id) 0 *ps-buddy-explore-near-player-prefer-paps-and-caps* 12.00 2 *default-ai-explore-follow-settings* 0)
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-complete? medicine med-infected-building-corridor-fight)) 
                        (go complete 1)
                    
                
            }
        }
    }
}
