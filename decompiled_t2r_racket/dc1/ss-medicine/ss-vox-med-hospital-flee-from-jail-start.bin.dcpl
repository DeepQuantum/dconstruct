        }
        block event reached-solo {
            track main {
                lambda 
                    (go done 1)
                
            }
        }
    }
    state final-lead {
        block start {
            track vox {
                lambda 
                    (wait-create-convo hallway-convo 2 0 11)
                
                lambda 
                    (signal nora-gesture--worst-case 0)
                
                lambda 
                    (wait-convo-say nora vox-igc-nor-gam-med-hospital-flee-from-jail-convo-3-sp-007 0.50 nora 0 0 0 0 0 0 (get-symbol cur-convo ss-conversation-manager-1))
                
                lambda 
                    (signal nora-gesture--ambulances 0)
                
                lambda 
                    (wait-convo-say nora vox-igc-nor-gam-med-hospital-flee-from-jail-convo-3-sp-008 0.50 nora 0 0 0 0 0 0 (get-symbol cur-convo ss-conversation-manager-1))
                
                lambda 
                    (signal nora-gesture--contained 0)
                
                lambda 
                    (wait-convo-say nora vox-igc-nor-gam-med-hospital-flee-from-jail-convo-3-sp-009 0.50 player 0 0 0 0 0 0 (get-symbol cur-convo ss-conversation-manager-1))
                
                lambda 
                    (signal player-gesture--good-idea 0)
                
                lambda 
                    (wait-convo-say player vox-igc-abb-gam-med-hospital-flee-from-jail-convo-3-slf-003 0.00 0 0 0 vox-igc-abb-gam-med-hospital-flee-from-jail-convo-3-resume-sp-003 0 0 0 (get-symbol cur-convo ss-conversation-manager-1))
                
                lambda 
                    (end-convo hallway-convo)
                
                lambda 
                    (go done 1)
                
            }
            track nora-gestures {
                lambda 
                    (set-boolean suspend-gestures? 1 self)
                
                lambda 
                    (wait-for nora-gesture--worst-case)
                
                lambda 
                    (gesture_ nora npc-talk-arm-right-wave-e-med-gesture (alloc-gesture-play-params))
                
                lambda 
                    (wait-for nora-gesture--ambulances)
                
                lambda 
                    (wait 0.10)
                
                lambda 
                    (gesture_ nora npc-m-nw-ambi-talk-c-gesture (alloc-gesture-play-params))
                
                lambda 
                    (wait-for nora-gesture--contained)
                
                lambda 
                    (gesture_ nora npc-m-nw-ambi-talk-g-gesture (alloc-gesture-play-params))
                
                lambda 
                    (set-boolean suspend-gestures? 0 self)
                
            }
            track abby-gestures {
                lambda 
                    (wait-for player-gesture--good-idea)
                
                lambda 
                    (wait 0.20)
                
                lambda 
                    (gesture_ player npc-m-nw-ambi-agree-b-gesture (alloc-gesture-play-params))
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (get-boolean suspend-gestures? self)) 
                        (suspend-idle-gestures/f nora)
                        (suspend-idle-gestures/f player)
                    
                
            }
        }
        block event reached-solo {
            track main {
                lambda 
                    (go done 1)
                
            }
        }
    }
}
