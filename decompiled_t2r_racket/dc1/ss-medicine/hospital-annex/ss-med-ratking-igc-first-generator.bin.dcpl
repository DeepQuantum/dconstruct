                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 0 8))))) 10)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) 0)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) (get-spawner-locator ap-med-first-generator-1 1))
                    (animate_ gen-med-hospital-first-1 med-hospital-basement-start-generator-success-idle--generator var_0)
                
                lambda 
                    (set-high-contrast-mode-type gen-med-hospital-first-1 1)
                
                lambda 
                    (set-single-shader-instance-param gen-med-hospital-first-1 blendOffset0 0.50)
                
                lambda 
                    (send-event blend-light-on ss-med-hospital-power-switch-1)
                
                lambda 
                    (turn-on-light rt-generator-redShape-1 1)
                
                lambda 
                    (turn-on-light rt-generator-whiteShape-1 1)
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
    state enable-power-switch {
        block start {
            track main {
                lambda 
                    (task-set-active-continue! breaker-switch 0 0 0 0.00 0 0)
                
                lambda 
                    (send-event force-power-on ss-med-hospital-power-switch-1)
                
                lambda 
                    (send-event generator-on ss-med-hos-accessibility-1)
                
                lambda 
                    (go already-complete 1)
                
            }
        }
    }
}
