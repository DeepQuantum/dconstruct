                    (gui2-set-widget-state (gui2-build-widget-path (get-ingredient-widget--crafting-menu alcohol) "badge" "percentPool" "percentAnim" 0 0 0 0 0) glow 0 0 0)
                    (data-source-mark-new (hud2-get-recipe-data-source-id (menu2-recipe-component-get-recipe-id (get-symbol focused-slot self))) 0)
                    (gui2-set-widget-state (gui2-build-widget-path (get-symbol focused-slot self) "newness" 0 0 0 0 0 0 0) new 0 0 0)
                    (gui2-set-widget-state (gui2-build-widget-path (get-symbol focused-slot self) "newness" "fader" "shimmerBg" 0 0 0 0 0) shimmer 0 0 0)
                    (gui2-set-widget-state (gui2-build-widget-path (get-symbol focused-slot self) "newness" "fader" "shimmerFg" 0 0 0 0 0) shimmer 0 0 0)
                    (define var_42 (get-ingredient-widget--crafting-menu rag))
                    (define var_43 (get-ingredient-widget--crafting-menu alcohol))
                    (gui2-set-widget-state var_42 tutorialEnd 0 0 0)
                    (gui2-set-widget-state var_43 tutorialEnd 0 0 0)
                    (gui2-set-widget-state (gui2-build-widget-path var_42 "badge" "outline" "fader" 0 0 0 0 0) white 0 0 0)
                    (gui2-set-widget-state (gui2-build-widget-path var_43 "badge" "outline" "fader" 0 0 0 0 0) white 0 0 0)
                
                lambda 
                    (set-boolean ready-to-exit-tutorial? 1 self)
                
            }
        }
        block event animation-ended {
            track main {
                lambda 
                    (if (== tutorialEnd (event-arg-symbol 1))) 
                        (if (get-boolean ready-to-exit-tutorial? self)) 
                            (wait-one-frame)
                            (define var_2 (get-ingredient-widget--crafting-menu rag))
                            (define var_3 (get-ingredient-widget--crafting-menu alcohol))
                            (define var_4 (get-partial-ingredient-quantity rag))
                            (define var_5 (get-partial-ingredient-quantity rag))
                            (define var_6 (get-partial-ingredient-quantity alcohol))
                            (define var_7 (get-partial-ingredient-quantity alcohol))
                            (gui2-set-progress-bar-percent (gui2-build-widget-path var_2 "badge" "percent" 0 0 0 0 0 0) (- var_4 (cast f32 var_5)) 0.00 12)
                            (gui2-set-progress-bar-percent (gui2-build-widget-path var_2 "badge" "negativePercent" 0 0 0 0 0 0) (- 1.00 (- var_4 (cast f32 var_5))) 0.00 12)
                            (gui2-set-widget-state var_2 focused 0 0 0)
                            (gui2-set-progress-bar-percent (gui2-build-widget-path var_3 "badge" "percent" 0 0 0 0 0 0) (- var_6 (cast f32 var_7)) 0.00 12)
                            (gui2-set-progress-bar-percent (gui2-build-widget-path var_2 "badge" "negativePercent" 0 0 0 0 0 0) (- 1.00 (- var_6 (cast f32 var_7))) 0.00 12)
                            (gui2-set-widget-state var_3 focused 0 0 0)
                            (if (and (and (joypad-command-active? inventory-craft 6) (not (== (menu2-recipe-component-get-recipe-id (get-symbol focused-slot self)) 0))) (player-can-craft? (menu2-recipe-component-get-recipe-id (get-symbol focused-slot self)) 0))) 
                                (set-recipe-component-collapsed--crafting-menu (get-symbol focused-slot self) 1)
                                (go crafting 1)
                             else 
                                (set-recipe-component-collapsed--crafting-menu (get-symbol focused-slot self) 0)
                                (go crafting-navigation 1)
                            
                        
                    
                
            }
        }
        block end {
            track main {
                lambda 
                    (menu2-set-container-focus-update-disabled (gui2-build-widget-path self "ref" "craftableItems" 0 0 0 0 0 0) 0)
                
                lambda 
                    (gui2-go-widget-state (gui2-build-widget-path (get-symbol focused-slot self) "wrenchVisibilityAnim" 0 0 0 0 0 0 0) active 0 0 0)
                
                lambda 
                    (menu2-legend-set-button-disabled self HUD_PLAYER_MENU_PROMPT_CRAFT 0)
                
                lambda 
                    (define var_1 (menu2-legend-get-button-path (get-self-id) HUD_PLAYER_MENU_PROMPT_CRAFT holdIcon))
                    (if (not (== var_1 0))) 
                        (set! var_2 (hud2-set-button-hold-shimmer-enabled var_1 1))
                    
                
                lambda 
                    (gui2-seek-widget-property (get-symbol focused-slot self) fcolor.a 1.00 0.50)
                
            }
        }
        block update {
            track main {
                lambda 
                    (joypad-disable-commands menu-prev-tab menu-next-tab inventory-close)
                
                lambda 
                    (menu2-legend-set-button-disabled self MENU_BACK 1)
                
            }
        }
    }
    state tutorial-end {
        block start {
            track main {
                lambda 
                    (menu2-legend-set-button-disabled self MENU_BACK 0)
                
            }
        }
        block end {
            track main {
                lambda 
                    (broadcast-event health-kit-tutorial-done)
                
            }
        }
        block update {
            track main {
                lambda 
                    (joypad-disable-commands menu-prev-tab menu-next-tab)
                
                lambda 
                    (if (joypad-command-active? inventory-close 6)) 
                        (broadcast-event health-kit-tutorial-done)
                    
                
                lambda 
                    (if (joypad-command-active? select-health-start 6)) 
                        (define var_2 (menu2-recipe-component-get-recipe-id (get-symbol focused-slot self)))
                        (if (and (and (and (not (== var_2 0)) (== var_2 health-kit)) (< (get-player-health) (get-player-max-health))) (> (get-inventory-item-quantity var_2) 0))) 
                            (player-instant-draw-weapon-by-name var_2 0.00 1)
                            (set-boolean heal-exit? 1 self)
                            (broadcast-event health-kit-tutorial-done)
                            (set! var_6 (joypad-force-command inventory-close))
                        
                    
                
            }
        }
    }
    state --all-- {
        block event hold-fail-timer {
            track main {
                lambda 
                    (set-int32 hold-fail-count 0 self)
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (not (script-in-state? self not-focused))) 
                        (if (is-hud-scaled?)) 
                            (gui2-disable-categories/f 256)
                         else 
                            (hud2-mark-health-ammo-interacted)
                        
                    
                
                lambda 
                    (set-boolean just-handled-craft-press? 0 self)
                
            }
        }
        block event tab-focus-gained {
            track main {
                lambda 
                    (define var_1 (menu2-legend-get-button-path (get-self-id) HUD_PLAYER_MENU_PROMPT_CRAFT holdIcon))
                    (if (not (== var_1 0))) 
                        (set! var_2 (hud2-set-button-hold-percent var_1 0.00 1))
                    
                
                lambda 
                    (set-symbol recipe-unlocked 0 (hud2-get-notification-manager-path))
                
                lambda 
                    (if (get-boolean queued-refresh? self)) 
                        (set-boolean queued-refresh? 0 self)
                        (populate--crafting-menu 1)
                        (reset-shimmer--crafting-menu)
                    
                
            }
        }
        block event focus-gained {
            track main {
                lambda 
                    (if (not (== (get-symbol focused-slot self) 0))) 
                        (gui2-go-widget-state (gui2-build-widget-path (get-symbol focused-slot self) "quantity" 0 0 0 0 0 0 0) default 0 0 0)
                    
                
                lambda 
                    (set-symbol focused-slot (menu2-get-focused-component) self)
                
                lambda 
                    (try-update-highlight--crafting-menu (!= (get-script-state self) setup))
                
            }
        }
        block event tab-focus-lost {
            track main {
                lambda 
                    (broadcast-event crafting-menu-closed)
                
                lambda 
                    (clear-datasource-new-flag--crafting-menu 0)
                
                lambda 
                    (go not-focused 1)
                
            }
        }
        block event quick-craft-started {
            track main {
                lambda 
                    (if (not (== (event-arg-symbol 0) 0))) 
                        (define var_2 (lookup-inv-item-def (event-arg-symbol 0)))
                        (if (not (== var_2 0))) 
                            (log-event "hud-craft-quick-start" 1 (deref (cast i64* (+ var_2 8))) 0 0)
                            (set! var_3 (set-symbol quick-craft-item (event-arg-symbol 0) self))
                        
                    
                
            }
        }
        block event infinite-crafting-toggled {
            track main {
                lambda 
                    (for ([var_1 ingredients]) 
                        (define var_2)
                        (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 7))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 5))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else 
                            (set! var_2 0)
                        
                        (update-ingredient-text--crafting-menu var_2)
                        (update-ingredients-needed--crafting-menu 0)
                        (try-update-highlight--crafting-menu 0)
                    )
                
                lambda 
                    (populate--crafting-menu 0)
                
            }
        }
        block event player-upgrade-learned {
            track main {
                lambda 
                    (set-boolean queued-refresh? 1 self)
                
            }
        }
        block event item-given {
            track main {
                lambda 
                    (populate--crafting-menu 0)
                
                lambda 
                    (if (not (get-boolean just-crafted? self))) 
                        (update-ingredients-needed--crafting-menu 0)
                    
                
            }
        }
        block event item-removed {
            track main {
                lambda 
                    (populate--crafting-menu 0)
                
                lambda 
                    (if (not (get-boolean just-crafted? self))) 
                        (update-ingredients-needed--crafting-menu 0)
                    
                
            }
        }
    }
    state --script-- {
        block end {
            track main {
                lambda 
                    (broadcast-event crafting-menu-closed)
                
                lambda 
                    (clear-datasource-new-flag--crafting-menu 1)
                
                lambda 
                    (if (get-boolean heal-exit? self)) 
                        (joypad-force-command select-health-start)
                    
                
            }
        }
    }
}
