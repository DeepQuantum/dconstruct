        block event designer-menu-changed {
            track main {
                lambda 
                    (refresh-notifications-enabled)
                
                lambda 
                    (if (and (!= *hud-prototypes* nullptr) (deref (cast u8* *hud-prototypes*)))) 
                        (set! (deref (cast u8* *hud-prototypes*)) 0)
                        (debug-send-all-notifications)
                    
                
            }
        }
        block event pick-up-treasure {
            track main {
                lambda 
                    (if (and (or (or (== (event-arg-symbol 0) collectible-joe-leah-photo) (== (event-arg-symbol 0) collectible-joe-leah-note)) (== (event-arg-symbol 0) collectible-pat-library-eugene-firefly-pendant)) (== (event-arg-symbol 0) collectible-pat-suburbs-superhero-card))) 
                        (handle-item-recieved-event--notification-mgr (event-arg-symbol 0) 1 1)
                    
                
            }
        }
        block event request-pickup-notification {
            track main {
                lambda 
                    (handle-item-recieved-event--notification-mgr (event-arg-symbol 0) 1 (event-arg-boolean 1))
                
            }
        }
        block event player-pickup {
            track main {
                lambda 
                    (handle-item-recieved-event--notification-mgr (event-arg-symbol 1) (event-arg-int32 2) 1)
                
            }
        }
        block event player-menu-closed {
            track main {
                lambda 
                    (if (not (== (get-symbol recipe-unlocked self) 0))) 
                        (wait 0.50)
                        (set-symbol recipe-unlocked 0 self)
                        (hud2-request-new-item-notification (get-symbol recipe-unlocked self) 0.00 0)
                    
                
            }
        }
        block event crafting-menu-opened {
            track main {
                lambda 
                    (set-symbol recipe-unlocked 0 self)
                
            }
        }
    }
