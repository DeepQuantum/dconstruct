                                    (gui2-set-widget-state (get-guitar-slot-child var_5 5) active 0 0 0)
                                    (if (and (== var_5 (get-int32 desired-chord-index self)) (not (== (get-int32 desired-chord-index self) -1)))) 
                                        (gui2-go-widget-state (get-guitar-slot-child (get-int32 desired-chord-index self) 5) off 0 0 0)
                                        (gui2-go-widget-state (get-guitar-slot-child (get-int32 desired-chord-index self) 6) active 0 0 1)
                                    
                                    (if (== (get-int32 desired-chord-index self) -1)) 
                                        (update-slot-bg--guitar)
                                    
                                    (set! var_6 (set-int32 desired-chord-index var_5 self))
                                
                            
                        
                    
                
            }
        }
        block event hide-all-chords {
            track main {
                lambda 
                    (if (get-boolean setup-complete? self)) 
                        (define i 0)
                        (let loop () (when (< i 6) 
                            (hide-chord--guitar-hud i 1)
                            (set! i (+ i 1))
                         (loop)))
                    
                
            }
        }
        block event show-all-chords {
            track main {
                lambda 
                    (if (get-boolean setup-complete? self)) 
                        (define i 0)
                        (let loop () (when (< i 6) 
                            (hide-chord--guitar-hud i 0)
                            (set! i (+ i 1))
                         (loop)))
                    
                
            }
        }
        block event show-chord {
            track main {
                lambda 
                    (if (get-boolean setup-complete? self)) 
                        (hide-chord--guitar-hud (event-arg-int32 0) 0)
                    
                
            }
        }
        block event hide-chord {
            track main {
                lambda 
                    (if (get-boolean setup-complete? self)) 
                        (hide-chord--guitar-hud (event-arg-int32 0) 1)
                    
                
            }
        }
        block event set-chord-disabled {
            track main {
                lambda 
                    (if (get-boolean setup-complete? self)) 
                        (define var_2 (get-guitar-slot-child (event-arg-int32 0) 3))
                        (define var_4 (get-guitar-slot-child (event-arg-int32 0) 2))
                        (gui2-set-widget-state var_2 active 0 0 0)
                        (gui2-set-widget-state var_4 active 0 0 0)
                        (gui2-set-widget-state var_2 disabled 0 0 0)
                        (gui2-set-widget-state var_4 disabled 0 0 0)
                    
                
            }
        }
        block event strummed {
            track main {
                lambda 
                    (if (get-boolean setup-complete? self)) 
                        (start-timer show-hud (get-float idle-time self) self 1)
                        (if (event-arg-boolean 1)) 
                            (++ progress-streak self)
                            (if (>= (get-int32 progress-streak self) 2)) 
                                (set-int32 failed-note-count 0 self)
                                (define i 0)
                                (let loop () (when (< i 6) 
                                    (gui2-go-widget-state (get-guitar-slot-child i 6) active 0 0 (== i (get-int32 desired-chord-index self)))
                                    (set! i (+ i 1))
                                 (loop)))
                            
                         else (if (> (- (get-current-time 0) (get-float last-fail-time self)) 0.50)) 
                            (set-float last-fail-time (get-current-time 0) self)
                            (++ failed-note-count self)
                            (set-int32 progress-streak 0 self)
                            (if (>= (get-int32 failed-note-count self) 3)) 
                                (define i 0)
                                (let loop () (when (< i 6) 
                                    (gui2-go-widget-state (get-guitar-slot-child i 6) active 0 0 0)
                                    (gui2-go-widget-state (get-guitar-slot-child i 6) flashing 0 0 0)
                                    (set! i (+ i 1))
                                 (loop)))
                            
                        
                        (if (> (- (get-current-time 0) (get-float last-strum-time self)) 0.20)) 
                            (set-float last-strum-time (get-current-time 0) self)
                            (set! var_15 (guitar-play-strum-anim (== (event-arg-int32 0) 3)))
                        
                    
                
                lambda 
                    (if (strum-prompt-allowed?--guitar-minigame)) 
                        (start-timer show-strum-text 15.00 self 1)
                    
                
            }
        }
        block event tutorial-played {
            track main {
                lambda 
                    (wait-boolean setup-complete? 1 self)
                
                lambda 
                    (gui2-set-widget-state (get-symbol w-strum-text self) off 0 0 0)
                
                lambda 
                    (start-timer show-strum-text 15.00 self 1)
                
            }
        }
        block event hide-strum-text {
            track main {
                lambda 
                    (start-timer show-hud (get-float idle-time self) self 1)
                
                lambda 
                    (toggle-playing-ui 0)
                
            }
        }
        block event show-strum-text {
            track main {
                lambda 
                    (start-timer show-hud (get-float idle-time self) self 1)
                
                lambda 
                    (toggle-playing-ui 1)
                
                lambda 
                    (start-timer show-strum-prompt 7.00 self 1)
                
            }
        }
        block event show-hud {
            track main {
                lambda 
                    (if (and (guitar-freeplay-is-active?) (get-boolean setup-complete? self))) 
                        (guitar-freeplay-show-legend 1)
                    
                
            }
        }
        block event options-menu-changed {
            track main {
                lambda 
                    (update-strum-tutorial)
                
                lambda 
                    (update-strings-darray-rotation)
                
            }
        }
        block event input-device-type-changed {
            track main {
                lambda 
                    (update-strum-tutorial)
                
            }
        }
        block event show-strum-prompt {
            track main {
                lambda 
                    (if (get-boolean show-strum-prompt? self)) 
                        (update-strum-tutorial)
                        (set-boolean show-strum-prompt? 0 self)
                    
                
            }
        }
        block event plucked-reset {
            track main {
                lambda 
                    (set-int32 strum-count 0 self)
                
            }
        }
        block event string-plucked {
            track main {
                lambda 
                    (if (guitar-freeplay-is-active?)) 
                        (start-timer plucked-reset 3.00 self 1)
                        (++ strum-count self)
                        (if (>= (get-int32 strum-count self) 15)) 
                            (toggle-playing-ui 0)
                            (stop-timer show-strum-prompt self)
                            (gui2-go-widget-state (get-symbol w-swipe-prompt self) off 0 0 0)
                        
                     else 
                        (stop-timer show-strum-prompt self)
                        (gui2-go-widget-state (get-symbol w-swipe-prompt self) off 0 0 0)
                    
                
                lambda 
                    (start-timer show-hud (get-float idle-time self) self 1)
                
                lambda 
                    (if (> (event-arg-int32 0) -1)) 
                        (gui2-set-widget-state (get-string-widget--guitar-minigame (- (event-arg-int32 0) 1)) pulse 0 0 0)
                    
                
            }
        }
    }
}
