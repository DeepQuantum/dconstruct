                        (wait-until-anim-frame player aef-fight-chase-abby-enters-backstage-start--abby 26.00 2)
                        (define var_1 (play-hfx-id push-haptic-impact 0 2))
                        (let loop () (when (not (object-anim-reached-frame? player aef-fight-chase-abby-enters-backstage-start--abby 67.00 2)) 
                            (hfx-ramp-internal var_1 0 0 (alloc-parameter-ramp-internal 0.15 0.00 (/ 256.00 48000.00) 0.00 1 0.00 0) 1)
