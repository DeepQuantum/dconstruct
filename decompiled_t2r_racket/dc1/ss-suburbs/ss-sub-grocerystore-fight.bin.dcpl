statescript {
    options {
        player
        sub-grocerystore-exterior
    }
    declarations {
        symbol npc-on-exit = #0000000000000000
    }
    state task-check {
        block start {
            track main {
                lambda 
                    (if (task-complete? seattle-ellie-towers sub-grocery-combat)) 
                        (go done 1)
                     else (if (task-active? seattle-ellie-towers sub-grocery-combat)) 
                        (go combat 1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-active? seattle-ellie-towers sub-grocery-combat)) 
                        (go combat 1)
                    
                
            }
        }
    }
    state combat {
        block start {
            track main {
                lambda 
                    (wait-spawn-npc-group-async grocerystore-npcs 0 0)
                
                lambda 
                    (npc-make-aware-of npc-grocery-store-2 player 2 0)
                
                lambda 
                    (script-caption npc-grocery-store-2 "Someone dropped down in there!" -1.00 0 0)
                
                lambda 
                    (set-symbol npc-on-exit npc-grocery-store-2 self)
                
                lambda 
                    (npc-set-zone-region npc-grocery-store-2 rgn-zone-near-exit-1)
                
            }
        }
        block event tension-changed {
            track main {
                lambda 
                    (if (and (tension-mode-is? 4) (> (npc-group-alive-count grocerystore-npcs) 2))) 
                        (if (not (npc-alive? (get-symbol npc-on-exit self)))) 
                            (set-symbol npc-on-exit (get-closest-living-npc-in-group grocerystore-npcs pos-zone-near-exit-1 0) self)
                        
                        (npc-set-zone-region (get-symbol npc-on-exit self) rgn-zone-near-exit-1)
                        (npc-set-hard-point (get-symbol npc-on-exit self) hard-point-near-exit-1)
                     else (if (npc-alive? (get-symbol npc-on-exit self))) 
                        (npc-clear-hard-point (get-symbol npc-on-exit self))
                    
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (if (== (npc-group-alive-count grocerystore-npcs) 0)) 
                        (go done 1)
                    
                
                lambda 
                    (if (< (npc-group-alive-count grocerystore-npcs) 3)) 
                        (npc-clear-hard-point (get-symbol npc-on-exit self))
                        (npc-clear-zone (get-symbol npc-on-exit self))
                    
                
            }
        }
    }
}
