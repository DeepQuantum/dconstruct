(define (print-dialogues-list arg_0 arg_1) 
    (define i 0)
    (let loop () (when (< i 50) 
        (if (== i arg_0)) 
            (if (== arg_1 1)) 
                (debug-draw-string-2d (alloc-point 730.00 (cast f32 (+ 20 (* i 10))) 0.00 0) "=>" 7 0.00 0.60 0 0 0 1.00)
            
        
        (debug-draw-string-2d (alloc-point 750.00 (cast f32 (+ 20 (* i 10))) 0.00 0) (dc:format "%s" (get-dialogue (get-symbol dialogueProcess self) i)) 7 0.00 0.60 0 0 0 1.00)
        (set! i (+ i 1))
     (loop)))
    i
)

(define (print-languages-list arg_0) 
    (define var_0 (get-languages-count))
    (debug-draw-string-2d (alloc-point 400.00 20.00 0.00 0) (dc:format "languages count: %d" var_0) 7 0.00 0.60 0 0 0 1.00)
    (for ([ i (in-range var_0)]) 
        (if (== i arg_0)) 
            (debug-draw-string-2d (alloc-point 380.00 (cast f32 (+ 30 (* i 10))) 0.00 0) "=>" 7 0.00 0.60 0 0 0 1.00)
        
        (debug-draw-string-2d (alloc-point 400.00 (cast f32 (+ 30 (* i 10))) 0.00 0) (dc:format "%s" (get-language-name i)) 7 0.00 0.60 0 0 0 1.00)
    )
    (+ i 1)
)

(define (button-pressed? arg_0) 
    (debug-joypad-command-active? arg_0 0)
)

