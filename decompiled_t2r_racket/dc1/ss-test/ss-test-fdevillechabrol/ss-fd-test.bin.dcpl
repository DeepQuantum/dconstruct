                        (if (== (get-int32 mode self) 0)) 
                            (set-int32 currentLanguageIndex (- (get-int32 currentLanguageIndex self) 5) self)
                        
                        (if (== (get-int32 mode self) 2)) 
                            (set-int32 currentDialogueIndex (- (get-int32 currentDialogueIndex self) 5) self)
                        
                        (if (== (get-int32 mode self) 1)) 
                            (set-int32 currentPage (- (get-int32 currentPage self) 5) self)
                        
                    
                
                lambda 
