    state main {
        block start {
            track raycast {
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (let loop () (when 1 
                        (set-int32 set-locator-raycast (kick-raycast (camera-locator 1) (offset-locator (camera-locator 1) (alloc-vector 0.00 0.00 99.00 1.00 0)) 0 6147) self)
                        (wait-one-frame)
                        (set-bound-frame locator-raycast (wait-raycast (get-int32 set-locator-raycast self)) self)
                        (debug-draw-raycast (get-int32 set-locator-raycast self) 0.00)
                        (debug-draw-locator (get-bound-frame locator-raycast self) 0.30 0.00 0 2.00 0)
                        (set-bound-frame respawn-boundframe (rotate-locator-lookat (flatten-locator (get-bound-frame locator-raycast self)) (camera-locator 0) 1.00 0) self)
                     (loop)))
                
            }
            track respawn-npc {
                lambda 
                    (let loop () (when 1 
                        (if (! (== (ddict-key-count (get-symbol npc-respawn-queue-ddict self)) 0))) 
                            (define var_5)
                            (if (deref (cast u8* (+ *gui-spawner* 4)))) 
                                (set! var_5 (&& (== (npc-group-alive-count all-enemy-npcs) 0) 0))
                             else 
                                (define var_10 (ddict-value-at (get-symbol npc-respawn-queue-ddict self) 0))
                                (define var_11)
                                (if (and var_10 (== (deref (cast u16* (+ var_10 12))) 1))) 
                                    (set! var_11 (deref (cast u8* var_10)))
                                 else (if (and var_10 (== (deref (cast u16* (+ var_10 12))) 2))) 
