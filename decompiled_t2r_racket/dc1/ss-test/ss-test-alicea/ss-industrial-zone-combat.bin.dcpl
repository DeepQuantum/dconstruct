statescript {
    options {
        player
    }
    declarations {
        bool spawn-reinf = nullptr
    }
    state start {
        block start {
            track main {
                lambda 
                    (wait 3.00)
                
                lambda 
                    (go check 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (debug-draw-text-box-2D "Clear out all enemies" 60 340.00 60.00 1.00 1 0 1 0.00)
                
            }
        }
    }
    state check {
        block event npc-died {
            track main {
                lambda 
                    (if (and (< (npc-group-alive-count first-wave-npcs) 2) (not (get-boolean spawn-reinf self)))) 
                        (go reinforcements 1)
                    
                
                lambda 
                    (if (and (== (npc-group-alive-count first-wave-npcs) 0) (== (npc-group-alive-count second-wave-npcs) 0))) 
                        (go combat-end 1)
                    
                
            }
        }
    }
    state reinforcements {
        block start {
            track main {
                lambda 
                    (set-boolean spawn-reinf 1 self)
                
                lambda 
                    (wait-spawn-npc-group-async second-wave-npcs 0 0)
                
                lambda 
                    (wait-script-caption npc-pistol-1 "Hey!" 1.50 0 0)
                
                lambda 
                    (wait-script-caption player "More of them..." 2.00 0 0)
                
                lambda 
                    (go check 1)
                
            }
        }
    }
    state combat-end {
        block start {
            track main {
                lambda 
                    (wait 3.00)
                
                lambda 
                    (request-dialog player-callout-combat-end player 0 0 0 0 0)
                
                lambda 
                    (wait-script-caption player "Toasty! [End of Setup]" 2.25 0 0)
                
                lambda 
                    (wait 1.00)
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
