statescript {
    options {
        player
        flooded-building
    }
    state intro-spawn {
        block start {
            track main {
                lambda 
                    (wait-spawn-npc-group-async building-npcs 0 0)
                
                lambda 
                    (wait 3.00)
                
                lambda 
                    (go set-patrol 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (debug-draw-text-box-2D "Clear out all enemies" 60 340.00 60.00 1.00 1 0 1 0.00)
                
            }
        }
    }
    state set-patrol {
        block event approaching-interior {
            track main {
                lambda 
                    (npc-set-patrol-route-if-alive npc-942 spl-519 -1)
                
                lambda 
                    (wait 1.50)
                
                lambda 
                    (npc-set-patrol-route-if-alive npc-941 spl-521 -1)
                
                lambda 
                    (npc-set-patrol-route-if-alive npc-944 spl-520 -1)
                
                lambda 
                    (go combat-wait 1)
                
            }
        }
    }
    state combat-wait {
        block event npc-died {
            track main {
                lambda 
                    (if (== (npc-group-alive-count building-npcs) 0)) 
                        (go combat-end 1)
                    
                
            }
        }
    }
    state combat-end {
        block start {
            track main {
                lambda 
                    (wait 3.00)
                
                lambda 
                    (request-dialog player-callout-combat-end player 0 0 0 0 0)
                
                lambda 
                    (wait-script-caption player "Adios! [End of Setup]" 1.50 0 0)
                
                lambda 
                    (wait 1.00)
                
                lambda 
                    (go done 1)
                
            }
        }
    }
}
