                        (go turn-on 1)
                    
                
                lambda 
                    (if (and (get-boolean light-on? self) (joypad-command-active? debug-script-press-r3 6))) 
                        (go turn-off 1)
                    
                
            }
        }
    }
    state turn-on {
        block start {
            track main {
                lambda 
                    (set-boolean light-on? 1 self)
                
                lambda 
                    (send-event turn-on-flashlight player)
                
                lambda 
                    (go waiting 1)
                
            }
        }
    }
    state turn-off {
        block start {
            track main {
                lambda 
                    (set-boolean light-on? 0 self)
                
                lambda 
