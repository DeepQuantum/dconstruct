statescript {
    options {
        player
    }
    declarations {
        bool light-on? = nullptr
    }
    state initial {
        block start {
            track main {
                lambda 
                    (send-event spawn-flashlight player)
                
                lambda 
                    (go turn-on 1)
                
            }
        }
    }
    state waiting {
        block event turn-on-light {
            track main {
                lambda 
