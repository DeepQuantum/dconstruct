                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) 0)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) (get-spawner-locator ap-igc-conversation-1 1))
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 1 8))))) 28)
