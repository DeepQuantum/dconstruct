            track main {
                lambda 
                    (define var_1 (get-animation-phase player 2 (get-symbol door-open-anim self)))
                    (print-float var_1 self)
                    (stop-animating player 0 0.30 (get-symbol door-open-anim self) 0)
                    (define var_4 (#%alloc-array single-frame 16 6 1))
                    (set! (deref (cast i32* (deref (+ (deref var_4) (* 0 8))))) 58)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_4) (* 0 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_4) (* 0 8))) 8))) var_1)
                    (set! (deref (cast i32* (deref (+ (deref var_4) (* 1 8))))) 28)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_4) (* 1 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_4) (* 1 8))) 8))) 0.20)
                    (set! (deref (cast i32* (deref (+ (deref var_4) (* 2 8))))) 40)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_4) (* 2 8))) 8))) 0)
                    (set! (deref (cast i32* (+ (deref (+ (deref var_4) (* 2 8))) 8))) 1)
                    (set! (deref (cast i32* (deref (+ (deref var_4) (* 3 8))))) 75)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_4) (* 3 8))) 8))) 0)
                    (define var_7)
                    (if (string-eq? (get-string door-open-hand self) "right")) 
                        (set! var_7 *scav-drawer-exit-r-hand*)
                     else 
                        (set! var_7 *scav-drawer-exit-l-hand*)
                    
                    (set! (deref (cast u64* (+ (deref (+ (deref var_4) (* 3 8))) 8))) var_7)
                    (set! (deref (cast i32* (deref (+ (deref var_4) (* 4 8))))) 20)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_4) (* 4 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_4) (* 4 8))) 8))) (+ (get-float abort-frame self) 30.00))
                    (set! (deref (cast i32* (deref (+ (deref var_4) (* 5 8))))) 30)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_4) (* 5 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_4) (* 5 8))) 8))) 0.40)
                    (animate_ player (get-symbol door-open-anim self) var_4)
                
                lambda 
                    (if (get-boolean return-to-pos self)) 
                        (if (>= (distance-between-locators-xz (get-object-locator player) (get-bound-frame last-pos self)) 0.90)) 
                            (player-scripted-move-new (get-bound-frame last-pos self) 1 *ellie-move-to-run-combat-door-tense* 7 0 0)
                         else 
                            (player-scripted-move-new (get-bound-frame last-pos self) 1 *ellie-move-to-run-tense-door-smallstep* 7 0 0)
                        
                    
                
                lambda 
                    (wait 2.00)
                
                lambda 
                    (go combat-door-complete 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (and (> (get-joypad-stick-intensity move 0.20 1.00) 0.10) (get-boolean return-to-pos self))) 
                        (cancel-player-move-to)
                    
                
            }
        }
    }
    state combat-door-complete {
        block start {
            track main {
                lambda 
                    (animate-start door-right-latch-combat-1 t2-door-right-open-combat 0 0)
                
                lambda 
                    (interactable-enable interact-combat-door-1)
                
                lambda 
                    (go main 1)
                
            }
        }
    }
}
