(define (menu-cross) 
    (if (joypad-command-active? debug-script-press-down 6)) 
        (if (< (get-int32 menu-line-current self) (get-int32 menu-line-total self))) 
            (set-int32 menu-line-current (+ (get-int32 menu-line-current self) 1) self)
