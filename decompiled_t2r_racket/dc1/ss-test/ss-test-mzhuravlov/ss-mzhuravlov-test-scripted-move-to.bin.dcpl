    state scripted-move-to {
        block start {
            track main {
                lambda 
                    (if (get-boolean debug-pause-ends self)) 
                        (go debug-pause 1)
                    
                
                lambda 
                    (if (== (get-symbol current-interactible self) interact-igc-conversation-1)) 
                        (set-bound-frame path-goal (get-animation-entry player igc-template-conversation--ellie (get-spawner-locator ap-igc-conversation-1 1) 0 0.00 apReference) self)
                        (interactable-disable interact-igc-conversation-1)
                        (set-symbol goto-state animate-igc self)
                     else (if (== (get-symbol current-interactible self) interact-promt-1)) 
                        (set-bound-frame path-goal (get-object-locator move-to-point-1) self)
                        (set-symbol goto-state scripted-post-move-reset self)
                     else (if (== (get-symbol current-interactible self) interact-promt-2)) 
                        (set-bound-frame path-goal (get-object-locator move-to-point-2) self)
                        (set-symbol goto-state scripted-post-move-reset self)
                     else (if (== (get-symbol current-interactible self) interact-promt-continue-1)) 
                        (set-bound-frame path-goal (get-object-locator move-to-point-continue-1) self)
                        (set-symbol goto-state scripted-post-move-reset self)
                    
                
                lambda 
                    (set-object-locator player-pos-proxy-1 (get-object-locator player))
                
                lambda 
                    (set-int32 scripted-move-type 100 self)
                
                lambda 
                    (define var_0 (get-current-player-movement-anim-settings))
                    (if (not (== var_0 0))) 
                        (set-symbol mm-set-on-start (deref (cast u64* (+ var_0 512))) self)
                     else 
                        (define var_2 (dc:format "Can't get current mm-set settings!"))
                        (display var_2 8)
                        (display-error var_2)
                    
                    (print-string "Locomotion mm-set at the moment of swtich:" self)
                    (print-symbol (get-symbol mm-set-on-start self) self)
                
                lambda 
                    (set-float distance-to-goal (get-locator-distance-xz (get-bound-frame path-goal self) (get-object-locator player)) self)
                
                lambda 
                    (set-float player-speed (get-player-speed) self)
                
                lambda 
                    (if (== (get-symbol current-interactible self) interact-promt-continue-1)) 
                        (wait-player-move-to-entry ellie-mm-explore-idle-igc (get-bound-frame path-goal self) 0 0 1.00 apReference-camera1 apReference 0.00 0 1 0 1 0.00 0 1)
                     else (if (== (get-symbol current-interactible self) interact-igc-conversation-1)) 
                        (print-string "GOAL TYPE STOP" self)
                        (wait-player-move-to-entry igc-template-conversation--ellie (get-spawner-locator ap-igc-conversation-1 1) 1 0 1.00 apReference-camera1 apReference 0.00 0 1 0 1 0.00 0 1)
                     else 
                        (print-string "GOAL TYPE STOP" self)
                        (set-float starting-speed-scale (get-joypad-stick-intensity move 0.20 1.00) self)
                        (debug-draw-string-2d (alloc-point 1100.00 (+ (get-float console-y-start self) 60.00) -4.00 0) (dc:format "Stick scale:   %.3f" (get-float starting-speed-scale self)) 2 3.00 0.50 0 0 0 1.00)
                        (wait-player-move-to-entry ellie-mm-explore-idle-igc (get-bound-frame path-goal self) 1 0 1.00 apReference-camera1 apReference 0.00 0 0 0 1 0.00 0 1)
                    
                
                lambda 
                    (debug-draw-string-2d (alloc-point 900.00 540.00 0.00 0) "GOAL REACHED" 3 0.10 3.00 0 0 0 1.00)
                
                lambda 
                    (go (get-symbol goto-state self) 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (joypad-set-stick-scale move (get-float starting-speed-scale self))
                
                lambda 
                    (draw-help)
                
                lambda 
                    (utility)
                
                lambda 
                    (utility-goal)
                
            }
        }
    }
