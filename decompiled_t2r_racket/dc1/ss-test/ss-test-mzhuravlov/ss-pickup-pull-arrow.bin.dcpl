                            (set-boolean second-ik-in-use? 1 self)
                        
                    
                
            }
        }
    }
    state stuck-arrow-exit {
        block start {
            track main {
                lambda 
                    (debug-draw-string-2d (alloc-point 100.00 40.00 0.00 0) "Exit state begins" 7 2.00 1.00 0 0 0 1.00)
                
                lambda 
                    (if (object-spawned? (get-symbol secondary-ik-solver self))) 
                        (stop-joint-ik (get-symbol secondary-ik-solver self) 0.30)
                    
                
                lambda 
                    (let loop () (when (not (>= (get-animation-frame player 2 (get-symbol arrow-pull-animation self)) (get-float main-ik-off-frame self))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (if (object-spawned? (get-symbol main-ik-solver self))) 
                        (stop-joint-ik (get-symbol main-ik-solver self) 0.40)
                    
                
                lambda 
                    (let loop () (when (not (>= (get-animation-phase player 2 (get-symbol arrow-pull-animation self)) 0.85)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (stop-animating player 2 0.60 (get-symbol arrow-pull-animation self) 0)
                
                lambda 
                    (let loop () (when (not (>= (get-animation-phase self 2 (symbol-concat-string (get-symbol arrow-pull-animation self) "--arrow")) 0.85)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (go secure-exit 1)
                
            }
        }
        block event player-attacked {
            track main {
                lambda 
                    (go secure-exit 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (disable-drawing-interactable-icon)
                
                lambda 
                    (if (and (> (get-joypad-stick-intensity move 0.20 1.00) 0.10) (not (get-boolean is-partial-exit self)))) 
                        (debug-draw-string-2d (alloc-point 100.00 40.00 0.00 0) "Abort input recognized" 7 2.00 1.00 0 0 0 1.00)
                        (stop-animating player 0 0.40 (get-symbol arrow-pull-animation self) 0)
                        (define var_5 (#%alloc-array single-frame 16 6 1))
                        (set! (deref (cast i32* (deref (+ (deref var_5) (* 0 8))))) 57)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_5) (* 0 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_5) (* 0 8))) 8))) (get-animation-frame player 2 (get-symbol arrow-pull-animation self)))
                        (set! (deref (cast i32* (deref (+ (deref var_5) (* 1 8))))) 28)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_5) (* 1 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_5) (* 1 8))) 8))) 0.20)
                        (set! (deref (cast i32* (deref (+ (deref var_5) (* 2 8))))) 40)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_5) (* 2 8))) 8))) 0)
                        (set! (deref (cast i32* (+ (deref (+ (deref var_5) (* 2 8))) 8))) 1)
                        (set! (deref (cast i32* (deref (+ (deref var_5) (* 3 8))))) 75)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_5) (* 3 8))) 8))) 0)
                        (define var_9)
                        (if (== (get-int32 main-hand self) 0)) 
                            (set! var_9 *scav-drawer-exit-l-hand*)
                         else 
                            (set! var_9 *scav-drawer-exit-r-hand*)
                        
                        (set! (deref (cast u64* (+ (deref (+ (deref var_5) (* 3 8))) 8))) var_9)
                        (set! (deref (cast i32* (deref (+ (deref var_5) (* 4 8))))) 30)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_5) (* 4 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_5) (* 4 8))) 8))) 0.40)
                        (set! (deref (cast i32* (deref (+ (deref var_5) (* 5 8))))) 44)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_5) (* 5 8))) 8))) 0)
                        (set! (deref (cast u8* (+ (deref (+ (deref var_5) (* 5 8))) 8))) (get-boolean mirror? self))
                        (animate_ player (get-symbol arrow-pull-animation self) var_5)
                        (set-boolean is-partial-exit 1 self)
                    
                
                lambda 
                    (debug-draw-string-2d (alloc-point 100.00 80.00 0.00 0) (dc:format "PHASE:       %0.4f" (get-animation-phase self 2 (symbol-concat-string (get-symbol arrow-pull-animation self) "--arrow"))) 7 0.00 1.00 0 0 0 1.00)
                
                lambda 
                    (if (and (get-boolean arrow-picked-up? self) (>= (get-animation-phase self 2 (symbol-concat-string (get-symbol arrow-pull-animation self) "--arrow")) 0.85))) 
                        (debug-draw-string-2d (alloc-point 100.00 60.00 0.00 0) "Consume ARROW" 7 0.00 1.00 0 0 0 1.00)
                        (if (== (get-int32 main-hand self) 1)) 
                            (item-pickup-play-pickup-done-sound self r_wrist)
                         else 
                            (item-pickup-play-pickup-done-sound self l_wrist)
                        
                        (send-event suppress-pickup-sound self)
                        (send-event enable-systemic-pickup self)
                        (player-apply-pickup self)
                        (set-boolean arrow-picked-up? 0 self)
                        (debug-draw-string-2d (alloc-point 300.00 80.00 0.00 0) (dc:format "ITEM-ID:       %s" (string-debug (item-pickup-get-item-id self))) 7 2.00 1.00 0 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 300.00 100.00 0.00 0) (dc:format "ITEM-AMOUNT:       %i" (item-pickup-get-amount self)) 7 2.00 1.00 0 0 0 1.00)
                    
                
            }
        }
    }
    state secure-exit {
        block start {
            track main {
                lambda 
                    (if (object-spawned? (get-symbol main-ik-solver self))) 
                        (stop-joint-ik (get-symbol main-ik-solver self) 0.20)
                    
                
                lambda 
                    (if (object-spawned? (get-symbol secondary-ik-solver self))) 
                        (stop-joint-ik (get-symbol secondary-ik-solver self) 0.20)
                    
                
                lambda 
                    (stop-animating player 2 0.20 (get-symbol arrow-pull-animation self) 0)
                
                lambda 
                    (if (get-boolean arrow-picked-up? self)) 
                        (if (== (get-int32 main-hand self) 1)) 
                            (item-pickup-play-pickup-done-sound self r_wrist)
                         else 
                            (item-pickup-play-pickup-done-sound self l_wrist)
                        
                        (send-event suppress-pickup-sound self)
                        (send-event enable-systemic-pickup self)
                        (player-apply-pickup self)
                        (set-boolean arrow-picked-up? 0 self)
                    
                
                lambda 
                    (if (get-boolean is-abort-exit? self)) 
                        (animate-start self (symbol-concat-string (get-symbol arrow-pull-animation self) "--arrow") 0 0)
                        (wait-one-frame)
                        (set-symbol main-ik-solver 0 self)
                        (set-symbol secondary-ik-solver 0 self)
                        (go wait-interact 1)
                    
                
                lambda 
                    (wait 0.30)
                
                lambda 
                    (kill-entity self)
                
                lambda 
                    (go complete 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (disable-drawing-interactable-icon)
                
            }
        }
    }
}
