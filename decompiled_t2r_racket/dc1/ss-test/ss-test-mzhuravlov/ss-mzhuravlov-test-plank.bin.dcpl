        symbol pickup-anim-pair = nullptr
        f32 pickup-anim-pair-weight = 0.00
        bool pickup-anim-is-horizontal? = nullptr
        bool pickup-anim-is-mirrored? = nullptr
    }
    state initial {
        block start {
            track main {
                lambda 
                    (kill-entity plank-pickup-1)
                
                lambda 
                    (enable-entity-respawn plank-pickup-1)
                
                lambda 
                    (spawn-entity plank-pickup-1 0 0)
                
                lambda 
                    (set-float frame-count 0.00 self)
                
                lambda 
                    (set-spawner-locator plank-pickup-1 (get-object-locator plank-default-locator-1))
                
            }
        }
        block update {
            track main {
                lambda 
                    (draw-help)
                
                lambda 
                    (set-tension-mode 1)
                
                lambda 
                    (joypad-disable-commands listen-hold listen-press aim aim-press aim-hold-long aim-hold)
                
                lambda 
                    (joypad-disable-commands inventory-open inventory-close inv-open inv-close weapon-cross-left weapon-cross-right weapon-cross-up weapon-cross-down)
                
                lambda 
                    (if (debug-joypad-command-active? debug-script-press-l2 0)) 
                        (if (get-boolean draw-help? self)) 
                            (set-boolean draw-help? 0 self)
                         else 
                            (set-boolean draw-help? 1 self)
                        
                    
                
                lambda 
                    (if (and (player-in-region? rgn-trigger-plank-1 2) (not (get-boolean in-region self)))) 
                        (set-boolean in-region 1 self)
                        (if (not (get-boolean carry-plank? self))) 
                            (go carry-plank-gesture 1)
                         else 
                            (go kill-gesture 1)
                        
                    
                
                lambda 
                    (if (and (player-in-region? rgn-trigger-plank-2 2) (not (get-boolean in-region self)))) 
                        (set-boolean in-region 1 self)
                        (go plank-pickup 1)
                    
                
                lambda 
                    (if (and (not (player-in-region? rgn-trigger-plank-2 2)) (not (player-in-region? rgn-trigger-plank-1 2)))) 
                        (set-boolean in-region 0 self)
                    
                
                lambda 
                    (if (and (player-in-region? rgn-trigger-plank-3 2) (not (get-boolean in-region self)))) 
                        (set-boolean in-region 1 self)
                        (go preview 1)
                    
                
                lambda 
                    (if (player-in-region? rgn-trigger-plank-4 2)) 
                        (go pickup-blend-pair 1)
                    
                
                lambda 
                    (if (joypad-command-active? jump 6)) 
                        (go test-animation 1)
                    
                
                lambda 
                    (if (get-boolean carry-plank? self)) 
                        (disable-collision plank-attach-01 0)
                        (set-object-locator plank-attach-01 (get-joint-locator player r_hand_prop))
                        (set-move-mode walk)
                        (set-float gesture-target-dist (get-player-to-object-distance plank-gesture-target-1) self)
                        (if (<= (get-float gesture-target-dist self) 3.00)) 
                            (set-float gesture-target-weight (lerp-scale 3.00 1.00 0.00 1.80 (get-float gesture-target-dist self)) self)
                            (if (> (get-float gesture-target-weight self) 0.00)) 
                                (define var_7 (alloc-gesture-play-params))
                                (set! (deref (cast u64* (+ var_7 8))) plank-gesture-target-1)
                                (set! (deref (cast i32* (+ var_7 36))) 19)
                                (set! (deref (cast i32* (+ var_7 116))) 2)
                                (set! (deref (cast f32* (+ var_7 76))) (get-float gesture-target-weight self))
                                (set! (deref (cast u8* (+ var_7 2))) 1)
                                (set! (deref (cast u8* (+ var_7 34))) 1)
                                (set! (deref (cast u8* (+ var_7 112))) 1)
                                (set! (deref (cast u8* (+ var_7 72))) 1)
                                (gesture_ player ellie-plank-carry-point-gesture var_7)
                            
                        
                    
                
            }
        }
    }
    state carry-plank-gesture {
        block start {
            track main {
                lambda 
                    (set-boolean carry-plank? 1 self)
                
                lambda 
                    (enable-entity-respawn plank-attach-01)
                
                lambda 
                    (spawn-entity plank-attach-01 0 0)
                
                lambda 
                    (define var_0 (alloc-gesture-play-params))
                    (set! (deref (cast u64* (+ var_0 8))) plank-gesture-target-1)
                    (set! (deref (cast i32* (+ var_0 36))) 19)
                    (set! (deref (cast u8* (+ var_0 2))) 1)
                    (set! (deref (cast u8* (+ var_0 34))) 1)
                    (gesture_ player ellie-plank-carry-gesture var_0)
                
                lambda 
                    (go initial 1)
                
            }
        }
    }
    state kill-gesture {
        block start {
            track main {
                lambda 
                    (kill-entity plank-attach-01)
                
                lambda 
                    (set-boolean carry-plank? 0 self)
                
                lambda 
                    (clear-gesture-instantly player -1)
                
                lambda 
                    (clear-gesture-instantly player -1)
                
                lambda 
                    (go initial 1)
                
            }
        }
    }
    state plank-pickup {
        block start {
            track main {
                lambda 
                    (set-bound-frame pickup-plank-goal-end (get-align-from-ap-ref player ellie-move-objects-plank-pickup-ground-tip (rotate-locator-angle (get-object-locator plank-pickup-1) 0 -90.00) 0.00 apReference) self)
                
                lambda 
                    (debug-draw-locator (get-bound-frame pickup-plank-goal-end self) 1.50 1.50 0 2.00 0)
                
                lambda 
                    (player-scripted-move-new (get-bound-frame pickup-plank-goal-end self) 1 0 7 0 0)
                
            }
        }
        block update {
            track main {
                lambda 
                    (debug-draw-string-2d (alloc-point 940.00 (+ (get-float console-y-start self) 175.00) -4.00 0) (dc:format "Distance to pickup plank -apRef offset: %0.1f" (get-locator-distance (get-object-locator player) (get-bound-frame pickup-plank-goal-end self))) 7 0.00 0.70 0 0 0 1.00)
                
                lambda 
                    (if (get-boolean pickup-plank? self)) 
                        (set-float frame-count (+ (get-float frame-count self) 1.00) self)
                    
                
                lambda 
                    (if (and (not (get-boolean pickup-plank? self)) (< (get-locator-distance (get-object-locator player) (get-bound-frame pickup-plank-goal-end self)) 0.80))) 
                        (define var_4 (alloc-gesture-play-params))
                        (set! (deref (cast i32* (+ var_4 36))) 19)
                        (set! (deref (cast u8* (+ var_4 34))) 1)
                        (gesture_ player ellie-plank-aproach-test-gesture var_4)
                        (set-boolean pickup-plank? 1 self)
                     else (if (<= (get-locator-distance (get-object-locator player) (get-bound-frame pickup-plank-goal-end self)) 0.20)) 
                        (go animate-plank-pickup 1)
                    
                
            }
        }
    }
    state animate-plank-pickup {
        block start {
            track main {
                lambda 
                    (disable-collision plank-pickup-1 0)
                
                lambda 
                    (clear-gesture player -1 -1.00 0)
                
