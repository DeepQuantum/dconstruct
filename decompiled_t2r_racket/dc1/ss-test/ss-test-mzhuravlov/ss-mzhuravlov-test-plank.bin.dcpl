    state play-pickup-blend-pair {
        block start {
            track main {
                lambda 
                    (set-float frame-count 0.00 self)
                
                lambda 
                    (set-boolean pickup-plank? 0 self)
                
                lambda 
                    (debug-draw-string-2d (alloc-point 940.00 (+ (get-float console-y-start self) 125.00) -4.00 0) (dc:format "Player Z offset: %0.1f" (deref (cast f32* (+ (get-object-position player) 8)))) 7 2.00 0.70 0 0 0 1.00)
                
                lambda 
                    (if (< (deref (cast f32* (+ (get-object-position player) 8))) 15.00)) 
                        (set-boolean pickup-anim-is-mirrored? 1 self)
                     else (if (< (deref (cast f32* (get-object-position player))) 1.00)) 
                        (if (< (deref (cast f32* (+ (get-object-position player) 8))) 20.00)) 
                            (set-boolean pickup-anim-is-mirrored? 1 self)
                         else 
                            (set-boolean pickup-anim-is-mirrored? 0 self)
                        
                    
                
                lambda 
                    (if (get-boolean pickup-anim-is-mirrored? self)) 
                        (set-object-locator plank-pickup-2 (get-object-locator plank-default-locator-3))
                        (set-object-locator plank-pickup-2-invs-1 (get-object-locator plank-default-locator-3))
                        (set-object-locator plank-pickup-2-invs-2 (get-object-locator plank-default-locator-3))
                        (if (and (<= (deref (cast f32* (+ (get-object-position player) 8))) 16.40) (>= (deref (cast f32* (+ (get-object-position player) 8))) 15.00))) 
                            (set-symbol pickup-anim ellie-move-objects-plank-pickup-ground-1-third-20cm self)
                            (set-symbol pickup-anim-pair ellie-move-objects-plank-pickup-ground-1-third-140cm self)
                            (set-float pickup-anim-pair-weight (lerp-scale 15.20 16.40 0.00 1.00 (deref (cast f32* (+ (get-object-position player) 8)))) self)
                         else (if (and (<= (deref (cast f32* (+ (get-object-position player) 8))) 17.79) (>= (deref (cast f32* (+ (get-object-position player) 8))) 16.40))) 
                            (set-symbol pickup-anim ellie-move-objects-plank-pickup-ground-2-third-140cm self)
