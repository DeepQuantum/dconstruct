statescript {
    options {
        player
        mg-wat-horse-explore-script
    }
    declarations {
    }
    state wait-to-spawn {
        block update {
            track main {
                lambda 
                    (if (player-in-region? (tag-symbol spawn-region self) 2)) 
                        (go spawned 1)
                    
                
