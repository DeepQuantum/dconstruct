statescript {
    options {
        player
        sp-all
    }
    declarations {
        symbol shield = #0000000000000000
        f32 attack-lerp = 0.00
    }
    state setup {
        block start {
            track main {
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (set-symbol shield (spawn-entity riot-shield-proto-spawner-1 0 0) self)
                
                lambda 
                    (npc-set-movement-speed-scale self 0.80)
                
                lambda 
                    (make-player-pass-through (get-symbol shield self))
                
                lambda 
                    (melee-fact-set-bool self has-riot-shield 1)
                
                lambda 
                    (go locomotion 1)
                
            }
        }
    }
    state locomotion {
        block update {
            track main {
                lambda 
                    (if (and (character-in-finisher? self) (character-in-melee-attack-as-defender? self))) 
                        (go dead 1)
                    
                
                lambda 
                    (define var_5)
                    (if (npc-using-skill? self 58)) 
                        (set! var_5 (rotate-locator-angle (set-locator-rotation (flatten-locator (get-joint-locator self neck)) (get-object-rotation self)) 1 180.00))
                    
                    (define var_8)
                    (if (not (npc-using-skill? self 58))) 
                        (if (and (character-in-melee-attack-as-attacker? self) (melee-damage-event-active? self))) 
                            (+=f attack-lerp (* 5.00 (get-delta-time)) self)
                         else (if (is-melee-hit-reaction-playing? self)) 
                            (-=f attack-lerp (* 2.50 (get-delta-time)) self)
                         else (if (> (get-float attack-lerp self) 0.00)) 
                            (-=f attack-lerp (* 0.50 (get-delta-time)) self)
                        
                        (clamp-var attack-lerp 0.00 1.00 self)
                        (set! var_8 (rotate-locator-angle var_5 1 (lerp-scale 0.00 1.00 0.00 110.00 (get-float attack-lerp self))))
                    
                    (if (and (< (get-float attack-lerp self) 0.50) (is-in-front? var_8 (get-object-locator player) 2 120.00))) 
                        (melee-fact-set-bool self riot-shield-up 1)
                     else 
                        (melee-fact-set-bool self riot-shield-up 0)
                    
                    (set-object-locator (get-symbol shield self) (offset-locator var_8 (alloc-vector 0.00 -0.40 0.50 1.00 0)))
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (if (== (event-arg-symbol 0) (get-self-id))) 
                        (go dead 1)
                    
                
            }
        }
    }
    state dead {
        block start {
            track main {
                lambda 
                    (melee-fact-set-bool self has-riot-shield 0)
                
                lambda 
                    (melee-fact-set-bool self riot-shield-up 0)
                
                lambda 
                    (enable-physics (get-symbol shield self) 0 0.00)
                
            }
