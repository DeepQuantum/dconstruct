statescript {
    options {
        player
        sp-all
        hun-hotel-stalker-prototype
    }
    declarations {
        i32 reinf-count = 0
    }
    state spawn-reinforcements {
        block start {
            track main {
                lambda 
                    (let loop () (when (not (> (darray-count all-enemy-npcs) 0)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (npc-make-aware-of (group-random all-enemy-npcs) player 2 *npc-awareness-options-no-surprise*)
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (define var_0 (get-furthest-in-group stalker-reinf-spawners player))
                    (spawn-entity-at npc-stalker-reinforcement-1 (get-spawner-locator var_0 1) 0)
                    (if (< (darray-count stalker-reinf-spawners) 7)) 
                        (darray-reset stalker-reinf-spawners)
                    
                    (darray-find-remove stalker-reinf-spawners (new-boxed-value 7 var_0) 0)
                    (++ reinf-count self)
                    (if (> (get-int32 reinf-count self) 5)) 
                        (set! var_5 (go wait-for-end 1))
                    
                
            }
        }
    }
    state wait-for-end {
        block event npc-died {
            track main {
                lambda 
                    (if (== (npc-group-alive-count all-enemy-npcs) 0)) 
                        (go combat-done 1)
                    
                
            }
        }
    }
    state combat-done {
        block start {
            track main {
                lambda 
                    (wait 3.00)
                
                lambda 
                    (request-dialog player-callout-combat-end player 0 0 0 0 0)
                
            }
        }
    }
}
