statescript {
    options {
        player
    }
    state  {
    }
    state wait-for-meatshield {
        block update {
            track main {
                lambda 
                    (if (and (and (or (player-in-state? Melee) (player-in-state? GrappleNpc)) 0) (player-in-meatshield-sequence? 1))) 
                        (go make-noise 1)
                    
                
            }
        }
