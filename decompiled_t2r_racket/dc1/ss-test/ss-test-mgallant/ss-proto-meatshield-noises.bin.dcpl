    state make-noise {
        block update {
            track main {
                lambda 
                    (if (not (player-in-meatshield-sequence? 1))) 
                        (go wait-for-meatshield 1)
                    
                
                lambda 
                    (audio-gameplay-event meatshield (get-object-position player) player)
                
            }
        }
    }
}
