                        (define var_3 (#%alloc-array single-frame 16 3 1))
                        (set! (deref (cast i32* (deref (+ (deref var_3) (* 0 8))))) 10)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_3) (* 0 8))) 8))) 0)
