                        (draw-radio-option (wrap-string "press D-Pad Up to use radio" 35) 1 (get-float centre-offset self) "" 0.00)
                    
                
                lambda 
                    (if (and (get-boolean active-conversation self) (get-boolean radio self))) 
                        (draw-radio-option (wrap-string "Put Radio Away" 35) 3 (get-float centre-offset self) "[D-Pad Down] " (+ (get-float centre-y-offset self) 200.00))
                    
                
                lambda 
                    (if (not (string-eq? (get-string radio-option-1 self) "null"))) 
                        (draw-radio-option (wrap-string (get-string radio-option-1 self) 35) 7 (get-float left-offset self) "[D-Pad Left] " 0.00)
                    
                
                lambda 
                    (if (not (string-eq? (get-string radio-option-2 self) "null"))) 
                        (draw-radio-option (wrap-string (get-string radio-option-2 self) 35) 9 (get-float centre-offset self) "[D-Pad Up] " (get-float centre-y-offset self))
                    
                
                lambda 
                    (if (not (string-eq? (get-string radio-option-3 self) "null"))) 
                        (draw-radio-option (wrap-string (get-string radio-option-3 self) 35) 2 (get-float right-offset self) "[D-Pad Right] " 0.00)
                    
                
            }
