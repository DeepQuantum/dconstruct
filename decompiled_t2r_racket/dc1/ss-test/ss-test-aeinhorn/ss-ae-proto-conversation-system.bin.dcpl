    state hud {
        block update {
            track main {
                lambda 
                    (if (get-boolean active-conversation self)) 
                        (joypad-disable-commands menu-up menu-down menu-right menu-left)
                    
                
                lambda 
                    (if (and (joypad-command-active? radio-down 6) (get-boolean radio self))) 
                        (set-boolean active-conversation 0 self)
                        (end-radio-conversation)
                    
                
                lambda 
