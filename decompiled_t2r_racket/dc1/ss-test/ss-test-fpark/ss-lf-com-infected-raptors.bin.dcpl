                        (spawn-npc npc-infected-raptors-runner-1 0 0)
                    
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (if (== (npc-group-alive-count lf-com-infected-raptors-npcs) 0)) 
                        (go combat-end 1)
                    
                
            }
        }
