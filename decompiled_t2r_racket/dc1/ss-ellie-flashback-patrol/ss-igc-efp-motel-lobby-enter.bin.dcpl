                    (signal release-player 0)
                
                lambda 
                    (wait-until-frame 356)
                
                lambda 
                    (signal enable-collision 0)
                
            }
            track haptics {
                lambda 
                    (if (joypad-has-haptics? 2)) 
                        (wait-until-anim-frame player efp-joel-ellie-enter-motel-lobby--ellie-outro 274.00 2)
                        (play-hfx-id door-open-haptic 0 2)
                    
                
            }
        }
    }
    state wait-make-systemic {
        block start {
            track wait-door-systemic {
                lambda 
                    (let loop () (when (and (and (and (! (is-object-on-screen? door-lobby-dbl-l-1 0.00)) (! (is-object-on-screen? door-lobby-dbl-r-1 0.00))) (distance-between-objects-greater-than? player door-lobby-dbl-l-1 5.00 1)) (not (distance-between-objects-greater-than? player door-lobby-dbl-r-1 5.00 1))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (stop-animating door-lobby-dbl-l-1 2 0.00 0 0)
                
                lambda 
                    (stop-animating door-lobby-dbl-r-1 2 0.00 0 0)
                
                lambda 
                    (go already-complete 1)
                
            }
            track lights {
                lambda 
                    (turn-off-light superSpot-runtime-Shape-4 0)
                
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda 
                    (door-enable-systemic door-lobby-dbl-l-1 0)
                
                lambda 
                    (door-enable-systemic door-lobby-dbl-r-1 0)
                
                lambda 
                    (door-open door-lobby-dbl-l-1 1)
                
                lambda 
                    (door-open door-lobby-dbl-r-1 1)
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
