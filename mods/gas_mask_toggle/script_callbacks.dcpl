        #spawn-script("ss-buddy-targeting-debug", null, player, 0);
        #spawn-script("ss-buddy-infected-danger-debug", null, player, 0);
        #spawn-script("ss-debug-poi-placer", null, player, 0);
        #spawn-script("ss-buddy-downed", null, player, 0);
        #spawn-script("ss-debug-thirds-grid", null, player, 0);
        #spawn-script("ss-debug-screen-dot-controller", null, player, 0);
        #spawn-script("ss-player-responsiveness-graph", null, player, 0);
