    #spawn-script("ss-accessibility-horse-jump", null, player, 0);
    #spawn-script("ss-accessibility-clamber", null, player, 0);
    #spawn-script("ss-accessibility-lockon-aim", null, player, 0);
    #spawn-script("ss-accessibility-lost-control-sound", null, player, 0);
    #spawn-script("ss-dynamic-checkpoint-manager", null, player, 0);
    #spawn-script("ss-player-hold-breath-aim-controller", null, player, 0);
