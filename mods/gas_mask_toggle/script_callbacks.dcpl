    #spawn-script("ss-promote-death-hints", null, player, 0);
    #spawn-script("ss-player-melee-moveset-controller", null, player, 0);
    #spawn-script("player-survive-with-one-health", null, player, 0);
    #spawn-script("ss-weapon-stats", null, player, 0);
    #spawn-script("ss-revolver-bullet-counter", null, player, 0);
    #spawn-script("ss-pistol-xcaliber-manager", null, player, 0);
    #spawn-script("ss-shotgun-baserri-bullet-counter", null, player, 0);
    #spawn-script("ss-reminders", null, player, 0);
    #spawn-script("ss-npc-begs-for-life", null, player, 0);
    #spawn-script("ss-hud2-buddy-status", null, player, 0);
    #spawn-script("ss-hud2-buddy-callout-icons", null, player, 0);
    #spawn-script("ss-hud2-reminder-manager", null, player, 0);
    #spawn-script("ss-idle-controller", "ss-idle-controller--player", player, 0);
    #spawn-script("ss-emotional-fade-controller", "ss-emotional-fade-controller--player", player, 0);
    #spawn-script("ss-waterfall-reaction", null, player, 0);
    #spawn-script("ss-player-messy-hair-manager", null, player, 0);
    #spawn-script("ss-prone-aim-grass-pusher", null, player, 0);
    #spawn-script("ss-hud2-proto-stealth-vignette", null, player, 0);
    #spawn-script("ss-pain-killers", null, player, 0);
    #spawn-script("ss-explosive-arrow", null, player, 0);
    #spawn-script("ss-proto-swap-pickaxe-pickup", null, player, 0);
    #spawn-script("ss-flashlight-dimming", null, player, 0);
    #spawn-script("ss-horse-rumble", null, player, 0);
    #spawn-script("ss-dumpster-rumble", null, player, 0);
    #spawn-script("ss-rope-swing-haptics", null, player, 0);
    #spawn-script("ss-weather-haptics", null, player, 0);
    #spawn-script("ss-cinematic-haptics-controller", null, player, 0);
