    #spawn-script("ss-debug-draw-controller", null, player, 0);
    #spawn-script("ss-weapon-drop-manager", null, player, 0);
    #spawn-script("ss-player-reload-gameplay-audio", null, player, 0);
    #spawn-script("ss-grounded-pickup-despawn", null, player, 0);
    #spawn-script("ss-adaptive-trigger-controller", null, player, 0);
    #spawn-script("ss-player-skel-fact", null, player, 0);
    if (#pc-build?()) {
        #spawn-script("ss-pc-partial-movement-controller", null, player, 0);
        #spawn-script("ss-hud2-toggle-all", null, player, 0);
    }
    if (arg_0) {
        #spawn-script("ss-player-peek-mode", null, player, 0);
        #spawn-script("ss-melee-rumble-listener", null, player, 0);
        #spawn-script("ss-moshpit-debug", null, player, 0);
