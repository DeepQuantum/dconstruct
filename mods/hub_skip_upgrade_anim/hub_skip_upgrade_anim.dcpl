@game "C:/Program Files (x86)/Steam/steamapps/common/The Last of Us Part II/"
@target "ss-t2/ss-workbench.bin"
@mod "hub_skip_upgrade_anim"

using #wait-for as far (symbol) -> u0;
using #set-animation-speed as far (symbol, f32, u16, u16) -> symbol;
using #wait-one-frame as far () -> u0;
using #set-low-health-screen-effect-fade-request as far (f32, f32) -> u0;
using #inventory-item-add-quantity as near (symbol, u64) -> u0;

u0 #workbench-enter@start@screen-effects@0() {
    #inventory-item-add-quantity(#parts, 1000);
    #set-low-health-screen-effect-fade-request(0.00, 5.00);
}
