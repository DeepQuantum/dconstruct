struct #gas-mask-setup {
    symbol on_gesture;
    symbol off_gesture;
    symbol on_gas_mask;
    symbol idle_gas_mask;
    symbol off_gas_mask;
    symbol gas_mask_name;
    symbol target;
    u8 gas_mask_state;
    u8 unknown0;
    u16 unused1;
    u32 unused2;
    symbol futz;
}

struct #reticle-offset-def-1080p {
    f32 horizontal_offset;
    f32 vertical_offset;
}

struct #weapon-damage-settings-entry {
    i32 base_damage;
    f32 unk000;
    f32 unk00;
    i32 unk0;
    i32 unk1;
    i32 unk2;
    i32 unk3;
    i32 unk4;
    i32 always_50_only_different_for_continuous_damage;
    i32 always_50_2_only_different_for_continuous_damage;
    f32 always_3_only_different_for_continuous_damage;
    i32 bypass_helmet_durability; | "toggling this to 1 makes it so that arrows can kill on 1 shot if enemies are wearing helmets"
}

struct #hud2-reticle-def {
    string base_reticle;
    string scope_reticle;
    string large_reticle;
    string accessiblity_reticle;
    i32 unk0;
    i32 unk1;
    f32 min_spread_size;
    f32 max_spread_size;
    i32 unk2;
    i32 unk3;
}

