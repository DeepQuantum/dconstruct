@standalone
@output "C:/Program Files (x86)/Steam/steamapps/common/The Last of Us Part II/mods/ProjectFEDRA_unpacked/bin/dc1/ss-rogue/test-script-qntm.bin"
@modules "C:/Program Files (x86)/Steam/steamapps/common/The Last of Us Part II/mods/ProjectFEDRA_unpacked/bin/dc1/modules.bin"
@sidbase "C:/Users/damix/Documents/GitHub/TLOU2Modding/dconstruct/test/dc_test_files/sidbase_new_fixed.bin"
@repackage "C:/Program Files (x86)/Steam/steamapps/common/The Last of Us Part II/mods/ProjectFEDRA_unpacked"

using #player as u64;
using #tracking as u64;

using #get-svar-as-boolean as near (u64) -> bool;
using #increment-stat as far (u64, u64) -> u0; 
using #set-stat-bit as far (u64, u64) -> u0;

using #display as far (string, u64) -> u0;
//using #dc:format as far (string, u64, u64) -> string;

using #rogue-cheat-mod-ever-enabled as u64;
using #runs-complete-dina as u64;
using #meta-runs-complete as u64;
using #trophy-win-with-all-characters as u64;

using #stun-bomb-smoke as u64;
using #recipe-smoke-bomb as u64;

using #recipe-stun-bomb as u64;

using #player-upgrade-active? as far (u64) -> bool;
using #get-inventory-item-quantity as near (u64) -> u64;

using #inventory-item-add-quantity as near (u64, u64) -> u0;
using #inventory-item-consume as near (u64, u64) -> u0;

using #*ellie-gas-mask-setup* as u64;
using #gas-mask-setup as u64;

using #set-gas-mask-setting-id as far (u64, u64) -> u0;
using #get-gas-mask-setting-id as far (u64) -> u64;
using #lookup-symbol as far (u64, u64) -> u64;
using #dc:format as far (string, u64, u64) -> string;
using #wait-equip-gas-mask as near (u64, u64, u64) -> u64;
using #wait as far (f32) -> u0;
using #spawn-gas-mask as near (u64) -> u64;
using #keyboard-button-pressed? as far (u64) -> bool;


statescript #test-script-qntm {
    options {
        #player
    }
    state #tracking {
        block start {
            track #main {
                lambda {
                    #display("Custom script", 19);
                    
                    #set-gas-mask-setting-id(#player, #*ellie-gas-mask-setup*);   
                }
            }
        }
        block update {
            track #main {
                lambda {
                    if (#keyboard-button-pressed?(158)) {
                        #display("pressed", 19);
                        u64 test = #get-gas-mask-setting-id(#player);
                        u64 test1 = #lookup-symbol(test, #gas-mask-setup);
                        #display(#dc:format("set gas mask setting id with params: %016llx %016llx", test, test1), 8);
                        
                        u64 gas_mask = #wait-equip-gas-mask(#player, 0, 1);

                        #display(#dc:format("gas mask: %016llx %d", gas_mask, 0), 19);    
                    }
                }
            }
        }
    }
}