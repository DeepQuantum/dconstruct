                            wait-until-anim-frame(player, get-symbol(ellies-anim, self), 244.00, 2);
                            play-hfx-id(boost-lift-haptic, 0, 2);
                            wait-until-anim-frame(player, get-symbol(ellies-anim, self), 292.00, 2);
                            play-hfx-id(falling-grab-rumble-settings, 0, 2);
                            wait-until-anim-frame(player, get-symbol(ellies-anim, self), 354.00, 2);
                            play-hfx-id(falling-grab-rumble-settings, 0, 2);
                            wait-until-anim-frame(player, get-symbol(ellies-anim, self), 394.00, 2);
                            play-hfx-id(clamber-right-hand-light-haptic, 0, 2);
                            wait-until-anim-frame(player, get-symbol(ellies-anim, self), 428.00, 2);
                            play-hfx-id(clamber-left-hand-light-haptic, 0, 2);
                            wait-until-anim-frame(player, get-symbol(ellies-anim, self), 481.00, 2);
                            play-hfx-id(climb-hand-right-light-rumble-settings, 0, 2);
                            wait-until-anim-frame(player, get-symbol(ellies-anim, self), 509.00, 2);
                            play-hfx-id(climb-hand-left-light-rumble-settings, 0, 2);
                        }
                    }
                }
            }
            track vox {
                lambda {
                    if (!get-boolean(vox-boost?, self)) {
                        wait-for(anim-start);
                        set-boolean(vox-boost?, 1, self);
                        if (get-boolean(long-form, self)) {
                            say(player, vox-igc-ell-igc-sea-qz-wall-boost-boost-long-001, 2, 0);
                            say(dina, vox-igc-din-igc-sea-qz-wall-boost-boost-long-001, 2, 0);
                            wait-frames(600);
                            send-event(ellie-boosted, ss-vox-sea-qz-wall-gate-1);
                        } else {
                            say(player, vox-igc-ell-igc-sea-qz-wall-boost-boost-001, 2, 0);
                            say(dina, vox-igc-din-igc-sea-qz-wall-boost-boost-001, 2, 0);
                            wait-frames(500);
                            send-event(ellie-boosted, ss-vox-sea-qz-wall-gate-1);
                        }
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (player-in-state?(Ladder) || player-in-state?(Script) && 0) {
                        joypad-disable-commands(crouch-press, crouch-release, drop-hold);
                    }
                }
                lambda {
                    override-render-settings(
                        *sea-rs-sea-igc-wall-boost-ladder*,
                        0.00,
                        -1.00,
                        0,
                        32767,
                        0,
                        1,
                        0,
                        1.00
                    );
                }
                lambda {
                    camera-set-overlay(*camera-remap-ladder*);
                }
            }
        }
    }
    state wait-fall {
        block start {
            track main {
                lambda {
                    set-boolean(vox-boost-done?, 1, ss-vox-sea-qz-wall-gate-1);
                }
                lambda {
                    interactable-disable(int-sea-qz-truck-boost-2);
                }
                lambda {
                    wait(3.00);
                }
                lambda {
                    if (!script-in-state?(ss-sea-qz-wall-pole-jump-1, jump-to-pole)) {
                        wait-npc-move-to-entry-frame(
                            dina,
                            sea-qz-wall-dina-hints-1--dina,
                            get-object-or-spawner-locator(ap-sea-qz-wall-dina-points-6),
                            1,
                            1,
                            0,
                            0,
                            0.00,
                            apReference,
                            npc-m-ambi-entry-table
                        );
                        if (!script-in-state?(ss-sea-qz-wall-pole-jump-1, jump-to-pole)) {
                            set-boolean(playing-anim, 1, self);
                            u64? var_3 = #%alloc-array(single-frame, 16, 3, 1);
                            *(i32*)*(*var_3 + (0 * 8)) = 10;
                            *(u64*)(*(*var_3 + (0 * 8)) + 8) = 0;
                            *(u64*)(*(*var_3 + (0 * 8)) + 8) = get-spawner-locator(ap-sea-qz-wall-dina-points-6, 1);
                            *(i32*)*(*var_3 + (1 * 8)) = 28;
                            *(u64*)(*(*var_3 + (1 * 8)) + 8) = 0;
                            *(f32*)(*(*var_3 + (1 * 8)) + 8) = 0.75;
                            *(i32*)*(*var_3 + (2 * 8)) = 30;
                            *(u64*)(*(*var_3 + (2 * 8)) + 8) = 0;
                            *(f32*)(*(*var_3 + (2 * 8)) + 8) = 0.50;
                            animate_(dina, sea-qz-wall-dina-hints-1--dina, var_3);
                        }
                    }
                }
            }
            track birds {
                lambda {
                    if (get-boolean(from-top, self)) {
                        while (!entity-exists?(obj-sea-qz-over-top-bird-2)) {
                            wait-one-frame();
                        }
                        wait(1.50);
                        send-event(force-flee, obj-sea-qz-over-top-bird-2);
                    }
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-active?(seattle-arrival, sea-qz-wall-gate-walkway)) {
                        go(look-about, 1);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (player-in-state?(Ladder)) {
                        joypad-disable-commands(crouch-press, crouch-release, drop-hold);
                    }
                }
                lambda {
                    if (get-boolean(playing-anim, self)) {
                        look-at-object(dina, player, r_eyeball, 10.00);
                    }
                }
            }
        }
    }
    state look-about {
        block start {
            track main {
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 3, 1);
                    *(i32*)*(*var_0 + (0 * 8)) = 10;
                    *(u64*)(*(*var_0 + (0 * 8)) + 8) = 0;
                    *(u64*)(*(*var_0 + (0 * 8)) + 8) = get-spawner-locator(ap-sea-qz-wall-dina-points-7, 1);
                    *(i32*)*(*var_0 + (1 * 8)) = 28;
                    *(u64*)(*(*var_0 + (1 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (1 * 8)) + 8) = 0.75;
                    *(i32*)*(*var_0 + (2 * 8)) = 30;
                    *(u64*)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (2 * 8)) + 8) = 0.50;
                    animate_(dina, sea-qz-wall-dina-hints-1--dina, var_0);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-active?(seattle-arrival, sea-qz-door-puzzle)) {
                        go(complete, 1);
                    }
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    interactable-disable(int-sea-qz-truck-boost-2);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
