        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    interactable-disable(int-sea-horse-sanc-door-1);
                }
                lambda {
                    set-object-locator(obj-sea-horse-sanc-door-open-1, get-spawner-locator(pos-sea-horse-sanc-door-2, 1));
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
