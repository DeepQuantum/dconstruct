                    *(f32*)(*(*var_0 + (1 * 8)) + 8) = 0.50;
                    *(i32*)*(*var_0 + (2 * 8)) = 30;
                    *(u64*)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (2 * 8)) + 8) = 0.50;
                    *(i32*)*(*var_0 + (3 * 8)) = 24;
                    *(u64*)(*(*var_0 + (3 * 8)) + 8) = 0;
                    *(i32*)(*(*var_0 + (3 * 8)) + 8) = 10;
                    wait-animate_(dina, sea-horse-dead-bodies-door-success--dina, var_0);
                }
                lambda {
                    camera-fade-out-animated(1.50, 0);
                }
                lambda {
                    wait(0.50);
                }
                lambda {
                    npc-teleport-to(dina, get-spawner-locator(ap-sea-building-tommys-shirt-1, 1));
                }
                lambda {
                    wait(0.50);
                }
                lambda {
                    buddy-get-on-horse(dina, player-horse, 1, 0, 0);
                }
                lambda {
                    wait(0.20);
                }
                lambda {
                    wait-stub-object-lerp(horse, ch-sea-horse-wall-approach-1, 0.10, 1, 1.00);
                }
                lambda {
                    interactable-enable(horse);
                }
                lambda {
                    go(talk-about-mud, 1);
                }
            }
        }
    }
    state talk-about-mud {
        block start {
            track main {
                lambda {
                    wait-say(player, vox-igc-ell-gam-sea-horse-building-collapsed-009, 2, 0);
                }
