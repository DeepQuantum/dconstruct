                }
                lambda {
                    auto-save-game();
                }
                lambda {
                    go(wait-interact, 1);
                }
            }
        }
    }
    state open-second-gate {
        block start {
            track main {
                lambda {
                    interactable-disable(int-sea-horse-sanc-gate-rt-2);
                }
                lambda {
                    wait-player-move-to-entry(
                        sea-hub-dome-open-gates-open-left--ellie,
                        get-spawner-locator(pos-sea-horse-dome-gate-1, 1),
                        1,
                        0,
                        0.40,
                        apReference-camera1,
                        apReference-left,
                        0.00,
                        0,
                        1,
                        0,
                        1,
                        0.00,
                        0,
                        1
                    );
                }
                lambda {
                    camera-enable-animated(2.00, -1.00, 1, 1000, 0, 0, 0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 4, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-spawner-locator(pos-sea-horse-dome-gate-1, 1);
                    *(i32*)*var_0[1] = 28;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 0.50;
                    *(i32*)*var_0[2] = 30;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.50;
                    *(i32*)*var_0[3] = 14;
                    *(u64*)(*var_0[3] + 8) = 0;
                    *(u64*)(*var_0[3] + 8) = apReference-left;
                    animate_(obj-sea-horse-dome-gate-2, sea-hub-dome-open-gates-open--gate-left, var_0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 4, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-spawner-locator(pos-sea-horse-dome-gate-1, 1);
                    *(i32*)*var_0[1] = 28;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 0.50;
                    *(i32*)*var_0[2] = 30;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.50;
                    *(i32*)*var_0[3] = 14;
                    *(u64*)(*var_0[3] + 8) = 0;
                    *(u64*)(*var_0[3] + 8) = apReference-left;
                    wait-animate_(player, sea-hub-dome-open-gates-open-left--ellie, var_0);
                }
                lambda {
                    camera-fade-out-animated(2.00, 0);
                }
                lambda {
                    set-svar(sea-horse-dome-gates, 2);
                }
                lambda {
                    auto-save-game();
                }
                lambda {
                    go(rope, 1);
                }
            }
        }
    }
    state rope {
        block start {
            track leave-area {
                lambda {
                    wait-boolean(arrived-exit, 1, self);
                }
                lambda {
                    hud-clear-tutorials(0);
                }
                lambda {
                    wait-boolean(left-dome, 1, self);
                }
                lambda {
                    if (!get-boolean(dina-out-already, self)) {
                        npc-teleport-to(dina, get-spawner-locator(pos-sea-dome-dina-tp-1, 1));
                    }
                }
                lambda {
                    go(complete, 1);
                }
            }
            track no-boost {
                lambda {
                    while (get-boolean(near-exit, self) && !joypad-command-active?(jump, 6)) {
                        wait-one-frame();
                    }
                }
            }
            track hint {
                lambda {
                    send-event(turn-on, hint-waypoint-110);
                }
                lambda {
                    wait-boolean(dina-points-out-push, 1, self);
                }
                lambda {
                    wait(0.50);
                }
                lambda {
                    send-event(turn-on, hint-waypoint-15);
                }
                lambda {
                    wait-boolean(dina-points-out-exit, 1, self);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gen-cya-plyr-hint-gnrc-sp-004, 2, 0);
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gen-cya-dina-hint-rspns-sp-008, 2, 0);
                }
                lambda {
                    send-event(activate-waypoint, hint-waypoint-110);
                }
            }
            track rope-tut {
                lambda {
                    if (!get-boolean(tutorial-once, self)) {
                        wait-boolean(near-rope, 1, self);
                        while (!get-boolean(arrived-exit, self)) {
                            while (player-in-state?(RopeClimb) || !is-text-to-speech-enabled?() && !get-boolean(rope-vox-done, self)) {
                                wait-one-frame();
                            }
                            mark-tutorial-unlocked-by-cipher-id(MENU_TUTORIAL_ROPE_SWING, 1);
                            if (is-text-to-speech-enabled?()) {
                                if (!is-traversal-audio-cues?()) {
                                    hud2-play-tutorial(HUD_FTT_TUTORIAL_ROPE3_PC, 10.00, rope-swing, 0, 2, 0, 0, 0);
                                }
                            }
                            wait-boolean(good-swing, 1, self);
                            wait(1.00);
                            if (player-in-state?(RopeClimb)) {
                                hud2-play-tutorial(HUD_FTT_TUTORIAL_ROPE4, 10.00, jump, 0, 2, 0, 0, 0);
                            }
                            while (player-in-state?(RopeClimb)) {
                                wait-one-frame();
                            }
                            hud2-clear-tutorials(0);
                        }
                        set-boolean(tutorial-once, 1, self);
                    }
                }
            }
            track tts-tutorial {
                lambda {
                    wait-boolean(rope-vox-done, 1, self);
                }
                lambda {
                    while (1) {
                        while (get-boolean(near-rope, self) && !player-in-state?(RopeClimb)) {
                            wait-one-frame();
                        }
                        if (is-text-to-speech-enabled?() && is-traversal-audio-cues?()) {
                            hud2-play-tutorial(TIP_ACCESS_ROPE_SWING, -1.00, none, 0, 2, 0, 0, 0);
                        }
                        while (player-in-state?(RopeClimb)) {
                            wait-one-frame();
                        }
                        hud2-clear-tutorials(0);
                    }
                }
            }
            track cart {
                lambda {
                    wait-boolean(cart-puzzle-done, 1, self);
                }
                lambda {
                    interactable-disable(obj-sea-horse-sanc-dumpster-1);
                }
                lambda {
                    enable-collision-gamedriven(obj-sea-horse-sanc-dumpster-1, 0, 0.00);
                }
                lambda {
                    push-object-set-game-driven(obj-sea-horse-sanc-dumpster-1, 0.00);
                }
                lambda {
                    wait-stub-object-lerp(obj-sea-horse-sanc-dumpster-1, get-closest-spawner-in-group-to-point(sea-dome-cart-pos, get-object-position(obj-sea-horse-sanc-dumpster-1)), 1.00, 1, 1.00);
                }
                lambda {
                    if (get-closest-spawner-in-group-to-point(sea-dome-cart-pos, get-object-position(obj-sea-horse-sanc-dumpster-1)) == pos-obj-sanc-dumpster-moved-7) {
                        enable-action-pack(tap-jump-up-down-33349, 1);
                        enable-action-pack(tap-jump-up-down-33351, 1);
                        enable-action-pack(tap-jump-up-down-33357, 1);
                    } else if (get-closest-spawner-in-group-to-point(sea-dome-cart-pos, get-object-position(obj-sea-horse-sanc-dumpster-1)) == pos-obj-sanc-dumpster-moved-1) {
                        enable-action-pack(tap-jump-up-down-33348, 1);
                        enable-action-pack(tap-jump-up-down-33352, 1);
                        enable-action-pack(tap-jump-up-down-33353, 1);
                        enable-action-pack(tap-jump-up-down-33356, 1);
                    } else {
                        enable-action-pack(tap-jump-up-down-33350, 1);
                        enable-action-pack(tap-jump-up-down-33354, 1);
                        enable-action-pack(tap-jump-up-down-33355, 1);
                    }
                }
            }
            track old-hint {
                lambda {
                    wait(1.00);
                }
                lambda {
                    send-event(turn-off, hint-waypoint-91);
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    send-event(turn-off, hint-waypoint-80);
                }
            }
        }
        block event clear-cart-tut {
            track main {
                lambda {
                    if (get-boolean(dina-points-out-push, self)) {
                        hud-clear-tutorials(0);
                    }
                }
            }
        }
        block  {
        }
        block event hint-displayed {
            track main {
                lambda {
                    if (event-sender() == hint-waypoint-110) {
                        set-boolean(touched-cart-again, 1, self);
                        wait-say(player, vox-igc-ell-gen-cya-plyr-hint-gnrc-sp-001, 2, 0);
                        wait(1.00);
                        wait-say(dina, vox-igc-din-gen-cya-dina-hint-rspns-sp-012, 2, 0);
                        send-event(activate-waypoint, hint-waypoint-110);
                    }
                }
                lambda {
                    if (event-sender() == hint-waypoint-15) {
                        set-boolean(dina-points-out-exit, 1, self);
                        wait-say(player, vox-igc-ell-gen-cya-plyr-hint-gnrc-sp-001, 2, 0);
                        wait(1.00);
                        wait-say(dina, vox-igc-din-gen-cya-dina-hint-rspns-sp-001, 2, 0);
                        send-event(activate-waypoint, hint-waypoint-15);
                    }
                }
                lambda {
                    if (event-sender() == hint-waypoint-16) {
                        send-event(turn-off, hint-waypoint-15);
                        set-boolean(dina-points-out-push, 1, self);
                        hud-play-tutorial(HINT_SEA_SANCTUARY_PUSH_OBJ, -1.00, 2, none, 0.50, 0, 0, 0);
                        wait-say(player, vox-igc-ell-gen-cya-plyr-hint-gnrc-sp-005, 2, 0);
                        wait(1.00);
                        wait-say(dina, vox-igc-din-gen-cya-dina-hint-rspns-sp-001, 2, 0);
                        send-event(activate-waypoint, hint-waypoint-16);
                    }
                }
            }
        }
        block event puzzle-skipped {
            track main {
                lambda {
                    if (get-svar(sea-horse-finding-gas) < 2) {
                        set-svar(dome-first, 1);
                        player-give-key-item(gas-canister-empty);
                        set-svar(sea-horse-finding-gas, 3);
                    } else if (get-svar(sea-horse-finding-gas) == 4) {
                        player-remove-key-item(gas-canister-empty);
                        player-give-key-item(gas-canister-full);
                        set-svar(sea-horse-finding-gas, 6);
                    }
                }
                lambda {
                    hud-clear-tutorials(0);
                }
                lambda {
                    set-svar(sea-horse-dome-gates, 2);
                }
                lambda {
                    task-set-active-continue!(sanctuary-second-floor, 0, 0, 0, 0.00, 0, 0);
                }
                lambda {
                    auto-save-game();
                }
                lambda {
                    task-restart-from-continue();
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (get-boolean(inside-dome, self) && !(task-continue-active?(seattle-arrival, sea-hub-explore, sanctuary-second-floor))) {
                        notify-skippable-puzzle(sea-dome-rope-puzzle, 1);
                    }
                }
                lambda {
                    if (!get-boolean(remind-push, self) && get-boolean(touched-cart-again, self) && player-in-state?(PushPull)) {
                        set-boolean(remind-push, 1, self);
                        send-event(turn-off, hint-waypoint-110);
                    }
                }
                lambda {
                    if (!get-boolean(touched-push, self) && player-in-state?(PushPull)) {
                        set-boolean(touched-push, 1, self);
                    }
                }
                lambda {
                    if (player-in-state?(PushPull)) {
                        pause-all-hints();
                        pause-hint-timer(hint-waypoint-16);
                    }
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    interactable-disable(int-sea-horse-sanc-gate-2);
                }
                lambda {
                    animate-done(obj-sea-horse-dome-gate-1, sea-hub-dome-open-gates-open--gate-right, pos-sea-horse-dome-gate-1, 0, 0, 2);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
