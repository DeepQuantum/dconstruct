                    *(i32*)*var_0[2] = 30;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.50;
                    *(i32*)*var_0[3] = 14;
                    *(u64*)(*var_0[3] + 8) = 0;
                    *(u64*)(*var_0[3] + 8) = apReference-right;
                    wait-animate_(player, sea-hub-dome-open-gates-open-right--ellie, var_0);
