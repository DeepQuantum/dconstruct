        }
        block event player-changed-state {
            track main {
                lambda {
                    go(please-stop-speaking, 1);
                }
            }
        }
        block event sea-surrounded {
            track main {
                lambda {
                    go(please-stop-speaking, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    suppress-all-hints/f();
                }
            }
        }
    }
    state please-stop-speaking {
        block start {
            track main {
                lambda {
                    stop-speaking(player);
                }
                lambda {
                    stop-speaking(dina);
                }
                lambda {
                    go(done, 1);
                }
            }
        }
    }
}
