                lambda {
                    no-hub-conversations();
                }
                lambda {
                    wait-frames(167);
                }
                lambda {
                    set-boolean(vox-took-shotgun?, 1, self);
                }
                lambda {
                    set-boolean(vox-has-shotgun?, 1, self);
                }
                lambda {
                    if (!player-has-weapon?(shotgun-remington-pump)) {
                        wait-say(player, vox-igc-ell-gam-sea-hub-explore-bank-vault-slf-005, 2, 0);
                    }
                }
                lambda {
                    hub-conversations-ok();
                }
                lambda {
                    go(wait-until-done-with-infected-2, 1);
                }
            }
        }
    }
    state wait-until-done-with-infected-2 {
        block event npc-died {
            track main {
                lambda {
                    if (npc-group-alive-count(sea-hub-bank-infected-vox-2) == 0) {
                        if (player-in-region?(rgn-vox-no-conversations-6, 2)) {
                            go(done-with-bank, 1);
                        }
                    }
                }
            }
        }
        block event enter {
            track main {
                lambda {
                    if (!get-svar-as-boolean(vox-sea-hub-bank-leave-bank-done)) {
                        if (get-tension-mode() == 1) {
                            go(done-with-bank, 1);
                        }
                    }
                }
            }
        }
        block event player-changed-state {
            track main {
                lambda {
                    go(done-with-bank-convo-no-fight, 1);
                }
            }
        }
        block event entered-into-investigate {
            track main {
                lambda {
                    go(vault-note, 1);
                }
            }
        }
        block event entered-into-investigate {
            track main {
                lambda {
                    wait(0.50);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-sea-hub-find-ring-001, 2, 0);
                }
            }
        }
    }
    state done-with-bank {
        block start {
            track main {
                lambda {
                    set-svar(vox-sea-hub-bank-leave-bank-done, 1);
                }
                lambda {
                    no-hub-conversations();
                }
                lambda {
                    send-event(leave-convo, ss-vox-sea-hub-interruptible-conversations-1);
                }
                lambda {
                    wait(5.00);
                }
                lambda {
                    while (!!(is-combat-or-search?())) {
                        wait(0.10);
                    }
                }
                lambda {
                    set-svar(vox-sea-hub-bank-done, 1);
                }
                lambda {
                    send-event(complete-poi, ss-sea-horse-map-writing-1, new-boxed-value(2, 5), new-boxed-value(6, 10.00));
                }
                lambda {
                    wait-say(dina, vox-igc-din-gam-sea-hub-explore-bank-return-to-surface-sp-001, 2, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-sea-hub-explore-bank-return-to-surface-sp-001, 2, 0);
                }
                lambda {
                    select-mode-mark-complete(0.00);
                }
                lambda {
                    go(done-bank-convo, 1);
                }
            }
        }
        block event enter {
            track main {
                lambda {
                    set-svar(vox-sea-hub-leave-bank-complete, 1);
                }
            }
        }
    }
    state done-bank-convo {
        block start {
            track main {
                lambda {
                    no-hub-conversations();
                }
                lambda {
                    while (!get-svar-as-boolean(vox-sea-hub-leave-bank-complete)) {
                        wait(0.10);
                    }
                }
                lambda {
                    wait(2.00);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-sea-hub-explore-bank-return-to-surface-sp-002, 2, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-sea-hub-explore-bank-return-to-surface-sp-003, 2, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gam-sea-hub-explore-bank-return-to-surface-sp-002, 2, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gam-sea-hub-explore-bank-return-to-surface-sp-003, 2, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-sea-hub-explore-bank-return-to-surface-sp-004, 2, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gam-sea-hub-explore-bank-return-to-surface-sp-004, 2, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-sea-hub-explore-bank-return-to-surface-sp-005, 2, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gam-sea-hub-explore-bank-return-to-surface-sp-005, 2, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-sea-hub-explore-bank-return-to-surface-sp-006, 2, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gam-sea-hub-explore-bank-return-to-surface-sp-006, 2, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-sea-hub-explore-bank-return-to-surface-slf-007, 2, 0);
                }
                lambda {
                    while (!(player-in-region?(rgn-vox-no-conversations-6, 2)) && npc-on-horse?(dina, horse, 1, 1, 1) && !player-in-state?(RideHorse)) {
                        wait(0.10);
                    }
                }
                lambda {
                    wait(2.00);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gam-sea-hub-explore-bank-entrance-done-sp-003, 2, 0);
                }
                lambda {
                    wait(0.60);
                }
                lambda {
                    if (!(get-boolean(vox-ng-shotgun?, self)) && get-boolean(vox-has-shotgun?, self)) {
                        wait-say(player, vox-igc-ell-gam-sea-hub-explore-bank-entrance-done-sp-002, 2, 0);
                    }
                }
                lambda {
                    hub-conversations-ok();
                }
                lambda {
                    go(next-place, 1);
                }
            }
        }
        block event enter {
            track main {
                lambda {
                    set-svar(vox-sea-hub-leave-bank-complete, 1);
                }
            }
        }
    }
    state done-with-bank-convo-no-fight {
        block start {
            track main {
                lambda {
                    set-svar(vox-sea-hub-leave-bank-complete, 1);
                }
                lambda {
                    send-event(complete-poi, ss-sea-horse-map-writing-1, new-boxed-value(2, 5), new-boxed-value(6, 10.00));
                }
                lambda {
                    select-mode-mark-complete(0.00);
                }
                lambda {
                    no-hub-conversations();
                }
                lambda {
                    while (!(player-in-region?(rgn-vox-no-conversations-6, 2)) && npc-on-horse?(dina, horse, 1, 1, 1) && !player-in-state?(RideHorse)) {
                        wait(0.10);
                    }
                }
                lambda {
                    wait(2.00);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gam-sea-hub-explore-bank-entrance-done-sp-003, 2, 0);
                }
                lambda {
                    wait(0.60);
                }
                lambda {
                    if (!(get-boolean(vox-ng-shotgun?, self)) && get-boolean(vox-has-shotgun?, self)) {
                        wait-say(player, vox-igc-ell-gam-sea-hub-explore-bank-entrance-done-sp-002, 2, 0);
                    }
                }
                lambda {
                    go(next-place, 1);
                }
            }
        }
    }
    state next-place {
        block start {
            track main {
                lambda {
                    no-hub-conversations();
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    if (!(get-svar-as-boolean(vox-sea-hub-courthouse-stash)) && !(get-svar-as-boolean(vox-sea-hub-dome-stash))) {
                        wait-say(player, vox-igc-ell-gam-sea-hub-explore-bank-entrance-done-reminder-sp-001, 2, 0);
                    } else if (get-svar-as-boolean(vox-sea-hub-courthouse-stash) && !(get-svar-as-boolean(vox-sea-hub-dome-stash))) {
                        wait-say(player, vox-igc-ell-gam-sea-hub-explore-bank-entrance-done-reminder-sp-003, 2, 0);
                    } else if (!(get-svar-as-boolean(vox-sea-hub-courthouse-stash)) && get-svar-as-boolean(vox-sea-hub-dome-stash)) {
                        wait-say(player, vox-igc-ell-gam-sea-hub-explore-bank-entrance-done-reminder-sp-002, 2, 0);
                    } else if (get-svar-as-boolean(vox-sea-hub-courthouse-stash) && get-svar-as-boolean(vox-sea-hub-dome-stash)) {
                        wait-say(player, vox-igc-ell-gam-sea-hub-explore-bank-entrance-done-reminder-sp-004, 2, 0);
                    }
                }
                lambda {
                    hub-conversations-ok();
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
    }
    state vault-note {
        block start {
            track vox {
                lambda {
                    wait(3.00);
                }
                lambda {
                    set-boolean(vox-tried-vault?, 1, self);
                }
                lambda {
                    while (!get-boolean(vox-read-note?, self)) {
                        wait(0.10);
                    }
                }
                lambda {
                    go(put-down-note, 1);
                }
            }
        }
        block event exiting-investigate {
            track main {
                lambda {
                    set-boolean(vox-read-note?, 1, self);
                }
            }
        }
    }
    state put-down-note {
        block start {
            track main {
                lambda {
                    wait(0.30);
                }
                lambda {
                    if (!get-boolean(vox-dina-finds-cash?, ss-sea-horse-bank-cash-1)) {
                        set-boolean(vox-ellie-finds-note?, 1, self);
                        wait-say(player, vox-igc-ell-gam-sea-hub-explore-bank-vault-sp-006, 2, 0);
                        wait(0.30);
                        wait-say(dina, vox-igc-din-gam-sea-hub-explore-bank-vault-sp-006, 2, 0);
                        set-boolean(vox-ellie-finds-note?, 0, self);
                    }
                }
                lambda {
                    if (get-boolean(vox-took-shotgun?, self)) {
                        go(wait-until-done-with-infected-2, 1);
                    } else {
                        go(wait-for-event, 1);
                    }
                }
            }
        }
        block event pulled-shotgun {
            track main {
                lambda {
                    go(take-shotgun, 1);
                }
            }
        }
    }
}
