                        wait-one-frame();
                    }
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    interactable-disable(exa-sea-hub-hotel-dead-lobby-2);
                }
            }
        }
        block event npc-died {
            track main {
                lambda {
                    if (darray-contains?(sea-horse-hotel-infected, new-boxed-value(7, event-arg-symbol(0)))) {
                        set-int32-bit(hotel-kills, darray-find(sea-horse-hotel-infected, new-boxed-value(7, event-arg-symbol(0)), 0), 1, self);
                    }
                }
                lambda {
                    if (darray-contains?(sea-horse-hotel-infected, new-boxed-value(7, event-arg-symbol(0))) && no-npcs-in-group-alive?(sea-horse-hotel-infected)) {
                        task-set-active-continue!(hotel-lobby, 0, 0, 0, 0.00, 0, 0);
                    }
                }
                lambda {
                    if (npc-group-alive-count(sea-horse-hotel-infected) == 0) {
                        decrease-trapdoor-level();
                        set-attempt-count(0);
                        go(wait-dina, 1);
                    }
                }
            }
        }
        block event too-close {
            track main {
                lambda {
                    npc-make-aware-of(npc-sea-horse-hotel-lobby-inf-1, player, 1, 0);
                }
            }
        }
        block event release-lobby {
            track main {
                lambda {
                    foreach (u64? var_1 : sea-horse-hotel-lobby-infected) {
                        u16 var_2;
                        if (var_1 && *(u16*)(var_1 + 12) == 7) {
                            var_2 = *(u64*)var_1;
                        } else if (var_1 && *(u16*)(var_1 + 12) == 5) {
                            var_2 = *(u64*)var_1;
                        } else if (var_1 && *(u16*)(var_1 + 12) == 4) {
                            var_2 = *(u64*)var_1;
                        } else {
                            var_2 = 0;
                        }
                        npc-clear-zone-if-alive(var_2);
                    }
                }
            }
        }
        block event despawn-infected {
            track main {
                lambda {
                    npc-request-explore(dina, 0, 0, *buddy-post-selector-set*, 12.00, 0, *default-ai-explore-follow-settings*, 0);
                }
                lambda {
                    go(despawn-infected, 1);
                }
            }
        }
    }
    state wait-dina {
        block start {
            track main {
                lambda {
                    while (tension-mode-is?(3)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    while (npc-get-demeanor(dina) == 2) {
                        wait-one-frame();
                    }
                }
                lambda {
                    go(dina-tense, 1);
                }
            }
        }
    }
    state dina-tense {
        block start {
            track main {
                lambda {
                    npc-set-demeanor(dina, 1, 0);
                }
                lambda {
                    set-region-enabled(rgn-accessibility-pathfind-override-513, 0, 0);
                }
                lambda {
                    set-region-enabled(rgn-accessibility-pathfind-override-51, 1, 0);
                }
                lambda {
                    enable-action-pack(tap-accessibility-jump-1248, 1);
                }
            }
        }
    }
    state despawn-infected {
        block start {
            track main {
                lambda {
                    clear-accessibility-pathfind-goal(0);
                }
                lambda {
                    foreach (u64? var_1 : sea-horse-hotel-infected) {
                        u16 var_2;
                        if (var_1 && *(u16*)(var_1 + 12) == 7) {
                            var_2 = *(u64*)var_1;
                        } else if (var_1 && *(u16*)(var_1 + 12) == 5) {
                            var_2 = *(u64*)var_1;
                        } else if (var_1 && *(u16*)(var_1 + 12) == 4) {
                            var_2 = *(u64*)var_1;
                        } else {
                            var_2 = 0;
                        }
                        set-svar-bit(sea-horse-hotel-infect-npcs, darray-find(sea-horse-hotel-infected, new-boxed-value(7, var_2), 0), get-int32-bit(hotel-kills, darray-find(sea-horse-hotel-infected, new-boxed-value(7, var_2), 0), self));
                    }
                }
                lambda {
                    auto-save-game();
                }
                lambda {
                    foreach (u64? var_1 : sea-horse-hotel-infected) {
                        u16 var_2;
                        if (var_1 && *(u16*)(var_1 + 12) == 7) {
                            var_2 = *(u64*)var_1;
                        } else if (var_1 && *(u16*)(var_1 + 12) == 5) {
                            var_2 = *(u64*)var_1;
                        } else if (var_1 && *(u16*)(var_1 + 12) == 4) {
                            var_2 = *(u64*)var_1;
                        } else {
                            var_2 = 0;
                        }
                        if (npc-alive?(var_2)) {
                            npc-kill(var_2);
                        }
                    }
                }
                lambda {
                    go(wait-spawn, 1);
                }
            }
        }
    }
}
