statescript {
    options {
        player
        sp-all
    }
    state wait-for-death {
        block event npc-died {
            track main {
                lambda {
                    if (get-self-id() == event-arg-symbol(0)) {
                        go(drop-ammo, 1);
                    }
                }
            }
        }
    }
    state drop-ammo {
        block start {
            track main {
                lambda {
                    if (npc-get-weapon(self) == pistol-basic) {
                        spawn-entity-at(pickup-ammo-pistol-1, get-object-locator(self), 0);
                    }
                }
            }
        }
    }
}
