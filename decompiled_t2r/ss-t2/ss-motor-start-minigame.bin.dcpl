                    if (!motor-minigame-at-max-pull-count?()) {
                        u64? var_3 = get-float(current-power, self);
                        while (get-int32(successful-pull-count, self) > 0 || get-float(current-power, self) < 0.18 || var_3 > 0.18 && var_3 > 0.18) {
                            wait-one-frame();
                        }
                        set-boolean(ignore-input?, 0, self);
                    }
                }
            }
            track kill-widget {
                lambda {
                    wait-boolean(exit-requested?, 1, self);
                }
                lambda {
                    if (gui2-widget-exists?(get-symbol(w-power, self))) {
                        gui2-set-widget-state(get-symbol(w-power, self), off, 0, 1, 0);
                        wait(0.50);
                    }
                }
                lambda {
                    set-boolean(game-in-progress?, 0, self);
                }
                lambda {
                    go(wait-for-events, 1);
                }
            }
            track haptics {
                lambda {
                    if (tag-boolean(rumble-during-startup, self) && get-boolean(is-bounce-after-pull-success?, self) && joypad-has-haptics?(2)) {
                        wait-frames(12);
                        sid var_4;
                        if (get-float(cumulative-power, self) < 0.30) {
                            var_4 = generator-pull-haptic-1;
                        } else {
                            var_4 = generator-pull-haptic-2;
                        }
                        play-hfx-id(var_4, alloc-haptic-location-internal(get-self-id(), 0, 0.00, 0.00, 0.00, 0), 2);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (motor-minigame-at-max-pull-count?() && get-float(current-power, self) >= 1.00) {
                        go(success, 1);
                    }
                }
                lambda {
                    if (motor-minigame-at-max-pull-count?() && get-float(velocity, self) > 0.00 && get-float(current-power, self) >= 0.44) {
                        +=f(velocity, (negf(get-float(gravity, self)) * get-float(speed-scalar, self)) * get-delta-time(), self);
                    } else {
                        +=f(velocity, (get-float(gravity, self) * get-float(speed-scalar, self)) * get-delta-time(), self);
                    }
                }
                lambda {
                    +=f(current-power, get-float(velocity, self) * get-delta-time(), self);
                }
                lambda {}

                lambda {
                    if (get-boolean(increase-cumulative-power?, self)) {
                        motor-minigame-increase-cumulative-power();
                    } else {
                        motor-minigame-degrade-cumulative-power();
                    }
                }
                lambda {
                    if (tag-boolean(rumble-during-startup, self) && get-boolean(is-bounce-after-pull-success?, self) && !joypad-has-haptics?(2)) {
                        rumble(get-float(current-power, self));
                    }
                }
                lambda {
                    if (timer-running?(error-fade-timer, self)) {
                        motor-minigame-ui-fade-out-error-color();
                    }
                }
                lambda {
                    if (timer-running?(miss-pos-fade-timer, self)) {
                        u64? var_5;
                        if (get-timer-value(miss-pos-fade-timer, self) < gui2-get-widget-alpha(get-symbol(w-miss-pos, self))) {
                            var_5 = get-timer-value(miss-pos-fade-timer, self);
                        } else {
                            var_5 = gui2-get-widget-alpha(get-symbol(w-miss-pos, self));
                        }
                        gui2-set-widget-alpha(get-symbol(w-miss-pos, self), var_5);
                    }
                }
                lambda {
                    motor-minigame-ui-update-widget();
                }
                lambda {
                    if (!get-boolean(exit-requested?, self)) {
                        if (get-boolean(in-successful-pull-range?, self)) {
                            if (!get-boolean(accessibility-sound-played, self)) {
                                play-accessibility-interact-sound-at-position(get-joint-position(player, r_hand_prop_attachment), 0, 0.00, 0);
                                set-boolean(accessibility-sound-played, 1, self);
                            }
                        } else {
                            set-boolean(accessibility-sound-played, 0, self);
                        }
                    }
                }
                lambda {
                    if (get-float(current-power, self) <= 0.00 && get-float(velocity, self) < 0.00) {
                        go(bottom-of-bounce, 1);
                    }
                }
            }
        }
        block event pull-attempt {
            track main {
                lambda {
                    if (!get-boolean(ignore-input?, self)) {
                        if (get-boolean(always-fail, self)) {
                            set-int32(successful-pull-count, 0, self);
                        } else if (get-float(current-power, self) <= 0.18) {
                            ++(successful-pull-count, self);
                            set-float(hud-spin-velocity, (f32)get-int32(successful-pull-count, self) * 0.40, self);
                            gui2-set-widget-state(gui2-build-widget-path(
                                get-symbol(w-power, self),
                                "fader",
                                "content",
                                "pulse",
                                0,
                                0,
                                0,
                                0,
                                0
                            ), pulse, 0, 0, 0);
                            if (!gui2-widget-is-animating?(get-symbol(w-pulse, self))) {
                                gui2-set-widget-state(get-symbol(w-pulse, self), pulse, 0, 0, 0);
                            }
                        } else {
                            set-int32(successful-pull-count, 0, self);
                        }
                    }
                }
                lambda {
                    u16 var_1;
                    if (get-boolean(ignore-input?, self)) {
                        var_1 = -1;
                    } else if (motor-minigame-at-max-pull-count?()) {
                        var_1 = 2;
                    } else if (get-int32(successful-pull-count, self) > 0) {
                        var_1 = 1;
                    } else {
                        var_1 = 0;
                    }
                    broadcast-event(pull-attempt-result, new-boxed-value(2, var_1));
                }
                lambda {
                    if (!get-boolean(ignore-input?, self)) {
                        if (get-int32(successful-pull-count, self) > 0) {
                            go(pull-success, 1);
                        } else {
                            go(fail-and-reset, 1);
                        }
                    }
                }
            }
        }
        block event error-fade-timer {
            track main {
                lambda {
                    set-vector(widget-color, alloc-vector(1.00, 1.00, 1.00, 1.00, 0), self);
                }
            }
        }
        block event motor-minigame-play-running-idle {
            track main {
                lambda {
                    set-boolean(play-running-idle-requested?, 1, self);
                }
            }
        }
    }
    state bottom-of-bounce {
        block start {
            track main {
                lambda {
                    if (!get-boolean(increase-cumulative-power?, self)) {
                        set-boolean(is-bounce-after-pull-success?, 0, self);
                    }
                }
                lambda {
                    if (get-boolean(decrement-pull-count?, self)) {
                        set-boolean(decrement-pull-count?, 0, self);
                        if (get-int32(successful-pull-count, self) > 0) {
                            --(successful-pull-count, self);
                        }
                    }
                }
                lambda {
                    set-float(current-power, 0.00, self);
                }
                lambda {
                    set-float(velocity, motor-minigame-get-new-velocity(1.00), self);
                }
                lambda {
                    set-float(top-point, pow-float(get-float(velocity, self), 2.00) / (2.00 * get-float(gravity, self)), self);
                }
                lambda {
                    go(bounce, 1);
                }
            }
        }
    }
    state pull-success {
        block start {
            track main {
                lambda {
                    if (!(get-float(velocity, self) < 0.00)) {
                        set-float(velocity, motor-minigame-get-new-velocity(lerp-scale(0.00, 0.18, 1.00, 1.00 - 0.18, get-float(current-power, self))), self);
                    }
                }
                lambda {
                    send-event(
                        success,
                        get-symbol(w-power, self),
                        new-boxed-value(2, get-int32(successful-pull-count, self)),
                        new-boxed-value(2, darray-count(get-symbol(pull-impulse-darray, self)) - 1)
                    );
                }
                lambda {
                    set-boolean(decrement-pull-count?, 0, self);
                }
                lambda {
                    set-boolean(increase-cumulative-power?, 1, self);
                }
                lambda {
                    set-boolean(is-bounce-after-pull-success?, 1, self);
                }
                lambda {
                    set-boolean(ignore-input?, 1, self);
                }
                lambda {
                    go(bounce, 1);
                }
            }
        }
    }
    state fail-and-reset {
        block start {
            track main {
                lambda {
                    motor-minigame-reset-vars();
                }
                lambda {
                    set-vector(widget-color, color-to-vector(lookup-hud-color(t2-red)), self);
                }
                lambda {
                    motor-minigame-ui-update-widget();
                }
                lambda {
                    gui2-set-progress-bar-percent-at-speed(get-symbol(w-progress, self), 0.00, 1.00, 1, 0.00);
                }
                lambda {
                    send-event(failed, get-symbol(w-power, self));
                }
                lambda {
                    gui2-set-widget-state(get-symbol(w-circle, self), press, 0, 0, 0);
                }
                lambda {
                    gui2-set-widget-state(get-symbol(w-prompt, self), off, 0, 0, 0);
                }
                lambda {
                    wait(1.20);
                }
                lambda {
                    start-timer(error-fade-timer, get-float(error-fade-time, self), self, 1);
                }
                lambda {
                    go(bounce, 1);
                }
            }
            track miss-pos-hud {
                lambda {
                    if (gui2-get-widget-alpha(get-symbol(w-miss-pos, self)) > 0.00) {
                        gui2-seek-widget-property(get-symbol(w-miss-pos, self), fcolor.a, 0.00, 0.20);
                        wait(0.20);
                    }
                }
                lambda {
                    gui2-seek-widget-property(get-symbol(w-miss-pos, self), fcolor.a, 1.00, 0.00);
                }
                lambda {
                    gui2-set-widget-rotation(get-symbol(w-miss-pos, self), gui2-get-widget-rotation(get-symbol(w-spinner, self)));
                }
                lambda {
                    start-timer(miss-pos-fade-timer, get-float(miss-pos-fade-time, self), self, 1);
                }
            }
        }
    }
    state success {
        block start {
            track hud {
                lambda {
                    while (1) {
                        motor-minigame-ui-update-widget();
                        wait-one-frame();
                    }
                }
            }
            track rumble {
                lambda {
                    if (!joypad-has-haptics?(2)) {
                        rumble-curve(get-float(cumulative-power, self), 0.00, 1.50, 4, 0);
                    }
                }
            }
            track haptics {
                lambda {
                    if (joypad-has-haptics?(2)) {
                        wait-frames(12);
                        play-hfx-id(generator-pull-haptic-3, alloc-haptic-location-internal(get-self-id(), 0, 0.00, 0.00, 0.00, 0), 2);
                    }
                }
            }
            track listen-mode-higlight-on {
                lambda {
                    if (tag-boolean(show-in-listen-mode, self)) {
                        listen-mode-add-reveal(
                            motor-minigame-get-target-object(),
                            motor-minigame-get-target-object(),
                            get-object-locator(motor-minigame-get-target-object()),
                            25.00,
                            3600.00,
                            0.00,
                            0.80,
                            0,
                            0,
                            0,
                            0
                        );
                    }
                }
                lambda {
                    signal(listen-mode-done, 0);
                }
            }
            track logic {
                lambda {
                    broadcast-event(motor-minigame-success, new-boxed-value(7, motor-minigame-get-target-object()));
                }
                lambda {
                    set-boolean(power-on?, 1, self);
                }
                lambda {
                    wait-for(listen-mode-done);
                }
            }
        }
        block event hud-anim-complete {
            track main {
                lambda {
                    set-symbol(w-power, 0, self);
                }
                lambda {
                    if (get-boolean(play-running-idle-requested?, self)) {
                        go(generator-running, 1);
                    } else {
                        set-boolean(game-in-progress?, 0, self);
                        go(wait-for-events, 1);
                    }
                }
            }
        }
        block event motor-minigame-play-running-idle {
            track main {
                lambda {
                    set-boolean(play-running-idle-requested?, 1, self);
                }
            }
        }
    }
}
