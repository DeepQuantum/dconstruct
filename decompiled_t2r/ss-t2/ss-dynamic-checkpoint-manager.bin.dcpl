        block event checkpoint-committed {
            track main {
                lambda {
                    if (in-active-checkpoint-task?()) {
                        set-int32(debug-status, 2, self);
                        set-float(last-checkpoint-time, get-float(temp-checkpoint-time, self), self);
                        set-bound-frame(last-checkpoint-pos, get-bound-frame(temp-checkpoint-pos, self), self);
                        -=i(kills-since-checkpoint, get-int32(temp-kills-to-subtract, self), self);
                        set-boolean(upgrade-since-checkpoint, 0, self);
                        set-boolean(last-checkpoint-in-grass, get-boolean(temp-checkpoint-in-grass, self), self);
                        set-boolean(temp-checkpoint-in-grass, 0, self);
                        stop-timer(new-wave-timer, self);
                        stop-timer(pursue-end-timer, self);
                        start-timer(debug-draw-timer, 2.00, self, 1);
                    }
                }
            }
        }
        block event checkpoint-lambda-failed {
            track main {
                lambda {
                    if (!get-boolean(temp-checkpoint-in-grass, self) && is-position-future-exposed?(get-locator-position(get-bound-frame(temp-checkpoint-pos, self)))) {
                        var_4 = log-event("dynamic-checkpoint-failed-exposure", 1, "", 0, 0);
