            }
        }
        block event debug-draw-timer {
            track main {
                lambda {
                    if (!is-waiting-for-checkpoint-commit?()) {
                        set-int32(debug-status, 0, self);
                    }
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(get-symbol(active-task, self), get-symbol(active-subtask, self))) {
                        set-boolean(enabled, 1, self);
                        set-symbol(active-task, 0, self);
                        set-symbol(active-subtask, 0, self);
                        set-symbol(active-continue, 0, self);
                        set-symbol(active-region, 0, self);
