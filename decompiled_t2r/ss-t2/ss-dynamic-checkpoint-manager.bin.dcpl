                        if (!get-boolean(last-checkpoint-in-grass, self) && !get-boolean(last-enemy-killed, self) && current-task-elapsed-time() > *(f32*)(get-difficulty-detail-player() + 104) || tension-mode-is?(2) && tension-mode-is?(4)) {
                            var_8 = send-event(record-active-continue, self);
                        }
                    }
                }
            }
        }
        block event record-active-continue {
            track main {
                lambda {
                    if (npc-group-alive-count(all-enemy-npcs) > 0) {
                        set-boolean(last-enemy-killed, 0, self);
