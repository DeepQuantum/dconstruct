                        set-int32(debug-status, 1, self);
                        if (get-boolean(last-enemy-killed, self)) {
                            log-event("dynamic-checkpoint-requested-normal", 1, string-debug(get-symbol(active-continue, self)), 0, 0);
                            set-int32(debug-type, 3, self);
                        } else if (tension-mode-is?(2) && tension-mode-is?(1)) {
                            log-event("dynamic-checkpoint-requested-stealth", 1, string-debug(get-symbol(active-continue, self)), 0, 0);
                            set-int32(debug-type, 0, self);
                        } else if (tension-mode-is?(4)) {
                            log-event("dynamic-checkpoint-requested-search", 1, string-debug(get-symbol(active-continue, self)), 0, 0);
                            set-int32(debug-type, 2, self);
                        } else if (tension-mode-is?(3)) {
                            log-event("dynamic-checkpoint-requested-combat", 1, string-debug(get-symbol(active-continue, self)), 0, 0);
                            set-int32(debug-type, 1, self);
                        }
                        start-timer(checkpoint-timer, 6.00, self, 1);
                        start-timer(debug-draw-timer, 3.00, self, 1);
