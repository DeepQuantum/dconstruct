                    set-boolean(bfl-initial-vox-complete, 1, self);
                }
            }
        }
    }
    state cleanup {
        block start {
            track main {
                lambda {
                    set-float(time-player-has-not-been-aiming-at-defender, 0.00, self);
                }
                lambda {
                    set-float(time-player-has-been-aiming-at-defender, 0.00, self);
                }
                lambda {
                    set-float(time-player-has-been-aiming, 0.00, self);
                }
                lambda {
                    set-float(time-player-has-not-been-manual-aiming, 0.00, self);
                }
                lambda {
                    set-float(time-player-has-been-disengaging, 0.00, self);
                }
                lambda {
                    set-float(time-player-has-been-close, 0.00, self);
                }
                lambda {
                    set-float(time-player-has-last-attempted-firing, 999.00, self);
                }
                lambda {
                    set-float(time-player-has-been-in-BfL, 0.00, self);
                }
                lambda {
                    set-float(stick-lerp-time, 0.00, self);
                }
                lambda {
                    set-float(stick-lerp-time, 1.00, self);
                }
                lambda {
                    set-boolean(initial-auto-aim, 1, self);
                }
                lambda {
                    set-boolean(holstered-weapon-attempt, 0, self);
                }
                lambda {
                    set-boolean(player-released, 0, self);
                }
                lambda {
                    set-boolean(from-melee?, 0, self);
                }
                lambda {
                    set-boolean(death-prep, 0, self);
                }
                lambda {
                    set-boolean(initial-aim, 0, self);
                }
                lambda {
                    set-boolean(queued-melee-finisher, 0, self);
                }
                lambda {
                    set-boolean(bfl-initial-vox-complete, 0, self);
                }
                lambda {
                    set-boolean(valid-to-shoot-n-melee, 0, self);
                }
                lambda {
                    set-boolean(aim-interrupt-vox-valid, 0, self);
                }
                lambda {
                    fact-remove(get-symbol(defender, self), ignore-poise);
                }
                lambda {
                    go(listen-for-instance, 1);
                }
            }
        }
    }
}
