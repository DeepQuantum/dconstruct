                    wait-until-anim-frame(npc-nor-basement-1, nor-nora-cornered-outro--female-a, 550.00, 2);
                }
                lambda {
                    stop-speaking(npc-nor-basement-1);
                }
                lambda {
                    say(npc-nor-basement-1, vox-igc-mltmc-igc-nor-nora-cornered-outro-2-001, 2, 0);
                }
            }
            track snd-design {
                lambda {
                    wait-until-anim-frame(player, nor-nora-cornered-outro--ellie, 43.00, 2);
                }
                lambda {
                    play-sound-at-position(sfx-igc-nor-fall-to-basement-rock-debris, get-spawner-position(snd-pos-basement-rock-debris-1, 1), 0, 0);
                }
            }
            track npcs {
                lambda {
                    foreach (u64? var_1 : intro-militia-npcs) {
                        u16 var_2;
                        if (var_1 && *(u16*)(var_1 + 12) == 7) {
                            var_2 = *(u64*)var_1;
                        } else if (var_1 && *(u16*)(var_1 + 12) == 5) {
                            var_2 = *(u64*)var_1;
                        } else if (var_1 && *(u16*)(var_1 + 12) == 4) {
                            var_2 = *(u64*)var_1;
                        } else {
                            var_2 = 0;
                        }
                        if (npc-alive?(var_2)) {
                            set-visible(var_2, 1);
                        }
                    }
                }
            }
            track prog {
                lambda {
                    while (signal-raised?(feather-done, 0) && !signal-raised?(nora-done, 0)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    go(task-complete, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (get-animation-playing?(player, nor-nora-cornered-outro--ellie, 2) && get-animation-frame(player, 2, nor-nora-cornered-outro--ellie) < 456.00) {
                        override-render-settings(
                            *nor-rs-453-nor-basement-igc-start*,
                            0.00,
                            0.00,
                            0,
                            32767,
                            0,
                            1,
                            0,
                            1.00
                        );
                    }
                }
                lambda {
                    player-silent-flashlight/f();
                }
            }
        }
    }
    state task-complete {
        block start {
            track main {
                lambda {
                    task-complete!(find-nora, nor-spore-basement-intro);
                }
                lambda {
                    set-visible(npc-nor-nora-1, 0);
                }
                lambda {
                    animate-start(npc-nor-nora-1, torture-nora-loop--nora, ap-nor-spore-basement-torture-door-1, 0);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
