                        u64? var_4 = #%alloc-array(single-frame, 16, 4, 1);
                        *(i32*)*(*var_4 + (0 * 8)) = 10;
                        *(u64*)(*(*var_4 + (0 * 8)) + 8) = 0;
                        *(u64*)(*(*var_4 + (0 * 8)) + 8) = get-bound-frame(ellie-ending-ap, self);
                        *(i32*)*(*var_4 + (1 * 8)) = 14;
                        *(u64*)(*(*var_4 + (1 * 8)) + 8) = 0;
                        *(u64*)(*(*var_4 + (1 * 8)) + 8) = apReference-low;
                        *(i32*)*(*var_4 + (2 * 8)) = 24;
                        *(u64*)(*(*var_4 + (2 * 8)) + 8) = 0;
                        *(i32*)(*(*var_4 + (2 * 8)) + 8) = 19;
                        *(i32*)*(*var_4 + (3 * 8)) = 30;
                        *(u64*)(*(*var_4 + (3 * 8)) + 8) = 0;
                        *(f32*)(*(*var_4 + (3 * 8)) + 8) = 0.95;
                        wait-animate_(player, arrow-hit-success-left--ellie, var_4);
                    }
                }
                lambda {
                    set-svar-as-boolean(nor-scar-intro-arrow-pulled-out, 1);
                }
                lambda {
                    send-event(player-done, ss-nor-scar-intro-igc-arrow-hit-npcs-1);
                }
                lambda {
                    send-event(vox-arrow-pull-out, ss-vox-nor-scar-intro-1);
                }
                lambda {
                    while (player-in-state?(Move) || player-in-state?(GunMove) && !0) {
                        wait-one-frame();
                    }
                }
                lambda {
                    if (get-boolean(ambush-left, ss-nor-scar-intro-igc-arrow-hit-npcs-1)) {
                        task-set-active-continue!(ambush-left, 1, 1, 0, 0.00, 0, 0);
                    } else if (get-boolean(ambush-right, ss-nor-scar-intro-igc-arrow-hit-npcs-1)) {
                        task-set-active-continue!(ambush-right, 1, 1, 0, 0.00, 0, 0);
                    } else if (get-boolean(ambush-middle-left-side, self)) {
                        task-set-active-continue!(ambush-middle, 1, 1, 0, 0.00, 0, 0);
                    } else {
                        task-set-active-continue!(ambush-middle-right-side, 1, 1, 0, 0.00, 0, 0);
                    }
                }
                lambda {
                    set-invisible-to-npcs(player, 0);
                }
                lambda {
                    detach(obj-nor-scar-intro-arrow-1);
                }
                lambda {
                    disable-collision(obj-nor-scar-intro-arrow-1, 0);
                }
                lambda {
                    stop-animating(obj-nor-scar-intro-arrow-1, 2, 0.00, 0, 0);
                }
                lambda {
                    disable-camera-look-at();
                }
                lambda {
                    go(done, 1);
                }
            }
            track vox {
                lambda {
                    wait-for(anim-start);
                }
                lambda {
                    say(player, vox-igc-ell-igc-nor-scar-arrow-hit-success-001, 2, 0);
                }
            }
            track hack {
                lambda {
                    if (get-boolean(player-in-right-region, self) && get-boolean(player-in-mid-right-region, self)) {
                        wait(3.50);
                    } else {
                        wait(1.50);
                    }
                }
                lambda {
                    send-event(arrow-pulled-out, ss-nor-scar-intro-igc-arrow-hit-npcs-1);
                }
                lambda {
                    camera-fade-out-animated(5.50, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    override-render-settings(
                        *zgame-player-blood-healing-disable*,
                        0.00,
                        -1.00,
                        0,
                        32767,
                        0,
                        1,
                        0,
                        1.00
                    );
                }
                lambda {
                    if (get-animation-frame(player, 2, arrow-hit-success--ellie) < 130.00 && get-animation-frame(player, 2, arrow-hit-success-left--ellie) < 130.00) {
                        joypad-disable-commands(camera);
                        camera-look-at-object(get-symbol(ic-camera-look-at, self), 0, get-float(camera-look-at-speed, self), 1.00);
                    }
                }
                lambda {
                    set-single-shader-instance-param(obj-nor-scar-intro-arrow-1, blendOffset1, 1.00);
                }
            }
        }
    }
    state die {
        block start {
            track main {
                lambda {
                    animate_(player, ellie-death-arrow-bleed-out-crouch-r-shldr, #%alloc-array(single-frame, 16, 0, 1));
                }
                lambda {
                    promote-post-death-tip(TIP_ARROW_PULL_OUT, 1);
                }
                lambda {
                    kill-player-no-anim(0, 0, 0.06);
                }
            }
        }
        block update {
            track main {
                lambda {
                    promote-post-death-tip(TIP_ARROW_PULL_OUT, 1);
                }
            }
        }
    }
}
