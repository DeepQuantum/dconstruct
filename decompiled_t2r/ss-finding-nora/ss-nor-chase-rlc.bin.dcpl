u64? set-player-chase-moveset() {
    if (is-auto-traversal-accessibility?() && !player-in-state?(ScriptMove)) {
        set-sprint-type(sprint-tense);
        set-run-type(sprint-tense);
        set-walk-type(sprint-tense);
    } else {
        set-walk-type(run-tense);
        set-run-type(run-tense);
        set-sprint-type(sprint-tense);
    }
    player-set-sprint-settings-combat(*player-chase-sprint-settings*);
    player-set-sprint-settings-relaxed(*player-chase-sprint-settings*);
    joypad-disable-commands(inventory-open, inventory-craft);
    return player-disable-full-body-hit-reactions(1);
}

