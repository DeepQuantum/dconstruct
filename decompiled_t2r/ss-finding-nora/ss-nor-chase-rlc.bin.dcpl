                            var_2 = 0;
                        }
                        if (npc-alive?(var_2)) {
                            npc-make-aware-of(var_2, player, 0, 0);
                        }
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    set-player-chase-moveset();
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(find-nora, nor-noras-chase-final-hallway)) {
                        go(complete, 1);
                    }
                }
            }
        }
        block event enter {
            track main {
                lambda {
                    if (!get-boolean(vox-vaulted-through?, self)) {
                        set-boolean(vox-vaulted-through?, 1, self);
                        while (!player-in-state?(Move)) {
                            wait(0.10);
                        }
                        wait(0.50);
                        wait-say(player, vox-igc-ell-gam-nor-noras-chase-rooftop-run-pr-003, 2, 0);
                    }
                }
            }
        }
    }
}
