                    if (is-encounter-select?()) {
                        wait(1.50);
                        select-mode-mark-complete(0.00);
                    }
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
    }
    state post-igc {
        block start {
            track main {
                lambda {
                    u16 var_1;
                    if (is-combat-or-search?()) {
                        var_1 = 1;
                    }
                    wait(0.50);
                    while (!!(is-speaking?(player))) {
                        wait(0.10);
                    }
                    if (var_1) {
                        wait-say(player, vox-igc-ell-gam-nor-scar-forest-combat-brute-combat-done-slf-004, 2, 0);
                        wait(1.60);
                    }
                    wait(0.80);
                    wait-say(player, vox-igc-ell-gam-nor-scar-forest-combat-brute-combat-done-slf-006, 2, 0);
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
    }
}
