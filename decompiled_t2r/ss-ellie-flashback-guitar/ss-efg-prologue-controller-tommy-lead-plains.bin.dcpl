u64? should-tommy-swap-splines-in-plains?() {
    return distance-between-points(get-object-position(player-horse), get-locator-position(spline-locator-closest-to-locator(get-symbol(tommy-spline, self), get-object-locator(player-horse), 0))) < get-float(spline-detect-dist, self) && distance-between-objects-less-than?(player-horse, npc-efg-tommy-horse-1, get-float(min-dist-from-tommy, self)) || get-symbol(tommy-spline, self) == spl-efg-prologue-tommy-horse-lead-plains-3 && is-player-further-ahead-on-the-spline-than-tommy?(get-symbol(tommy-spline, self), get-float(min-distance-ahead, self), 0);
}

u64? is-tommy-in-danger-bump-zone?() {
    return distance-between-points(get-object-position(player-horse), get-locator-position(spline-locator-closest-to-locator(get-symbol(tommy-spline, self), get-object-locator(player-horse), 0))) < get-float(spline-detect-dist, self) && distance-between-objects-less-than?(player-horse, npc-efg-tommy-horse-1, get-float(force-dist-from-tommy, self)) && is-tommy-further-ahead-on-the-spline-than-player?(get-symbol(tommy-spline, self), 0.00, 0);
}

