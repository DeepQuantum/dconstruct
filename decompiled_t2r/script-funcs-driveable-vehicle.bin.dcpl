u64? vehicle-set-rider(u64? arg_0, u64? arg_1, u16 arg_2, u64? arg_3) {
    return send-event(
        enter-vehicle,
        arg_1,
        new-boxed-value(7, arg_0),
        new-boxed-value(2, 2),
        new-boxed-value(2, arg_2),
        new-boxed-value(13, 0),
        new-boxed-value(1, 0),
        new-boxed-value(7, arg_3)
    );
}

