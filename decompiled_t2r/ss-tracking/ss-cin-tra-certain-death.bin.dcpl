                    task-complete!(tracking-horde, tra-certain-death);
                }
                lambda {
                    broadcast-event(gameplay-fence-idle);
                }
                lambda {
                    animate-done(snpc-certain-death-male-1, male=cin-tra-certain-death=010-chunk-last, cin-tra-certain-death-1, 0, 0, 2);
                }
                lambda {
                    npc-die(snpc-certain-death-male-1, 1, 0, 0, 1);
                }
                lambda {
                    set-high-contrast-mode-type(snpc-certain-death-male-1, 1);
                }
                lambda {
                    spawn-entity(obj-tra-horde-fence-blocker-1, 0, 0);
                }
                lambda {
                    spawn-entity(obj-tra-horde-fence-blocker-4, 0, 0);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(tracking-horde, tra-horde-joel-tommy-rescue)) {
                        go(clean-up, 1);
                    }
                }
            }
        }
    }
    state already-done {
        block start {
            track main {
                lambda {
                    spawn-entity(snpc-certain-death-male-1, 0, 0);
                }
                lambda {
                    animate-done(snpc-certain-death-male-1, male=cin-tra-certain-death=010-chunk-last, cin-tra-certain-death-1, 0, 0, 2);
                }
                lambda {
                    npc-die(snpc-certain-death-male-1, 1, 0, 0, 1);
                }
                lambda {
                    set-high-contrast-mode-type(snpc-certain-death-male-1, 1);
                }
                lambda {
                    spawn-entity(obj-tra-horde-fence-blocker-1, 0, 0);
                }
                lambda {
                    spawn-entity(obj-tra-horde-fence-blocker-4, 0, 0);
                }
                lambda {
                    spawn-entity(fx-tra-cin-blood-1, 0, 0);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(tracking-horde, tra-horde-joel-tommy-rescue)) {
                        go(clean-up, 1);
                    }
                }
            }
        }
    }
    state clean-up {
        block start {
            track main {
                lambda {
                    kill-entity-if-spawned(snpc-certain-death-male-1);
                }
                lambda {
                    kill-entity-if-spawned(snpc-certain-death-inf-female-1);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
