    }
    state clean-up {
        block start {
            track main {
                lambda {
                    animate-done(obj-tra-horde-joel-tommy-escape-door-l-1, tra-horde-tommy-close-door-exit--dbl-door, ap-tra-horde-tommy-close-1, 0, 0, 2);
                }
                lambda {
                    animate-done(obj-tra-horde-tommy-close-door-1, tra-horde-tommy-close-door-exit--locker, ap-tra-horde-tommy-close-1, 0, 0, 2);
                }
                lambda {
                    enable-nav-blocker-object(nav-blocker-rect-1011);
                }
                lambda {
                    disable-nav-blocker-object(nav-blocker-rect-infected-1011);
                }
                lambda {
                    disable-nav-blocker-object(nav-blocker-rect-1247);
                }
                lambda {
                    interactable-disable(obj-tra-horde-joel-tommy-escape-door-l-1);
                }
                lambda {
                    door-disable-systemic-high-contrast-mode-update(obj-tra-horde-joel-tommy-escape-door-l-1, 1);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
