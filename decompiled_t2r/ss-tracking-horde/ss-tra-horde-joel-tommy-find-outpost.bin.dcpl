                    *(u64*)(*(*var_0 + (4 * 8)) + 8) = 0;
                    *(i32*)(*(*var_0 + (4 * 8)) + 8) = 2;
                    wait-animate_(joel, tra-escape-plan-argument-intro--joel, var_0);
                }
                lambda {
                    npc-set-zone-region(joel, rgn-tra-horde-find-outpost-da-joel-zone-1);
                }
                lambda {
                    npc-set-combat-params(joel, *tracking-horde-tommy-gondola-combat-params*);
                }
            }
            track infected {
                lambda {
                    if (get-animation-playing?(snpc-tra-horde-joel-run-and-gun-1, tra-horde-run-and-gun--female-horde, 2)) {
                        while (!(get-animation-phase(snpc-tra-horde-joel-run-and-gun-1, 2, 0) > 0.95)) {
                            wait-one-frame();
                        }
                        animate-done(snpc-tra-horde-joel-run-and-gun-1, tra-horde-run-and-gun--female-horde, ap-tra-horde-run-and-gun-1, 0, 0, 2);
                    }
                }
            }
            track vox {
                lambda {
                    while (1) {
                        npc-buddy-disable-informational-callouts/f(joel);
                        npc-buddy-disable-informational-callouts/f(tommy);
                        wait-one-frame();
                    }
                }
            }
        }
        block event in-outpost {
            track main {
                lambda {
                    npc-clear-zone(joel);
                }
                lambda {
                    go(inside-outpost, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (player-in-region?(rgn-tra-horde-find-outpost-transition-2, 2)) {
                        player-force-stand();
                        joypad-disable-commands(jump, crouch, prone);
                    }
                }
            }
        }
    }
    state inside-outpost {
        block start {
            track main {
                lambda {
                    task-complete!(tracking-horde, tra-horde-joel-tommy-find-outpost);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
