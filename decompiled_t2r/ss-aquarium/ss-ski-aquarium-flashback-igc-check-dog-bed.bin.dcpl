                }
                lambda {
                    wait-for(anim-done);
                }
                lambda {
                    signal(toy-detached, 0);
                }
            }
        }
    }
    state done {
        block start {
            track main {
                lambda {
                    set-boolean(igc-playing?, 0, self);
                }
                lambda {
                    set-boolean(igc-done?, 1, self);
                }
            }
        }
    }
}
