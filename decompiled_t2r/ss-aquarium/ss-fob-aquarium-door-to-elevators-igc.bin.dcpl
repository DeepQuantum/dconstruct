                }
                lambda {
                    kill-entity(obj-fob-aquarium-keys-1);
                }
                lambda {
                    signal(owen-final-anims-done, 0);
                }
            }
            track abby-start-vox {
                lambda {
                    wait-for(abby-start-vox);
                }
                lambda {
                    wait-say(player, vox-igc-abb-igc-fob-aquarium-atrium-door-start-001, 2, 0);
                }
            }
            track abby-and-owen-vox {
                lambda {
                    wait-for(start-igc);
                }
                lambda {
                    stop-speaking(player);
                }
                lambda {
                    say(player, vox-igc-abb-igc-fob-aquarium-atrium-door-with-abby-001, 2, 0);
                }
                lambda {
                    say(owen, vox-igc-own-igc-fob-aquarium-atrium-door-with-abby-001, 2, 0);
                }
            }
            track music {
                lambda {
                    play-music-stinger(*music-playlist-fob-aquarium-flashback-door-to-elevator-igc*, 0);
                }
            }
        }
    }
}
