                            debug-draw-string(get-locator-position(get-bound-frame(aim-loc, self)), "Aiming/Painting", 3, 0.00, 0, 1.00, 0, 0);
                            debug-draw-locator(get-bound-frame(target-loc, self), 0.30, 0.00, 0, 2.00, 0);
                            debug-draw-string(get-locator-position(get-bound-frame(target-loc, self)), "Spline Tracking", 9, 0.00, 0, 1.00, 0, 0);
                        }
                        set-float(spline-progress, spline-percentage-locator(get-symbol(paint-spline, self), get-bound-frame(aim-loc, self), 1), self);
                        wait-one-frame();
                    }
                }
            }
        }
    }
    state evaluate-skill {
        block start {
            track main {
                lambda {
                    wait-stop-animating(player, 2, 0.80, 0);
                }
                lambda {
                    camera-fade-out-animated(3.00, 0);
                }
                lambda {
                    if (get-int32(completed-segments-count, self) < floor((f32)get-int32(total-segments, self) * 0.50)) {
                        wait(1.00);
                        script-caption(player, "Doesn't look quite done...", 5.00, 0, 0);
                        go(wait-for-interact, 1);
                    } else {
                        u64? var_3 = get-float(cumulative-error, self);
                        i32 var_4 = get-int32(total-paint-frames, self);
                        print-string("Final Error:", self);
                        print-float(var_3 / (f32)var_4, self);
                        wait(1.00);
                        if ((var_3 / (f32)var_4) < 0.20) {
                            var_5 = script-caption(player, "Hey, that's pretty good!", 5.00, 0, 0);
                        } else if ((var_3 / (f32)var_4) < 0.30) {
                            var_5 = script-caption(player, "Good enough.", 5.00, 0, 0);
                        } else {
                            var_5 = script-caption(player, "Well, it's not TERRIBLE...", 5.00, 0, 0);
                        }
                        go(finish-painting, 1);
                    }
                }
            }
        }
    }
    state finish-painting {
        block start {
            track anim {
                lambda {
                    camera-enable-animated(3.50, -1.00, 1, 1000, 0, 0, 0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 5, 1);
                    *(i32*)*(*var_0 + (0 * 8)) = 10;
                    *(u64*)(*(*var_0 + (0 * 8)) + 8) = 0;
                    *(u64*)(*(*var_0 + (0 * 8)) + 8) = get-spawner-locator(get-symbol(active-ap, self), 1);
                    *(i32*)*(*var_0 + (1 * 8)) = 28;
                    *(u64*)(*(*var_0 + (1 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (1 * 8)) + 8) = 1.00;
                    *(i32*)*(*var_0 + (2 * 8)) = 30;
                    *(u64*)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (2 * 8)) + 8) = 1.00;
                    *(i32*)*(*var_0 + (3 * 8)) = 27;
                    *(u64*)(*(*var_0 + (3 * 8)) + 8) = 0;
                    *(u8*)(*(*var_0 + (3 * 8)) + 8) = 2;
                    *(i32*)*(*var_0 + (4 * 8)) = 29;
                    *(u64*)(*(*var_0 + (4 * 8)) + 8) = 0;
                    *(u8*)(*(*var_0 + (4 * 8)) + 8) = 4;
                    animate_(owen, ski-aquarium-flashback-abby-paint-exit--owen, var_0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 5, 1);
                    *(i32*)*(*var_0 + (0 * 8)) = 10;
                    *(u64*)(*(*var_0 + (0 * 8)) + 8) = 0;
                    *(u64*)(*(*var_0 + (0 * 8)) + 8) = get-spawner-locator(get-symbol(active-ap, self), 1);
                    *(i32*)*(*var_0 + (1 * 8)) = 28;
                    *(u64*)(*(*var_0 + (1 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (1 * 8)) + 8) = 1.00;
                    *(i32*)*(*var_0 + (2 * 8)) = 30;
                    *(u64*)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (2 * 8)) + 8) = 1.00;
                    *(i32*)*(*var_0 + (3 * 8)) = 27;
                    *(u64*)(*(*var_0 + (3 * 8)) + 8) = 0;
                    *(u8*)(*(*var_0 + (3 * 8)) + 8) = 2;
                    *(i32*)*(*var_0 + (4 * 8)) = 29;
                    *(u64*)(*(*var_0 + (4 * 8)) + 8) = 0;
                    *(u8*)(*(*var_0 + (4 * 8)) + 8) = 4;
                    wait-animate_(player, ski-aquarium-flashback-abby-paint-exit--abby, var_0);
                }
                lambda {
                    camera-fade-out-animated(2.00, 0);
                }
                lambda {
                    go(task-complete, 1);
                }
            }
            track drop-brush {
                lambda {
                    wait-until-anim-phase(player, ski-aquarium-flashback-abby-paint-exit--abby, 0.15, 2);
                }
                lambda {
                    detach(obj-ski-aquarium-flashback-paintbrush-1);
                }
            }
        }
    }
    state task-complete {
        block start {
            track main {
                lambda {
                    task-complete-if-active!(saving-kids, ski-aquarium-flashback-paint);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
