    }
    state owen-attacks {
        block start {
            track main {
                lambda {
                    set-boolean(has-attacked?, 1, npc-faq-owen-enemy-1);
                }
                lambda {
                    foreach (u64? var_2 : faq-confront-nav-blockers) {
                        enable-nav-blocker-object(var_2);
                    }
                }
                lambda {
                    stop-animating(npc-faq-owen-enemy-1, 2, 0.50, 0, 0);
                }
                lambda {
                    character-set-invincibility(npc-faq-owen-enemy-1, 0, 0);
                }
                lambda {
                    npc-set-zone-region(npc-faq-owen-enemy-1, rgn-faq-confrontation-owen-zone-1);
                }
                lambda {
                    npc-lock-to-zone(npc-faq-owen-enemy-1);
                }
                lambda {
                    npc-set-demeanor(npc-faq-owen-enemy-1, 2, 0);
                }
                lambda {
                    npc-make-aware-of-at(npc-faq-owen-enemy-1, player, get-object-position(player), 2, 0, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    faq-set-ellie-confront-mode();
                }
            }
        }
        block event npc-attacked {
            track main {
                lambda {
                    go(player-kills-mel, 1);
                }
            }
        }
        block event npc-died {
            track main {
                lambda {
                    go(player-kills-owen, 1);
                }
            }
        }
        block event death-anim-done? {
            track main {
                lambda {
                    equip-player-weapon(pistol-beretta);
                }
            }
        }
    }
    state player-kills-owen {
        block start {
            track main {
                lambda {
                    if (get-boolean(has-attacked?, npc-faq-owen-enemy-1)) {
                        send-event(kill, npc-faq-owen-enemy-1);
                    } else {
                        send-event(kill, npc-faq-owen-enemy-1, boxed_symbol(owen-shot));
                    }
                }
                lambda {
                    wait(0.50);
                }
                lambda {
                    if (get-boolean(dead?, npc-faq-mel-enemy-1)) {
                        go(finale, 1);
                    } else {
                        go(mel-attacks, 1);
                    }
                }
            }
        }
    }
    state  {
    }
    state finale {
        block start {
            track anim {
                lambda {
                    wait-boolean(death-anim-done?, 1, npc-faq-mel-enemy-1);
                }
                lambda {
                    camera-enable-animated(1.50, -1.00, 1, 1000, 0, 0, 0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 4, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-spawner-locator(ap-faq-confront-owen-mel-1, 1);
                    *(i32*)*var_0[1] = 28;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 1.30;
                    *(i32*)*var_0[2] = 56;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.70;
                    *(i32*)*var_0[3] = 58;
                    *(u64*)(*var_0[3] + 8) = 0;
                    *(f32*)(*var_0[3] + 8) = 0.20;
                    animate_(npc-faq-mel-enemy-1, faq-atrium-owen-mel-confrontation-end--mel, var_0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 4, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-spawner-locator(ap-faq-confront-owen-mel-1, 1);
                    *(i32*)*var_0[1] = 28;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 1.30;
                    *(i32*)*var_0[2] = 56;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.70;
                    *(i32*)*var_0[3] = 58;
                    *(u64*)(*var_0[3] + 8) = 0;
                    *(f32*)(*var_0[3] + 8) = 0.20;
                    animate_(player, faq-atrium-owen-mel-confrontation-end--ellie, var_0);
                }
                lambda {
                    while (!get-animation-playing?(npc-faq-mel-enemy-1, faq-atrium-owen-mel-confrontation-end--mel, 2)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    wait-until-anim-frame(npc-faq-mel-enemy-1, faq-atrium-owen-mel-confrontation-end--mel, 220.00, 2);
                }
                lambda {
                    camera-fade-out-animated(0.00, 0);
                }
                lambda {
                    go(task-complete, 1);
                }
            }
            track lightning {
                lambda {
                    while (!get-animation-playing?(npc-faq-mel-enemy-1, faq-atrium-owen-mel-confrontation-end--mel, 2)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    wait-until-anim-frame(npc-faq-mel-enemy-1, faq-atrium-owen-mel-confrontation-end--mel, 195.00, 2);
                }
                lambda {
                    wait-lightning-flash(ren-faq-lightning-controller-1, 6, 12, 1.10, 1.60, 0.01, 0.11);
                }
            }
        }
        block update {
            track main {
                lambda {
                    faq-set-ellie-confront-mode();
                }
            }
        }
        block end {
            track main {
                lambda {
                    fact-set(player, is-confront-owen-mel, boxed_bool(0));
                }
            }
        }
    }
    state task-complete {
        block start {
            track main {
                lambda {
                    task-complete!(find-aquarium, faq-confront-owen-mel);
                }
                lambda {
                    go(done, 1);
                }
            }
        }
    }
}
