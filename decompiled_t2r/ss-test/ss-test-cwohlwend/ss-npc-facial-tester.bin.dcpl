                        } else if (get-symbol(current-menu, self) == get-symbol(militia-melee-ddict, self) || get-symbol(current-menu, self) == get-symbol(militia-debug-ddict, self) || get-symbol(current-menu, self) == get-symbol(militia-gun-ddict, self) || get-symbol(current-menu, self) == get-symbol(militia-hybrid-ddict, self) && get-symbol(current-menu, self) == get-symbol(militia-dog+human-ddict, self)) {
                            set-symbol(current-menu, get-symbol(militia-sub-ddict, self), self);
                            set-string(menu-string, "Militia", self);
                        } else if (get-symbol(current-menu, self) == get-symbol(scar-melee-ddict, self) || get-symbol(current-menu, self) == get-symbol(scar-debug-ddict, self) || get-symbol(current-menu, self) == get-symbol(scar-gun-ddict, self) || get-symbol(current-menu, self) == get-symbol(scar-hybrid-ddict, self) && get-symbol(current-menu, self) == get-symbol(scar-brute-ddict, self)) {
                            set-symbol(current-menu, get-symbol(scar-sub-ddict, self), self);
                            set-string(menu-string, "Scar", self);
                        } else if (get-symbol(current-menu, self) == get-symbol(slaver-debug-ddict, self)) {
                            set-symbol(current-menu, get-symbol(slavers-sub-ddict, self), self);
                            set-string(menu-string, "Slavers", self);
                        } else if (get-symbol(current-menu, self) == get-symbol(crowd-debug-ddict, self)) {
                            set-symbol(current-menu, get-symbol(crowd-sub-ddict, self), self);
                            set-string(menu-string, "Crowd", self);
                        }
                        adjust-selector-and-move-window-to-zero-respawner();
                    }
                }
            }
        }
        block event npc-died {
            track main {
                lambda {
                    if (ddict-contains-key?(get-symbol(npc-respawn-ddict, self), event-arg-symbol(0))) {
                        ddict-set(get-symbol(npc-respawn-queue-ddict, self), event-arg-symbol(0), new-boxed-value(6, get-current-time(0)));
                    }
                }
            }
        }
