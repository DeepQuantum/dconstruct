                    } else if (*(u64*)(lookup-symbol(get-symbol(melee-move, self), melee-attack) + 16) == melee-player-wall-finisher-combo-intro) {
                        var_11 = 1;
                    } else if (*(u8*)(*(lookup-symbol(get-symbol(melee-move, self), melee-attack) + 296) + 162)) {
                        var_11 = 1;
                    } else {
                        var_11 = 0;
                    }
                    start-melee-action(
                        get-symbol(attacker, self),
                        get-symbol(defender, self),
                        get-symbol(melee-move, self),
                        var_4,
                        var_11,
                        1,
                        0,
                        0
                    );
                }
                lambda {
                    if (get-symbol(attacker2, self) != none) {
                        while (!character-in-melee-attack?(get-symbol(attacker2, self))) {
                            wait-one-frame();
                        }
                        while (!character-in-melee-attack?(player)) {
                            wait-one-frame();
                        }
                        u64? var_6;
                        if (*(i32*)(*(get-current-melee-attack(player) + 296) + 200) == 1 && *(i32*)(*(get-current-melee-attack(player) + 296) + 200) == 0) {
                            var_6 = get-spawner-locator(pos-melee-tester-collab-pos-1, 1);
                        } else if (*(i32*)(*(get-current-melee-attack(player) + 296) + 200) == 2) {
                            var_6 = get-spawner-locator(pos-melee-tester-collab-buddy-on-left-1, 1);
                        } else if (*(i32*)(*(get-current-melee-attack(player) + 296) + 200) == 3) {
                            var_6 = get-spawner-locator(pos-melee-tester-collab-buddy-on-right-1, 1);
                        } else {
                            var_6 = get-spawner-locator(pos-atk2-tester-spawn-1, 1);
                        }
                        set-bound-frame(attacker2-init-locator, var_6, self);
                    }
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    go(wait-melee-done, 1);
                }
            }
            track awareness {
                lambda {
                    wait-for(characters-reset);
                }
                lambda {
                    while (1) {
                        if (is-npc?(get-symbol(attacker, self))) {
                            if (get-symbol(defender, self) != none) {
                                npc-make-aware-of(get-symbol(attacker, self), get-symbol(defender, self), 2, 0);
                            }
                            if (get-symbol(attacker2, self) != none) {
                                npc-make-aware-of(get-symbol(attacker, self), get-symbol(attacker2, self), 2, 0);
                            }
                        }
                        if (is-npc?(get-symbol(defender, self))) {
                            if (get-symbol(attacker, self) != none) {
                                npc-make-aware-of(get-symbol(defender, self), get-symbol(attacker, self), 2, 0);
                            }
                            if (get-symbol(attacker2, self) != none) {
                                npc-make-aware-of(get-symbol(defender, self), get-symbol(attacker2, self), 2, 0);
                            }
                        }
                        if (get-symbol(attacker2, self) != none && is-npc?(get-symbol(attacker2, self))) {
                            if (get-symbol(attacker, self) != none) {
                                npc-make-aware-of(get-symbol(attacker2, self), get-symbol(attacker, self), 2, 0);
                            }
                            if (get-symbol(defender, self) != none) {
                                npc-make-aware-of(get-symbol(attacker2, self), get-symbol(defender, self), 2, 0);
                            }
                        }
                        wait-one-frame();
                    }
                }
            }
        }
    }
    state wait-melee-done {
        block start {
            track main {
                lambda {
                    while (character-in-melee-attack-as-attacker?(get-symbol(attacker, self)) && character-in-melee-attack-as-defender?(get-symbol(defender, self))) {
                        wait-one-frame();
                    }
                }
                lambda {
                    if (is-npc?(get-symbol(attacker, self)) && get-symbol(group-symbol, self) == finishers) {
                        while ((current-time(1) - current-time(1)) < 1.00) {
                            fade-to-black(0.00, frames-to-sec(1), 0.00, 1);
                            wait-one-frame();
                        }
                        wait(1.00);
                    }
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    go(melee-state, 1);
                }
            }
        }
    }
    state instant-change {
        block start {
            track main {
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("1"), 19);
                    }
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    if (get-symbol(attacker, self) != none) {
                        stop-animating(get-symbol(attacker, self), 2, 0.00, 0, 0);
                    }
                }
                lambda {
                    if (get-symbol(attacker2, self) != none) {
                        stop-animating(get-symbol(attacker2, self), 2, 0.00, 0, 0);
                    }
                }
                lambda {
                    if (get-symbol(defender, self) != none) {
                        stop-animating(get-symbol(defender, self), 2, 0.00, 0, 0);
                    }
                }
                lambda {
                    move-tester-remove-weapons(get-symbol(attacker, self));
                }
                lambda {
                    reset-character(get-symbol(attacker, self));
                }
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("2"), 19);
                    }
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    reset-character(get-symbol(attacker2, self));
                }
                lambda {
                    move-tester-remove-weapons(get-symbol(defender, self));
                }
                lambda {
                    reset-character(get-symbol(defender, self));
                }
                lambda {
                    go(melee-state, 1);
                }
            }
        }
    }
}
