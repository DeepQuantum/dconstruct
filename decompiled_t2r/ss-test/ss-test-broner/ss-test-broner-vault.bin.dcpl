}

u64? rb-vault-adjust-ground-height(u64? arg_0, u64? arg_1, u64? arg_2) {
    return rb-vault-move-object(arg_0, alloc-vector(0.00, rb-vault-get-ground-height(arg_0, arg_1, arg_2), 0.00, 1.00, 0));
}

u64? rb-vault-move-object(u64? arg_0, u64? arg_1) {
    return set-object-position(arg_0, offset-point(get-object-position(arg_0), arg_1));
}

u64? rb-vault-get-target-rot(u64? arg_0, u64? arg_1) {
    return quat-from-axis-angle(rotate-vector("", quat-from-axis-angle("", arg_1)), arg_0);
}

u64? rb-vault-set-rot(u64? arg_0, u64? arg_1, u64? arg_2) {
    return set-object-rotation(arg_0, rb-vault-get-target-rot(arg_1, arg_2));
}

u64? rb-vault-set-height(u64? arg_0, u64? arg_1) {
    u64? var_0 = get-object-position(arg_0);
