    return set-object-position(arg_0, var_0);
}

u64? rb-vault-get-ground-height(u64? arg_0, u64? arg_1, u64? arg_2) {
    u64? var_0 = get-object-position(arg_0);
    u64? var_4 = rotate-vector("", rb-vault-get-target-rot(arg_1, arg_2));
