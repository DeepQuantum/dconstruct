                        debug-draw-string-2d(
                            alloc-point(440.00, 250.00 + (20.00 * 2.00), 0.00, 0),
                            dc:format("[R2 + U/D] Multiplier:      %.3f", get-float(input-mult, self)),
                            1,
                            0.00,
                            1.00,
                            1,
                            0,
                            0,
                            1.00
                        );
                        debug-draw-string-2d(
                            alloc-point(440.00, 250.00 + (20.00 * 3.00), 0.00, 0),
                            dc:format("[ O + L/R] Ground Rot L/R:  %.3f", get-float(ground-rot-z, self)),
                            1,
                            0.00,
                            1.00,
                            1,
                            0,
                            0,
                            1.00
                        );
                        debug-draw-string-2d(
                            alloc-point(440.00, 250.00 + (20.00 * 4.00), 0.00, 0),
                            dc:format("[ O + U/D] Ground Rot F/B:  %.3f", get-float(ground-rot-x, self)),
                            1,
                            0.00,
                            1.00,
                            1,
                            0,
                            0,
                            1.00
                        );
                    }
                }
            }
        }
    }
}
