u64? current-distance-from-centroid() {
    return distance-between-points(get-point(conversation-centroid, self), get-object-position(player));
}

u64? distance-delta-from-centroid() {
    print-float(current-distance-from-centroid() - get-float(distance-to-centroid, self), self);
    return current-distance-from-centroid() - get-float(distance-to-centroid, self);
}

u16 enable-conversation-system() {
