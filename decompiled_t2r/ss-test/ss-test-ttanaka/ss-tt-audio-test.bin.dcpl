            }
        }
        block update {
            track main {
                lambda {
                    joypad-disable-all-commands-except();
                }
                lambda {
                    ss-tt-audio-test-get-controller();
                }
                lambda {
                    ss-tt-audio-test-UI();
                }
                lambda {
                    debug-set-camera-position/f(get-bound-frame(camera-position, self));
