statescript {
    options {
        player
        lf-trav-buddies
    }
    declarations {
        symbol current-barrel = nullptr
        bool barrel-caught = nullptr
    }
    state initial {
        block event catch-zone {
            track main {
                lambda {
                    go(catch-zone, 1);
                }
            }
        }
    }
    state catch-zone {
        block start {
            track dina {
                lambda {
                    while (!get-boolean(barrel-caught, self)) {
                        set-symbol(current-barrel, spawn-entity(barrel-75, 0, 0), self);
                        wait-one-frame();
                        apply-point-impulse(
                            get-symbol(current-barrel, self),
                            root,
                            get-object-position(npc-dina-5),
                            "",
                            1.00,
                            -1.00,
                            0,
                            0.00,
                            0.00
                        );
                        wait(6.00);
                        if (entity-exists?(get-symbol(current-barrel, self))) {
                            kill-entity(get-symbol(current-barrel, self));
                        }
                    }
                }
            }
            track ellie {
                lambda {
                    wait-boolean(barrel-caught, 1, self);
                }
                lambda {
                    script-caption(player, "Caught it!", -1.00, 0, 0);
                }
                lambda {
                    kill-entity(get-symbol(current-barrel, self));
                }
                lambda {
                    spawn-entity(barrel-82, 0, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (distance-between-objects-less-than?(get-symbol(current-barrel, self), player, 1.00)) {
                        set-boolean(barrel-caught, 1, self);
                    }
                }
            }
        }
    }
}
