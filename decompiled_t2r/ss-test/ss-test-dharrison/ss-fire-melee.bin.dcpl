statescript {
    options {
        player
        sp-all
    }
    declarations {
        u64 particle-handle = 0
    }
    state wait-for-craft {
        block event player-craft-item {
            track main {
                lambda {
                    spawn-script-multiple("ss-fire-melee", event-arg-symbol(1), 0);
                }
                lambda {
                    if (get-uint64(particle-handle, self) != 0) {
                        player-drop-weapon(short-pipe-fire);
                    }
                }
            }
        }
        block event player-swing {
            track main {
                lambda {
                    if (get-uint64(particle-handle, self) == 0) {
                        set-uint64(particle-handle, spawn-particles-at-joint(
                            torch-fire,
                            get-self-id(),
                            handle,
                            0,
                            16,
                            root,
                            2,
                            alloc-vector(0.00, 0.05, 0.30, 1.00, 0),
                            2,
                            0
                        ), self);
                    }
                }
            }
        }
        block event melee-attack-hit {
            track main {
                lambda {
                    if (get-player-weapon-id() == short-pipe-fire) {
                        npc-set-on-fire(event-arg-symbol(0), 0, person-on-fire);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (nth-frame?(10, 0) && get-uint64(particle-handle, self) != 0) {
                        player-set-weapon-health(player-get-weapon-health() - 1);
                        if (player-get-weapon-health() <= 0) {
                            if (get-player-weapon-id() == short-pipe-fire) {
                                remove-player-weapon(short-pipe-fire);
                                give-player-weapon(short-pipe, 0, 0);
                                player-set-weapon-health(1);
                                go(fire-done, 1);
                            } else {
                                kill-entity(get-self-id());
                                go(fire-done, 1);
                            }
                        }
                    }
                }
            }
        }
    }
}
