        0    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 20.00, 0.00, 0),
            "Demeanor: ambient",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        ),
        1    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 20.00, 0.00, 0),
            "Demeanor: search",
