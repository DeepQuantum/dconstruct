u16 switch-weapon(u64? arg_0, sid arg_1) {
    u16 var_0;
    if (arg_1 == firearm) {
        npc-unholster-weapon(arg_0, 0, -1.00, 0);
        var_0 = npc-draw-firearm(arg_0, 2, -1.00, 0);
    } else if (arg_1 == pistol) {
        npc-unholster-weapon(arg_0, 0, -1.00, 0);
        var_0 = npc-draw-pistol(arg_0, 2, -1.00, 0);
    } else if (arg_1 == long-gun) {
        npc-unholster-weapon(arg_0, 0, -1.00, 0);
        var_0 = npc-draw-long-gun(arg_0, 2, -1.00, 0);
    } else if (arg_1 == melee-weapon) {
        npc-unholster-weapon(arg_0, 0, -1.00, 0);
        var_0 = npc-draw-melee-weapon(arg_0, 2, -1.00, 0);
    } else {
        var_0 = 0;
    }
    return var_0;
}

u16 update-npc-demeanor() {
    if (get-int32(demeanor-pointer, self) == 0) {
        npc-set-demeanor(get-symbol(active-npc, self), 0, 0);
    } else if (get-int32(demeanor-pointer, self) == 1) {
        npc-set-demeanor(get-symbol(active-npc, self), 5, 0);
    } else if (get-int32(demeanor-pointer, self) == 2) {
        npc-set-demeanor(get-symbol(active-npc, self), 2, 0);
    } else if (get-int32(demeanor-pointer, self) == 3) {
        npc-set-demeanor(get-symbol(active-npc, self), 3, 0);
    } else if (get-int32(demeanor-pointer, self) == 4) {
        npc-set-demeanor(get-symbol(active-npc, self), 1, 0);
    } else if (get-int32(demeanor-pointer, self) == 5) {
        npc-set-demeanor(get-symbol(active-npc, self), 4, 0);
    }
    u16 var_13;
    if (!(get-symbol(active-slave-npc, self) == 0)) {
        if (get-int32(demeanor-pointer, self) == 0) {
            var_13 = npc-set-demeanor(get-symbol(active-slave-npc, self), 0, 0);
        } else if (get-int32(demeanor-pointer, self) == 1) {
            var_13 = npc-set-demeanor(get-symbol(active-slave-npc, self), 5, 0);
        } else if (get-int32(demeanor-pointer, self) == 2) {
            var_13 = npc-set-demeanor(get-symbol(active-slave-npc, self), 2, 0);
        } else if (get-int32(demeanor-pointer, self) == 3) {
            var_13 = npc-set-demeanor(get-symbol(active-slave-npc, self), 3, 0);
        } else if (get-int32(demeanor-pointer, self) == 4) {
            var_13 = npc-set-demeanor(get-symbol(active-slave-npc, self), 1, 0);
        } else if (get-int32(demeanor-pointer, self) == 5) {
            var_13 = npc-set-demeanor(get-symbol(active-slave-npc, self), 4, 0);
        } else {
            var_13 = 0;
        }
    } else {
        var_13 = 0;
    }
    return var_13;
}

