u64? spawn-test-npc(sid arg_0) {
    set-boolean(player?, 0, self);
    if (object-spawned?(get-symbol(active-npc, self))) {
        npc-kill(get-symbol(active-npc, self));
    }
    wait-one-frame();
    if (arg_0 == npc-and-dog-1) {
        spawn-npc(npc-dog-1, 0, 0);
        spawn-npc(npc-pistol-1, 0, 0);
    } else {
        spawn-npc(arg_0, 0, 0);
    }
    if (arg_0 == c-dina-1) {
        set-symbol(active-npc, dina, self);
    } else if (arg_0 == c-yara-1) {
        set-symbol(active-npc, yara, self);
    } else if (arg_0 == c-lev-1) {
        set-symbol(active-npc, lev, self);
    } else if (arg_0 == c-joel-1) {
        set-symbol(active-npc, joel, self);
    } else if (arg_0 == c-jesse-1) {
        set-symbol(active-npc, jesse, self);
    } else if (arg_0 == c-manny-1) {
        set-symbol(active-npc, manny, self);
    } else if (arg_0 == c-mel-1) {
        set-symbol(active-npc, mel, self);
    } else if (arg_0 == c-owen-1) {
        set-symbol(active-npc, owen, self);
    } else if (arg_0 == npc-and-dog-1) {
        set-symbol(active-npc, npc-pistol-1, self);
        set-symbol(active-slave-npc, npc-dog-1, self);
    } else {
        npc-set-script-only-no-perception(arg_0);
        set-symbol(active-npc, arg_0, self);
    }
    npc-set-script-only-no-perception(get-symbol(active-npc, self));
    npc-change-vision-settings(get-symbol(active-npc, self), *default-vision-cone-blind*);
    return update-npc-demeanor();
}

