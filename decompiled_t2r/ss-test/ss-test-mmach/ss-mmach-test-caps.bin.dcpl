            0,
            0,
            0,
            1.00
        );
        debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 60.00, -4.00, 0),
            "Perform Corner Check: X",
            7,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        );
        debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 70.00, -4.00, 0),
            "-------------------------------------",
            7,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        );
        debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 80.00, -4.00, 0),
            "Change Enter Angle: L2(hold) + Dpad L/R",
            7,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        );
        debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 90.00, -4.00, 0),
            "Change Exit Angle: R2(hold) + Dpad L/R",
            7,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        );
        debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 100.00, -4.00, 0),
            "Speed Change: L2(hold) + R2(hold) + Dpad Up/Down",
            7,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        );
        debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 110.00, -4.00, 0),
            "Demeanor Change: L2(hold) + R2(hold) + Dpad L/R",
            7,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        );
        var_1 = debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 120.00, -4.00, 0),
            "Hide Help: Square",
            7,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        );
    } else {
        var_1 = debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 50.00, -4.00, 0),
            "Display Help: Square",
            7,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        );
    }
    return var_1;
}

u16 draw-speed-caption() {
    return match (get-int32(speed-pointer, self)) {
        0    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 30.00, -4.00, 0),
            "Speed: walk",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        ),
        1    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 30.00, -4.00, 0),
            "Speed: run",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        ),
        2    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 30.00, -4.00, 0),
            "Speed: sprint",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        ),
        3    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 30.00, -4.00, 0),
            "Speed: max",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        ),
        else -> 0
    };
}

statescript {
    options {
        player
    }
    declarations {
        i32 angle-start-pointer = 0
        i32 angle-end-pointer = 0
        i32 angle-start = 0
        i32 angle-end = 0
        i32 demeanor-pointer = 0
        i32 speed-pointer = 0
        i32 speed-enum = 0
        f32 top-menu-y-start = 20.00
        f32 top-menu-x-start = 600.00
        f32 console-y-start = 550.00
        f32 console-x-start = 1000.00
        bool draw-help? = nullptr
        symbol pivot-start = pivot-start-1
        symbol pivot-end = pivot-end-1
        symbol position-start = position-start-1
        symbol position-end = position-end-1
        symbol activity = cap-1
        symbol active-npc = #0000000000000000
        symbol active-slave-npc = #0000000000000000
        bound-frame active-region-locator = nullptr
        symbol active-npc-selection = select-npc-to-spawn
        symbol active-cap-selection = select-a-cap
        symbol active-weapon-selection = select-a-weapon
        bool player? = nullptr
        bool is-single-loop? = nullptr
    }
    state initial {
        block start {
            track main {
                lambda {
                    player-remove-weapons();
                }
                lambda {
                    fatigue-disable();
                }
            }
        }
        block update {
            track main {
                lambda {
                    set-symbol(active-npc-selection, hud-debug-group-menu(
                        character-group,
                        get-symbol(active-npc-selection, self),
                        alloc-point(get-float(top-menu-x-start, self), get-float(top-menu-y-start, self), 0.00, 0),
                        alloc-vector(-14.00, 6.00, 0.00, 1.00, 0),
                        npc-group-menu-confirmed,
                        npc-debug-group-menu-updated,
                        0.60,
                        "triangle",
                        8.00
                    ), self);
                }
                lambda {
                    set-symbol(active-cap-selection, hud-debug-group-menu(
                        caps-group,
                        get-symbol(active-cap-selection, self),
                        alloc-point(get-float(top-menu-x-start, self) + 150.00, get-float(top-menu-y-start, self), 0.00, 0),
                        alloc-vector(-14.00, 6.00, 0.00, 1.00, 0),
                        cap-group-menu-confirmed,
                        cap-debug-group-menu-updated,
                        0.60,
                        "square",
                        8.00
                    ), self);
                }
                lambda {
                    set-symbol(active-weapon-selection, hud-debug-group-menu(
                        weapons-group,
                        get-symbol(active-weapon-selection, self),
                        alloc-point(get-float(top-menu-x-start, self) + 350.00, get-float(top-menu-y-start, self), 0.00, 0),
                        alloc-vector(-14.00, 6.00, 0.00, 1.00, 0),
                        weapon-group-menu-confirmed,
                        weapon-debug-group-menu-updated,
                        0.60,
                        "r3",
                        8.00
                    ), self);
                }
                lambda {
                    draw-cap-help();
                }
                lambda {
                    draw-speed-caption();
                }
                lambda {
                    draw-demeanor-caption();
                }
                lambda {
                    draw-movement-dir-caption(get-symbol(position-start, self), dir-start);
                }
                lambda {
                    draw-movement-dir-caption(get-symbol(position-end, self), dir-end);
                }
                lambda {
                    draw-crosshair();
                }
                lambda {
                    foreach (u64? var_1 : caps-group) {
                        u16 var_2;
                        if (var_1 && *(u16*)(var_1 + 12) == 7) {
                            var_2 = *(u64*)var_1;
                        } else if (var_1 && *(u16*)(var_1 + 12) == 5) {
                            var_2 = *(u64*)var_1;
                        } else if (var_1 && *(u16*)(var_1 + 12) == 4) {
                            var_2 = *(u64*)var_1;
                        } else {
                            var_2 = 0;
                        }
                        if (spawner-exists?(var_2)) {
                            debug-draw-string(
                                offset-position(get-spawner-position(var_2, 1), alloc-vector(0.00, 2.00, 0.00, 1.00, 0)),
                                string-debug(var_2),
                                7,
                                0.00,
                                0,
                                0.50,
                                0,
                                0
                            );
                        }
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(fire-hold, 0)) {
                        send-event(selection-active, self);
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(jump, 0) && !debug-joypad-command-active?(fire-hold, 0)) {
                        send-event(start-moving, self);
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(fire-hold, 0) && !debug-joypad-command-active?(aim, 0)) {
                        if (debug-joypad-command-active?(menu-left, 0)) {
                            set-int32(angle-end, get-int32(angle-end, self) - 10, self);
                            set-object-locator(get-symbol(pivot-end, self), rotate-locator-angle(get-object-locator-default-rotation(get-symbol(pivot-end, self)), 1, (f32)get-int32(angle-end, self)));
                        }
                        if (debug-joypad-command-active?(menu-right, 0)) {
                            set-int32(angle-end, get-int32(angle-end, self) + 10, self);
                            set-object-locator(get-symbol(pivot-end, self), rotate-locator-angle(get-object-locator-default-rotation(get-symbol(pivot-end, self)), 1, (f32)get-int32(angle-end, self)));
                        }
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(aim, 0) && !debug-joypad-command-active?(fire-hold, 0)) {
                        if (debug-joypad-command-active?(menu-left, 0)) {
                            set-int32(angle-start, get-int32(angle-start, self) - 10, self);
                            set-object-locator(get-symbol(pivot-start, self), rotate-locator-angle(get-object-locator-default-rotation(get-symbol(pivot-start, self)), 1, (f32)get-int32(angle-start, self)));
                        }
                        if (debug-joypad-command-active?(menu-right, 0)) {
                            set-int32(angle-start, get-int32(angle-start, self) + 10, self);
                            set-object-locator(get-symbol(pivot-start, self), rotate-locator-angle(get-object-locator-default-rotation(get-symbol(pivot-start, self)), 1, (f32)get-int32(angle-start, self)));
                        }
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(aim, 0) && debug-joypad-command-active?(fire-hold, 0)) {
                        if (debug-joypad-command-active?(menu-left, 0)) {
                            send-event(change-demeanor, self, new-boxed-value(2, 0));
                        }
                        if (debug-joypad-command-active?(menu-right, 0)) {
                            send-event(change-demeanor, self, new-boxed-value(2, 1));
                        }
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(aim, 0) && debug-joypad-command-active?(fire-hold, 0)) {
                        if (debug-joypad-command-active?(menu-up, 0)) {
                            send-event(change-speed, self, new-boxed-value(2, 1));
                        }
                        if (debug-joypad-command-active?(menu-down, 0)) {
                            send-event(change-speed, self, new-boxed-value(2, 0));
                        }
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(melee-attack, 0)) {
                        send-event(help-toggle, self);
                    }
                }
            }
        }
        block event start-moving {
            track main {
                lambda {
                    if (entity-exists?(get-symbol(active-npc, self))) {
                        switch-weapon(get-symbol(active-npc, self), get-symbol(active-weapon-selection, self));
                        if (!npc-is-using-cinematic-action-pack?(get-symbol(active-npc, self))) {
                            if (!is-final-build?()) {
                                display(dc:format("Npc IS NOT in a CAP"), 19);
                            }
                            update-npc-demeanor();
                            npc-clear-request-movement(get-symbol(active-npc, self));
                            npc-stop(get-symbol(active-npc, self));
                            npc-teleport-to(get-symbol(active-npc, self), get-object-locator-remove-binding(get-symbol(position-start, self)));
                            if (darray-contains?(door-caps, new-boxed-value(7, get-symbol(activity, self)))) {
                                u64? var_17 = #%alloc-array(single-frame, 16, 1, 1);
                                *(i32*)*(*var_17 + (0 * 8)) = 58;
                                *(u64*)(*(*var_17 + (0 * 8)) + 8) = 0;
                                *(f32*)(*(*var_17 + (0 * 8)) + 8) = 1.00;
                                animate_(get-symbol(activity, self), close-r, var_17);
                            }
                            if (!(get-symbol(active-slave-npc, self) == 0)) {
                                npc-clear-request-movement(get-symbol(active-slave-npc, self));
                                npc-stop(get-symbol(active-slave-npc, self));
                                npc-teleport-to(get-symbol(active-slave-npc, self), offset-locator(get-object-locator-remove-binding(get-symbol(position-start, self)), alloc-vector(0.30, 0.00, 0.50, 1.00, 0)));
                            }
                            wait(0.30);
                            if (!(get-symbol(active-slave-npc, self) == 0)) {
                                npc-use-cinematic-action-pack(get-symbol(active-slave-npc, self), get-symbol(activity, self), get-int32(speed-enum, self), 0, 0);
                            }
                            if (get-boolean(is-single-loop?, self)) {
                                wait-npc-use-cinematic-action-pack(get-symbol(active-npc, self), get-symbol(activity, self), get-int32(speed-enum, self), 0, 0);
                                npc-move-to(
                                    get-symbol(active-npc, self),
                                    get-object-locator-remove-binding(get-symbol(position-end, self)),
                                    get-int32(speed-enum, self),
                                    0,
                                    0,
                                    0,
                                    0,
                                    0
                                );
                                if (!(get-symbol(active-slave-npc, self) == 0)) {
                                    npc-move-to(
                                        get-symbol(active-slave-npc, self),
                                        get-object-locator-remove-binding(get-symbol(position-end, self)),
                                        get-int32(speed-enum, self),
                                        0,
                                        0,
                                        0,
                                        0,
                                        0
                                    );
                                }
                            } else {
                                npc-use-cinematic-action-pack(get-symbol(active-npc, self), get-symbol(activity, self), get-int32(speed-enum, self), 0, 0);
                            }
                        } else {
                            if (!is-final-build?()) {
                                display(dc:format("Npc IS in a CAP"), 19);
                            }
                            npc-move-to(
                                get-symbol(active-npc, self),
                                get-object-locator-remove-binding(get-symbol(position-end, self)),
                                get-int32(speed-enum, self),
                                0,
                                0,
                                0,
                                0,
                                0
                            );
                            if (!(get-symbol(active-slave-npc, self) == 0)) {
                                npc-move-to(
                                    get-symbol(active-slave-npc, self),
                                    get-object-locator-remove-binding(get-symbol(position-end, self)),
                                    get-int32(speed-enum, self),
                                    0,
                                    0,
                                    0,
                                    0,
                                    0
                                );
                            }
                        }
                    }
                }
            }
        }
        block event help-toggle {
            track main {
                lambda {
                    if (get-boolean(draw-help?, self)) {
                        set-boolean(draw-help?, 0, self);
                    } else {
                        set-boolean(draw-help?, 1, self);
                    }
                }
            }
        }
        block event change-demeanor {
            track main {
                lambda {
                    if (entity-exists?(get-symbol(active-npc, self))) {
                        if (event-arg-int32(0) == 0) {
                            ++(demeanor-pointer, self);
                        } else {
                            --(demeanor-pointer, self);
                        }
                        if (get-int32(demeanor-pointer, self) > 6) {
                            set-int32(demeanor-pointer, 0, self);
                        } else if (get-int32(demeanor-pointer, self) < 0) {
                            set-int32(demeanor-pointer, 6, self);
                        }
                        update-npc-demeanor();
                    } else {
                        debug-draw-text-box-2D(
                            "Spawn npc first!",
                            60,
                            340.00,
                            60.00,
                            1.00,
                            1,
                            0,
                            1,
                            1.00
                        );
                    }
                }
            }
        }
        block event change-speed {
            track main {
                lambda {
                    if (event-arg-int32(0) == 1) {
                        ++(speed-pointer, self);
                    } else {
                        --(speed-pointer, self);
                    }
                }
                lambda {
                    if (get-int32(speed-pointer, self) > 3) {
                        set-int32(speed-pointer, 0, self);
                    } else if (get-int32(speed-pointer, self) < 0) {
                        set-int32(speed-pointer, 3, self);
                    }
                }
                lambda {
                    if (get-int32(speed-pointer, self) == 0) {
                        set-int32(speed-enum, 0, self);
                    } else if (get-int32(speed-pointer, self) == 1) {
                        set-int32(speed-enum, 1, self);
                    } else if (get-int32(speed-pointer, self) == 2) {
                        set-int32(speed-enum, 2, self);
                    } else if (get-int32(speed-pointer, self) == 3) {
                        set-int32(speed-enum, 3, self);
                    }
                }
            }
        }
        block event selection-active {
            track main {
                lambda {
                    u64? var_4 = kick-raycast(camera-locator(1), offset-locator(camera-locator(1), alloc-vector(0.00, 0.00, 35.00, 1.00, 0)), 0, 4097);
                    wait-one-frame();
                    if (wait-raycast-hit-nothing?(var_4)) {}
 else {
                        set-bound-frame(active-region-locator, wait-raycast(var_4), self);
                        debug-draw-sphere(get-locator-position(get-bound-frame(active-region-locator, self)), 0.25, 3, 0.00, 0, 0);
                        if (debug-joypad-command-active?(jump, 0)) {
                            u64? var_12 = select-activity(get-bound-frame(active-region-locator, self));
                            if (!(var_12 == 0)) {
                                var_13 = set-symbol(activity, var_12, self);
                            }
                        }
                    }
                }
            }
        }
        block event npc-group-menu-confirmed {
            track main {
                lambda {
                    if (!(get-symbol(active-npc-selection, self) == select-npc-to-spawn)) {
                        spawn-test-npc(get-symbol(active-npc-selection, self));
                    }
                }
            }
        }
        block event cap-group-menu-confirmed {
            track main {
                lambda {
                    if (!(get-symbol(active-cap-selection, self) == select-a-cap)) {
                        debug-draw-locator(get-spawner-locator(get-symbol(active-cap-selection, self), 1), 2.00, 2.00, 0, 2.00, 0);
                        select-activity(get-spawner-locator(get-symbol(active-cap-selection, self), 1));
                    }
                }
            }
        }
        block event weapon-group-menu-confirmed {
            track main {
                lambda {
                    switch-weapon(get-symbol(active-npc, self), get-symbol(active-weapon-selection, self));
                }
            }
        }
    }
}
