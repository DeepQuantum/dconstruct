u64? draw-crosshair() {
    return debug-draw-ngon-2d(
        vector-divide(get-screen-size(1), 2.00),
        5.00,
        12,
        0.00,
        1,
        0.00,
        1.00,
        0,
        1.00,
        1.00
    );
}

