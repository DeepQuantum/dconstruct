    } else {
        var_1 = debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 20.00, -4.00, 0),
            "Strafing: OFF",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        );
    }
    return var_1;
}

u16 draw-speed-caption() {
    return match (get-int32(speed-pointer, self)) {
        0    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 10.00, -4.00, 0),
            "Speed: walk",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        ),
        1    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 10.00, -4.00, 0),
            "Speed: run",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        ),
        2    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 10.00, -4.00, 0),
            "Speed: sprint",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        ),
        3    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 10.00, -4.00, 0),
            "Speed: max",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        ),
        else -> 0
    };
}

statescript {
    options {
        player
    }
    declarations {
        i32 angle-start-pointer = 0
        i32 angle-end-pointer = 0
        i32 angle-start = 0
        i32 angle-end = 0
        i32 demeanor-pointer = 0
        i32 speed-pointer = 0
        i32 speed-enum = 0
        f32 top-menu-y-start = 20.00
        f32 top-menu-x-start = 800.00
        f32 console-y-start = 550.00
        f32 console-x-start = 1000.00
        bool weapon-up? = nullptr
        bool strafe? = nullptr
        bool draw-help? = nullptr
        symbol pivot-start = pivot-start-1
        symbol pivot-end = pivot-end-1
        symbol position-start = position-start-1
        symbol position-end = position-end-1
        symbol activity = cap-1
        symbol active-npc = #0000000000000000
        bound-frame active-region-locator = nullptr
        symbol active-npc-selection = select-npc-to-spawn
        symbol active-mp-selection = select-a-move-performance
        symbol active-weapon-selection = no-weapon
        symbol active-mp-table-selection = *npc-m-ambient-move-performances*
        symbol ambi-move-performance = *npc-m-ambient-move-performances*
        symbol search-move-performance = *npc-m-search-move-performances*
        symbol uneasy-move-performance = *npc-buddy-uneasy-move-performances*
        symbol mt-value = #0000000000000000
        f32 button-repeat-delay = 0.15
        timer button-repeat-timer = nullptr
        bool button-delay-active = nullptr
        bool player? = nullptr
        symbol current-object = #0000000000000000
        f32 angle-increment = 22.50
    }
    state initial {
        block start {
            track main {
                lambda {
                    player-remove-weapons();
                }
                lambda {
                    fatigue-disable();
                }
                lambda {
                    allocate-dynamic-nav-blocker-for-object(blocker-object-1);
                }
                lambda {
                    enable-nav-blocker-object(blocker-object-1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (debug-joypad-command-active?(fire-hold, 0)) {
                        set-symbol(active-weapon-selection, hud-debug-group-menu(
                            weapon-group,
                            get-symbol(active-weapon-selection, self),
                            alloc-point(get-float(top-menu-x-start, self) + -350.00, get-float(top-menu-y-start, self), 0.00, 0),
                            alloc-vector(-14.00, 6.00, 0.00, 1.00, 0),
                            weapon-group-menu-confirmed,
                            weapon-debug-group-menu-updated,
                            0.60,
                            "circle",
                            8.00
                        ), self);
                        set-symbol(active-npc-selection, hud-debug-group-menu(
                            character-group,
                            get-symbol(active-npc-selection, self),
                            alloc-point(get-float(top-menu-x-start, self) + -200.00, get-float(top-menu-y-start, self), 0.00, 0),
                            alloc-vector(-14.00, 6.00, 0.00, 1.00, 0),
                            npc-group-menu-confirmed,
                            npc-debug-group-menu-updated,
                            0.60,
                            "triangle",
                            8.00
                        ), self);
                        set-symbol(active-mp-selection, hud-debug-group-menu(
                            move-performances-group,
                            get-symbol(active-mp-selection, self),
                            alloc-point(get-float(top-menu-x-start, self) + -50.00, get-float(top-menu-y-start, self), 0.00, 0),
                            alloc-vector(-14.00, 6.00, 0.00, 1.00, 0),
                            mp-group-menu-confirmed,
                            mp-debug-group-menu-updated,
                            0.60,
                            "square",
                            8.00
                        ), self);
                        set-symbol(active-mp-table-selection, hud-debug-group-menu(
                            move-performance-tables-group,
                            get-symbol(active-mp-table-selection, self),
                            alloc-point(get-float(top-menu-x-start, self) + 200.00, get-float(top-menu-y-start, self), 0.00, 0),
                            alloc-vector(-14.00, 6.00, 0.00, 1.00, 0),
                            mp-group-menu-confirmed,
                            mp-debug-group-menu-updated,
                            0.60,
                            "x",
                            8.00
                        ), self);
                    }
                }
                lambda {
                    draw-demeanor-caption();
                }
                lambda {
                    draw-speed-caption();
                }
                lambda {
                    draw-strafe-caption();
                }
                lambda {
                    draw-weapon-hold-caption();
                }
                lambda {
                    draw-help();
                }
                lambda {
                    draw-crosshair();
                }
                lambda {
                    if (debug-joypad-command-active?(fire-hold, 0)) {
                        send-event(selection-active, self);
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(jump, 0) && !debug-joypad-command-active?(fire-hold, 0)) {
                        if (debug-joypad-command-active?(aim, 0)) {
                            send-event(move, self, new-boxed-value(1, 1));
                        } else {
                            send-event(move, self, new-boxed-value(1, 0));
                        }
                    }
                }
                lambda {
                    if (!debug-joypad-command-active?(fire-hold, 0) && debug-joypad-command-active?(aim, 0) && !(get-symbol(current-object, self) == 0)) {
                        if (debug-joypad-command-active?(menu-left, 0)) {
                            set-object-locator(get-symbol(current-object, self), offset-locator(get-object-locator(get-symbol(current-object, self)), get-camera-vector-in-obj-space(alloc-vector(0.25, 0.00, 0.00, 1.00, 0), get-symbol(current-object, self), 1, 1)));
                            set-boolean(button-delay-active, 1, self);
                            start-timer(button-repeat-timer, get-float(button-repeat-delay, self), self, 1);
                        }
                        if (debug-joypad-command-active?(debug-script-hold-left, 0) && !get-boolean(button-delay-active, self)) {
                            set-object-locator(get-symbol(current-object, self), offset-locator(get-object-locator(get-symbol(current-object, self)), get-camera-vector-in-obj-space(alloc-vector(0.25, 0.00, 0.00, 1.00, 0), get-symbol(current-object, self), 1, 1)));
                            set-boolean(button-delay-active, 1, self);
                            start-timer(button-repeat-timer, get-float(button-repeat-delay, self), self, 1);
                        }
                        if (debug-joypad-command-active?(menu-right, 0)) {
                            set-object-locator(get-symbol(current-object, self), offset-locator(get-object-locator(get-symbol(current-object, self)), get-camera-vector-in-obj-space(alloc-vector(-0.25, 0.00, 0.00, 1.00, 0), get-symbol(current-object, self), 1, 1)));
                            set-boolean(button-delay-active, 1, self);
                            start-timer(button-repeat-timer, get-float(button-repeat-delay, self), self, 1);
                        }
                        if (debug-joypad-command-active?(debug-script-hold-right, 0) && !get-boolean(button-delay-active, self)) {
                            set-object-locator(get-symbol(current-object, self), offset-locator(get-object-locator(get-symbol(current-object, self)), get-camera-vector-in-obj-space(alloc-vector(-0.25, 0.00, 0.00, 1.00, 0), get-symbol(current-object, self), 1, 1)));
                            set-boolean(button-delay-active, 1, self);
                            start-timer(button-repeat-timer, get-float(button-repeat-delay, self), self, 1);
                        }
                        if (debug-joypad-command-active?(menu-up, 0)) {
                            set-object-locator(get-symbol(current-object, self), offset-locator(get-object-locator(get-symbol(current-object, self)), get-camera-vector-in-obj-space(alloc-vector(0.00, 0.00, 0.25, 1.00, 0), get-symbol(current-object, self), 1, 1)));
                            set-boolean(button-delay-active, 1, self);
                            start-timer(button-repeat-timer, get-float(button-repeat-delay, self), self, 1);
                        }
                        if (debug-joypad-command-active?(debug-script-hold-up, 0) && !get-boolean(button-delay-active, self)) {
                            set-object-locator(get-symbol(current-object, self), offset-locator(get-object-locator(get-symbol(current-object, self)), get-camera-vector-in-obj-space(alloc-vector(0.00, 0.00, 0.25, 1.00, 0), get-symbol(current-object, self), 1, 1)));
                            set-boolean(button-delay-active, 1, self);
                            start-timer(button-repeat-timer, get-float(button-repeat-delay, self), self, 1);
                        }
                        if (debug-joypad-command-active?(menu-down, 0)) {
                            set-object-locator(get-symbol(current-object, self), offset-locator(get-object-locator(get-symbol(current-object, self)), get-camera-vector-in-obj-space(alloc-vector(0.00, 0.00, -0.25, 1.00, 0), get-symbol(current-object, self), 1, 1)));
                            set-boolean(button-delay-active, 1, self);
                            start-timer(button-repeat-timer, get-float(button-repeat-delay, self), self, 1);
                        }
                        if (debug-joypad-command-active?(debug-script-hold-down, 0) && !get-boolean(button-delay-active, self)) {
                            set-object-locator(get-symbol(current-object, self), offset-locator(get-object-locator(get-symbol(current-object, self)), get-camera-vector-in-obj-space(alloc-vector(0.00, 0.00, -0.25, 1.00, 0), get-symbol(current-object, self), 1, 1)));
                            set-boolean(button-delay-active, 1, self);
                            start-timer(button-repeat-timer, get-float(button-repeat-delay, self), self, 1);
                        }
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(fire-hold, 0) && !debug-joypad-command-active?(aim, 0) && !(get-symbol(current-object, self) == 0)) {
                        if (debug-joypad-command-active?(menu-left, 0)) {
                            set-object-locator(get-symbol(current-object, self), rotate-locator-axis-angle(get-object-locator(get-symbol(current-object, self)), alloc-vector(0.00, 1.00, 0.00, 1.00, 0), get-float(angle-increment, self)));
                            debug-draw-string(
                                get-object-position(get-symbol(current-object, self)),
                                float-to-string(get-angle-between-quats(get-spawner-rotation(get-symbol(current-object, self), 1), get-object-rotation(get-symbol(current-object, self))), 1),
                                3,
                                get-float(button-repeat-delay, self),
                                1,
                                1.00,
                                0,
                                0
                            );
                            set-boolean(button-delay-active, 1, self);
                            start-timer(button-repeat-timer, get-float(button-repeat-delay, self), self, 1);
                        }
                        if (debug-joypad-command-active?(debug-script-hold-left, 0) && !get-boolean(button-delay-active, self)) {
                            set-object-locator(get-symbol(current-object, self), rotate-locator-axis-angle(get-object-locator(get-symbol(current-object, self)), alloc-vector(0.00, 1.00, 0.00, 1.00, 0), get-float(angle-increment, self)));
                            debug-draw-string(
                                get-object-position(get-symbol(current-object, self)),
                                float-to-string(get-angle-between-quats(get-spawner-rotation(get-symbol(current-object, self), 1), get-object-rotation(get-symbol(current-object, self))), 1),
                                3,
                                get-float(button-repeat-delay, self),
                                1,
                                1.00,
                                0,
                                0
                            );
                            set-boolean(button-delay-active, 1, self);
                            start-timer(button-repeat-timer, get-float(button-repeat-delay, self), self, 1);
                        }
                        if (debug-joypad-command-active?(menu-right, 0)) {
                            set-object-locator(get-symbol(current-object, self), rotate-locator-axis-angle(get-object-locator(get-symbol(current-object, self)), alloc-vector(0.00, 1.00, 0.00, 1.00, 0), negf(get-float(angle-increment, self))));
                            debug-draw-string(
                                get-object-position(get-symbol(current-object, self)),
                                float-to-string(get-angle-between-quats(get-spawner-rotation(get-symbol(current-object, self), 1), get-object-rotation(get-symbol(current-object, self))), 1),
                                3,
                                get-float(button-repeat-delay, self),
                                1,
                                1.00,
                                0,
                                0
                            );
                            set-boolean(button-delay-active, 1, self);
                            start-timer(button-repeat-timer, get-float(button-repeat-delay, self), self, 1);
                        }
                        if (debug-joypad-command-active?(debug-script-hold-right, 0) && !get-boolean(button-delay-active, self)) {
                            set-object-locator(get-symbol(current-object, self), rotate-locator-axis-angle(get-object-locator(get-symbol(current-object, self)), alloc-vector(0.00, 1.00, 0.00, 1.00, 0), negf(get-float(angle-increment, self))));
                            debug-draw-string(
                                get-object-position(get-symbol(current-object, self)),
                                float-to-string(get-angle-between-quats(get-spawner-rotation(get-symbol(current-object, self), 1), get-object-rotation(get-symbol(current-object, self))), 1),
                                3,
                                get-float(button-repeat-delay, self),
                                1,
                                1.00,
                                0,
                                0
                            );
                            set-boolean(button-delay-active, 1, self);
                            start-timer(button-repeat-timer, get-float(button-repeat-delay, self), self, 1);
                        }
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(aim, 0) && debug-joypad-command-active?(fire-hold, 0)) {
                        if (debug-joypad-command-active?(menu-left, 0)) {
                            send-event(change-demeanor, self, new-boxed-value(2, 0));
                        }
                        if (debug-joypad-command-active?(menu-right, 0)) {
                            send-event(change-demeanor, self, new-boxed-value(2, 1));
                        }
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(aim, 0) && debug-joypad-command-active?(fire-hold, 0)) {
                        if (debug-joypad-command-active?(menu-up, 0)) {
                            send-event(change-speed, self, new-boxed-value(2, 1));
                        }
                        if (debug-joypad-command-active?(menu-down, 0)) {
                            send-event(change-speed, self, new-boxed-value(2, 0));
                        }
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(interact, 0) && !debug-joypad-command-active?(fire-hold, 0)) {
                        send-event(change-weapon-hold, self);
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(crouch-press, 0)) {
                        send-event(change-strafe, self);
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(melee-attack, 0) && !debug-joypad-command-active?(fire-hold, 0)) {
                        send-event(help-toggle, self);
                    }
                }
            }
        }
        block event move {
            track main {
                lambda {
                    if (event-arg-boolean(0) == 1) {
                        issue-teleport(get-object-locator(get-symbol(position-end, self)));
                        wait(0.40);
                        issue-move-performance-speed(
                            0,
                            get-object-locator-remove-binding(get-symbol(position-start, self)),
                            1,
                            get-int32(speed-pointer, self),
                            get-int32(demeanor-pointer, self)
                        );
                    } else {
                        issue-teleport(get-object-locator(get-symbol(position-start, self)));
                        wait(0.40);
                        issue-move-performance-speed(
                            0,
                            get-object-locator-remove-binding(get-symbol(position-end, self)),
                            1,
                            get-int32(speed-pointer, self),
                            get-int32(demeanor-pointer, self)
                        );
                    }
                }
            }
        }
        block event help-toggle {
            track main {
                lambda {
                    if (get-boolean(draw-help?, self)) {
                        set-boolean(draw-help?, 0, self);
                    } else {
                        set-boolean(draw-help?, 1, self);
                    }
                }
            }
        }
        block event change-demeanor {
            track main {
                lambda {
                    if (entity-exists?(get-symbol(active-npc, self))) {
                        if (event-arg-int32(0) == 0) {
                            ++(demeanor-pointer, self);
                        } else {
                            --(demeanor-pointer, self);
                        }
                        if (get-int32(demeanor-pointer, self) > 6) {
                            set-int32(demeanor-pointer, 0, self);
                        } else if (get-int32(demeanor-pointer, self) < 0) {
                            set-int32(demeanor-pointer, 6, self);
                        }
                        update-npc-demeanor();
                    } else {
                        debug-draw-text-box-2D(
                            "Spawn npc first!",
                            60,
                            340.00,
                            60.00,
                            1.00,
                            1,
                            0,
                            1,
                            1.00
                        );
                    }
                }
            }
        }
        block event change-speed {
            track main {
                lambda {
                    if (event-arg-int32(0) == 1) {
                        ++(speed-pointer, self);
                    } else {
                        --(speed-pointer, self);
                    }
                }
                lambda {
                    if (get-int32(speed-pointer, self) > 3) {
                        set-int32(speed-pointer, 0, self);
                    } else if (get-int32(speed-pointer, self) < 0) {
                        set-int32(speed-pointer, 3, self);
                    }
                }
                lambda {
                    if (get-int32(speed-pointer, self) == 0) {
                        set-int32(speed-enum, 0, self);
                    } else if (get-int32(speed-pointer, self) == 1) {
                        set-int32(speed-enum, 1, self);
                    } else if (get-int32(speed-pointer, self) == 2) {
                        set-int32(speed-enum, 2, self);
                    } else if (get-int32(speed-pointer, self) == 3) {
                        set-int32(speed-enum, 3, self);
                    }
                }
            }
        }
        block event change-weapon-hold {
            track main {
                lambda {
                    if (entity-exists?(get-symbol(active-npc, self))) {
                        if (get-boolean(weapon-up?, self)) {
                            npc-weapon-down(get-symbol(active-npc, self));
                            set-boolean(weapon-up?, 0, self);
                        } else {
                            npc-weapon-up(get-symbol(active-npc, self));
                            set-boolean(weapon-up?, 1, self);
                        }
                    } else {
                        debug-draw-text-box-2D(
                            "Spawn npc first!",
                            60,
                            340.00,
                            60.00,
                            1.00,
                            1,
                            0,
                            1,
                            1.00
                        );
                    }
                }
            }
        }
        block event change-strafe {
            track main {
                lambda {
                    if (entity-exists?(get-symbol(active-npc, self))) {
                        if (get-boolean(strafe?, self)) {
                            set-boolean(strafe?, 0, self);
                        } else {
                            set-boolean(strafe?, 1, self);
                        }
                    } else {
                        debug-draw-text-box-2D(
                            "Spawn npc first!",
                            60,
                            340.00,
                            60.00,
                            1.00,
                            1,
                            0,
                            1,
                            1.00
                        );
                    }
                }
            }
        }
        block event selection-active {
            track main {
                lambda {
                    u64? var_4 = kick-raycast(camera-locator(1), offset-locator(camera-locator(1), alloc-vector(0.00, 0.00, 35.00, 1.00, 0)), 0, 4099);
                    wait-one-frame();
                    if (wait-raycast-hit-nothing?(var_4)) {}
 else {
                        set-bound-frame(active-region-locator, wait-raycast(var_4), self);
                        debug-draw-sphere(get-locator-position(get-bound-frame(active-region-locator, self)), 0.25, 3, 0.00, 0, 0);
                        if (debug-joypad-command-active?(jump, 0)) {
                            u64? var_13 = select-activity(get-bound-frame(active-region-locator, self), wait-raycast-get-object(var_4));
                            if (!(var_13 == 0)) {
                                var_14 = set-symbol(activity, var_13, self);
                            }
                        }
                    }
                }
            }
        }
        block event npc-group-menu-confirmed {
            track main {
                lambda {
                    if (!(get-symbol(active-npc-selection, self) == select-npc-to-spawn)) {
                        spawn-test-npc(get-symbol(active-npc-selection, self));
                    }
                }
            }
        }
        block event mp-group-menu-confirmed {
            track main {
                lambda {
                    if (!(get-symbol(active-mp-selection, self) == select-a-move-performance)) {
                        debug-draw-locator(get-spawner-locator(get-symbol(active-mp-selection, self), 1), 2.00, 2.00, 0, 2.00, 0);
                        select-activity(get-spawner-locator(get-symbol(active-mp-selection, self), 1), 0);
                    }
                }
            }
        }
        block event weapon-group-menu-confirmed {
            track main {
                lambda {
                    if (get-symbol(active-weapon-selection, self) == no-weapon) {
                        npc-holster-weapon(get-symbol(active-npc, self), 0, 1, -1.00, 0);
                    }
                }
                lambda {
                    if (get-symbol(active-weapon-selection, self) == primary-weapon) {
                        npc-draw-pistol(get-symbol(active-npc, self), 2, -1.00, 0);
                        npc-unholster-weapon(get-symbol(active-npc, self), 0, -1.00, 0);
                    }
                }
                lambda {
                    if (get-symbol(active-weapon-selection, self) == secondary-weapon) {
                        npc-draw-long-gun(get-symbol(active-npc, self), 2, -1.00, 0);
                        npc-unholster-weapon(get-symbol(active-npc, self), 0, -1.00, 0);
                    }
                }
                lambda {
                    if (get-symbol(active-weapon-selection, self) == melee-weapon) {
                        npc-request-melee-weapon(get-symbol(active-npc, self));
                        npc-unholster-weapon(get-symbol(active-npc, self), 0, -1.00, 0);
                    }
                }
            }
        }
        block event button-repeat-timer {
            track main {
                lambda {
                    set-boolean(button-delay-active, 0, self);
                }
            }
        }
    }
}
