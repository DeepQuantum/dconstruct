statescript {
    options {
        player
    }
    declarations {
        f32 top-menu-y-start = 20.00
        f32 top-menu-x-start = 500.00
        f32 console-y-start = 500.00
        bool draw-help? = nullptr
        i32 demeanor-pointer = 1
        i32 speed-pointer = 1
        i32 speed-enum = 1
        i32 mt-pointer = 0
        symbol mt-value = #0000000000000000
        bool strafe? = nullptr
        bool weapon-up? = nullptr
        symbol activity = rgn-1
        symbol goal-1 = pos-1
        symbol goal-2 = pos-2
        bool plant-move? = nullptr
        bool change-speed? = nullptr
        bool change-facing? = nullptr
        bool entry-move? = nullptr
        bool spline-move? = nullptr
        bool cover-move? = nullptr
        symbol entry-anim = #0000000000000000
        bound-frame active-region-locator = nullptr
        symbol goals-array = #0000000000000000
        symbol goals-array-reversed = #0000000000000000
        symbol active-npc = #0000000000000000
        bool player? = nullptr
        i32 player-speed-enum = 1
        symbol current-object = #0000000000000000
        f32 angle-increment = 5.62
        f32 button-repeat-delay = 0.15
        timer button-repeat-timer = nullptr
        bool button-delay-active = nullptr
        bound-frame facing-point = nullptr
        bool active-facing-point = nullptr
        symbol active-npc-selection = select-npc-to-spawn
        symbol active-weapon-selection = no-weapon
        symbol active-demeanor-selection = ambient
        symbol active-mt-subcat-selection = default
    }
    state initial {
        block  {
        }
        block update {
            track main {
                lambda {
                    player-disable-grab-melee-moves();
                }
                lambda {
                    draw-demeanor-caption();
                }
                lambda {
                    draw-speed-caption();
                }
                lambda {
                    draw-weapon-hold-caption();
                }
                lambda {
                    draw-strafe-caption();
                }
                lambda {
                    draw-mt-caption();
                }
                lambda {
                    draw-help();
                }
                lambda {
                    draw-crosshair();
                }
                lambda {
                    draw-facing-point();
                }
                lambda {
                    if (debug-mouse-click-l() || debug-mouse-click-r() && debug-mouse-click-m()) {
                        send-event(mouse-click, self);
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(fire-hold, 0)) {
                        send-event(selection-active, self);
                        debug-draw-string-2d(
                            alloc-point(get-float(top-menu-x-start, self) + -20.00, get-float(top-menu-y-start, self), 0.00, 0),
                            "Spawn NPC: ",
                            3,
                            0.00,
                            0.60,
                            0,
                            0,
