        0    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 40.00, -4.00, 0),
            "Motion Type: default",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        ),
        1    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 40.00, -4.00, 0),
            "Motion Type: panic",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        ),
        2    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 40.00, -4.00, 0),
            "Motion Type: approach",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        ),
        3    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 40.00, -4.00, 0),
            "Motion Type: injured",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        ),
        4    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 40.00, -4.00, 0),
            "Motion Type: grass",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        ),
        5    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 40.00, -4.00, 0),
            "Motion Type: melee-outer",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        ),
        6    -> debug-draw-string-2d(
            alloc-point(1000.00, get-float(console-y-start, self) + 40.00, -4.00, 0),
            "Motion Type: door-kick",
            3,
            0.00,
            0.50,
            0,
            0,
            0,
            1.00
        ),
        else -> 0
    };
}

u16 draw-facing-point() {
    u16 var_1;
    if (get-boolean(active-facing-point, self)) {
        if (!(get-symbol(active-npc, self) == 0)) {
            if (valid-bound-frame?(get-bound-frame(facing-point, self))) {
                debug-draw-sphere(get-locator-position(get-bound-frame(facing-point, self)), 0.10, 7, 0.00, 0, 1);
                var_1 = debug-draw-line(
                    get-object-position(get-symbol(active-npc, self)),
                    get-locator-position(offset-locator(rotate-locator-lookat(get-object-locator(get-symbol(active-npc, self)), get-bound-frame(facing-point, self), 1.00, 0), alloc-vector(0.00, 0.00, 2.00, 1.00, 0))),
                    7,
                    7,
                    0.00,
                    0,
                    1.00,
                    0,
                    0,
                    0
                );
            } else {
                var_1 = 0;
            }
        } else {
            var_1 = 0;
        }
    } else {
        var_1 = 0;
    }
    return var_1;
}

statescript {
    options {
        player
    }
    declarations {
        f32 top-menu-y-start = 20.00
        f32 top-menu-x-start = 800.00
        f32 console-y-start = 500.00
        bool draw-help? = nullptr
        i32 demeanor-pointer = 1
        i32 speed-pointer = 1
        i32 speed-enum = 1
        i32 mt-pointer = 0
        symbol mt-value = #0000000000000000
        bool strafe? = nullptr
        bool weapon-up? = nullptr
        symbol activity = nullptr
        symbol goal-1 = pos-1
        symbol goal-2 = pos-2
        symbol platform-start = vault-platform-start-1
        symbol platform-end = vault-platform-end-1
        bool sync-move? = nullptr
        bound-frame active-region-locator = nullptr
        symbol goals-array = #0000000000000000
        symbol goals-array-reversed = #0000000000000000
        symbol active-npc = #0000000000000000
        symbol active-slave-npc = #0000000000000000
        bool player? = nullptr
        i32 player-speed-enum = 1
        symbol current-object = nullptr
        f32 angle-increment = 5.62
        f32 button-repeat-delay = 0.15
        timer button-repeat-timer = nullptr
        bool button-delay-active = nullptr
        bound-frame facing-point = nullptr
        bool active-facing-point = nullptr
        symbol active-npc-selection = select-npc-to-spawn
        symbol active-platform = vault-platform-start-1
        symbol tap-type = nullptr
        f32 wall-height = 1.00
        vector vault-offset = (0.00, 0.00, 0.25, 1.00)
        vector vault-start-platform-offset = (0.00, 0.00, 0.00, 1.00)
        vector vault-end-platform-offset = (0.00, 0.00, 0.00, 1.00)
        f32 jump-height = 1.00
        vector jump-offset = (0.00, -1.00, 0.00, 1.00)
        f32 height-increment = 0.10
    }
    state initial {
        block  {
        }
        block update {
            track main {
                lambda {
                    player-disable-grab-melee-moves();
                }
                lambda {
                    draw-demeanor-caption();
                }
                lambda {
                    draw-speed-caption();
                }
                lambda {
                    draw-weapon-hold-caption();
                }
                lambda {
                    draw-strafe-caption();
                }
                lambda {
                    draw-mt-caption();
                }
                lambda {
                    draw-tap-help();
                }
                lambda {
                    draw-crosshair();
                }
                lambda {
                    draw-facing-point();
                }
                lambda {
                    if (get-symbol(active-npc, self) == 0 && !debug-joypad-command-active?(fire-hold, 0)) {
                        debug-draw-text-box-2D(
                            "Hold R2 to display the NPC spawn menu",
                            60,
                            340.00,
                            60.00,
                            1.00,
                            1,
                            0,
                            1,
                            0.00
                        );
                    }
                }
                lambda {
                    if (get-symbol(activity, self) == 0 && !debug-joypad-command-active?(fire-hold, 0)) {
                        debug-draw-text-box-2D(
                            "Hold R2 to activate a selection mode and select your activity",
                            60,
                            340.00,
                            120.00,
                            1.00,
                            1,
                            0,
                            1,
                            0.00
                        );
                    }
                }
                lambda {
                    if (debug-mouse-click-l() || debug-mouse-click-r() && debug-mouse-click-m()) {
                        send-event(mouse-click, self);
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(fire-hold, 0)) {
                        send-event(selection-active, self);
                        set-symbol(active-npc-selection, hud-debug-group-menu(
                            character-group,
                            get-symbol(active-npc-selection, self),
                            alloc-point(get-float(top-menu-x-start, self), get-float(top-menu-y-start, self), 0.00, 0),
                            alloc-vector(-14.00, 6.00, 0.00, 1.00, 0),
                            npc-group-menu-confirmed,
                            npc-debug-group-menu-updated,
                            0.60,
                            "triangle",
                            8.00
                        ), self);
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(jump, 0) && !debug-joypad-command-active?(fire-hold, 0)) {
                        if (debug-joypad-command-active?(aim, 0)) {
                            send-event(move, self, new-boxed-value(1, 1));
                        } else {
                            send-event(move, self, new-boxed-value(1, 0));
                        }
                    }
                }
                lambda {
                    if (!debug-joypad-command-active?(fire-hold, 0) && !debug-joypad-command-active?(interact-hold, 0) && debug-joypad-command-active?(aim, 0) && !(get-symbol(current-object, self) == 0) || get-symbol(current-object, self) == get-symbol(platform-start, self) && get-symbol(current-object, self) == get-symbol(platform-end, self)) {
                        if (debug-joypad-command-active?(menu-up, 0)) {
