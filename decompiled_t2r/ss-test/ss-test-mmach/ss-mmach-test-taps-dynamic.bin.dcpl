                            if (get-symbol(tap-type, self) == vault) {
                                if (get-symbol(current-object, self) == get-symbol(platform-start, self)) {
                                    set-vector(vault-start-platform-offset, vector-add(get-vector(vault-start-platform-offset, self), alloc-vector(0.00, get-float(height-increment, self), 0.00, 1.00, 0)), self);
                                } else {
