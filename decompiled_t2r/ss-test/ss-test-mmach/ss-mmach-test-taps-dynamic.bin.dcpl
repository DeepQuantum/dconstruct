                                }
                                update-vault-tap-params(get-vector(vault-start-platform-offset, self), get-vector(vault-end-platform-offset, self), vault-offset, wall-height, 1.00);
                                set-var-tap-offset-ls(tap-vault-1, get-vector(vault-offset, self));
