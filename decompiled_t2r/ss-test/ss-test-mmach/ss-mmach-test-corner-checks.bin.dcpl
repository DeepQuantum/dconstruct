    state initial {
        block start {
            track main {
                lambda {
                    player-remove-weapons();
                }
                lambda {
                    fatigue-disable();
                }
            }
        }
        block update {
            track main {
                lambda {
                    draw-help();
                }
                lambda {
                    draw-demeanor-caption(get-int32(demeanor-pointer, self), 1000.00, get-float(console-y-start, self) + 0.00);
                }
                lambda {
                    draw-speed-caption(get-int32(speed-pointer, self), 1000.00, get-float(console-y-start, self) + 10.00);
                }
                lambda {
                    draw-weapon-hold-caption();
                }
                lambda {
                    draw-idle-exit-caption();
                }
                lambda {
                    draw-corner-check-dir-caption(get-symbol(position-start, self), get-symbol(pivot-start, self), start);
                }
                lambda {
                    draw-corner-check-dir-caption(get-symbol(position-end, self), get-symbol(pivot-end, self), end);
                }
