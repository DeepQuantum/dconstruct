                        send-event(start-moving, self);
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(fire-hold, 0) && !debug-joypad-command-active?(aim, 0)) {
                        if (debug-joypad-command-active?(menu-left, 0)) {
                            set-int32(angle-end, get-int32(angle-end, self) - 10, self);
                            set-object-locator(get-symbol(pivot-end, self), rotate-locator-angle(get-object-locator-default-rotation(get-symbol(pivot-end, self)), 1, (f32)get-int32(angle-end, self)));
