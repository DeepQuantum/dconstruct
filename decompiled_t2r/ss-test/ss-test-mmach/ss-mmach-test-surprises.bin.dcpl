statescript {
    options {
        player
    }
    declarations {
        f32 top-menu-y-start = 20.00
        f32 top-menu-x-start = 800.00
        f32 console-y-start = 550.00
        f32 console-x-start = 920.00
        f32 values-x-start = 1110.00
        i32 angle-start-pointer = 0
        i32 angle-end-pointer = 0
        i32 angle-start = 0
        i32 angle-end = 0
        i32 demeanor-pointer = 0
        i32 speed-pointer = 0
        i32 speed-enum = 0
        bool strafe? = nullptr
        bool weapon-up? = true
        bool seen? = nullptr
        i32 weapon-id = 0
        bool draw-help? = nullptr
        symbol active-attachable = #0000000000000000
        symbol pivot-start = pivot-start-1
        symbol pivot-end = pivot-end-1
        symbol position-start = position-start-1
        symbol position-end = position-end-1
        symbol activity = rgn-1
        symbol active-npc = nullptr
        bound-frame active-region-locator = nullptr
        bool allow-sleep? = nullptr
        bool strong-surprises? = nullptr
        symbol active-npc-selection = select-npc-to-spawn
    }
    state initial {
        block start {
            track main {
                lambda {
                    give-player-weapon(bottle, 1, 0);
                }
                lambda {
                    fatigue-disable();
                }
            }
        }
        block update {
            track main {
                lambda {
                    draw-help();
                }
                lambda {
                    draw-crosshair();
                }
                lambda {
                    draw-demeanor-caption();
                }
                lambda {
                    draw-weapon-hold-caption();
                }
                lambda {
                    draw-sleep-caption();
                }
                lambda {
                    draw-surprises-type-caption();
                }
                lambda {
                    if (get-symbol(active-npc, self) == 0 && !debug-joypad-command-active?(fire-hold, 0)) {
                        debug-draw-text-box-2D(
                            "Hold R2 to display a NPC spawn menu",
                            60,
                            340.00,
                            60.00,
                            1.00,
                            1,
                            0,
                            1,
                            0.00
                        );
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(fire-hold, 0)) {
                        send-event(selection-active, self);
                        set-symbol(active-npc-selection, hud-debug-group-menu(
                            character-group,
                            get-symbol(active-npc-selection, self),
                            alloc-point(get-float(top-menu-x-start, self), get-float(top-menu-y-start, self), 0.00, 0),
                            alloc-vector(-14.00, 6.00, 0.00, 1.00, 0),
                            npc-group-menu-confirmed,
                            npc-debug-group-menu-updated,
                            0.60,
                            "triangle",
                            8.00
                        ), self);
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(jump, 0) && !debug-joypad-command-active?(fire-hold, 0)) {
                        send-event(ping-distraction, self, new-boxed-value(1, 0));
                    }
                }
                lambda {
                    if (debug-mouse-click-l() || debug-mouse-click-r() && debug-mouse-click-m()) {
                        send-event(ping-distraction, self, new-boxed-value(1, 1));
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(aim, 0) && debug-joypad-command-active?(fire-hold, 0)) {
                        if (debug-joypad-command-active?(menu-left, 0)) {
                            send-event(change-demeanor, self, new-boxed-value(2, 0));
                        }
                        if (debug-joypad-command-active?(menu-right, 0)) {
                            send-event(change-demeanor, self, new-boxed-value(2, 1));
                        }
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(aim, 0) && debug-joypad-command-active?(fire-hold, 0)) {
                        if (debug-joypad-command-active?(menu-up, 0)) {
                            send-event(change-sleep, self, new-boxed-value(2, 0));
                        }
                        if (debug-joypad-command-active?(menu-down, 0)) {
                            send-event(change-sleep, self, new-boxed-value(2, 1));
                        }
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(interact, 0) && !debug-joypad-command-active?(fire-hold, 0)) {
                        send-event(change-weapon-hold, self);
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(aim, 0) && !debug-joypad-command-active?(fire-hold, 0) || debug-joypad-command-active?(menu-left, 0)) {
                        if (debug-joypad-command-active?(menu-right, 0)) {
                            send-event(change-surprises, self);
                        }
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(fire-hold, 0) && debug-joypad-command-active?(crouch-press, 0)) {
                        give-player-weapon(bottle, 1, 0);
                        send-event(reset-npc, self);
                    }
                }
                lambda {
                    if (debug-joypad-command-active?(melee-attack, 0)) {
                        send-event(help-toggle, self);
                    }
                }
            }
        }
        block event start-moving {
            track main {
                lambda {
                    if (entity-exists?(get-symbol(active-npc, self))) {
                        if (get-int32(demeanor-pointer, self) == 0) {
                            npc-set-demeanor(get-symbol(active-npc, self), 5, 1);
                        } else if (get-int32(demeanor-pointer, self) == 1) {
                            npc-set-demeanor(get-symbol(active-npc, self), 2, 1);
                        } else if (get-int32(demeanor-pointer, self) == 2) {
                            npc-set-demeanor(get-symbol(active-npc, self), 3, 1);
                        } else if (get-int32(demeanor-pointer, self) == 3) {
                            npc-set-demeanor(get-symbol(active-npc, self), 1, 1);
                        } else if (get-int32(demeanor-pointer, self) == 4) {
                            npc-set-demeanor(get-symbol(active-npc, self), 4, 1);
                        } else if (get-int32(demeanor-pointer, self) == 5) {
                            npc-set-demeanor(get-symbol(active-npc, self), 0, 1);
                        }
                        npc-clear-request-movement(get-symbol(active-npc, self));
                        npc-stop(get-symbol(active-npc, self));
                        npc-teleport-to(get-symbol(active-npc, self), get-object-locator-remove-binding(get-symbol(position-start, self)));
                        wait(0.30);
                        wait-npc-corner-check-c(
                            get-symbol(active-npc, self),
                            get-object-locator(get-symbol(pivot-start, self)),
                            get-object-locator-remove-binding(get-symbol(position-end, self)),
                            get-int32(speed-enum, self),
                            6
                        );
                        npc-move-to(
                            get-symbol(active-npc, self),
                            get-object-locator-remove-binding(get-symbol(position-end, self)),
                            get-int32(speed-enum, self),
                            0,
                            0,
                            0,
                            0,
                            0
                        );
                    }
                }
            }
        }
        block event change-weapon-hold {
            track main {
                lambda {
                    if (entity-exists?(get-symbol(active-npc, self))) {
                        set-boolean(weapon-up?, abs(get-boolean(weapon-up?, self) - 1), self);
                        if (get-int32(demeanor-pointer, self) == 1) {
                            npc-holster-weapon(get-symbol(active-npc, self), 2, get-boolean(weapon-up?, self), -1.00, 0);
                        } else {
                            npc-holster-weapon(get-symbol(active-npc, self), 1, get-boolean(weapon-up?, self), -1.00, 0);
                        }
                    } else {
                        debug-draw-text-box-2D(
                            "Spawn npc first!",
                            60,
                            340.00,
                            60.00,
                            1.00,
                            1,
                            0,
                            1,
                            1.00
                        );
                    }
                }
            }
        }
        block event change-weapon {
            track main {
                lambda {
                    if (entity-exists?(get-symbol(active-npc, self))) {
                        if (!(get-symbol(active-attachable, self) == 0)) {
                            kill-entity(get-symbol(active-attachable, self));
                            set-symbol(active-attachable, 0, self);
                        }
                        if (event-arg-int32(0) == 1) {
                            ++(weapon-id, self);
                        } else {
                            --(weapon-id, self);
                        }
                        if (get-int32(weapon-id, self) > 4) {
                            set-int32(weapon-id, 0, self);
                        } else if (get-int32(weapon-id, self) < 0) {
                            set-int32(weapon-id, 4, self);
                        }
                        if (get-int32(weapon-id, self) == 0) {
                            npc-holster-weapon(get-symbol(active-npc, self), 4, 1, -1.00, 0);
                            npc-destroy-weapon(get-symbol(active-npc, self));
                        } else if (get-int32(weapon-id, self) == 1) {
                            npc-give-weapon(get-symbol(active-npc, self), pistol-basic, 200, 1);
                        } else if (get-int32(weapon-id, self) == 2) {
                            npc-give-weapon(get-symbol(active-npc, self), shotgun, 200, 1);
                        } else if (get-int32(weapon-id, self) == 3) {
                            npc-destroy-weapon(get-symbol(active-npc, self));
                            set-symbol(active-attachable, spawn-attachable("waiter-tablet", get-symbol(active-npc, self), "rightHand", 0, 0), self);
                        } else if (get-int32(weapon-id, self) == 4) {
                            npc-destroy-weapon(get-symbol(active-npc, self));
                            set-symbol(active-attachable, spawn-attachable("toolbox", get-symbol(active-npc, self), "leftHand", 0, 0), self);
                        }
                    }
                }
            }
        }
        block event change-demeanor {
            track main {
                lambda {
                    if (entity-exists?(get-symbol(active-npc, self))) {
                        if (event-arg-int32(0) == 1) {
                            ++(demeanor-pointer, self);
                        } else {
                            --(demeanor-pointer, self);
                        }
                        if (get-int32(demeanor-pointer, self) > 2) {
                            set-int32(demeanor-pointer, 0, self);
                        } else if (get-int32(demeanor-pointer, self) < 0) {
                            set-int32(demeanor-pointer, 2, self);
                        }
                        update-npc-demeanor();
                        send-event(reset-npc, self);
                    } else {
                        debug-draw-text-box-2D(
                            "Spawn npc first!",
                            60,
                            340.00,
                            60.00,
                            1.00,
                            1,
                            0,
                            1,
                            1.00
                        );
                    }
                }
            }
        }
        block event change-sleep {
            track main {
                lambda {
                    if (entity-exists?(get-symbol(active-npc, self))) {
                        if (get-boolean(allow-sleep?, self)) {
                            set-boolean(allow-sleep?, 0, self);
                        } else {
                            set-boolean(allow-sleep?, 1, self);
                        }
                        send-event(reset-npc, self);
                    } else {
                        debug-draw-text-box-2D(
                            "Spawn npc first!",
                            60,
                            340.00,
                            60.00,
                            1.00,
                            1,
                            0,
                            1,
                            1.00
                        );
                    }
                }
            }
        }
        block event help-toggle {
            track main {
                lambda {
                    if (get-boolean(draw-help?, self)) {
                        set-boolean(draw-help?, 0, self);
                    } else {
                        set-boolean(draw-help?, 1, self);
                    }
                }
            }
        }
        block event change-surprises {
            track main {
                lambda {
                    if (get-boolean(strong-surprises?, self)) {
                        set-boolean(strong-surprises?, 0, self);
                    } else {
                        set-boolean(strong-surprises?, 1, self);
                    }
                }
            }
        }
        block event change-speed {
            track main {
                lambda {
                    if (event-arg-int32(0) == 1) {
                        ++(speed-pointer, self);
                    } else {
                        --(speed-pointer, self);
                    }
                }
                lambda {
                    if (get-int32(speed-pointer, self) > 3) {
                        set-int32(speed-pointer, 0, self);
                    } else if (get-int32(speed-pointer, self) < 0) {
                        set-int32(speed-pointer, 3, self);
                    }
                }
                lambda {
                    if (get-int32(speed-pointer, self) == 0) {
                        set-int32(speed-enum, 0, self);
                    } else if (get-int32(speed-pointer, self) == 1) {
                        set-int32(speed-enum, 1, self);
                    } else if (get-int32(speed-pointer, self) == 2) {
                        set-int32(speed-enum, 2, self);
                    } else if (get-int32(speed-pointer, self) == 3) {
                        set-int32(speed-enum, 3, self);
                    }
                }
            }
        }
        block event selection-active {
            track main {
                lambda {
                    u64? var_4 = kick-raycast(camera-locator(1), offset-locator(camera-locator(1), alloc-vector(0.00, 0.00, 35.00, 1.00, 0)), 0, 4097);
                    wait-one-frame();
                    if (wait-raycast-hit-nothing?(var_4)) {}
 else {
                        set-bound-frame(active-region-locator, wait-raycast(var_4), self);
                        debug-draw-sphere(get-locator-position(get-bound-frame(active-region-locator, self)), 0.25, 3, 0.00, 0, 0);
                        u64? var_11 = select-activity(get-bound-frame(active-region-locator, self));
                        if (!(var_11 == 0)) {
                            var_12 = set-symbol(activity, var_11, self);
                        }
                    }
                }
            }
        }
        block event ping-distraction {
            track main {
                lambda {
                    u64? var_6;
                    if (event-arg-boolean(0) == 1) {
                        var_6 = rotate-locator-angle(rotate-locator-angle(camera-locator(1), 1, (camera-get-fov-degrees() * 0.50) * (1.00 - (*(f32*)debug-mouse-pos(0) / (*(f32*)get-screen-size(0) * 0.50)))), 0, ((camera-get-fov-degrees() * 0.50) * ((*(f32*)(debug-mouse-pos(0) + 4) / (*(f32*)(get-screen-size(0) + 4) * 0.50)) - 1.00)) / (*(f32*)get-screen-size(0) / *(f32*)(get-screen-size(0) + 4)));
                    }
                    u64? var_18 = kick-raycast(camera-locator(1), offset-locator(var_6, alloc-vector(0.00, 0.00, 70.00, 1.00, 0)), 0, 4097);
                    wait-one-frame();
                    identity-bound-frame();
                    if (wait-raycast-hit-nothing?(var_18)) {}
 else {
                        u64? var_21 = wait-raycast(var_18);
                        debug-draw-sphere(get-locator-position(var_21), 0.25, 3, 1.00, 0, 0);
                        if (get-boolean(strong-surprises?, self)) {
                            send-event(teleport-player, player, new-boxed-value(18, var_21));
                            audio-gameplay-event(weapon-fire, get-locator-position(var_21), player);
                        } else {
                            npc-ping-distraction-at(get-symbol(active-npc, self), get-locator-position(var_21), get-boolean(seen?, self));
                        }
                    }
                }
            }
        }
        block event reset-npc {
            track main {
                lambda {
                    if (!(active-npc == 0)) {
                        spawn-test-npc(get-symbol(active-npc, self));
                        if (get-boolean(strong-surprises?, self)) {
                            send-event(teleport-player, player, new-boxed-value(18, get-spawner-locator(cp-1, 1)));
                        }
                        wait(0.50);
                    }
                }
            }
        }
        block event npc-group-menu-confirmed {
            track main {
                lambda {
                    if (!(get-symbol(active-npc-selection, self) == select-npc-to-spawn)) {
                        spawn-test-npc(get-symbol(active-npc-selection, self));
                    }
                }
            }
        }
    }
}
