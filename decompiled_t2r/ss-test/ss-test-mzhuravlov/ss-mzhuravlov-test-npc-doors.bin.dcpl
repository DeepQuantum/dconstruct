u64? spawn-test-npc() {
    if (get-symbol(active-npc, self) == npc-main-01) {
        npc-kill(get-symbol(active-npc, self));
        wait-one-frame();
        spawn-npc(npc-dog-1, 0, 0);
        set-symbol(active-npc, npc-dog-1, self);
    } else {
        npc-kill(get-symbol(active-npc, self));
        wait-one-frame();
        spawn-npc(npc-main-01, 0, 0);
        set-symbol(active-npc, npc-main-01, self);
    }
    npc-set-script-only-no-perception(get-symbol(active-npc, self));
    return update-npc-demeanor();
}

