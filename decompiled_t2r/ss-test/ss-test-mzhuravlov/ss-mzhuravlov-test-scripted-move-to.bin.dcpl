    state combat-door {
        block start {
            track main {
                lambda {
                    set-boolean(return-to-pos, 0, self);
                }
                lambda {
                    set-int32(cur-weapon, fact-lookup-int(fact-get-dictionary(player), weapon-type, 1), self);
                }
                lambda {
                    if (get-weapon-def-id(get-weapon-id(player, -1)) == bow-ellie && get-int32(cur-weapon, self) == 2) {
                        set-string(door-open-hand, "right", self);
                    } else if (get-int32(cur-weapon, self) == 0 && get-int32(cur-weapon, self) == 2) {
                        set-string(door-open-hand, "any", self);
                    } else {
                        set-string(door-open-hand, "left", self);
                    }
                }
                lambda {
                    debug-draw-string-2d(
                        alloc-point(300.00, 300.00, 0.00, 0),
                        "Door open hand based on weapon:",
                        3,
                        2.00,
                        0.60,
                        0,
                        0,
                        0,
                        1.00
                    );
                }
                lambda {
                    debug-draw-string-2d(
                        alloc-point(300.00, 320.00, 0.00, 0),
                        get-string(door-open-hand, self),
                        3,
                        2.00,
                        0.60,
                        0,
                        0,
                        0,
                        1.00
                    );
                }
                lambda {
                    set-bound-frame(goal, get-joint-locator(door-right-latch-combat-1, handle), self);
                }
                lambda {
                    set-bound-frame(goal, rotate-locator-angle(get-bound-frame(goal, self), 1, 180.00), self);
                }
                lambda {
                    debug-draw-locator(get-bound-frame(goal, self), 0.50, 0.00, 1, 1.00, 0);
                }
                lambda {
                    set-float(door-angle, angle-in-between-locators-plus(get-bound-frame(goal, self), get-object-locator(player), 2, 0), self);
                }
                lambda {
                    print-float(get-float(door-angle, self), self);
                }
                lambda {
                    if (get-float(door-angle, self) > 45.00) {
                        set-string(door-open-facing, "right", self);
                    } else if (get-float(door-angle, self) < -45.00) {
                        set-string(door-open-facing, "left", self);
                    } else {
                        set-string(door-open-facing, "forward", self);
                    }
                }
                lambda {
                    debug-draw-string-2d(
                        alloc-point(300.00, 340.00, 0.00, 0),
                        "Door open closest facing detected:",
                        3,
                        2.00,
                        0.60,
                        0,
                        0,
                        0,
                        1.00
                    );
                }
                lambda {
                    debug-draw-string-2d(
                        alloc-point(300.00, 360.00, 0.00, 0),
                        get-string(door-open-facing, self),
                        3,
                        2.00,
                        0.60,
                        0,
                        0,
                        0,
                        1.00
                    );
                }
                lambda {
                    if (string-eq?(get-string(door-open-hand, self), "any")) {
                        if (string-eq?(get-string(door-open-facing, self), "forward")) {
                            if (get-float(door-angle, self) < 0.00) {
                                set-symbol(door-open-anim, ellie-tense-door-v3-right-open-push-right-hand^forward, self);
                            } else {
                                set-symbol(door-open-anim, ellie-tense-door-v3-right-open-push-left-hand^forward, self);
                            }
                        } else if (string-eq?(get-string(door-open-facing, self), "right")) {
                            set-symbol(door-open-anim, ellie-tense-door-v3-right-open-push-left-hand^90right, self);
                        } else if (string-eq?(get-string(door-open-facing, self), "left")) {
                            set-symbol(door-open-anim, ellie-tense-door-v3-right-open-push-right-hand^90left, self);
                        }
                    } else if (string-eq?(get-string(door-open-hand, self), "right")) {
                        if (string-eq?(get-string(door-open-facing, self), "forward")) {
                            set-symbol(door-open-anim, ellie-tense-door-v3-right-open-push-right-hand^forward, self);
                        } else if (string-eq?(get-string(door-open-facing, self), "right")) {
                            set-symbol(door-open-anim, ellie-tense-door-v3-right-open-push-right-hand^90right, self);
                        } else if (string-eq?(get-string(door-open-facing, self), "left")) {
                            set-symbol(door-open-anim, ellie-tense-door-v3-right-open-push-right-hand^90left, self);
                        }
                    } else if (string-eq?(get-string(door-open-hand, self), "left")) {
                        if (string-eq?(get-string(door-open-facing, self), "forward")) {
                            set-symbol(door-open-anim, ellie-tense-door-v3-right-open-push-left-hand^forward, self);
                        } else if (string-eq?(get-string(door-open-facing, self), "right")) {
                            set-symbol(door-open-anim, ellie-tense-door-v3-right-open-push-left-hand^90right, self);
                        } else if (string-eq?(get-string(door-open-facing, self), "left")) {
                            set-symbol(door-open-anim, ellie-tense-door-v3-right-open-push-left-hand^90left, self);
                        }
                    }
                }
                lambda {
                    if (get-symbol(door-open-anim, self) == ellie-tense-door-v3-right-open-push-left-hand^forward) {
                        set-float(abort-frame, 10.00, self);
                        set-string(door-open-hand, "left", self);
                    } else if (get-symbol(door-open-anim, self) == ellie-tense-door-v3-right-open-push-left-hand^90left) {
                        set-float(abort-frame, 10.00, self);
                        set-string(door-open-hand, "left", self);
                    } else if (get-symbol(door-open-anim, self) == ellie-tense-door-v3-right-open-push-left-hand^90right) {
                        set-float(abort-frame, 10.00, self);
                        set-string(door-open-hand, "left", self);
                    } else if (get-symbol(door-open-anim, self) == ellie-tense-door-v3-right-open-push-right-hand^forward) {
                        set-float(abort-frame, 10.00, self);
                        set-string(door-open-hand, "right", self);
                    } else if (get-symbol(door-open-anim, self) == ellie-tense-door-v3-right-open-push-right-hand^90left) {
                        set-float(abort-frame, 10.00, self);
                        set-string(door-open-hand, "right", self);
                    } else if (get-symbol(door-open-anim, self) == ellie-tense-door-v3-right-open-push-right-hand^90right) {
                        set-float(abort-frame, 10.00, self);
                        set-string(door-open-hand, "right", self);
                    }
                }
                lambda {
                    interactable-disable(interact-combat-door-1);
                }
                lambda {
                    set-bound-frame(path-goal, get-align-from-ap-ref(player, get-symbol(door-open-anim, self), get-object-locator(door-right-latch-combat-1), 0.00, apReference), self);
                }
                lambda {
                    debug-draw-locator(get-bound-frame(path-goal, self), 0.50, 0.00, 1, 1.00, 0);
                }
                lambda {
                    go(combat-door-opening, 1);
                }
            }
        }
    }
    state combat-door-opening {
        block start {
            track main {
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 2, 1);
                    *(i32*)*var_0[0] = 28;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(f32*)(*var_0[0] + 8) = 0.00;
                    *(i32*)*var_0[1] = 30;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 0.00;
                    animate_(door-right-latch-combat-1, t2-door-right-open-combat, var_0);
                }
                lambda {
                    u64? var_1 = #%alloc-array(single-frame, 16, 9, 1);
                    *(i32*)*var_1[0] = 28;
                    *(u64*)(*var_1[0] + 8) = 0;
                    *(f32*)(*var_1[0] + 8) = 0.50;
                    *(i32*)*var_1[1] = 27;
                    *(u64*)(*var_1[1] + 8) = 0;
                    *(u8*)(*var_1[1] + 8) = 4;
                    *(i32*)*var_1[2] = 45;
                    *(u64*)(*var_1[2] + 8) = 0;
                    *(f32*)(*var_1[2] + 8) = 0.50;
                    *(i32*)*var_1[3] = 30;
                    *(u64*)(*var_1[3] + 8) = 0;
                    *(f32*)(*var_1[3] + 8) = 0.40;
                    *(i32*)*var_1[4] = 29;
                    *(u64*)(*var_1[4] + 8) = 0;
                    *(u8*)(*var_1[4] + 8) = 4;
                    *(i32*)*var_1[5] = 46;
                    *(u64*)(*var_1[5] + 8) = 0;
                    *(f32*)(*var_1[5] + 8) = 0.20;
                    *(i32*)*var_1[6] = 70;
                    *(u64*)(*var_1[6] + 8) = 0;
                    *(i32*)(*var_1[6] + 8) = 10;
                    *(i32*)*var_1[7] = 10;
                    *(u64*)(*var_1[7] + 8) = 0;
                    *(u64*)(*var_1[7] + 8) = get-object-locator(door-right-latch-combat-1);
                    *(i32*)*var_1[8] = 24;
                    *(u64*)(*var_1[8] + 8) = 0;
                    u16 var_4;
                    if (get-boolean(is-crouch?, self)) {
                        var_4 = 18;
                    } else {
                        var_4 = 1;
                    }
                    *(i32*)(*var_1[8] + 8) = var_4;
                    animate_(player, get-symbol(door-open-anim, self), var_1);
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    go(combat-door-complete, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (get-joypad-stick-intensity(move, 0.20, 1.00) > 0.10 && get-animation-frame(player, 2, get-symbol(door-open-anim, self)) > get-float(abort-frame, self) && object-anim-playing?(player, get-symbol(door-open-anim, self), 0)) {
                        go(combat-door-early-exit, 1);
                    }
                }
                lambda {
                    if (get-joypad-stick-intensity(move, 0.20, 1.00) < 0.10 && get-animation-frame(player, 2, get-symbol(door-open-anim, self)) > (get-float(abort-frame, self) + 8.00) && object-anim-playing?(player, get-symbol(door-open-anim, self), 0) && get-boolean(return-to-pos, self)) {
                        go(combat-door-early-exit, 1);
                    }
                }
            }
        }
    }
    state combat-door-early-exit {
        block start {
            track main {
                lambda {
                    u64? var_1 = get-animation-phase(player, 2, get-symbol(door-open-anim, self));
                    print-float(var_1, self);
                    stop-animating(player, 0, 0.30, get-symbol(door-open-anim, self), 0);
                    u64? var_4 = #%alloc-array(single-frame, 16, 6, 1);
                    *(i32*)*var_4[0] = 58;
                    *(u64*)(*var_4[0] + 8) = 0;
                    *(f32*)(*var_4[0] + 8) = var_1;
                    *(i32*)*var_4[1] = 28;
                    *(u64*)(*var_4[1] + 8) = 0;
                    *(f32*)(*var_4[1] + 8) = 0.20;
                    *(i32*)*var_4[2] = 40;
                    *(u64*)(*var_4[2] + 8) = 0;
                    *(i32*)(*var_4[2] + 8) = 1;
                    *(i32*)*var_4[3] = 75;
                    *(u64*)(*var_4[3] + 8) = 0;
                    sid var_7;
                    if (string-eq?(get-string(door-open-hand, self), "right")) {
                        var_7 = *scav-drawer-exit-r-hand*;
                    } else {
                        var_7 = *scav-drawer-exit-l-hand*;
                    }
                    *(u64*)(*var_4[3] + 8) = var_7;
                    *(i32*)*var_4[4] = 20;
                    *(u64*)(*var_4[4] + 8) = 0;
                    *(f32*)(*var_4[4] + 8) = get-float(abort-frame, self) + 30.00;
                    *(i32*)*var_4[5] = 30;
                    *(u64*)(*var_4[5] + 8) = 0;
                    *(f32*)(*var_4[5] + 8) = 0.40;
                    animate_(player, get-symbol(door-open-anim, self), var_4);
                }
                lambda {
                    if (get-boolean(return-to-pos, self)) {
                        if (distance-between-locators-xz(get-object-locator(player), get-bound-frame(last-pos, self)) >= 0.90) {
                            player-scripted-move-new(get-bound-frame(last-pos, self), 1, *ellie-move-to-run-combat-door-tense*, 7, 0, 0);
                        } else {
                            player-scripted-move-new(get-bound-frame(last-pos, self), 1, *ellie-move-to-run-tense-door-smallstep*, 7, 0, 0);
                        }
                    }
                }
                lambda {
                    wait(2.00);
                }
                lambda {
                    go(combat-door-complete, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (get-joypad-stick-intensity(move, 0.20, 1.00) > 0.10 && get-boolean(return-to-pos, self)) {
                        cancel-player-move-to();
                    }
                }
            }
        }
    }
    state combat-door-complete {
        block start {
            track main {
                lambda {
                    animate-start(door-right-latch-combat-1, t2-door-right-open-combat, 0, 0);
                }
                lambda {
                    interactable-enable(interact-combat-door-1);
                }
                lambda {
                    go(main, 1);
                }
            }
        }
    }
}
