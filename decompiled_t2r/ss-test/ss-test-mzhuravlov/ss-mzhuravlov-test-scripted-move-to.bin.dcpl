u16 get-curve-type(u16 arg_0) {
    return match (arg_0) {
        0    -> 7,
        1    -> 8,
        2    -> 9,
        3    -> 2,
        4    -> 1,
        5    -> 3,
        6    -> 4,
        7    -> 5,
        8    -> 6,
        else -> 0
    };
}

u16 menu-cross() {
    if (joypad-command-active?(debug-script-press-down, 6)) {
        if (get-int32(menu-line-current, self) < get-int32(menu-line-total, self)) {
            set-int32(menu-line-current, get-int32(menu-line-current, self) + 1, self);
        } else {
            set-int32(menu-line-current, 1, self);
        }
    }
    if (joypad-command-active?(debug-script-press-up, 6)) {
        if (get-int32(menu-line-current, self) > 1) {
            set-int32(menu-line-current, get-int32(menu-line-current, self) - 1, self);
        } else {
            set-int32(menu-line-current, get-int32(menu-line-total, self), self);
        }
    }
    if (get-int32(menu-line-current, self) == 5) {
        if (joypad-command-active?(debug-script-press-x, 6)) {
            go(initial, 1);
            print-string("RESET STATE", self);
        }
    }
    if (get-int32(menu-line-current, self) == 9) {
        if (joypad-command-active?(debug-script-press-x, 6)) {
            if (get-boolean(is-abby, self)) {
                set-boolean(is-abby, 0, self);
                go(ellie-start, 1);
            } else {
                set-boolean(is-abby, 1, self);
                go(abby-start, 1);
            }
        }
    }
    if (get-int32(menu-line-current, self) == 15) {
        if (joypad-command-active?(debug-script-press-x, 6)) {
            if (get-boolean(is-winter-outfit, self)) {
                set-boolean(is-winter-outfit, 0, self);
                go(ellie-start, 1);
            } else {
                set-boolean(is-winter-outfit, 1, self);
                go(ellie-winter-start, 1);
            }
        }
    }
    u16 var_19;
    if (joypad-command-active?(debug-script-press-left, 6) && joypad-command-active?(debug-script-press-right, 6) && get-int32(menu-line-current, self) == 1) {
        if (joypad-command-active?(debug-script-press-left, 6)) {
            set-int32(is-demeanor, get-int32(is-demeanor, self) - 1, self);
        } else {
            set-int32(is-demeanor, get-int32(is-demeanor, self) + 1, self);
        }
        if (get-int32(is-demeanor, self) == 0) {
            var_19 = set-int32(is-demeanor, 7, self);
        } else if (get-int32(is-demeanor, self) > 7) {
            var_19 = set-int32(is-demeanor, 1, self);
        } else {
            var_19 = 0;
        }
    } else if (get-int32(menu-line-current, self) == 2) {
        if (get-boolean(is-force-walk, self)) {
            var_19 = set-boolean(is-force-walk, 0, self);
        } else {
            var_19 = set-boolean(is-force-walk, 1, self);
        }
    } else if (get-int32(menu-line-current, self) == 3) {
        if (joypad-command-active?(debug-script-press-left, 6)) {
            set-float(interact-radius, get-float(interact-radius, self) - 0.50, self);
        } else {
            set-float(interact-radius, get-float(interact-radius, self) + 0.50, self);
        }
        if (get-float(interact-radius, self) == 0.00) {
            set-float(interact-radius, 10.00, self);
        } else if (get-float(interact-radius, self) >= 10.00) {
            set-float(interact-radius, 2.00, self);
        }
        print-string(dc:format("Interactible radius =  %.2f", get-float(interact-radius, self)), self);
        interactable-set-interact-radius(interact-promt-1, get-float(interact-radius, self));
        interactable-set-interact-radius(interact-igc-conversation-1, get-float(interact-radius, self));
        interactable-set-interact-radius(interact-promt-continue-1, get-float(interact-radius, self));
        var_19 = set-boolean(dummy, 0, self);
    } else if (get-int32(menu-line-current, self) == 4) {
        if (get-int32(is-new-scripted-move-to, self) == 2) {
            var_19 = set-int32(is-new-scripted-move-to, 0, self);
        } else {
            var_19 = set-int32(is-new-scripted-move-to, get-int32(is-new-scripted-move-to, self) + 1, self);
        }
    } else if (get-int32(menu-line-current, self) == 6) {
        if (get-boolean(debug-pause-before-goto, self)) {
            var_19 = set-boolean(debug-pause-before-goto, 0, self);
        } else {
            var_19 = set-boolean(debug-pause-before-goto, 1, self);
        }
    } else if (get-int32(menu-line-current, self) == 7) {
        if (joypad-command-active?(debug-script-press-left, 6)) {
            set-float(cut-off-distance, get-float(cut-off-distance, self) - 0.05, self);
        } else {
            set-float(cut-off-distance, get-float(cut-off-distance, self) + 0.05, self);
        }
        if (get-float(cut-off-distance, self) == 0.00) {
            var_19 = set-float(cut-off-distance, 0.20, self);
        } else if (get-float(cut-off-distance, self) >= 2.00) {
            var_19 = set-float(cut-off-distance, 0.20, self);
        } else {
            var_19 = 0;
        }
    } else if (get-int32(menu-line-current, self) == 8) {
        if (joypad-command-active?(debug-script-press-left, 6)) {
            set-int32(anim-curve-id, get-int32(anim-curve-id, self) - 1, self);
        } else {
            set-int32(anim-curve-id, get-int32(anim-curve-id, self) + 1, self);
        }
        if (get-int32(anim-curve-id, self) == 0) {
            set-int32(anim-curve-id, 8, self);
        } else if (get-int32(anim-curve-id, self) > 8) {
            set-int32(anim-curve-id, 0, self);
        }
        var_19 = set-curve-type-symbol(get-int32(anim-curve-id, self));
    } else if (get-int32(menu-line-current, self) == 11) {
        if (get-boolean(is-print-animation-name, self)) {
            var_19 = set-boolean(is-print-animation-name, 0, self);
        } else {
            var_19 = set-boolean(is-print-animation-name, 1, self);
        }
    } else if (get-int32(menu-line-current, self) == 16) {
        if (get-boolean(disallow-unholster, self)) {
            var_19 = set-boolean(disallow-unholster, 0, self);
        } else {
            var_19 = set-boolean(disallow-unholster, 1, self);
        }
    } else if (get-int32(menu-line-current, self) == 10) {
        if (get-boolean(is-carry-dina, self)) {
            set-boolean(is-carry-dina, 0, self);
            npc-kill(dina-1);
            var_19 = go(ellie-start, 1);
        } else {
            set-boolean(is-carry-dina, 1, self);
            var_19 = go(carry-dina, 1);
        }
    } else if (get-int32(menu-line-current, self) == 13) {
        if (get-boolean(is-carry-yara, self)) {
            set-boolean(is-carry-yara, 0, self);
            npc-kill(yara-1);
            var_19 = go(abby-start, 1);
        } else {
            set-boolean(is-carry-yara, 1, self);
            var_19 = go(carry-yara, 1);
        }
    } else if (get-int32(menu-line-current, self) == 12) {
        if (get-boolean(is-push-crate, self)) {
            set-boolean(is-push-crate, 0, self);
            var_19 = go(ellie-start, 1);
        } else {
            set-boolean(is-push-crate, 1, self);
            var_19 = go(push-crate, 1);
        }
    } else if (get-int32(menu-line-current, self) == 14) {
        if (get-boolean(heal-test-protocol?, self)) {
            var_19 = set-boolean(heal-test-protocol?, 0, self);
        } else {
            var_19 = set-boolean(heal-test-protocol?, 1, self);
        }
    } else {
        var_19 = 0;
    }
    return var_19;
}

u64? draw-help-offset() {
    set-float(console-y-current, get-float(console-y-current, self) + 10.00, self);
    return set-int32(menu-line-total, get-int32(menu-line-total, self) + 1, self);
}

u64? heal-test-protocol() {
    if (get-inventory-item-quantity(health-kit) == 0) {
        inventory-item-add-quantity(health-kit, 1);
    }
    return set-player-health(20);
}

u16 utility() {
    if (get-boolean(disable-controls?, self)) {
        joypad-disable-commands(
            listen-hold,
            listen-press,
            aim,
            aim-press,
            aim-hold-long,
            aim-hold,
            evade-start,
            evade-release,
            evade-climb,
            melee-attack,
            jump,
            jump-hold
        );
        joypad-disable-commands(inventory-open, inventory-close, inv-open, inv-close, weapon-cross-left, weapon-cross-right, weapon-cross-up, weapon-cross-down);
    }
    u16 var_2;
    if (get-int32(is-demeanor, self) == 1) {
        set-tension-mode(1);
        if (get-boolean(is-force-walk, self)) {
            var_2 = player-force-walk();
        } else {
            var_2 = 0;
        }
    } else if (get-int32(is-demeanor, self) == 2) {
        set-tension-mode(3);
        if (get-boolean(is-force-walk, self)) {
            var_2 = player-force-walk();
        } else {
            var_2 = 0;
        }
    } else if (get-int32(is-demeanor, self) == 3) {
        if (get-boolean(is-force-walk, self)) {
            player-force-walk();
        }
        set-walk-type(walk-uneasy);
        set-run-type(run-uneasy);
        var_2 = set-sprint-type(sprint-uneasy);
    } else if (get-int32(is-demeanor, self) == 4) {
        if (get-boolean(is-force-walk, self)) {
            player-force-walk();
        }
        var_2 = set-tension-mode(2);
    } else if (get-int32(is-demeanor, self) == 5) {
        if (get-boolean(is-force-walk, self)) {
            player-force-walk();
        }
        set-walk-type(walk-tense-old);
        set-run-type(run-tense-old);
        var_2 = set-tension-mode(3);
    } else if (get-int32(is-demeanor, self) == 6) {
        if (get-boolean(is-force-walk, self)) {
            player-force-walk();
        }
        set-walk-type(walk-tense-old);
        set-run-type(run-injured);
        set-tension-mode(3);
        set-run-type(run-injured);
        set-crouch-type(crouch-injured);
        set-sprint-type(slow-sprint-tense);
        var_2 = set-player-health(20);
    } else if (get-int32(is-demeanor, self) == 7) {
        player-force-walk();
        set-walk-type(ellie-walk-relaxed-injured);
        set-run-type(ellie-walk-relaxed-injured);
        set-sprint-type(ellie-walk-relaxed-injured);
        set-tension-mode(1);
        set-crouch-type(crouch-injured);
        var_2 = set-player-health(20);
    } else {
        var_2 = 0;
    }
    return var_2;
}

statescript {
    options {
        player
    }
    declarations {
        f32 console-y-start = 0.00
        f32 console-y-current = 0.00
        f32 cut-off-distance = 0.30
        string anim-curve = (set-symbol 'anim-curve 'quadratic-ease-in-out)
        i32 anim-curve-id = 2
        bound-frame goal = nullptr
        bound-frame path-goal = nullptr
        i32 freeze-timer = nullptr
        f32 distance-to-goal = 10.00
        f32 orientation-to-goal = 180.00
        f32 player-speed = 0.00
        point look-at-point = nullptr
        f32 interact-radius = 2.00
        symbol current-interactible = interact-promt-1
        symbol goto-state = nullptr
        bool draw-help? = nullptr
        bool disable-controls? = nullptr
        bool heal-test-protocol? = nullptr
        bool disallow-unholster = nullptr
        bool dummy = true
        i32 is-new-scripted-move-to = 2
        i32 menu-line-current = 1
        i32 menu-line-total = 1
        bool debug-pause-before-goto = nullptr
        bool debug-pause-ends = nullptr
        bool is-print-animation-name = true
        symbol anim-playing = nullptr
        bool partial-playing = nullptr
        bool is-force-walk = nullptr
        i32 is-demeanor = 1
        bool is-abby = nullptr
        bool is-winter-outfit = nullptr
        i32 scripted-move-type = 0
        i32 scripted-move-goal-type = 0
        f32 starting-speed-scale = 0.00
        symbol mm-set-on-start = nullptr
        symbol doors-array = nullptr
        bound-frame last-pos = nullptr
        bool is-carry-dina = nullptr
        bool is-carry-yara = nullptr
        bool is-push-crate = nullptr
        bool is-carry-yara-low = nullptr
        timer carry-yara-timer = nullptr
        f32 door-angle = nullptr
        string door-open-facing = nullptr
        string door-open-hand = nullptr
        symbol door-open-anim = nullptr
        i32 cur-weapon = nullptr
        f32 abort-frame = nullptr
        bool return-to-pos = nullptr
    }
    state initial {
        block start {
            track main {
                lambda {
                    utility();
                }
                lambda {
                    send-event(teleport-player, player, boxed_boundframe(get-object-locator(player-pos-proxy-1)));
                }
                lambda {
                    camera-fade-out-animated-stick(0.00);
                }
                lambda {
                    debug-draw-string-2d(
                        alloc-point(900.00, 540.00, 0.00, 0),
                        "RESETING",
                        2,
                        1.20,
                        3.00,
                        0,
                        0,
                        0,
                        1.00
                    );
                }
                lambda {
                    go(main, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    utility();
                }
            }
        }
    }
    state abby-start {
        block start {
            track main {
                lambda {
                    utility();
                }
                lambda {
                    set-bound-frame(last-pos, get-object-locator(player), self);
                }
                lambda {
                    spawn-player("", 0);
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 3, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-bound-frame(last-pos, self);
                    *(i32*)*var_0[1] = 28;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 0.00;
                    *(i32*)*var_0[2] = 31;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(u8*)(*var_0[2] + 8) = 0;
                    animate_(player, bindpose, var_0);
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    stop-animating(player, 2, 0.00, 0, 0);
                }
                lambda {
                    remove-player-weapon(bow-ellie);
                }
                lambda {
                    spawn-flashlight(player);
                }
                lambda {
                    if (!get-boolean(is-abby, self)) {
                        set-boolean(is-abby, 1, self);
                        go(carry-yara, 1);
                    }
                }
                lambda {
                    go(main, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    utility();
                }
            }
        }
    }
    state ellie-start {
        block start {
            track main {
                lambda {
                    utility();
                }
                lambda {
                    stop-carry-ik(0.20);
                }
                lambda {
                    set-bound-frame(last-pos, get-object-locator(player), self);
                }
                lambda {
                    spawn-player("", 0);
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 3, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-bound-frame(last-pos, self);
                    *(i32*)*var_0[1] = 31;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(u8*)(*var_0[1] + 8) = 0;
                    *(i32*)*var_0[2] = 28;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.00;
                    animate_(player, bindpose, var_0);
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    stop-animating(player, 2, 0.00, 0, 0);
                }
                lambda {
                    spawn-flashlight(player);
                }
                lambda {
                    go(main, 1);
                }
            }
        }
    }
    state ellie-winter-start {
        block start {
            track main {
                lambda {
                    utility();
                }
                lambda {
                    set-bound-frame(last-pos, get-object-locator(player), self);
                }
                lambda {
                    spawn-player("", 0);
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 3, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-bound-frame(last-pos, self);
                    *(i32*)*var_0[1] = 31;
