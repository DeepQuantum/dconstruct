u16 set-curve-type-symbol(u16 arg_0) {
    return match (arg_0) {
        0    -> set-string(anim-curve, "(set-symbol 'anim-curve 'quadratic-ease-in)", self),
        1    -> set-string(anim-curve, "(set-symbol 'anim-curve 'quadratic-ease-out)", self),
        2    -> set-string(anim-curve, "(set-symbol 'anim-curve 'quadratic-ease-in-out)", self),
        3    -> set-string(anim-curve, "(set-symbol 'anim-curve 'uniform-s)", self),
        4    -> set-string(anim-curve, "(set-symbol 'anim-curve 'linear)", self),
        5    -> set-string(anim-curve, "(set-symbol 'anim-curve 'ease-in)", self),
        6    -> set-string(anim-curve, "(set-symbol 'anim-curve 'ease-out)", self),
        7    -> set-string(anim-curve, "(set-symbol 'anim-curve 'long-tail)", self),
        8    -> set-string(anim-curve, "(set-symbol 'anim-curve 'long-toe)", self),
        else -> 0
    };
}

u64? utility-goal() {
    set-float(distance-to-goal, get-locator-distance-xz(get-bound-frame(path-goal, self), get-object-locator(player)), self);
    set-float(orientation-to-goal, angle-in-between-locators(get-bound-frame(path-goal, self), get-object-locator(player), 2), self);
    set-float(player-speed, get-player-speed(), self);
    debug-draw-locator(get-bound-frame(path-goal, self), 0.50, 0.00, 1, 1.00, 0);
    debug-draw-string-2d(
        alloc-point(100.00, 20.00, 0.00, 0),
        dc:format("Distance to go to point: %.2f", get-float(distance-to-goal, self)),
        7,
        0.00,
        1.00,
        0,
        0,
        0,
        1.00
    );
    debug-draw-string-2d(
        alloc-point(100.00, 40.00, 0.00, 0),
        dc:format("Angle diff: %.2f", get-float(orientation-to-goal, self)),
        7,
        0.00,
        1.00,
        0,
        0,
