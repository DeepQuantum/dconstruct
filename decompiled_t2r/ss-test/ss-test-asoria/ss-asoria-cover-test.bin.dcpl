                lambda {
                    if (player-command-active?(mark, 1)) {
                        if (get-boolean(draw-help?, self)) {
                            set-boolean(draw-help?, 0, self);
                        } else {
                            set-boolean(draw-help?, 1, self);
                        }
                    }
                }
                lambda {
                    if (player-command-active?(fire-hold, 1)) {
                        if (player-command-active?(menu-right, 1)) {
                            set-int32(angle-end, get-int32(angle-end, self) - 30, self);
                            set-object-locator(pivot-start-1, rotate-locator-angle(get-object-locator-default-rotation(pivot-start-1), 1, (f32)get-int32(angle-end, self)));
                        }
                        if (player-command-active?(menu-left, 1)) {
                            set-int32(angle-end, get-int32(angle-end, self) + 30, self);
                            set-object-locator(pivot-start-1, rotate-locator-angle(get-object-locator-default-rotation(pivot-start-1), 1, (f32)get-int32(angle-end, self)));
                        }
                    }
                }
            }
        }
    }
}
