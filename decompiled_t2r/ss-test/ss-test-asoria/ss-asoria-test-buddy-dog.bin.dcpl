u64? get-ground-adjusted-locator(u64? arg_0) {
    return alloc-bound-frame(
        alloc-point(
            *(f32*)get-locator-position(get-object-locator(player)),
            0.00,
            *(f32*)(get-locator-position(get-object-locator(player)) + 8),
            0
        ),
        get-locator-rotation(flatten-locator(arg_0)),
        0,
        0,
        0
    );
}

