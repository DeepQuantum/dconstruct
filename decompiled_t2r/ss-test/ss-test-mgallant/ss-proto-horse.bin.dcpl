                    start-timer(force-dismount-timer, 3.00, self, 1);
                }
                lambda {
                    go(dismount, 1);
                }
            }
        }
        block event melee-attack-timer {
            track main {
                lambda {
                    set-int32(melee-raycast, -1, self);
                }
            }
        }
        block end {
            track main {
                lambda {
                    set-int32(raycast-down, -1, self);
                }
                lambda {
                    set-int32(raycast-ideal, -1, self);
                }
                lambda {
                    set-int32(raycast-move, -1, self);
                }
                lambda {
                    set-int32(raycast-rotate, -1, self);
                }
            }
        }
    }
    state jumping {
        block update {
            track main {
                lambda {
                    camera-set-overlay(*camera-remap-horse*);
                }
                lambda {
                    update-ap-ref(player, get-horse-rider-ap-ref(), 0);
                }
                lambda {
                    foreach (u64? var_1 : all-buddy-npcs) {
                        u16 var_2;
                        if (var_1 && *(u16*)(var_1 + 12) == 7) {
                            var_2 = *(u64*)var_1;
                        } else if (var_1 && *(u16*)(var_1 + 12) == 5) {
                            var_2 = *(u64*)var_1;
                        } else if (var_1 && *(u16*)(var_1 + 12) == 4) {
                            var_2 = *(u64*)var_1;
                        } else {
                            var_2 = 0;
                        }
                        update-ap-ref(var_2, get-proto-horse-passenger-ap-ref(self), 0);
                    }
                }
                lambda {
                    joypad-disable-all-commands-except(camera);
                }
                lambda {
                    treat-character-as-uninterruptible(player);
                }
            }
        }
        block event jump-done {
            track main {
                lambda {
                    go(mounted, 1);
                }
            }
        }
    }
    state struggle-with-npc {
        block start {
            track main {
                lambda {
                    wait-one-frame();
                }
                lambda {
                    camera-enable-animated(0.00, -1.00, 1, 1000, 0, 0, 0);
                }
                lambda {
                    animate_(self, horse-idle, #%alloc-array(single-frame, 16, 0, 1));
                }
                lambda {
                    u64? var_1 = #%alloc-array(single-frame, 16, 4, 1);
                    *(i32*)*(*var_1 + (0 * 8)) = 10;
                    *(u64*)(*(*var_1 + (0 * 8)) + 8) = 0;
                    *(u64*)(*(*var_1 + (0 * 8)) + 8) = get-object-locator(self);
                    *(i32*)*(*var_1 + (1 * 8)) = 59;
                    *(u64*)(*(*var_1 + (1 * 8)) + 8) = 0;
                    *(i32*)(*(*var_1 + (1 * 8)) + 8) = 0;
                    *(i32*)*(*var_1 + (2 * 8)) = 58;
                    *(u64*)(*(*var_1 + (2 * 8)) + 8) = 0;
                    *(f32*)(*(*var_1 + (2 * 8)) + 8) = get-animation-phase(get-symbol(struggle-npc, self), 2, 0);
                    *(i32*)*(*var_1 + (3 * 8)) = 28;
                    *(u64*)(*(*var_1 + (3 * 8)) + 8) = 0;
                    *(f32*)(*(*var_1 + (3 * 8)) + 8) = 0.30;
                    wait-animate_(player, get-symbol(struggle-intro, self), var_1);
                }
                lambda {
                    u64? var_1 = #%alloc-array(single-frame, 16, 1, 1);
                    *(i32*)*(*var_1 + (0 * 8)) = 10;
                    *(u64*)(*(*var_1 + (0 * 8)) + 8) = 0;
                    *(u64*)(*(*var_1 + (0 * 8)) + 8) = get-object-locator(self);
                    wait-animate_(player, get-symbol(struggle-loop, self), var_1);
                }
                lambda {
                    if (joypad-command-active?(interact-repeat, 6)) {
                        broadcast-event-to-npcs(struggle-success);
                        u64? var_2 = #%alloc-array(single-frame, 16, 3, 1);
                        *(i32*)*(*var_2 + (0 * 8)) = 10;
                        *(u64*)(*(*var_2 + (0 * 8)) + 8) = 0;
                        *(u64*)(*(*var_2 + (0 * 8)) + 8) = get-object-locator(self);
                        *(i32*)*(*var_2 + (1 * 8)) = 28;
                        *(u64*)(*(*var_2 + (1 * 8)) + 8) = 0;
                        *(f32*)(*(*var_2 + (1 * 8)) + 8) = 0.30;
                        *(i32*)*(*var_2 + (2 * 8)) = 30;
                        *(u64*)(*(*var_2 + (2 * 8)) + 8) = 0;
                        *(f32*)(*(*var_2 + (2 * 8)) + 8) = 1.00;
                        wait-animate_(player, get-symbol(struggle-success, self), var_2);
                        camera-fade-out-animated(1.00, 0);
                        update-player-animation(ellie-mm-tense-idle, 1.00);
                        wait(0.50);
                        go(mounted, 1);
                    } else {
                        send-event(struggle-fail, get-symbol(struggle-npc, self));
                        u64? var_6 = #%alloc-array(single-frame, 16, 3, 1);
                        *(i32*)*(*var_6 + (0 * 8)) = 10;
                        *(u64*)(*(*var_6 + (0 * 8)) + 8) = 0;
                        *(u64*)(*(*var_6 + (0 * 8)) + 8) = get-object-locator(self);
                        *(i32*)*(*var_6 + (1 * 8)) = 28;
                        *(u64*)(*(*var_6 + (1 * 8)) + 8) = 0;
                        *(f32*)(*(*var_6 + (1 * 8)) + 8) = 0.30;
                        *(i32*)*(*var_6 + (2 * 8)) = 30;
                        *(u64*)(*(*var_6 + (2 * 8)) + 8) = 0;
                        *(f32*)(*(*var_6 + (2 * 8)) + 8) = 0.50;
                        wait-animate_(player, get-symbol(struggle-fail, self), var_6);
                        start-timer(force-dismount-timer, 3.00, self, 1);
                        go(dismount, 1);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    camera-set-overlay(*camera-remap-horse*);
                }
                lambda {
                    treat-character-as-uninterruptible(player);
                }
                lambda {
                    if (object-anim-playing?(player, get-symbol(struggle-intro, self), 0) && object-anim-playing?(player, get-symbol(struggle-loop, self), 0)) {
                        draw-joypad-command(interact-repeat, get-joint-locator(self, hero_attachment), 0);
                    }
                }
            }
        }
    }
