                    *(u64*)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (2 * 8)) + 8) = 0.30;
                    *(i32*)*(*var_0 + (3 * 8)) = 30;
                    *(u64*)(*(*var_0 + (3 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (3 * 8)) + 8) = 0.30;
                    animate_(self, dog-sniff, var_0);
                }
                lambda {
                    while (!timer-running?(bark-at-timer, self) && !tension-mode-is?(3)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    if (npc-using-skill?(self, 59)) {
                        set-focusable-ignore(player, 1);
                        wait-frames(10);
                        set-focusable-ignore(player, 0);
                    }
                }
                lambda {
                    start-timer(smell-repeat-timer, 30.00, self, 1);
                }
                lambda {
                    go(detect-smell, 1);
                }
            }
            track noise {
                lambda {
                    wait(1.50);
                }
                lambda {
                    audio-gameplay-event(dog-bark, get-locator-position(get-bound-frame(bark-at-loc, self)), player);
                }
                lambda {
                    wait-frames(2);
                }
                lambda {
                    audio-gameplay-event(dog-bark, get-locator-position(get-bound-frame(bark-at-loc, self)), player);
                }
                lambda {
                    wait-frames(2);
                }
                lambda {
                    audio-gameplay-event(dog-bark, get-locator-position(get-bound-frame(bark-at-loc, self)), player);
                }
                lambda {
                    wait-frames(2);
                }
                lambda {
                    audio-gameplay-event(dog-bark, get-locator-position(get-bound-frame(bark-at-loc, self)), player);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (deterministic-nth-frame?(30) && object-anim-playing?(self, dog-sniff, 0)) {
                        if (!(tag-symbol(owner-npc, self) == 0) && tag-symbol(owner-npc, self) == get-symbol(bark-at-source, self)) {
                            dog-script-caption("*whimper*", 4);
                        } else {
                            dog-script-caption("*BARK*", 2);
                        }
                    }
                }
            }
        }
        block event bark-at {
            track main {
                lambda {
                    if (get-symbol(bark-at-source, self) == event-arg-symbol(0)) {
                        start-timer(bark-at-timer, event-arg-float(2), self, 1);
                    }
                }
            }
        }
        block event Attack {
            track main {
                lambda {
                    npc-clear-request-movement(self);
                }
                lambda {
                    go(detect-smell, 1);
                }
            }
        }
        block event npc-died {
            track main {
                lambda {
                    if (get-self-id() == event-arg-symbol(0)) {
                        go(death, 1);
                    }
                }
            }
        }
        block end {
            track main {
                lambda {
                    if (npc-alive?(self)) {
                        stop-animating(self, 2, 0.00, 0, 0);
                        npc-stop(self);
                    }
                }
                lambda {
                    set-symbol(bark-at-source, 0, self);
                }
                lambda {
                    set-point(investigate-pos, get-locator-position(blank-locator()), self);
                }
            }
        }
    }
    state audio-distraction {
        block start {
            track main {
                lambda {
                    if (!tension-mode-is?(3)) {
                        npc-ping-distraction-at(self, get-locator-position(get-bound-frame(bottle-loc, self)), 0);
                        while (tension-mode-is?(3) && !((get-current-time(0) - get-current-time(0)) > 1.00)) {
                            wait-one-frame();
                        }
                        while (get-locator-distance(get-object-locator(self), get-bound-frame(bottle-loc, self)) < 2.00 || !(npc-in-investigation?(self)) && !tension-mode-is?(3)) {
                            wait-one-frame();
                        }
                        npc-request-hold(self, 10.00);
                        npc-clear-request-movement(self);
                        npc-change-vision-settings(self, test-no-vision);
                        dog-script-caption("Scratch", 1);
                        if (!tension-mode-is?(3)) {
                            u64? var_14 = #%alloc-array(single-frame, 16, 4, 1);
                            *(i32*)*(*var_14 + (0 * 8)) = 10;
                            *(u64*)(*(*var_14 + (0 * 8)) + 8) = 0;
                            *(u64*)(*(*var_14 + (0 * 8)) + 8) = get-object-locator(self);
                            *(i32*)*(*var_14 + (1 * 8)) = 3;
                            *(u64*)(*(*var_14 + (1 * 8)) + 8) = 0;
                            *(u8*)(*(*var_14 + (1 * 8)) + 8) = 1;
                            *(i32*)*(*var_14 + (2 * 8)) = 28;
                            *(u64*)(*(*var_14 + (2 * 8)) + 8) = 0;
                            *(f32*)(*(*var_14 + (2 * 8)) + 8) = 0.30;
                            *(i32*)*(*var_14 + (3 * 8)) = 30;
                            *(u64*)(*(*var_14 + (3 * 8)) + 8) = 0;
                            *(f32*)(*(*var_14 + (3 * 8)) + 8) = 0.30;
                            animate_(self, dog-sniff, var_14);
                            while (tension-mode-is?(3) && !((get-current-time(0) - get-current-time(0)) > 5.00)) {
                                wait-one-frame();
                            }
                            stop-animating(self, 2, 0.00, 0, 0);
                        }
                        npc-change-vision-settings(self, default);
                        npc-clear-request-movement(self);
                    }
                }
                lambda {
                    go(detect-smell, 1);
                }
            }
        }
        block event tension-changed {
            track main {
                lambda {
                    if (tension-mode-is?(3)) {
                        go(detect-smell, 1);
                    }
                }
            }
        }
        block event Attack {
            track main {
                lambda {
                    npc-clear-request-movement(self);
                }
                lambda {
                    go(detect-smell, 1);
                }
            }
        }
    }
    state death {
        block start {
            track main {
                lambda {
                    darray-find-remove(all-dogs, new-boxed-value(7, get-self-id()), 0);
                }
            }
        }
    }
    state check-bark {
        block start {
            track check-obstacles {
                lambda {
                    while (1) {
                        wait-for-event(
                            bark-at,
                            0,
                            0,
                            0,
                            0,
                            0,
                            0,
                            0,
                            0,
                            0
                        );
                        wait(1.50);
                        u64? var_0 = #%alloc-array(single-frame, 16, 4, 1);
                        *(i32*)*(*var_0 + (0 * 8)) = 10;
                        *(u64*)(*(*var_0 + (0 * 8)) + 8) = 0;
                        *(u64*)(*(*var_0 + (0 * 8)) + 8) = rotate-locator-lookat(get-object-locator(self), get-bound-frame(bark-at-loc, self), 1.00, 0);
                        *(i32*)*(*var_0 + (1 * 8)) = 3;
                        *(u64*)(*(*var_0 + (1 * 8)) + 8) = 0;
                        *(u8*)(*(*var_0 + (1 * 8)) + 8) = 1;
                        *(i32*)*(*var_0 + (2 * 8)) = 28;
                        *(u64*)(*(*var_0 + (2 * 8)) + 8) = 0;
                        *(f32*)(*(*var_0 + (2 * 8)) + 8) = 0.30;
                        *(i32*)*(*var_0 + (3 * 8)) = 30;
                        *(u64*)(*(*var_0 + (3 * 8)) + 8) = 0;
                        *(f32*)(*(*var_0 + (3 * 8)) + 8) = 0.30;
                        animate_(self, dog-sniff, var_0);
                        dog-script-caption("*BARK*", 2);
                        wait(1.50);
                        stop-animating(self, 2, 0.00, 0, 0);
                        wait(0.50);
                    }
                }
            }
        }
    }
    state meet-up-with-human {
        block start {
            track main {
                lambda {
                    set-boolean(regrouped, 1, self);
                }
                lambda {
                    npc-set-demeanor(tag-symbol(owner-npc, self), 0, 1);
                }
                lambda {
                    script-caption(tag-symbol(owner-npc, self), "Whissstle!", -1.00, 0, 0);
                }
                lambda {
                    while (!(get-object-distance(self, tag-symbol(owner-npc, self)) < 2.00)) {
                        npc-move-to(self, get-object-locator(tag-symbol(owner-npc, self)), 0, 0, 0, 0, 0, 0);
                        wait(1.00);
                    }
                }
                lambda {
                    u64? var_1 = #%alloc-array(single-frame, 16, 2, 1);
                    *(i32*)*(*var_1 + (0 * 8)) = 31;
                    *(u64*)(*(*var_1 + (0 * 8)) + 8) = 0;
                    *(u8*)(*(*var_1 + (0 * 8)) + 8) = 1;
                    *(i32*)*(*var_1 + (1 * 8)) = 28;
                    *(u64*)(*(*var_1 + (1 * 8)) + 8) = 0;
                    *(f32*)(*(*var_1 + (1 * 8)) + 8) = 0.50;
                    animate_(tag-symbol(owner-npc, self), npc-m-p-crouch-idle, var_1);
                }
                lambda {
                    wait(2.00);
                }
                lambda {
                    stop-animating(tag-symbol(owner-npc, self), 2, 0.50, 0, 0);
                }
                lambda {
                    npc-set-demeanor(tag-symbol(owner-npc, self), 5, 1);
                }
                lambda {
                    go(check-bark, 1);
                }
            }
        }
        block event Attack {
            track main {
                lambda {
                    go(check-bark, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (npc-using-skill?(self, 30) && npc-using-skill?(tag-symbol(owner-npc, self), 30)) {
                        go(check-bark, 1);
                    }
                }
            }
        }
    }
}
