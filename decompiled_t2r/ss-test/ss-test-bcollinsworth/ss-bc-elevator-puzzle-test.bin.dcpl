u64? bc-get-rope-obj(u64? arg_0) {
    return get-carry-rope-rope(arg_0);
}

u64? bc-test-rope-in-region?(u64? arg_0, u64? arg_1, u64? arg_2) {
    return locator-in-region?(alloc-bound-frame(rope-get-query-point(arg_1, arg_2), 0, 0, 0, 0), arg_0, player);
}

