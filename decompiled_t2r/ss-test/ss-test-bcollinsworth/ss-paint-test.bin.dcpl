            track painting-loop {
                lambda {
                    wait-for(enable-painting);
                }
                lambda {
                    while (1) {
                        update-painting-vars--test();
                        if (tag-boolean(paint-with-aim?, get-symbol(active-interact, self))) {
                            joypad-disable-commands(move);
                            joypad-force-command(aim);
                            joypad-set-stick-scale(camera, get-float(anim-speed, self));
                            player-ik-point-at(get-locator-position(get-bound-frame(paint-raycast-loc, self)), 0, *player-point-at-paint-ik*, 0, 0.20);
                        } else {
                            draw-paint-input-vec--test();
                            set-int32(error-state, get-painting-error--test(), self);
                            i32 var_6 = get-int32(error-state, self);
                            if (var_6 == -1) {
                                var_7 = painting-error-enter--test(paint-test-inside--abby);
                            } else {
                                u16 var_9;
                                if (var_6 == 1) {
                                    var_9 = painting-error-enter--test(paint-test-outside--abby);
                                } else if (var_6 == 0) {
                                    var_9 = painting-error-correct--test();
                                } else {
                                    var_9 = 0;
                                }
                                var_7 = var_9;
                            }
                            set-animation-speed(player, get-float(anim-speed, self), 0, 0);
                        }
                        update-paint-target-locator--test();
                        if (get-boolean(apply-paint?, self) && get-float(error-dist-normalized, self) <= 1.00 && locator-further-than-distance-to-locator?(
                            get-bound-frame(paint-raycast-loc, self),
                            alloc-bound-frame(vector-to-point(get-vector(last-paint-pos, self)), 0, 0, 0, 0),
                            0.03,
                            1
                        )) {
                            apply-paint--test();
                            update-completed-paint-segments--test();
                        }
                    }
                }
                lambda {
                    wait-one-frame();
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (joypad-command-active?(crouch-press, 6)) {
                        go(evaluate-skill, 1);
                    }
                }
                lambda {
                    u16 var_1;
                    if (joypad-command-active?(fire-hold, 6)) {
                        var_1 = 1;
                    } else {
                        var_1 = 0;
                    }
                    set-boolean(apply-paint?, var_1, self);
                }
                lambda {
                    camera-set-overlay(*camera-remap-close*);
                }
            }
        }
    }
    state evaluate-skill {
        block start {
            track main {
                lambda {
                    if (get-boolean(painting-completed?, self)) {
                        set-boolean(tally-error?, 0, self);
                        u64? var_1 = get-float(total-error, self);
                        i32 var_2 = get-int32(total-frames, self);
                        get-int32(frames-in-error-anim, self);
                        get-int32(total-frames, self);
                        print-string("Final Error:", self);
                        print-float(var_1 / (f32)var_2, self);
                        wait(1.00);
                        if ((var_1 / (f32)var_2) < 0.15) {
                            var_5 = script-caption(player, "Wow, I'm great at this!", 5.00, 0, 0);
                        } else if ((var_1 / (f32)var_2) < 0.24) {
                            var_5 = script-caption(player, "Good enough.", 5.00, 0, 0);
                        } else if ((var_1 / (f32)var_2) < 0.40) {
                            var_5 = script-caption(player, "Well, it's not TERRIBLE...", 5.00, 0, 0);
                        } else {
                            var_5 = script-caption(player, "I really suck.", 5.00, 0, 0);
                        }
                        go(exit-painting, 1);
                    }
                }
                lambda {
                    go(not-done-yet, 1);
                }
            }
        }
    }
    state not-done-yet {
        block start {
            track main {
                lambda {
                    wait-stop-animating(player, 2, 0.80, 0);
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    script-caption(player, "Doesn't look quite done...", 5.00, 0, 0);
                }
                lambda {
                    go(exit-painting, 1);
                }
            }
        }
    }
    state exit-painting {
        block start {
            track main {
                lambda {
                    stop-animating(player, 2, 0.80, 0, 0);
                }
                lambda {
                    go(wait-for-interact, 1);
                }
            }
        }
    }
}
