                    *(u64*)(*var_1[1] + 8) = rotate-locator-angle(var_0, 1, 180.00);
                    *(i32*)*var_1[2] = 57;
                    *(u64*)(*var_1[2] + 8) = 0;
                    *(f32*)(*var_1[2] + 8) = 0.00;
                    animate_(player, abby-vs-ellie-knife-stealth-kill--abby, var_1);
                    u64? var_3 = #%alloc-array(single-frame, 16, 3, 1);
                    *(i32*)*var_3[0] = 28;
                    *(u64*)(*var_3[0] + 8) = 0;
                    *(f32*)(*var_3[0] + 8) = 0.00;
                    *(i32*)*var_3[1] = 10;
                    *(u64*)(*var_3[1] + 8) = 0;
                    *(u64*)(*var_3[1] + 8) = rotate-locator-angle(var_0, 1, 180.00);
                    *(i32*)*var_3[2] = 57;
                    *(u64*)(*var_3[2] + 8) = 0;
                    *(f32*)(*var_3[2] + 8) = 0.00;
                    animate_(npc-enemy-ellie-pistol-1, abby-vs-ellie-knife-stealth-kill--ellie, var_3);
                    aef-task-fail-in-time-for-stinger(npc-enemy-ellie-pistol-1, abby-vs-ellie-knife-stealth-kill--ellie);
                }
            }
            track rumble {
                lambda {
                    wait-until-frame(18);
                }
                lambda {
                    wait-rumble-curve(1.00, 1.00, 0.10, 2, 0);
                }
                lambda {
                    wait-rumble-curve(1.00, 1.00, 0.10, 2, 0);
                }
                lambda {
                    wait-rumble-curve(1.00, 0.00, 0.10, 2, 0);
                }
                lambda {
                    wait-until-frame(46);
                }
                lambda {
                    wait-rumble-curve(0.87, 1.00, 0.10, 2, 0);
                }
                lambda {
                    wait-rumble-curve(1.00, 0.00, 0.10, 2, 0);
                }
                lambda {
                    wait-until-frame(63);
                }
                lambda {
                    wait-rumble-curve(0.83, 1.00, 0.10, 2, 0);
                }
                lambda {
                    wait-rumble-curve(1.00, 1.00, 0.10, 2, 0);
                }
                lambda {
                    wait-rumble-curve(1.00, 1.00, 0.10, 2, 0);
                }
                lambda {
                    wait-rumble-curve(1.00, 1.00, 0.10, 2, 0);
                }
                lambda {
