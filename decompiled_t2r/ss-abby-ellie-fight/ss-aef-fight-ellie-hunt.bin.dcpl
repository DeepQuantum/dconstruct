                }
            }
            track music {
                lambda {
                    play-music-stinger(*music-playlist-aef-fight-abby-death*, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    disable-trap-bomb-detonation();
                }
                lambda {
                    debug-draw-string-2d(
                        alloc-point(50.00, 500.00, 0.00, 0),
                        string-debug(get-symbol(custom-death-ap, self)),
                        1,
                        0.00,
                        1.00,
                        0,
                        0,
                        0,
                        1.00
                    );
                }
                lambda {
                    if (get-state-frame() > 10) {
                        hud2-hide-health-ammo/f(0, 0);
                    }
                }
            }
        }
    }
    state complete {
        block start {
            track main {
                lambda {
                    if (entity-exists?(hanging-florescent-light-1)) {
                        set-light-process-volumetric-intensity(superSpot-attachCenterShape-1, 0.02);
                    }
                }
                lambda {
                    kill-entity(self);
                }
            }
        }
    }
}
