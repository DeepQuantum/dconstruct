                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("ELLIE ENTERED STATE: %s", string-debug(get-script-state(self))), 19);
                    }
                }
                lambda {
                    broadcast-event(ellie-stunned);
                }
                lambda {
                    wait-aef-ellie-put-away-throwable(0, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    debug-draw-string(get-object-position(npc-enemy-ellie-pistol-1), "STUNNED", 1, 0.00, 0, 1.00, 0, 0);
                }
                lambda {
                    if (!aef-ellie-stunned?()) {
                        go(ellie-debug-advance, 1);
                    }
                }
            }
        }
        block end {
            track main {
                lambda {
                    broadcast-event(ellie-no-longer-stunned);
                }
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("ELLIE LEAVING STATE: %s", string-debug(get-script-state(self))), 19);
                    }
                }
            }
        }
    }
