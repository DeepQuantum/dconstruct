                lambda {
                    npc-set-script-only-no-perception(npc-enemy-ellie-pistol-1);
                }
                lambda {
                    wait-aef-ellie-put-away-throwable(0, 0);
                }
                lambda {
                    npc-stop(npc-enemy-ellie-pistol-1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    disable-trap-bomb-detonation();
                }
                lambda {
                    debug-draw-string(get-object-position(npc-enemy-ellie-pistol-1), "IN-IGC", 1, 0.00, 0, 1.00, 0, 0);
