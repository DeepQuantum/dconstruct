    state ellie-rush-attack {
        block start {
            track rush {
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("ELLIE ENTERED STATE: %s", string-debug(get-script-state(self))), 19);
                    }
                }
                lambda {
                    npc-set-script-only-with-perception(npc-enemy-ellie-pistol-1);
                }
                lambda {
                    wait-aef-ellie-put-away-throwable(0, 1);
                }
                lambda {
                    set-int32(post-id, -1, self);
                }
                lambda {
                    while (1) {
                        if (distance-xz-between-objects(npc-enemy-ellie-pistol-1, player) < 5.00) {
                            npc-stop(npc-enemy-ellie-pistol-1);
                        }
                        if (get-closest-post-id(get-object-locator(player), 3) != get-int32(post-id, self)) {
                            npc-move-to-post(
                                npc-enemy-ellie-pistol-1,
                                ai-get-post(get-closest-post-id(get-object-locator(player), 3)),
                                1,
                                0,
                                0,
                                0,
                                1,
                                0,
                                *zero-vector*,
                                0
                            );
                        }
                        var_0 = wait-one-frame();
                    }
                }
                lambda {
                    go(ellie-debug-advance, 1);
                }
            }
            track vox {
                lambda {
                    broadcast-event(ellie-boss-charge-at-player);
                }
            }
        }
        block update {
            track main {
                lambda {
                    debug-draw-string(get-object-position(npc-enemy-ellie-pistol-1), "STUN BOMB RUSH", 1, 0.00, 0, 1.00, 0, 0);
                }
            }
        }
        block end {
            track main {
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("ELLIE LEAVING STATE: %s", string-debug(get-script-state(self))), 19);
                    }
                }
            }
        }
    }
    state complete {
        block start {
            track main {
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("ELLIE ENTERED STATE: %s", string-debug(get-script-state(self))), 19);
                    }
                }
                lambda {
                    end-script();
                }
            }
        }
        block end {
            track main {
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("ELLIE LEAVING STATE: %s", string-debug(get-script-state(self))), 19);
                    }
                }
            }
        }
    }
