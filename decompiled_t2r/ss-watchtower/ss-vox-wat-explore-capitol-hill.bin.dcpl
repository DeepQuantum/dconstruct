                lambda {
                    npc-turn-to(dina, get-spawner-position(ic-vox-wat-cap-hill-inactive-checkpoint-1, 1), 1, 0);
                }
                lambda {
                    point-to-point(dina, get-spawner-position(ic-vox-wat-cap-hill-inactive-checkpoint-1, 1), 12, 0);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gen-cya-wat-explore-capitol-hill-gas-station-bookstore-002, 2, 0);
                }
