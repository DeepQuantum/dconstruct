    state olive-st-combat-done {
        block start {
            track vox {
                lambda {
                    if (!get-boolean(vox-olive-st-combat-vox-done, self)) {
                        set-boolean(vox-olive-st-combat-vox-done, 1, self);
                        if (!get-boolean(vox-player-in-olive-st-rgn, self)) {
                            go(wait-for-event, 1);
                        }
                        set-boolean(vox-initiated-combat, 0, self);
                        if (tension-mode-is?(3)) {
                            set-boolean(vox-initiated-combat, 1, self);
                        }
                        wait-until-non-combat-tension(2.00, 4.00);
                        if (get-boolean(vox-initiated-combat, self)) {
                            wait-say(dina, vox-igc-din-gen-cya-wat-explore-capitol-hill-olive-st-001, 2, 0);
                            wait(2.20);
                        }
                        wait-say(dina, vox-igc-din-gam-wat-explore-capitol-hill-gas-station-pub-sp-002, 2, 0);
                        wait(0.70);
                        wait-say(player, vox-igc-ell-gam-wat-explore-capitol-hill-gas-station-pub-sp-003, 2, 0);
                        wait(1.20);
                        if (get-boolean(vox-player-in-checkpoint-bldg-upstairs, self)) {
                            signal(upstairs, 0);
                        }
                    }
                }
                lambda {
                    wait-boolean(vox-player-near-checkpoint, 1, self);
                }
                lambda {
                    set-boolean(vox-olive-st-combat-done, 1, self);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-wat-freeway-checkpoint-post-combat-sp-002, 2, 0);
                }
                lambda {
                    wait(1.50);
                }
                lambda {
                    set-svar-as-boolean(vox-wat-cap-see-checkpoint-wall, 1);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gam-wat-explore-capitol-hill-olive-st-sp-017, 2, 0);
                }
                lambda {
                    wait(0.60);
                }
                lambda {
                    set-boolean(vox-way-over-played, 1, self);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-wat-explore-capitol-hill-olive-st-sp-012, 2, 0);
                }
                lambda {
                    wait(3.00);
                }
                lambda {
                    signal(outside, 0);
                }
            }
            track inside {
                lambda {
                    wait-for(outside);
                }
                lambda {
                    wait-boolean(vox-player-in-checkpoint-bldg, 1, self);
                }
                lambda {
                    wait(2.00);
                }
                lambda {
                    signal(inside, 0);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gam-wat-explore-capitol-hill-olive-st-sp-019, 2, 0);
                }
                lambda {
                    if (!get-boolean(vox-way-over-played, self)) {
                        wait-say(dina, vox-igc-din-gam-wat-explore-capitol-hill-olive-st-sp-020, 2, 0);
                    }
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
            track upstairs {
                lambda {
                    wait-for(upstairs);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gen-cya-wat-explore-capitol-hill-olive-st-002, 2, 0);
                }
            }
        }
