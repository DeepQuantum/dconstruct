                    send-event(station-combat-complete, ss-wat-infected-tunnels-train-open-1);
                }
                lambda {
                    npc-request-follow(dina, player, 4, *default-ai-follow-settings*, 0, 0);
                }
                lambda {
                    wait(5.00);
                }
                lambda {
                    send-event(evt-dina-light-on, ss-wat-infected-tunnels-dina-flashlight-1);
                }
                lambda {
                    wait(10.00);
                }
                lambda {
                    npc-request-explore(dina, 0, 0, *buddy-post-selector-set*, 15.00, 4, *default-ai-explore-follow-settings*, 0);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(watchtower, wat-infected-tunnels-station-fight)) {
                        go(station-cleanup, 1);
                    }
                }
            }
        }
    }
    state station-cleanup {
        block start {
            track main {
                lambda {
                    send-event(evt-dina-light-on, ss-wat-infected-tunnels-dina-flashlight-1);
                }
                lambda {
                    set-invisible-to-npcs(player, 1);
                }
                lambda {
                    set-invisible-to-npcs(dina, 1);
                }
                lambda {
                    npc-set-script-high-priority(dina);
                }
            }
        }
        block event evt-progressed-out-of-sight {
            track main {
                lambda {
                    set-invisible-to-npcs(player, 0);
                }
                lambda {
                    set-invisible-to-npcs(dina, 0);
                }
                lambda {
                    group-kill-entity(station-fight-militia, 0);
                }
                lambda {
                    group-kill-entity(station-fight-clickers, 0);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
