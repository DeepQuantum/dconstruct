                }
                lambda {
                    npc-weapon-down(dina);
                }
                lambda {
                    wait(2.00);
                }
                lambda {
                    npc-set-script-only-no-perception(dina);
                }
                lambda {
                    while (!npc-on-screen-and-visible?(dina, -1, 0)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    npc-set-script-only-no-perception(dina);
