                        *(f32*)(*var_3[2] + 8) = 0.50;
                        wait-animate_(dina, var_2, var_3);
                    }
                }
            }
            track door {
                lambda {
                    sid var_1;
                    if (get-boolean(in-combat?, self)) {
                        var_1 = wat-infected-tunnels-open-chain-door-combat-finish--door;
                    } else {
                        var_1 = wat-infected-tunnels-open-chain-door-finish--door;
                    }
                    u64? var_2 = #%alloc-array(single-frame, 16, 3, 1);
                    *(i32*)*var_2[0] = 10;
                    *(u64*)(*var_2[0] + 8) = 0;
                    *(u64*)(*var_2[0] + 8) = get-spawner-locator(ap-wat-chain-door-1, 1);
                    *(i32*)*var_2[1] = 28;
                    *(u64*)(*var_2[1] + 8) = 0;
                    *(f32*)(*var_2[1] + 8) = 0.50;
                    *(i32*)*var_2[2] = 30;
                    *(u64*)(*var_2[2] + 8) = 0;
                    *(f32*)(*var_2[2] + 8) = 0.50;
                    wait-animate_(obj-wat-chain-door-1, var_1, var_2);
                }
                lambda {
                    signal(door-closed, 0);
                }
            }
            track chain {
                lambda {
                    sid var_1;
                    if (get-boolean(in-combat?, self)) {
                        var_1 = wat-infected-tunnels-open-chain-door-combat-finish--chain;
                    } else {
                        var_1 = wat-infected-tunnels-open-chain-door-finish--chain;
                    }
                    u64? var_2 = #%alloc-array(single-frame, 16, 3, 1);
                    *(i32*)*var_2[0] = 10;
                    *(u64*)(*var_2[0] + 8) = 0;
                    *(u64*)(*var_2[0] + 8) = get-spawner-locator(ap-wat-chain-door-1, 1);
                    *(i32*)*var_2[1] = 28;
                    *(u64*)(*var_2[1] + 8) = 0;
                    *(f32*)(*var_2[1] + 8) = 0.00;
                    *(i32*)*var_2[2] = 30;
                    *(u64*)(*var_2[2] + 8) = 0;
                    *(f32*)(*var_2[2] + 8) = 0.00;
                    animate_(obj-wat-chain-door-chain-1, var_1, var_2);
                }
            }
            track crate {
                lambda {
                    sid var_1;
                    if (get-boolean(in-combat?, self)) {
                        var_1 = wat-infected-tunnels-open-chain-door-combat-finish--crate;
                    } else {
                        var_1 = wat-infected-tunnels-open-chain-door-finish--crate;
                    }
                    u64? var_2 = #%alloc-array(single-frame, 16, 1, 1);
                    *(i32*)*var_2[0] = 10;
                    *(u64*)(*var_2[0] + 8) = 0;
                    *(u64*)(*var_2[0] + 8) = get-spawner-locator(ap-wat-chain-door-1, 1);
                    animate_(obj-wat-chain-door-box-1, var_1, var_2);
                }
            }
            track vox {
                lambda {
                    send-event(vox-chain-door-finish, ss-vox-wat-infected-tunnels-shambler-intro-fight-1);
                }
                lambda {
                    if (get-boolean(in-combat?, self)) {
                        say(player, vox-igc-ell-igc-wat-infected-tunnels-open-chain-door-hold-combat-001, 2, 0);
                    } else {
                        say(player, vox-igc-ell-igc-wat-infected-tunnels-open-chain-door-hold-combat-done-001, 2, 0);
                    }
                }
                lambda {
                    if (get-boolean(in-combat?, self)) {
                        say(dina, vox-igc-din-igc-wat-infected-tunnels-open-chain-door-hold-combat-001, 2, 0);
                    } else {
                        say(dina, vox-igc-din-igc-wat-infected-tunnels-open-chain-door-hold-combat-done-001, 2, 0);
                    }
                }
                lambda {
                    if (get-boolean(in-combat?, self)) {
                        send-event(vox-facility-start-tense, ss-vox-wat-infected-tunnels-facility-explore-1);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    joypad-disable-commands(prone-toggle, jump);
                }
                lambda {
                    treat-character-as-uninterruptible(player);
                }
                lambda {
                    player-disable-full-body-hit-reactions(1);
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    kill-entity(int-wat-chain-door-1);
                }
                lambda {
                    kill-entity(int-wat-chain-door-combat-done-1);
                }
                lambda {
