                lambda {
                    animate-done(obj-wat-chain-door-box-1, wat-infected-tunnels-open-chain-door-finish--crate, ap-wat-chain-door-1, 0, 0, 2);
                }
                lambda {
                    if (task-continue-active?(watchtower, wat-infected-tunnels-facility-explore, default)) {
                        go(complete, 1);
                    }
                }
            }
