u64? set-rifles() {
    set-symbol(rifle-t, npc-get-weapon-process-id(tommy), self);
    return set-symbol(rifle-e, get-player-weapon-process-id-from-weapon-id(rifle-remington-bolt), self);
}

u64? detach-rifles() {
    detach-without-physicalizing(get-symbol(rifle-t, self), 0.00);
    return detach-without-physicalizing(get-symbol(rifle-e, self), 0.00);
}

