                }
                lambda {
                    wait-until-anim-frame(tommy, efp-tommy-gives-rifle-end--tommy, 207.00, 2);
                }
                lambda {
                    set-boolean(tommy-has-rifle-e?, 1, self);
                }
            }
            track haptics {
                lambda {
                    if (joypad-has-haptics?(2)) {
                        wait-until-anim-frame(player, efp-tommy-gives-rifle-end--ellie, 148.00, 2);
                        play-hfx-id(touch-soft-left, 0, 2);
                        wait-until-anim-frame(player, efp-tommy-gives-rifle-end--ellie, 166.00, 2);
                        play-hfx-id(climb-hand-right-light-rumble-settings, 0, 2);
                        wait-until-anim-frame(player, efp-tommy-gives-rifle-end--ellie, 182.00, 2);
                        play-hfx-id(touch-soft-left, 0, 2);
                        wait-until-anim-frame(player, efp-tommy-gives-rifle-end--ellie, 226.00, 2);
                        play-hfx-id(climb-hand-left-light-rumble-settings, 0, 2);
                        wait-until-anim-frame(player, efp-tommy-gives-rifle-end--ellie, 238.00, 2);
                        play-hfx-id(climb-hand-right-light-rumble-settings, 0, 2);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (!(get-boolean(ellie-has-rifle-t?, self))) {
                        photo-mode-fake-character/f(get-symbol(rifle-t, self), 2);
                        photo-mode-fake-character/f(get-weapon-strap-process-id(get-symbol(rifle-t, self)), 2);
                    } else {
                        photo-mode-fake-character/f(get-symbol(rifle-t, self), 1);
                        photo-mode-fake-character/f(get-weapon-strap-process-id(get-symbol(rifle-t, self)), 1);
                    }
                }
                lambda {
                    if (!(get-boolean(tommy-has-rifle-e?, self))) {
                        photo-mode-fake-character/f(get-symbol(rifle-e, self), 1);
                        photo-mode-fake-character/f(get-weapon-strap-process-id(get-symbol(rifle-e, self)), 1);
                    } else {
                        photo-mode-fake-character/f(get-symbol(rifle-e, self), 2);
                        photo-mode-fake-character/f(get-weapon-strap-process-id(get-symbol(rifle-e, self)), 2);
                    }
                }
                lambda {
                    override-render-settings(
                        *efp-rs-efp-walking-with-tommy-handoff-igc*,
                        1.00,
                        1.00,
                        0,
                        32767,
                        0,
                        1,
                        0,
                        1.00
                    );
                }
            }
        }
        block end {
            track main {
                lambda {
                    send-event(enable-character-collision, get-weapon-strap-process-id(get-symbol(rifle-t, self)));
                }
            }
        }
    }
}
