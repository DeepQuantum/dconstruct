    state initial {
        block start {
            track main {
                lambda {
                    while (!is-script-running?(ss-encounter-manager-1)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    set-symbol(w-map-info-panel, template--get-widget-root(*(u64*)template--get-current-run-template()), self);
                }
                lambda {
                    set-symbol(w-map-info-panel-ref, symbol-concat-string(get-symbol(w-map-info-panel, self), ".reference"), self);
                }
                lambda {
                    set-symbol(w-animGroup, gui2-find-widget-path("anim-group", self), self);
