                    wait-rumble-curve(0.43, 0.43, 0.10, 2, 0);
                }
                lambda {
                    wait-rumble-curve(0.43, 0.50, 0.10, 2, 0);
                }
                lambda {
                    wait-rumble-curve(0.50, 0.00, 0.10, 2, 0);
                }
            }
            track sound {
                lambda {
                    wait-until-anim-frame(npc-ratking-bloater-1, ratking-death--ratking, 209.00, 2);
                }
                lambda {
                    t2r-ratking-death-play-positioned-sfx();
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (npc-alive?(npc-superstalker-2)) {
                        send-event(force-disengage, npc-superstalker-2);
                    }
                }
                lambda {
                    set-player-invincible();
                }
                lambda {
                    if (!(get-boolean(anim-done?, self))) {
                        joypad-disable-all-commands();
                        set-invisible/f(buddy--get-current-buddy());
                        set-vector(camera-direction, vector-between-locators(get-bound-frame(camera-starting-loc, self), get-object-locator(npc-ratking-bloater-1)), self);
                        set-object-locator(obj-flashlight-target-1, get-object-locator(npc-ratking-bloater-1));
                        flashlight-override-pos(player-get-flashlight(), get-object-position(t2r-ic-split-light-parent-1));
                        flashlight-override-dir(player-get-flashlight(), get-local-z(get-object-rotation(t2r-ic-split-light-parent-1)));
                        override-render-settings(
                            *med-rs-med-096-ss-on*,
                            0.00,
                            0.00,
                            0,
                            32767,
                            0,
                            1,
                            0,
                            1.00
                        );
                    }
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    spawn-entity(npc-ratking-bloater-1, 0, 0);
                }
                lambda {
                    npc-set-ragdoll-allowed(npc-ratking-bloater-1, 0, 1);
                }
                lambda {
                    set-bound-frame(bloater-ap, get-ap-ref-from-align(npc-ratking-bloater-1, ratking-death--ratking, get-object-locator(npc-ratking-bloater-1), 1.00, apReference, 0), self);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 5, 1);
                    *(i32*)*(*var_0 + (0 * 8)) = 10;
                    *(u64*)(*(*var_0 + (0 * 8)) + 8) = 0;
                    *(u64*)(*(*var_0 + (0 * 8)) + 8) = get-bound-frame(bloater-ap, self);
                    *(i32*)*(*var_0 + (1 * 8)) = 28;
                    *(u64*)(*(*var_0 + (1 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (1 * 8)) + 8) = 0.00;
                    *(i32*)*(*var_0 + (2 * 8)) = 58;
                    *(u64*)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (2 * 8)) + 8) = 1.00;
                    *(i32*)*(*var_0 + (3 * 8)) = 56;
                    *(u64*)(*(*var_0 + (3 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (3 * 8)) + 8) = 0.00;
                    *(i32*)*(*var_0 + (4 * 8)) = 86;
                    *(u64*)(*(*var_0 + (4 * 8)) + 8) = 0;
                    *(u8*)(*(*var_0 + (4 * 8)) + 8) = 1;
                    animate_(npc-ratking-bloater-1, ratking-death--ratking, var_0);
                }
                lambda {
                    npc-die(npc-ratking-bloater-1, 1, 0, 1, 1);
                }
                lambda {
                    spawn-entity-at(obj-bloater-block-cyl-2, offset-locator(get-bound-frame(bloater-ap, self), alloc-vector(-1.80, 0.00, 1.70, 1.00, 0)), 0);
