                        set-svar-as-boolean(tut-hub-intro, 1);
                        go(empty-state, 1);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    joypad-disable-all-commands-except(menu-select-vc);
                }
                lambda {
                    joypad-disable-commands(pause);
                }
            }
        }
    }
    state tutorialize-reminder {
        block start {
            track main {
                lambda {
                    if (!(get-svar-as-boolean(tut-hub-return)) && get-svar(encounter-depth) == 1) {
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-reward-cache*, 2, 2, 2);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-vendor*, 2, 2, 2);
                        log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                        set-svar-as-boolean(tut-hub-return, 1);
                    }
                }
                lambda {
                    set-symbol(nav-assist-point-name, HUD_ROGUE_REWARD_CRATE_TITLE, self);
                }
                lambda {
                    set-symbol(nav-assist-point-symbol, acc-reward-box-1, self);
                }
                lambda {
                    hud2-play-tutorial(get-symbol(nav-assist-point-name, self), 2.00, jump, "hud/player-menu/collectibles-tab.png", 1, 0, 0, 1);
                }
                lambda {
                    set-accessibility-pathfind-goal(get-symbol(nav-assist-point-symbol, self));
                }
                lambda {
                    go(empty-state, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    joypad-disable-all-commands();
                }
                lambda {
                    if (!(get-svar-as-boolean(tut-hub-intro))) {
                        fade-to-black(0.00, 1.00, 0.00, 0);
                    }
                }
            }
        }
    }
    state tutorialize-death {
        block start {
            track main {
                lambda {
                    hud2-play-tutorial(HUD_TUTORIAL_ROGUE_DEATH_INTRO_01, 5.00, 0, 0, 1, 0, 0, 0);
                }
                lambda {
                    hud2-play-tutorial(HUD_TUTORIAL_ROGUE_DEATH_INTRO_02, 5.00, 0, 0, 1, 0, 0, 0);
                }
                lambda {
                    set-svar-as-boolean(tut-first-death, 1);
                }
                lambda {
                    mark-tutorial-unlocked-by-cipher-id(HUD_TUTORIAL_ROGUE_TITLE_DEATH_LC, 1);
                }
            }
        }
    }
    state  {
    }
    state map-table-enter {
        block start {
            track player {
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("(((((((((((((Self ID = %s", string-debug(get-self-id())), 19);
                    }
                }
                lambda {
                    while (!get-boolean(bow-unholster-active?, self) && !((get-current-time(0) - get-current-time(0)) > 1.00)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    set-boolean(bow-unholster-active?, 0, self);
                }
                lambda {
                    sid var_1;
                    if (task-active?(t2r-hub-proto, t2r-theater-hub)) {
                        var_1 = t2r-hub-theater-map-board-enter;
                    } else {
                        var_1 = t2r-hub-aquarium-map-board-enter;
                    }
                    wait-player-move-to-entry(
                        var_1,
                        get-spawner-locator(pos-map-table-player-1, 1),
                        1,
                        0,
                        0.48,
                        apReference-camera1,
                        apReference,
                        0.00,
                        0,
                        1,
                        0,
                        1,
                        0.00,
                        0,
                        1
                    );
                }
                lambda {
                    signal(camera-start, 0);
                }
                lambda {
                    sid var_1;
                    if (task-active?(t2r-hub-proto, t2r-theater-hub)) {
                        var_1 = t2r-hub-theater-map-board-enter;
                    } else {
                        var_1 = t2r-hub-aquarium-map-board-enter;
                    }
                    u64? var_2 = #%alloc-array(single-frame, 16, 4, 1);
                    *(i32*)*var_2[0] = 10;
                    *(u64*)(*var_2[0] + 8) = 0;
                    *(u64*)(*var_2[0] + 8) = get-spawner-locator(pos-map-table-player-1, 1);
                    *(i32*)*var_2[1] = 28;
                    *(u64*)(*var_2[1] + 8) = 0;
                    *(f32*)(*var_2[1] + 8) = 0.50;
                    *(i32*)*var_2[2] = 30;
                    *(u64*)(*var_2[2] + 8) = 0;
                    *(f32*)(*var_2[2] + 8) = 0.00;
                    *(i32*)*var_2[3] = 54;
                    *(u64*)(*var_2[3] + 8) = 0;
                    *(f32*)(*var_2[3] + 8) = 0.05;
                    wait-animate_(player, var_1, var_2);
                }
                lambda {
                    sid var_1;
                    if (task-active?(t2r-hub-proto, t2r-theater-hub)) {
                        var_1 = t2r-hub-theater-map-board-idle;
                    } else {
                        var_1 = t2r-hub-aquarium-map-board-idle;
                    }
                    u64? var_2 = #%alloc-array(single-frame, 16, 3, 1);
                    *(i32*)*var_2[0] = 10;
                    *(u64*)(*var_2[0] + 8) = 0;
                    *(u64*)(*var_2[0] + 8) = get-spawner-locator(pos-map-table-player-1, 1);
                    *(i32*)*var_2[1] = 28;
                    *(u64*)(*var_2[1] + 8) = 0;
                    *(f32*)(*var_2[1] + 8) = 0.00;
                    *(i32*)*var_2[2] = 30;
                    *(u64*)(*var_2[2] + 8) = 0;
                    *(f32*)(*var_2[2] + 8) = 0.00;
                    animate_(player, var_1, var_2);
                }
                lambda {
                    wait-for(camera-done);
                }
                lambda {
                    wait-for(hud-on);
                }
                lambda {
                    go(map-table-idle, 1);
                }
            }
            track camera {
                lambda {
                    wait-for(camera-start);
                }
                lambda {
                    camera-enable-animated(1.00, -1.00, 1, 1000, 0, 0, 0);
                }
                lambda {
                    wait(0.50);
                }
                lambda {
                    broadcast-event(entering-map-table);
                }
                lambda {
                    signal(camera-done, 0);
                }
            }
            track hud {
                lambda {
                    hud2-clear-tutorials(0);
                }
                lambda {
                    wait-for(camera-start);
                }
                lambda {
                    wait(0.90);
                }
                lambda {
                    set-symbol(map-table-path, menu2-push-page(hudMenuStack, "pc/t2r-hud-rogue/t2r-map-table-template-1-pc", 0), self);
                }
                lambda {
                    while (!gui2-widget-exists?(get-symbol(map-table-path, self))) {
                        wait-one-frame();
                    }
                }
                lambda {
                    signal(hud-on, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    use-esc-for-back/f();
                }
                lambda {
                    joypad-disable-commands(flashlight-toggle, fire, move, weapon-cross);
                }
                lambda {
                    hud2-suppress-reminders/f();
                }
                lambda {
                    hud2-hide-health-ammo/f(0, 0);
                }
            }
        }
        block event regen-run {
            track main {
                lambda {
                    wait-one-frame();
                }
                lambda {
                    broadcast-event(entering-map-table);
                }
            }
        }
    }
    state map-table-idle {
        block start {
            track main {
                lambda {
                    set-boolean(looking-at-map?, 1, self);
                }
                lambda {
                    while (!!hud-tutorial-active?(0)) {
                        wait-one-frame();
                    }
                }
            }
            track fg-signal {
                lambda {
                    wait-boolean(looking-at-map?, 1, self);
                }
                lambda {
                    wait(0.25 - get-delta-time());
                }
                lambda {
                    send-event(in-map-table, ss-map-table-fg-controller-1);
                }
            }
        }
        block event rogue-fading-into-map-encounter {
            track main {
                lambda {
                    go(waiting-on-encounter-fade, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    joypad-disable-commands(flashlight-toggle, fire, move, weapon-cross, crouch);
                }
                lambda {
                    if (get-boolean(looking-at-map?, self) == 1 || !gui2-widget-in-state?(get-symbol(map-table-path, self), active, 0) && gui2-widget-exists?(get-symbol(map-table-path, self)) == 0) {
                        set-boolean(looking-at-map?, 0, self);
                        go(map-table-exit, 1);
                    }
                }
            }
        }
        block event regen-run {
            track main {
                lambda {
                    wait-one-frame();
                }
                lambda {
                    send-event(in-map-table, ss-map-table-fg-controller-1);
                }
            }
        }
        block end {
            track main {
                lambda {
                    log-rogue-inventory-stats(1);
                }
            }
        }
    }
    state  {
    }
    state map-table-exit {
        block start {
            track player {
                lambda {
                    wait-for(start-exit);
                }
                lambda {
                    if (task-active?(t2r-hub-proto, t2r-theater-hub)) {
                        u64? var_1 = #%alloc-array(single-frame, 16, 5, 1);
                        *(i32*)*var_1[0] = 10;
                        *(u64*)(*var_1[0] + 8) = 0;
                        *(u64*)(*var_1[0] + 8) = get-spawner-locator(pos-map-table-player-1, 1);
                        *(i32*)*var_1[1] = 28;
                        *(u64*)(*var_1[1] + 8) = 0;
                        *(f32*)(*var_1[1] + 8) = 0.25;
                        *(i32*)*var_1[2] = 30;
                        *(u64*)(*var_1[2] + 8) = 0;
                        *(f32*)(*var_1[2] + 8) = 0.80;
                        *(i32*)*var_1[3] = 61;
                        *(u64*)(*var_1[3] + 8) = 0;
                        *(i32*)(*var_1[3] + 8) = 50;
                        *(i32*)*var_1[4] = 60;
                        *(u64*)(*var_1[4] + 8) = 0;
                        *(f32*)(*var_1[4] + 8) = 0.50;
                        animate_(player, t2r-hub-theater-map-board-exit, var_1);
                    } else {
                        u64? var_3 = #%alloc-array(single-frame, 16, 4, 1);
                        *(i32*)*var_3[0] = 10;
                        *(u64*)(*var_3[0] + 8) = 0;
                        *(u64*)(*var_3[0] + 8) = get-spawner-locator(pos-map-table-player-1, 1);
                        *(i32*)*var_3[1] = 28;
                        *(u64*)(*var_3[1] + 8) = 0;
                        *(f32*)(*var_3[1] + 8) = 0.25;
                        *(i32*)*var_3[2] = 30;
                        *(u64*)(*var_3[2] + 8) = 0;
                        *(f32*)(*var_3[2] + 8) = 0.80;
                        *(i32*)*var_3[3] = 61;
                        *(u64*)(*var_3[3] + 8) = 0;
                        *(i32*)(*var_3[3] + 8) = 35;
                        animate_(player, t2r-hub-aquarium-map-board-exit, var_3);
                    }
                }
                lambda {
                    signal(player-done, 0);
                }
            }
            track light {
                lambda {
                    wait-for(camera-map-fade);
                }
                lambda {
                    broadcast-event(exiting-map-table);
                }
            }
            track flashlight {
                lambda {
                    wait(0.60);
                }
                lambda {
                    set-boolean(player-flashlight-on?, 0, self);
                }
                lambda {
                    turn-off-flashlight(player, 0);
                }
                lambda {
                    signal(flashlight-done, 0);
                }
            }
            track camera {
                lambda {
                    signal(camera-map-fade, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    signal(start-exit, 0);
                }
                lambda {
                    camera-fade-out-animated(2.00, 0);
                }
                lambda {
                    signal(camera-done, 0);
                }
            }
            track map {
                lambda {
                    signal(map-done, 0);
                }
            }
            track interact {
                lambda {
                    wait-for(map-done);
                }
                lambda {
                    wait-for(flashlight-done);
                }
                lambda {
                    wait-for(camera-done);
                }
                lambda {
                    wait-for(player-done);
                }
                lambda {
                    interactable-enable(int-map-table-1);
                }
                lambda {
                    broadcast-event(exited-map-table);
                }
            }
        }
        block event regen-run {
            track main {
                lambda {
                    wait-one-frame();
                }
                lambda {
                    broadcast-event(exiting-map-table);
                }
            }
        }
    }
    state waiting-on-post-flow {
        block start {
            track main {
                lambda {
                    set-boolean(waiting-for-post-flow?, 1, self);
                }
            }
        }
    }
}
