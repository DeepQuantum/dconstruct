                lambda {
                    broadcast-event(encounter-complete);
                }
            }
            track music {
                lambda {
                    while (!(get-int32(defense-wrapup-time, self) <= 3)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    play-music-stinger(*music-playlist-rogue-encounter-complete*, 0);
                }
            }
            track holdout-trophy {
                lambda {
                    if (!get-svar-as-boolean(rogue-cheat-mod-ever-enabled) && get-int32(def-wounded-health-current, self) >= 70) {
                        increment-stat(trophy-holdout-ally, 1);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    set-tension-mode(1);
                }
                lambda {
                    if (get-int32(defense-wrapup-time, self) < 2) {
                        set-focusable-ignore/f(player);
                    }
                }
                lambda {
                    if (entity-exists?(ss-chained-infected-manager-1)) {
                        if (closest-distance-to-any-chained-inf() < 15.00) {
                            set-walk-type(walk-tense);
                            set-run-type(run-tense);
                            set-sprint-type(sprint-tense);
                        }
                    }
                }
                lambda {
                    if (get-int32(defense-wrapup-time, self) < 6) {
                        hud2-suppress-reminders/f();
                    }
                }
            }
        }
    }
}
