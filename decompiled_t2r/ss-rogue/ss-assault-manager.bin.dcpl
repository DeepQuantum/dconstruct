                                display(dc:format("DEB-AM:      -> %s", string-debug(var_14)), 19);
                            }
                        }
                    }
                }
            }
            track tutorial {
                lambda {
                    if (!get-svar-as-boolean(tut-assault-lockbox)) {
                        wait(3.00);
                        set-svar-as-boolean(tut-assault-lockbox, 1);
                    }
                }
            }
            track reminder {
                lambda {
                    if (get-svar-as-boolean(tut-assault-lockbox)) {
                        hud2-request-reminder(*listen-mode-supplies-reminder*, 0);
                    }
                }
                lambda {
                    wait(3.00);
                }
                lambda {
                    if (!hud-tutorial-active?(8)) {
                        hud2-request-reminder(*reload-reminder-rogue*, 0);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    disallow-normal-tension();
                }
            }
        }
    }
    state assault-complete-success {
        block start {
            track main {
                lambda {
                    hud-assault-destroy();
                }
                lambda {
                    send-event(vox-match-end, ss-vox-rl-encounter-controller-1);
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    broadcast-event(encounter-combat-complete);
                }
                lambda {
                    play-sound(sfx-rl-round-end-win, 0);
                }
                lambda {
                    wait(0.50);
                }
                lambda {
                    hud-encounter-over-create(ENCOUNTER_MISSION_COMPLETE, t2-yellow, 1);
                }
                lambda {
                    hud-encounter-over-fade-in();
                }
                lambda {
                    wait(5.00);
                }
                lambda {
                    set-int32(assault-wrapup-time, get-int32(assault-wrapup-time, self) - 5, self);
                }
                lambda {
                    hud-encounter-over-fade-out();
                }
                lambda {
                    hud-message-timer-show(ENCOUNTER_MISSION_EXIT_ALT_CAPS, *invalid-symbol*, (f32)get-int32(assault-wrapup-time, self), 0, 0);
                }
                lambda {
                    while (get-int32(assault-wrapup-time, self) > 0) {
                        if (timer-done?(acc-time-repeat-timer, self) && !text-to-speech-playing?() && !(hud-tutorial-active?(0)) && mod-int32(get-int32(assault-time-countdown, self), 5) == 0) {
                            start-timer(acc-time-repeat-timer, 5.00, self, 1);
                        }
                        wait(1.00);
                        --(assault-wrapup-time, self);
                    }
                }
                lambda {
                    broadcast-event(encounter-complete);
                }
            }
            track music {
                lambda {
                    while (!(get-int32(assault-wrapup-time, self) <= 3)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    play-music-stinger(*music-playlist-rogue-encounter-complete*, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (get-boolean(is-encounter-manager-task?, ss-wave-manager-level-set-loader-1)) {
                        if (get-boolean(no-sprint, self)) {
                            joypad-disable-commands(sprint);
                        }
                        if (get-boolean(no-move, self)) {
                            joypad-disable-all-commands();
                        }
                    }
                }
                lambda {
                    if (get-int32(assault-wrapup-time, self) < 2) {
                        set-focusable-ignore/f(player);
                    }
                }
                lambda {
                    if (entity-exists?(ss-chained-infected-manager-1)) {
                        if (closest-distance-to-any-chained-inf() < 15.00) {
                            set-walk-type(walk-tense);
                            set-run-type(run-tense);
                            set-sprint-type(sprint-tense);
                        }
                    }
                }
                lambda {
                    if (get-int32(assault-wrapup-time, self) < 6) {
                        hud2-suppress-reminders/f();
                    }
                }
                lambda {
                    if (get-int32(assault-wrapup-time, self) < 3) {
                        foreach (u64? var_5 : get-symbol(group-available-workbenches, self)) {
                            interactable-disable(var_5);
                        }
                    }
                }
            }
        }
    }
}
