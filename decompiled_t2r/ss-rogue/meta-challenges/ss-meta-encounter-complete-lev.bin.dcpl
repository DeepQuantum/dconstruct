statescript {
    options {
        player
    }
    state tracking {
        block event encounter-combat-complete {
            track main {
                lambda {
                    if (rogue-get-player-character() == 4) {
                        increment-svar(meta-encounter-complete-lev-count, 1);
                        t2r-meta-trial-updates-add(meta-encounter-complete-lev);
                    }
                }
                lambda {
                    if (get-svar(meta-encounter-complete-lev-count) >= 3) {
                        go(completed, 1);
                    }
                }
            }
        }
        block event force-meta-complete {
            track main {
                lambda {
                    go(completed, 1);
                }
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda {
                    if (print-meta-debug()) {
                        if (!is-final-build?()) {
                            display(dc:format("Encounter Complete Lev Trial Complete"), 19);
                        }
                        debug-draw-string-2d(
                            alloc-point(315.00, 400.00, 0.00, 0),
                            "Challenge Completed",
                            7,
                            5.00,
                            4.00,
                            1,
                            0,
                            0,
                            1.00
                        );
                    }
                }
                lambda {
                    request-meta-complete-notification(meta-encounter-complete-lev);
                }
                lambda {
                    log-event("meta trial complete", 0, "encounter complete lev", 0, 0);
                }
                lambda {
                    broadcast-event(meta-challenge-complete-abby);
                }
                lambda {
                    set-svar-as-boolean(meta-encounter-complete-lev, 1);
                }
                lambda {
                    t2r-meta-trial-updates-add(meta-encounter-complete-lev);
                }
                lambda {
                    player-unlock-character(yara, 1);
                }
                lambda {
                    set-stat-bit(trophy-unlock-all-characters, 6);
