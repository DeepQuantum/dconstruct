statescript {
    options {
        player
    }
    state tracking {
        block event player-craft-item {
            track main {
                lambda {
                    set-svar(meta-melee-weapon-upgrade-count, 1 + get-svar(meta-melee-weapon-upgrade-count));
                }
                lambda {
                    t2r-meta-trial-updates-add(meta-abby-upgrade-path);
                }
                lambda {
                    if (get-svar(meta-melee-weapon-upgrade-count) >= 3) {
                        go(completed, 1);
                    }
                }
            }
        }
        block event force-meta-complete {
            track main {
                lambda {
                    go(completed, 1);
                }
            }
        }
        block event rogue-run-complete {
            track main {
                lambda {
                    set-svar(meta-melee-weapon-upgrade-count, 0);
                }
            }
        }
        block event run-failed-disable-win {
            track main {
                lambda {
                    set-svar(meta-melee-weapon-upgrade-count, 0);
                }
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda {
                    if (print-meta-debug()) {
                        if (!is-final-build?()) {
                            display(dc:format("Abby Upgrade Path Trial Complete"), 19);
                        }
                        debug-draw-string-2d(
                            alloc-point(315.00, 400.00, 0.00, 0),
                            "Challenge Completed",
                            7,
                            5.00,
                            4.00,
                            1,
                            0,
                            0,
                            1.00
                        );
                    }
                }
                lambda {
                    request-meta-complete-notification(meta-abby-upgrade-path);
                }
                lambda {
                    log-event("meta trial complete", 0, "abby upgrade path", 0, 0);
                }
                lambda {
                    broadcast-event(meta-challenge-complete-abby);
                }
                lambda {
                    set-svar-as-boolean(meta-abby-upgrade-path, 1);
                }
                lambda {
                    set-svar-as-boolean(player-skins-abby-tracking-patch, 1);
                }
                lambda {
                    increment-svar(meta-num-skins-unlocked, 1);
                }
                lambda {
                    t2r-meta-trial-updates-add(meta-abby-upgrade-path);
                }
                lambda {
                    kill-entity(self);
                }
            }
        }
    }
}
