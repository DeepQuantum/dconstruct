                    wait-frames(5);
                }
                lambda {
                    camera-fade-out-animated(2.00, 0);
                }
                lambda {
                    wait-frames(17);
                }
                lambda {
                    set-boolean(self-shadow, 1, self);
                }
            }
            track backup {
                lambda {
                    wait(0.20);
                }
                lambda {
                    stop-animating(player, 1, 0.20, tag-symbol(cw-part-ellie, self), 0);
                }
                lambda {
                    stop-animating(player, 1, 0.20, tag-symbol(ccw-part-ellie, self), 0);
                }
                lambda {
                    stop-animating(player, 1, 0.20, tag-symbol(slo-part-ellie, self), 0);
                }
                lambda {
                    signal(camera-done, 0);
                }
            }
            track hud {
                lambda {
                    if (gui2-widget-exists?(get-symbol(w-minigame-hud, self))) {
                        hud2-hide-lock-minigame(get-symbol(w-minigame-hud, self), 1);
                        set-symbol(w-minigame-hud, 0, self);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    camera-override-near-clip/f(0.01);
                }
                lambda {
                    if (!get-boolean(self-shadow, self)) {
                        if (player-flashlight-on?()) {
                            enable-player-flashlight-shadows/f();
                            player-flashlight-override-near-clip/f(0.10);
                        }
                    }
                }
            }
        }
    }
    state attacked-out {
        block start {
            track main {
                lambda {
                    log-event("safe-attacked-out", 1, string-debug(get-self-id()), 0, 0);
                }
                lambda {
                    accessibility-set-custom-state(0, 0);
                }
                lambda {
                    hud-clear-tutorials(0);
                }
                lambda {
                    camera-fade-out-animated(1.00, 0);
                }
                lambda {
                    stop-animating(player, 2, 0.50, 0, 0);
                }
                lambda {
                    if (gui2-widget-exists?(get-symbol(w-minigame-hud, self))) {
                        hud2-hide-lock-minigame(get-symbol(w-minigame-hud, self), 1);
                        set-symbol(w-minigame-hud, 0, self);
                    }
                }
                lambda {
                    wait(0.20);
                }
                lambda {
                    stop-animating(player, 1, 0.20, tag-symbol(cw-part-ellie, self), 0);
                }
                lambda {
                    stop-animating(player, 1, 0.20, tag-symbol(ccw-part-ellie, self), 0);
                }
                lambda {
                    stop-animating(player, 1, 0.20, tag-symbol(slo-part-ellie, self), 0);
                }
                lambda {
                    set-boolean(should-cw, 1, self);
                }
                lambda {
                    set-float(my-code, 0.00, self);
                }
                lambda {
                    set-int32(code-length, 0, self);
                }
                lambda {
                    set-float(last-deflect, -1.00, self);
                }
                lambda {
                    set-boolean(player-interacting-with-safe, 0, self);
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    go(wait-interact, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    camera-override-near-clip/f(0.01);
                }
                lambda {
                    if (!get-boolean(self-shadow, self)) {
                        if (player-flashlight-on?()) {
                            enable-player-flashlight-shadows/f();
                            player-flashlight-override-near-clip/f(0.10);
                        }
                    }
                }
            }
        }
    }
    state attacked-out-safe-close {
        block start {
            track main {
                lambda {
                    log-event("safe-attacked-out", 1, string-debug(get-self-id()), 0, 0);
                }
                lambda {
                    accessibility-set-custom-state(0, 0);
                }
                lambda {
                    hud-clear-tutorials(0);
                }
                lambda {
                    camera-fade-out-animated(1.00, 0);
                }
                lambda {
                    stop-animating(player, 2, 0.50, 0, 0);
                }
                lambda {
                    if (gui2-widget-exists?(get-symbol(w-minigame-hud, self))) {
                        hud2-hide-lock-minigame(get-symbol(w-minigame-hud, self), 1);
                        set-symbol(w-minigame-hud, 0, self);
                    }
                }
                lambda {
                    wait(0.20);
                }
                lambda {
                    stop-animating(player, 1, 0.20, tag-symbol(cw-part-ellie, self), 0);
                }
                lambda {
                    stop-animating(player, 1, 0.20, tag-symbol(ccw-part-ellie, self), 0);
                }
                lambda {
                    stop-animating(player, 1, 0.20, tag-symbol(slo-part-ellie, self), 0);
                }
                lambda {
                    set-boolean(should-cw, 1, self);
                }
                lambda {
                    set-float(my-code, 0.00, self);
                }
                lambda {
                    set-int32(code-length, 0, self);
                }
                lambda {
                    set-float(last-deflect, -1.00, self);
                }
                lambda {
                    set-boolean(player-interacting-with-safe, 0, self);
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    go(wait-interact, 1);
                }
            }
            track safe {
                lambda {
                    sid var_2;
                    if (tag-boolean(flatten-on-1?, self)) {
                        var_2 = ellie-systemic-safe-open-success-long--safe;
                    } else {
                        var_2 = tag-symbol(succ-anim-safe, self);
                    }
                    get-animation-phase(get-self-id(), 2, var_2);
                }
                lambda {
                    sid var_2;
                    if (tag-boolean(flatten-on-1?, self)) {
                        var_2 = ellie-systemic-safe-open-success-long--safe;
                    } else {
                        var_2 = tag-symbol(succ-anim-safe, self);
                    }
                    u64? var_4 = #%alloc-array(single-frame, 16, 5, 1);
                    *(i32*)*var_4[0] = 10;
                    *(u64*)(*var_4[0] + 8) = 0;
                    *(u64*)(*var_4[0] + 8) = get-spawner-locator(self, 1);
                    *(i32*)*var_4[1] = 28;
                    *(u64*)(*var_4[1] + 8) = 0;
                    *(f32*)(*var_4[1] + 8) = 0.50;
                    *(i32*)*var_4[2] = 30;
                    *(u64*)(*var_4[2] + 8) = 0;
                    *(f32*)(*var_4[2] + 8) = 0.50;
                    *(i32*)*var_4[3] = 58;
                    *(u64*)(*var_4[3] + 8) = 0;
                    sid var_8;
                    if (tag-boolean(flatten-on-1?, self)) {
                        var_8 = ellie-systemic-safe-open-success-long--safe;
                    } else {
                        var_8 = tag-symbol(succ-anim-safe, self);
                    }
                    *(f32*)(*var_4[3] + 8) = get-animation-phase(get-self-id(), 2, var_8);
                    *(i32*)*var_4[4] = 56;
                    *(u64*)(*var_4[4] + 8) = 0;
                    *(f32*)(*var_4[4] + 8) = -1.00;
                    animate_(get-self-id(), var_2, var_4);
                }
            }
        }
        block update {
            track main {
                lambda {
                    camera-override-near-clip/f(0.01);
                }
                lambda {
                    if (!get-boolean(self-shadow, self)) {
                        if (player-flashlight-on?()) {
                            enable-player-flashlight-shadows/f();
                            player-flashlight-override-near-clip/f(0.10);
                        }
                    }
                }
            }
        }
    }
    state siege-complete {
        block start {
            track main {
                lambda {
                    interactable-disable(get-self-id());
                }
                lambda {
                    u64 i = 0;
                    while (i < 5) {
                        if (!(tag-symbol(symbol-concat-int32(item-, i + 1), self) == 0)) {
                            spawn-entity(tag-symbol(symbol-concat-int32(item-, i + 1), self), 0, 0);
                        }
                        i = i + 1;
                    }
                }
                lambda {
                    if (tag-specified?(nav-blocker, self)) {
                        enable-nav-blocker-object(tag-symbol(nav-blocker, self));
                    }
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    interactable-disable(get-self-id());
                }
                lambda {
                    u64? var_1 = #%alloc-array(single-frame, 16, 2, 1);
                    *(i32*)*var_1[0] = 56;
                    *(u64*)(*var_1[0] + 8) = 0;
                    *(f32*)(*var_1[0] + 8) = 0.00;
                    *(i32*)*var_1[1] = 58;
                    *(u64*)(*var_1[1] + 8) = 0;
                    *(f32*)(*var_1[1] + 8) = 1.00;
                    animate_(get-self-id(), door-anim, var_1);
                }
                lambda {
                    if (tag-specified?(nav-blocker, self)) {
                        enable-nav-blocker-object(tag-symbol(nav-blocker, self));
                    }
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state complete {
        block start {
            track main {
                lambda {
                    set-boolean(player-interacting-with-safe, 0, self);
                }
                lambda {
                    if (gui2-widget-exists?(get-symbol(w-minigame-hud, self))) {
                        hud2-hide-lock-minigame(get-symbol(w-minigame-hud, self), 1);
                        set-symbol(w-minigame-hud, 0, self);
                    }
                }
                lambda {
                    set-high-contrast-mode-type(get-self-id(), 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (get-boolean(force-open, self)) {
                        joypad-disable-all-commands-except(
                            menu-select,
                            menu-back,
                            menu-left,
                            menu-right,
                            menu-up,
                            menu-down,
                            menu-stick-left,
                            menu-stick-right,
                            menu-prev-tab,
                            menu-next-tab
                        );
                    }
                }
            }
        }
    }
}
