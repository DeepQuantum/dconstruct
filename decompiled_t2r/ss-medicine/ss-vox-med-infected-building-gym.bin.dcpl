    state player-entered-back-room {
        block start {
            track main {
                lambda {
                    wait(1.00);
                }
                lambda {
                    if (get-boolean(vox-player-in-juice-bar-back-room, self)) {
                        set-boolean(vox-back-room-interrupt-done, 1, self);
                        conversation-interactable-disable(lev);
                        wait-say(player, vox-igc-abb-gen-cya-med-infected-building-gym-convo-1-001, 2, 0);
                        wait-boolean(vox-player-in-juice-bar-back-room, 0, self);
                        conversation-interactable-enable(lev, 1);
                        set-symbol(vox-optional-convo, optional-convo-question, self);
                        start-timer(vox-timer-optional-lev-convo, 10.00, self, 1);
                    }
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
    }
    state reach-stairwell-door {
        block start {
            track main {
                lambda {
