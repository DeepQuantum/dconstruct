                        wait-until-anim-frame(player, med-downtown-rooftop-barricade-door--abby, 200.00, 2);
                        play-hfx-id(door-open-haptic, 0, 2);
                        wait-until-anim-frame(player, med-downtown-rooftop-barricade-door--abby, 235.00, 2);
                        play-hfx-id(door-close-haptic, 0, 2);
                    }
                }
            }
        }
