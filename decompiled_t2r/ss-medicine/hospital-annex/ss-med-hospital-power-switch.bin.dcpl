                    go(complete, 1);
                }
                lambda {
                    wait-set-single-shader-instance-param(obj-power-dial-1, blendOffset2, 0.50, 0.00, 0.70);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-set-single-shader-instance-param(obj-power-dial-1, blendOffset2, 0.00, 0.50, 1.30);
                }
                lambda {
                    wait(0.70);
                }
                lambda {
                    go(lights-idle, 1);
                }
            }
