                    wait-until-anim-frame(player, med-hospital-basement-exit-clicker-hall--abby, 111.00, 2);
                }
                lambda {
                    send-event(go-locked, obj-clicker-hall-exit-door-1);
                }
            }
            track vox {
                lambda {
                    wait-for(anim-ready);
                }
                lambda {
                    say(player, vox-igc-abb-igc-med-hospital-basement-exit-clicker-hall-001, 2, 0);
                }
            }
            track rumble {
                lambda {
                    wait-for(anim-ready);
                }
                lambda {
                    wait-until-anim-frame(player, med-hospital-basement-exit-clicker-hall--abby, 8.00, 2);
                }
                lambda {
                    start-rumble(medium-land-rumble-settings, 0);
                }
                lambda {
                    wait-until-anim-frame(player, med-hospital-basement-exit-clicker-hall--abby, 58.00, 2);
                }
                lambda {
                    wait-rumble-curve(0.35, 0.35, 0.10, 2, 0);
                }
                lambda {
                    wait-rumble-curve(0.35, 0.35, 0.10, 2, 0);
                }
                lambda {
                    wait-rumble-curve(0.35, 0.35, 0.10, 2, 0);
                }
                lambda {
                    wait-rumble-curve(0.35, 0.35, 0.10, 2, 0);
                }
                lambda {
                    wait-rumble-curve(0.35, 0.00, 0.10, 2, 0);
                }
                lambda {
                    wait-until-anim-frame(player, med-hospital-basement-exit-clicker-hall--abby, 78.00, 2);
                }
                lambda {
                    start-rumble(hard-land-rumble-settings, 0);
                }
            }
            track music {
                lambda {
                    wait(2.00);
                }
                lambda {
                    if (tension-mode-is?(3)) {
                        play-music-stinger(*music-playlist-med-hospital-basement-back-rooms-combat-endtag*, 0);
                    } else if (tension-mode-is?(4)) {
                        play-music-stinger(*music-playlist-med-hospital-basement-back-rooms-unaware-search-endtag*, 0);
                    } else if (tension-mode-is?(2)) {
                        play-music-stinger(*music-playlist-med-hospital-basement-back-rooms-unaware-search-endtag*, 0);
                    }
                }
                lambda {
                    wait(1.50);
                }
                lambda {
                    play-music-stinger(*music-playlist-med-hospital-basement-outside-clicker-hall-silent-loop*, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    foreach (u64? var_2 : hospital-trap-infected) {
                        if (npc-alive?(var_2)) {
                            npc-set-zone-region(var_2, rgn-back-rooms-stalker-zone-1);
                            if (npc-using-skill?(var_2, 5)) {
                                send-event(force-disengage, var_2);
                            }
                        }
                    }
                }
            }
        }
        block event melee-attack-hit {
            track main {
                lambda {
                    go(interrupted-exit, 1);
                }
            }
        }
    }
    state interrupted-exit {
        block start {
            track main {
                lambda {
                    animate-start(obj-clicker-hall-exit-door-1, med-clicker-exit-get-correct-anim("-enter", "--door"), ap-clicker-hall-exit-1, 0);
                }
                lambda {
                    camera-fade-out-animated(0.00, 0);
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    go(wait-interact, 1);
                }
            }
        }
    }
    state already-closed {
        block start {
            track main {
                lambda {
                    send-event(disable, squeeze-through-clicker-hall-exit-1);
                }
                lambda {
                    interactable-enable(int-exit-clicker-hall-1);
                }
                lambda {
                    interactable-set-unavailable(int-exit-clicker-hall-1, 1);
                }
                lambda {
                    send-event(go-locked, obj-clicker-hall-exit-door-1);
                }
                lambda {
                    set-object-locator(int-exit-clicker-hall-1, get-joint-locator(obj-clicker-hall-exit-door-1, button_r));
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
