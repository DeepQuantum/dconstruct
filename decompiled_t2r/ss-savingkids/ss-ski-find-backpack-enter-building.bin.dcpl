                    wait-until-anim-frame(player, ski-find-backpack-enter-autoshop-success--abby, 170.00, 2);
                }
                lambda {
                    player-flashlight-set-particle-fade(1.00, 2.00);
                }
                lambda {
                    turn-on-flashlight(player, 0);
                }
            }
            track move-to-lev {
                lambda {
                    wait-until-anim-frame(lev, ski-find-backpack-enter-autoshop-success--lev, 110.00, 2);
                }
                lambda {
                    npc-move-to-spawner(
                        lev,
                        pos-autoshop-anim-move-2,
                        0,
                        2,
                        0,
                        0,
                        0,
                        0,
                        0
                    );
                }
                lambda {
                    signal(lev-in-position, 0);
                }
            }
            track move-to-yara {
                lambda {
                    npc-set-script-only-with-perception(yara);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 6, 1);
                    *(i32*)*(*var_0 + (0 * 8)) = 10;
                    *(u64*)(*(*var_0 + (0 * 8)) + 8) = 0;
                    *(u64*)(*(*var_0 + (0 * 8)) + 8) = get-spawner-locator(ap-ski-open-garage-door-1, 1);
                    *(i32*)*(*var_0 + (1 * 8)) = 28;
                    *(u64*)(*(*var_0 + (1 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (1 * 8)) + 8) = 0.00;
                    *(i32*)*(*var_0 + (2 * 8)) = 30;
                    *(u64*)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (2 * 8)) + 8) = 0.50;
                    *(i32*)*(*var_0 + (3 * 8)) = 32;
                    *(u64*)(*(*var_0 + (3 * 8)) + 8) = 0;
                    *(u8*)(*(*var_0 + (3 * 8)) + 8) = 1;
                    *(i32*)*(*var_0 + (4 * 8)) = 20;
                    *(u64*)(*(*var_0 + (4 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (4 * 8)) + 8) = 190.00;
                    *(i32*)*(*var_0 + (5 * 8)) = 24;
                    *(u64*)(*(*var_0 + (5 * 8)) + 8) = 0;
                    *(i32*)(*(*var_0 + (5 * 8)) + 8) = 2;
                    wait-animate_(yara, ski-find-backpack-enter-autoshop-success--yara, var_0);
                }
                lambda {
                    npc-use-cinematic-action-pack(yara, cap-yara-nw-injured-lean-back-4, 0, 0, 0);
                }
            }
            track vox {
                lambda {
                    say(player, vox-igc-abb-igc-ski-find-backpack-enter-autoshop-success-001, 2, 0);
                }
                lambda {
                    say(yara, vox-igc-yar-igc-ski-find-backpack-enter-autoshop-success-001, 2, 0);
                }
                lambda {
                    say(lev, vox-igc-lev-igc-ski-find-backpack-enter-autoshop-success-001, 2, 0);
                }
            }
            track rumble {
                lambda {
                    wait-rumble-curve(0.00, 0.15, 0.20, 2, 0);
                }
                lambda {
                    while (!object-anim-reached-frame?(player, ski-find-backpack-enter-autoshop-success--abby, 30.00, 2)) {
                        wait-rumble-curve(0.10, 0.10, 0.10, 2, 0);
                    }
                }
                lambda {
                    while (!object-anim-reached-frame?(player, ski-find-backpack-enter-autoshop-success--abby, 82.00, 2)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    wait-rumble-curve(0.25, 0.10, 0.20, 2, 0);
                }
                lambda {
                    while (!object-anim-reached-frame?(player, ski-find-backpack-enter-autoshop-success--abby, 130.00, 2)) {
                        wait-rumble-curve(0.10, 0.10, 0.10, 2, 0);
                    }
                }
            }
            track hud {
                lambda {
                    hud2-signal-interactable-hold-success();
                }
            }
            track sound {
                lambda {
                    stop-sound(get-int32(snd-garage-lp, self));
                }
            }
        }
        block update {
            track main {
                lambda {
                    joypad-disable-commands(flashlight-toggle);
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    animate-done(obj-garage-door-1, ski-find-backpack-enter-autoshop-success--garage-door, ap-ski-open-garage-door-1, 0, 0, 2);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state clean-up {
        block start {
            track main {
                lambda {
                    stop-sound(get-int32(snd-garage-lp, self));
                }
                lambda {
                    task-complete!(saving-kids, ski-find-backpack-enter-building);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
