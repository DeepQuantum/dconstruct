                    stop-sound(get-int32(snd-garage-door-lp, self));
                }
            }
            track rumble {
                lambda {
                    wait-rumble-curve(0.33, 0.33, 4.80, 2, 0);
                }
                lambda {
                    wait-rumble-curve(0.33, 0.00, 4.30, 2, 0);
                }
                lambda {
                    wait-frames(30);
                }
                lambda {
                    wait-rumble-curve(0.00, 0.33, 1.00, 2, 0);
                }
                lambda {
                    wait-rumble-curve(0.66, 0.66, 0.30, 2, 0);
                }
                lambda {
                    wait-rumble-curve(0.66, 0.00, 0.10, 2, 0);
                }
            }
            track vox {
                lambda {
                    say(player, vox-igc-abb-igc-ski-going-back-abby-lifts-garage-door-success-001, 2, 0);
                }
            }
            track hud {
                lambda {
                    hud2-signal-interactable-hold-success();
                }
                lambda {
                    send-event(early-spawn-manual, ss-ski-loot-room-management-2);
                }
                lambda {
                    disable-action-pack(tap-accessibility-jump-619);
                }
                lambda {
                    disable-action-pack(tap-accessibility-jump-639);
                }
            }
            track music {
                lambda {
                    wait(8.00);
                }
                lambda {
                    if (tension-mode-is?(3)) {
                        play-music-stinger(*music-playlist-ski-hunting-party-combat-endtag*, 0);
                    } else if (tension-mode-is?(4)) {
                        play-music-stinger(*music-playlist-ski-hunting-party-search-endtag*, 0);
                    } else if (tension-mode-is?(2)) {
                        play-music-stinger(*music-playlist-ski-hunting-party-unaware-endtag*, 0);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    set-player-invincible();
                }
                lambda {
                    set-walk-type(walk-unaware);
                }
                lambda {
                    set-run-type(run-unaware);
                }
            }
        }
    }
    state interpupted {
        block start {
            track main {
                lambda {
                    if (object-anim-playing?(obj-ski-coastal-garage-door-1, ski-going-back-abby-lifts-garage-door-struggle-no-combat--door, 0)) {
                        u64? var_1 = #%alloc-array(single-frame, 16, 5, 1);
                        *(i32*)*(*var_1 + (0 * 8)) = 10;
                        *(u64*)(*(*var_1 + (0 * 8)) + 8) = 0;
                        *(u64*)(*(*var_1 + (0 * 8)) + 8) = get-spawner-locator(ap-ski-going-back-abby-lifts-garage-door-1, 1);
                        *(i32*)*(*var_1 + (1 * 8)) = 28;
                        *(u64*)(*(*var_1 + (1 * 8)) + 8) = 0;
                        *(f32*)(*(*var_1 + (1 * 8)) + 8) = 0.20;
                        *(i32*)*(*var_1 + (2 * 8)) = 58;
                        *(u64*)(*(*var_1 + (2 * 8)) + 8) = 0;
                        *(f32*)(*(*var_1 + (2 * 8)) + 8) = get-animation-phase(obj-ski-coastal-garage-door-1, 2, ski-going-back-abby-lifts-garage-door-struggle-no-combat--door);
                        *(i32*)*(*var_1 + (3 * 8)) = 59;
                        *(u64*)(*(*var_1 + (3 * 8)) + 8) = 0;
                        *(i32*)(*(*var_1 + (3 * 8)) + 8) = 2;
                        *(i32*)*(*var_1 + (4 * 8)) = 32;
                        *(u64*)(*(*var_1 + (4 * 8)) + 8) = 0;
                        *(u8*)(*(*var_1 + (4 * 8)) + 8) = 1;
                        wait-animate_(obj-ski-coastal-garage-door-1, ski-going-back-abby-lifts-garage-door-lower--door, var_1);
                    } else if (object-anim-playing?(obj-ski-coastal-garage-door-1, ski-going-back-abby-lifts-garage-door-lower--door, 0)) {
                        while (!(0.95 < get-animation-phase(obj-ski-coastal-garage-door-1, 2, ski-going-back-abby-lifts-garage-door-lower--door))) {
                            wait-one-frame();
                        }
                    }
                }
                lambda {
                    stop-sound(get-int32(snd-garage-door-lp, self));
                }
                lambda {
                    go(wait-door-interact, 1);
                }
            }
        }
    }
}
