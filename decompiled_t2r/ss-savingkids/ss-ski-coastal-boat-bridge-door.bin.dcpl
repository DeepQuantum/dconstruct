                    *(i32*)*var_0[1] = 28;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 0.50;
                    *(i32*)*var_0[2] = 30;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.50;
                    animate_(door-ski-coastal-boat-bridge-1, ski-coastal-explore-ferry-bridge-door-success-no-combat--door, var_0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 5, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-spawner-locator(ap-ski-coastal-boat-bridge-1, 1);
                    *(i32*)*var_0[1] = 28;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 0.50;
                    *(i32*)*var_0[2] = 30;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.50;
                    *(i32*)*var_0[3] = 61;
                    *(u64*)(*var_0[3] + 8) = 0;
                    *(i32*)(*var_0[3] + 8) = 63;
                    *(i32*)*var_0[4] = 60;
                    *(u64*)(*var_0[4] + 8) = 0;
                    *(f32*)(*var_0[4] + 8) = 1.00;
                    wait-animate_(player, ski-coastal-explore-ferry-bridge-door-success-no-combat--abby, var_0);
                }
                lambda {
                    camera-fade-out-auto-gen-animated(2.00, 3.00, 0);
                }
                lambda {
                    set-svar-as-boolean(ski-coastal-boat-door-barricaded, 0);
                }
                lambda {
                    character-set-invincibility(player, 0, 0);
                }
                lambda {
                    task-complete!(saving-kids, ski-coastal-explore-boat-upper);
                }
                lambda {
                    go(complete, 1);
                }
            }
            track haptics {
                lambda {
                    if (joypad-has-haptics?(2)) {
                        wait-until-anim-frame(player, ski-coastal-explore-ferry-bridge-door-success-no-combat--abby, 42.00, 2);
                        play-hfx-id(door-close-haptic, 0, 2);
                    }
                }
            }
            track rumble {
                lambda {
                    wait-rumble-curve(0.36, 0.36, 0.30, 2, 0);
                }
                lambda {
                    wait-rumble-curve(0.36, 0.36, 0.30, 2, 0);
                }
                lambda {
                    wait-rumble-curve(0.36, 0.00, 0.30, 2, 0);
                }
            }
            track vox {
                lambda {
                    say(player, vox-igc-abb-igc-ski-coastal-explore-ferry-bridge-door-success-001, 2, 0);
                }
            }
            track flashlight {
                lambda {
                    wait-frames(30);
                }
                lambda {
                    turn-on-flashlight(player, 0);
                }
            }
            track hud {
                lambda {
                    hud2-signal-interactable-hold-success();
                }
            }
            track end-combat {
                lambda {
                    broadcast-event(escaped-to-bridge);
                }
            }
            track music {
                lambda {
                    if (tension-mode-is?(3)) {
                        play-music-stinger(*music-playlist-ski-coastal-explore-boat-upper-Combat-end*, 0);
                    } else if (tension-mode-is?(4)) {
                        play-music-stinger(*music-playlist-ski-coastal-explore-boat-upper-Search-end*, 0);
                    } else if (tension-mode-is?(2)) {
                        play-music-stinger(*music-playlist-ski-coastal-explore-boat-upper-Unaware-end*, 0);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    camera-shake(t1-handheld-idle-large, 0.10, 1.00, 1);
                }
            }
        }
    }
    state already-done {
        block start {
            track main {
                lambda {
                    interactable-disable(door-ski-coastal-boat-bridge-1);
                }
                lambda {
                    door-enable-systemic(door-ski-coastal-boat-bridge-1, 0);
                }
                lambda {
                    if (get-svar-as-boolean(ski-coastal-boat-door-barricaded)) {
                        animate-done(obj-no-hos-cab-cart-1, ski-coastal-explore-ferry-bridge-door-success-combat--barricade, ap-ski-coastal-boat-bridge-1, 0, 0, 2);
                        animate-done(door-ski-coastal-boat-bridge-1, ski-coastal-explore-ferry-bridge-door-success-combat--door, ap-ski-coastal-boat-bridge-1, 0, 0, 2);
                    } else {
                        animate-done(obj-no-hos-cab-cart-1, ski-coastal-explore-ferry-bridge-door-success-no-combat--barricade, ap-ski-coastal-boat-bridge-1, 0, 0, 2);
                        animate-done(door-ski-coastal-boat-bridge-1, ski-coastal-explore-ferry-bridge-door-success-no-combat--door, ap-ski-coastal-boat-bridge-1, 0, 0, 2);
                    }
                }
            }
        }
    }
}
