        block start {
            track main {
                lambda {
                    wait(3.00);
                }
                lambda {
                    request-dialog(player-callout-combat-end, player, 0, 0, 0, 0, 0);
                }
                lambda {
                    wait-script-caption(player, "I think that's all of them...", 2.75, 0, 0);
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
