                        play-hfx-id(tiny-soft-haptic, 0, 2);
                        wait-until-anim-frame(player, efm-ellie-find-helmet-to-pedestal-left--ellie, 156.00, 2);
                        play-hfx-id(tiny-soft-haptic, 0, 2);
                        wait-until-anim-frame(player, efm-ellie-find-helmet-to-pedestal-left--ellie, 192.00, 2);
                        play-hfx-id(tiny-soft-haptic, 0, 2);
                        wait-until-anim-frame(player, efm-ellie-find-helmet-to-pedestal-left--ellie, 239.00, 2);
                        play-hfx-id(efm-put-on-helmet, 0, 2);
                    }
                }
            }
            track remove-helmet-filter {
                lambda {
                    wait-frames(38);
                }
                lambda {
                    audio-clear-gas-mask-flag(player);
                }
            }
            track add-helmet-filter {
                lambda {
                    wait-frames(247);
                }
                lambda {
                    audio-set-gas-mask-flag(player, *futz-space-helmet*);
                }
            }
        }
    }
    state helmets-off-exhibits-on {
        block start {
            track main {
                lambda {
                    interactable-camera-remap-default(int-enter-lander-1);
                }
                lambda {
                    foreach (u64? var_2 : helmet-interacts) {
                        if (var_2 != none) {
                            interactable-disable(var_2);
                            interactable-camera-remap-default(var_2);
                        }
                    }
                }
                lambda {
                    audio-clear-gas-mask-flag(player);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
