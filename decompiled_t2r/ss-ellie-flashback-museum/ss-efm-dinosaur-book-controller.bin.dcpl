                    *(f32*)(*var_0[3] + 8) = 0.30;
                    *(i32*)*var_0[4] = 56;
                    *(u64*)(*var_0[4] + 8) = 0;
                    *(f32*)(*var_0[4] + 8) = 2.00;
                    animate_(player, efm-ellie-dinosaur-book--hold^idle--part, var_0);
                }
                lambda {
