    state exit-reading-interupted {
        block start {
            track main {
                lambda {
                    if (get-animation-playing?(player, efm-ellie-dinosaur-book--read^hold--part, 1)) {
                        u64? var_1 = get-current-time(0);
                        while (!((get-current-time(0) - var_1) >= 0.50)) {
                            set-animation-speed(
                                player,
                                lerp-scale(0.00, 0.50, 1.00, 2.00, get-current-time(0) - var_1),
                                1,
                                efm-ellie-dinosaur-book--read
                            );
                            wait-one-frame();
                        }
                        set-animation-speed(player, 2.00, 1, efm-ellie-dinosaur-book--read);
                    }
                }
                lambda {
                    while (0.95 < get-animation-phase(player, 1, efm-ellie-dinosaur-book--read^hold--part) && !!(get-animation-playing?(player, efm-ellie-dinosaur-book--read^hold--part, 1))) {
                        wait-one-frame();
