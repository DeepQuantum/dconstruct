                    *(i32*)*var_0[1] = 41;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(u64*)(*var_0[1] + 8) = s_script-gesture-0;
                    *(i32*)*var_0[2] = 28;
                    *(u64*)(*var_0[2] + 8) = 0;
