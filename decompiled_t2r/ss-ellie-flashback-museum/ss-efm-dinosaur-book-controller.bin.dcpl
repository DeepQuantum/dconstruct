                    *(i32*)*var_0[3] = 56;
                    *(u64*)(*var_0[3] + 8) = 0;
                    *(f32*)(*var_0[3] + 8) = 2.00;
                    *(i32*)*var_0[4] = 41;
                    *(u64*)(*var_0[4] + 8) = 0;
                    *(u64*)(*var_0[4] + 8) = s_script-gesture-add-0;
                    animate_(player, efm-ellie-dinosaur-book--read^idle--add, var_0);
                }
                lambda {
