                    animate_(joel, efm-capsule-enter-with-helmet-intro--joel, var_0);
                }
            }
            track objs-HCM {
                lambda {
                    set-high-contrast-mode-type(get-player-current-helmet(), 6);
                }
                lambda {
                    set-high-contrast-mode-type(obj-ellie-cin-backpack-1, 6);
                }
            }
            track vox {
                lambda {
                    wait-for(anim-start);
                }
                lambda {
                    say(player, vox-igc-ell-igc-efm-capsule-enter-with-helmet-intro-001, 2, 0);
                }
                lambda {
                    say(joel, vox-igc-joe-igc-efm-capsule-enter-with-helmet-intro-001, 2, 0);
                }
            }
            track sound {
                lambda {
                    wait-until-anim-frame(obj-lander-hatch-1, efm-capsule-enter-with-helmet-intro--hatch, 161.00, 2);
                }
                lambda {
                    play-sound-at-position(sfx-igc-efm-discover-museum-space-get-helmet--internal-debris-1, get-spawner-position(pos-snd-efm-apollo11-int-1, 1), 0, 0);
                }
                lambda {
                    wait-until-anim-frame(obj-lander-hatch-1, efm-capsule-enter-with-helmet-intro--hatch, 282.00, 2);
                }
                lambda {
                    play-sound-at-position(sfx-igc-efm-discover-museum-space-get-helmet--internal-debris-2, get-spawner-position(pos-snd-efm-apollo11-int-1, 1), 0, 0);
                }
            }
            track rumble {
                lambda {
                    if (!joypad-has-haptics?(2)) {
                        wait-until-anim-frame(player, efm-capsule-enter-with-helmet-intro--ellie, 101.00, 2);
                        start-rumble(soft-land-rumble-settings, 0);
                        wait-until-anim-frame(player, efm-capsule-enter-with-helmet-intro--ellie, 160.00, 2);
                        wait-rumble(0.50, 0.20);
                        wait-until-anim-frame(player, efm-capsule-enter-with-helmet-intro--ellie, 178.00, 2);
                        wait-rumble-curve(0.20, 0.70, 0.10, 1, 0);
                        wait-rumble(0.70, 0.20);
                        wait-rumble-curve(0.70, 0.00, 0.10, 1, 0);
                    }
                }
            }
            track haptics {
                lambda {
                    if (joypad-has-haptics?(2)) {
                        wait-until-anim-frame(player, efm-capsule-enter-with-helmet-intro--ellie, 24.00, 2);
                        play-hfx-id(soft-land-rumble-settings, 0, 2);
                        wait-until-anim-frame(player, efm-capsule-enter-with-helmet-intro--ellie, 75.00, 2);
                        play-hfx-id(generic-pull-release-soft-haptic, 0, 2);
                        wait-until-anim-frame(player, efm-capsule-enter-with-helmet-intro--ellie, 161.00, 2);
                        play-hfx-id(generic-pull-release-soft-haptic, 0, 2);
                        wait-until-anim-frame(player, efm-capsule-enter-with-helmet-intro--ellie, 187.00, 2);
                        play-hfx-id(generic-pull-release-haptic, 0, 2);
                        wait-until-anim-frame(player, efm-capsule-enter-with-helmet-intro--ellie, 280.00, 2);
                        play-hfx-id(generic-pull-release-haptic, 0, 2);
                        wait-until-anim-frame(player, efm-capsule-enter-with-helmet-intro--ellie, 330.00, 2);
                        play-hfx-id(extra-light-land-rumble-settings, 0, 2);
                    }
                }
            }
            track spawn-insides {
                lambda {
                    wait-spawn-entity(obj-capsule-insides-1, 0);
                }
                lambda {
                    animate-start(obj-capsule-insides-1, capsule=cin-efm-swim-flashback-capsule=010, 0, 0);
                }
            }
            track hair {
                lambda {
                    wait-for(anim-start);
                }
                lambda {
                    wait-frames(365);
                }
                lambda {
                    stop-animating(player, 1, 0.50, efm-ellie-find-helmet-on--hair, 0);
                }
            }
            track backpack-swap {
                lambda {
                    set-visible(obj-ellie-cin-backpack-1, 0);
                }
                lambda {
                    wait-for(anim-start);
                }
                lambda {
                    wait-frames(300);
                }
                lambda {
                    set-mesh-visible(player, ellie-14-backpack, 0);
                }
                lambda {
                    set-visible(get-prop-obj-by-name(player, ellie-14-backpack-straps-cloth), 0);
                }
                lambda {
                    set-visible(get-prop-obj-by-name(player, ellie-14-pin-dangling-cloth), 0);
                }
                lambda {
                    set-mesh-visible(obj-ellie-cin-backpack-1, backpack-ellie-museum-spaceship-pin, 0);
                }
                lambda {
                    set-visible(obj-ellie-cin-backpack-1, 1);
                }
            }
        }
    }
}
