                    *(u64*)(*(*var_1 + (1 * 8)) + 8) = 0;
                    *(f32*)(*(*var_1 + (1 * 8)) + 8) = 0.00;
                    animate_(player-get-anim-backpack(), efm-joel-gives-ellie-pin-exit--backpack, var_1);
                }
                lambda {
                    wait(0.20);
                }
                lambda {
                    change-object-material(player, objects/characters/ellie/14/arms-dirt:promo, objects/characters/ellie/14/arms-dirt:default, 0);
                }
                lambda {
                    player-swap-to-anim-backpack(0);
                }
                lambda {
                    set-mesh-visible(player-get-anim-backpack(), backpack-ellie-16-spaceship-pin, 1);
                }
                lambda {
                    set-mesh-visible(player-get-anim-backpack(), backpack-ellie-monster, 1);
                }
                lambda {
                    while (!(get-animation-frame(player-get-anim-backpack(), 2, 0) >= 241.00)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    player-swap-to-cloth-backpack(0);
                }
                lambda {
                    set-mesh-visible(player, ellie-14-spaceship-pin, 1);
                }
                lambda {
                    spawn-flashlight(player);
                }
                lambda {
                    set-visible(player-get-flashlight(), 1);
                }
                lambda {
                    signal(finished-backpack, 0);
                }
            }
            track pin {
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 4, 1);
                    *(i32*)*(*var_0 + (0 * 8)) = 10;
                    *(u64*)(*(*var_0 + (0 * 8)) + 8) = 0;
                    *(u64*)(*(*var_0 + (0 * 8)) + 8) = get-spawner-locator(ap-efm-pin-1, 1);
                    *(i32*)*(*var_0 + (1 * 8)) = 28;
                    *(u64*)(*(*var_0 + (1 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (1 * 8)) + 8) = 0.00;
                    *(i32*)*(*var_0 + (2 * 8)) = 30;
                    *(u64*)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (2 * 8)) + 8) = 0.50;
                    *(i32*)*(*var_0 + (3 * 8)) = 20;
                    *(u64*)(*(*var_0 + (3 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (3 * 8)) + 8) = 156.00;
                    wait-animate_(obj-igc-pin-1, efm-joel-gives-ellie-pin-exit--pin, var_0);
                }
                lambda {
                    kill-entity(obj-igc-pin-1);
                }
                lambda {
                    kill-entity(simple-investigate-igc-pin-1);
                }
                lambda {
                    set-mesh-visible(player-get-anim-backpack(), backpack-ellie-spaceship-pin, 1);
                }
            }
            track prop-pin-visibility {
                lambda {
                    set-visible(obj-igc-pin-1, 0);
                }
                lambda {
                    wait-until-anim-frame(obj-igc-pin-1, efm-joel-gives-ellie-pin-exit--pin, 18.00, 2);
                }
                lambda {
                    set-visible(obj-igc-pin-1, 1);
                }
            }
            track music {
                lambda {
                    play-music-stinger(*music-playlist-efm-discover-museum-post-cap-end*, 0);
                }
            }
            track vox {
                lambda {
                    say(player, vox-igc-ell-igc-efm-joel-gives-ellie-pin-exit-001, 2, 0);
                }
            }
            track haptics {
                lambda {
                    if (joypad-has-haptics?(2)) {
                        wait-until-anim-frame(player, efm-joel-gives-ellie-pin-exit--ellie, 44.00, 2);
                        play-hfx-id(hfx-craft-intro, 0, 2);
                        wait-until-anim-frame(player, efm-joel-gives-ellie-pin-exit--ellie, 85.00, 2);
                        play-hfx-id(hfx-craft-zip, 0, 2);
                        wait-until-anim-frame(player, efm-joel-gives-ellie-pin-exit--ellie, 195.00, 2);
                        play-hfx-id(hfx-craft-zip, 0, 2);
                        wait-until-anim-frame(player, efm-joel-gives-ellie-pin-exit--ellie, 206.00, 2);
                        play-hfx-id(hfx-craft-outro, 0, 2);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    camera-override-near-clip/f(0.00);
                }
                lambda {
                    override-render-settings(
                        *efm-rs-090-get-pin*,
                        1.30,
                        1.50,
                        0,
                        250,
                        0,
                        1,
                        0,
                        1.00
                    );
                }
            }
        }
    }
    state task-complete {
        block start {
            track main {
                lambda {
                    interactable-disable(int-enter-lander-1);
                }
                lambda {
                    task-complete!(ellie-flashback-museum, efm-flashback-capsule);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
