u64? dist-end-of-pursuit-spline(u64? arg_0) {
    return get-locator-distance(get-object-locator(get-self-id()), spline-locator-at-distance(arg_0, get-spline-length(arg_0)));
}

u16 play-anim() {
    u16 var_1;
    if (get-float(speed, self) == 0.00) {
        set-symbol(horse-anim, horse-mm-ambi-idle, self);
        var_1 = set-symbol(rider-anim, horse-mm-ambi-idle--npc, self);
    } else if (get-float(speed, self) > 0.00) {
        set-symbol(horse-anim, horse-mm-gallop-fw-loop, self);
        var_1 = set-symbol(rider-anim, horse-mm-gallop-fw-loop--npc, self);
    } else {
        var_1 = 0;
    }
    return var_1;
}

u64? horse-ap() {
    return get-joint-parented-bound-frame(tag-symbol(horse, self), hero_attachment);
}

