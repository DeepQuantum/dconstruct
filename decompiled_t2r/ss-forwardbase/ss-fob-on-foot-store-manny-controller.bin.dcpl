                    npc-request-hold(manny, 10.00);
                }
                lambda {
                    npc-look-at-object(manny, player, targ-head, 20.00);
                }
            }
        }
        block event climbed-to-lumber {
            track main {
                lambda {
                    go(patio-shelf-climb-lumber, 1);
                }
            }
        }
    }
    state patio-shelf-climb-lumber {
        block start {
            track main {
                lambda {
                    wait(0.50);
                }
                lambda {
                    npc-look-at-object(manny, player, targ-head, 20.00);
                }
            }
        }
        block event crossing-plank {
            track main {
                lambda {
                    go(patio-shelf-climb-plank, 1);
                }
            }
        }
    }
    state patio-shelf-climb-plank {
        block event task-complete {
            track main {
                lambda {
                    go(appliances-combat, 1);
                }
            }
        }
        block event begin-shelf-collapse {
            track main {
                lambda {
                    go(shelf-collapse, 1);
                }
            }
        }
    }
    state shelf-collapse {
        block start {
            track main {
                lambda {
                    set-boolean(force-ambient-lg, 0, self);
                }
                lambda {
                    set-boolean(force-combat-lg, 0, self);
                }
                lambda {
                    npc-unholster-weapon(manny, 4, -1.00, 0);
                }
                lambda {
                    npc-request-follow(manny, player, 4, *default-ai-follow-settings*, 0, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    npc-buddy-request-no-combat-delay/f(manny);
                }
            }
        }
        block event begin-combat {
            track main {
                lambda {
                    go(appliances-combat, 1);
                }
            }
        }
    }
    state appliances-combat {
        block start {
            track main {
                lambda {
                    set-manny-weapon-combat-active(1);
                }
                lambda {
                    npc-clear-request-movement(manny);
                }
                lambda {
                    npc-set-script-high-priority(manny);
                }
                lambda {
                    npc-request-always-attack(manny);
                }
                lambda {
                    npc-request-follow(manny, player, 4, *default-ai-follow-settings*, 0, 1);
                }
                lambda {
                    npc-buddy-give-kill-token(manny);
                }
            }
        }
        block update {
            track main {
                lambda {
                    npc-buddy-request-no-combat-delay/f(manny);
                }
            }
        }
        block event on-set-active-continue {
            track main {
                lambda {
                    if (task-continue-active?(forward-base, fob-on-foot-store-appliances, combat-done)) {
                        go(lead-to-exit, 1);
                    }
                }
            }
        }
        block end {
            track main {
                lambda {
                    npc-request-default-attack(manny);
                }
            }
        }
    }
    state lead-to-exit {
        block event manny-found-appliances-exit {
            track main {
                lambda {
                    go(move-to-guard-exit, 1);
                }
            }
        }
        block event leaving-appliances {
            track main {
                lambda {
                    go(transition-to-nursery, 1);
                }
            }
        }
    }
    state move-to-guard-exit {
        block start {
            track main {
                lambda {
                    wait-npc-move-to(manny, get-spline-point-locator(spl-lead-fob-store-final-manny-1, get-last-index-on-spline(spl-lead-fob-store-final-manny-1) - 1), 0, 2, 0, 0, 0, *npc-m-lg-uneasy-move-performances*);
                }
                lambda {
                    if (!(distance-xz-between-objects(player, obj-manny-exit-vis-target-1) < distance-xz-between-objects(manny, obj-manny-exit-vis-target-1))) {
                        send-event(manny-found-appliances-exit, ss-vox-fob-on-foot-store-appliances-1);
                    }
                }
                lambda {
                    wait-npc-move-to(manny, get-spline-point-locator(spl-lead-fob-store-final-manny-1, get-last-index-on-spline(spl-lead-fob-store-final-manny-1)), 0, 2, 0, 0, 0, *npc-m-lg-uneasy-move-performances*);
                }
                lambda {
                    go(wait-at-exit, 1);
                }
            }
        }
        block event leaving-appliances {
            track main {
                lambda {
                    stop-timer-if-running(remind-player-of-exit, self);
                }
                lambda {
                    go(transition-to-nursery, 1);
                }
            }
        }
    }
    state wait-at-exit {
        block start {
            track vox {
                lambda {
                    wait-for(call-player-to-exit);
                }
                lambda {
                    npc-request-buddy-look(manny, 1);
                }
                lambda {
                    send-event(player-lost, ss-vox-fob-on-foot-store-appliances-1);
                }
            }
            track positioning {
                lambda {
                    npc-set-script-only-with-perception(manny);
                }
                lambda {
                    npc-use-cinematic-action-pack(manny, cap-fob-on-foot-store-guard-door-1, 0, 0, 0);
                }
                lambda {
                    start-timer(remind-player-of-exit, 30.00, self, 1);
                }
                lambda {
                    wait-boolean(can-beckon-player-to-exit, 1, self);
                }
                lambda {
                    while (!distance-between-objects-greater-than?(player, manny, 14.00, 1)) {
                        wait(0.10);
                    }
                }
                lambda {
                    signal(call-player-to-exit, 1);
                }
            }
        }
        block event leaving-appliances {
            track main {
                lambda {
                    stop-timer-if-running(remind-player-of-exit, self);
                }
                lambda {
                    go(transition-to-nursery, 1);
                }
            }
        }
        block event remind-player-of-exit {
            track main {
                lambda {
                    set-boolean(can-beckon-player-to-exit, 1, self);
                }
            }
        }
    }
    state transition-to-nursery {
        block start {
            track main {
                lambda {
                    npc-set-script-only-with-perception(manny);
                }
                lambda {
                    set-boolean(force-ambient-lg, 0, self);
                }
                lambda {
                    set-boolean(force-combat-lg, 0, self);
                }
                lambda {
                    npc-holster-weapon(manny, 4, 1, -1.00, 0);
                }
                lambda {
                    turn-off-flashlight(manny, 0);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    set-manny-weapon-combat-active(0);
                }
                lambda {
                    go(nursery-follow, 1);
                }
            }
        }
    }
    state nursery-follow {
        block start {
            track main {
                lambda {
                    npc-set-script-only-with-perception(manny);
                }
                lambda {
                    wait-npc-use-positional-action-pack(
                        manny,
                        pap-fob-on-foot-admire-nursery-1,
                        0,
                        1,
                        0,
                        0.50,
                        0.50,
                        0,
                        0,
                        0
                    );
                }
                lambda {
                    npc-set-script-high-priority(manny);
                }
                lambda {
                    npc-request-follow(manny, player, 2, *fob-on-foot-manny-nursery-follow-settings*, 0, 1);
                }
            }
        }
        block event mission-accomplished {
            track main {
                lambda {
                    go(nursery-explore, 1);
                }
            }
        }
        block event nursery-conversations-done {
            track main {
                lambda {
                    go(nursery-explore, 1);
                }
            }
        }
    }
    state nursery-explore {
        block start {
            track main {
                lambda {
                    npc-request-explore-no-follow(manny, rgn-fob-on-foot-nursery-explore-3, 0, *buddy-post-selector-set*, 2, 1);
                }
                lambda {
                    wait(15.00);
                }
                lambda {
                    npc-request-explore-no-follow(manny, rgn-fob-on-foot-nursery-explore-2, 0, *buddy-post-selector-set*, 2, 1);
                }
            }
        }
        block event search-parking-lot {
            track main {
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
