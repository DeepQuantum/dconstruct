            }
        }
    }
    state clear-move-requests {
        block start {
            track main {
                lambda {
                    npc-clear-request-movement(alice);
                }
                lambda {
                    npc-clear-request-movement(mel);
                }
                lambda {
                    npc-clear-request-movement(manny);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
