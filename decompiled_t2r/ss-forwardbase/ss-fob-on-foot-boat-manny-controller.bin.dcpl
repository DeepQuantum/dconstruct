                    npc-move-to(manny, get-spawner-locator(pos-fob-on-foot-boat-truck-wait-point-1, 1), 0, 1, 0, 0, 0, 0);
                }
            }
        }
        block event signalled-manny {
            track main {
                lambda {
                    go(acknowledge-player, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    npc-buddy-combat-request-long-gun-only/f(manny);
                }
            }
        }
    }
    state acknowledge-player {
        block start {
            track main {
                lambda {
                    npc-look-at-object(manny, player, targHead, 10.00);
                }
                lambda {
                    wait-npc-turn-to(manny, get-object-position(player), 0, 0);
                }
            }
        }
        block event wave-to-player {
            track main {
                lambda {
                    u64? var_0 = alloc-gesture-play-params();
                    *(i32*)(var_0 + 36) = 19;
                    *(u8*)(var_0 + 34) = 1;
                    gesture_(manny, fob-on-foot-manny-wave-gesture, var_0);
                }
            }
        }
        block event player-climbing-down {
            track main {
                lambda {
                    go(reunite-with-player, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    suspend-idle-gestures/f(manny);
                }
                lambda {
                    npc-disable-dialog-look(manny, 0.00);
                }
                lambda {
                    npc-buddy-combat-request-long-gun-only/f(manny);
                }
            }
        }
    }
    state reunite-with-player {
        block start {
            track main {
                lambda {
                    npc-request-hold(manny, 10.00);
                }
                lambda {
                    npc-look-at-object(manny, player, targHead, 30.00);
                }
                lambda {
                    wait-npc-move-along-spline(
                        manny,
                        spl-manny-rejoin-group-1,
                        get-spawner-position(pos-fob-on-foot-reunion-greet-walk-start-1, 1),
                        get-spawner-position(pos-fob-on-foot-reunion-end-1, 1),
                        0,
                        1,
                        0,
                        0,
                        1,
                        0,
                        -1.00
                    );
                }
                lambda {
                    npc-look-at-object(manny, mel, targHead, 5.00);
                }
                lambda {
                    wait-npc-turn-to(manny, get-object-position(mel), 0, 0);
                }
            }
        }
        block event player-entered-sugar {
            track main {
                lambda {
                    go(greet-player, 1);
                }
            }
        }
        block event manny-start-lead {
            track main {
                lambda {
                    go(trains-enter, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    npc-buddy-combat-request-long-gun-only/f(manny);
                }
            }
        }
        block end {
            track main {
                lambda {
                    set-boolean(manny-ready-to-greet, 1, ss-vox-fob-on-foot-boat-reunion-1);
                }
            }
        }
    }
    state greet-player {
        block start {
            track main {
                lambda {
                    npc-request-hold(manny, 10.00);
                }
                lambda {
                    npc-stop(manny);
                }
                lambda {
                    npc-turn-to(manny, get-object-position(player), 1, 0);
                }
                lambda {
                    npc-look-at-object(manny, player, targHead, 10.00);
                }
            }
        }
        block event manny-start-lead {
            track main {
                lambda {
                    go(trains-enter, 1);
                }
            }
        }
    }
    state trains-enter {
        block start {
            track main {
                lambda {
                    npc-set-script-high-priority(manny);
                }
                lambda {
                    npc-request-lead-spline(manny, spl-manny-rejoin-group-1, player, *fob-on-foot-boat-reunion-lead-settings*, 0, 1);
                }
            }
            track player-in-trailer {
                lambda {
                    wait-boolean(player-in-trailer, 1, ss-fob-on-foot-boat-reunion-1);
                }
                lambda {
                    go(wait-player-exit-trailer, 1);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(forward-base, fob-on-foot-trains-enter)) {
                        go(complete, 1);
                    }
                }
            }
        }
        block event manny-optional-convo-start {
            track main {
                lambda {
                    go(manny-convo, 1);
                }
            }
        }
        block event manny-convo-enabled {
            track main {
                lambda {
                    go(wait-for-optional-convo, 1);
                }
            }
        }
    }
    state wait-for-optional-convo {
        block start {
            track main {
                lambda {
                    npc-request-explore-loose(manny, rgn-lead-fob-yards-sugar-1, 0, 0);
                }
                lambda {
                    wait(20.00);
                }
                lambda {
                    go(trains-enter, 1);
                }
            }
        }
        block event manny-optional-convo-start {
            track main {
                lambda {
                    go(manny-convo, 1);
                }
            }
        }
    }
    state manny-convo {
        block start {
            track main {
                lambda {
                    npc-holster-weapon(manny, 0, 1, -1.00, 0);
                }
                lambda {
                    npc-request-lead-spline(manny, spl-manny-rejoin-group-1, player, *fob-on-foot-boat-reunion-convo-lead-settings*, 0, 0);
                }
                lambda {
                    while (!get-svar-as-boolean(vox-fob-on-foot-reunion-convo-done)) {
                        wait(0.10);
                    }
                }
                lambda {
                    go(trains-enter, 1);
                }
            }
        }
    }
    state wait-player-exit-trailer {
        block start {
            track main {
                lambda {
                    npc-request-hold(manny, 10.00);
                }
                lambda {
                    enable-action-pack(cap-fob-sugar-manny-wall-lean-1, 1);
                }
                lambda {
                    npc-use-cinematic-action-pack(manny, cap-fob-sugar-manny-wall-lean-1, 0, 0, 0);
                }
                lambda {
                    wait-boolean(player-in-trailer, 0, ss-fob-on-foot-boat-reunion-1);
                }
                lambda {
                    wait-random(1.00, 2.00);
                }
                lambda {
                    npc-stop-behavior(manny);
                }
                lambda {
                    disable-action-pack(cap-fob-sugar-manny-wall-lean-1);
                }
                lambda {
                    go(trains-enter, 1);
                }
            }
        }
    }
}
