u64? get-lead-wait-position() {
    return spline-tag-symbol(wait-position, get-symbol(lead-spline, self), get-int32(move-index, self));
}

u64? update-dist-to-player() {
    return set-float(dist-to-player, distance-xz-between-objects(get-symbol(leader, self), player), self);
}

bool in-max-lead-dist?() {
    return get-float(dist-to-player, self) < get-float(max-lead-dist, self);
}

bool in-run-threshold?() {
    return get-float(dist-to-player, self) < get-float(run-threshold, self);
}

