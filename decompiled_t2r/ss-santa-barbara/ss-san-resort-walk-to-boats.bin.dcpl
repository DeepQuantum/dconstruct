            track waves {
                lambda {
                    wait-for(start-cinematic);
                }
            }
            track hair {
                lambda {
                    wait-until-cin-maya-frame(2873.00, 0);
                }
                lambda {
                    set-mesh-visible(npc-san-spikes-abby-3, abby-santa-barbara-prisoner-wet-hair, 1);
                }
            }
            track detach {
                lambda {
                    if (!get-boolean(task-in, self)) {
                        wait-until-anim-fully-faded-in(player, ellie=cin-san-free-abby-fight=010);
                        wait-until-cin-maya-frame(441.00, 0);
                        detach-player-weapon(0, 1, 0.15);
                    }
                }
            }
            track backpack {
                lambda {
                    u64? var_1 = #%alloc-array(single-frame, 16, 4, 1);
                    *(i32*)*(*var_1 + (0 * 8)) = 10;
                    *(u64*)(*(*var_1 + (0 * 8)) + 8) = 0;
                    *(u64*)(*(*var_1 + (0 * 8)) + 8) = get-joint-parented-bound-frame(player, spined);
                    *(i32*)*(*var_1 + (1 * 8)) = 14;
                    *(u64*)(*(*var_1 + (1 * 8)) + 8) = 0;
                    *(u64*)(*(*var_1 + (1 * 8)) + 8) = spine_d;
                    *(i32*)*(*var_1 + (2 * 8)) = 28;
                    *(u64*)(*(*var_1 + (2 * 8)) + 8) = 0;
                    *(f32*)(*(*var_1 + (2 * 8)) + 8) = 0.00;
                    *(i32*)*(*var_1 + (3 * 8)) = 30;
                    *(u64*)(*(*var_1 + (3 * 8)) + 8) = 0;
                    *(f32*)(*(*var_1 + (3 * 8)) + 8) = 0.00;
                    animate_(get-weapon-id(player, 0), rifle=cin-san-free-abby-fight, var_1);
                }
                lambda {
                    u64? var_3 = #%alloc-array(single-frame, 16, 4, 1);
                    *(i32*)*(*var_3 + (0 * 8)) = 10;
                    *(u64*)(*(*var_3 + (0 * 8)) + 8) = 0;
                    *(u64*)(*(*var_3 + (0 * 8)) + 8) = get-joint-parented-bound-frame(player, spined);
                    *(i32*)*(*var_3 + (1 * 8)) = 14;
                    *(u64*)(*(*var_3 + (1 * 8)) + 8) = 0;
                    *(u64*)(*(*var_3 + (1 * 8)) + 8) = spine_d;
                    *(i32*)*(*var_3 + (2 * 8)) = 28;
                    *(u64*)(*(*var_3 + (2 * 8)) + 8) = 0;
                    *(f32*)(*(*var_3 + (2 * 8)) + 8) = 0.00;
                    *(i32*)*(*var_3 + (3 * 8)) = 30;
                    *(u64*)(*(*var_3 + (3 * 8)) + 8) = 0;
                    *(f32*)(*(*var_3 + (3 * 8)) + 8) = 0.00;
                    animate_(get-weapon-strap-process-id(get-player-weapon-process-id-from-weapon-id(get-player-slotted-longgun(0))), rifle-strap=cin-san-free-abby-fight, var_3);
                }
                lambda {
                    if (get-boolean(task-in, self)) {
                        wait-one-frame();
                        player-swap-to-anim-backpack(0);
                    }
                }
                lambda {
                    wait(2.00);
                }
                lambda {
                    clear-gesture(player, -1, -1.00, 0);
                }
                lambda {
                    wait-until-cin-maya-frame(1427.00, 0);
                }
                lambda {
                    player-swap-to-anim-backpack(0);
                }
            }
            track rumble {
                lambda {
                    if (!joypad-has-haptics?(2)) {
                        wait-for(start-cinematic);
                        wait-until-cin-frame(2720.00, 0);
                        start-rumble(soft-land-rumble-settings, 0);
                        wait-until-cin-frame(2744.00, 0);
                        wait-rumble-curve(0.09, 0.27, 0.10, 2, 0);
                        wait-rumble-curve(0.27, 0.00, 0.10, 2, 0);
                        wait-until-cin-frame(2756.00, 0);
                        wait-rumble-curve(0.15, 1.00, 0.10, 2, 0);
                        wait-rumble-curve(1.00, 0.00, 0.10, 2, 0);
                        wait-until-cin-frame(2853.00, 0);
                        start-rumble(extra-hard-land-rumble-settings, 0);
                    }
                }
            }
            track haptics {
                lambda {
                    if (joypad-has-haptics?(2)) {
                        wait-for(start-cinematic);
                        wait-until-cin-frame(1284.00, 0);
                        play-hfx-id(touch-soft-right, 0, 2);
                        wait-until-cin-frame(1348.00, 0);
                        play-hfx-id(touch-soft-left, 0, 2);
                        wait-until-cin-frame(1430.00, 0);
                        play-hfx-id(touch-soft-left, 0, 2);
                        wait-until-cin-frame(1515.00, 0);
                        play-hfx-id(clip-drop-haptic-heavy, 0, 2);
                        wait-until-cin-frame(2723.00, 0);
                        play-hfx-id(melee-hand-grab-haptic, 0, 2);
                        wait-until-cin-frame(2744.00, 0);
                        play-hfx-id(generic-pull-release-haptic, 0, 2);
                        wait-until-cin-frame(2750.00, 0);
                        play-hfx-id(boost-lift-haptic, 0, 2);
                        wait-until-cin-frame(2853.00, 0);
                        play-hfx-id(melee-standing-attack-rumble-settings, 0, 2);
                        wait-until-cin-frame(3437.00, 0);
                        play-hfx-id(clip-drop-haptic, 0, 2);
                        wait-until-cin-frame(3457.00, 0);
                        play-hfx-id(tiny-kiss-haptic, 0, 2);
                    }
                }
            }
            track leg-ik {
                lambda {
                    wait-until-cin-frame(235.00, 0);
                }
                lambda {
                    set-boolean(disable-leg-ik, 1, self);
                }
            }
            track splashers {
                lambda {
                    wait-until-cin-frame(2730.00, 0);
                }
                lambda {
                    while (1) {
                        disable-splashers-this-frame(player);
                        disable-splashers-this-frame(npc-san-spikes-abby-3);
                        wait-one-frame();
                    }
                }
            }
            track ultrawide {
                lambda {
                    wait-until-anim-frame(player, ellie=cin-san-free-abby-fight=030, 471.00, 2);
                }
                lambda {
                    if (is-ultrawide?() && uw-mode-is-minimal?()) {
                        while (!object-anim-reached-frame?(player, ellie=cin-san-free-abby-fight=040, 0.00, 2)) {
                            update-ap-ref(player, offset-locator(get-spawner-locator(cin-san-free-abby-fight-1, 1), alloc-vector(0.00, 0.00, 0.15, 1.00, 0)), 0);
                            update-ap-ref(cin-san-free-abby-fight=knife-base-def, offset-locator(get-spawner-locator(cin-san-free-abby-fight-1, 1), alloc-vector(0.00, 0.00, 0.15, 1.00, 0)), 0);
                            wait-one-frame();
                        }
                        update-ap-ref(player, get-spawner-locator(cin-san-free-abby-fight-1, 1), 0);
                        update-ap-ref(cin-san-free-abby-fight=knife-base-def, get-spawner-locator(cin-san-free-abby-fight-1, 1), 0);
                    }
                }
            }
        }
        block end {
            track main {
                lambda {
                    set-table-shader-material-values-param(*san-beach-fight-edge-soften*, 0.00);
                }
            }
        }
        block update {
            track main {
                lambda {
                    cinematic-allow-player-flashlight/f();
                }
                lambda {
                    camera-override-near-clip/f(0.01);
                }
                lambda {
                    player-weapon-jiggle-disable/f(2.00);
                }
                lambda {
                    disable-camera-adjust-to-water-surface();
                }
                lambda {
                    suppress-spot-player-stinger();
                }
            }
        }
    }
}
