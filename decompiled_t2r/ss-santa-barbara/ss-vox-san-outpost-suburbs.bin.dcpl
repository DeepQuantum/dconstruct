                }
                lambda {
                    send-event(entered-correct-house, ss-san-outpost-lev-controller-1);
                }
                lambda {
                    set-boolean(vox-ff-house-done, 1, self);
                }
                lambda {
                    conv-gesture(lev, 19, 12);
                }
                lambda {
                    npc-look-at-spawner(lev, poi-445, 3.00);
                }
                lambda {
                    wait-say(lev, vox-igc-lev-gam-san-outpost-firefly-house-ext-sp-001, 2, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    player-look-at-point(get-spawner-position(poi-445, 1), 2.00);
                }
                lambda {
                    wait-say(player, vox-igc-abb-gam-san-outpost-firefly-house-ext-sp-002, 2, 0);
                }
                lambda {
                    if (get-boolean(vox-2426-done, self)) {
                        wait(0.50);
                        player-look-at-object(lev, headb, 2.00);
                        conv-gesture(player, 4, 12);
                        wait-say(player, vox-igc-abb-gam-san-outpost-firefly-house-ext-sp-003, 2, 0);
                    }
                }
                lambda {
                    if (get-boolean(vox-2429-done, self)) {
                        wait(0.50);
                        npc-look-at-object(lev, player, targHead, 2.00);
                        wait-say(lev, vox-igc-lev-gam-san-outpost-firefly-house-ext-sp-002, 2, 0);
                    }
                }
                lambda {
                    wait(0.50);
                }
                lambda {
                    player-look-at-point(get-spawner-position(poi-445, 1), 2.00);
                }
                lambda {
                    conv-gesture(player, 3, 12);
                }
                lambda {
                    wait-say(player, vox-igc-abb-gam-san-outpost-firefly-house-ext-sp-004, 2, 0);
                }
                lambda {
                    wait(0.70);
                }
                lambda {
                    player-look-at-object(lev, headb, 2.00);
                }
                lambda {
                    wait-say(player, vox-igc-abb-gam-san-outpost-firefly-house-ext-sp-005, 2, 0);
                }
                lambda {
                    conv-gesture(lev, 38, 12);
                }
                lambda {
                    npc-look-at-object(lev, player, targHead, 2.00);
                }
                lambda {
                    wait-say(lev, vox-igc-lev-gam-san-outpost-firefly-house-ext-sp-003, 2, 0);
                }
                lambda {
                    go(player-leaves-house-area, 1);
                }
            }
            track early-out {
                lambda {
                    wait-boolean(player-at-ff-house, 0, self);
                }
                lambda {
                    if (!signal-raised?(started, 0)) {
                        go(select-convo, 1);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    suspend-idle-gestures/f(player);
                }
                lambda {
                    suspend-idle-gestures/f(lev);
                }
                lambda {
                    npc-disable-dialog-look(lev, 0.00);
                }
                lambda {
                    npc-disable-dialog-look-gestures(lev, 0.00);
                }
                lambda {
                    player-disable-dialog-look-gestures(0.00);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(santa-barbara, san-outpost-firefly-house-ext)) {
                        go(done, 1);
                    }
                }
            }
        }
        block event tension-changed {
            track main {
                lambda {
                    if (!(tension-mode-is?(1))) {
                        if (get-boolean(vox-ff-house-done, self)) {
                            go(player-leaves-house-area, 1);
                        } else {
                            go(select-convo, 1);
                        }
                    }
                }
            }
        }
    }
    state player-leaves-house-area {
        block start {
            track main {
                lambda {
                    while (!task-complete?(santa-barbara, san-outpost-suburbs-street-end)) {
                        wait(0.10);
                    }
                }
                lambda {
                    wait-boolean(player-near-ff-house, 0, self);
                }
                lambda {
                    set-boolean(vox-left-ff-house-done, 1, self);
                }
                lambda {
                    wait-say(lev, vox-igc-lev-gam-san-outpost-firefly-house-ext-spj-007, 2, 0);
                }
                lambda {
                    wait(0.50);
                }
                lambda {
                    wait-say(lev, vox-igc-lev-gam-san-outpost-firefly-house-ext-spj-008, 2, 0);
                }
                lambda {
                    wait(3.00);
                }
                lambda {
                    wait-boolean(player-backtracking?, 1, self);
                }
                lambda {
                    wait-say(lev, vox-igc-lev-gam-san-outpost-firefly-house-ext-spj-009, 2, 0);
                }
                lambda {
                    wait(2.00);
                }
                lambda {
                    while (!(distance-between-objects(player, lev) < 10.00)) {
                        wait(0.10);
                    }
                }
                lambda {
                    if (!(get-locator-distance(get-object-locator(player), get-spawner-locator(pos-locked-door-animation-1, 1)) < 23.00)) {
                        wait-say(lev, vox-igc-lev-gam-san-outpost-firefly-house-ext-pr-010, 2, 0);
                    }
                }
                lambda {
                    wait-boolean(player-backtracking?, 0, self);
                }
                lambda {
                    wait-say(lev, vox-igc-lev-gam-san-outpost-firefly-house-ext-sp-006, 2, 0);
                }
                lambda {
                    wait-boolean(player-backtracking?, 1, self);
                }
                lambda {
                    while (!(distance-between-objects(player, lev) < 10.00)) {
                        wait(0.10);
                    }
                }
                lambda {
                    if (!(get-locator-distance(get-object-locator(player), get-spawner-locator(pos-locked-door-animation-1, 1)) < 23.00)) {
                        wait-say(lev, vox-igc-lev-gam-san-outpost-firefly-house-ext-sp-005, 2, 0);
                    }
                }
                lambda {
                    go(done, 1);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(santa-barbara, san-outpost-firefly-house-ext)) {
                        go(done, 1);
                    }
                }
            }
        }
    }
}
