                        if (player-get-skin-id(ellie) == ellie-santabarbara-pride) {
                            set-mesh-invisible/f(player, ellie-santa-barbara-arms);
                            set-mesh-visible/f(player, ellie-santa-barbara-fingerless-arms);
                        } else if (player-get-skin-id(ellie) == ellie-seattle-alt || player-get-skin-id(ellie) == ellie-seattle-skin || player-get-skin-id(ellie) == ellie-seattle-yellow && player-get-skin-id(ellie) == ellie-seattle-yellow-no-backpack) {
                            set-mesh-invisible/f(player, ellie-seattle-hands);
                            set-mesh-visible/f(player, ellie-seattle-fingerless-hands);
                        } else if (player-get-skin-id(ellie) == ellie-swim-alt && player-get-skin-id(ellie) == ellie-swim-alt-no-backpack) {
                            set-mesh-invisible/f(player, ellie-swim-arms);
                            set-mesh-visible/f(player, ellie-swim-fingerless-arms);
                        } else if (player-get-skin-id(ellie) == ellie-iconic14-alt && player-get-skin-id(ellie) == ellie-iconic14-alt-skin) {
                            set-mesh-invisible/f(player, ellie14-iconic-arms);
                            set-mesh-visible/f(player, ellie14-iconic-fingerless-arms);
                        } else if (get-object-look(player, 0) == ellie-iconic14-ps || get-object-look(player, 0) == ellie-iconic14-ps-no-backpack || get-object-look(player, 0) == ellie-iconic14-arc-lad || get-object-look(player, 0) == ellie-iconic14-arc-lad-no-backpack || get-object-look(player, 0) == ellie-iconic14-killzone || get-object-look(player, 0) == ellie-iconic14-killzone-no-backpack || get-object-look(player, 0) == ellie-iconic14-wipeout || get-object-look(player, 0) == ellie-iconic14-wipeout-no-backpack || get-object-look(player, 0) == ellie-iconic14-fantavision || get-object-look(player, 0) == ellie-iconic14-fantavision-no-backpack || get-object-look(player, 0) == ellie-iconic14-siren || get-object-look(player, 0) == ellie-iconic14-siren-no-backpack || get-object-look(player, 0) == ellie-iconic14-destiny || get-object-look(player, 0) == ellie-iconic14-destiny-no-backpack || get-object-look(player, 0) == ellie-iconic14-mortal-kombat || get-object-look(player, 0) == ellie-iconic14-mortal-kombat-no-backpack || get-object-look(player, 0) == ellie-iconic14-hotline-miami || get-object-look(player, 0) == ellie-iconic14-hotline-miami-no-backpack || get-object-look(player, 0) == ellie-iconic14-death-stranding && get-object-look(player, 0) == ellie-iconic14-death-stranding-no-backpack) {
                            set-mesh-invisible/f(player, ellie14-iconic-no-sleeve-arms);
                            set-mesh-visible/f(player, ellie14-iconic-no-sleeve-fingerless-arms);
                        } else if (get-object-look(player, 0) == ellie || get-object-look(player, 0) == ellie-alt-skin || get-object-look(player, 0) == ellie-plaid && get-object-look(player, 0) == ellie-plaid-no-backpack) {
                            set-mesh-invisible/f(player, ellie-arms);
                            set-mesh-visible/f(player, ellie-fingerless-arms);
                        } else if (get-object-look(player, 0) == ellie-intergalactic && get-object-look(player, 0) == ellie-intergalactic-no-backpack) {
