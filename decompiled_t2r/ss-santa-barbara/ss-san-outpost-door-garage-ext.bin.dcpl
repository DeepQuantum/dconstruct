            track sound {
                lambda {
                    wait-for(anim-start);
                }
                lambda {
                    wait-until-anim-frame(player, san-outpost-garage-door-success--abby, 49.00, 2);
                }
                lambda {
                    play-sound-at-position(sfx-igc-san-outpost-garage-door-success--debris-inside, get-spawner-position(pos-snd-san-outpost-garage-int-1, 1), 0, 0);
                }
            }
            track vox {
                lambda {
                    wait-for(anim-start);
                }
                lambda {
                    say(player, vox-igc-abb-igc-san-outpost-garage-door-success-001, 2, 0);
                }
            }
            track hud {
                lambda {
                    hud2-signal-interactable-hold-success();
                }
            }
        }
        block update {
            track main {
                lambda {
                    camera-shake(camera-mocap-idle-medium, 1.00, 1.00, 1);
                }
            }
        }
    }
    state post-open-door {
        block start {
            track main {
                lambda {
                    wait-npc-use-positional-action-pack(
                        lev,
                        pap-san-outpost-check-open-garage-1,
                        0,
                        1,
                        0,
                        0.50,
                        0.50,
                        0,
                        1,
                        0
                    );
                }
                lambda {
                    npc-request-follow(lev, player, 0, *default-ai-follow-settings*, 0, 0);
                }
                lambda {
                    go(done, 1);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    npc-request-follow(lev, player, 0, *default-ai-follow-settings*, 0, 0);
                }
                lambda {
                    go(done, 1);
                }
            }
        }
    }
}
