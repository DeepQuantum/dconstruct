                        print-float(var_4 / var_5, self);
                        hfx-ramp-internal(
                            get-int32(push-haptic-pid, self),
                            0,
                            0,
                            alloc-parameter-ramp-internal(
                                curve-scale(0.05, 0.25, 0.00, 1.50, var_4 / var_5, 10),
                                0.00,
                                256.00 / 48000.00,
                                0.00,
                                1,
                                0.00,
                                0
                            ),
                            1
                        );
                        hfx-continue(get-int32(push-haptic-pid, self));
                        set-point(hand-pos-last-frame, get-point(hand-pos, self), self);
                    } else {
                        rumble-curve(0.05, 0.05, 0.10, 2, 0);
                    }
                }
            }
        }
