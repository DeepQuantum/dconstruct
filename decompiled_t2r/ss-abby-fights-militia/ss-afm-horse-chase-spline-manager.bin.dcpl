statescript {
    options {
        player
        afm-horse-chase-script
    }
    declarations {
        bool branch-decided? = nullptr
        bool last-branch-left-chosen? = nullptr
        bool magnetize-started? = nullptr
        timer post-branch-magnetize-timer = nullptr
        bool branching? = nullptr
        bound-frame best-branching-camera-target-loc = nullptr
        symbol master-spline-center = spl-afm-horse-chase-1
        symbol master-spline-left = spl-afm-horse-chase-left-1
        symbol master-spline-right = spl-afm-horse-chase-right-1
        bool remove-forest-collision = nullptr
        bool left-branch-open? = true
        bool right-branch-open? = true
        f32 branch-center-region-radius = 5.00
    }
    state --all-- {
        block event branch-5-left-opened {
            track main {
                lambda {
                    set-boolean(left-branch-open?, 1, self);
                }
            }
        }
        block event branch-5-right-opened {
            track main {
                lambda {
                    set-boolean(right-branch-open?, 1, self);
                }
            }
        }
        block event branch-5-left-closed {
            track main {
                lambda {
                    set-boolean(left-branch-open?, 0, self);
                }
            }
        }
        block event branch-5-right-closed {
            track main {
                lambda {
                    set-boolean(right-branch-open?, 0, self);
                }
            }
        }
    }
    state task-check {
        block start {
            track main {
                lambda {
                    if (task-complete?(abby-fights-militia, afm-horse-chase-knock-off)) {
                        go(already-complete, 1);
                    }
                }
                lambda {
                    if (task-active?(abby-fights-militia, afm-horse-chase-start)) {
                        go(branch-1, 1);
                    }
                }
                lambda {
                    if (task-active?(abby-fights-militia, afm-horse-chase-scar-flee)) {
                        go(branch-1, 1);
                    }
                }
                lambda {
                    if (task-active?(abby-fights-militia, afm-horse-chase-crossfire)) {
                        go(branch-3, 1);
                    }
                }
                lambda {
                    if (task-range-active?(abby-fights-militia, afm-horse-chase-cavalry, abby-fights-militia, afm-horse-chase-field-arrive)) {
                        go(branch-forest, 1);
                    }
                }
                lambda {
                    if (task-active?(abby-fights-militia, afm-horse-chase-capitol-arrive)) {
                        if (task-continue-active?(abby-fights-militia, afm-horse-chase-capitol-arrive, *DEBUG-pre-knock-off*)) {
                            go(branch-8, 1);
                        } else {
                            go(branch-5, 1);
                        }
                    }
                }
                lambda {
                    if (task-active?(abby-fights-militia, afm-horse-chase-knock-off)) {
                        go(complete, 1);
                    }
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(abby-fights-militia, afm-horse-chase-knock-off)) {
                        go(already-complete, 1);
                    }
                }
                lambda {
                    if (task-active?(abby-fights-militia, afm-horse-chase-start)) {
                        go(branch-1, 1);
                    }
                }
            }
        }
    }
    state branch-1 {
        block start {
            track main {
                lambda {
                    set-boolean(magnetize-started?, 0, self);
                }
                lambda {
                    stop-timer-if-running(post-branch-magnetize-timer, self);
                }
                lambda {
                    set-boolean(branch-decided?, 0, self);
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    horse-set-barrier-spline-disabled(spl-afm-horse-chase-route-left-1, 1, player-horse);
                }
                lambda {
                    horse-set-barrier-spline-disabled(spl-afm-horse-chase-route-right-1, 1, player-horse);
                }
                lambda {
                    horse-set-barrier-spline-disabled(spl-afm-horse-chase-route-left-2, 1, player-horse);
                }
                lambda {
                    horse-set-barrier-spline-disabled(spl-afm-horse-chase-route-right-2, 1, player-horse);
                }
            }
        }
        block event exit {
            track main {
                lambda {
                    if (!get-boolean(branch-decided?, self)) {
                        set-boolean(branch-decided?, 1, self);
                        ss-afm-horse-chase-spline-manager--set-branch-splines(
                            rgn-afm-horse-chase-spline-left-right-1,
                            rgn-afm-horse-chase-spline-left-1,
                            rgn-afm-horse-chase-spline-right-1,
                            rgn-afm-horse-chase-spline-left-right-1,
                            spl-afm-horse-chase-route-1,
                            get-symbol(master-spline-center, self),
                            spl-afm-horse-chase-route-left-1,
                            spl-afm-horse-chase-route-right-1,
                            pos-afm-horse-chase-branch-locator-1
                        );
                    }
                }
            }
        }
        block event enter {
            track main {
                lambda {
                    ss-afm-horse-chase-spline-manager--send-splines-event(get-symbol(master-spline-center, self), get-symbol(master-spline-left, self), get-symbol(master-spline-right, self), 0);
                }
                lambda {
                    go(branch-2, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
