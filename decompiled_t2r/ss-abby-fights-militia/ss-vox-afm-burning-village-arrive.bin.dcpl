    state militia-reinforcements {
        block start {
            track main {
                lambda {
                    suppress-speech(*suppress-all-combat-dialog-afm*, 15);
                }
                lambda {
                    while (no-npcs-in-group-alive?(vox-afm-burning-village-wlf-reinf) && !(distance-between-locators(get-spawner-locator(hard-point-village-arrive-13, 1), get-object-locator(get-closest-living-npc-in-group(vox-afm-burning-village-wlf-reinf, player, 0))) < 6.00)) {
                        wait(0.10);
                    }
                }
                lambda {
                    set-boolean(vox-wlf-reinforcements-done, 1, self);
                }
                lambda {
                    if (!no-npcs-in-group-alive?(vox-afm-burning-village-wlf-reinf)) {
                        request-dialog(cya-afm-burning-village-reinforcements-1, get-closest-living-npc-in-group(vox-afm-burning-village-wlf-reinf, player, 0), 0, 0, 0, 0, 1);
                        wait(2.50);
                    }
                }
                lambda {
                    if (!no-npcs-in-group-alive?(vox-afm-burning-village-scar-reinf)) {
                        request-dialog(cya-afm-burning-village-reinforcements-2, get-closest-living-npc-in-group(vox-afm-burning-village-scar-reinf, player, 0), 0, 0, 0, 0, 1);
                        wait(2.00);
                    }
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
    }
    state end-vignette {
        block start {
            track main {
                lambda {
                    suppress-speech(*suppress-all-combat-dialog-afm*, 15);
                }
                lambda {
                    wait-say(lev, vox-igc-lev-gam-afm-burning-village-window-spj-002, 2, 0);
                }
                lambda {
                    wait(0.50);
                }
                lambda {
                    if (npc-group-alive-count(vox-afm-burning-village-scar-reinf) > 1) {
                        signal(scar-vox, 0);
                        request-dialog(cya-afm-burning-village-end-1, get-closest-living-npc-in-group(vox-afm-burning-village-scar-reinf, player, 0), vox-afm-village-fake-scar-male-1, 0, 0, 0, 1);
                    }
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    if (signal-raised?(scar-vox, 0)) {
                        while (get-boolean(vox-lily-taunt-done, self) && !((get-current-time(0) - get-current-time(0)) > 5.00)) {
                            wait-one-frame();
                        }
                    }
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
    }
    state afm-burning-village-spot-player {
        block start {
            track main {
                lambda {
                    start-timer(vox-timer-spot-player-per-faction, 6.00, self, 1);
                }
                lambda {
                    u64? var_1 = npc-get-faction(get-symbol(spotter, self), 1);
                    if (var_1 == Militia) {
                        start-timer(vox-timer-spot-player-militia, 45.00, self, 1);
                        if (get-boolean(vox-wlf-first-spot, self)) {
                            if (get-int32(vox-player-spot-zone, self) == 6) {
                                set-boolean(vox-wlf-last-spot, 1, self);
                            }
                            var_2 = request-dialog(cya-afm-burning-village-spot-player-wlf, get-symbol(spotter, self), 0, 0, 0, 0, 1);
                        } else {
                            set-boolean(vox-wlf-first-spot, 1, self);
                            var_2 = request-dialog(cya-afm-burning-village-spot-player-wlf-first, get-symbol(spotter, self), 0, 0, 0, 0, 1);
                        }
                    } else if (var_1 == Scar) {
                        start-timer(vox-timer-spot-player-scar, 45.00, self, 1);
                        if (get-boolean(vox-scar-first-spot, self)) {
                            if (get-int32(vox-player-spot-zone, self) == 6) {
                                set-boolean(vox-scar-last-spot, 1, self);
                            }
                            var_2 = request-dialog(cya-afm-burning-village-spot-player-scar, get-symbol(spotter, self), 0, 0, 0, 0, 1);
                        } else {
                            set-boolean(vox-scar-first-spot, 1, self);
                            var_2 = request-dialog(cya-afm-burning-village-spot-player-scar-first, get-symbol(spotter, self), 0, 0, 0, 0, 1);
                        }
                    }
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
    }
