                        0,
                        0,
                        0,
                        0
                    );
                }
                lambda {
                    if (!get-boolean(vox-player-near-window, self)) {
                        wait-say(lev, vox-igc-lev-gam-afm-burning-village-arrive-pr-003, 2, 0);
                    }
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (!get-boolean(vox-abby-reached-dock-block, self)) {
                        npc-disable-dialog-look(lev, 0.00);
                    }
                }
            }
        }
        block event vox-abby-found-the-way {
            track main {
                lambda {
                    if (!get-boolean(vox-lev-lead-to-window, self)) {
                        go(abby-finds-window-first, 1);
