            track lev {
                lambda {
                    reins-over-horse-head(npc-fallback-horse-1, 0);
                }
                lambda {
                    if (get-boolean(instant-mount?, self) && get-boolean(lev-initiated-horse-mount?, self)) {
                        wait-until-anim-frame(player, afm-mounting-horse-success--abby, 39.00, 2);
                        npc-holster-weapon(lev, 4, 1, -1.00, 0);
                        u64? var_2 = #%alloc-array(single-frame, 16, 6, 1);
                        *(i32*)*(*var_2 + (0 * 8)) = 14;
                        *(u64*)(*(*var_2 + (0 * 8)) + 8) = 0;
                        *(u64*)(*(*var_2 + (0 * 8)) + 8) = riderAP;
                        *(i32*)*(*var_2 + (1 * 8)) = 83;
                        *(u64*)(*(*var_2 + (1 * 8)) + 8) = 0;
                        *(u64*)(*(*var_2 + (1 * 8)) + 8) = afm-horse-chase-mount-lev-binding;
                        *(i32*)*(*var_2 + (2 * 8)) = 57;
                        *(u64*)(*(*var_2 + (2 * 8)) + 8) = 0;
                        *(f32*)(*(*var_2 + (2 * 8)) + 8) = get-animation-frame(player, 2, afm-mounting-horse-success--abby);
                        *(i32*)*(*var_2 + (3 * 8)) = 28;
                        *(u64*)(*(*var_2 + (3 * 8)) + 8) = 0;
                        *(f32*)(*(*var_2 + (3 * 8)) + 8) = 0.00;
                        *(i32*)*(*var_2 + (4 * 8)) = 30;
                        *(u64*)(*(*var_2 + (4 * 8)) + 8) = 0;
                        *(f32*)(*(*var_2 + (4 * 8)) + 8) = 0.50;
                        *(i32*)*(*var_2 + (5 * 8)) = 24;
                        *(u64*)(*(*var_2 + (5 * 8)) + 8) = 0;
                        *(i32*)(*(*var_2 + (5 * 8)) + 8) = 10;
                        animate_(lev, afm-mounting-horse-success--lev, var_2);
                        reins-set-igc-owner(npc-fallback-horse-1, lev);
                    } else {
                        wait-until-anim-frame(player, afm-mounting-horse-success--abby, 80.00, 2);
                        npc-set-script-only-no-perception(lev);
                        teleport-character(lev, pos-afm-horse-chase-start-lev-teleport-mount-1);
                        npc-holster-weapon(lev, 2, 1, -1.00, 0);
                        u64? var_4 = #%alloc-array(single-frame, 16, 3, 1);
                        *(i32*)*(*var_4 + (0 * 8)) = 10;
                        *(u64*)(*(*var_4 + (0 * 8)) + 8) = 0;
                        *(u64*)(*(*var_4 + (0 * 8)) + 8) = get-spawner-locator(ap-afm-mounting-horse-1, 1);
                        *(i32*)*(*var_4 + (1 * 8)) = 28;
                        *(u64*)(*(*var_4 + (1 * 8)) + 8) = 0;
                        *(f32*)(*(*var_4 + (1 * 8)) + 8) = 0.00;
                        *(i32*)*(*var_4 + (2 * 8)) = 30;
                        *(u64*)(*(*var_4 + (2 * 8)) + 8) = 0;
                        *(f32*)(*(*var_4 + (2 * 8)) + 8) = 0.00;
                        animate_(lev, afm-mounting-horse-enter--lev, var_4);
                        wait-until-anim-frame(player, afm-mounting-horse-success--abby, 122.00, 2);
                        u64? var_6 = #%alloc-array(single-frame, 16, 6, 1);
                        *(i32*)*(*var_6 + (0 * 8)) = 14;
                        *(u64*)(*(*var_6 + (0 * 8)) + 8) = 0;
                        *(u64*)(*(*var_6 + (0 * 8)) + 8) = riderAP;
                        *(i32*)*(*var_6 + (1 * 8)) = 83;
                        *(u64*)(*(*var_6 + (1 * 8)) + 8) = 0;
                        *(u64*)(*(*var_6 + (1 * 8)) + 8) = afm-horse-chase-mount-lev-binding;
                        *(i32*)*(*var_6 + (2 * 8)) = 57;
                        *(u64*)(*(*var_6 + (2 * 8)) + 8) = 0;
                        *(f32*)(*(*var_6 + (2 * 8)) + 8) = get-animation-frame(player, 2, afm-mounting-horse-success--abby);
                        *(i32*)*(*var_6 + (3 * 8)) = 28;
                        *(u64*)(*(*var_6 + (3 * 8)) + 8) = 0;
                        *(f32*)(*(*var_6 + (3 * 8)) + 8) = 0.00;
                        *(i32*)*(*var_6 + (4 * 8)) = 30;
                        *(u64*)(*(*var_6 + (4 * 8)) + 8) = 0;
                        *(f32*)(*(*var_6 + (4 * 8)) + 8) = 0.50;
                        *(i32*)*(*var_6 + (5 * 8)) = 24;
                        *(u64*)(*(*var_6 + (5 * 8)) + 8) = 0;
                        *(i32*)(*(*var_6 + (5 * 8)) + 8) = 10;
                        animate_(lev, afm-mounting-horse-success--lev, var_6);
                        reins-set-igc-owner(npc-fallback-horse-1, lev);
                    }
                }
            }
            track dead-scar {
                lambda {
                    wait-for(animate-start);
                }
                lambda {
                    wait-frames(20);
                }
                lambda {
                    while (!!get-animation-playing?(npc-afm-mounting-horse-1, afm-mounting-horse-success--male, 2)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    animate-done(npc-afm-mounting-horse-1, afm-mounting-horse-success--male, npc-fallback-horse-1, 0, 0, 2);
                }
                lambda {
                    if (npc-alive?(npc-afm-mounting-horse-1)) {
                        npc-die(npc-afm-mounting-horse-1, 0, 0, 0, 1);
                    }
                }
                lambda {
                    signal(track-complete-dead-scar, 0);
                }
            }
            track reins {
                lambda {
                    wait-until-anim-frame(player, afm-mounting-horse-success--abby, 149.00, 2);
                }
                lambda {
                    reins-reset(npc-fallback-horse-1);
                }
                lambda {
                    reins-set-igc-owner(npc-fallback-horse-1, player);
                }
            }
            track flashlight {
                lambda {
                    wait-until-anim-frame(player, afm-mounting-horse-success--abby, 40.00, 2);
                }
                lambda {
                    turn-off-flashlight(player, 0);
                }
            }
            track high-contrast-mode {
                lambda {
                    set-high-contrast-mode-type(npc-fallback-horse-1, 0);
                }
                lambda {
                    wait-for(animate-start);
                }
                lambda {
                    wait-frames(165);
                }
                lambda {
                    set-high-contrast-mode-type(npc-fallback-horse-1, 6);
                }
            }
            track vox {
                lambda {
                    wait-for(animate-start);
                }
                lambda {
                    say(player, vox-igc-abb-igc-afm-mounting-horse-001, 2, 0);
                }
                lambda {
                    say(lev, vox-igc-lev-igc-afm-mounting-horse-001, 2, 0);
                }
            }
            track music {
                lambda {
                    wait-for(animate-start);
                }
                lambda {
                    send-event(afm-horse-chase-music--mount-horse, ss-afm-horse-chase-music-1);
                }
            }
            track haptics {
                lambda {
                    if (joypad-has-haptics?(2)) {
                        wait-until-anim-frame(player, afm-mounting-horse-success--abby, 14.00, 2);
                        play-hfx-id(clip-drop-haptic-heavy, 0, 2);
                        wait-until-anim-frame(player, afm-mounting-horse-success--abby, 20.00, 2);
                        play-hfx-id(climb-hand-left-light-rumble-settings, 0, 2);
                        wait-until-anim-frame(player, afm-mounting-horse-success--abby, 28.00, 2);
                        play-hfx-id(clip-drop-haptic, 0, 2);
                        wait-until-anim-frame(player, afm-mounting-horse-success--abby, 48.00, 2);
                        play-hfx-id(clip-drop-haptic, 0, 2);
                        wait-until-anim-frame(player, afm-mounting-horse-success--abby, 78.00, 2);
                        play-hfx-id(clamber-hand-light-haptic, 0, 2);
                        wait-until-anim-frame(player, afm-mounting-horse-success--abby, 90.00, 2);
                        play-hfx-id(clamber-foot-light-haptic, 0, 2);
                        wait-until-anim-frame(player, afm-mounting-horse-success--abby, 129.00, 2);
                        play-hfx-id(tom-mount-horse, 0, 2);
                        wait-until-anim-frame(player, afm-mounting-horse-success--abby, 155.00, 2);
                        play-hfx-id(fob-concessions-jordan-hand-clasp, 0, 2);
                        wait-until-anim-frame(player, afm-mounting-horse-success--abby, 181.00, 2);
                        play-hfx-id(boost-lift-haptic-short, 0, 2);
                        wait-until-anim-frame(player, afm-mounting-horse-success--abby, 222.00, 2);
                        play-hfx-id(touch-soft, 0, 2);
                    }
                }
            }
            track track-check {
                lambda {
                    wait-for(track-complete-dead-scar);
                }
                lambda {
                    wait-for(track-complete-main);
                }
                lambda {
                    kill-particles-after-combat();
                }
                lambda {
                    go(post-mount, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    joypad-disable-commands(horse-dismount);
                }
                lambda {
                    hud2-hide-health-ammo/f(0, 0);
                }
                lambda {
                    if (entity-exists?(npc-fallback-horse-1)) {
                        if (!(get-player-horse-id(1, 1) == npc-fallback-horse-1)) {
                            set-player-horse(npc-fallback-horse-1);
                        }
                    }
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state post-mount {
        block start {
            track post-mount-vox {
                lambda {
                    send-event(vox-horse-chase-start, ss-vox-afm-horse-chase-start-1);
                }
                lambda {
                    wait(3.00);
                }
                lambda {
                    equip-player-weapon(pistol-glock);
                }
            }
            track post-mount-phantom-shooter {
                lambda {
                    wait(1.20);
                }
                lambda {
                    wait-spawn-entity(pos-afm-horse-chase-phantom-shooter-1, 0);
                }
                lambda {
                    phantom-shooter-set-accuracy(pos-afm-horse-chase-phantom-shooter-1, 0.00);
                }
                lambda {
                    phantom-shooter-set-graze-chance(pos-afm-horse-chase-phantom-shooter-1, 100.00);
                }
                lambda {
                    wait(0.60);
                }
                lambda {
                    phantom-shooter-shoot-at-target(pos-afm-horse-chase-phantom-shooter-1, player);
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    ss-afm-horse-chase-start-flinch();
                }
                lambda {
                    wait(0.50);
                }
                lambda {
                    phantom-shooter-shoot-at-target(pos-afm-horse-chase-phantom-shooter-1, player);
                }
                lambda {
                    wait(0.50);
                }
                lambda {
                    phantom-shooter-shoot-at-target(pos-afm-horse-chase-phantom-shooter-1, player);
                }
                lambda {
                    wait(0.80);
                }
                lambda {
                    phantom-shooter-shoot-at-target(pos-afm-horse-chase-phantom-shooter-1, player);
                }
                lambda {
                    phantom-shooter-enable(pos-afm-horse-chase-phantom-shooter-1, 0);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (player-in-region?(rgn-afm-horse-chase-magnet-spline-active-1, 2)) {
                        horse-set-magnet-spline/f(spl-afm-horse-chase-jump-magnet-spline-1, 15.00, 10.00, 5.00, 0, 0, 0, horse);
                    }
                }
            }
        }
    }
}
