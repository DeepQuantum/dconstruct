        block update {
            track main {
                lambda {
                    joypad-disable-all-commands-except(journal-cancel, investigate-flip);
                }
                lambda {
                    if (get-boolean(investigate-started?, self)) {
                        if (!(player-in-state?(Investigate) || player-in-state?(Journal) && 0)) {
                            gui2-set-widget-state(gui2-build-widget-path(
                                get-symbol(loading-screen, self),
                                "loading",
                                0,
                                0,
                                0,
                                0,
                                0,
                                0,
                                0
                            ), off, 0, 0, 0);
                            menu2-pop-page(hudMenuStack, menu-collectibles/collect-loading-screen);
                            go(menu, 1);
                        }
                    }
                }
            }
        }
    }
    state examine {
        block event inspect-exit {
            track main {
                lambda {
                    if (!(loading-screen == 0)) {
                        menu2-pop-page(hudMenuStack, menu-collectibles/collect-loading-screen);
                    }
                }
                lambda {
                    set-symbol(loading-screen, 0, self);
                }
                lambda {
                    play-sound(sfx-menu-examine-close, 0);
                }
                lambda {
                    u64? var_2 = darray-at(get-symbol(current-category-collectibles, self), get-int32(list-index, self));
                    u16 var_3;
                    if (var_2 && *(u16*)(var_2 + 12) == 7) {
                        var_3 = *(u64*)var_2;
                    } else if (var_2 && *(u16*)(var_2 + 12) == 5) {
                        var_3 = *(u64*)var_2;
                    } else if (var_2 && *(u16*)(var_2 + 12) == 4) {
                        var_3 = *(u64*)var_2;
                    } else {
                        var_3 = 0;
                    }
                    u64? var_4 = get-treasure-by-id(var_3, 0);
                    if (!(var_4 == 0)) {
                        u64? var_8 = darray-at(get-symbol(unlocked-categories, self), get-int32(category-index, self));
                        u16 var_9;
                        if (var_8 && *(u16*)(var_8 + 12) == 1) {
                            var_9 = *(u8*)var_8;
                        } else if (var_8 && *(u16*)(var_8 + 12) == 2) {
                            var_9 = *(i32*)var_8;
                        } else if (var_8 && *(u16*)(var_8 + 12) == 3) {
                            var_9 = *(u32*)var_8;
                        } else if (var_8 && *(u16*)(var_8 + 12) == 4) {
                            var_9 = *(i64*)var_8;
                        } else if (var_8 && *(u16*)(var_8 + 12) == 5) {
                            var_9 = *(u64*)var_8;
                        } else if (var_8 && *(u16*)(var_8 + 12) == 6) {
                            var_9 = (i32)*(f32*)var_8;
                        } else {
                            var_9 = 0;
                        }
                        speak-text-to-speech-formatted(new-boxed-value(7, get-collectible-category-title(var_9)), 1, 0, 1);
                        speak-text-to-speech-formatted(
                            new-boxed-value(7, *(u64*)(var_4 + 8)),
                            1,
                            0,
                            1
                        );
                        u64? var_14 = #%alloc-array(single-frame, 1, 2, 0);
                        *(u64*)(*var_14 + (0 * 8)) = new-boxed-value(7, A11Y_MENU_WORKBENCH_PART_COUNT);
                        *(u64*)(*var_14 + (1 * 8)) = new-boxed-value(2, get-inventory-item-quantity(parts));
                        var_5 = speak-text-to-speech-formatted(new-boxed-value(21, var_14), 1, 0, 1);
                    }
                }
                lambda {
                    go(menu, 1);
                }
            }
        }
        block end {
            track main {
                lambda {
                    data-source-mark-range-dirty(collectibles-list, get-int32(list-index, self), 1, 0);
                }
            }
        }
    }
    state --all-- {
        block update {
            track main {
                lambda {
                    if (!script-in-state?(self, not-focused)) {
                        gui2-disable-categories/f(256);
                        if (is-crafting-tutorial?(0)) {
                            menu2-legend-set-button-disabled(self, MENU_BACK, 1);
                        }
                    }
                }
            }
        }
        block event tab-focus-lost {
            track main {
                lambda {
                    send-event(collectibles-tab-focus-lost, menu2-get-player-menu-tabbar-path());
                }
                lambda {
                    menu2-pop-page(hudMenuStack, menu-collectibles/collect-loading-screen);
                }
                lambda {
                    joypad-force-command(investigate-exit-tab);
                }
                lambda {
                    joypad-force-command(journal-exit-tab);
                }
                lambda {
                    go(not-focused, 1);
                }
            }
        }
        block event tab-focus-gained {
            track main {
                lambda {
                    set-boolean(play-focus-sound?, 0, self);
                }
            }
        }
        block event designer-menu-changed {
            track main {
                lambda {
                    set-boolean(check-if-debug-cleared?, 1, self);
                }
            }
        }
    }
}
