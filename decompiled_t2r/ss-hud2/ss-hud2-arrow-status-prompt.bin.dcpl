            track main {
                lambda {
                    play-pulse-anim--arrow-status-hud(0);
                }
                lambda {
                    start-damage-timer--arrow-impalement(get-timer-value(recurring-damage-base, self), 0);
                }
                lambda {
                    send-event(arrow-impalement-damage, ss-reminders);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (!player-is-arrow-stuck?()) {
                        go(no-arrow, 1);
                    }
                }
            }
        }
        block event pulse-timer {
            track main {
                lambda {
                    if (get-boolean(first-pulse?, self)) {
                        play-pulse-anim--arrow-status-hud(1);
                        set-boolean(first-pulse?, 0, self);
                    }
                }
            }
        }
        block event impale-sound-loop-timer {
            track main {
                lambda {
                    play-impale-sound--arrow-status-hud(0);
                }
            }
        }
        block event impale-sound-initial-timer {
            track main {
                lambda {
                    play-impale-sound--arrow-status-hud(1);
                }
            }
        }
    }
}
