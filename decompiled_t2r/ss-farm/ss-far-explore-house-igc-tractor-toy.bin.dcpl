                    *(i32*)*(*var_0 + (0 * 8)) = 10;
                    *(u64*)(*(*var_0 + (0 * 8)) + 8) = 0;
                    *(u64*)(*(*var_0 + (0 * 8)) + 8) = get-spawner-locator(ap-far-explore-house-tractor-toy-1, 1);
                    *(i32*)*(*var_0 + (1 * 8)) = 28;
                    *(u64*)(*(*var_0 + (1 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (1 * 8)) + 8) = 0.50;
                    *(i32*)*(*var_0 + (2 * 8)) = 30;
                    *(u64*)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(f32*)(*(*var_0 + (2 * 8)) + 8) = 0.00;
                    animate_(far-tractor-01, far-explore-baby-tractor-exit--tractor, var_0);
                }
            }
            track vox {
                lambda {
                    say(player, vox-igc-ell-igc-far-explore-baby-tractor-exit-001, 2, 0);
                }
            }
            track music {
                lambda {
                    send-event(stop-tractor-music, ss-far-explore-house-igc-tractor-music-1);
                }
            }
            track rumble {
                lambda {
                    if (!joypad-has-haptics?(2)) {
                        wait-until-frame(259);
                        start-rumble(soft-land-rumble-settings, 0);
                    }
                }
            }
            track haptics {
                lambda {
                    if (joypad-has-haptics?(2)) {
                        wait-until-anim-frame(player, far-explore-baby-tractor-exit--ellie, 109.00, 2);
                        play-hfx-id(touch-soft, 0, 2);
                        wait-until-anim-frame(player, far-explore-baby-tractor-exit--ellie, 259.00, 2);
                        play-hfx-id(soft-land-rumble-settings, 0, 2);
                    }
                }
            }
        }
        block end {
            track main {
                lambda {
                    set-boolean(tractor-igc-done?, 1, ss-far-explore-house-controller-igc-progression-1);
                }
                lambda {
                    set-boolean(pause-baby-gestures?, 0, ss-far-explore-controller-baby-gestures-1);
                }
                lambda {
                    set-boolean(pause-baby-igc?, 0, ss-snd-baby-murmur-logic-1);
                }
                lambda {
                    set-svar-as-boolean(far-found-tractor-toy, 1);
                }
                lambda {
                    task-set-active-continue!(tractor-done, 0, 0, 0, 0.00, 0, 0);
                }
            }
        }
    }
    state cleanup {
        block start {
            track main {
                lambda {
                    if (entity-exists?(obj-far-explore-tractor-toy-1)) {
                        kill-entity(obj-far-explore-tractor-toy-1);
                    }
                }
                lambda {
                    wait(5.50);
                }
                lambda {
                    kill-entity-if-spawned(far-explore-house-tractor-light-object-1);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
