                    send-event(dina-hint-vox, ss-far-explore-house-hints-1);
                }
                lambda {
                    interactable-set-activation-region(int-far-explore-house-tractor-toy-1, rgn-far-explore-tractor-toy-activation-4);
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
        block event player-requested-interact {
            track main {
                lambda {
                    go(pick-up-ollie, 1);
                }
            }
        }
        block event porch-door-vox {
            track main {
                lambda {
                    if (!get-boolean(vox-opened-front-door?, self)) {
                        go(opened-front-door, 1);
                    }
                }
            }
        }
        block event entered-into-investigate {
            track main {
                lambda {
                    if (get-boolean(vox-sister-photo?, ss-vox-far-explore-garden-1) && !get-boolean(vox-sister-photo?, ss-vox-far-explore-house-1)) {
                        set-boolean(vox-sister-photo?, 1, ss-vox-far-explore-garden-1);
                        set-boolean(vox-sister-photo?, 1, ss-vox-far-explore-house-1);
                        go(sister-photo, 1);
                    }
                }
            }
        }
        block event enter {
            track main {
                lambda {
                    if (!get-boolean(vox-look-fence?, self)) {
                        go(look-fence, 1);
                    }
                }
            }
        }
    }
    state start-music {
        block start {
            track main {
                lambda {
                    send-event(disable, rgn-accessibility-pathfind-override-339);
                }
                lambda {
                    set-accessibility-pathfind-goal(pos-far-explore-house-pathfind-1);
                }
                lambda {
                    send-event(enable, rgn-accessibility-pathfind-override-342);
                }
                lambda {
                    stop-speaking(dina);
                }
                lambda {
                    say-pre-roll(player, vox-igc-ell-igc-far-explore-dancing-with-dina-summed-001);
                }
                lambda {
                    say-pre-roll(dina, vox-igc-din-igc-far-explore-dancing-with-dina-summed-001);
                }
                lambda {
                    if (!distance-between-objects-less-than?(player, dina, 2.00)) {
                        wait-say(dina, vox-igc-din-gam-far-explore-play-record-spj-001, 2, 0);
                        wait(0.30);
                        if (!distance-between-objects-less-than?(player, dina, 2.00)) {
                            wait-say(dina, vox-igc-din-gam-far-explore-play-record-sp-002, 2, 0);
                            wait(0.30);
                            if (!distance-between-objects-less-than?(player, dina, 2.00)) {
                                wait-say(player, vox-igc-ell-gam-far-explore-play-record-sp-001, 2, 0);
                                wait(0.30);
                                if (!distance-between-objects-less-than?(player, dina, 2.00)) {
                                    wait-say(dina, vox-igc-din-gam-far-explore-play-record-sp-003, 2, 0);
                                    wait(0.30);
                                    if (!distance-between-objects-less-than?(player, dina, 2.00)) {
                                        wait-say(player, vox-igc-ell-gam-far-explore-play-record-slf-002, 2, 0);
                                    }
                                }
                            }
                        }
                    }
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
    }
    state pick-up-ollie {
        block start {
            track main {
                lambda {
                    while (!player-in-state?(Script)) {
                        wait(0.10);
                    }
                }
                lambda {
                    set-boolean(vox-picked-up-toy?, 1, self);
                }
                lambda {
                    send-event(disable, rgn-accessibility-pathfind-override-341);
                }
                lambda {
                    if (get-boolean(vox-danced-with-dina?, self)) {
                        wait-say(player, vox-igc-ell-gam-far-explore-baby-tractor-sp-001, 2, 0);
                        wait(0.30);
                        wait-say(player, vox-igc-ell-gam-far-explore-baby-tractor-sp-002, 2, 0);
                    } else {
                        wait-say(player, vox-igc-ell-gam-far-explore-baby-tractor-sp-003, 2, 0);
                        wait(0.30);
                        wait-say(player, vox-igc-ell-gam-far-explore-baby-tractor-sp-004, 2, 0);
                    }
                }
                lambda {
                    set-accessibility-pathfind-goal(pos-far-explore-house-pathfind-1);
                }
                lambda {
                    if (!(get-boolean(vox-dina-says-hi?, self))) {
                        go(dina-wait-music, 1);
                    } else if (get-boolean(vox-started-music?, self)) {
                        go(wait-for-event, 1);
                    } else {
                        go(music-hint, 1);
                    }
                }
            }
        }
    }
    state look-at-sheep {
        block start {
            track main {
                lambda {
                    while (!!(is-speaking?(player))) {
                        wait(0.10);
                    }
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-far-explore-house-outside-sheep-spj-001, 2, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-far-explore-house-outside-sheep-sp-002, 2, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-far-explore-house-outside-sheep-spj-003, 2, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-far-explore-house-outside-sheep-slf-004, 2, 0);
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
    }
    state opened-front-door {
        block start {
            track main {
                lambda {
                    while (!!(is-speaking?(player))) {
                        wait(0.10);
                    }
                }
                lambda {
                    set-boolean(vox-opened-front-door?, 1, self);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-far-explore-house-outside-sp-001, 2, 0);
                }
                lambda {
                    while (!player-in-state?(Move)) {
                        wait(0.10);
                    }
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-far-explore-house-outside-slf-002, 2, 0);
                }
                lambda {
                    if (!(get-boolean(vox-ollie-hint?, self)) && !(get-boolean(vox-picked-up-toy?, self)) && get-boolean(vox-danced-with-dina?, self)) {
                        go(ollie-hint, 1);
                    }
                }
                lambda {
                    if (!(get-boolean(vox-dina-says-hi?, self))) {
                        go(dina-wait-music, 1);
                    } else if (get-boolean(vox-started-music?, self)) {
                        go(wait-for-event, 1);
                    } else {
                        go(music-hint, 1);
                    }
                }
            }
        }
        block event exit {
            track main {
                lambda {
                    set-timer-paused(vox-music-timer, 1, self);
                }
            }
        }
    }
    state poster {
        block start {
            track vox {
                lambda {
                    wait(0.50);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-far-explore-house-guest-room-poster-sp-001, 2, 0);
                }
                lambda {
                    signal(make-baby-giggle, 0);
                }
                lambda {
                    wait(0.80);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-far-explore-house-guest-room-poster-slf-002, 2, 0);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-far-explore-house-guest-room-poster-sp-003, 2, 0);
                }
                lambda {
                    set-boolean(pause-baby-gestures?, 0, ss-far-explore-controller-baby-gestures-1);
                }
                lambda {
                    if (!(get-boolean(vox-ollie-hint?, self)) && !(get-boolean(vox-picked-up-toy?, self)) && get-boolean(vox-danced-with-dina?, self)) {
                        go(ollie-hint, 1);
                    }
                }
                lambda {
                    if (!(get-boolean(vox-dina-says-hi?, self))) {
                        go(dina-wait-music, 1);
                    } else if (get-boolean(vox-started-music?, self)) {
                        go(wait-for-event, 1);
                    } else {
                        go(music-hint, 1);
                    }
                }
            }
            track gesture {
                lambda {
                    set-boolean(pause-baby-gestures?, 1, ss-far-explore-controller-baby-gestures-1);
                }
                lambda {
                    wait-for(make-baby-giggle);
                }
                lambda {
                    wait(0.25);
                }
                lambda {
                    play-sound-at-joint(sfx-baby-giggle, obj-far-explore-baby-1, headb, 0, 0);
                }
            }
        }
    }
    state sister-photo {
        block start {
            track main {
                lambda {
                    wait(1.50);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-far-explore-house-sp-001, 2, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-far-explore-house-sp-002, 2, 0);
                }
                lambda {
                    if (!(get-boolean(vox-ollie-hint?, self)) && !(get-boolean(vox-picked-up-toy?, self)) && get-boolean(vox-danced-with-dina?, self)) {
                        go(ollie-hint, 1);
                    }
                }
                lambda {
                    if (!(get-boolean(vox-dina-says-hi?, self))) {
                        go(dina-wait-music, 1);
                    } else if (get-boolean(vox-started-music?, self)) {
                        go(wait-for-event, 1);
                    } else {
                        go(music-hint, 1);
                    }
                }
            }
        }
    }
}
