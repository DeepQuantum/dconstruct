                        bm-blood-clear-eff,
                        player,
                        root,
                        0,
                        0,
                        root,
                        2,
                        0,
                        2,
                        0
                    );
                    set-effect-float(var_0, posU, 0.50);
                    set-effect-float(var_0, posV, 0.84);
                    set-effect-float(var_0, spriteScale, 2.00);
                }
            }
            track haptics {
                lambda {
                    if (joypad-has-haptics?(2)) {
                        wait-until-anim-frame(player, sle-tommy-fight-exit-garage-exit--abby, 86.00, 2);
                        play-hfx-id(clamber-right-hand-light-haptic, 0, 2);
                    }
                }
            }
        }
    }
    state clean-up {
        block start {
            track main {
                lambda {
                    ss-sle-vox-sys--relinquish-talking-stick(get-self-id());
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
