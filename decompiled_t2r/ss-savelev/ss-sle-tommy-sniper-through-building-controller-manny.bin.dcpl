                        u16 var_2;
                        if (var_1 && *(u16*)(var_1 + 12) == 7) {
                            var_2 = *(u64*)var_1;
                        } else if (var_1 && *(u16*)(var_1 + 12) == 5) {
                            var_2 = *(u64*)var_1;
                        } else if (var_1 && *(u16*)(var_1 + 12) == 4) {
                            var_2 = *(u64*)var_1;
                        } else {
                            var_2 = 0;
                        }
                        if (npc-alive?(var_2)) {
                            npc-die(var_2, 0, 0, 0, 1);
                        }
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    npc-buddy-request-no-combat-delay/f(manny);
                }
            }
        }
    }
    state idle-at-door {
        block start {
            track main {
                lambda {
                    npc-clear-aim-at(manny);
                }
                lambda {
                    npc-cancel-fire-command(manny);
                }
                lambda {
                    npc-set-script-only-no-perception(manny);
                }
                lambda {
                    npc-set-demeanor(manny, 2, 0);
                }
                lambda {
                    npc-set-primary-weapon(manny, rifle-mini-14-manny, 0);
                }
                lambda {
                    npc-unholster-weapon(manny, 0, -1.00, 0);
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    wait-npc-move-to-spawner(
                        manny,
                        pos-sniper-manny-elevator-wait-1,
                        2,
                        1,
                        0,
                        0,
                        0,
                        0,
                        0
                    );
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    go(aim-at-door, 1);
                }
            }
        }
    }
    state aim-at-door {
        block start {
            track progression {
                lambda {
                    set-boolean(manny-waiting-at-elevator, 1, ss-vox-sle-tommy-sniper-through-building-1);
                }
                lambda {
                    wait-boolean(player-interacted-with-elevator, 1, self);
                }
                lambda {
                    go(clean-up, 1);
                }
            }
            track looks {
                lambda {
                    while (1) {
                        while (is-speaking?(manny) && !((get-current-time(0) - get-current-time(0)) > random-float-range(3.00, 6.00, 0))) {
                            wait-one-frame();
                        }
                        npc-clear-look-aim-at(manny);
                        wait-one-frame();
                        npc-look-at-object(manny, player, headb, -1.00);
                        wait(random-float-range(1.50, 2.50, 0));
                    }
                }
            }
        }
        block end {
            track main {
                lambda {
                    npc-clear-look-aim-at(manny);
                }
            }
        }
    }
    state clean-up {
        block start {
            track main {
                lambda {
                    npc-weapon-down(manny);
                }
                lambda {
                    npc-clear-aim-at(manny);
                }
                lambda {
                    npc-cancel-fire-command(manny);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
