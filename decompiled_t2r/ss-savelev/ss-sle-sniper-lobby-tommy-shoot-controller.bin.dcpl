            }
            track turn-off-for-instant-kill {
                lambda {
                    wait-boolean(turn-off-shoot-controller, 1, self);
                }
                lambda {
                    go(clean-up, 1);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(save-lev, sle-tommy-sniper-lobby-approach-back)) {
                        go(clean-up, 1);
                    } else if (task-complete?(save-lev, sle-tommy-sniper-lobby-fight-from-windows)) {
                        go(reset, 1);
                    }
                }
            }
        }
        block event npc-fired-weapon {
            track main {
                lambda {
                    if (event-arg-symbol(0) == npc-tommy-fight-1) {
                        set-boolean(tommy-fired-this-frame, 1, self);
                        fact-set-time-safe(npc-tommy-fight-1, tommy-fired);
                    }
                }
            }
        }
        block event player-attacked {
            track main {
                lambda {
                    set-boolean(player-hit-by-tommy, 1, self);
                }
            }
        }
        block end {
            track main {
                lambda {
                    npc-cancel-fire-command(npc-tommy-fight-1);
                }
                lambda {
                    npc-clear-look-aim-at(npc-tommy-fight-1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    npc-make-aware-of(npc-tommy-fight-1, player, 2, 0);
                }
            }
        }
    }
    state tommy-choreo-cover {
        block start {
            track main {
                lambda {
                    set-boolean(EXTERN-tommy-in-valid-shoot-state, 1, self);
                }
                lambda {
                    npc-cancel-fire-command(npc-tommy-fight-1);
                }
                lambda {
                    npc-clear-look-aim-at(npc-tommy-fight-1);
                }
                lambda {
                    signal(in-cover, 0);
                }
            }
            track reposition {
                lambda {
                    while (1) {
                        if (get-boolean(CTRL-request-retreat, self) && tommy-has-not-seen-player-for?(0.50)) {
                            go(retreat, 1);
                        } else if (get-boolean(CTRL-request-reposition, self)) {
                            go(repositioning, 1);
                        }
                        wait-one-frame();
                    }
                }
            }
            track turn-off-for-instant-kill {
                lambda {
                    wait-boolean(turn-off-shoot-controller, 1, self);
                }
                lambda {
                    go(clean-up, 1);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(save-lev, sle-tommy-sniper-lobby-approach-back)) {
                        go(clean-up, 1);
                    } else if (task-complete?(save-lev, sle-tommy-sniper-lobby-fight-from-windows)) {
                        go(reset, 1);
                    }
                }
            }
        }
        block event player-attacked {
            track main {
                lambda {
                    set-boolean(player-hit-by-tommy, 1, self);
                }
            }
        }
        block update {
            track main {
                lambda {
                    npc-make-aware-of(npc-tommy-fight-1, player, 2, 0);
                }
            }
        }
    }
    state shoot-aiming-player {
        block start {
            track main {
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("shoot controller - shoot aiming player"), 19);
                    }
                }
                lambda {
                    set-boolean(EXTERN-tommy-in-valid-shoot-state, 0, self);
                }
                lambda {
                    while (!npc-is-aiming-at-object?(npc-tommy-fight-1, player, 1.00)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    npc-fire-at-object(npc-tommy-fight-1, player, 1, 3, 256, 0);
                }
                lambda {
                    signal(shot-fired, 0);
                }
                lambda {
                    wait(1.50);
                }
                lambda {
                    npc-fire-at-object(npc-tommy-fight-1, player, 2, 3, 256, 0);
                }
            }
            track player-stopped-aiming {
                lambda {
                    wait-for(shot-fired);
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    while (!player-is-aiming?() && !tommy-has-not-seen-player-for?(0.50)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    go(tommy-shoot-at-player, 1);
                }
            }
            track tommy-hit-player {
                lambda {
                    while (!player-in-state?(HitReaction)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    while (1) {
                        if (get-boolean(EXTERN-tommy-shot-at-perch, self) && get-boolean(RGN-tommy-shoot-repo-left, self)) {
                            go(reposition-one-left, 1);
                        } else if (get-boolean(EXTERN-tommy-shot-at-perch, self) && get-boolean(RGN-tommy-shoot-repo-middle, self)) {
                            go(reposition-one-middle, 1);
                        } else if (get-boolean(EXTERN-tommy-shot-at-perch, self) && get-boolean(RGN-tommy-shoot-repo-right, self)) {
                            go(reposition-one-right, 1);
                        }
                        wait-one-frame();
                    }
                }
            }
            track turn-off-for-instant-kill {
                lambda {
                    wait-boolean(turn-off-shoot-controller, 1, self);
                }
                lambda {
                    go(clean-up, 1);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(save-lev, sle-tommy-sniper-lobby-approach-back)) {
                        go(clean-up, 1);
                    } else if (task-complete?(save-lev, sle-tommy-sniper-lobby-fight-from-windows)) {
                        go(reset, 1);
                    }
                }
            }
        }
        block end {
            track main {
                lambda {
                    npc-cancel-fire-command(npc-tommy-fight-1);
                }
                lambda {
                    npc-reload-weapon(npc-tommy-fight-1, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    npc-look-aim-at-object(npc-tommy-fight-1, player, 0, -1.00, 0);
                }
                lambda {
                    npc-make-aware-of(npc-tommy-fight-1, player, 2, *npc-awareness-options-silent*);
                }
            }
        }
    }
    state repositioning {
        block start {
            track main {
                lambda {
                    set-boolean(request-fire, 1, ss-sle-tommy-strafing-shoot-controller-1);
                }
                lambda {
                    set-boolean(EXTERN-tommy-in-valid-shoot-state, 0, self);
                }
                lambda {
                    set-boolean(EXTERN-tommy-choreo-shooting, 0, self);
                }
                lambda {
                    npc-cancel-fire-command(npc-tommy-fight-1);
                }
                lambda {
                    wait-boolean(CTRL-request-reposition, 0, self);
                }
                lambda {
                    go(tommy-cover-at-perch, 1);
                }
            }
            track shortcut-retreat {
                lambda {
                    while (!get-boolean(CTRL-request-retreat, self)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    set-boolean(CTRL-request-reposition, 0, self);
                }
                lambda {
                    go(retreat, 1);
                }
            }
            track turn-off-for-instant-kill {
                lambda {
                    wait-boolean(turn-off-shoot-controller, 1, self);
                }
                lambda {
                    go(clean-up, 1);
                }
            }
        }
        block end {
            track main {
                lambda {
                    set-boolean(request-fire, 0, ss-sle-tommy-strafing-shoot-controller-1);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(save-lev, sle-tommy-sniper-lobby-approach-back)) {
                        go(clean-up, 1);
                    } else if (task-complete?(save-lev, sle-tommy-sniper-lobby-fight-from-windows)) {
                        go(reset, 1);
                    }
                }
            }
        }
    }
    state retreat {
        block start {
            track main {
                lambda {
                    set-boolean(EXTERN-tommy-in-valid-shoot-state, 0, self);
                }
                lambda {
                    set-boolean(EXTERN-tommy-choreo-shooting, 0, self);
                }
                lambda {
                    npc-cancel-fire-command(npc-tommy-fight-1);
                }
                lambda {
                    set-boolean(retreating, 1, self);
                }
                lambda {
                    wait-boolean(CTRL-request-retreat, 0, self);
                }
                lambda {
                    go(reset, 1);
                }
            }
            track turn-off-for-instant-kill {
                lambda {
                    wait-boolean(turn-off-shoot-controller, 1, self);
                }
                lambda {
                    go(clean-up, 1);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(save-lev, sle-tommy-sniper-lobby-approach-back)) {
                        go(clean-up, 1);
                    }
                }
            }
        }
    }
    state reset {
        block start {
            track main {
                lambda {
                    set-boolean(player-hit-by-tommy, 0, self);
                }
                lambda {
                    set-boolean(RGN-tommy-shoot-repo-left, 0, self);
                }
                lambda {
                    set-boolean(RGN-tommy-shoot-repo-middle, 0, self);
                }
                lambda {
                    set-boolean(RGN-tommy-shoot-repo-right, 0, self);
                }
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("making windows shoot at manny m false - reset"), 19);
                    }
                }
                lambda {
                    set-boolean(tommy-fired-this-frame, 0, self);
                }
                lambda {
                    set-boolean(EXTERN-tommy-shot-at-perch, 0, self);
                }
                lambda {
                    set-boolean(retreating, 0, self);
                }
                lambda {
                    set-boolean(CTRL-request-retreat, 0, self);
                }
                lambda {
                    set-boolean(CTRL-request-reposition, 0, self);
                }
                lambda {
                    set-boolean(just-repositioned-force-miss-next-shot, 1, self);
                }
                lambda {
                    set-boolean(EXTERN-tommy-choreo-shooting, 0, self);
                }
                lambda {
                    stop-timer(choreo-timer, self);
                }
                lambda {
                    go(repositioning, 1);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(save-lev, sle-tommy-sniper-lobby-approach-back)) {
                        go(clean-up, 1);
                    }
                }
            }
        }
    }
    state clean-up {
        block start {
            track main {
                lambda {
                    npc-cancel-fire-command(npc-tommy-fight-1);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
