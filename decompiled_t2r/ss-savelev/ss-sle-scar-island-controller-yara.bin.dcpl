        block event task-complete {
            track main {
                lambda {
                    if (task-active?(save-lev, sle-scar-village-levs-house)) {
                        go(follow-spline-to-finding-lev, 1);
                    }
                }
            }
        }
    }
    state follow-spline-to-finding-lev {
        block start {
            track main {
                lambda {
                    npc-set-demeanor(yara, 1, 0);
                }
                lambda {
                    wait-npc-request-lead-spline(yara, spl-sle-scar-island-lev-house-to-finding-lev-1, player, *sle-scar-island-village-levs-house-lead-settings*, 4, 0);
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    set-tension-mode(1);
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
