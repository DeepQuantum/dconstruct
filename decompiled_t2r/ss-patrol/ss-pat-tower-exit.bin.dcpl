                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-spawner-locator(ap-pat-tower-untie-horses-1, 1);
                    *(i32*)*var_0[1] = 28;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 0.50;
                    *(i32*)*var_0[2] = 30;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.50;
                    *(i32*)*var_0[3] = 57;
                    *(u64*)(*var_0[3] + 8) = 0;
                    *(f32*)(*var_0[3] + 8) = 60.00;
                    *(i32*)*var_0[4] = 27;
                    *(u64*)(*var_0[4] + 8) = 0;
                    *(u8*)(*var_0[4] + 8) = 2;
                    *(i32*)*var_0[5] = 29;
                    *(u64*)(*var_0[5] + 8) = 0;
                    *(u8*)(*var_0[5] + 8) = 2;
                    *(i32*)*var_0[6] = 24;
                    *(u64*)(*var_0[6] + 8) = 0;
                    *(i32*)(*var_0[6] + 8) = 2;
                    animate_(player-horse, pat-suburbs-tower-untie-horse--horse-main, var_0);
                    character-wait-for-horse-to-finish-anim(player, player-horse, pat-suburbs-tower-untie-horse--horse-main);
                }
            }
            track vox {
                lambda {
                    wait-for(anim-start);
                }
                lambda {
                    wait-say(player, vox-igc-ell-igc-pat-tower-untie-horse-001, 2, 0);
                }
            }
            track haptics {
                lambda {
                    if (joypad-has-haptics?(2)) {
                        wait-until-anim-frame(player, pat-suburbs-tower-untie-horse--ellie, 42.00, 2);
                        play-hfx-id(touch-soft, 0, 2);
                        wait-until-anim-frame(player, pat-suburbs-tower-untie-horse--ellie, 64.00, 2);
                        play-hfx-id(touch-soft, 0, 2);
                        wait-until-anim-frame(player, pat-suburbs-tower-untie-horse--ellie, 92.00, 2);
                        play-hfx-id(touch-soft, 0, 2);
                        wait-until-anim-frame(player, pat-suburbs-tower-untie-horse--ellie, 186.00, 2);
                        play-hfx-id(clamber-foot-light-haptic, 0, 2);
                        wait-until-anim-frame(player, pat-suburbs-tower-untie-horse--ellie, 244.00, 2);
                        play-hfx-id(clamber-foot-light-haptic, 0, 2);
                    }
                }
            }
        }
    }
    state lead-out {
        block start {
            track main {
                lambda {
                    wait-boolean(exited-tower?, 1, self);
                }
                lambda {
                    task-complete!(patrol, pat-tower-untie-horses);
                }
                lambda {
                    go(complete, 1);
                }
            }
            track disable-sprint {
                lambda {
                    while (1) {
                        set-player-horse-move-settings/f(*horse-move-settings-trot*);
                        wait-one-frame();
                    }
                }
            }
        }
    }
}
