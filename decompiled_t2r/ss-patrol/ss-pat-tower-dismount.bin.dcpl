                    reins-pin-at-point(player-horse, 0.50, get-spawner-locator(pos-pat-tower-horse-reins-pin-point-1, 1));
                }
                lambda {
                    reins-pin-at-point(dina-horse, 0.50, get-spawner-locator(pos-pat-tower-horse-reins-pin-point-dina-1, 1));
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
