                    npc-request-explore(dina, rgn-dina-follow-explore-library-5, 0, *ps-buddy-explore-performance-first*, 8.00, 0, *default-ai-explore-follow-settings*, 0);
                }
            }
            track see-lights {
                lambda {
                    wait-boolean(player-past-see-lights?, 1, self);
                }
                lambda {
                    wait-npc-leave-cinematic-action-pack(dina, cap-library-seelight-1);
                }
                lambda {
                    npc-request-explore(dina, rgn-dina-follow-explore-library-5, 0, *ps-buddy-explore-performance-first*, 8.00, 0, *default-ai-explore-follow-settings*, 0);
                }
            }
        }
        block event hint-timer-done {
            track main {
                lambda {
                    if (event-sender() == hint-waypoint-basement-stairs-1) {
                        go(start-basement-hint, 1);
                    }
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(patrol, pat-library-generator-on)) {
                        go(complete, 1);
                    }
                }
            }
        }
    }
    state start-basement-hint {
        block start {
            track main {
                lambda {
                    npc-request-explore(dina, rgn-dina-follow-explore-library-2, 0, *ps-buddy-explore-performance-first*, 50.00, 0, *default-ai-explore-follow-settings*, 0);
                }
                lambda {
                    npc-use-cinematic-action-pack(dina, cap-library-find-light-6, 1, 0, 0);
                }
                lambda {
                    while (!npc-is-using-cinematic-action-pack?(dina)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    wait(1.20);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gam-pat-library-basement-stairs-discovery-sp-001, 2, 0);
                }
                lambda {
                    send-event(turn-on, hint-waypoint-basement-stairs-2);
                }
                lambda {
                    send-event(turn-off, hint-waypoint-basement-stairs-1);
                }
                lambda {
                    npc-request-hold(dina, 10.00);
                }
            }
        }
        block event hint-displayed {
            track main {
                lambda {
                    if (event-sender() == hint-waypoint-basement-stairs-2) {
                        go(do-basement-hint, 1);
                    }
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(patrol, pat-library-generator-on)) {
                        go(complete, 1);
                    }
                }
            }
        }
    }
    state do-basement-hint {
        block start {
            track main {
                lambda {
                    wait-say(player, vox-igc-ell-gen-cya-pat-library-basement-stairs-002, 2, 0);
                }
                lambda {
                    wait(0.60);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gen-cya-pat-library-basement-stairs-003, 2, 0);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(patrol, pat-library-generator-on)) {
                        go(complete, 1);
                    }
                }
            }
        }
    }
}
