                }
                lambda {
                    wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 667.00, 2);
                }
                lambda {
                    if (get-boolean(use-astro-pack, self)) {
                        kill-entity-if-spawned(obj-pat-jackson-home-backpack-2);
                    } else {
                        kill-entity-if-spawned(obj-pat-jackson-home-backpack-1);
                    }
                }
                lambda {
                    player-swap-to-cloth-backpack(0);
                }
                lambda {
                    player-set-backpack-visible(1);
                }
                lambda {
                    wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 675.00, 2);
                }
                lambda {
                    set-mesh-visible(player, ellie-patrol-hoodie-nocloth, 0);
                }
                lambda {
                    player-set-prop-visible(ellie-patrol-hoodie-cloth, 1);
                }
            }
            track vox {
                lambda {
                    send-event(vox-grab-backpack, ss-vox-pat-jackson-home-grab-backpack-1);
                }
                lambda {
                    stop-speaking(player);
                }
                lambda {
                    wait-say(player, vox-igc-ell-igc-pat-jackson-home-backpack-001, 2, 0);
                }
            }
            track kill {
                lambda {
                    wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 409.00, 2);
                }
                lambda {
                    kill-entity-if-spawned(obj-pat-jackson-home-pistol-1);
                }
                lambda {
                    kill-entity-if-spawned(obj-pat-jackson-home-notebook-1);
                }
                lambda {
                    kill-entity-if-spawned(obj-pat-jackson-home-jacket-1);
                }
                lambda {
                    kill-entity-if-spawned(obj-pat-jackson-home-walkman-1);
                }
            }
            track haptics {
                lambda {
                    if (joypad-has-haptics?(2)) {
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 21.00, 2);
                        play-hfx-id(hand-grab-haptic, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 57.00, 2);
                        play-hfx-id(touch-soft, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 68.00, 2);
                        play-hfx-id(touch-soft, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 105.00, 2);
                        play-hfx-id(hand-grab-haptic, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 136.00, 2);
                        play-hfx-id(hand-grab-haptic-right, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 177.00, 2);
                        play-hfx-id(pistol-chamber-haptic-back, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 202.00, 2);
                        play-hfx-id(pistol-chamber-haptic, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 220.00, 2);
                        play-hfx-id(touch-soft-left, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 243.00, 2);
                        play-hfx-id(hand-grab-haptic, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 270.00, 2);
                        play-hfx-id(hand-grab-haptic-right, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 293.00, 2);
                        play-hfx-id(hand-grab-haptic-right, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 312.00, 2);
                        play-hfx-id(touch-soft-right, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 350.00, 2);
                        play-hfx-id(hand-grab-haptic, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 391.00, 2);
                        play-hfx-id(hand-grab-haptic, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 416.00, 2);
                        play-hfx-id(hfx-craft-zip, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 439.00, 2);
                        play-hfx-id(hand-grab-haptic, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 522.00, 2);
                        play-hfx-id(hfx-craft-outro, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 556.00, 2);
                        play-hfx-id(touch-soft, 0, 2);
                        wait-until-anim-frame(player, pat-jackson-home-backpack--ellie, 612.00, 2);
                        play-hfx-id(touch-soft, 0, 2);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    player-disable-dialog-look(0.00);
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    set-region-enabled(rr-pat-ellieroom-igc-opti-1, 0, 0);
                }
                lambda {
                    if (!entity-exists?(obj-pat-jackson-home-desk-chair-1)) {
                        wait-spawn-entity(obj-pat-jackson-home-desk-chair-1, 0);
                        animate-done(obj-pat-jackson-home-desk-chair-1, pat-jackson-home-backpack--chair, 0, 0, 0, 2);
                    }
                }
                lambda {
                    player-set-backpack-visible(1);
                }
                lambda {
                    set-visible(player-get-flashlight(), 1);
                }
                lambda {
                    set-mesh-visible(player, ellie-patrol-jacket, 1);
                }
                lambda {
                    set-mesh-visible(player, ellie-patrol-hoodie, 0);
                }
                lambda {
                    send-event(ready-to-go, ss-pat-jackson-home-leave-room-1);
                }
                lambda {
                    set-boolean(got-backpack, 1, ss-pat-jackson-home-leave-room-1);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state complete {
        block start {
            track main {
                lambda {
                    set-region-enabled(rr-pat-ellieroom-igc-opti-1, 0, 0);
                }
                lambda {
                    if (get-boolean(use-astro-pack, self)) {
                        kill-entity-if-spawned(obj-pat-jackson-home-backpack-2);
                    } else {
                        kill-entity-if-spawned(obj-pat-jackson-home-backpack-1);
                    }
                }
                lambda {
                    kill-entity-if-spawned(obj-pat-jackson-home-pistol-1);
                }
                lambda {
                    kill-entity-if-spawned(obj-pat-jackson-home-notebook-1);
                }
                lambda {
                    kill-entity-if-spawned(obj-pat-jackson-home-jacket-1);
                }
                lambda {
                    kill-entity-if-spawned(obj-pat-jackson-home-walkman-1);
                }
            }
        }
    }
}
