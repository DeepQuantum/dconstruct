            track main {
                lambda {
                    if (get-boolean(quick-turn-disabled?, self)) {
                        player-disable-quick-turn();
                    }
                }
            }
        }
        block event player-squeeze-through {
            track main {
                lambda {
                    if (get-boolean(quick-turn-disabled?, self)) {
                        set-boolean(quick-turn-disabled?, 0, self);
                    } else {
                        set-boolean(quick-turn-disabled?, 1, self);
                    }
                }
            }
        }
    }
}
