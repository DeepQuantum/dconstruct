                lambda {
                    go(recipe, 1);
                }
            }
            track molotov {
                lambda {
                    wait-for(kill-molotov);
                }
                lambda {
                    wait-frames(30);
                }
                lambda {
                    kill-entity(obj-pat-supermarket-molotov-1);
                }
            }
            track flashlight-volumetric {
                lambda {
                    while (!signal-raised?(kill-molotov, 0)) {
                        player-flashlight-force-facing();
                        player-flashlight-set-particle-fade(0.00, 0.00);
                        wait-one-frame();
                    }
                }
                lambda {
                    send-event(pop-flashlight, player);
                }
                lambda {
                    while (1) {
                        player-flashlight-force-facing-camera();
                        wait-one-frame();
                    }
                }
            }
            track vox {
                lambda {
                    say(player, vox-igc-ell-igc-pat-market-dina-crafts-molotov-exit-001, 2, 0);
                }
                lambda {
                    say(dina, vox-igc-din-igc-pat-market-dina-crafts-molotov-exit-001, 2, 0);
                }
                lambda {
                    send-event(vox-molotov-done, ss-vox-pat-supermarket-mixed-combat-1);
                }
                lambda {
                    send-event(got-molotov, ss-pat-hint-supermarket-rope-1);
                }
            }
            track audio {
                lambda {
                    wait-for(kill-molotov);
                }
                lambda {
                    stop-sound(get-int32(sound-molotov-slosh-lp, self));
                }
            }
        }
    }
    state recipe {
        block start {
            track main {
                lambda {
                    if (is-new-game-plus?()) {
                        if (!player-knows-recipe?(molotov)) {
                            player-learn-recipe-by-item-id(molotov, 0);
                            hud2-request-new-item-notification(molotov, 0.00, 0);
                        }
                    }
                }
                lambda {
                    go(wait-for-vault, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    u64? var_0 = get-player-weapon-id();
                    if (var_0 == molotov) {
                        joypad-disable-commands(object-arc-throw, throwable-throw, object-throw, object-throw-hold, object-quick-throw, object-quick-throw-hold, aim);
                    }
                    if (var_0 == brick || var_0 == bottle || var_0 == pistol-beretta && var_0 == rifle-remington-bolt) {
                        if (var_0 == brick && !(var_0 == bottle)) {
                            player-force-npc-aim-block/f();
                        }
                        var_1 = joypad-disable-commands(fire, object-arc-throw, throwable-throw, object-throw, object-throw-hold, object-quick-throw, object-quick-throw-hold);
                    }
                }
            }
        }
    }
    state wait-for-vault {
        block event entering-mixed-combat {
            track main {
                lambda {
                    if (get-single-shader-instance-param(get-symbol(dina-gas-mask, ss-pat-supermarket-enter-spores-1), blendOffset2) == 1.00) {
                        set-single-shader-instance-param(get-symbol(dina-gas-mask, ss-pat-supermarket-enter-spores-1), blendOffset2, 0.00);
                    }
                }
                lambda {
                    task-complete-if-active!(patrol, pat-supermarket-molotov);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    u64? var_0 = get-player-weapon-id();
                    if (var_0 == molotov) {
                        joypad-disable-commands(object-arc-throw, throwable-throw, object-throw, object-throw-hold, object-quick-throw, object-quick-throw-hold, aim);
                    }
                    if (var_0 == brick || var_0 == bottle || var_0 == pistol-beretta && var_0 == rifle-remington-bolt) {
                        if (var_0 == brick && !(var_0 == bottle)) {
                            player-force-npc-aim-block/f();
                        }
                        var_1 = joypad-disable-commands(fire, object-arc-throw, throwable-throw, object-throw, object-throw-hold, object-quick-throw, object-quick-throw-hold);
                    }
                }
            }
        }
    }
}
