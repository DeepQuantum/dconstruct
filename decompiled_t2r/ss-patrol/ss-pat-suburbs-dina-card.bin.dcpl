                lambda {
                    set-visible(collectible-suburbs-superhero-card-1, 1);
                }
            }
            track vox {
                lambda {
                    wait-frames(120);
                }
                lambda {
                    send-event(vox-put-card-back, ss-vox-pat-suburbs-houses-1);
                }
            }
        }
    }
}
