                    task-complete!(patrol, pat-tower-upper-floor);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state animate-done {
        block start {
            track main {
                lambda {
                    if (!task-complete?(patrol, pat-tower-untie-horses)) {
                        animate-done(obj-pat-tower-ledger-1, pat-suburbs-tower-ledger-exit-right--ledger, ap-pat-tower-ledger-1, 0, 0, 2);
                        animate-done(obj-pat-tower-pen-1, pat-suburbs-tower-ledger-exit-right--pen, ap-pat-tower-ledger-1, 0, 0, 2);
                    }
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
