                    *(u64*)(*var_0[0] + 8) = get-spawner-locator(ap-pat-clicker-shop-1, 1);
                    *(i32*)*var_0[1] = 28;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 0.50;
                    *(i32*)*var_0[2] = 30;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.50;
                    wait-animate_(obj-pat-clicker-bottle-1, pat-library-enter-shop--bottle, var_0);
                }
                lambda {
                    kill-entity(obj-pat-clicker-bottle-1);
                }
                lambda {
                    throw-projectile(
                        get-locator-position(offset-locator(get-object-locator(dina), alloc-vector(1.00, 1.00, 1.25, 1.00, 0))),
                        get-spawner-position(pos-pat-clicker-sound-1, 1),
                        bottle,
                        -1.00
                    );
                }
            }
        }
        block update {
            track main {
                lambda {
                    camera-shake(t1-handheld-idle-large, 1.00, 1.00, 1);
                }
            }
        }
    }
    state patrol-1 {
        block start {
            track main {
                lambda {
                    wait-one-frame();
                }
                lambda {
                    wait-npc-move-to(npc-pat-clicker-intro-1, get-spawner-locator(pos-pat-clicker-sound-1, 1), 1, 0, 0, 0, 0, 0);
                }
                lambda {
                    npc-set-deaf(npc-pat-clicker-intro-1, 0);
                }
                lambda {
                    npc-set-script-low-priority(npc-pat-clicker-intro-1);
                }
                lambda {
                    npc-set-patrol-route-if-alive(npc-pat-clicker-intro-1, spl-pat-clicker-1, -1);
                }
            }
        }
        block event new-patrol {
            track main {
                lambda {
                    go(patrol-2, 1);
                }
            }
        }
        block event npc-died {
            track main {
                lambda {
                    if (!(npc-alive?(npc-pat-clicker-intro-1))) {
                        go(complete, 1);
                    }
                }
            }
        }
    }
    state patrol-2 {
        block start {
            track main {
                lambda {
                    wait-one-frame();
                }
                lambda {
                    npc-set-patrol-route-if-alive(npc-pat-clicker-intro-1, spl-pat-clicker-2, -1);
                }
            }
        }
        block event exit {
            track main {
                lambda {
                    go(complete, 1);
                }
            }
        }
        block event npc-died {
            track main {
                lambda {
                    if (!(npc-alive?(npc-pat-clicker-intro-1))) {
                        go(complete, 1);
                    }
                }
            }
        }
    }
}
