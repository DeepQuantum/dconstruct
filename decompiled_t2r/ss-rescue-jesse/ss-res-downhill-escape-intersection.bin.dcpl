    state already-complete {
        block start {
            track main {
                lambda {
                    kill-entity-if-spawned(npc-res-downhill-militia-car-back-1);
                }
                lambda {
                    kill-entity-if-spawned(npc-res-downhill-militia-car-back-2);
                }
                lambda {
                    if (entity-exists?(obj-res-downhill-windshield-broken-1)) {
                        set-all-windshield-cracks(1.00, 1);
                        set-all-windshield-cracks(1.00, 0);
                    }
                }
                lambda {
                    if (task-not-complete?(rescue-jesse, res-downhill-infected)) {
                        while (!object-spawned?(obj-res-downhill-militia-car-1)) {
                            wait(0.10);
                        }
                        set-shader-instance-blend-offset(obj-res-downhill-militia-car-1, 0.20, 2);
                        set-shader-instance-blend-offset(obj-jeep-res-downhill-escape-1, 1.00, 1);
                    }
                }
                lambda {
                    if (task-range-active?(rescue-jesse, res-downhill-infected-charge, rescue-jesse, res-downhill-hood)) {
                        spawn-entity(fx-res-downhill-fire-1, 0, 0);
                    }
                }
                lambda {
                    if (task-not-complete?(rescue-jesse, res-downhill-crash)) {
                        spawn-hood-smoke();
                        go(cleanup-2, 1);
                    }
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state cleanup-2 {
        block event kill-hood-smoke {
            track main {
                lambda {
                    kill-particles(get-uint64(car-smoke-handle, self), 1);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
