                    if (!joypad-has-haptics?(2)) {
                        if (get-symbol(tension-list, self) == quiet-anim-list) {
                            rumble-curve(0.35, 0.10, 1.30, 1, 0);
                            wait-frames(110);
                            wait-frames(27);
                            wait-frames(41);
                            rumble-curve(0.10, 0.30, 0.30, 1, 0);
                            wait-frames(9);
                            rumble-curve(0.30, 0.30, 0.70, 1, 0);
                            wait-frames(25);
                            rumble-curve(0.30, 0.40, 0.20, 1, 0);
                        } else if (get-symbol(tension-list, self) == calm-anim-list) {
                            rumble-curve(0.35, 0.10, 1.30, 1, 0);
                            wait-frames(110);
                            wait-frames(27);
                            wait-frames(49);
                            rumble-curve(0.10, 0.30, 0.30, 1, 0);
                            wait-frames(9);
                            rumble-curve(0.30, 0.30, 0.70, 1, 0);
                            wait-frames(22);
                            rumble-curve(0.30, 0.40, 0.20, 1, 0);
                        } else {
                            rumble-curve(0.35, 0.10, 0.83, 1, 0);
                            wait-frames(65);
                            wait-frames(34);
                            wait-frames(43);
                            rumble-curve(0.10, 0.30, 0.30, 1, 0);
                            wait-frames(9);
                            rumble-curve(0.30, 0.30, 0.80, 1, 0);
                            wait-frames(24);
                            rumble-curve(0.30, 0.40, 0.20, 1, 0);
                        }
                    }
                }
            }
            track haptics {
                lambda {
                    if (joypad-has-haptics?(2)) {
                        if (get-symbol(tension-list, self) == quiet-anim-list) {
                            set-int32(struggle-haptic-pid, play-hfx-id(push-object-haptic-effect, 0, 2), self);
                            while (!object-anim-reached-frame?(player, res-neighborhood-backdoor-quiet-end--ellie, 39.00, 2)) {
                                hfx-continue(get-int32(struggle-haptic-pid, self));
                                wait-one-frame();
                            }
                            wait-until-anim-frame(player, res-neighborhood-backdoor-quiet-end--ellie, 85.00, 2);
                            play-hfx-id(door-close-haptic, 0, 2);
                            wait-until-anim-frame(player, res-neighborhood-backdoor-quiet-end--ellie, 115.00, 2);
                            play-hfx-id(soft-snap-haptic, 0, 2);
                            wait-until-anim-frame(player, res-neighborhood-backdoor-quiet-end--ellie, 183.00, 2);
                            set-int32(struggle-haptic-pid, play-hfx-id(push-object-haptic-effect, 0, 2), self);
                            while (!object-anim-reached-frame?(player, res-neighborhood-backdoor-quiet-end--ellie, 213.00, 2)) {
                                hfx-continue(get-int32(struggle-haptic-pid, self));
                                wait-one-frame();
                            }
                            play-hfx-id(push-haptic-medium-impact, 0, 2);
                        } else if (get-symbol(tension-list, self) == calm-anim-list) {
                            set-int32(struggle-haptic-pid, play-hfx-id(push-object-haptic-effect, 0, 2), self);
                            while (!object-anim-reached-frame?(player, res-neighborhood-backdoor-calm-end--ellie, 39.00, 2)) {
                                hfx-continue(get-int32(struggle-haptic-pid, self));
                                wait-one-frame();
                            }
                            wait-until-anim-frame(player, res-neighborhood-backdoor-calm-end--ellie, 107.00, 2);
                            play-hfx-id(door-close-haptic, 0, 2);
                            wait-until-anim-frame(player, res-neighborhood-backdoor-calm-end--ellie, 125.00, 2);
                            play-hfx-id(soft-snap-haptic, 0, 2);
                            wait-until-anim-frame(player, res-neighborhood-backdoor-calm-end--ellie, 187.00, 2);
                            set-int32(struggle-haptic-pid, play-hfx-id(push-object-haptic-effect, 0, 2), self);
                            while (!object-anim-reached-frame?(player, res-neighborhood-backdoor-calm-end--ellie, 226.00, 2)) {
                                hfx-continue(get-int32(struggle-haptic-pid, self));
                                wait-one-frame();
                            }
                            play-hfx-id(push-haptic-medium-impact, 0, 2);
                        } else {
                            set-int32(struggle-haptic-pid, play-hfx-id(push-object-haptic-effect, 0, 2), self);
                            while (!object-anim-reached-frame?(player, res-neighborhood-backdoor-attack-end--ellie, 37.00, 2)) {
                                hfx-continue(get-int32(struggle-haptic-pid, self));
                                wait-one-frame();
                            }
                            wait-until-anim-frame(player, res-neighborhood-backdoor-attack-end--ellie, 67.00, 2);
                            play-hfx-id(door-close-haptic, 0, 2);
                            wait-until-anim-frame(player, res-neighborhood-backdoor-attack-end--ellie, 86.00, 2);
                            play-hfx-id(soft-snap-haptic, 0, 2);
                            wait-until-anim-frame(player, res-neighborhood-backdoor-attack-end--ellie, 142.00, 2);
                            set-int32(struggle-haptic-pid, play-hfx-id(push-object-haptic-effect, 0, 2), self);
                            while (!object-anim-reached-frame?(player, res-neighborhood-backdoor-attack-end--ellie, 172.00, 2)) {
                                hfx-continue(get-int32(struggle-haptic-pid, self));
                                wait-one-frame();
                            }
                            play-hfx-id(push-haptic-hard-impact, 0, 2);
                        }
                    }
                }
            }
            track hud {
                lambda {
                    hud2-signal-interactable-hold-success();
                }
            }
        }
        block update {
            track main {
                lambda {
                    camera-shake(t1-handheld-idle-large, 1.00, 1.00, 1);
                }
            }
        }
    }
    state wait-kill {
        block start {
            track main {
                lambda {
                    wait(3.00);
                }
                lambda {
                    while (player-listen-mode-active?()) {
                        wait-one-frame();
                    }
                }
                lambda {
                    npc-kill(npc-res-store-dog-on-leash-3);
                }
                lambda {
                    npc-kill(npc-res-store-dog-on-leash-4);
                }
                lambda {
                    npc-kill(npc-res-store-human-with-dog-3);
                }
                lambda {
                    npc-kill(npc-res-store-human-with-dog-4);
                }
                lambda {
                    npc-kill(npc-res-store-human-without-dog-2);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    if (entity-exists?(obj-res-neighborhood-vending-1)) {
                        animate-done(obj-res-neighborhood-vending-1, res-neighborhood-backdoor-calm-end--desk, ap-res-neighborhood-exit-1, 0, 0, 2);
                    }
                }
                lambda {
                    if (entity-exists?(obj-res-neighborhood-exit-1)) {
                        animate-done(obj-res-neighborhood-exit-1, res-neighborhood-backdoor-calm-end--door, ap-res-neighborhood-exit-1, 0, 0, 2);
                    }
                }
            }
        }
    }
}
