                    set-float(joel-blend-into-dismount-time, lerp-scale(
                        0.00,
                        1.00,
                        get-float(blend-in-sec-from-gate-enter, self),
                        get-float(max-blend-in-sec-from-gate-enter, self),
                        spline-percentage-locator(spl-efg-prologue-ride-gate-dismount-blend-1, get-object-locator(player-horse), 0)
                    ), self);
                }
            }
        }
    }
    state dismount {
        block start {
            track pause-card {
                lambda {
                    wait-boolean(narrative-lead-credits-shown?, 1, self);
                }
                lambda {
                    wait(0.50);
                }
                lambda {
                    wait-gui2-show-pause-card(*credits-starring*, 1, 1, 1);
                }
                lambda {
                    set-boolean(starring-credits-shown?, 1, ss-cin-efg-prologue-jackson-gate-1);
                }
            }
            track joel {
                lambda {
                    camera-enable-animated-blend-time-from-angle(
                        5.00,
                        1.00,
                        player,
                        efg-ride-dismount--joel,
                        get-attach-point-parented-bound-frame(player-horse, targHeroAttach),
                        180.00,
                        45.00,
                        apReference-camera1,
                        0.00
                    );
                }
                lambda {
                    signal(anim-start, 0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 6, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-attach-point-parented-bound-frame(player-horse, targHeroAttach);
                    *(i32*)*var_0[1] = 14;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(u64*)(*var_0[1] + 8) = apRef-player;
                    *(i32*)*var_0[2] = 57;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = get-float(start-frame-for-anim, self);
                    *(i32*)*var_0[3] = 28;
                    *(u64*)(*var_0[3] + 8) = 0;
                    *(f32*)(*var_0[3] + 8) = get-float(blend-in-sec-from-gate-enter, self);
                    *(i32*)*var_0[4] = 22;
                    *(u64*)(*var_0[4] + 8) = 0;
                    *(f32*)(*var_0[4] + 8) = get-float(end-phase-for-first-anim, self);
                    *(i32*)*var_0[5] = 45;
                    *(u64*)(*var_0[5] + 8) = 0;
                    *(f32*)(*var_0[5] + 8) = get-float(blend-in-sec-from-gate-enter, self);
                    wait-animate_(player, efg-ride-dismount--joel, var_0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 5, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-attach-point-parented-bound-frame(player-horse, targHeroAttach);
                    *(i32*)*var_0[1] = 14;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(u64*)(*var_0[1] + 8) = apRef-player;
                    *(i32*)*var_0[2] = 28;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = get-float(joel-blend-into-dismount-time, self);
                    *(i32*)*var_0[3] = 30;
                    *(u64*)(*var_0[3] + 8) = 0;
                    *(f32*)(*var_0[3] + 8) = get-float(blend-in-sec-to-cine, self);
                    *(i32*)*var_0[4] = 59;
                    *(u64*)(*var_0[4] + 8) = 0;
                    *(i32*)(*var_0[4] + 8) = 1;
                    wait-animate_(player, efg-ride-dismount--joel, var_0);
                }
                lambda {
                    task-complete!(ellie-flashback-guitar, efg-prologue-ride-to-jackson-above-gate);
                }
                lambda {
                    camera-fade-out-animated(2.00, 0);
                }
            }
            track joel-horse {
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 5, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-bound-frame(moving-ap, self);
                    *(i32*)*var_0[1] = 28;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = get-float(blend-in-sec-from-gate-enter, self);
                    *(i32*)*var_0[2] = 57;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = get-float(start-frame-for-anim, self);
                    *(i32*)*var_0[3] = 45;
                    *(u64*)(*var_0[3] + 8) = 0;
                    *(f32*)(*var_0[3] + 8) = get-float(blend-in-sec-from-gate-enter, self);
                    *(i32*)*var_0[4] = 22;
                    *(u64*)(*var_0[4] + 8) = 0;
                    *(f32*)(*var_0[4] + 8) = get-float(end-phase-for-first-anim, self);
                    wait-animate_(player-horse, efg-ride-dismount--horse, var_0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 5, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-spawner-locator(ap-efg-prologue-ride-gate-dismount-1, 1);
                    *(i32*)*var_0[1] = 28;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = get-float(joel-blend-into-dismount-time, self);
                    *(i32*)*var_0[2] = 59;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(i32*)(*var_0[2] + 8) = 1;
                    *(i32*)*var_0[3] = 0;
                    *(u64*)(*var_0[3] + 8) = 0;
                    *(u8*)(*var_0[3] + 8) = 1;
                    *(i32*)*var_0[4] = 30;
                    *(u64*)(*var_0[4] + 8) = 0;
                    *(f32*)(*var_0[4] + 8) = get-float(blend-in-sec-to-cine, self);
                    wait-animate_(player-horse, efg-ride-dismount--horse, var_0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (!task-complete?(ellie-flashback-guitar, efg-prologue-ride-to-jackson-above-gate)) {
                        update-ap-ref(player, get-attach-point-parented-bound-frame(player-horse, targHeroAttach), 0);
                    }
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
