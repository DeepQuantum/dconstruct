    state injured {
        block start {
            track injured-anim {
                lambda {
                    send-event(increase-fail-timer-2, ss-efg-prologue-operating-room-fail-1);
                }
            }
            track vox {
                lambda {
                    say(npc-joel-operating-room-doc-1, vox-igc-sur-gam-efg-operating-room-attack, 2, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    attach-scalpel-to-owner();
                }
                lambda {
                    if (get-locator-distance(get-object-locator(player), get-spawner-locator(pos-efg-operating-room-doc-protect-1, 1)) > 4.00) {
                        clear-look-at(npc-joel-operating-room-doc-1);
                    }
                }
                lambda {
                    if (joypad-command-active?(melee-attack, 6) && can-interact-with-doc()) {
                        go(melee-kill, 1);
                    }
                }
            }
        }
        block event flinch {
            track main {
                lambda {
                    flinch-doc-1();
                }
            }
        }
        block event npc-attacked {
            track main {
                lambda {
                    send-event(killed-doctor, self);
                }
            }
        }
    }
    state spawn-dead-doctor {
        block start {
            track main {
                lambda {
                    kill-entity(obj-efg-prologue-invis-collision-1);
                }
                lambda {
                    kill-entity(obj-efg-prologue-invis-collision-2);
                }
                lambda {
                    if (!entity-exists?(npc-joel-operating-room-doc-1)) {
                        spawn-npc(npc-joel-operating-room-doc-1, 0, 0);
                        npc-set-force-player-push(npc-joel-operating-room-doc-1, 1, 0.00, -1.00);
                        while (!object-spawned?(npc-joel-operating-room-doc-1)) {
                            wait-one-frame();
                        }
                    }
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 3, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-spawner-locator(ap-efg-prologue-operating-room-1, 1);
                    *(i32*)*var_0[1] = 58;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 1.00;
                    *(i32*)*var_0[2] = 56;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.00;
                    animate_(npc-joel-operating-room-doc-1, efg-021-doctors-react-to-joel--npc1-choke, var_0);
                }
                lambda {
                    npc-die(npc-joel-operating-room-doc-1, 1, 0, 0, 1);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state complete {
        block start {
            track main {
                lambda {
                    kill-entity(obj-efg-prologue-invis-collision-1);
                }
                lambda {
                    kill-entity(obj-efg-prologue-invis-collision-2);
                }
            }
        }
    }
}
