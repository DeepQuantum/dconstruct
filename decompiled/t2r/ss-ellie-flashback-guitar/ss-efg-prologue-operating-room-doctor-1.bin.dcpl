                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 1.00;
                    *(i32*)*var_0[2] = 56;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.00;
