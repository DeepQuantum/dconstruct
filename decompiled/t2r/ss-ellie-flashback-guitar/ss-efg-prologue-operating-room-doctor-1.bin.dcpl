                    *(f32*)(*var_0[1] + 8) = 0.00;
                    animate_(obj-efg-operating-room-surgical-table-1, efg-021-doctors-react-to-joel--table-choke, var_0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 2, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-spawner-locator(ap-efg-prologue-operating-room-1, 1);
                    *(i32*)*var_0[1] = 28;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 0.30;
                    wait-animate_(npc-joel-operating-room-doc-1, efg-021-doctors-react-to-joel--npc1-choke, var_0);
