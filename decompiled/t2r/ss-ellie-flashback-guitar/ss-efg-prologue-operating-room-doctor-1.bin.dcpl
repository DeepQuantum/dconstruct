                    *(i32*)*var_0[2] = 30;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.60;
                    animate_(player, efg-021-doctors-react-to-joel--joel-choke, var_0);
