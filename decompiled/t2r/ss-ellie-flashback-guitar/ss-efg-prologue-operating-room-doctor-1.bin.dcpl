                }
                lambda {
                    set-boolean(attach-scalpel, 0, self);
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    set-object-locator(obj-efg-operating-room-scalpel-1, get-spawner-locator(pos-efg-operating-room-scalpel-floor-1, 1));
