u64? get-angle-between-cam-and-sun() {
    return angle-in-between-vectors(get-vec-from-bound-frame(camera-locator(0), 2), get-sun-direction());
}

u64? get-angle-between-player-and-sun() {
    return angle-in-between-vectors(get-vec-from-bound-frame(get-object-locator(player), 2), get-sun-direction());
}

