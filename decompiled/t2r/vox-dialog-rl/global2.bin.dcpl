u64? player-desperate() {
    return task-range-active?(find-nora, nor-ellie-alone-streets, find-aquarium, faq-seeing-mel-struggle);
}

u64? vertigo-vox-permitted?() {
    return !(darray-count(all-buddy-npcs) == 0) && !(is-combat-or-search?()) || task-get-current-subnode-id() == med-street-crossroad-lev-shows-off && task-range-active?(medicine, med-infected-building-descent, medicine, med-infected-building-descent-floor-7);
}

bool san-resort-pool-killed-enough-enemies-outside?() {
    return npc-group-alive-count(vox-san-pool-outside-npcs) < 3;
}

u64? afm-first-spotted-abby?() {
    return !(get-svar-as-boolean(vox-afm-first-spotted-abby));
}

u64? nora-chase-active?() {
    return task-range-active?(find-nora, nor-noras-chase-start, find-nora, nor-noras-chase-final-hallway);
}

u64? bear-still-alive?() {
    return !(get-svar-as-boolean(dog-militia-bear-killed));
}

u64? meatshielded-human-near-infected?() {
    return npc-group-alive-count(all-infected-npcs) > 0 && distance-between-objects-less-than?(get-closest-living-npc-in-group(all-infected-npcs, player, 0), player, 5.00);
}

u16 forest-and-garage-npcs-dead?() {
    u16 var_2;
    if (npc-group-alive-count(glt-forest-npcs) == 0 && npc-group-alive-count(glt-garage-npcs) == 0) {
        var_2 = 1;
    } else {
        var_2 = 0;
    }
    return var_2;
}

u64? task-range-active-joe-school-fight?() {
    return task-range-active?(jordan-escape, joe-school-fight, jordan-escape, joe-school-fight-corridor);
}

u64? militia-investigating?() {
    return !(faction-investigating?(3));
}

u64? fight-ruins-combat?() {
    return get-svar-as-boolean(vox-res-neighborhood-fight-houses-street-patrol-combat);
}

u64? nor-inf-hosp-first-spotted-trespasser?() {
    return !(get-svar-as-boolean(vox-nor-inf-hosp-spot-player-trespasser));
}

u64? no-one-speaking?() {
    return !(is-any-major-character-speaking?());
}

u64? joe-school-first-spotted-trespasser?() {
    return !(get-svar-as-boolean(vox-joe-school-first-spotted-trespasser));
}

u64? med-crane?() {
    return task-range-active?(medicine, med-crane-traverse-first-start, medicine, med-crane-traverse-fall);
}

u64? enemy-name-suppression?() {
    return task-continue-active?(find-nora, nor-ellie-alone-streets, workbench-ambush) || task-continue-active?(find-nora, nor-scar-forest-combat, stripmall) && task-continue-active?(find-nora, nor-scar-forest-combat, brute-intro);
}

u64? bill-mumbles-to-self-permitted?() {
    return get-int32(current-wave-num, ss-assault-manager-1) > 1 && !entity-exists?(ss-molotov-rain-1) || get-symbol(last-npc-death-reason, ss-vox-rl-encounter-controller-1) != DismemberDeath || get-symbol(last-npc-death-reason, ss-vox-rl-encounter-controller-1) != ExplosionDeath && get-symbol(last-npc-death-reason, ss-vox-rl-encounter-controller-1) != FireDeath;
}

