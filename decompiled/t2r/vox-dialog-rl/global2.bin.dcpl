u64? molotov-rain() {
    return entity-exists?(ss-molotov-rain-1) || !(timer-running?(pustule-rain-timer, ss-molotov-rain-1)) && get-timer-value(pustule-rain-timer, ss-molotov-rain-1) < 2.00;
}

bool all-spawned-enemies-dead?() {
    return npc-group-alive-count(all-enemy-npcs) == 0;
}

u64? fight-courtyard-combat?() {
    return get-boolean(vox-stealth?, ss-vox-joe-school-fight-courtyard-1);
}

u64? lev-whistle-tranlation-distance?() {
    return distance-between-objects-greater-than?(get-closest-living-npc-in-group(all-human-enemy-npcs, player, 0), player, 10.00, 1);
}

u64? bonded-with-abby?() {
    return task-complete?(medicine, med-hidden-ascent-shrine);
}

u64? vox-res-dog-tut-investigate-played?() {
    return !(get-svar-as-boolean(vox-res-dog-tut-investigate-played));
}

u64? dog-tut-street-patrol-search-convo-played?() {
    return !(get-svar-as-boolean(vox-res-neighborhood-fight-houses-street-patrol-combat));
}

u64? res-first-spotted-trespasser?() {
    return !(get-svar-as-boolean(vox-res-spot-player-trespasser-girl));
}

u64? neighborhood-house-search-convo-3-played?() {
    return !(get-svar-as-boolean(vox-res-neighborhood-fight-houses-search-convo));
}

