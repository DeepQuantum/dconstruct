    if (gui2-widget-exists?(get-symbol(w-button-hold, ss-hud2-1))) {
        var_2 = send-event(force-success, get-symbol(w-button-hold, ss-hud2-1));
    } else {
        var_2 = 0;
    }
    return var_2;
}

sid hud2-get-notification-manager-path() {
    return canvas.hudRoot.rootFullscreen.notifications;
}

u64? hud2-get-arrow-status-prompt() {
    u64? var_1;
    if (is-rogue-mode?()) {
        if (gui2-widget-exists?(canvas.hudRoot.hud-skulls1.group.arrowStatus.group.arrowStatus)) {
            var_1 = canvas.hudRoot.hud-skulls1.group.arrowStatus.group.arrowStatus;
        } else {
            var_1 = gui2-get-widget-path(0);
        }
    } else {
        var_1 = gui2-get-widget-path(0);
    }
    return var_1;
}

u64? hud2-hack-wait-show-pause-tutorial(u64? arg_0, u64? arg_1) {
    if (gui2-widget-exists?(canvas.hudRoot.pauseTutorial)) {
        gui2-kill-widget(canvas.hudRoot.pauseTutorial);
    }
    u64? var_1 = gui2-spawn-widget(canvas.hudRoot, "hud-tutorial/pause-tutorial-temp", "pauseTutorial", 0);
    gui2-set-widget-text-cipher(gui2-build-widget-path(
        var_1,
        "group",
        "text",
        0,
        0,
        0,
        0,
        0,
        0
    ), arg_0);
    gui2-set-widget-state(var_1, off, 0, 0, 0);
    gui2-set-widget-state(var_1, pause, 0, 0, 0);
    wait-gui2-show-and-populate-pause-card(
        *hack-blank-card*,
        0,
        0,
        0,
        0,
        0,
        arg_1,
        0,
        1,
        1
    );
    return gui2-set-widget-state(var_1, idle, 0, 0, 0);
}

