u64? should-show-boat-listen-mode-tutorial?() {
    return get-boolean(visible-in-listen-mode?, boat) && timer-done?(delay-after-exiting-boat-timer, self) || object-further-than-distance-to-object?(player, boat, 30.00, 1) && object-further-than-distance-to-object?(player, boat, 15.00, 1) && !object-on-screen-and-visible?(boat, -1, 0);
}

