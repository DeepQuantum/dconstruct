                        var_52 = gui2-set-progress-bar-radial-subtractive-percent(get-symbol(w-progress-reverse-square, self), var_3 * (1.00 - 1.00));
                    }
                    wait(0.20);
                    go(animate-off, 1);
                }
            }
            track velocity {
                lambda {
                    while (get-float(velocity, self) > 0.00) {
                        set-float(velocity, get-float(velocity, self) - (get-delta-time() * 4.50), self);
                        wait-one-frame();
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (gui2-is-widget-pool-widget?(self)) {
                        gui2-keep-pool-widget-alive/f(self);
                    }
                }
                lambda {
