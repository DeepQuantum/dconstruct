                }
                lambda {
                    update-progress-widgets--button-hold(1);
                }
            }
        }
    }
    state animate-off {
        block start {
            track main {
                lambda {
                    gui2-set-widget-state(self, active, 0, 0, 0);
                }
                lambda {
                    gui2-set-widget-state(self, off, 0, 1, 0);
                }
            }
        }
    }
    state --all-- {
        block event_set-progress {
            track main {
                lambda {
                    set-float(internal-percent, event-arg-float(0), self);
                }
                lambda {
                    set-int32(buffer-frames, 0, self);
                }
                lambda {
                    if (event-arg-float(0) == 1.00) {
                        go(success, 1);
                    }
                }
            }
        }
        block event_force-success {
            track main {
                lambda {
                    set-boolean(forced-success?, 1, self);
                }
            }
        }
        block event_options-menu-changed {
            track main {
                lambda {
                    update-player-setting-hud--proto-button-mash();
                }
            }
        }
        block event_set-interactable-id {
            track main {
                lambda {
                    u64? var_1;
                    if (!(get-symbol(interactable-id, self) == 0)) {
                        var_1 = get-symbol(interactable-id, self);
                    } else {
                        var_1 = hud2-attachable-button-get-interactable-id(self);
                    }
                    u64? var_4 = lookup-interactable-def(var_1);
                    set-symbol(w-pulse-parent, gui2-find-widget-path("pulses", self), self);
                    if (gui2-widget-exists?(get-symbol(w-prompt, self))) {
                        gui2-set-widget-image(gui2-find-widget-path("icon", get-symbol(w-prompt, self)), dc:format("%s@large", *(i64 *)(var_4 + 208)));
                    }
                    if (gui2-widget-exists?(get-symbol(w-prompt-square, self))) {
                        gui2-set-widget-image(gui2-find-widget-path("icon", get-symbol(w-prompt-square, self)), dc:format("%s@large", *(i64 *)(var_4 + 208)));
                    }
                    set-symbol(joypad-command, *(u64 *)(var_4 + 240), self);
                }
            }
        }
        block update {
            track main {
                lambda {
                    update-player-setting-hud--proto-button-mash();
                }
            }
        }
    }
    state --script-- {
        block end {
            track main {
                lambda {
                    set-symbol(w-button-hold, 0, ss-hud2-1);
                }
            }
        }
    }
}
