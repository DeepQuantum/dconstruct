statescript {
    options {
        player
    }
    declarations {
        symbol w-workbench-page = nullptr
    }
    state forward-events {
        block event_pass-page-path {
            track main {
                lambda {
                    set-symbol(w-workbench-page, event-arg-symbol(0), self);
                }
            }
        }
        block event_focus-gained {
            track main {
                lambda {
                    if (!(get-symbol(w-workbench-page, self) == 0)) {
                        send-event(focus-gained, get-symbol(w-workbench-page, self));
                    }
                }
            }
        }
    }
}
