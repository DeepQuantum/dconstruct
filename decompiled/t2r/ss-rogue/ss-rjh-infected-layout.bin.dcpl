statescript {
    options {
        player
    }
    state faction-check {
        block update {
            track main {
                lambda {
                    if (wave-manager-get-next-wave-faction(ss-wave-manager-1) == 3) {
                        go(spawn-layout, 1);
                    }
                }
            }
        }
    }
    state spawn-layout {
        block start {
            track main {
                lambda {
                    foreach (u16 var_2 : rjh-blockers) {
                        spawn-entity(var_2, 0, 0);
                    }
                }
            }
        }
    }
}
