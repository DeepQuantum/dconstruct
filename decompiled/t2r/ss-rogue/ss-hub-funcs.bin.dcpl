u16 hub-library-start-lights(u16 arg_0) {
    hub-library-turn-on-map-workbench();
    hub-library-turn-on-generator-related-lights();
    hug-library-turn-off-base-lights();
    u16 var_0;
    if (arg_0 == 1) {
        var_0 = hub-library-turn-on-workbench();
    } else {
        var_0 = 0;
    }
    return var_0;
}

u64? hub-library-turn-on-workbench() {
    turn-on-light(rt-workbench-a-1, 0);
    turn-on-light(rt-workbench-b-1, 0);
    turn-on-light(rt-workbench-c-1, 0);
    return darray-append(workbench-spawned-light-effects, boxed_symbol(spawn-entity(fx-workbench-light-flare-beam-1, 0, 0)), 0);
}

u64? hub-library-turn-on-map-workbench() {
    set-table-shader-material-values-param(*workbench-t2r-hub-lamp-common*, 0.65);
    return spawn-entity(fx-t2r-hub-workbench-light-flare-beam-1, 0, 0);
}

u64? hug-library-turn-off-base-lights() {
    return turn-off-light(rt-library-door-light-1, 0);
}

u64? hub-library-start-disable-interacts() {
    return interactable-disable(drawer-desk-a-hr1-ao134-1);
}

u64? hub-library-turn-on-generator-related-lights() {
    change-render-setting-value-float(*pat-rs-pat-library-settings*, lighting:bg-dual-lightmap-blend, 0.00);
    set-table-shader-material-values-param(*pat-library-basement-stairs-light*, 1.00);
    set-table-shader-material-values-param(*pat-library-basement-stairs-fluorescent-light*, 1.00);
    set-table-shader-material-values-param(*pat-library-space-heater-a*, 1.00);
    turn-on-light(rt-stairway-generator-light-1, 0);
    turn-on-light(rt-lower-uplight-a-1, 0);
    turn-on-light(rt-lower-uplight-b-1, 0);
    turn-on-light(rt-generator-led-1, 0);
    return turn-on-light(rt-heater-1, 0);
}

