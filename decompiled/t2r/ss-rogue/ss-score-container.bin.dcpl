statescript {
    declarations {
        symbol w-tab-container = nullptr
        i32 num-tabs = 0
    }
    state default {
        block start {
            track main {
                lambda {
                    set-symbol(w-tab-container, gui2-find-widget-path("tab-container", self), self);
                }
                lambda {
                    go(get-score-data, 1);
                }
            }
        }
    }
    state get-score-data {
        block start {
            track main {
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("DEB-UI-SC: Getting score data"), 19);
                    }
                }
                lambda {
                    u64? var_0 = score-manager--get-score-data();
                    u64? var_4 = darray-count(var_0);
                    ss-score-container-setup(var_0, score-manager--get-bonus-score-data(), score-manager--get-multipler-data(), score-manager--get-overview-data());
                    menu2-show-tab(get-symbol(w-tab-container, self), var_4 - 1);
                    set-int32(num-tabs, var_4, self);
                }
            }
        }
        block event_started-animating-post-scores {
            track main {
                lambda {
                    menu2-set-container-focus-update-disabled(get-symbol(w-tab-container, self), 1);
                }
            }
        }
        block event_done-animating-post-scores {
            track main {
                lambda {
                    menu2-set-container-focus-update-disabled(get-symbol(w-tab-container, self), 0);
                }
            }
        }
        block event_jump-focus-to-run-tab {
            track main {
                lambda {
                    menu2-show-tab(get-symbol(w-tab-container, self), 6);
                }
            }
        }
    }
}
