string get-rogue-game-mode-as-string(u16 arg_0) {
    return match (arg_0) {
        0    -> "assault",
        1    -> "survival",
        2    -> "defense",
        3    -> "siege",
        4    -> "boss",
        else -> "invalid"
    };
}

