statescript {
    options {
        player
    }
    declarations {
        string challenge-progress-str = grab an enemy
    }
    state tracking {
        block start {
            track main {
                lambda {
                    hud-challenge-update-progress-count(0, 1);
                }
            }
        }
        block event_npc-died {
            track main {
                lambda {
                    u64? var_0 = event-arg-symbol(0);
                    if (event-arg-symbol(1) == player && var_0 != player-get-meatshield() && player-in-meatshield?() && !(weapon-get-default-ammo-id(event-arg-symbol(2)) == 0)) {
                        if (!is-final-build?()) {
                            display(dc:format("DEB-EC: Player killed %s while holding %s in meatshield", string-debug(var_0), string-debug(player-get-meatshield())), 19);
                        }
                        hud-challenge-update-progress-count(1, 1);
                        var_6 = go(completed, 1);
                    }
                }
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda {
                    set-string(challenge-progress-str, "complete", self);
                }
                lambda {
                    send-event(challenge-complete, ss-challenges-controller-1);
                }
