statescript {
    options {
        player
    }
    declarations {
        timer buff-timer = nullptr
        bool buff-enabled = nullptr
        u64 fx-handle = 0
    }
    state tracking {
        block update {
            track main {
                lambda {
                    if (get-boolean(buff-enabled, self)) {
                        player-set-motion-match-crouch-speed-multiplier/f(1.15);
                        player-set-motion-match-run-speed-multiplier/f(1.15);
                        player-set-motion-match-sprint-speed-multiplier/f(1.15);
                    }
                }
            }
        }
        block event_player-used-health-kit {
            track main {
                lambda {
                    if (get-boolean(buff-enabled, self)) {
                        stop-timer-if-running(buff-timer, self);
                    } else {
                        set-uint64(fx-handle, spawn-particles-at-joint(
                            pos-perk-speed-burst,
                            player,
                            spined,
                            0,
                            16,
                            root,
                            0,
                            0,
                            0,
                            0
                        ), self);
                        set-boolean(buff-enabled, 1, self);
                    }
                }
                lambda {
                    play-sound(sfx-hud-rl-skulls-boost-speed-small, 0);
                }
                lambda {
                    start-timer(buff-timer, 8.00, self, 1);
                }
                lambda {
                    if (player-upgrade-active?(heal-at-full)) {
                        inventory-item-add-quantity(rag, 1);
                        inventory-item-add-quantity(alcohol, 1);
                    }
                }
            }
        }
        block event_player-pickup {
            track main {
                lambda {
                    if (event-arg-symbol(1) == health-small) {
                        if (get-boolean(buff-enabled, self)) {
                            stop-timer-if-running(buff-timer, self);
                        } else {
                            set-uint64(fx-handle, spawn-particles-at-joint(
                                pos-perk-speed-burst,
                                player,
                                spined,
                                0,
                                16,
                                root,
                                0,
                                0,
                                0,
                                0
                            ), self);
                            set-boolean(buff-enabled, 1, self);
                        }
                        play-sound(sfx-hud-rl-skulls-boost-speed-small, 0);
                        start-timer(buff-timer, 8.00, self, 1);
                    }
                }
            }
        }
        block event_skull-activate {
            track main {
                lambda {
                    if (event-arg-symbol(0) == melee-restore-health) {
                        if (get-boolean(buff-enabled, self)) {
                            stop-timer-if-running(buff-timer, self);
                        } else {
                            set-uint64(fx-handle, spawn-particles-at-joint(
                                pos-perk-speed-burst,
                                player,
                                spined,
                                0,
                                16,
                                root,
                                0,
                                0,
                                0,
                                0
                            ), self);
                            set-boolean(buff-enabled, 1, self);
                        }
                        start-timer(buff-timer, 8.00, self, 1);
                    }
                }
            }
        }
        block event_buff-timer {
            track main {
                lambda {
                    set-boolean(buff-enabled, 0, self);
                }
                lambda {
                    kill-particles(get-uint64(fx-handle, self), 0);
                }
                lambda {
                    set-uint64(fx-handle, 0, self);
                }
            }
        }
        block event_run-complete {
            track main {
                lambda {
                    if (!get-svar-as-boolean(rogue-cheat-mod-ever-enabled)) {
                        increment-stat(runs-complete-mel, 1);
                        increment-stat(meta-runs-complete, 1);
                        set-stat-bit(trophy-win-with-all-characters, 9);
                    }
                }
            }
        }
    }
}
