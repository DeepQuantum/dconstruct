statescript {
    options {
        player
    }
    declarations {
        i32 profile-index = 0
        i32 category-index = 0
        i32 item-index = 0
        i32 menu-index = 0
        i32 selection-index = 0
        i32 quantity = 1
        i32 weapon-index = 0
        i32 upgrade-index = 0
        i32 path-index = 0
        i32 random-weapon-index = 0
        f32 loadout-unlocked-display-time = 4.00
        bool loadout-manager-is-listening = nullptr
    }
    state task-check {
        block start {
            track main {
                lambda {
                    if (get-svar(dev-menu-reload-character) == 1) {
                        give-player-profile-loadout(all-weapons, 1);
                        set-svar(dev-menu-reload-character, 0);
                    } else {
                        set-svar(dev-menu-reload-character, 0);
                    }
                }
                lambda {
                    go(initialize, 1);
                }
            }
        }
    }
    state initialize {
        block start {
            track main {
                lambda {
                    weapons-initialize();
                }
                lambda {
                    go(wait-for-update, 1);
                }
            }
        }
    }
    state profile-select {
        block start {
            track main {
                lambda {
                    player-remove-all-weapon-upgrades();
                }
                lambda {
                    player-upgrade-remove-all();
                }
                lambda {
