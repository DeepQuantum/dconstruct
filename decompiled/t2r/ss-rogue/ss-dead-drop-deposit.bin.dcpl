                        } else if (*(u64 *)(**t2r-dead-drop-item-info-array* + (var_3 * 32)) == shiv) {
                            var_5 = anim-overlay-player-level-specific-dead-drop-shiv;
                        } else {
                            var_5 = anim-overlay-player-level-specific-dead-drop-trap-bomb;
                        }
                        if (!(*(u64 *)(**t2r-dead-drop-item-info-array* + (var_3 * 32)) == molotov)) {
                            set-overlay-set(player, var_5);
                        }
                        set-boolean(is-overlay-ready?, 1, self);
                        wait-until-anim-frame(player, ellie-dead-drop--enter, 22.00, 2);
                        wait-holster-player-weapon(4, 1.00);
                        set-symbol(grabbed-item, spawn-attachable(var_4, player, "rightHand", 0, 0), self);
                        if (*(u64 *)(**t2r-dead-drop-item-info-array* + (var_3 * 32)) == health-kit) {
                            var_7 = animate_(get-symbol(grabbed-item, self), idle, #%alloc-array(single-frame, 16, 0, 1));
                        }
                    }
                }
                lambda {
                    wait-until-anim-frame(player, ellie-dead-drop--enter, 37.00, 2);
                }
                lambda {
                    if (entity-exists?(get-symbol(grabbed-item, self))) {
                        kill-entity(get-symbol(grabbed-item, self));
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    set-player-no-igc-kill-grenade();
                }
                lambda {
                    interactable-draw-icon(self);
                }
                lambda {
                    set-float(deposit-progress, get-animation-phase(player, 2, ellie-dead-drop--enter) / 0.48, self);
                }
                lambda {
                    interactable-set-progress(self, get-float(deposit-progress, self));
                }
                lambda {
                    accessibility-suppress-control-sounds/f();
                }
                lambda {
                    player-disable-unholstering();
                }
                lambda {
                    if (!(joypad-command-active?(interact-hold-immediate, 6)) || !(get-boolean(deposit-success, self))) {
                        if (get-boolean(player-interrupted?, self)) {
                            cancel-player-move-to();
                            if (get-animation-playing?(player, ellie-dead-drop--enter, 2) && get-animation-frame(player, 2, ellie-dead-drop--enter) > 22.00) {
                                set-animation-speed(player, -1.00, 2, 0);
                            } else {
                                stop-animating(player, 2, 0.50, 0, 0);
                            }
                            set-animation-speed(self, -1.00, 2, 0);
                            interactable-set-progress(self, 0.00);
                            set-float(deposit-progress, 0.00, self);
                            go(wait-deposit, 1);
                        }
                    }
                }
            }
        }
        block event_player-attacked {
            track main {
                lambda {
                    set-boolean(player-interrupted?, 1, self);
                }
                lambda {
                    if (entity-exists?(get-symbol(grabbed-item, self))) {
                        kill-entity(get-symbol(grabbed-item, self));
                    }
                }
            }
        }
    }
    state deposit-success {
        block start {
            track main {
                lambda {
                    if (entity-exists?(get-symbol(grabbed-item, self))) {
                        kill-entity(get-symbol(grabbed-item, self));
                    }
                }
                lambda {
                    listen-mode-set-buddy-draw-mode(get-self-id(), 0);
                }
                lambda {
                    listen-mode-visible(get-self-id(), 0, 1, -1.00);
                }
                lambda {
                    interactable-disable(self);
                }
                lambda {
                    log-event("rogue-dead-drop", 1, dc:format("Deposited"), 0, 0);
                }
                lambda {
                    go(deposited, 1);
                }
            }
        }
    }
    state deposited {
        block start {
            track main {
                lambda {
                    interactable-disable(self);
                }
            }
        }
    }
}
