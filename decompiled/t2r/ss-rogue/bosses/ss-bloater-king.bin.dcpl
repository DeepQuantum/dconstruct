    state phase-change-stun {
        block start {
            track main {
                lambda {
                    broadcast-event(boss-invincibility);
                }
                lambda {
                    npc-set-script-only-with-perception(npc-infected-bloater-king-carpark-1);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 4, 1);
                    *(i32*)*var_0[0] = 4;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u8*)(*var_0[0] + 8) = 1;
                    *(i32*)*var_0[1] = 3;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(u8*)(*var_0[1] + 8) = 1;
                    *(i32*)*var_0[2] = 28;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.30;
                    *(i32*)*var_0[3] = 30;
                    *(u64*)(*var_0[3] + 8) = 0;
                    *(f32*)(*var_0[3] + 8) = 0.50;
                    wait-animate_(npc-infected-bloater-king-carpark-1, inf-bloater-charge-tell-bellow, var_0);
                }
                lambda {
                    npc-set-script-high-priority(npc-infected-bloater-king-carpark-1);
                }
                lambda {
                    if (get-boolean(phase-two-done?, self)) {
                        go(phase-three, 1);
                    } else if (get-boolean(phase-one-done?, self)) {
                        go(phase-two, 1);
                    }
                }
            }
        }
        block end {
            track main {
                lambda {
                    kill-particles(get-uint64(phase-change-fx, self), 0);
                }
            }
        }
    }
    state done {
        block start {
            track main {
                lambda {
                    hud-boss-destroy();
                }
            }
        }
    }
}
