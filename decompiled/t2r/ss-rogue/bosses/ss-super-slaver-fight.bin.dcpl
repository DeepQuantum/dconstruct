                        display(dc:format("DEB-BO: Spawning reinforcements!"), 19);
                    }
                }
                lambda {
                    request-reinforcement-spawn();
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (get-player-to-object-distance(npc-super-slaver-1) < 12.00 && !get-boolean(player-activated-close-loadout?, self)) {
                        stop-timer-if-running(boss-close-loadout-timeout, self);
                        set-boolean(player-activated-close-loadout?, 1, self);
                    }
                }
            }
        }
    }
    state cleanup {
        block start {
            track main {
                lambda {
                    go(done, 1);
                }
            }
        }
    }
    state done {
        block start {
            track main {
                lambda {
                    hud-boss-destroy();
                }
            }
        }
    }
}
