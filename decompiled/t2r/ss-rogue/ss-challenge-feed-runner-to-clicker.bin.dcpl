statescript {
    options {
        player
    }
    declarations {
        string challenge-progress-str = incomplete
    }
    state tracking {
        block update {
            track main {
                lambda {
                    if (player-in-meatshield?()) {
                        set-string(challenge-progress-str, "feed to clicker", self);
                    } else {
                        set-string(challenge-progress-str, "grab an infected", self);
                    }
                }
                lambda {
                    if (player-in-meatshield?()) {
                        hud-challenge-update-progress-text(HUD_ROGUE_CHALLENGE_FEED_CLICKER);
                    } else {
                        hud-challenge-update-progress-text(HUD_ROGUE_CHALLENGE_GRAB_INFECTED);
                    }
                }
            }
        }
        block event_melee-move-started {
            track main {
                lambda {
                    u64? var_0 = event-arg-symbol(0);
                    if (infected-vs-npc-bite-front-left == var_0 && infected-vs-npc-bite-front-right == var_0) {
                        set-string(challenge-progress-str, "complete!", self);
                        hud-challenge-update-progress-text(HUD_ROGUE_CHALLENGE_COMPLETED);
                        var_1 = go(completed, 1);
                    }
                }
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda {
                    send-event(challenge-complete, ss-challenges-controller-1);
                }
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("DEB-EC: Challenge complete %s", string-debug(get-self-id())), 19);
                    }
                }
            }
        }
    }
