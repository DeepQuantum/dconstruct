                        set-mesh-visible(get-symbol(object-name, self), rogue-map-photo-faction, 0);
                        set-mesh-visible(get-symbol(object-name, self), rogue-map-photo-mode, 0);
                        set-mesh-visible(get-symbol(object-name, self), rogue-map-photo-buddy, 0);
                        set-mesh-visible(get-symbol(object-name, self), rogue-map-photo-skulls, 0);
                        setup-fg-photo-path-reroute(get-symbol(object-name, self));
                        setup-fg-photo-exposure(get-symbol(object-name, self), get-int32(encounter-depth, self), encounter--get-total-encounters-completed());
                        setup-fg-photo-burn(get-symbol(object-name, self));
                        setup-fg-photo-modifier(get-symbol(object-name, self), get-boolean(encounter-has-modifier?, self));
                    } else {
                        setup-fg-photo-faction(get-symbol(object-name, self), get-symbol(encounter-faction-name, self));
                        setup-fg-photo-path-reroute(get-symbol(object-name, self));
                        setup-fg-photo-mode(get-symbol(object-name, self), get-symbol(encounter-mode, self));
                        setup-fg-photo-buddy(get-symbol(object-name, self), get-symbol(encounter-buddy-name, self));
                        setup-fg-photo-modifier(get-symbol(object-name, self), get-boolean(encounter-has-modifier?, self));
                        setup-fg-photo-exposure(get-symbol(object-name, self), get-int32(encounter-depth, self), encounter--get-total-encounters-completed());
                        setup-fg-photo-burn(get-symbol(object-name, self));
                    }
                }
                lambda {
                    setup-fg-photo-anim(get-symbol(object-name, self));
                }
                lambda {
                    animate_(get-symbol(object-name, self), get-symbol(encounter-anim, self), #%alloc-array(single-frame, 16, 0, 1));
                }
                lambda {
                    set-high-contrast-mode-type(get-symbol(object-name, self), 2);
                }
                lambda {
                    if (get-symbol(current-state, self) == unavailable) {
                        go(unavailable, 1);
                    } else if (get-symbol(current-state, self) == available) {
                        go(available, 1);
                    } else if (get-symbol(current-state, self) == complete) {
                        go(complete, 1);
                    } else if (get-symbol(current-state, self) == unreachable) {
                        go(unreachable, 1);
                    } else {
                        go(default, 1);
                    }
                }
            }
        }
    }
}
