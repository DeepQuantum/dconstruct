u64? is-collectibles-tab-open?() {
    return !(menu2-get-player-menu-path() == 0) && menu2-get-current-tab(gui2-build-widget-path(
        menu2-get-player-menu-path(),
        "tabbed",
        0,
        0,
        0,
        0,
        0,
        0,
        0
    )) == 2;
}

u64? speak-tts-for-each-skull-in-group(u64? arg_0, u64? arg_1) {
    speak-text-to-speech-formatted(boxed_symbol(get-symbol(active-skulls-cipher, self)), 1, 0, 1);
    foreach (u64? var_4 : arg_0) {
        if (**t2r-skulls-array* + (var_4 * 152)) {
            speak-text-to-speech-formatted(
                boxed_symbol(*(u64*)((**t2r-skulls-array* + (var_4 * 152)) + 16)),
                1,
                0,
                1
            );
            if (arg_1) {
                speak-text-to-speech-formatted(
                    boxed_symbol(*(u64*)((**t2r-skulls-array* + (var_4 * 152)) + 24)),
                    1,
                    0,
                    1
                );
            }
        }
    }
    return wait-one-frame();
}

