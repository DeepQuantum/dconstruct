statescript {
    options {
        player
    }
    declarations {
        symbol path-unlock-widget = #0000000000000000
        symbol w-progress-bar = #0000000000000000
        f32 max-hold-time = 3.00
        timer command-pressed-timer = nullptr
        f32 progress-percent = 0.00
    }
    state initial {
        block start {
            track main {
                lambda {
                    set-symbol(path-unlock-widget, self, self);
                }
                lambda {
                    set-symbol(w-progress-bar, gui2-find-widget-path("progressBar", self), self);
                }
                lambda {
                    if (get-svar-as-boolean(rogue-path-unlocked)) {
                        go(complete, 1);
                    }
                }
                lambda {
                    go(wait-focus, 1);
                }
            }
        }
    }
    state wait-focus {
        block start {
            track main {
                lambda {
                    gui2-set-widget-visible(self, 0);
                }
            }
        }
        block event_photo-focused {
            track main {
                lambda {
                    if (get-photo-widget-by-encounter-id(event-arg-int32(0), template--get-index-ddict-by-id(template--get-current-template-id())) == enc-button-2b) {
                        gui2-set-widget-visible(self, 1);
                        var_4 = go(wait-command, 1);
                    } else {
                        var_4 = gui2-set-widget-visible(self, 0);
                    }
                }
            }
        }
    }
    state wait-command {
        block start {
            track main {
                lambda {
                    stop-timer(command-pressed-timer, self);
                }
                lambda {
                    gui2-set-progress-bar-percent(get-symbol(w-progress-bar, self), 0.00, 0.00, 12);
                }
            }
        }
        block update {
