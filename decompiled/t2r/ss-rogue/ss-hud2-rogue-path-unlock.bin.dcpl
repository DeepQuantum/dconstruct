                lambda {
                    go(wait-focus, 1);
                }
            }
        }
    }
    state complete {
        block start {
            track main {
                lambda {
                    gui2-set-progress-bar-percent(get-symbol(w-progress-bar, self), 0.00, 0.00, 12);
                }
                lambda {
                    gui2-set-widget-visible(self, 0);
