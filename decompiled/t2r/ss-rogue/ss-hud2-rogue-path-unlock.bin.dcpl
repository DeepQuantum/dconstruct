                lambda {
                    go(wait-focus, 1);
                }
            }
        }
    }
    state command-pressing {
        block start {
            track main {
                lambda {
                    start-timer(command-pressed-timer, get-float(max-hold-time, self), self, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (!(joypad-command-active?(interact-hold, 6))) {
                        go(wait-command, 1);
                    }
                }
                lambda {
                    set-float(progress-percent, (get-float(max-hold-time, self) - get-timer-value(command-pressed-timer, self)) / get-float(max-hold-time, self), self);
                }
                lambda {
                    gui2-set-progress-bar-percent(get-symbol(w-progress-bar, self), get-float(progress-percent, self), 0.00, 12);
                }
                lambda {
                    if (get-float(progress-percent, self) > 0.99) {
                        set-svar(rogue-path-unlocked, 1);
                        consume-rogue-key(1);
                        go(complete, 1);
                    }
                }
            }
        }
