u16 get-item-type-as-string(u16 arg_0) {
    return match (arg_0) {
        0    -> "weapon",
        1    -> "weapon-upgraded",
        2    -> "ammo",
        3    -> "item",
        4    -> "player-upgrade",
        5    -> "manual",
        6    -> "parts",
        7    -> "supplements",
        8    -> "special",
        9    -> "offmarket",
        10   -> "backup",
        11   -> "holster",
        else -> 0
    };
}

