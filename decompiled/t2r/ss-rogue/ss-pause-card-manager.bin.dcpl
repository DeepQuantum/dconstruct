statescript {
    options {
        player
    }
    declarations {
        bool tutorials-ready = true
        bool showing-tutorial = nullptr
        i32 tut-sound-handle = 0
    }
    state --all-- {
        block start {
            track main {
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("pause-card manager waiting for events"), 19);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (get-boolean(showing-tutorial, self)) {
                        joypad-override-persistent-command-list/f(*tutorial-pause-card-persistent-command-list*, 2);
                        joypad-override-persistent-command-list/f(*tutorial-pause-card-persistent-command-list*, 0);
                        joypad-disable-all-commands();
                        joypad-disable-commands-for-joypad/f(0, accessibility-toggle-slow-motion);
                        joypad-force-disables/f(2);
                    }
                }
            }
        }
        block event_check-for-pause-cards {
            track main {
                lambda {
                    if (rogue-player-in-hub?()) {
                        go(hub-pause-cards-after-black-fade, 1);
                    } else if (rogue-get-current-task-game-mode() == 0) {
                        go(assault-pause-cards, 1);
                    } else if (rogue-get-current-task-game-mode() == 1) {
                        go(survival-pause-cards, 1);
                    } else if (rogue-get-current-task-game-mode() == 3) {
                        go(siege-pause-cards, 1);
                    } else if (rogue-get-current-task-game-mode() == 2) {
                        go(defense-pause-cards, 1);
                    }
                }
            }
        }
        block event_tutorial-pause-card-meta {
            track main {
                lambda {
                    if (!(get-svar-as-boolean(tut-meta-intro))) {
                        set-mixer-override(mix-rl-under-black-duck-all-except-music);
                        set-boolean(showing-tutorial, 1, self);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-meta-unlocks*, 2, 2, 0);
                        set-boolean(showing-tutorial, 0, self);
                        log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                        set-svar-as-boolean(tut-meta-intro, 1);
                        mark-tutorial-unlocked-by-cipher-id(MENU_ROGUE_META_TUTORIAL_TITLE_LC, 1);
                        wait(1.00);
                    }
                }
                lambda {
                    set-mixer-override(0);
                }
                lambda {
                    broadcast-event(post-flow-pause-card-done);
                }
            }
        }
        block event_tutorial-pause-card-leaderboard {
            track main {
                lambda {
                    if (!(get-svar-as-boolean(tut-leaderboard-intro))) {
                        set-mixer-override(mix-rl-under-black-duck-all-except-music);
                        set-boolean(showing-tutorial, 1, self);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-leaderboards*, 2, 2, 2);
                        set-boolean(showing-tutorial, 0, self);
                        log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                        set-svar-as-boolean(tut-leaderboard-intro, 1);
                        mark-tutorial-unlocked-by-cipher-id(HUD_TUTORIAL_ROGUE_LEADERBOARDS_LC, 1);
                        set-mixer-override(0);
                    }
                }
            }
        }
        block event_tutorial-pause-card-dead-drop {
            track main {
                lambda {
                    if (!(get-svar-as-boolean(tut-assault-deaddrop))) {
                        go(dead-drop-pause-card, 1);
                    }
                }
            }
        }
        block event_tutorial-pause-card-death {
            track main {
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("*********Death Pause Card EVENT"), 19);
                    }
                }
                lambda {
                    if (!(get-svar-as-boolean(tut-first-death)) && get-boolean(run-failed-post, ss-post-encounter-flow-1)) {
                        go(death-pause-card, 1);
                    }
                }
                lambda {
                    go(tutorial-pause-cards-completed, 1);
                }
            }
        }
    }
    state  {
    }
    state hub-pause-cards-after-black-fade {
        block event_fading-up-from-black {
            track main {
                lambda {
                    go(hub-pause-cards, 1);
                }
            }
        }
        block  {
        }
        block update {
            track main {
                lambda {
                    set-black-fade(1.00, 0, 1, 0);
                }
            }
        }
    }
    state tutorial-pause-cards-completed {
        block start {
            track main {
                lambda {
                    wait(1.00);
                }
                lambda {
                    set-mixer-override(0);
                }
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("*********Post Flow Done"), 19);
                    }
                }
                lambda {
                    broadcast-event(post-flow-pause-card-done);
                }
                lambda {
                    broadcast-event(pause-cards-completed);
                }
            }
        }
    }
    state death-pause-card {
        block start {
            track main {
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("*********Death Pause Card Start"), 19);
                    }
                }
                lambda {
                    set-mixer-override(mix-rl-under-black-duck-all-except-music);
                }
                lambda {
                    set-boolean(showing-tutorial, 1, self);
                }
                lambda {
                    wait-gui2-show-pause-card(*t2r-rogue-tutorial-death*, 2, 2, 2);
                }
                lambda {
                    set-boolean(showing-tutorial, 0, self);
                }
                lambda {
                    log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                }
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("*********Death Pause Card End"), 19);
                    }
                }
                lambda {
                    set-svar-as-boolean(tut-first-death, 1);
                }
                lambda {
                    mark-tutorial-unlocked-by-cipher-id(HUD_TUTORIAL_ROGUE_TITLE_DEATH_LC, 1);
                }
                lambda {
                    if (!(get-svar-as-boolean(tut-scoring-intro))) {
                        go(tutorial-pause-cards-completed, 1);
                    }
                }
            }
        }
    }
    state score-pause-card {
        block start {
            track main {
                lambda {
                    if (!(get-svar-as-boolean(tut-scoring-intro))) {
                        if (!is-final-build?()) {
                            display(dc:format("*********Score Pause Card"), 19);
                        }
                        set-mixer-override(mix-rl-under-black-duck-all-except-music);
                        set-boolean(showing-tutorial, 1, self);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-scoring*, 2, 2, 2);
                        set-boolean(showing-tutorial, 0, self);
                        log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                        set-svar-as-boolean(tut-scoring-intro, 1);
                        mark-tutorial-unlocked-by-cipher-id(HUD_TUTORIAL_ROGUE_SCORING_LC, 1);
                    }
                }
                lambda {
                    go(tutorial-pause-cards-completed, 1);
                }
            }
        }
    }
    state dead-drop-pause-card {
        block start {
            track main {
                lambda {
                    set-mixer-override(mix-rl-under-black-duck-all-except-music);
                }
                lambda {
                    set-boolean(showing-tutorial, 1, self);
                }
                lambda {
                    wait-gui2-show-pause-card(*t2r-rogue-tutorial-dead-drop*, 2, 2, 2);
                }
                lambda {
                    set-boolean(showing-tutorial, 0, self);
                }
                lambda {
                    log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                }
                lambda {
                    set-svar-as-boolean(tut-assault-deaddrop, 1);
                }
                lambda {
                    go(additional-features-pause-cards, 1);
                }
            }
            track audio {
                lambda {
                    set-int32(tut-sound-handle, play-sound(sfx-hud-tutorial-stinger-lp, 0), self);
                }
            }
        }
        block end {
            track main {
                lambda {
                    stop-sound(get-int32(tut-sound-handle, self));
                }
            }
        }
    }
    state hub-pause-cards {
        block start {
            track main {
                lambda {
                    if (get-svar(encounter-depth) == 0 && !get-svar-as-boolean(tut-hub-intro)) {
                        set-mixer-override(mix-rl-under-black-duck-all-except-music);
                        if (!is-final-build?()) {
                            display(dc:format("pushing tutorial page here"), 19);
                        }
                        set-boolean(showing-tutorial, 1, self);
                        broadcast-event(view-controls-screen-shown);
                        menu2-show-page-stack(hudMenuStack);
                        set-black-fade(1.00, 0, 1, 0);
                        wait-one-frame();
                        while (!(menu2-get-top-page-in-stack(hudMenuStack, 0) != menu2-push-page(hudMenuStack, "pc/menu/page-view-controls_nofade", 0))) {
                            wait-one-frame();
                        }
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-hub*, 2, 2, 2);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-rogue-map*, 2, 2, 2);
                        set-boolean(showing-tutorial, 0, self);
                        log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                        set-svar-as-boolean(tut-hub-intro, 1);
                        broadcast-event(view-controls-screen-popped);
                        mark-tutorial-unlocked-by-cipher-id(HUD_TUTORIAL_ROGUE_TITLE_HUB_LC, 1);
                        mark-tutorial-unlocked-by-cipher-id(HUD_TUTORIAL_ROGUE_TITLE_ROGUE_MAP_LC, 1);
                    } else if (get-svar(encounter-depth) == 1 && !get-svar-as-boolean(tut-hub-return)) {
                        set-boolean(showing-tutorial, 1, self);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-reward-cache*, 2, 2, 2);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-vendor*, 2, 2, 2);
                        set-boolean(showing-tutorial, 0, self);
                        set-svar-as-boolean(tut-hub-return, 1);
                        mark-tutorial-unlocked-by-cipher-id(HUD_ROGUE_REWARD_CRATE_TITLE, 1);
                        mark-tutorial-unlocked-by-cipher-id(HUD_TUTORIAL_ROGUE_TITLE_VENDOR_LC, 1);
                        log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                    }
                }
                lambda {
                    if (get-svar(encounter-depth) == 5 && !get-svar-as-boolean(tut-first-boss-encounter)) {
                        set-boolean(showing-tutorial, 1, self);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-bosses*, 2, 2, 2);
                        set-boolean(showing-tutorial, 0, self);
                        set-svar-as-boolean(tut-first-boss-encounter, 1);
                        mark-tutorial-unlocked-by-cipher-id(HUD_TUTORIAL_ROGUE_TITLE_BOSS_LC, 1);
                        log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                    }
                }
                lambda {
                    if (get-svar-as-boolean(enemy-unlock-bosses-complete) && !get-svar-as-boolean(tut-bosses-unlocked)) {
                        set-boolean(showing-tutorial, 1, self);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-bosses-unlocked*, 2, 2, 2);
                        set-boolean(showing-tutorial, 0, self);
                        set-svar-as-boolean(tut-bosses-unlocked, 1);
                        mark-tutorial-unlocked-by-cipher-id(HUD_TUTORIAL_ROGUE_TITLE_BOSS_UNLOCKED_LC, 1);
                        log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                    }
                }
                lambda {
                    if (!get-svar-as-boolean(tut-marlene-path-reroute-unlocked) && rogue-get-player-character() == 10 && get-svar(encounter-depth) == 2) {
                        set-boolean(showing-tutorial, 1, self);
                        wait-gui2-show-pause-card(*t2r-rogue-path-reroute-tutorial*, 2, 2, 2);
                        set-svar-as-boolean(tut-marlene-path-reroute-unlocked, 1);
                        set-boolean(showing-tutorial, 0, self);
                        log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                    }
                }
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("broadcast pause completed"), 19);
                    }
                }
                lambda {
                    set-mixer-override(0);
                }
                lambda {
                    broadcast-event(hub-pause-card-completed);
                }
            }
        }
    }
    state assault-pause-cards {
        block start {
            track main {
                lambda {
                    set-mixer-override(mix-rl-under-black-duck-all-except-music);
                }
                lambda {
                    if (!(get-svar-as-boolean(tut-assault-intro))) {
                        set-boolean(showing-tutorial, 1, self);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-assault-mode*, 2, 2, 2);
                        set-boolean(showing-tutorial, 0, self);
                        set-svar-as-boolean(tut-assault-intro, 1);
                        mark-tutorial-unlocked-by-cipher-id(HUD_TUTORIAL_ROGUE_TITLE_ASSAULT_LC, 1);
                    }
                }
                lambda {
                    if (!(get-svar-as-boolean(tut-assault-lockbox))) {
                        set-boolean(showing-tutorial, 1, self);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-supply-drop*, 2, 2, 2);
                        set-boolean(showing-tutorial, 0, self);
                        mark-tutorial-unlocked-by-cipher-id(HUD_TUTORIAL_ROGUE_TITLE_SUPPLY_DROP_LC, 1);
                        set-svar-as-boolean(tut-assault-lockbox, 1);
                    }
                }
                lambda {
                    log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                }
                lambda {
                    go(additional-features-pause-cards, 1);
                }
            }
        }
    }
