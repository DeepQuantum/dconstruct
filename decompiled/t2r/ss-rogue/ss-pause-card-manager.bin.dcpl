        }
    }
    state defense-pause-cards {
        block start {
            track main {
                lambda {
                    set-mixer-override(mix-rl-under-black-duck-all-except-music);
                }
                lambda {
                    if (!(get-svar-as-boolean(tut-defense-intro))) {
                        set-boolean(showing-tutorial, 1, self);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-defense-mode*, 2, 2, 2);
                        set-boolean(showing-tutorial, 0, self);
                        set-svar-as-boolean(tut-defense-intro, 1);
                        mark-tutorial-unlocked-by-cipher-id(HUD_TUTORIAL_ROGUE_TITLE_DEFENSE_LC, 1);
                    }
                }
                lambda {
                    log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                }
                lambda {
                    go(additional-features-pause-cards, 1);
                }
            }
        }
    }
    state additional-features-pause-cards {
        block start {
            track main {
                lambda {
                    if (!(get-svar-as-boolean(tut-first-challenge)) && get-svar-as-boolean(main-unlock-gambits)) {
                        set-boolean(showing-tutorial, 1, self);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-gambits*, 2, 2, 2);
                        set-boolean(showing-tutorial, 0, self);
                        mark-tutorial-unlocked-by-cipher-id(HUD_TUTORIAL_ROGUE_TITLE_GAMBITS_LC, 1);
                        log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                        set-svar-as-boolean(tut-first-challenge, 1);
                    }
                }
                lambda {
                    if (!(get-svar-as-boolean(tut-first-skull)) && encounter--has-skulls?(encounter--get-current-encounter-ddict())) {
                        set-boolean(showing-tutorial, 1, self);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-modifiers*, 2, 2, 2);
                        set-boolean(showing-tutorial, 0, self);
                        log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                        set-svar-as-boolean(tut-first-skull, 1);
                        mark-tutorial-unlocked-by-cipher-id(HUD_TUTORIAL_ROGUE_TITLE_MODIFIERS_LC, 1);
                    }
                }
                lambda {
                    if (!(get-svar-as-boolean(tut-buddies-intro)) && rogue-get-player-character() != 6 && encounter--has-buddy?(encounter--get-current-encounter-ddict()) && rogue-get-current-task-game-mode() != 2) {
                        set-boolean(showing-tutorial, 1, self);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-buddies*, 2, 2, 2);
                        set-boolean(showing-tutorial, 0, self);
                        log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                        set-svar-as-boolean(tut-buddies-intro, 1);
                        mark-tutorial-unlocked-by-cipher-id(HUD_TUTORIAL_ROGUE_TITLE_BUDDY_LC, 1);
                    }
                }
                lambda {
                    if (!(get-svar-as-boolean(tut-assault-deaddrop)) && get-svar-as-boolean(main-unlock-dead-drop)) {
                        set-boolean(showing-tutorial, 1, self);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-dead-drop*, 2, 2, 2);
                        set-boolean(showing-tutorial, 0, self);
                        mark-tutorial-unlocked-by-cipher-id(HUD_TUTORIAL_ROGUE_TITLE_DEAD_DROP_LC, 1);
                        log-event("rogue-tutorial-pause-card", 1, "", 0, 0);
                        set-svar-as-boolean(tut-assault-deaddrop, 1);
                    }
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("broadcast pause completed"), 19);
                    }
                }
                lambda {
                    set-mixer-override(0);
                }
                lambda {
                    broadcast-event(pause-cards-completed);
                }
                lambda {
                    broadcast-event(encounter-pause-cards-completed);
                }
            }
        }
    }
