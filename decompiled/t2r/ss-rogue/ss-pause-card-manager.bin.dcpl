                lambda {
                    if (!(get-svar-as-boolean(tut-survival-intro))) {
                        set-boolean(showing-tutorial, 1, self);
                        wait-gui2-show-pause-card(*t2r-rogue-tutorial-survival-mode*, 2, 2, 2);
