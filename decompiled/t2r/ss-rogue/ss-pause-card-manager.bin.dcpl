    }
    state siege-pause-cards {
        block start {
            track main {
                lambda {
                    set-mixer-override(mix-rl-under-black-duck-all-except-music);
                }
                lambda {
                    if (!(get-svar-as-boolean(tut-siege-intro))) {
                        set-boolean(showing-tutorial, 1, self);
