            track main {
                lambda {
                    set-boolean(ready-for-deposit, 1, self);
                }
                lambda {
                    check-and-swap-stun-smoke-bomb();
                }
            }
        }
        block end {
            track main {
                lambda {
                    set-boolean(ready-for-deposit, 0, self);
                }
            }
        }
        block event_dead-drop-deposit {
            track main {
                lambda {
                    if (wait-deposit-items()) {
                        go(item-deposited, 1);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (player-has-deposit-items?()) {
                        set-boolean(player-has-deposit-items, 1, self);
                    } else {
                        set-boolean(player-has-deposit-items, 0, self);
                    }
                }
            }
        }
        block event_player-upgrade-enabled {
            track main {
