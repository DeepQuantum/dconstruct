                            var_2 = "recipe";
                        } else {
                            var_2 = "nothing";
                        }
                        string var_4;
                        if (get-svar-as-boolean(dead-drop-wait-pick-up-weapon)) {
                            var_4 = "weapon";
                        } else {
                            var_4 = "nothing";
                        }
                        display(dc:format("DEB-DD: Player starting next task.. %s & %s left behind! Cleared.", var_2, var_4), 19);
                    }
                }
                lambda {
