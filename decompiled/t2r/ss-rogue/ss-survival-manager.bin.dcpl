                        melee-fact-set-bool(rogue-get-current-buddy(), melee-buddy-prevent-infected-grapples, 1);
                        if (!is-final-build?()) {
                            display(dc:format("DEB_BUDDY: Buddy in struggle? %b", buddy-in-struggle?(rogue-get-current-buddy())), 19);
                        }
                        if (buddy-in-struggle?(rogue-get-current-buddy())) {
                            start-melee-action(rogue-get-current-buddy(), 0, attacker-standing-struggle-break-front, 0, 0, 1, 0, 0);
                        }
                    }
                }
                lambda {
                    broadcast-event(hunted-over-hide-hud);
                }
                lambda {
                    play-sound(sfx-rl-round-end-win, 0);
