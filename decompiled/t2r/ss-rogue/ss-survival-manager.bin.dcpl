                        }
                        ++(max-enemies-that-were-active, self);
                        set-boolean(survival-spawn-next-enemy?, 0, self);
                        while (!!(text-to-speech-playing?())) {
                            wait-one-frame();
                        }
                        while (!!(hud-tutorial-active?(0))) {
                            wait-one-frame();
                        }
                        speak-text-to-speech-formatted(boxed_symbol(HUD_ROGUE_ENEMY_SPAWNED), 1, 0, 1);
                        wait(0.10);
                    }
                }
            }
            track early-cut {
                lambda {
                    wait-for(start-waiting);
                }
                lambda {
                    while (!(get-timer-value(countdown-timer, rogue-ui--get-t2r-timer-path()) <= 0.00)) {
