        block event backpack-opened {
            track main {
                lambda {
                    hud-survival-fade-out();
                }
            }
        }
        block event backpack-closed {
            track main {
                lambda {
                    hud-survival-fade-in();
                }
            }
        }
        block event rogue-run-abandoned {
            track main {
                lambda {
                    hud-survival-destroy();
                }
            }
        }
        block event npc-died {
            track main {
                lambda {
                    --(survival-target-kills-for-box, self);
