                        }
                        if (get-int32(survival-time-countdown, self) == 5) {
                            signal(start-waiting, 0);
                        }
                        if (get-int32(survival-time-countdown, self) == 0) {
                            set-boolean(survival-wave-active?, 0, self);
                        }
                        if (get-int32(survival-enemies-active, self) == wave-manager-get-npc-alive-count(ss-wave-manager-1) && !(get-boolean(reached-max-survival-enemies, self))) {
                            log-event("survival-max-enemies-reached", 1, "", 0, 0);
