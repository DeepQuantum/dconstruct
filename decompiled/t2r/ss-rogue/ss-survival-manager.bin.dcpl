                lambda {
                    if (!(darray-count(grp-lockbox-spawn-locations-survival-dynamic) == 0) && get-int32(survival-caches-spawned, self) < 2) {
                        if (get-int32(survival-target-kills-for-box, self) <= 0) {
                            set-int32(survival-target-kills-for-box, 3, self);
                            if (!(supply-drop-spawned?()) && !(supply-drop-unopened?())) {
                                u16 var_10;
                                foreach (u64? var_12 : grp-lockbox-spawn-locations-survival-dynamic) {
                                    u16 var_18;
                                    if (closest-distance-to-supply-cache(grp-lockbox-spawn-locations-survival-dynamic) < 1000.00 && !(is-on-screen?(get-spawner-position(*invalid-symbol*, 1), 1.00))) {
                                        var_17 = closest-distance-to-supply-cache(grp-lockbox-spawn-locations-survival-dynamic);
                                        var_18 = var_12;
                                    }
                                    var_10 = var_18;
                                }
                                if (!(var_10 == 0)) {
                                    speak-text-to-speech-formatted(boxed_symbol(HUD_ROGUE_REWARD_CRATE), 1, 0, 1);
                                    darray-find-remove(grp-lockbox-spawn-locations-survival-dynamic, boxed_symbol(var_10), 0);
                                    broadcast-event(spawn-lockbox, boxed_boundframe(get-spawner-locator(var_10, 1)), boxed_bool(tag-boolean(is-wood, var_10)));
                                    ++(lockbox-wave-num, self);
                                    var_8 = ++(survival-caches-spawned, self);
