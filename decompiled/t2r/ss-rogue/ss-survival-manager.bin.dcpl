                lambda {
                    hud-encounter-over-create(ENCOUNTER_MISSION_COMPLETE, t2-yellow, 1);
                }
                lambda {
                    hud-encounter-over-fade-in();
                }
                lambda {
                    speak-text-to-speech-formatted(boxed_symbol(ENCOUNTER_MISSION_EXIT_ALT_CAPS), 1, 0, 1);
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    play-music-stinger(*music-playlist-rogue-encounter-complete-hunted*, 0);
                }
                lambda {
                    wait(4.00);
                }
                lambda {
                    hud-encounter-over-fade-out();
                }
                lambda {
                    broadcast-event(encounter-complete);
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    set-boolean(endgame-cam-enabled, 1, self);
                }
            }
            track audio {
                lambda {
                    set-mixer-override(mix-rl-under-black-duck-all-except-music-no-fade);
                }
            }
            track hunted-trophy {
                lambda {
                    if (!get-svar-as-boolean(rogue-cheat-mod-ever-enabled) && entity-exists?(ss-score-manager-1) && get-int32(encounter-enemy-kill-count, ss-score-manager-1) >= 12) {
                        increment-stat(trophy-hunted-kills, 1);
                    }
                }
            }
        }
        block event camera-cut-to-endgame {
            track main {
                lambda {
                    set-boolean(endgame-cam-enabled, 1, self);
                }
            }
        }
        block update {
            track main {
                lambda {
                    disable-inventory();
                }
                lambda {
                    rogue-hud-hide-all/f();
                }
                lambda {
                    photo-mode-disable-frame-forward/f();
                }
                lambda {
                    set-player-invincible();
                }
                lambda {
                    set-tension-mode(1);
                }
                lambda {
                    cancel-player-aim();
                }
                lambda {
                    igc-prop-clean-up(2.00);
                }
                lambda {
                    player-disable-auto-unholster();
                }
                lambda {
                    if (!get-boolean(endgame-cam-enabled, self)) {
                        joypad-disable-all-commands();
                        set-black-fade(1.00, 1, 0, 1);
                    }
                }
            }
        }
    }
}
