                    }
                }
                lambda {
                    if (get-boolean(survival-hit-max-enemies?, self)) {
                        hud-survival-stop-spawn-countdown();
                    }
                }
                lambda {
                    disallow-normal-tension();
                }
            }
        }
        block end {
            track main {
                lambda {
                    stop-timer-if-running(last-enemy-timer, self);
                }
            }
        }
    }
    state survival-complete-success {
        block start {
            track main {
                lambda {
                    log-event("survival-max-enemies-active", get-int32(max-enemies-that-were-active, self), "", 0, 0);
                }
                lambda {
                    broadcast-event(encounter-combat-complete);
                }
                lambda {
                    photo-mode-disable-frame-forward/f();
                }
                lambda {
                    kill-all-arrows-stuck-in-player();
                }
                lambda {
                    hfx-group-set-suppressed(63, 1);
                }
                lambda {
                    set-focusable-ignore(player, 1);
