                    } else if (wave-manager-get-encounter-intensity(ss-wave-manager-1) == 2) {
                        set-int32(survival-time-to-next-spawn-base, get-int32(survival-time-to-next-spawn-base, self) - 0, self);
                    } else if (wave-manager-get-encounter-intensity(ss-wave-manager-1) == 3) {
                        set-int32(survival-time-to-next-spawn-base, get-int32(survival-time-to-next-spawn-base, self) - 1, self);
                    } else if (wave-manager-get-encounter-intensity(ss-wave-manager-1) == 4) {
                        set-int32(survival-time-to-next-spawn-base, get-int32(survival-time-to-next-spawn-base, self) - 2, self);
                    } else if (wave-manager-get-encounter-intensity(ss-wave-manager-1) == 5) {
