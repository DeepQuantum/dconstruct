    if (get-boolean(play10PositiveTicks, self)) {
        var_2 = play-sound(sfx-rl-round-timer-tick-positive, 0);
    } else {
        var_2 = 0;
    }
    return var_2;
}

u64? play-tick-sound-end--timer() {
    u64? var_1;
    if (get-boolean(altTickSounds, self)) {
        var_1 = play-sound(sfx-rl-round-timer-tick-small, 0);
    } else {
        var_1 = play-sound(sfx-rl-round-timer-end, 0);
    }
    return var_1;
}

