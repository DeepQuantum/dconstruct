statescript {
    options {
        player
    }
    declarations {
        i32 kills-required = 3
    }
    state tracking {
        block event_npc-died {
            track main {
                lambda {
                    if (event-arg-symbol(1) == player && event-arg-symbol(2) == molotov) {
                        increment-svar(meta-yara-brute-kills-count, 1);
                        t2r-meta-trial-updates-add(meta-yara-kill-brutes);
                        if (npc-brute?(event-arg-symbol(0)) && is-brute-npc?(event-arg-symbol(0)) && get-svar(meta-yara-brute-kills-count) >= get-int32(kills-required, self)) {
                            go(completed, 1);
                        }
                    }
                }
            }
        }
        block event_force-meta-complete {
            track main {
                lambda {
                    go(completed, 1);
                }
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda {
                    if (print-meta-debug()) {
                        if (!is-final-build?()) {
                            display(dc:format("Yara Defeat 5 brutes Trial Complete"), 19);
                        }
                        debug-draw-string-2d(
                            alloc-point(315.00, 400.00, 0.00, 0),
                            "Challenge Completed",
                            7,
                            5.00,
                            4.00,
                            1,
                            0,
                            0,
                            1.00
                        );
                    }
                }
                lambda {
                    request-meta-complete-notification(meta-yara-kill-brutes);
                }
                lambda {
                    log-event("meta trial complete", 0, "yara kill brutes", 0, 0);
                }
                lambda {
                    broadcast-event(meta-challenge-complete-abby);
                }
                lambda {
                    set-svar-as-boolean(meta-yara-kill-brutes, 1);
                }
                lambda {
                    set-svar-as-boolean(player-skins-yara-player-walk-zipped, 1);
                }
                lambda {
                    increment-svar(meta-num-skins-unlocked, 1);
                }
                lambda {
                    t2r-meta-trial-updates-add(meta-yara-kill-brutes);
                }
                lambda {
                    set-stat-bit(trophy-complete-abby-faction-tracks, 2);
                }
                lambda {
                    kill-entity(self);
                }
            }
        }
    }
}
