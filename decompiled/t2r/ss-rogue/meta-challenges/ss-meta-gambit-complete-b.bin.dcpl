statescript {
    options {
        player
    }
    state tracking {
        block event rogue-challenge-complete {
            track main {
                lambda {
                    increment-svar(meta-gambit-complete, 1);
                }
                lambda {
                    t2r-meta-trial-updates-add(meta-gambit-complete-b);
                }
                lambda {
                    if (get-svar(meta-gambit-complete) >= 3) {
                        go(completed, 1);
                    }
                }
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda {
                    if (print-meta-debug()) {
                        if (!is-final-build?()) {
                            display(dc:format("Gambite Complete B Trial Complete"), 19);
                        }
                        debug-draw-string-2d(
                            alloc-point(315.00, 400.00, 0.00, 0),
                            "Challenge Completed",
                            7,
                            5.00,
                            4.00,
                            1,
                            0,
                            0,
                            1.00
                        );
                    }
                }
                lambda {
                    request-meta-complete-notification(meta-gambit-complete-b);
                }
                lambda {
                    log-event("meta trial complete", 0, "gambit complete b", 0, 0);
                }
                lambda {
                    set-svar-as-boolean(meta-gambit-complete-b, 1);
                }
                lambda {
                    set-svar-as-boolean(gambit-unlock-tier-2, 1);
                }
                lambda {
                    t2r-meta-trial-updates-add(meta-gambit-complete-b);
                }
                lambda {
                    kill-entity(self);
                }
            }
