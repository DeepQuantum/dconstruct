statescript {
    options {
        player
    }
    state tracking {
        block start {
            track main {
                lambda {
                    if (get-svar(encounter-depth) == 0 && rogue-player-in-hub?()) {
                        set-svar-as-boolean(meta-healthkit-used, 0);
                    }
                }
            }
        }
        block event_player-used-health-kit {
            track main {
                lambda {
                    set-svar-as-boolean(meta-healthkit-used, 1);
                }
            }
        }
        block event_run-complete {
            track main {
                lambda {
                    if (!get-svar-as-boolean(meta-healthkit-used)) {
                        go(completed, 1);
                    }
                }
            }
        }
        block event_force-meta-complete {
            track main {
                lambda {
                    go(completed, 1);
                }
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda {
                    if (print-meta-debug()) {
                        if (!is-final-build?()) {
                            display(dc:format("Manny Complete a run without using a health kit Trial Complete"), 19);
                        }
                        debug-draw-string-2d(
                            alloc-point(315.00, 400.00, 0.00, 0),
                            "Challenge Completed",
                            7,
                            5.00,
                            4.00,
                            1,
                            0,
                            0,
                            1.00
                        );
                    }
                }
                lambda {
                    request-meta-complete-notification(meta-manny-no-healthkit);
                }
                lambda {
                    log-event("meta trial complete", 0, "manny no healthkit", 0, 0);
                }
                lambda {
                    set-svar-as-boolean(meta-manny-no-healthkit, 1);
                }
                lambda {
                    set-svar-as-boolean(player-skins-manny-firefly-skin, 1);
                }
                lambda {
                    t2r-meta-trial-updates-add(meta-manny-no-healthkit);
                }
                lambda {
                    kill-entity(self);
                }
            }
        }
    }
}
