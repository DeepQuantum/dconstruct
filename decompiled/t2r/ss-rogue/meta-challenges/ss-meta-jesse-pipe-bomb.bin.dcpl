statescript {
    options {
        player
    }
    declarations {
        i32 num-killed = 0
    }
    state tracking {
        block event_npc-died {
            track main {
                lambda {
                    if (event-arg-symbol(1) == player && !npc-is-buddy?(event-arg-symbol(0)) && event-arg-symbol(2) == pipe-bomb) {
                        set-int32(num-killed, get-int32(num-killed, self) + 1, self);
                        if (get-int32(num-killed, self) >= 3) {
                            var_4 = go(completed, 1);
                        }
                    }
                }
            }
        }
        block event_force-meta-complete {
            track main {
                lambda {
                    go(completed, 1);
                }
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda {
                    if (print-meta-debug()) {
                        if (!is-final-build?()) {
                            display(dc:format("Jesse pipe bomb Trial Complete"), 19);
                        }
                        debug-draw-string-2d(
                            alloc-point(315.00, 400.00, 0.00, 0),
                            "Challenge Completed",
                            7,
                            5.00,
                            4.00,
                            1,
                            0,
                            0,
                            1.00
                        );
                    }
                }
                lambda {
                    request-meta-complete-notification(meta-jesse-pipe-bomb);
                }
                lambda {
                    log-event("meta trial complete", 0, "jesse pipe bomb", 0, 0);
                }
                lambda {
                    broadcast-event(meta-challenge-complete-ellie);
                }
                lambda {
                    set-svar-as-boolean(meta-jesse-pipe-bomb, 1);
                }
                lambda {
                    set-svar-as-boolean(player-skins-jesse-patrol, 1);
                }
                lambda {
                    increment-svar(meta-num-skins-unlocked, 1);
                }
                lambda {
                    t2r-meta-trial-updates-add(meta-jesse-pipe-bomb);
                }
                lambda {
                    set-stat-bit(trophy-complete-ellie-faction-tracks, 2);
                }
                lambda {
                    kill-entity(self);
                }
            }
        }
    }
}
