u64? max-inventory-items?() {
    return get-inventory-item-max-count(health-kit) <= get-inventory-item-quantity(health-kit) || get-inventory-item-max-count(molotov) <= get-inventory-item-quantity(molotov) && get-inventory-item-max-count(pipe-bomb) <= get-inventory-item-quantity(pipe-bomb) && get-inventory-item-max-count(trap-bomb) <= get-inventory-item-quantity(trap-bomb) || get-inventory-item-max-count(stun-bomb) <= get-inventory-item-quantity(stun-bomb) && get-inventory-item-max-count(smoke-bomb) <= get-inventory-item-quantity(smoke-bomb);
}

statescript {
    options {
        player
    }
    state tracking {
        block event_player-pickup {
            track main {
                lambda {
                    if (max-inventory-items?()) {
                        go(completed, 1);
                    }
                }
            }
        }
        block event_player-craft-item {
            track main {
                lambda {
                    if (max-inventory-items?()) {
                        go(completed, 1);
                    }
                }
            }
        }
        block event_force-meta-complete {
            track main {
                lambda {
                    go(completed, 1);
                }
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda {
                    if (print-meta-debug()) {
                        if (!is-final-build?()) {
                            display(dc:format("Dina Max Inventory Items Trial Complete"), 19);
                        }
                        debug-draw-string-2d(
                            alloc-point(315.00, 400.00, 0.00, 0),
                            "Challenge Completed",
                            7,
                            5.00,
                            4.00,
                            1,
                            0,
                            0,
                            1.00
                        );
                    }
                }
                lambda {
                    request-meta-complete-notification(meta-dina-max-inv-items);
                }
                lambda {
                    log-event("meta trial complete", 0, "dina max inv items", 0, 0);
                }
                lambda {
                    set-svar-as-boolean(meta-dina-max-inv-items, 1);
                }
                lambda {
                    set-svar-as-boolean(player-skins-dina-patrol-no-jacket, 1);
                }
                lambda {
                    t2r-meta-trial-updates-add(meta-dina-max-inv-items);
