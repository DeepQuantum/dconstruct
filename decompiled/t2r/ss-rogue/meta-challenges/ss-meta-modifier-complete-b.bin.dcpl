statescript {
    options {
        player
    }
    state tracking {
        block event_encounter-combat-complete {
            track main {
                lambda {
                    if (encounter--has-skulls?(encounter--get-current-encounter-ddict())) {
                        increment-svar(meta-skull-encounter-complete, 1);
                        t2r-meta-trial-updates-add(meta-skull-complete-b);
                    }
                }
                lambda {
                    if (get-svar(meta-skull-encounter-complete) >= 6) {
                        go(completed, 1);
                    }
                }
            }
        }
        block event_force-meta-complete {
            track main {
                lambda {
                    go(completed, 1);
                }
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda {
                    if (print-meta-debug()) {
                        if (!is-final-build?()) {
                            display(dc:format("Skull Complete B Trial Complete"), 19);
                        }
                        debug-draw-string-2d(
                            alloc-point(315.00, 400.00, 0.00, 0),
                            "Challenge Completed",
                            7,
                            5.00,
                            4.00,
                            1,
                            0,
                            0,
                            1.00
                        );
                    }
                }
                lambda {
                    request-meta-complete-notification(meta-skull-complete-b);
                }
                lambda {
                    log-event("meta trial complete", 0, "skull complete b", 0, 0);
                }
                lambda {
                    set-svar-as-boolean(meta-skull-complete-b, 1);
                }
                lambda {
                    set-svar-as-boolean(skull-unlock-tier-2, 1);
                }
                lambda {
                    custom-run--set-skulls-enabled-by-unlock-level(2, 1);
                }
                lambda {
                    t2r-meta-trial-updates-add(meta-skull-complete-b);
                }
                lambda {
                    kill-entity(self);
                }
            }
        }
    }
}
