                            7,
                            5.00,
                            4.00,
                            1,
                            0,
                            0,
                            1.00
                        );
                    }
                }
                lambda {
                    request-meta-complete-notification(meta-manny-upgrade-path);
                }
                lambda {
                    log-event("meta trial complete", 0, "manny upgrade weapon", 0, 0);
                }
                lambda {
