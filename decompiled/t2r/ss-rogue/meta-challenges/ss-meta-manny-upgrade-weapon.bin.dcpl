            track main {
                lambda {
                    if (print-meta-debug()) {
                        if (!is-final-build?()) {
                            display(dc:format("Manny Fully upgrade any gun Trial Complete"), 19);
                        }
                        debug-draw-string-2d(
                            alloc-point(315.00, 400.00, 0.00, 0),
