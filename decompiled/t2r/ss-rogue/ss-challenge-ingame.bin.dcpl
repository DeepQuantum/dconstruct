                        } else {
                            var_17 = "No";
                        }
                        display(dc:format("DEB-EC: player dead? %s", var_17), 19);
                    }
                    if (!object-spawned?(ss-game-over-1) && script-in-state?(ss-game-over-1, game-over) && !player-in-state?(Death) && var_0) {
                        var_20 = play-sound(sfx-hud-rl-gambit-failed-post-encounter, 0);
                    } else {
                        var_20 = play-sound(sfx-hud-rl-gambit-failed, 0);
                    }
                }
                lambda {
                    wait(0.30);
                }
                lambda {
                    u64? var_2;
                    if (rogue-get-player-character() == 10) {
