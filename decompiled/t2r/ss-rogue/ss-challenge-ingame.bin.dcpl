            }
        }
    }
    state complete-challenge {
        block start {
            track main {
                lambda {
                    if (!get-boolean(is-setup, self)) {
                        go(finished, 1);
                    }
                }
                lambda {
                    if (gui2-get-widget-state(self, 0) == fade-in) {
                        if (get-boolean(enable-long-complete, self)) {
                            wait(2.00);
                        }
                        gui2-set-widget-state(get-symbol(bg-shimmer, self), shimmer, 0, 0, 0);
                        gui2-set-widget-state-immediate(self, complete-skipped, 0, 0, 0);
                        gui2-set-widget-state(get-symbol(complete-flash-ref, self), flash, 0, 0, 0);
                    } else {
                        if (get-boolean(enable-long-complete, self)) {
                            wait(2.00);
                        }
                        gui2-set-widget-state(get-symbol(bg-shimmer, self), shimmer, 0, 0, 0);
                        gui2-go-widget-state(self, complete, 0, 0, 0);
                        gui2-go-widget-state(get-symbol(complete-flash-ref, self), flash, 0, 0, 0);
                    }
                }
                lambda {
                    wait(0.30);
                }
                lambda {
