                        *invalid-symbol*,
                        cipher-box-formatted-number-string(var_1, rogue-ui--get-rank-score-limit(5), rogue-ui--get-rank-score-limit(4), rogue-ui--get-rank-score-limit(3), rogue-ui--get-rank-score-limit(2)),
                        0,
                        2,
                        1
                    ))) {
                        wait-one-frame();
                    }
                }
                lambda {
                    set-mixer-override(0);
                }
                lambda {
                    menu2-broadcast-to-page-stacks(done-score-info);
                }
                lambda {
                    send-event(done-score-info, menu2-get-top-page-in-stack(hudMenuStack, 0));
                }
                lambda {
                    broadcast-event(done-score-info);
                }
                lambda {
                    go(default, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (joypad-command-active?(continue-button, 6)) {
                        menu2-pop-page(hudMenuStack, menu/message-box-ok);
                    }
                }
            }
        }
    }
