statescript {
    options {
        player
    }
    declarations {
        i32 selection-index = 0
    }
    state wait-for-display {
        block event_display-upgrade-path-selection {
            track main {
                lambda {
                    set-int32(selection-index, 0, self);
                }
                lambda {
                    populate-paths-obtained();
                }
                lambda {
                    populate-paths-available(3);
                }
                lambda {
                    if (darray-count(paths-available) > 0 && darray-count(paths-obtained) < 5) {
                        go(display, 1);
                    }
                }
            }
        }
    }
    state display {
        block update {
            track main {
                lambda {
                    joypad-disable-all-commands-except(debug-script-press-right, debug-script-press-left, debug-script-press-up, debug-script-press-down, debug-script-press-x);
                }
                lambda {
                    display-paths-available(get-int32(selection-index, self));
                }
                lambda {
                    if (joypad-command-active?(debug-script-press-right, 6)) {
                        if ((get-int32(selection-index, self) + 1) >= darray-count(paths-available)) {
                            set-int32(selection-index, 0, self);
                        } else {
                            +=i(selection-index, 1, self);
                        }
                    }
                }
                lambda {
                    if (joypad-command-active?(debug-script-press-left, 6)) {
                        if ((get-int32(selection-index, self) - 1) < 0) {
                            set-int32(selection-index, darray-count(paths-available) - 1, self);
                        } else {
                            -=i(selection-index, 1, self);
                        }
                    }
                }
                lambda {
                    if (joypad-command-active?(debug-script-press-x, 6)) {
                        go(give-item, 1);
                    }
                }
            }
        }
    }
    state give-item {
        block start {
            track main {
                lambda {
                    u64? var_1 = darray-at(paths-available, get-int32(selection-index, self));
                    u16 var_2;
                    if (var_1 && *(u16 *)(var_1 + 12) == 7) {
                        var_2 = *(u64 *)var_1;
                    } else if (var_1 && *(u16 *)(var_1 + 12) == 5) {
                        var_2 = *(u64 *)var_1;
