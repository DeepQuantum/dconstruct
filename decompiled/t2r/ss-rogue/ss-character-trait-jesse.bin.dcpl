statescript {
    options {
        player
    }
    state tracking {
        block start {
            track main {
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format("Character Trait Initiated"), 19);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    player-vertigo-scale(0.00);
                }
            }
        }
        block event_player-loadout-initialized {
            track main {
                lambda {
                    if (encounter--player-started-new-run-in-hub?()) {
                        set-svar(rogue-key-count, 1);
                    }
                }
            }
        }
        block event_run-complete {
            track main {
                lambda {
                    if (!get-svar-as-boolean(rogue-cheat-mod-ever-enabled)) {
                        increment-stat(runs-complete-jesse, 1);
                        increment-stat(meta-runs-complete, 1);
                        set-stat-bit(trophy-win-with-all-characters, 7);
                    }
                }
            }
        }
    }
}
