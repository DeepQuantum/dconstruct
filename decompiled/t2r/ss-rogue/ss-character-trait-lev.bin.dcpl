statescript {
    options {
        player
    }
    state tracking {
        block update {
            track main {
                lambda {
                    override-listen-mode-settings/f(*increased-range-listen-mode-settings*);
                }
            }
        }
        block event_run-complete {
            track main {
                lambda {
                    if (!get-svar-as-boolean(rogue-cheat-mod-ever-enabled)) {
                        increment-stat(runs-complete-lev, 1);
                        increment-stat(meta-runs-complete, 1);
                        set-stat-bit(trophy-win-with-all-characters, 4);
                    }
                }
            }
        }
    }
}
