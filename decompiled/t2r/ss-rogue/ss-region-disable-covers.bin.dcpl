statescript {
    options {
        player
    }
    declarations {
        f32 radius-disable-covers = 0.00
        i32 num-covers-disabled = 0
    }
    state initial {
        block start {
            track main {
                lambda {
                    if (get-float(radius-disable-covers, self) <= 0.00) {
                        display-error("Setup failed! (1) Make sure this region is a sphere (2) Provide radius-disable-covers > 0.0 value");
                    } else {
                        set-int32(num-covers-disabled, disable-cover-aps-in-sphere(get-region-sphere-center(get-self-id(), 0), get-float(radius-disable-covers, self)), self);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (*encounter-tweaks* != null && *(u8 *)(*encounter-tweaks* + 44)) {
                        debug-draw-region(get-self-id(), 8, 0.00, 1, 0, 1, 0);
                        debug-draw-string(
                            get-region-centroid(get-self-id(), 0),
                            dc:format(" Disabled covers: %d", get-int32(num-covers-disabled, self)),
                            2,
                            0.00,
                            1,
                            1.00,
                            1,
                            0
                        );
                    }
                }
            }
        }
    }
}
