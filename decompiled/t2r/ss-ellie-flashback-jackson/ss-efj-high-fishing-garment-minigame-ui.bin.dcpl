        } else {
            var_1 = 0;
        }
    } else {
        if (!gui2-widget-exists?(get-symbol(striker-widget, self))) {
            set-symbol(striker-widget, gui2-spawn-widget(canvas.hudRoot, "hud-minigames/hud-high-strike/high-strike-root", 0, 1), self);
            gui2-assign-to-category(get-symbol(striker-widget, self), 1048576);
