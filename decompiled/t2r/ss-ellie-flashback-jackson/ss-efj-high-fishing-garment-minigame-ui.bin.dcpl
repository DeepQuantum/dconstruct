            gui2-set-widget-rotation(gui2-build-widget-path(
                get-symbol(striker-widget, self),
                "buttonPrompt",
                0,
                0,
                0,
                0,
                0,
                0,
                0
            ), pi());
            gui2-set-widget-image(gui2-build-widget-path(
                get-symbol(striker-widget, self),
                "buttonPrompt",
                0,
                0,
                0,
                0,
                0,
                0,
                0
            ), gui2-resolve-user-input-icon("gen:attack"));
            gui2-set-widget-state(get-symbol(striker-widget, self), default, 0, 0, 0);
        }
        gui2-set-widget-anim-phase(get-symbol(striker-widget, self), get-float(current-level, self));
        gui2-set-progress-bar-percent(gui2-build-widget-path(
            get-symbol(striker-widget, self),
            "maxPower",
            0,
            0,
            0,
            0,
            0,
            0,
            0
        ), 0.00, 0.00, 12);
        var_1 = gui2-set-widget-tint(get-symbol(striker-widget, self), vector-to-color(get-vector(widget-color, self)));
    }
    return var_1;
}

f32 high-striker-minigame-get-new-velocity(u64? arg_0) {
    return (0.30 * get-float(speed-scalar, self)) * arg_0;
}

statescript {
    options {
        player
    }
    declarations {
        f32 current-level = 0.50
        f32 velocity = 0.00
        f32 gravity = -0.03
        f32 speed-scalar = 1.00
        symbol striker-widget = nullptr
        vector widget-color = (1.00, 1.00, 1.00, 1.00)
        bool pause-minigame? = nullptr
        bool sound-played? = nullptr
    }
    state wait-for-init {
        block start {
            track main {
                lambda {
                    if (gui2-widget-exists?(get-symbol(striker-widget, self))) {
                        gui2-kill-widget(get-symbol(striker-widget, self));
                        set-symbol(striker-widget, 0, self);
                    }
                }
            }
        }
        block event start-high-striker-minigame {
            track main {
                lambda {
                    go(init, 1);
                }
            }
        }
    }
    state init {
        block start {
            track main {
                lambda {
                    set-float(current-level, 1.00, self);
                }
                lambda {
                    set-vector(widget-color, alloc-vector(1.00, 1.00, 1.00, 1.00, 0), self);
                }
                lambda {
                    set-boolean(sound-played?, 0, self);
                }
                lambda {
                    if (is-traversal-audio-cues?() && is-combat-audio-cues?()) {
                        play-accessibility-square-sound-at-position(get-object-position(obj-efj-hi-striker-game-1), 0, 2.00);
                    }
                }
                lambda {
                    hud-show-cipher-message(4, HUD_CRF_HIGH_STRIKER_TUTORIAL, 3.00, 2, none, 0.50);
                }
                lambda {
                    go(start, 1);
                }
            }
        }
    }
    state start {
        block update {
            track main {
                lambda {
                    high-striker-minigame-ui-update-widget();
                }
                lambda {
                    draw-interactable-hud(interact-attack, offset-locator(get-joint-locator(obj-efj-hi-striker-game-1, weight), alloc-vector(0.00, 0.30, 1.30, 1.00, 0)), 0);
                }
            }
        }
        block event raise-hammer {
            track main {
                lambda {
                    go(rise, 1);
                }
            }
        }
    }
    state rise {
        block update {
            track main {
                lambda {
                    +=f(velocity, get-float(gravity, self) * get-float(speed-scalar, self), self);
                }
                lambda {
                    +=f(current-level, get-float(velocity, self) * get-delta-time(), self);
                }
                lambda {
                    high-striker-minigame-ui-update-widget();
                }
                lambda {
                    if (get-float(current-level, self) <= 0.20 && !get-boolean(sound-played?, self)) {
                        if (is-traversal-audio-cues?() && is-combat-audio-cues?()) {
                            play-accessibility-square-sound-at-position(get-object-position(obj-efj-hi-striker-game-1), 0, 2.00);
                        }
                        set-boolean(sound-played?, 1, self);
                    }
                }
                lambda {
                    if (get-float(current-level, self) < -0.10 && get-float(velocity, self) < 0.00) {
                        broadcast-event(strike-attempt-fail);
                        go(wait-for-init, 1);
                    }
                }
            }
        }
        block event strike-attempt {
            track main {
                lambda {
                    hud-stop-current-message(0, 0);
                }
                lambda {
                    if (get-float(current-level, self) <= 0.20) {
                        broadcast-event(strike-attempt-success);
                    } else {
                        broadcast-event(strike-attempt-fail);
                    }
                }
                lambda {
                    go(wait-for-init, 1);
                }
            }
        }
    }
}
