                }
                lambda {
                    npc-die(get-symbol(grapple-npc, self), 0, 0, 0, 1);
                }
                lambda {
                    set-boolean(grapple-in-progress, 0, self);
                }
                lambda {
                    set-boolean(npc-move-to-stage-1-complete?, 0, self);
                }
                lambda {
                    set-boolean(npc-move-to-stage-2-complete?, 0, self);
                }
                lambda {
                    send-event(grapple-end, ss-afm-horse-chase-controller-horse-1);
                }
                lambda {
                    set-symbol(grapple-npc, 0, self);
                }
                lambda {
                    go(wait-for-new-npc, 1);
                }
            }
        }
    }
}
