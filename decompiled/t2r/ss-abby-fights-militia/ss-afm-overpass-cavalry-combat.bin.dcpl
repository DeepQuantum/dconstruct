                    kill-entity(npc-highway-scar-intro-2);
                }
                lambda {
                    foreach (u64? var_2 : afm-highway-hardpoints) {
                        set-hardpoint-disabled(var_2);
                    }
                }
                lambda {
                    kill-all-dropped-weapons();
                }
                lambda {
                    npc-remove-all-ragdolls();
                }
                lambda {
                    cleanup-all-empty-weapon-clips();
                }
                lambda {
                    go(done, 1);
                }
            }
        }
    }
}
