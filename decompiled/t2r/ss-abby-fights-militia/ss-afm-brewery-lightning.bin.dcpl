u64? afm-set-lightning-close() {
    set-float(min-lightning-delay, 30.00, self);
    set-float(max-lightning-delay, 40.00, self);
    set-float(sound-delay, 0.00, self);
    set-symbol(thunder-sfx, sfx-emt-afm-near-thunder, self);
    return set-symbol(lightning-settings, close, self);
}

u64? afm-resume-lightning-vox() {
    return start-timer(lightning-controller, get-float(timer-pause, self), self, 1);
}

u64? afm-set-lightning-far() {
    set-float(min-lightning-delay, 40.00, self);
    set-float(max-lightning-delay, 70.00, self);
    set-float(sound-delay, 0.00, self);
    set-symbol(thunder-sfx, sfx-emt-afm-distant-thunder, self);
    return set-symbol(lightning-settings, far, self);
}

u64? afm-pause-lightning-vox() {
    set-float(timer-pause, get-timer-value(lightning-controller, self), self);
    return stop-timer(lightning-controller, self);
}

u64? afm-set-lightning-medium() {
    set-float(min-lightning-delay, 30.00, self);
    set-float(max-lightning-delay, 50.00, self);
    set-float(sound-delay, 0.00, self);
    set-symbol(thunder-sfx, sfx-emt-afm-medium-thunder, self);
    return set-symbol(lightning-settings, medium, self);
}

