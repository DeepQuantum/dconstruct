                }
                lambda {
                    npc-request-hold(yara, 10.00);
                }
                lambda {
                    npc-request-hold(lev, 10.00);
                }
                lambda {
                    animate-done(obj-ski-gate-scissor-1, ski-forest-escape-cornered-loop--gate, ap-ski-forest-escape-door-boost-1, 0, 0, 2);
                }
                lambda {
                    go(clean-up, 1);
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    if (!task-complete?(saving-kids, ski-finding-shelter-check-doors)) {
                        animate-done(obj-ski-gate-scissor-1, ski-forest-escape-cornered-loop--gate, ap-ski-forest-escape-door-boost-1, 0, 0, 2);
                    }
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state clean-up {
        block start {
            track main {
                lambda {
                    task-complete!(saving-kids, ski-forest-restaurant-start);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
