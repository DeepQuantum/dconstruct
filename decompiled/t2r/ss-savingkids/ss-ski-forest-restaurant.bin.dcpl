                }
                lambda {
                    if (task-complete?(saving-kids, ski-forest-escape-cornered-exit-revealed)) {
                        clear-accessibility-pathfind-goal(0);
                        go(complete, 1);
                    }
                }
                lambda {
                    set-tension-mode(3);
                }
                lambda {
                    disallow-invisible-while-prone/f();
                }
            }
        }
    }
}
