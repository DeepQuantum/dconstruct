                    *(u64 *)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(i32 *)(*(*var_0 + (2 * 8)) + 8) = 1;
                    animate_(player, pat-library-move-shelf-anticipation--ellie, var_0);
                }
                lambda {
                    u64? var_0 = get-current-time(0);
                    while (!((get-current-time(0) - var_0) >= 0.50)) {
                        u64? var_3 = curve-scale(0.00, 0.50, 0.50, -0.60, get-current-time(0) - var_0, 3);
                        set-animation-speed(dina, var_3, 2, 0);
                        set-animation-speed(player, var_3, 2, 0);
                        wait-one-frame();
                    }
                    set-animation-speed(dina, -0.60, 2, 0);
                    set-animation-speed(player, -0.60, 2, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (get-animation-frame(player, 2, pat-library-move-shelf-anticipation-ellie) <= 1.00) {
                        go(move-shelf-idle, 1);
                    }
                }
            }
        }
    }
    state anim-done {
        block start {
            track main {
                lambda {
                    animate-done(obj-pat-library-shelf-1, pat-library-move-shelf--bookshelf, ap-pat-tarp-1, 0, 0, 2);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
