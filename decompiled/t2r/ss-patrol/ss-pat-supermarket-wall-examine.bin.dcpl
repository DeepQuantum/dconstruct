statescript {
    options {
        player
    }
    state task-check {
        block start {
            track main {
                lambda {
                    if (task-complete?(patrol, pat-supermarket-clicker-collapse)) {
                        go(complete, 1);
                    }
                }
                lambda {
                    if (task-active?(patrol, pat-supermarket-clicker-collapse)) {
                        go(wait-use, 1);
                    }
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-active?(patrol, pat-supermarket-clicker-collapse)) {
                        go(wait-use, 1);
                    }
                }
            }
        }
    }
    state wait-use {
        block start {
            track main {
                lambda {
                    interactable-disable(exa-employee-of-the-month-1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (has-collected-treasure?(collectible-pat-market-security-note, 0)) {
                        interactable-enable(exa-employee-of-the-month-1);
                        go(complete, 1);
                    }
                }
            }
        }
    }
}
