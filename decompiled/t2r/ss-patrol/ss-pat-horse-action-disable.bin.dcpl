statescript {
    options {
        player
        player-horse
        pat-const-script
    }
    state task-check {
        block start {
            track main {
                lambda {
                    if (task-complete?(patrol, pat-grow-building-hang)) {
                        go(complete, 1);
                    }
                }
                lambda {
                    if (task-range-active?(patrol, pat-tower-approach, patrol, pat-grow-building-hang)) {
                        go(disable, 1);
                    }
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-active?(patrol, pat-tower-approach)) {
                        go(disable, 1);
                    }
                }
            }
        }
    }
    state disable {
        block update {
            track main {
                lambda {
                    if (player-on-horse?(horse, 1, 1, 1)) {
                        joypad-disable-all-inventory-actions();
                        joypad-disable-commands(listen-hold, fire-press, fire-hold, fire-release, reload, reload-hold);
                        player-allow-no-weapon-aim();
                    }
                }
            }
        }
    }
}
