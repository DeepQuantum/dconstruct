                        wait-say(dina, vox-igc-din-gam-pat-suburbs-houses-collectible-sp-003, 2, 0);
                        wait(1.50);
                    }
                }
                lambda {
                    if (!get-boolean(vox-card-exit-inspect, self)) {
                        wait-say(player, vox-igc-ell-gam-pat-suburbs-houses-collectible-sp-003, 2, 0);
                        wait(1.50);
                    }
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-pat-suburbs-houses-collectible-sp-005, 2, 0);
                }
                lambda {
                    wait(2.00);
                }
                lambda {
                    set-boolean(vox-player-in-houses-region-a, 1, self);
                }
                lambda {
                    go(house-convo-check, 1);
                }
            }
        }
        block event vox-card-house-exit {
            track main {
                lambda {
                    if (!get-boolean(vox-card-interact, self)) {
                        go(house-convo-check, 1);
                    }
                }
            }
        }
        block event vox-put-card-back {
            track main {
                lambda {
                    if (!get-boolean(vox-card-interact, self)) {
                        set-boolean(vox-player-in-houses-region-a, 1, self);
                        go(house-convo-check, 1);
                    }
                }
            }
        }
    }
    state done {
        block start {
            track main {
                lambda {
                    set-boolean(suppress-horse-command-vox, 0, ss-vox-pat-horse-movement-controller-1);
                }
                lambda {
                    set-boolean(vox-check-houses-done, 1, self);
                }
            }
        }
    }
