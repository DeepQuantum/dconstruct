    state leave-houses-on-foot {
        block start {
            track main {
                lambda {
                    if (distance-between-objects-less-than?(player, dina, 15.00)) {
                        wait-say(dina, vox-igc-din-gam-pat-suburbs-houses-leave-on-foot-sp-001, 2, 0);
                        wait(0.50);
                        wait-say(dina, vox-igc-din-gam-pat-suburbs-houses-leave-on-foot-sp-002, 2, 0);
                    } else {
                        wait-say(dina, vox-igc-din-gam-pat-suburbs-houses-leave-on-foot-spj-005, 2, 0);
                        wait(0.50);
                        wait-say(dina, vox-igc-din-gam-pat-suburbs-houses-leave-on-foot-spj-006, 2, 0);
                    }
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
    }
    state superhero-card {
        block start {
            track vox {
                lambda {
                    set-boolean(vox-card-done, 1, self);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gam-pat-suburbs-houses-collectible-sp-001, 2, 0);
                }
                lambda {
                    wait(3.50);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gam-pat-suburbs-houses-collectible-sp-002, 2, 0);
                }
                lambda {
                    wait-for-event(
                        vox-card-interact,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0
                    );
                }
                lambda {
                    wait(0.60);
                }
                lambda {
                    say(dina, vox-igc-din-gam-pat-suburbs-houses-collectible-sp-003, 2, 0);
                }
                lambda {
                    wait-for(in-investigate);
                }
                lambda {
                    wait(1.50);
                }
                lambda {
                    if (get-boolean(vox-investigating-superhero-card, self)) {
                        say(player, vox-igc-ell-gam-pat-suburbs-houses-collectible-sp-003, 2, 0);
                        wait-boolean(vox-investigating-superhero-card, 0, self);
                        wait(1.50);
                    }
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-pat-suburbs-houses-collectible-sp-005, 2, 0);
                }
                lambda {
                    wait(2.00);
                }
                lambda {
                    set-boolean(vox-player-in-houses-region-a, 1, self);
                }
                lambda {
                    go(house-convo-check, 1);
                }
            }
            track investigate-started {
                lambda {
                    wait-for-event(
                        investigate-started,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0
                    );
                }
                lambda {
                    set-boolean(vox-investigating-superhero-card, 1, self);
                }
                lambda {
                    signal(in-investigate, 0);
                }
            }
            track exiting-investigate {
                lambda {
                    wait-for-event(
                        exiting-investigate,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0
                    );
                }
                lambda {
                    set-boolean(vox-investigating-superhero-card, 0, self);
                }
                lambda {
                    signal(in-investigate, 0);
                }
            }
        }
        block event vox-card-house-exit {
            track main {
                lambda {
                    if (!get-boolean(vox-card-interact, self)) {
                        go(house-convo-check, 1);
                    }
                }
            }
        }
        block event vox-put-card-back {
            track main {
                lambda {
                    if (!get-boolean(vox-card-interact, self)) {
                        set-boolean(vox-player-in-houses-region-a, 1, self);
                        go(house-convo-check, 1);
                    }
                }
            }
        }
    }
    state superhero-card-short {
        block start {
            track main {
                lambda {
                    set-boolean(vox-card-done, 1, self);
                }
                lambda {
                    if (!get-boolean(vox-card-inspect, self)) {
                        wait-say(dina, vox-igc-din-gam-pat-suburbs-houses-collectible-sp-002, 2, 0);
                        wait(0.60);
                    }
                }
                lambda {
                    wait-boolean(vox-card-interact, 1, self);
