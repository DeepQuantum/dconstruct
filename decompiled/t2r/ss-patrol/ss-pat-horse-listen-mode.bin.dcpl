statescript {
    options {
        player
        player-horse
        dina-horse
        pat-supermarket-script
    }
    state task-check {
        block start {
            track main {
                lambda {
                    if (task-complete?(patrol, pat-supermarket-mixed-combat-done)) {
                        go(complete, 1);
                    }
                }
                lambda {
                    if (task-range-active?(patrol, pat-supermarket-carcass, patrol, pat-supermarket-mixed-combat-done)) {
                        go(hide-horses, 1);
                    }
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-active?(patrol, pat-supermarket-carcass)) {
                        go(hide-horses, 1);
                    }
                }
            }
        }
    }
    state hide-horses {
        block update {
            track main {
                lambda {
                    listen-mode-visible(player-horse, 0, 1, -1.00);
                }
                lambda {
                    listen-mode-visible(dina-horse, 0, 1, -1.00);
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-complete?(patrol, pat-supermarket-mixed-combat-done)) {
                        listen-mode-visible(player-horse, 1, 1, -1.00);
                        listen-mode-visible(dina-horse, 1, 1, -1.00);
                        go(complete, 1);
                    }
                }
            }
        }
    }
}
