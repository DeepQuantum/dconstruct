                    camera-fade-out-animated(1.00, 0);
                }
                lambda {
                    npc-request-lead-spline(dina, spl-pat-jackson-dina-1, player, *pat-dina-to-barn-lead-settings-close*, 0, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    npc-set-demeanor(dina, 0, 0);
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-active?(patrol-jackson, pat-jackson-assignments)) {
                        go(complete, 1);
                    }
                }
            }
        }
    }
}
