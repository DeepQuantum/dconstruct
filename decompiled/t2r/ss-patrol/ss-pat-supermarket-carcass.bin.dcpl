                    set-boolean(draw-gun?, 1, ss-pat-supermarket-tension-controller-1);
                }
                lambda {
                    wait(2.00);
                }
                lambda {
                    hud2-play-tutorial(HUD_TUTORIAL_QUICK_SWAP_ALT, 8.00, quick-swap-weapon, 0, 1, 0, 0, 0);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state horse-anims {
        block start {
            track main {
                lambda {
                    while (entity-exists?(player-horse) && !entity-exists?(dina-horse)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    if (get-boolean(task-in?, self)) {
                        u64? var_1 = #%alloc-array(single-frame, 16, 1, 1);
                        *(i32*)*var_1[0] = 13;
                        *(u64*)(*var_1[0] + 8) = 0;
                        *(i32*)(*var_1[0] + 8) = 2;
                        animate_(player-horse, pat-market-horse-mm-tense-idle, var_1);
                        u64? var_2 = #%alloc-array(single-frame, 16, 2, 1);
                        *(i32*)*var_2[0] = 58;
                        *(u64*)(*var_2[0] + 8) = 0;
                        *(f32*)(*var_2[0] + 8) = 0.60;
                        *(i32*)*var_2[1] = 13;
                        *(u64*)(*var_2[1] + 8) = 0;
                        *(i32*)(*var_2[1] + 8) = 2;
                        animate_(dina-horse, pat-market-horse-mm-tense-idle, var_2);
                    }
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
