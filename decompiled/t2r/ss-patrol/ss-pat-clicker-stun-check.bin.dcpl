statescript {
    options {
        player
        pat-supermarket-script
        pat-supermarket-infected-script
    }
    state first-state {
        block event_Attack {
            track main {
                lambda {
                    if (npc-is-stunned?(self) || *(u64 *)(event::get-attack-info(get-event()) + 72) == brick && *(u64 *)(event::get-attack-info(get-event()) + 72) == bottle) {
                        send-event(stunned, ss-pat-clicker-dina-callout-1);
                    }
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-complete?(patrol, pat-supermarket-clicker-combat)) {
                        go(complete, 1);
                    }
                }
            }
        }
    }
}
