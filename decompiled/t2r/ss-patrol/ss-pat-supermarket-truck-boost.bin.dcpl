                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 0.50;
                    *(i32*)*var_0[2] = 30;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.50;
                    wait-animate_(dina, pat-market-pharmacy-boost-stomach-end--dina, var_0);
                }
                lambda {
                    go(redo-crouch, 1);
                }
            }
            track vox {
                lambda {
                    if (get-int32(vox-lift-count, self) == 0) {
                        ++(vox-lift-count, self);
                        stop-speaking(dina);
                        wait-say(dina, vox-igc-din-igc-pat-market-pharmacy-boost-stomach-001, 2, 0);
                    } else if (get-int32(vox-lift-count, self) == 1) {
                        ++(vox-lift-count, self);
                        wait-say(dina, vox-igc-din-igc-pat-market-pharmacy-boost-stomach-003, 2, 0);
                    } else {
                        wait-say(dina, vox-igc-din-igc-pat-market-pharmacy-boost-stomach-002, 2, 0);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (player-in-region?(rgn-pat-supermarket-truck-boost-1, 2) && get-animation-playing?(dina, pat-market-pharmacy-boost-stomach-idle--dina, 2) && is-on-screen?(get-object-position(obj-pat-truck-target-1), 0.00)) {
                        u16 var_5;
                        if (joypad-command-active?(jump, 6)) {
                            var_5 = 1;
                        } else if (joypad-command-active?(interact, 6)) {
                            var_5 = 1;
                        } else {
                            var_5 = 0;
                        }
                        if (var_5) {
                            go(lift, 1);
                        }
                        u16 var_9;
                        if (get-boolean(play-acc-sweetener, self)) {
                            var_9 = sfx-ui-acc-interact-buddy-boost;
                        } else {
                            var_9 = 0;
                        }
                        play-accessibility-interact-sound-at-position(get-object-position(dina), var_9, 2.00, 0);
                        set-boolean(play-acc-sweetener, 0, self);
                    }
                }
                lambda {
                    if (!player-in-region?(rgn-pat-supermarket-truck-boost-1, 2)) {
                        set-boolean(play-acc-sweetener, 1, self);
                    }
                }
                lambda {
                    npc-look-at-point(dina, get-joint-position(player, headb), 10.00);
                }
                lambda {
                    set-boolean(debug-on-screen?, is-on-screen?(get-object-position(obj-pat-truck-target-1), 0.00), self);
                }
                lambda {
                    joypad-disable-commands(jump, jump-hold);
                }
            }
        }
        block event player-requested-interact {
            track main {
                lambda {
                    interactable-disable(int-pat-clicker-truck-1);
                }
                lambda {
                    camera-enable-animated(1.00, -1.00, 1, 1000, 0, 0, 0);
                }
                lambda {
                    go(lift, 1);
                }
            }
        }
    }
}
