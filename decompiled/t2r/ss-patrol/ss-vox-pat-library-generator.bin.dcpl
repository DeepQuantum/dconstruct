        block start {
            track vox {
                lambda {
                    if (!get-boolean(vox-first-workbench-done, self)) {
                        set-boolean(vox-first-workbench-done, 1, self);
                        wait(1.00);
                        while (!!(is-any-major-character-speaking?())) {
                            wait(0.10);
                        }
                        wait(1.00);
                        wait-say(dina, vox-igc-din-gam-pat-library-generator-on-sp-013, 2, 0);
                        wait(1.20);
