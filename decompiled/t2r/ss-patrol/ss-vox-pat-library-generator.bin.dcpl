                            wait(0.10);
                        }
                        while (script-in-state?(get-symbol(menu-widget, workbench-68), weapon-selection) && !script-in-state?(workbench-68, workbench-idle)) {
                            wait(0.10);
                        }
                        set-boolean(vox-first-workbench-upgrade-done, 1, self);
                        wait-say(player, vox-igc-ell-gam-pat-library-generator-on-sp-017, 2, 0);
                        wait(0.80);
                        wait-say(dina, vox-igc-din-gam-pat-library-generator-on-sp-014, 2, 0);
                    }
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
