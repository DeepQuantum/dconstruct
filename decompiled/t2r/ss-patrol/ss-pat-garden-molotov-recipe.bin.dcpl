statescript {
    options {
        player
        pat-garden-script
    }
    state task-check {
        block start {
            track main {
                lambda {
                    if (task-complete?(patrol, pat-garden-office-molotov)) {
                        go(complete, 1);
                    }
                }
                lambda {
                    if (task-active?(patrol, pat-garden-office-molotov)) {
                        go(wait-pickup, 1);
                    }
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-active?(patrol, pat-garden-office-molotov)) {
                        go(wait-pickup, 1);
                    }
                }
            }
        }
    }
    state wait-pickup {
        block start {
            track main {
                lambda {
                    script-caption(dina, "Ellie, looks like there's some gear over on this table", -1.00, 0, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (get-inventory-item-quantity(alcohol) >= 1 && get-inventory-item-quantity(scrap) >= 20) {
                        go(recipe, 1);
                    }
                }
            }
        }
    }
    state recipe {
        block start {
            track main {
                lambda {
                    player-learn-recipe-by-item-id(molotov, 0);
