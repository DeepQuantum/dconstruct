                    wait-for(save-abby);
                }
                lambda {
                    say(player, vox-igc-abb-igc-tra-overlook-cliff-edge-001, 2, 0);
                }
                lambda {
                    say(owen, vox-igc-own-igc-tra-overlook-cliff-edge-001, 2, 0);
                }
            }
            track rumble {
                lambda {
                    wait-for(save-abby);
                }
                lambda {
                    wait-until-anim-frame(player, tra-overlook-cliff-edge-start--abby, 15.00, 2);
                }
                lambda {
                    start-rumble(extra-hard-land-rumble-settings, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    override-render-settings(
                        *tra-rs-tra-traverse-cliff-abby-igc-1*,
                        1.00,
                        1.00,
                        0,
                        99,
                        0,
                        1,
                        0,
                        1.00
                    );
                }
                lambda {
                    player-vertigo-override-height-pct(get-vertigo-override-value(2), -1.00);
                }
                lambda {
                    player-vertigo-override-edge-dist-pct(get-vertigo-override-value(2), -1.00);
                }
                lambda {
                    player-vertigo-override-edge-look-angle-pct(get-vertigo-override-value(2), -1.00);
                }
                lambda {
                    player-vertigo-override-down-look-angle-pct(get-vertigo-override-value(2), -1.00);
                }
                lambda {
                    player-vertigo-override(get-vertigo-override-value(2), -1.00);
                }
            }
        }
    }
    state post-cliff {
        block start {
            track main {
                lambda {
                    set-boolean(name-revealed-abby, 1, ss-tra-inventory-control-1);
                }
                lambda {
                    set-boolean(name-revealed-owen, 1, ss-tra-inventory-control-1);
                }
                lambda {
                    player-vertigo-allow-in-cinematic(0);
                }
                lambda {
                    spawn-entity(obj-tra-block-cliff-1, 0, 0);
                }
                lambda {
                    spawn-entity(obj-tra-block-cliff-2, 0, 0);
                }
                lambda {
                    task-complete-if-active!(tracking, tra-overlook-traverse-cliff);
                }
                lambda {
                    npc-request-hold(owen, 10.00);
                }
                lambda {
                    while (!(get-joypad-stick-intensity(move, 0.20, 1.00) > 0.00)) {
                        npc-look-at-object(owen, player, 0, 10.00);
                        wait-one-frame();
                    }
                }
                lambda {
                    npc-set-player-evade(owen, 1);
                }
                lambda {
                    npc-request-lead-spline(owen, spl-tra-overlook-traverse-lead-1, player, *tra-owen-overlook-post-cliff-ai-lead-settings*, 0, 0);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    player-vertigo-allow-in-cinematic(0);
                }
                lambda {
                    animate-done(tra-overlook-cliff-edge-break-piece-1, tra-overlook-cliff-edge-start-piece, ap-overlook-traverse-cliff-1, 0, 0, 2);
                }
                lambda {
                    spawn-entity(obj-tra-block-cliff-1, 0, 0);
                }
                lambda {
                    spawn-entity(obj-tra-block-cliff-2, 0, 0);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
