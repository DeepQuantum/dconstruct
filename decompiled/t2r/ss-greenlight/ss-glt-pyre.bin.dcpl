    state clean-up {
        block start {
            track main {
                lambda {
                    kill-entity-if-spawned(npc-glt-pyre-assistant-1-1);
                }
                lambda {
                    kill-entity-if-spawned(npc-glt-pyre-mourner-1);
                }
