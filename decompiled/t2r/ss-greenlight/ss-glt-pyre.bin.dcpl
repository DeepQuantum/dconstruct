                    play-sound-at-position(sfx-igc-body-fire-lp-4, get-spawner-position(pos-snd-pyre-body-4, 1), 0, 0);
                }
            }
        }
        block end {
            track main {
                lambda {
                    send-event(turn-on, light-glt-pyre-1);
                }
                lambda {
                    send-event(turn-on, light-glt-pyre-2);
                }
                lambda {
                    send-event(turn-on, light-glt-pyre-3);
                }
                lambda {
                    send-event(turn-on, light-glt-pyre-4);
                }
                lambda {
                    kill-entity(obj-bottle-1);
                }
            }
        }
        block event clean-pyre-sequence {
            track main {
                lambda {
                    go(clean-up, 1);
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    spawn-npc(npc-glt-pyre-priest-1, 0, 0);
                }
                lambda {
                    npc-set-script-only-no-perception(npc-glt-pyre-priest-1);
