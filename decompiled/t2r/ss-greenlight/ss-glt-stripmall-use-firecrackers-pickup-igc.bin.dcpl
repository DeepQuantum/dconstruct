    animate-start(obj-glt-machete-body-1, glt-makeup-store-scavenge-machete--body, ap-glt-pickup-machete-1, 0);
    animate-start(obj-glt-machete-arrow-1, glt-makeup-store-scavenge-machete--arrow, ap-glt-pickup-machete-1, 0);
    animate-start(obj-glt-machete-arrow-broken-1, glt-makeup-store-scavenge-machete--arrowtip1, ap-glt-pickup-machete-1, 0);
    return animate-start(obj-glt-machete-arrow-broken-2, glt-makeup-store-scavenge-machete--arrowtip2, ap-glt-pickup-machete-1, 0);
}

