statescript {
    options {
        player
        nor-sinkhole-script
    }
    state wait-for-player {
        block event_inside {
            track main {
                lambda {
                    if (player-in-state?(Swim) && player-flashlight-on?()) {
                        u16 var_3;
                        if (joypad-command-active?(sprint-hold, 6)) {
                            var_3 = 1;
                        } else if (joypad-command-active?(sprint-press, 6)) {
                            var_3 = 1;
                        } else {
                            var_3 = 0;
                        }
                        if (!var_3 && is-on-screen?(get-spawner-position(pos-swim-fast-goal-1, 1), 0.00)) {
                            go(show-tutorial, 1);
                        }
                    }
                }
            }
        }
    }
    state show-tutorial {
        block start {
            track main {
                lambda {
                    if (joypad-button-from-input(gen:sprint) != joypad-button-from-input(swim:descend)) {
                        hud-play-tutorial(HUD_TUTORIAL_SWIM_FASTER, 10.00, 2, sprint-press, 3.00, 0, 0, 0);
                    }
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
