    state ambush-combat-started {
        block start {
            track main {
                lambda {
                    wait(0.50);
                }
                lambda {
                    wait-say(get-closest-living-npc-in-group(workbench-ambush-speakers, player, 0), vox-event-ai-nor-ellie-alone-streets-ambush-001, 2, 0);
                }
                lambda {
                    wait(3.30);
                }
                lambda {
                    wait-boolean(workbench-ambush-1-grabbed?, 1, self);
                }
                lambda {
                    wait(3.30);
                }
                lambda {
                    while (!is-any-ambusher-speaking?()) {
                        wait(0.10);
                    }
                }
                lambda {
                    wait-say(get-furthest-living-npc-in-group(workbench-ambush-speakers, player, 0), vox-event-ai-nor-ellie-alone-streets-ambush-002, 2, 0);
                }
                lambda {
                    wait(3.30);
                }
                lambda {
                    while (!is-any-ambusher-speaking?()) {
                        wait(0.10);
                    }
                }
                lambda {
                    wait-say(get-furthest-living-npc-in-group(workbench-ambush-speakers, player, 0), vox-event-ai-nor-ellie-alone-streets-ambush-003, 2, 0);
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    foreach (u16 var_2 : workbench-ambushers-1) {
                        if (npc-alive?(var_2)) {
                            npc-disable-has-ever-seen-updates/f(var_2);
                            fact-set(var_2, has-faction-ever-seen-player-or-buddy, boxed_bool(1));
                            fact-set(global, search-start-played?, boxed_bool(1));
                            fact-set(global, ambush-played?, boxed_bool(1));
                        }
                    }
                }
                lambda {
                    if (fact-get-bool-safe(npc-workbench-ambush-1, is-grappled?)) {
                        set-boolean(workbench-ambush-1-grabbed?, 0, self);
                    }
                }
            }
        }
        block event_npc-died {
            track main {
                lambda {
                    if (event-arg-symbol(0) == npc-workbench-ambush-1) {
                        set-boolean(workbench-ambush-1-grabbed?, 1, self);
                    }
                }
            }
        }
    }
