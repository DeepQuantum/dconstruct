u64? noras-chase-gurney-setup() {
    noras-chase-nora-setup();
    return teleport-character(npc-nor-nora-1, pos-nor-chase-gurney-1);
}

u64? noras-chase-nora-setup() {
    if (!entity-exists?(npc-nor-nora-1)) {
        spawn-entity(npc-nor-nora-1, 0, 0);
    }
    if (!entity-exists?(door-nor-confrontation-1)) {
        spawn-entity(door-nor-confrontation-1, 0, 0);
    }
    character-set-invincibility(npc-nor-nora-1, 4, 0);
    return npc-set-script-mode(npc-nor-nora-1, 2, 1);
}

u64? noras-chase-escape-setup() {
    noras-chase-nora-setup();
    return teleport-character(npc-nor-nora-1, pos-nor-chase-office-1);
}

u64? noras-chase-bridge-setup() {
    noras-chase-nora-setup();
    return teleport-character(npc-nor-nora-1, pos-nor-chase-bridge-1);
}

u64? noras-chase-office-setup() {
    noras-chase-nora-setup();
    return teleport-character(npc-nor-nora-1, pos-nor-chase-office-bookcase-1);
}

u64? noras-chase-rooftop-setup() {
    return noras-chase-nora-setup();
}

