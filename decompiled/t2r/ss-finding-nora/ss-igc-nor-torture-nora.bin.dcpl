            track haptics {
                lambda {
                    if (joypad-has-haptics?(2)) {
                        wait-until-anim-frame(player, torture-nora-attack-3--ellie, 36.50, 2);
                        play-hfx-id(melee-standing-finisher-rumble-settings, 0, 2);
                        play-hfx-id(wade-slosh-haptic, 0, 2);
                    }
                }
            }
            track black {
                lambda {
                    wait-frames(35);
                }
                lambda {
                    fade-to-black(0.00, 1.00, 0.00, 0);
                }
            }
            track music {
                lambda {
                    play-music-stinger(*music-playlist-nor-torture-nora-igc-oneshot-pt4*, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    camera-override-near-clip/f(0.00);
                }
                lambda {
                    override-render-settings(
                        *zgame-player-blood-healing-disable*,
                        0.00,
                        -1.00,
                        0,
                        32767,
                        0,
                        1,
                        0,
                        1.00
                    );
                }
                lambda {
                    if (get-boolean(mix-black-duck, self)) {
                        set-per-frame-mixer-override(mix-nor-torture-nora-black-duck);
                    }
                }
            }
        }
    }
    state wait-on-black {
        block start {
            track main {
                lambda {
                    set-boolean(mix-black-duck, 1, self);
                }
                lambda {
                    wait-fade-to-black(0.00, 5.00, 0.00);
                }
                lambda {
                    go(task-complete, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (get-boolean(mix-black-duck, self)) {
                        set-per-frame-mixer-override(mix-nor-torture-nora-black-duck);
                    }
                }
            }
        }
    }
    state task-complete {
        block start {
            track main {
                lambda {
                    task-complete!(find-nora, nor-torture-nora-igc);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (get-boolean(mix-black-duck, self)) {
                        set-per-frame-mixer-override(mix-nor-torture-nora-black-duck);
                    }
                }
            }
        }
    }
}
