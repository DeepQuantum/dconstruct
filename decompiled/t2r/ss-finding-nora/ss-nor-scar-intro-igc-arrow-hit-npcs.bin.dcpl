                }
                lambda {
                    while (!can-set-combat-checkpoints?()) {
                        wait-one-frame();
                    }
                }
                lambda {
                    set-combat-checkpoint(find-nora, nor-scar-intro, combat-done, 0, 0);
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-complete?(find-nora, nor-scar-intro)) {
                        go(cleanup, 1);
                    }
                }
            }
        }
    }
    state cleanup {
        block start {
            track main {
                lambda {
                    group-kill-entity(nor-scar-intro-npcs, 0);
                }
                lambda {
                    set-hardpoint-disabled(hard-point-nor-scar-intro-1);
                }
                lambda {
                    set-hardpoint-disabled(hard-point-nor-scar-intro-3);
                }
                lambda {
                    set-hardpoint-disabled(hard-point-nor-scar-intro-4);
                }
                lambda {
                    go(done, 1);
                }
            }
        }
    }
}
