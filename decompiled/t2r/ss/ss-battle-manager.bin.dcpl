                                    if (tag-int32(use-zone-locking, self) == 1) {
                                        npc-lock-to-zone(var_43);
                                    }
                                }
                                if (tag-int32(tutorial, self) == 1) {
                                    update-npc-awareness();
                                }
                                ++(ini-group-total, self);
                            }
                            net-set-boolean(ini-group-done, 1, self);
                        }
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (net-is-host?()) {
                        if (get-boolean(ini-group-done, self)) {
                            if (get-int32(spawn-count, self) >= get-int32(to-spawn-count, self) && !(get-int32(to-spawn-count, self) == -1)) {
                                net-go(done);
                            } else if (should-spawn?()) {
                                go(spawn, 1);
                            }
                        }
                    }
                }
            }
        }
    }
    state spawn {
        block start {
            track main {
                lambda {
                    if (!(get-float(min-init-spawn-delay, self) == 0.00) && !get-boolean(first-spawn?, self)) {
                        set-boolean(first-spawn?, 1, self);
                        wait(random-float-min-max(get-float(min-init-spawn-delay, self), get-float(max-init-spawn-delay, self), 0));
                    } else {
                        wait(random-float-min-max(get-float(min-inter-wave-spawn-delay, self), get-float(max-inter-wave-spawn-delay, self), 0));
                    }
                }
                lambda {
                    u64 i = 0;
                    while (i < random-int32-min-max(get-int32(min-spawn, self), get-int32(max-spawn, self), 0)) {
                        if (should-spawn?() && net-is-host?()) {
                            u64? var_7;
                            if (darray-count(get-symbol(schema-group, self)) > 0) {
                                var_7 = get-best-schema-spawner();
                            } else {
                                var_7 = select-best-schema-spawner(self, get-int32(schema-count, self));
                            }
                            if (!var_7) {
                                u64? var_14 = dc:format("battle-manager '%s' couldn't select schema spawner ", string-debug(get-object-id(self)));
                                display(var_14, 8);
                                display-error(var_14);
                                go(error, 1);
                            } else {
                                u64? var_17;
                                if (!(get-symbol(npc-group-leader, self) == 0)) {
                                    var_17 = get-spawner-near-leader(get-symbol(spawner-group, self), -1.00);
                                } else if (net-is-gametype?(6)) {
                                    if (get-self-id() == bm-team0-1) {
                                        var_17 = get-closest-spawner-in-group-to-locator(get-symbol(spawner-group, self), net-calculate-best-respawn-point-for-team(0));
                                    } else if (get-self-id() == bm-team1-1) {
                                        var_17 = get-closest-spawner-in-group-to-locator(get-symbol(spawner-group, self), net-calculate-best-respawn-point-for-team(1));
                                    } else {
                                        u16 var_32;
                                        if (!(tag-symbol(axis-spline, self) == 0)) {
                                            var_32 = tag-symbol(axis-spline, self);
                                        } else {
                                            var_32 = 0;
                                        }
                                        var_17 = battle-select-best-spawner-from-group(
                                            var_7,
                                            get-symbol(spawner-group, self),
                                            tag-float(spawn-distance, self),
                                            var_32,
                                            tag-int32(spawn-out-of-frustum, self)
                                        );
                                    }
                                } else {
                                    u16 var_39;
                                    if (!(tag-symbol(axis-spline, self) == 0)) {
                                        var_39 = tag-symbol(axis-spline, self);
                                    } else {
                                        var_39 = 0;
                                    }
                                    var_17 = battle-select-best-spawner-from-group(
                                        var_7,
                                        get-symbol(spawner-group, self),
                                        tag-float(spawn-distance, self),
                                        var_39,
                                        tag-int32(spawn-out-of-frustum, self)
                                    );
                                }
                                setup-bm-npc(spawn-npc(entity-name(var_7), var_17, 0), var_17);
                            }
                            if (get-int32(alive-count, self) == get-int32(min-keep-alive-count, self)) {
                                set-boolean(fill, 1, self);
                            } else if (get-int32(alive-count, self) == get-int32(max-keep-alive-count, self)) {
                                set-boolean(fill, 0, self);
                            }
                            if (get-int32(spawn-count, self) >= get-int32(to-spawn-count, self) && !(get-int32(to-spawn-count, self) == -1)) {
                                net-go(done);
                            }
                        }
                        wait(random-float-min-max(tag-float(min-inter-spawn-delay, self), tag-float(max-inter-spawn-delay, self), 0));
                        i = i + 1;
                    }
                }
                lambda {
                    if (tag-int32(tutorial, self) == 1) {
                        update-npc-awareness();
                    }
                }
                lambda {
                    go(pause, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    update-leader-zoning();
                }
            }
        }
    }
    state pause {
        block start {
            track main {
                lambda {
                    wait-one-frame();
                }
                lambda {
                    if (should-spawn?()) {
                        go(spawn, 1);
                    } else {
                        net-go(wait);
                    }
                }
            }
        }
    }
    state freeze {
        block  {
        }
        block event_unfreeze-bm {
            track main {
                lambda {
                    go(pause, 1);
                }
            }
        }
    }
    state wait {
        block update {
            track main {
                lambda {
                    update-leader-zoning();
                }
                lambda {
                    if (should-spawn?()) {
                        go(spawn, 1);
                    } else if (get-int32(spawn-count, self) >= get-int32(to-spawn-count, self) && !(get-int32(to-spawn-count, self) == -1)) {
                        net-go(done);
                    }
                }
            }
        }
    }
    state error {
        block event_is-active? {
            track main {
                lambda {
                    event-return-boolean(0);
                }
            }
        }
    }
    state done {
        block start {
            track main {
                lambda {
                    if (net-is-host?()) {
                        if (tag-boolean(go-to-pending-after-all-dead, self)) {
                            while (!(get-int32(alive-count, self) <= 0)) {
                                wait-one-frame();
                            }
                            if (!(tag-symbol(completion-reward, self) == none)) {
                                net-spawn-entity-at(tag-symbol(completion-reward, self), get-object-locator(get-symbol(last-dead-npc, self)), 0, 0, 0, 0);
                            }
                            broadcast-event(battle-manager-finished, boxed_symbol(get-self-id()));
                            wait(3.00);
                            net-go(pending-activation);
                        } else {
                            net-go(pending-activation);
                        }
                    }
                }
            }
        }
        block event_is-active? {
            track main {
                lambda {
                    event-return-boolean(get-int32(alive-count, self) > 0);
                }
            }
        }
    }
}
