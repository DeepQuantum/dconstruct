statescript {
    options {
        player
    }
    declarations {
        bool allow-skip = nullptr
    }
    state initial {
        block start {
            track main {
                lambda {
                    if (tag-symbol(door-to-bypass, self) == 0 && tag-symbol(pos-to-telepor, self) == 0) {
                        u64? var_2 = dc:format("Door and/or Teleport position not specified");
                        display(var_2, 8);
                        display-error(var_2);
                    }
                }
            }
        }
        block event_player-requested-interact {
            track main {
                lambda {
                    set-boolean(allow-skip, 1, self);
                }
            }
        }
        block event_door-opened {
            track main {
                lambda {
                    set-boolean(allow-skip, 0, self);
                }
            }
        }
        block event_puzzle-skipped {
            track main {
                lambda {
                    teleport-character(player, tag-symbol(pos-to-teleport, self));
                }
            }
        }
        block event_inside {
            track main {
                lambda {
                    if (get-boolean(allow-skip, self)) {
                        notify-skippable-puzzle(get-self-id(), 1);
                    }
                }
            }
        }
    }
}
