                            } else {
                                var_8 = 0;
                            }
                            var_4 = npc-make-aware-of(var_8, dina, 2, *npc-awareness-options-silent*);
                        }
                    }
                }
            }
        }
    }
    state exit-turnstile-igc {
        block start {
            track main {
                lambda {
                    set-invisible-to-npcs(player, 1);
                }
                lambda {
                    set-invisible-to-npcs(dina, 1);
                }
                lambda {
                    foreach (u16 var_2 : all-enemy-npcs) {
                        if (npc-alive?(var_2)) {
                            npc-stop-behavior(var_2);
                            npc-set-script-only-no-perception(var_2);
                        }
                    }
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    go(clean-up, 1);
                }
            }
        }
    }
    state clean-up {
        block start {
            track main {
                lambda {
                    set-invisible-to-npcs(player, 0);
                }
                lambda {
                    set-invisible-to-npcs(dina, 0);
                }
                lambda {
                    kill-entity-if-spawned(npc-wat-gate-clicker-1);
                }
                lambda {
                    kill-entity-if-spawned(npc-wat-gate-clicker-2);
                }
                lambda {
                    kill-entity-if-spawned(npc-wat-gate-clicker-3);
                }
                lambda {
                    group-kill-entity(wat--exit-turnstile-clickers, 0);
                }
                lambda {
                    group-kill-entity(wat--exit-turnstile-runners, 0);
                }
            }
        }
    }
}
