statescript {
    options {
        player
        sp-all
        wat-capitol-hill-main-gas-station
    }
    state task-check {
        block start {
            track main {
                lambda {
                    wait-boolean(initialized, 1, ss-wat-explore-wide-1);
                }
                lambda {
                    if (task-complete?(watchtower, wat-explore-capitol-hill)) {
                        go(done, 1);
                    } else if (get-svar-as-boolean(wat-explore-dive-bar-combat-done)) {
                        go(done, 1);
                    } else if (get-svar-as-boolean(wat-explore-dive-bar-spawned)) {
                        go(spawn, 1);
                    }
                }
            }
        }
        block event_spawn-dive {
            track main {
                lambda {
                    go(spawn, 1);
                }
            }
        }
    }
    state spawn {
        block start {
            track main {
                lambda {
                    despawn-offscreen-npcs-in-group(darray-count(wat-infected-dive-npcs), all-enemy-npcs, 100.00);
                }
                lambda {
                    wait-spawn-npc-group-async(wat-infected-dive-npcs, 0, 0);
                }
                lambda {
                    npc-set-hard-point(npc-wat-infected-dive-2, hard-point-wat-dive-1);
                }
                lambda {
                    set-svar(wat-explore-dive-bar-spawned, 1);
                }
                lambda {
                    while (!distance-between-objects-less-than?(player, get-closest-object-in-group(wat-infected-dive-npcs, player, 0), 15.00)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    if (tension-mode-is?(1)) {
                        set-tension-mode(2);
                        send-event(vox-gas-station-infected-spawned, ss-vox-wat-explore-capitol-hill-gas-station-npcs-1);
                    }
                }
            }
        }
        block event_npc-died {
            track main {
                lambda {
                    if (npc-group-alive-count(wat-infected-dive-npcs) == 0) {
                        set-svar(wat-explore-dive-bar-combat-done, 1);
                        send-event(vox-gas-station-infected-combat-done, ss-vox-wat-explore-capitol-hill-1);
                        go(done, 1);
                    }
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-complete?(watchtower, wat-explore-capitol-hill)) {
                        go(cleanup, 1);
                    }
                }
            }
        }
    }
    state cleanup {
        block start {
            track main {
                lambda {
                    group-kill-entity(wat-infected-dive-npcs, 0);
                }
                lambda {
                    go(done, 1);
                }
            }
        }
    }
}
