                    if (is-speaking?(dina)) {
                        signal(start, 0);
                        wait(0.50);
                        stop-speaking(dina);
                    } else if (is-speaking?(player)) {
                        stop-speaking(player);
                        wait(0.50);
                    }
                }
                lambda {
                    signal(start, 0);
                }
            }
        }
        block event_player-attacked-mine {
            track main {
                lambda {
                    if (!get-svar-as-boolean(vox-wat-player-tripped-mine)) {
                        interactable-enable(int-wat-perimeter-traps-truck-door-rear-1);
                        go(clever-girl, 1);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    suspend-idle-gestures/f(player);
                }
                lambda {
                    suspend-idle-gestures/f(dina);
                }
                lambda {
                    npc-disable-dialog-look(dina, 0.00);
                }
                lambda {
                    npc-disable-dialog-look-gestures(dina, 0.00);
                }
                lambda {
                    player-disable-dialog-look-gestures(0.00);
                }
            }
        }
        block end {
            track main {
                lambda {
                    npc-clear-request-movement(dina);
                }
                lambda {
                    npc-request-explore(dina, rgn-wat-traps-master-explore-1, 0, *buddy-post-selector-set*, 6.00, 0, *default-ai-explore-follow-settings*, 0);
                }
            }
        }
    }
}
