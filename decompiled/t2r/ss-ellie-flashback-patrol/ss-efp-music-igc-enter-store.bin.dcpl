                    *(u64 *)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (2 * 8)) + 8) = 0.50;
                    wait-animate_(player, efp-muisc-store-enter--ellie-success, var_0);
                }
                lambda {
                    go(post-noise-tension, 1);
                }
            }
        }
    }
    state post-noise-tension {
        block start {
            track vox {
                lambda {
                    wait-script-caption(player, "Think they heard that?", 3.00, 0, 0);
                }
                lambda {
                    wait(4.00);
                }
                lambda {
                    wait-script-caption(joel, "I think we're good.", -1.00, 0, 0);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    set-tension-mode(3);
                }
            }
        }
    }
}
