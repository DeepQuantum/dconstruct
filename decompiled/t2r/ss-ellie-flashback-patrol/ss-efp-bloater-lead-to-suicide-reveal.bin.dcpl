                    *(u64 *)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(u8 *)(*(*var_0 + (2 * 8)) + 8) = 10;
                    *(i32 *)*(*var_0 + (3 * 8)) = 30;
                    *(u64 *)(*(*var_0 + (3 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (3 * 8)) + 8) = 1.00;
                    *(i32 *)*(*var_0 + (4 * 8)) = 36;
                    *(u64 *)(*(*var_0 + (4 * 8)) + 8) = 0;
