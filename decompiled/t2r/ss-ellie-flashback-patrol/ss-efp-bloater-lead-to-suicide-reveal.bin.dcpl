                lambda {
                    set-accessibility-pathfind-goal(pos-nav-assist-squeeze-to-reveal-1);
                }
                lambda {
                    wait-npc-move-to(joel, get-spawner-locator(pos-joel-wait-for-squeeze-to-reveal-1, 1), 0, 1, 0, 0, 0, 0);
                }
                lambda {
                    npc-request-hold(joel, 10.00);
                }
            }
            track vox {
                lambda {
                    say(joel, vox-igc-joe-igc-efp-jackson-suicide-reveal-intro-001, 2, 0);
                }
            }
            track squeeze {
                lambda {
                    wait-boolean(joel-opened-door, 1, self);
                }
                lambda {
                    wait(0.20);
                }
                lambda {
                    enable-player-squeeze-through(squeeze-through-to-reveal-1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    disable-sprinting();
                }
                lambda {
                    if (get-boolean(joel-opened-door, self)) {
                        npc-set-force-player-push(joel, 1, 0.00, -1.00);
                    }
                }
                lambda {
                    if (player-in-region?(rgn-efp-to-reveal-disable-unholster-1, 2)) {
                        camera-set-overlay(*camera-remap-near-squeeze*, 6, 1001.00);
                        holster-player-weapon(2, 1.00);
                        player-disable-unholstering();
                    }
                }
            }
        }
        block event_player-squeeze-through {
            track main {
                lambda {
                    set-accessibility-pathfind-goal(0);
                }
                lambda {
                    turn-off-flashlight(player, 0);
                }
                lambda {
                    go(start-cin, 1);
                }
            }
        }
    }
    state start-cin {
        block start {
            track main {
                lambda {
                    igc-prop-clean-up(2.00);
                }
                lambda {
                    camera-enable-animated(0.75, -1.00, 1, 1000, 0, 0, 0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 3, 1);
                    *(i32 *)*(*var_0 + (0 * 8)) = 10;
                    *(u64 *)(*(*var_0 + (0 * 8)) + 8) = 0;
                    *(u64 *)(*(*var_0 + (0 * 8)) + 8) = get-spawner-locator(ap-efp-jackson-suicide-reveal-intro-1, 1);
                    *(i32 *)*(*var_0 + (1 * 8)) = 28;
                    *(u64 *)(*(*var_0 + (1 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (1 * 8)) + 8) = 1.00;
                    *(i32 *)*(*var_0 + (2 * 8)) = 30;
                    *(u64 *)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (2 * 8)) + 8) = 0.00;
                    wait-animate_(player, efp-jackson-suicide-reveal-intro--ellie, var_0);
                }
