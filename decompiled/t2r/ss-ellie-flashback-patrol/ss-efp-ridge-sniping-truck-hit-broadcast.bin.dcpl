    state wait-hit {
        block event_start-hint-timer {
            track main {
                lambda {
                    send-event(turn-on, hint-waypoint-deer-ridge-2);
                }
            }
        }
        block event_Attack {
            track main {
                lambda {
                    broadcast-event(efp-watch-player-hit-truck, boxed_symbol(*(u64 *)(event::get-attack-info(get-event()) + 16)));
