                    if (!get-boolean(fill-hud, self)) {
                        hud2-show-interactable-hold(interact-default-hold, get-spawner-locator(pos-joe-vent-hud-1, 1), get-float(hud-progress, self), 1);
                    }
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    npc-unholster-pistol(dina, 0, 0, -1.00, 0);
                }
                lambda {
                    kill-entity-if-spawned(obj-joe-school-militia-1);
                }
                lambda {
                    kill-entity-if-spawned(obj-joe-school-militia-2);
                }
                lambda {
                    kill-entity-if-spawned(obj-joe-school-militia-3);
                }
                lambda {
                    kill-entity-if-spawned(obj-joe-school-dog-1);
                }
                lambda {
                    kill-entity-if-spawned(obj-joe-school-dog-2);
                }
                lambda {
                    foreach (u16 var_2 : all-enemy-npcs) {
                        kill-entity(var_2);
                    }
                }
                lambda {
                    animate-done(obj-joe-vent-igc-1, joe-ext-building-vent--vent-success, ap-joe-vent-igc-1, 0, 0, 2);
                }
            }
        }
    }
    state enemies-in-hall {
        block start {
            track main {
                lambda {
                    if (object-anim-playing?(player, joe-ext-building-vent--ellie-enter, 0) || object-anim-playing?(player, joe-ext-building-vent--ellie-attempt, 0) && object-anim-playing?(player, joe-ext-building-vent--ellie-attempt-idle, 0)) {
                        stop-animating(player, 0, 0.50, 0, 0);
                        camera-fade-out-animated(1.00, 0);
                    }
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 3, 1);
                    *(i32 *)*(*var_0 + (0 * 8)) = 10;
                    *(u64 *)(*(*var_0 + (0 * 8)) + 8) = 0;
                    *(u64 *)(*(*var_0 + (0 * 8)) + 8) = get-spawner-locator(ap-joe-vent-igc-1, 1);
                    *(i32 *)*(*var_0 + (1 * 8)) = 56;
                    *(u64 *)(*(*var_0 + (1 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (1 * 8)) + 8) = 0.00;
                    *(i32 *)*(*var_0 + (2 * 8)) = 28;
                    *(u64 *)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (2 * 8)) + 8) = 0.50;
                    animate_(obj-joe-vent-igc-1, joe-ext-building-vent--vent-enter, var_0);
                }
                lambda {
                    interactable-set-unavailable(int-joe-vent-1, 1);
                }
                lambda {
                    set-region-enabled(rgn-accessibility-pathfind-override-509, 1, 0);
                }
                lambda {
                    npc-set-script-low-priority(dina);
                }
                lambda {
                    if (get-boolean(dina-at-vent, self)) {
                        go(leave-vent, 1);
                    }
                }
            }
        }
        block event_npc-died {
            track main {
                lambda {
                    if (!(event-arg-symbol(0) == obj-joe-school-jordan-1)) {
                        if (!(event-arg-symbol(0) == obj-joe-school-interrogation-mike-1)) {
                            go(wait-for-player-in-region, 1);
                        }
                    }
                }
            }
        }
        block event_npc-exited-hall {
            track main {
                lambda {
                    go(wait-for-player-in-region, 1);
                }
            }
        }
    }
}
