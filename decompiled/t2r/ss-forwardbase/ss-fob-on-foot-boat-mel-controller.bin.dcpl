                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state on-rooftop {
        block start {
            track main {
                lambda {
                    npc-set-script-high-priority(mel);
                }
                lambda {
                    npc-request-lead-spline(mel, spl-mel-fob-reunion-to-trains-1, player, *default-ai-lead-settings*, 1, 0);
                }
                lambda {
                    go(move-to-fire-escape, 1);
                }
            }
        }
        block event_player-requested-interact {
            track main {
                lambda {
                    go(rejoin-party, 1);
                }
            }
        }
    }
    state move-to-fire-escape {
        block start {
            track main {
                lambda {
                    npc-set-script-high-priority(mel);
                }
                lambda {
                    npc-request-lead-spline(mel, spl-mel-fob-reunion-to-trains-1, player, *favor-move-performance-lead-settings*, 0, 0);
                }
            }
        }
        block event_lead-navigating-to-node {
            track main {
                lambda {
                    if (event-arg-int32(3) == get-last-index-on-spline(spl-mel-fob-reunion-to-trains-1)) {
                        go(rejoin-party, 1);
                    }
                }
            }
        }
    }
    state rejoin-party {
        block start {
            track main {
                lambda {
                    npc-request-lead-spline(mel, spl-lead-mel-reunion-1, player, *favor-move-performance-lead-settings*, 0, 0);
                }
                lambda {
                    wait-boolean(mel-returned-from-boat, 1, ss-fob-on-foot-boat-alice-controller-1);
                }
                lambda {
                    npc-look-at-object(mel, alice, targHead, 10.00);
                }
                lambda {
                    if (!get-svar-as-boolean(fob-vox-boat-roof-optional-convo)) {
                        while (!get-svar-as-boolean(fob-vox-boat-roof-optional-convo)) {
                            wait(0.10);
                        }
                        wait(1.00);
                    }
                }
                lambda {
                    npc-request-lead-spline(mel, spl-lead-mel-reunion-1, player, *fob-on-foot-boat-reunion-longer-lead-settings*, 0, 0);
                }
                lambda {
                    wait-boolean(player-in-yards, 1, self);
                }
                lambda {
                    go(trains-enter, 1);
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-active?(forward-base, fob-on-foot-trains-enter)) {
                        go(trains-enter, 1);
                    }
                }
            }
        }
        block event_mel-pulls-ahead {
            track main {
                lambda {
                    npc-request-lead-spline(mel, spl-lead-mel-reunion-1, player, *fob-on-foot-boat-reunion-longer-lead-settings*, 0, 0);
                }
            }
        }
    }
    state trains-enter {
        block start {
            track main {
                lambda {
                    npc-set-script-high-priority(mel);
                }
                lambda {
                    npc-request-lead-spline(mel, spl-lead-mel-reunion-1, player, *fob-on-foot-boat-reunion-lead-settings*, 0, 0);
                }
            }
            track player-in-trailer {
                lambda {
                    wait-boolean(player-in-trailer, 1, ss-fob-on-foot-boat-reunion-1);
                }
                lambda {
                    go(wait-player-exit-trailer, 1);
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-complete?(forward-base, fob-on-foot-trains-enter)) {
                        go(complete, 1);
                    }
                }
            }
        }
        block event_manny-optional-convo-start {
            track main {
                lambda {
                    go(manny-convo, 1);
                }
            }
        }
    }
    state manny-convo {
        block start {
            track main {
                lambda {
                    npc-request-lead-spline(mel, spl-lead-mel-reunion-1, player, *fob-on-foot-boat-reunion-convo-lead-settings*, 0, 0);
                }
                lambda {
                    while (!get-svar-as-boolean(vox-fob-on-foot-reunion-convo-done)) {
                        wait(0.10);
                    }
                }
                lambda {
                    go(trains-enter, 1);
                }
            }
        }
    }
    state wait-player-exit-trailer {
        block start {
            track main {
                lambda {
                    npc-request-hold(mel, 10.00);
                }
                lambda {
                    enable-action-pack(cap-fob-sugar-mel-wait-for-player-1, 1);
                }
                lambda {
                    npc-use-cinematic-action-pack(mel, cap-fob-sugar-mel-wait-for-player-1, 0, 0, 0);
                }
                lambda {
                    wait-boolean(player-in-trailer, 0, ss-fob-on-foot-boat-reunion-1);
                }
                lambda {
                    wait-random(1.00, 2.00);
                }
                lambda {
                    npc-stop-behavior(mel);
                }
                lambda {
                    disable-action-pack(cap-fob-sugar-mel-wait-for-player-1);
                }
                lambda {
                    go(trains-enter, 1);
                }
            }
        }
    }
}
