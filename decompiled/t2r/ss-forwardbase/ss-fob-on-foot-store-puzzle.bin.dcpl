                    if (!joypad-has-haptics?(2)) {
                        start-rumble(medium-land-rumble-settings, 0);
                        wait-until-frame(77);
                        start-rumble(soft-land-rumble-settings, 0);
                        wait-until-frame(152);
                        start-rumble(hard-land-rumble-settings, 0);
                        wait-until-frame(194);
                        start-rumble(extra-hard-land-rumble-settings, 0);
                        wait-until-frame(342);
                        start-rumble(soft-land-rumble-settings, 0);
                    }
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    wait-ensure-spawned(ladder-fob-on-foot-store-1);
                }
                lambda {
                    wait-ensure-spawned(obj-fob-on-foot-store-shelf-1);
                }
                lambda {
                    animate-done(obj-fob-on-foot-store-shelf-1, fob-on-foot-store-shelf-collapse-pinch--shelf, ap-fob-on-foot-store-shelf-collapse-1, 0, 0, 2);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
