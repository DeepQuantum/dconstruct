    state found-climb-up {
        block start {
            track main {
                lambda {
                    if (is-encounter-select?()) {
                        wait(1.50);
                        select-mode-mark-complete(0.00);
                    }
                }
                lambda {
                    while (!is-centered-on-screen?(get-object-position(ic-vox-look-at-climb-up-1), 200.00)) {
                        wait(0.10);
