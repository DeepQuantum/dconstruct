            }
        }
    }
    state combat-over {
        block start {
            track main {
                lambda {
                    wait-until-non-combat-tension(2.00, 4.00);
                }
                lambda {
                    while (player-in-region?(rgn-vox-fob-hostile-territory-sniper-building-1, 2) && !is-centered-on-screen?(get-object-position(ic-vox-look-at-sniper-building-1), 300.00)) {
                        wait(0.10);
                    }
                }
                lambda {
                    if (player-in-region?(rgn-vox-fob-hostile-territory-sniper-building-1, 2)) {
                        wait-say(player, vox-igc-abb-gam-fob-hostile-territory-sniper-combat-done-slf-028, 2, 0);
                        wait(0.30);
                        wait-say(player, vox-igc-abb-gam-fob-hostile-territory-sniper-combat-done-slf-029, 2, 0);
                    } else {
                        wait-say(player, vox-igc-abb-gam-fob-hostile-territory-sniper-combat-done-slf-023, 2, 0);
                        wait(0.30);
                        wait-say(player, vox-igc-abb-gam-fob-hostile-territory-sniper-combat-done-slf-024, 2, 0);
                    }
                }
                lambda {
                    if (is-encounter-select?()) {
                        wait(1.50);
                        select-mode-mark-complete(0.00);
                    }
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
    }
