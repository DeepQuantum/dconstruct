                        } else if (get-boolean(vox-bookstore-convo-played?, self) && !(get-boolean(vox-interior-convo-started?, self)) && get-boolean(vox-exterior-convo-played?, self) && get-boolean(vox-can-play-interior-convo?, self)) {
                            set-boolean(vox-interior-convo-started?, 1, self);
                            request-dialog(fob-hostile-territory-sniper-convo-interior-001, npc-fob-scar-4, npc-fob-scar-3, 0, 0, 0, 0);
                        }
                    } else if (event-arg-symbol(0) == npc-fob-scar-4 && event-arg-symbol(1) == npc-fob-scar-3 && event-arg-symbol(2) == ss-patrol-poi-group-16 && !(faction-investigating?(4)) && tension-mode-is?(2) && get-boolean(vox-hear-bookstore-convo?, self)) {
                        if (!is-final-build?()) {
                            display(dc:format("arrived at bookstore poi"), 19);
                        }
                        if (!(get-boolean(vox-bookstore-convo-started?, self))) {
                            set-boolean(vox-bookstore-convo-started?, 1, self);
                            request-dialog(fob-hostile-territory-sniper-convo-bookstore-001, npc-fob-scar-4, npc-fob-scar-3, 0, 0, 0, 0);
                        } else if (get-boolean(vox-bookstore-convo-played?, self) && !(get-boolean(vox-exterior-convo-started?, self)) && get-boolean(vox-can-play-exterior-convo?, self)) {
                            set-boolean(vox-exterior-convo-started?, 1, self);
                            request-dialog(fob-hostile-territory-sniper-convo-boba-001, npc-fob-scar-3, npc-fob-scar-4, 0, 0, 0, 0);
                        } else if (get-boolean(vox-bookstore-convo-played?, self) && !(get-boolean(vox-interior-convo-started?, self)) && get-boolean(vox-exterior-convo-played?, self) && get-boolean(vox-can-play-interior-convo?, self)) {
                            set-boolean(vox-interior-convo-started?, 1, self);
                            request-dialog(fob-hostile-territory-sniper-convo-interior-001, npc-fob-scar-4, npc-fob-scar-3, 0, 0, 0, 0);
                        }
                    } else if (event-arg-symbol(0) == npc-fob-scar-5 && event-arg-symbol(1) == npc-fob-scar-6 && event-arg-symbol(2) == ss-patrol-poi-group-17 && !(faction-investigating?(4)) && tension-mode-is?(2) && get-boolean(vox-hear-exterior-convo?, self)) {
                        if (!is-final-build?()) {
                            display(dc:format("arrived at exterior poi"), 19);
                        }
                        if (!(get-boolean(vox-exterior-convo-started?, self))) {
                            set-boolean(vox-exterior-convo-started?, 1, self);
                            request-dialog(fob-hostile-territory-sniper-convo-boba-001, npc-fob-scar-6, npc-fob-scar-5, 0, 0, 0, 0);
                        } else if (get-boolean(vox-exterior-convo-played?, self) && !(get-boolean(vox-interior-convo-played?, self)) && get-boolean(vox-can-play-interior-convo?, self)) {
                            set-boolean(vox-interior-convo-started?, 1, self);
                            request-dialog(fob-hostile-territory-sniper-convo-interior-001, npc-fob-scar-5, npc-fob-scar-6, 0, 0, 0, 0);
                        }
                    } else if (event-arg-symbol(0) == npc-fob-scar-6 && event-arg-symbol(1) == npc-fob-scar-5 && event-arg-symbol(2) == ss-patrol-poi-group-17 && !(faction-investigating?(4)) && tension-mode-is?(2) && get-boolean(vox-hear-exterior-convo?, self)) {
                        if (!is-final-build?()) {
                            display(dc:format("arrived at exterior poi"), 19);
                        }
                        if (!(get-boolean(vox-exterior-convo-started?, self))) {
                            set-boolean(vox-exterior-convo-started?, 1, self);
                            request-dialog(fob-hostile-territory-sniper-convo-boba-001, npc-fob-scar-6, npc-fob-scar-5, 0, 0, 0, 0);
                        } else if (get-boolean(vox-exterior-convo-played?, self) && !(get-boolean(vox-interior-convo-played?, self)) && get-boolean(vox-can-play-interior-convo?, self)) {
                            set-boolean(vox-interior-convo-started?, 1, self);
                            request-dialog(fob-hostile-territory-sniper-convo-interior-001, npc-fob-scar-5, npc-fob-scar-6, 0, 0, 0, 0);
                        }
                    } else if (event-arg-symbol(0) == npc-fob-scar-3 && event-arg-symbol(1) == npc-fob-scar-4 && event-arg-symbol(2) == ss-patrol-poi-group-17 && !(faction-investigating?(4)) && tension-mode-is?(2) && get-boolean(vox-hear-exterior-convo?, self)) {
