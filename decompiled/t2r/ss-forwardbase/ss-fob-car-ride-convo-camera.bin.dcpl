u64? in-left-plus-front-range?() {
    return float-in-range?(get-float(view-angle, self), -90.00, 0.00) && !get-boolean(in-deadzone, self);
}

u64? in-front-plus-right-range?() {
    return float-in-range?(get-float(view-angle, self), 0.00, 90.00) && !get-boolean(in-deadzone, self);
}

u64? update-view-angle() {
    return set-float(view-angle, angle-in-between-vectors-plus(vector-flatten(get-z-vec-from-object(obj-fob-car-ride-humvee-1), 1), vector-flatten(get-z-vec-from-bound-frame(camera-locator(0)), 1), 1), self);
}

u16 update-blend-amount() {
    set-float(blend-amount, (get-float(view-angle, self) - get-float(adjusted-origin-angle, self)) / (get-float(adjusted-target-angle, self) - get-float(adjusted-origin-angle, self)), self);
    u16 var_7;
    if (get-float(blend-amount, self) > 1.00) {
        var_7 = set-float(blend-amount, 1.00, self);
    } else if (get-float(blend-amount, self) < 0.00) {
        var_7 = set-float(blend-amount, 0.00, self);
    } else {
        var_7 = 0;
    }
    return var_7;
}

u64? update-deadzone-state() {
    return set-boolean(in-deadzone, float-in-range?(get-float(view-angle, self), get-float(origin-angle, self), get-float(adjusted-origin-angle, self)) && float-in-range?(get-float(view-angle, self), get-float(adjusted-target-angle, self), get-float(target-angle, self)), self);
}

u64? in-right-plus-back-range?() {
    return float-in-range?(get-float(view-angle, self), 90.00, 180.00) && !get-boolean(in-deadzone, self);
}

statescript {
    options {
        player
        fob-car-ride-script
        obj-fob-car-ride-humvee-1
    }
    declarations {
        f32 view-angle = 0.00
        f32 blend-amount = 0.00
        symbol camera-a = nullptr
        symbol camera-b = nullptr
        symbol zoom-camera-a = nullptr
        symbol zoom-camera-b = nullptr
        bool in-deadzone = nullptr
        f32 origin-angle = 0.00
        f32 target-angle = 0.00
        f32 adjusted-origin-angle = 0.00
        f32 adjusted-target-angle = 0.00
        f32 deadzone-angle = 5.00
    }
    state task-check {
        block start {
            track main {
                lambda {
                    if (task-continue-active?(forward-base, fob-car-ride-stadium, crowd-test--DEBUG)) {
                        go(complete, 1);
                    }
                }
                lambda {
                    if (task-range-active?(forward-base, fob-car-ride-stadium, forward-base, fob-car-ride-jungle)) {
                        go(overlay-start, 1);
                    }
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-active?(forward-base, fob-car-ride-stadium)) {
                        go(wait-overlay-start, 1);
                    }
                }
            }
        }
    }
    state wait-overlay-start {
        block start {
            track main {
                lambda {
                    camera-set-overlay(*camera-remap-strafe-fob-car-look-forward*);
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    go(overlay-start, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    update-view-angle();
                }
                lambda {
                    joypad-disable-commands(camera);
                }
                lambda {
                    fob-set-car-camera(*camera-strafe-fob-car-look-forward*, *camera-strafe-fob-car-look-forward*, 1.00);
                }
                lambda {
                    camera-set-overlay(*camera-remap-strafe-fob-car*, 1, 5.00);
                }
            }
        }
    }
    state overlay-start {
        block start {
            track main {
                lambda {
                    send-event(enable-camera-parenting, obj-fob-car-ride-humvee-1);
                }
                lambda {
                    go(camera-set, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    update-view-angle();
                }
                lambda {
                    joypad-disable-all-commands();
                }
            }
        }
    }
    state camera-set {
        block update {
            track main {
                lambda {
                    joypad-set-stick-scale(camera, 0.34);
                }
                lambda {
                    update-view-angle();
                }
                lambda {
                    update-deadzone-state();
                }
                lambda {
                    if (in-left-plus-front-range?()) {
                        update-zone-data(-90.00, 0.00);
                        set-symbol(camera-a, *camera-strafe-fob-car-close-look-left*, self);
                        set-symbol(camera-b, *camera-strafe-fob-car-look-forward*, self);
                        set-symbol(zoom-camera-a, *camera-strafe-fob-car-close-look-left-zoom*, self);
                        set-symbol(zoom-camera-b, *camera-strafe-fob-car-look-forward-zoom*, self);
                        set-boolean(look-at, 0, ss-fob-car-ride-ambush-intro-igc-1);
                    } else if (in-front-plus-right-range?()) {
                        update-zone-data(0.00, 90.00);
                        set-symbol(camera-a, *camera-strafe-fob-car-look-forward*, self);
                        set-symbol(camera-b, *camera-strafe-fob-car-look-right*, self);
                        set-symbol(zoom-camera-a, *camera-strafe-fob-car-look-forward-zoom*, self);
                        set-symbol(zoom-camera-b, *camera-strafe-fob-car-look-right-zoom*, self);
                        set-boolean(look-at, 0, ss-fob-car-ride-ambush-intro-igc-1);
                    } else if (in-right-plus-back-range?()) {
                        update-zone-data(90.00, 180.00);
                        set-symbol(camera-a, *camera-strafe-fob-car-look-right*, self);
                        set-symbol(camera-b, *camera-strafe-fob-car-look-backward*, self);
                        set-symbol(zoom-camera-a, *camera-strafe-fob-car-look-right-zoom*, self);
                        set-symbol(zoom-camera-b, *camera-strafe-fob-car-look-backward-zoom*, self);
                        set-boolean(look-at, 0, ss-fob-car-ride-ambush-intro-igc-1);
                    } else if (in-back-plus-left-range?()) {
                        update-zone-data(-180.00, -90.00);
                        set-symbol(camera-a, *camera-strafe-fob-car-look-backward*, self);
                        set-symbol(camera-b, *camera-strafe-fob-car-close-look-left*, self);
                        set-symbol(zoom-camera-a, *camera-strafe-fob-car-look-backward-zoom*, self);
                        set-symbol(zoom-camera-b, *camera-strafe-fob-car-close-look-left-zoom*, self);
                        set-boolean(look-at, 1, ss-fob-car-ride-ambush-intro-igc-1);
                    }
                }
                lambda {
                    update-blend-amount();
                }
                lambda {
                    fob-set-car-camera(get-symbol(camera-a, self), get-symbol(camera-b, self), get-float(blend-amount, self));
                }
                lambda {
                    fob-set-car-camera-zoom(get-symbol(zoom-camera-a, self), get-symbol(zoom-camera-b, self), get-float(blend-amount, self));
                }
                lambda {
                    if (player-is-aim-active?()) {
                        camera-set-overlay(*camera-remap-strafe-fob-car-zoom*, 1, 0.50);
                    } else {
                        camera-set-overlay(*camera-remap-strafe-fob-car*, 1, 0.50);
                    }
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-active?(forward-base, fob-car-ride-ambush-intro)) {
                        send-event(disable-camera-parenting, obj-fob-car-ride-humvee-1);
                        go(complete, 1);
                    }
                }
            }
        }
    }
}
