                }
                lambda {
                    wait-spawn-entity(npc-fob-car-ride-network-scar-10, 0);
                }
                lambda {
                    npc-set-spline-network-settings(npc-fob-car-ride-network-horse-7, *fob-car-scar-ambush-spline-network-settings*);
                }
                lambda {
                    horse-set-orphaned-spline-network-movement(npc-fob-car-ride-network-horse-7, 2, gallop-sprint);
                }
                lambda {
                    set-overlay-set(npc-fob-car-ride-network-scar-10, anim-overlay-thug-level-fob-ambush-end);
                }
                lambda {
                    send-event(vox-ambush-end-setup, ss-vox-fob-car-ride-ambush-combat-1);
                }
                lambda {
                    go(wait-for-car-crash, 1);
                }
            }
        }
    }
    state wait-for-car-crash {
        block event task-complete {
            track main {
                lambda {
                    if (task-active?(forward-base, fob-car-ride-crash)) {
                        go(clean-up, 1);
                    }
                }
            }
        }
    }
    state clean-up {
        block start {
            track main {
                lambda {
                    group-kill-entity(fob-car-ride-network-scars, 0);
                }
                lambda {
                    group-kill-entity(fob-car-ride-network-horses, 0);
                }
                lambda {
                    group-kill-entity(fob-car-ride-alley-network-scars, 0);
                }
                lambda {
                    group-kill-entity(fob-car-ride-alley-network-horses, 0);
                }
            }
        }
        block event task-complete {
            track main {
                lambda {
                    if (task-complete?(forward-base, fob-car-ride-crash)) {
                        go(clean-up-2, 1);
                    }
                }
            }
        }
    }
    state clean-up-2 {
        block start {
            track main {
                lambda {
                    group-kill-entity(fob-car-ride-end-network-2, 0);
                }
                lambda {
                    group-kill-entity(fob-car-ride-end-network-1, 0);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
