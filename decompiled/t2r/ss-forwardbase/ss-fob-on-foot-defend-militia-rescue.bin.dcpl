                        wait-until-anim-frame(player, fob-on-foot-defend-end-end--abby, 108.00, 2);
                        play-hfx-id(clamber-foot-light-haptic, 0, 2);
                        wait-until-anim-frame(player, fob-on-foot-defend-end-end--abby, 176.00, 2);
                        play-hfx-id(boost-pull-haptic-soft, 0, 2);
                        wait-until-anim-frame(player, fob-on-foot-defend-end-end--abby, 365.00, 2);
                        play-hfx-id(medium-land-rumble-settings, 0, 2);
                        wait-until-anim-frame(player, fob-on-foot-defend-end-end--abby, 430.00, 2);
                        send-event(car-ride-start, ss-fob-on-foot-defend-car-ride-haptics-1);
                        wait-until-anim-frame(player, fob-on-foot-defend-end-end--abby, 677.00, 2);
                        play-hfx-id(car-bump-medium, 0, 2);
                        wait-until-anim-frame(player, fob-on-foot-defend-end-end--abby, 870.00, 2);
                        send-event(car-ride-end, ss-fob-on-foot-defend-car-ride-haptics-1);
                    }
                }
            }
            track rumble {
                lambda {
                    if (!joypad-has-haptics?(2)) {
                        wait-until-anim-frame(player, fob-on-foot-defend-end-end--abby, 38.00, 2);
                        start-rumble(soft-land-rumble-settings, 0);
                        wait-until-anim-frame(player, fob-on-foot-defend-end-end--abby, 93.00, 2);
                        start-rumble(soft-land-rumble-settings, 0);
                        wait-until-anim-frame(player, fob-on-foot-defend-end-end--abby, 366.00, 2);
                        start-rumble(soft-land-rumble-settings, 0);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    override-render-settings(
                        *fob-rs-gas-end-igc*,
                        1.00,
                        -1.00,
                        0,
                        32767,
                        0,
                        1,
                        0,
                        1.00
                    );
                }
            }
        }
    }
}
