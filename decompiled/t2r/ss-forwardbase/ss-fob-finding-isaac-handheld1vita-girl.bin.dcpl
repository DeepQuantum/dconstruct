                        *(u64*)(*var_1[0] + 8) = get-spawner-locator(ap-fob-finding-isaac-pspvita-girl-1, 1);
                        *(i32*)*var_1[1] = 28;
                        *(u64*)(*var_1[1] + 8) = 0;
                        *(f32*)(*var_1[1] + 8) = 0.50;
                        *(i32*)*var_1[2] = 30;
                        *(u64*)(*var_1[2] + 8) = 0;
                        *(f32*)(*var_1[2] + 8) = 0.50;
                        animate_(snpc-fob-pspvita-girl-1, fob-finding-isaac-pspvita-girl-loop--girl, var_1);
                    }
                }
            }
            track abby {
                lambda {
                    wait-boolean(away-from-igc, 1, self);
                }
                lambda {
                    signal(abby-speaks, 0);
                }
            }
            track vox {
                lambda {
                    wait-for(abby-speaks);
                }
                lambda {
                    gesture_(player, npc-m-nw-ambi-disagree-a-head-gesture, alloc-gesture-play-params());
                }
                lambda {
                    wait-say(player, vox-igc-abb-gam-fob-isaac-psvita-girl-slf-010, 2, 0);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    player-disable-dialog-look(0.00);
                }
                lambda {
                    player-disable-dialog-look-gestures(0.00);
                }
                lambda {
                    suspend-idle-gestures/f(player);
                }
            }
        }
    }
}
