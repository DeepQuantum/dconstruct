statescript {
    options {
        player
        fob-on-foot-railway
    }
    declarations {
        symbol associated-tap = nullptr
        symbol associated-region = nullptr
        bool no-ally-within = nullptr
    }
    state first-state {
        block event_enter {
            track main {
                lambda {
                    disable-action-pack(get-symbol(associated-tap, self));
                }
            }
        }
        block event_exit {
            track main {
                lambda {
                    set-boolean(no-ally-within, 1, self);
                }
                lambda {
                    foreach (u16 var_2 : ally-characters) {
                        if (object-in-region?(var_2, get-symbol(associated-region, self))) {
                            set-boolean(no-ally-within, 0, self);
                        }
                    }
                }
                lambda {
                    if (get-boolean(no-ally-within, self)) {
                        enable-action-pack(get-symbol(associated-tap, self), 1);
                    }
                }
            }
        }
    }
}
