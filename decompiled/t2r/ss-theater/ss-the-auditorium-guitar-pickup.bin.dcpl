                    the-wait-draw-bar(0.00, obj-the-backstage-guitar-1, progress, 0.25, played-note);
                }
                lambda {
                    set-int32(fill-note?, 0, obj-the-backstage-guitar-1);
                }
                lambda {
                    signal(last-note, 0);
                }
                lambda {
                    the-wait-draw-bar(4.00, obj-the-backstage-guitar-1, progress, 0.25, played-note);
                }
                lambda {
                    task-complete!(theater, the-guitar);
