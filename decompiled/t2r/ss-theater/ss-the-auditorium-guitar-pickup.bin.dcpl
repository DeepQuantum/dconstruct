                lambda {
                    send-event(force-other, obj-the-backstage-guitar-1, boxed_bool(1));
                }
                lambda {
                    go(start-flashback, 1);
                }
            }
            track kill-sounds {
                lambda {
                    wait-for(last-note);
                }
                lambda {
                    while (1) {
                        while (!(get-int32(chord-press, obj-the-backstage-guitar-1) == 4)) {
                            wait-one-frame();
                        }
                        set-boolean(kill-sounds, 1, obj-the-backstage-guitar-1);
                        while (get-int32(chord-press, obj-the-backstage-guitar-1) == 4) {
                            wait-one-frame();
                        }
                        set-boolean(kill-sounds, 0, obj-the-backstage-guitar-1);
                    }
                }
            }
            track fail {
                lambda {
                    wait-boolean(wrong-strum, 1, obj-the-backstage-guitar-1);
                }
                lambda {
                    set-boolean(last-note?, 0, obj-the-backstage-guitar-1);
                }
                lambda {
                    go(future-days3, 1);
                }
            }
        }
