statescript {
    options {
        player
    }
    state task-check {
        block start {
            track main {
                lambda {
                    if (task-range-active?(theater, the-lobby, theater, the-guitar)) {
                        go(check-pickups, 1);
                    }
                }
                lambda {
                    if (task-complete?(rescue-jesse, res-apologies-intro)) {
                        go(spawn-pickups, 1);
                    }
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-range-active?(theater, the-lobby, theater, the-guitar)) {
                        go(check-pickups, 1);
                    }
                }
                lambda {
                    if (task-complete?(rescue-jesse, res-apologies-intro)) {
                        go(spawn-pickups, 1);
                    }
                }
            }
        }
    }
    state check-pickups {
        block event_player-requested-interact {
            track main {
                lambda {
                    set-svar-bit(the-lobby-pickups, darray-find(the-pickups, boxed_symbol(event-arg-symbol(0)), 0), 1);
                }
            }
        }
    }
    state spawn-pickups {
        block start {
            track main {
                lambda {
                    kill-entity(coll-the-soldier-setlist-3);
                }
                lambda {
                    foreach (u16 var_2 : res-the-pickups) {
                        if (!get-svar-bit(the-lobby-pickups, darray-find(res-the-pickups, boxed_symbol(var_2), 0))) {
                            spawn-entity(var_2, 0, 0);
                        }
                    }
                }
                lambda {
                    if (get-svar-bit(the-lobby-pickups, 15) && !get-svar-bit(the-lobby-pickups, 16)) {
                        spawn-entity(ss-player-upgrade-manual-selector-30, 0, 0);
                    }
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
