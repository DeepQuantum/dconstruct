                                get-animation-speed(player, 2, med-infected-elevator-valve-bloater-alt-pull--abby),
                                1.00,
                                get-current-time(0) - var_1,
                                4
                            ),
                            2,
                            0
                        );
                        wait-one-frame();
                    }
                    set-animation-speed(player, 1.00, 2, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (get-boolean(infected-attacking?, ss-med-infected-corridor-elevator-infected-attack-1)) {
                        go(early-exit, 1);
                    }
                }
                lambda {
                    if (get-animation-phase(player, 2, med-infected-elevator-valve-bloater-alt-pull--abby) > 0.97) {
                        go(success-bloater-alive, 1);
                    }
                }
                lambda {
                    update-struggle-phase-elevator(1);
                }
                lambda {
                    hud2-show-interactable-hold(interact-default-hold, get-joint-locator(med-infected-elevator-door-1, door_l), get-float(struggle-phase, self), 1);
                }
                lambda {
                    if (!joypad-command-active?(interact-hold, 6)) {
                        go(struggle-bloater-alive-reverse, 1);
                    }
                }
            }
        }
    }
    state struggle-bloater-alive-reverse {
        block start {
            track main {
                lambda {
                    u64? var_1 = get-current-time(0);
                    while (!((get-current-time(0) - var_1) >= 0.50)) {
                        set-animation-speed(
                            player,
                            curve-scale(
                                0.00,
                                0.50,
                                get-animation-speed(player, 2, med-infected-elevator-valve-bloater-alt-pull--abby),
                                -1.00,
                                get-current-time(0) - var_1,
                                3
                            ),
                            2,
                            0
                        );
                        wait-one-frame();
                    }
                    set-animation-speed(player, -1.00, 2, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    update-struggle-phase-elevator(1);
                }
                lambda {
                    hud2-show-interactable-hold(interact-default-hold, get-joint-locator(med-infected-elevator-door-1, door_l), get-float(struggle-phase, self), 1);
                }
                lambda {
                    if (joypad-command-active?(crouch-press, 6) && get-boolean(infected-attacking?, ss-med-infected-corridor-elevator-infected-attack-1)) {
                        go(early-exit, 1);
                    }
                }
                lambda {
                    if (joypad-command-active?(interact-hold, 6)) {
                        go(struggle-bloater-alive-forward, 1);
                    }
                }
                lambda {
                    if (get-animation-phase(med-infected-elevator-valve-bloater-alt-pull--abby, 2, 0) < 0.02) {
                        go(idle-bloater-alive, 1);
                    }
                }
            }
        }
    }
    state success-bloater-alive {
        block start {
            track anims {
                lambda {
                    set-boolean(succeeded-struggle?, 1, self);
                }
                lambda {
                    npc-set-script-only-with-perception(npc-infected-hive-bloater-1);
                }
                lambda {
                    npc-set-script-only-with-perception(lev);
                }
                lambda {
                    npc-holster-weapon(lev, 4, 1, -1.00, 0);
                }
                lambda {
                    npc-clear-request-movement(lev);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 1, 1);
                    *(i32 *)*(*var_0 + (0 * 8)) = 10;
                    *(u64 *)(*(*var_0 + (0 * 8)) + 8) = 0;
                    *(u64 *)(*(*var_0 + (0 * 8)) + 8) = get-spawner-locator(ap-med-infected-elevator-1, 1);
                    animate_(med-infected-elevator-door-1, med-infected-elevator-valve-bloater-alt-exit--door, var_0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 3, 1);
                    *(i32 *)*(*var_0 + (0 * 8)) = 10;
                    *(u64 *)(*(*var_0 + (0 * 8)) + 8) = 0;
                    *(u64 *)(*(*var_0 + (0 * 8)) + 8) = get-spawner-locator(ap-med-infected-elevator-1, 1);
                    *(i32 *)*(*var_0 + (1 * 8)) = 28;
                    *(u64 *)(*(*var_0 + (1 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (1 * 8)) + 8) = 0.50;
                    *(i32 *)*(*var_0 + (2 * 8)) = 30;
                    *(u64 *)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (2 * 8)) + 8) = 0.50;
                    animate_(lev, med-infected-elevator-valve-bloater-alt-exit--lev, var_0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 2, 1);
                    *(i32 *)*(*var_0 + (0 * 8)) = 10;
                    *(u64 *)(*(*var_0 + (0 * 8)) + 8) = 0;
                    *(u64 *)(*(*var_0 + (0 * 8)) + 8) = get-spawner-locator(ap-med-infected-elevator-1, 1);
                    *(i32 *)*(*var_0 + (1 * 8)) = 28;
                    *(u64 *)(*(*var_0 + (1 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (1 * 8)) + 8) = 0.50;
                    animate_(npc-infected-hive-bloater-1, med-infected-elevator-valve-bloater-alt-exit--bloater, var_0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 3, 1);
                    *(i32 *)*(*var_0 + (0 * 8)) = 10;
                    *(u64 *)(*(*var_0 + (0 * 8)) + 8) = 0;
                    *(u64 *)(*(*var_0 + (0 * 8)) + 8) = get-spawner-locator(ap-med-infected-elevator-1, 1);
                    *(i32 *)*(*var_0 + (1 * 8)) = 28;
                    *(u64 *)(*(*var_0 + (1 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (1 * 8)) + 8) = 0.50;
                    *(i32 *)*(*var_0 + (2 * 8)) = 30;
                    *(u64 *)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (2 * 8)) + 8) = 0.50;
                    wait-animate_(player, med-infected-elevator-valve-bloater-alt-exit--abby, var_0);
                }
                lambda {
                    npc-set-script-high-priority(lev);
                }
                lambda {
                    set-svar-as-boolean(med-descent-bloater-broke-door, 1);
                }
                lambda {
                    camera-fade-out-animated(1.00, 0);
                }
                lambda {
                    go(clean-up, 1);
                }
            }
            track vox {
                lambda {
                    say(player, vox-igc-abb-igc-med-infected-elevator-valve-bloater-alt-exit-001, 2, 0);
                }
                lambda {
                    say(lev, vox-igc-lev-igc-med-infected-elevator-valve-bloater-alt-exit-001, 2, 0);
                }
            }
            track hud {
                lambda {
                    hud2-signal-interactable-hold-success();
                }
            }
        }
    }
    state clean-up {
        block start {
            track main {
                lambda {
                    task-complete!(medicine, med-infected-building-corridor-fight);
                }
                lambda {
                    group-kill-entity(all-infected-npcs, 0);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    if (get-svar-as-boolean(med-descent-bloater-broke-door)) {
                        animate-done(med-infected-elevator-door-1, med-infected-elevator-valve-bloater-alt-exit--door, ap-med-infected-elevator-1, 0, 0, 2);
                    } else {
