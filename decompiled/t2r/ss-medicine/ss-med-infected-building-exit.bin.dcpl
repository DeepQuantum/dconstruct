                    set-boolean(lev-follow?, 0, self);
                }
                lambda {
                    npc-request-explore(lev, rgn-med-explore-inf-building-exit-1, 0, *buddy-post-selector-set*, 12.00, 0, *default-ai-explore-follow-settings*, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (player-in-region?(rgn-med-lead-to-inf-building-exit-1, 2)) {
                        go(lead-to-exit, 1);
                    }
