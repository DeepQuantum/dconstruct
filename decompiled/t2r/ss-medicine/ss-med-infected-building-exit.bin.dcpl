                    } else if (task-complete?(medicine, med-infected-building-exit)) {
                        go(complete, 1);
                    }
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-active?(medicine, med-infected-building-exit)) {
                        go(building-exit, 1);
                    }
                }
            }
        }
    }
    state building-exit {
        block start {
            track main {
                lambda {
                    if (get-boolean(lev-follow?, self)) {
                        npc-request-follow-conversation(lev, player, 0, 0, 0);
                    } else {
                        npc-request-explore(lev, rgn-med-explore-inf-building-exit-1, 0, *buddy-post-selector-set*, 12.00, 0, *default-ai-explore-follow-settings*, 0);
                    }
                }
            }
        }
