                        npc-holster-weapon(lev, 4, 1, -1.00, 0);
                        npc-teleport-to(lev, get-spawner-locator(med-hidden-ascent-top-lev-force-grab-location-1, 1));
                        npc-teleport-to(var_8, find-closest-point-on-nav-mesh(offset-locator(get-object-locator(lev), alloc-vector(0.00, 0.00, -2.00, 1.00, 0)), 2.00, 5.00, 0.00, 0, 0));
                        wait-one-frame();
                        start-melee-action(var_8, lev, npc-vs-buddy-fist-standing-struggle-back-intro, 0, 0, 1, 0, 0);
                        wait-one-frame();
                        while (!!get-current-melee-attack(var_8)) {
                            wait-one-frame();
                        }
                        npc-set-script-low-priority(lev);
                        var_9 = npc-set-script-low-priority(var_8);
                    }
                    darray-destroy(var_0);
                    go(combat, 1);
                }
            }
        }
        block event_npc-died {
            track main {
                lambda {
                    if (!(get-symbol(lev-grab-move-id, self) == 0) && get-symbol(lev-grab-move-id, self) != get-current-melee-action-name(lev)) {
                        go(combat, 1);
                    }
                }
                lambda {
                    if (npc-group-alive-count(med-ascent-scar-ambushers) == 0) {
                        send-event(vox-med-ascent-combat-end, ss-vox-med-hidden-ascent-top-1);
                        go(combat-done, 1);
                    }
                }
                lambda {
                    if (npc-group-alive-count(med-ascent-scar-ambushers) < 3) {
                        send-event(unzone-npcs, self);
                    }
                }
                lambda {
                    if (event-arg-symbol(1) == lev) {
                        ++(lev-kills, self);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (!(get-symbol(lev-grab-move-id, self) == 0) && get-current-melee-action-name(lev) != get-symbol(lev-grab-move-id, self)) {
                        go(combat, 1);
                    }
                }
                lambda {
                    foreach (u16 var_2 : med-ascent-scar-ambushers) {
                        if (npc-alive?(var_2)) {
                            npc-disable-has-ever-seen-updates/f(var_2);
                            fact-set(var_2, has-faction-ever-seen-player-or-buddy, boxed_bool(1));
                        }
                    }
                }
            }
        }
        block end {
            track main {
                lambda {
                    set-symbol(lev-grab-move-id, 0, self);
                }
            }
        }
    }
    state combat-done {
        block start {
            track main {
                lambda {
                    npc-clear-zone(lev);
                }
                lambda {
                    set-hardpoint-disabled(hard-point-med-hidden-ascent-1);
                }
                lambda {
                    set-hardpoint-disabled(hard-point-med-hidden-ascent-2);
                }
                lambda {
                    set-hardpoint-disabled(hard-point-med-hidden-ascent-3);
                }
                lambda {
                    task-set-active-continue-safely!(combat-done, 0, 0);
                }
                lambda {
                    send-event(combat-done, ss-med-hidden-ascent-shrine-1);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    wait-spawn-entity(obj-med-hidden-ascent-scar-ambush-hatch-1, 0);
                }
                lambda {
                    animate-done(obj-med-hidden-ascent-scar-ambush-hatch-1, med-hidden-ascent-ambush--hatch, ap-med-hidden-ascent-scar-ambush-1, 0, 0, 2);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
