statescript {
    options {
        player
        lev
        med-infected-script
    }
    state task-check {
        block start {
            track main {
                lambda {
                    if (task-range-active?(medicine, med-infected-building-rope-descent-start, medicine, med-infected-building-death-pit)) {
                        go(enable-flashlight, 1);
                    } else if (task-complete?(medicine, med-infected-building-death-pit)) {
                        go(complete, 1);
                    }
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-active?(medicine, med-infected-building-rope-descent-start)) {
                        go(enable-flashlight, 1);
                    }
                }
            }
        }
    }
    state enable-flashlight {
        block start {
            track main {
                lambda {
                    turn-on-flashlight(lev, 0);
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    turn-off-flashlight(lev, 0);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
