            track main {
                lambda {
                    ratking-destroy-door();
                }
                lambda {
                    go(destroyed, 1);
                }
            }
        }
    }
    state destroyed {
        block start {
            track main {
                lambda {
                    send-event(go-unpowered, tag-symbol(door, self));
                }
                lambda {
                    broadcast-event(door-destroyed, boxed_symbol(get-self-id()));
                }
                lambda {
                    if (tag-boolean(hack-close-behind-ratking?, self)) {
                        wait(1.50);
                        animate-start(tag-symbol(door, self), ratking-break-door-opened--door, tag-symbol(door, self), 0);
                    }
                }
                lambda {
                    if (tag-specified?(first-door?, self)) {
                        set-boolean(past-first-door, 1, ss-med-ratking-igc-chase-gurney-hall-ratking-1);
                    }
                }
                lambda {
                    while (1) {
                        disable-action-pack(tag-symbol(npc-tap, tag-symbol(squeeze-through, self)));
                        ratking-wall-disable-taps();
                        wait-one-frame();
                    }
                }
            }
        }
    }
    state start-destroyed {
        block start {
            track main {
                lambda {
                    send-event(go-unpowered, tag-symbol(door, self));
                }
                lambda {
                    animate-done(tag-symbol(door, self), ratking-break-door-opened--door, 0, 0, 0, 2);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
