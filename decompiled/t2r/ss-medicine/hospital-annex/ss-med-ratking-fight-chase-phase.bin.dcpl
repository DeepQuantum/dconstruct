f32 ratking-chase-rubberband-speed-spline(u64? arg_0, u64? arg_1) {
    f32 var_2;
    if (!(npc-not-visible?(arg_0))) {
        var_2 = 0.80;
    } else {
        var_2 = lerp-scale(
            3.00,
            10.00,
            0.50,
            1.60,
            spline-distance-object(arg_1, arg_0) - spline-distance-object(arg_1, player)
        );
    }
    return var_2;
}

u64? ratking-chase-update-hp() {
    f32 var_1;
    if (850.00 > (f32)get-svar(med-ratking-health-after-chase)) {
        var_1 = 850.00;
    } else {
        var_1 = (f32)get-svar(med-ratking-health-after-chase);
