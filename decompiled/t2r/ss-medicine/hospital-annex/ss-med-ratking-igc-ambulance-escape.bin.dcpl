                    turn-on-light(rt-ratking-fill-2Shape-2, 0);
                }
                lambda {
                    turn-on-light(rt-ratking-fill-1Shape-1, 0);
                }
                lambda {
                    u64? var_0 = get-current-time(0);
                    while (!((get-current-time(0) - var_0) >= 0.30)) {
                        set-light-process-intensity(rt-park-Shape-4, lerp-scale(0.00, 0.30, 1.00, 0.00, get-current-time(0) - var_0));
                        wait-one-frame();
                    }
                    set-light-process-intensity(rt-park-Shape-4, 0.00);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state ambulance-phase-continue {
        block start {
            track main {
                lambda {
                    animate-done(obj-ambulance-5, med-hospital-boss-ratking-ambulance-escape-success--ambulance, ap-ambulance-igc-1, 0, 0, 2);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
