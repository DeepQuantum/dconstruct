    state igc-cleanup {
        block start {
            track main {
                lambda {
                    send-event(player-exited-ambulance, ss-med-ratking-fight-chase-phase-1);
                }
                lambda {
                    task-complete!(medicine, med-hospital-ratking-ambulance-escape-igc);
                }
                lambda {
                    npc-set-script-only-no-perception(npc-superstalker-3);
                }
            }
            track lighting {
