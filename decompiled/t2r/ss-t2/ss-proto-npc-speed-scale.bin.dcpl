statescript {
    options {
        player
    }
    declarations {
        f32 speed-scale = 1.00
    }
    state scale-speed {
        block update {
            track main {
                lambda {
                    if (tension-mode-is?(3)) {
                        set-float(speed-scale, lerp-scale(
                            tag-float(start-dist, self),
                            tag-float(end-dist, self),
