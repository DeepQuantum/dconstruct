u64? cannot-open-lock?() {
    return get-inventory-item-quantity(get-symbol(resource-item-id, self)) < get-int32(resource-item-amount, self) && !(get-symbol(resource-item-id-2, self) == 0) && get-inventory-item-quantity(get-symbol(resource-item-id-2, self)) < get-int32(resource-item-amount-2, self);
}

