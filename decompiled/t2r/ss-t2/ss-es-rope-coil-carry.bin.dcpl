            track main {
                lambda {
                    if (!get-boolean(end-attached, tag-symbol(manager-obj, self))) {
                        kill-entity-if-spawned(tag-symbol(thrown-rope, self));
                        go(disabled, 1);
                    }
                }
            }
        }
    }
}
