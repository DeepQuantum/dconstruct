statescript {
    options {
        player
        sp-all
    }
    declarations {
    }
    state use-cap {
        block start {
            track main {
                lambda {
                    npc-set-script-only-no-perception(self);
                }
                lambda {
                    while (npc-alive?(self)) {
                        wait-npc-use-cinematic-action-pack(self, tag-symbol(cap, self), 0, 0, 0);
                        wait(tag-float(cap-use-time, self));
                        npc-move-to(self, offset-locator(get-spawner-locator(get-self-id(), 1), alloc-vector(0.00, 0.00, 8.00, 1.00, 0)), 0, 1, 0, 0, 0, 0);
                        while (!(get-locator-distance(get-spawner-locator(self, 1), get-object-locator(self)) > 7.50)) {
                            wait-one-frame();
                        }
                        npc-teleport-to(self, get-spawner-locator(get-self-id(), 1));
                        wait-one-frame();
                    }
                }
            }
        }
    }
}
