                                    play-sound-at-bound-frame(sfx-ui-acc-sonar-pickup, var_48, 0, 0);
                                }
                                set-effect-color-vec(spawn-particles-at-bound-frame(listen-sonar, var_48, none), lookup-hud-color-vector(t2-white));
                                if (get-symbol(sonar-goal, self) == 0) {
                                    var_40 = set-symbol(sonar-goal, var_30, self);
                                }
                            }
                        }
                    }
                    darray-destroy(var_12);
                }
            }
        }
        block end {
            track main {
                lambda {
                    stop-sound(get-int32(sonar-center-handle, self));
                }
                lambda {
                    delete-path-request(get-int32(pathfind-pickup, self));
                }
                lambda {
                    set-int32(pathfind-pickup, -1, self);
                }
            }
        }
    }
}
