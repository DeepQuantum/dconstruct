                    if (!npc-alive?(get-symbol(partner-npc, self))) {
                        if (!(get-symbol(assigned-group, self) == 0)) {
                            send-event(request-done, get-symbol(assigned-group, self));
                        }
                    }
                }
            }
        }
    }
}
