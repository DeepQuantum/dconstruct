statescript {
    declarations {
        bool auto-aiming = nullptr
        bool done = nullptr
        f32 auto-aim-time = 1.00
    }
    state initial {
        block update {
            track main {
                lambda {
                    force-camera-aim-point(get-joint-position(self, spined));
                }
            }
        }
        block start {
            track auto-aim {
                lambda {
                    while (1) {
                        if (player-is-aiming?() && npc-on-screen-and-visible?(self, -1, 0) && !get-boolean(done, self) && !player-melee-throwable?()) {
                            set-boolean(auto-aiming, 1, self);
                            player-aim-at-locator(get-joint-locator(self, spined), 1.00, 1.00, 2);
                            wait-one-frame();
                            while (!is-centered-on-reticle?(get-joint-position(self, spined), 40.00)) {
                                set-boolean(auto-aiming, 1, self);
                                player-aim-at-locator(get-joint-locator(self, spined), 1.00, 1.00, 2);
                                wait-one-frame();
                            }
                            set-boolean(done, 1, self);
                        }
                        wait-one-frame();
                    }
                }
            }
            track terminate {
                lambda {
                    while (get-boolean(done, self) && !((get-current-time(0) - get-current-time(0)) > get-float(auto-aim-time, self))) {
                        wait-one-frame();
                    }
                }
                lambda {
                    terminate();
                }
            }
        }
    }
