statescript {
    options {
        player
        sp-all
    }
    state wait-for-pickup {
        block event_player-requested-interact {
            track main {
                lambda {
                    go(read-note, 1);
                }
            }
        }
    }
    state read-note {
        block start {
            track main {
                lambda {
                    set-visible(self, 0);
                }
                lambda {
                    interactable-disable(self);
                }
                lambda {
                    wait-script-caption(player, "Collectable Note", -1.00, 0, 0);
                }
                lambda {
                    kill-entity(self);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
