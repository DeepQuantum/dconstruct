                        while (!player-in-state?(RopeClimb)) {
                            wait-one-frame();
                        }
                        if (is-text-to-speech-enabled?() && is-traversal-audio-cues?()) {
                            if (get-self-id() == ss-rgn-502) {
                                hud2-play-tutorial(TIP_ACCESS_ROPE_SWING, -1.00, none, 0, 2, 0, 0, 0);
                            }
                        }
                        while (player-in-state?(RopeClimb) && is-traversal-audio-cues?()) {
                            play-accessibility-sound-at-position(sfx-ui-acc-prompt-distant-x-button, get-object-or-spawner-position(tag-symbol(forward-position, self)), 0);
                            if (get-self-id() == ss-rgn-502) {
                                wait(1.50);
                                play-accessibility-sound-at-position(sfx-ui-acc-prompt-distant-x-button, get-object-or-spawner-position(tag-symbol(forward-position, self)), 0);
                                wait(1.50);
                            } else {
                                wait(2.50);
                            }
                        }
                        while (player-in-state?(RopeClimb)) {
                            wait-one-frame();
                        }
                        hud2-clear-tutorials(0);
