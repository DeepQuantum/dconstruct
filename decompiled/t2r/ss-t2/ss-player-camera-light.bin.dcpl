u16 update-light-position-player-light() {
    u16 var_2;
    if (entity-exists?(tag-symbol(cam-light, self))) {
        var_2 = set-object-locator(tag-symbol(cam-light, self), rotate-locator-lookat(
            camera-get-locator(),
            offset-locator(get-joint-locator(player, pelvis), alloc-vector(0.00, -0.50, 0.75, 1.00, 0)),
            1.00,
            1
        ));
    } else {
        var_2 = 0;
    }
    return var_2;
}

