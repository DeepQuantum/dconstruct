                        wait(tag-float(respawn-delay, self));
                    }
                }
                lambda {
                    if (get-boolean(wait-off-screen?, self)) {
                        while (!!is-spawner-on-screen?(tag-symbol(object-spawner, self))) {
                            wait-one-frame();
                        }
                    }
                }
                lambda {
                    set-symbol(currently-spawned-entity, wait-spawn-entity(tag-symbol(object-spawner, self), 0), self);
                }
                lambda {
                    ++(num-spawns, self);
                }
