                lambda {
                    go(wait-for-pickup, 1);
                }
            }
        }
    }
    state wait-for-pickup {
        block start {
            track main {
                lambda {
                    while (!!entity-exists?(get-symbol(currently-spawned-entity, self))) {
                        wait-one-frame();
                    }
                }
                lambda {
                    set-symbol(currently-spawned-entity, 0, self);
                }
                lambda {
                    if (tag-int32(max-spawns, self) > 0 && get-int32(num-spawns, self) >= tag-int32(max-spawns, self)) {
                        go(disabled, 1);
                    }
                }
                lambda {
                    go(respawn, 1);
                }
            }
        }
    }
