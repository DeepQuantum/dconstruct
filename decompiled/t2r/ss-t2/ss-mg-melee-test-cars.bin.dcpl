u64? spawn-random-infected(u64? arg_0, i32 arg_1) {
    if (darray-count(arg_0) < (i32)arg_1) {
        darray-reset(arg_0);
    }
    u64? var_1 = get-furthest-in-group(arg_0, player);
    spawn-npc(var_1, 0, 0);
    return darray-find-remove(arg_0, boxed_symbol(var_1), 0);
}

statescript {
    options {
        player
        mg-melee-test-cars
    }
    state task-check {
        block start {
            track main {
                lambda {
                    if (task-active?(mgallant, melee-cars-infected)) {
                        go(infected, 1);
                    } else if (task-active?(mgallant, melee-cars-hunters)) {
