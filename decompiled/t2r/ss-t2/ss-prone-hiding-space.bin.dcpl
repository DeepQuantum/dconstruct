statescript {
    options {
        player
        sp-all
    }
    state detect-player {
        block event_enter {
            track main {
                lambda {
                    if (player-is-prone?()) {
                        player-set-in-prone-region();
                    }
                }
            }
        }
        block event_inside {
            track main {
                lambda {
                    if (player-is-prone?()) {
                        player-set-in-prone-region();
                    }
                }
            }
        }
    }
}
