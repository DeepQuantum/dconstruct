u64? slaver-visor--physicalize-helmet() {
    detach(get-symbol(visor-prop, self));
    set-collision-layer(get-symbol(visor-prop, self), small, 0);
    enable-physics(get-symbol(visor-prop, self), 0, 0.00);
    return set-boolean(helmet-is-physicalized?, 1, self);
}

u16 slaver-visor--check-for-physicalize-helmet() {
    u16 var_1;
    if (!get-boolean(start-physicalizing-helmet, self)) {
        if (character-get-gore-damage-level(self, 0) == 3) {
            set-single-shader-instance-param(get-symbol(visor-prop, self), blendOffset0, 0.00);
            set-single-shader-instance-param(get-symbol(visor-prop, self), blendOffset1, 0.00);
            set-single-shader-instance-param(get-symbol(visor-prop, self), blendOffset2, 1.00);
            var_1 = set-boolean(start-physicalizing-helmet, 1, self);
        } else {
            var_1 = 0;
        }
    } else {
        var_1 = 0;
    }
    return var_1;
}

