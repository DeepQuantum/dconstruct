statescript {
    options {
        player
        sp-all
    }
    state wait-for-pickup {
        block start {
            track main {
                lambda {
                    if (get-inventory-item-quantity(leatherworking-kit) > 0 || *(u8 *)(*player-prototypes* + 48) && hands-on?()) {
                        kill-entity(self);
                        go(done, 1);
                    }
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (get-inventory-item-quantity(leatherworking-kit) > 0 || *(u8 *)(*player-prototypes* + 48) && hands-on?()) {
                        kill-entity(self);
                        go(done, 1);
                    }
                }
            }
        }
        block event_player-requested-interact {
            track main {
                lambda {
                    if (event-arg-symbol(0) == get-self-id()) {
                        go(pause-card, 1);
                    }
                }
            }
        }
    }
    state pause-card {
        block start {
            track main {
                lambda {
                    string var_1;
                    if (is-player-ellie?(player)) {
                        var_1 = "ellie-leatherworking";
                    } else {
                        var_1 = "abby-leatherworking";
                    }
                    log-event("leatherworking-kit", 0, var_1, get-object-locator(self), 0);
                }
                lambda {
                    wait-gui2-show-pause-card(*tutorial-leatherworking-kit*, 0, 1, 2);
                }
                lambda {
                    if (is-player-ellie?(player)) {
                        set-svar-as-boolean(leatherworking-at-workbench-ellie, 0);
                    } else {
                        set-svar-as-boolean(leatherworking-at-workbench-abby, 0);
                    }
                }
                lambda {
                    go(done, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    joypad-disable-all-commands-except(menu-select);
                }
            }
        }
    }
}
