                    *(u8 *)(*(*var_2 + (7 * 8)) + 8) = 1;
                    *(i32 *)*(*var_2 + (8 * 8)) = 84;
                    *(u64 *)(*(*var_2 + (8 * 8)) + 8) = 0;
                    *(u8 *)(*(*var_2 + (8 * 8)) + 8) = 1;
                    animate_(get-symbol(closest-horse, self), get-symbol(horse-anim, self), var_2);
                }
                lambda {
                    horse-play-looping-stirrups-partial(1.40, 2, get-symbol(closest-horse, self));
                }
                lambda {
                    log-event("player-pet-horse", 1, "", 0, 0);
                }
                lambda {
                    u64? var_1 = #%alloc-array(single-frame, 16, 7, 1);
                    *(i32 *)*(*var_1 + (0 * 8)) = 10;
                    *(u64 *)(*(*var_1 + (0 * 8)) + 8) = 0;
                    *(u64 *)(*(*var_1 + (0 * 8)) + 8) = get-object-locator(get-symbol(closest-horse, self));
                    *(i32 *)*(*var_1 + (1 * 8)) = 28;
                    *(u64 *)(*(*var_1 + (1 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_1 + (1 * 8)) + 8) = 0.70;
                    *(i32 *)*(*var_1 + (2 * 8)) = 27;
                    *(u64 *)(*(*var_1 + (2 * 8)) + 8) = 0;
                    *(u8 *)(*(*var_1 + (2 * 8)) + 8) = 2;
                    *(i32 *)*(*var_1 + (3 * 8)) = 30;
                    *(u64 *)(*(*var_1 + (3 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_1 + (3 * 8)) + 8) = 1.00;
                    *(i32 *)*(*var_1 + (4 * 8)) = 44;
                    *(u64 *)(*(*var_1 + (4 * 8)) + 8) = 0;
                    *(u8 *)(*(*var_1 + (4 * 8)) + 8) = get-boolean(mirrored, self);
                    *(i32 *)*(*var_1 + (5 * 8)) = 81;
                    *(u64 *)(*(*var_1 + (5 * 8)) + 8) = 0;
                    *(u8 *)(*(*var_1 + (5 * 8)) + 8) = 1;
                    *(i32 *)*(*var_1 + (6 * 8)) = 13;
                    *(u64 *)(*(*var_1 + (6 * 8)) + 8) = 0;
                    *(i32 *)(*(*var_1 + (6 * 8)) + 8) = 3;
                    wait-animate_(player, get-symbol(player-anim, self), var_1);
                }
                lambda {
                    go(allow-petting, 1);
                }
            }
            track abort {
                lambda {
                    wait(2.50);
                }
                lambda {
                    while (!joypad-command-active?(horse-pet, 6) && !(get-joypad-stick-intensity(move, 0.20, 1.00) > 0.10)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    go(allow-petting, 1);
                }
            }
            track vox {
                lambda {
                    if (!(*(f32 *)(lookup-symbol(get-symbol(info-set, self), horse-petting-info-set) + 16) == -1.00)) {
                        wait-until-anim-frame(
                            player,
                            get-symbol(player-anim, self),
                            *(f32 *)(lookup-symbol(get-symbol(info-set, self), horse-petting-info-set) + 16),
                            2
                        );
                        wait-say(player, *(u64 *)(lookup-symbol(get-symbol(info-set, self), horse-petting-info-set) + 24), 2, 0);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (*horse* != null && *(u8 *)*horse*) {
                        debug-draw-chosen-petting-anim(1);
                    }
                }
            }
        }
        block end {
            track main {
                lambda {
                    stop-animating(get-symbol(closest-horse, self), 1, 1.40, horse-mm-tail--part, 0);
                }
                lambda {
                    if (get-animation-playing?(get-symbol(closest-horse, self), get-symbol(horse-anim, self), 2)) {
                        stop-animating(get-symbol(closest-horse, self), 2, 1.40, get-symbol(horse-anim, self), 0);
                    }
                }
                lambda {
                    if (get-animation-playing?(player, get-symbol(player-anim, self), 2)) {
                        stop-animating(player, 2, 1.40, get-symbol(player-anim, self), 0);
                    }
                }
                lambda {
                    if (get-boolean(moving-to-entry?, self)) {
                        cancel-player-move-to();
                    }
                }
                lambda {
                    set-boolean(moving-to-entry?, 0, self);
                }
                lambda {
                    set-symbol(closest-horse, *invalid-symbol*, self);
                }
            }
        }
    }
}
