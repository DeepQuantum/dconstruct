u64? update-light-position() {
    return set-object-locator(self, rotate-locator-lookat(
        offset-locator(get-joint-locator(player, pelvis), alloc-vector(0.00, -0.50, 0.00, 1.00, 0)),
        offset-locator(camera-locator(0), alloc-vector(0.00, 0.00, 100.00, 1.00, 0)),
        1.00,
        1
    ));
}

statescript {
    options {
        player
    }
    declarations {
    }
    state initial {
        block start {
            track main {
                lambda {
                    if (tag-boolean(start-flashlight-on, self)) {
                        go(flashlight-on, 1);
                    }
                }
                lambda {
                    go(flashlight-off, 1);
                }
            }
        }
    }
    state flashlight-on {
        block start {
            track main {
                lambda {
                    turn-on-light(tag-symbol(flashlight-actor, self), 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (joypad-command-active?(debug-script-press-r3, 6)) {
                        go(flashlight-off, 1);
                    }
                }
                lambda {
                    update-light-position();
                }
            }
        }
    }
    state flashlight-off {
        block start {
            track main {
                lambda {
                    turn-off-light(tag-symbol(flashlight-actor, self), 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (joypad-command-active?(debug-script-press-r3, 6)) {
                        go(flashlight-on, 1);
                    }
                }
                lambda {
                    update-light-position();
                }
            }
        }
    }
}
