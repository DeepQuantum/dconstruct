statescript {
    options {
        player
    }
    declarations {
    }
    state check-is-new-game-plus {
        block start {
            track main {
                lambda {
                    if (!is-new-game-plus?()) {
                        kill-entity(self);
                    }
                }
                lambda {
                    if (!(tag-symbol(alternate-pickup, self) == 0)) {
                        while (!entity-exists?(tag-symbol(alternate-pickup, self))) {
                            wait-one-frame();
                        }
                        kill-entity(tag-symbol(alternate-pickup, self));
                    }
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
