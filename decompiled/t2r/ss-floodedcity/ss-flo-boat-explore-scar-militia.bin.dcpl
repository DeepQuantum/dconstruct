                        } else if (var_3 && *(u16*)(var_3 + 12) == 5) {
                            var_4 = *(u64*)var_3;
                        } else if (var_3 && *(u16*)(var_3 + 12) == 6) {
                            var_4 = (i32)*(f32*)var_3;
                        } else {
                            var_4 = 0;
                        }
                        kill-particles(var_4, 0);
                    }
                }
                lambda {
                    kill-entity-if-spawned(obj-boat-militia-1);
                }
                lambda {
                    group-kill-entity(flo-boat-explore-militia, 0);
                }
                lambda {
                    group-kill-entity(flo-boat-explore-scars, 0);
                }
                lambda {
                    foreach (u64? var_2 : flo-boat-explore-scar-hardpoints) {
                        set-hardpoint-disabled(var_2);
                    }
                }
                lambda {
                    set-hardpoint-disabled(hard-point-flo-scar-back-1);
                }
                lambda {
                    set-hardpoint-disabled(hard-point-flo-scar-back-2);
                }
                lambda {
