u64? flo-theater-coop-kill-npc-dead?() {
    return !(npc-alive?(npc-flo-theater-runner-1)) && !(npc-alive?(npc-flo-theater-runner-2));
}

u64? flo-theater-position-and-enable-interact(u64? arg_0, u64? arg_1) {
    set-object-position(arg_0, offset-position-vec(arg_1, ""));
    return interactable-enable(arg_0);
}

