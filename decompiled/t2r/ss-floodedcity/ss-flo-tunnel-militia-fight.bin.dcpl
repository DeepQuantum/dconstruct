                        go(complete, 1);
                    }
                }
            }
        }
        block end {
            track main {
                lambda {
                    npc-set-script-high-priority(jesse);
                }
                lambda {
                    npc-clear-look-at(jesse);
                }
            }
        }
    }
    state move-to-inside-conversation {
        block start {
            track jesse {
                lambda {
                    npc-set-script-only-no-perception(jesse);
                }
                lambda {
                    npc-move-to(jesse, get-spawner-locator(pos-flo-pax-convo-2, 1), 1, 0, 0, 0, 0, 0);
                }
                lambda {
                    while (distance-between-locators(get-object-locator(jesse), get-spawner-locator(pos-flo-pax-convo-2, 1)) < 4.00 && !(distance-between-objects(player, jesse) > 10.00)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    npc-move-to(jesse, get-spawner-locator(pos-flo-pax-convo-2, 1), 0, 1, 0, 0, 0, 0);
                }
            }
            track main {
                lambda {
                    while (!(distance-between-locators(get-object-locator(jesse), get-spawner-locator(pos-flo-pax-convo-2, 1)) < 7.00)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    while (!(distance-between-objects(player, jesse) < 12.00)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    signal(jesse-started-convo, 0);
                }
                lambda {
                    npc-request-buddy-look(jesse, 1);
                }
                lambda {
                    set-boolean(jesse-started-pax-convo, 1, ss-vox-flo-into-the-city-tunnel-militia-fight-1);
                }
                lambda {
                    point-to-point(jesse, get-spawner-position(pos-flo-pax-convo-poi-2, 1), 11, 1);
                }
                lambda {
                    npc-look-at-spawner(jesse, pos-flo-pax-convo-poi-2, -1.00);
                }
                lambda {
                    while (get-boolean(pax-convo-over, self) && !(distance-between-objects(player, jesse) > 13.00)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    go(combat-end, 1);
                }
            }
            track move-to-other-point {
                lambda {
                    wait-boolean(pax-convo, 1, self);
                }
                lambda {
                    set-boolean(pax-convo-alt, 0, self);
                }
                lambda {
                    if (!signal-raised?(jesse-started-convo, 0)) {
                        go(move-to-outside-conversation, 1);
                    }
                }
            }
            track go-back-to-lead {
                lambda {
                    wait-boolean(pax-convo-alt, 0, self);
                }
                lambda {
                    if (!signal-raised?(jesse-started-convo, 0)) {
                        go(combat-end, 1);
                    }
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-complete?(flooded-city, flo-into-the-city-tunnel-militia-fight)) {
                        go(complete, 1);
                    }
                }
            }
        }
        block end {
            track main {
                lambda {
                    npc-set-script-high-priority(jesse);
                }
                lambda {
                    npc-clear-look-at(jesse);
                }
            }
        }
    }
}
