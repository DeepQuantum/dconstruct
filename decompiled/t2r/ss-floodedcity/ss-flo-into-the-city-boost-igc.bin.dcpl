                        say(player, vox-igc-ell-igc-flo-into-the-city-boost-002, 2, 0);
                        set-boolean(player-backtracked?, 0, self);
                    }
                }
            }
        }
        block end {
            track main {
                lambda {
                    npc-clear-look-at(jesse);
                }
                lambda {
                    npc-request-buddy-look(jesse, 0);
                }
            }
        }
    }
