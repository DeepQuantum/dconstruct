                        wait-rumble-curve(0.24, 0.00, 0.10, 2, 0);
                    }
                }
            }
            track haptics {
                lambda {
                    if (joypad-has-haptics?(2)) {
                        wait-until-anim-frame(player, flo-into-the-city-boost--ellie, 28.00, 2);
                        play-hfx-id(clamber-right-hand-medium-haptic, 0, 2);
