statescript {
    options {
        player
    }
    declarations {
    }
    state initial {
        block start {
            track main {
                lambda {
                    if (!(current-spline == 0)) {
                        go(wait-for-in-region, 1);
                    } else {
                        print-string("WARNING: No current-spline set for this swim-current-region", self);
                    }
                }
            }
        }
    }
    state wait-for-in-region {
        block event_enter {
            track main {
                lambda {
                    go(in-region, 1);
                }
            }
        }
        block event_inside {
            track main {
                lambda {
                    go(in-region, 1);
                }
            }
        }
    }
    state in-region {
        block update {
            track main {
                lambda {
                    swim-enable(0);
                }
                lambda {
                    player-swim-flow-blend(
                        player,
                        tag-symbol(current-spline, self),
                        tag-float(start-strength, self),
                        tag-float(end-strength, self),
                        tag-boolean(pull-to-current?, self),
                        tag-boolean(pull-to-current-y?, self)
                    );
                }
            }
        }
        block event_exit {
            track main {
                lambda {
                    go(wait-for-in-region, 1);
                }
            }
        }
    }
}
