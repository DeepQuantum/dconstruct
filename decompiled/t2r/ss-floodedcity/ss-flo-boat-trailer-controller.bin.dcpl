statescript {
    options {
        player
        boat
    }
    state task-check {
        block start {
            track main {
                lambda {
                    if (task-continue-active?(flooded-city, flo-boat-explore-downtown, boat-trailer-shot--DEBUG)) {
                        go(apply-trailer-settings, 1);
                    }
                }
            }
        }
    }
    state apply-trailer-settings {
        block update {
            track main {
                lambda {
                    boat-override-dc-settings(boat, *flo-trailer-boat-settings*);
                }
            }
        }
    }
}
