        }
        block event_door-interact-canceled {
            track main {
                lambda {
                    if (get-boolean(player-in-door-interact, self)) {
                        set-boolean(player-in-door-interact, 0, self);
                        set-symbol(door, 0, self);
                    }
                }
            }
        }
        block event_door-interact-complete {
            track main {
                lambda {
                    if (get-boolean(player-in-door-interact, self)) {
                        set-boolean(player-in-door-interact, 0, self);
                        set-symbol(door, 0, self);
                    }
                }
            }
        }
