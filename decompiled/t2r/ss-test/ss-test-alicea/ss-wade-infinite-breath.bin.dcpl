statescript {
    options {
        player
    }
    state check {
        block event_player-in-water {
            track main {
                lambda {
                    go(infinite-breath, 1);
                }
            }
        }
    }
    state infinite-breath {
        block update {
            track main {
                lambda {
                    if (player-is-crouched?()) {
                        player-infinite-breath();
                    }
                }
                lambda {
                    go(check, 1);
                }
            }
        }
    }
}
