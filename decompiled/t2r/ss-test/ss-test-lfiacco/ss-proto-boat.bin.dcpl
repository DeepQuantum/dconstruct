                lambda {
                    set-boolean(returning-to-drake?, 1, self);
                }
                lambda {
                    signal(start-checks, 0);
                }
                lambda {
                    wait-boolean(sam-in-boat?, 1, self);
                }
                lambda {
                    while (1) {
                        calculate-spline-drive-position();
                        debug-draw-locator(get-bound-frame(target-drive-position, self), 0.30, 0.00, 0, 2.00, 0);
                        debug-draw-string(get-locator-position(get-bound-frame(target-drive-position, self)), "Target", 1, 0.00, 0, 1.00, 0, 0);
                        if (!get-boolean(returning-to-drake?, self)) {
                            if (get-object-speed(boat) < 0.50) {
                                boat-override-dc-settings(boat, *motorboat-playerboat-idle-settings*);
                            } else {
                                boat-override-dc-settings(boat, *motorboat-playerboat-boat-sam-drive-settings*);
                            }
                        } else if (absf(get-float(boat-spline-distance, self) - get-float(player-spline-distance, self)) < 60.00) {
                            boat-override-dc-settings(boat, *motorboat-playerboat-boat-sam-drive-settings*);
                        } else {
                            boat-override-dc-settings(boat, *motorboat-playerboat-boat-sam-drive-fast-settings*);
                        }
                        if (absf(get-float(boat-spline-distance, self) - get-float(player-spline-distance, self)) > 25.00) {
                            nav-vehicle-move-to(boat, nav-vehicle-find-reachable-location-near-locator(boat, get-bound-frame(target-drive-position, self)), 0);
                        } else {
                            set-boolean(sam-fetching-boat?, 0, self);
                            go(sam-driving, 1);
                        }
                        wait-one-frame();
                    }
                }
            }
            track check-teleport {
                lambda {
                    set-boolean(done-initial-teleport?, 0, self);
                }
                lambda {
                    wait-for(start-checks);
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    while (!get-boolean(done-initial-teleport?, self)) {
                        if (absf(get-float(boat-spline-distance, self) - get-float(player-spline-distance, self)) < 100.00) {
                            set-boolean(done-initial-teleport?, 1, self);
                        } else if (!is-object-on-screen?(boat, 0.00)) {
                            if (get-symbol(teleport-group, self) == none) {
                                vehicle-teleport(boat, rotate-locator-lookat(spline-locator-closest-to-object(get-symbol(current-drive-spline, self), boat), get-bound-frame(target-drive-position, self), 1.00, 0));
                            } else {
                                set-bound-frame(teleport-locator, get-spawner-locator(get-closest-in-group(get-symbol(teleport-group, self), player, 0, 0, 1, 0), 1), self);
                                vehicle-teleport(boat, get-bound-frame(teleport-locator, self));
                            }
                            set-float(boat-spline-distance, spline-distance-object(get-symbol(current-drive-spline, self), boat), self);
                            set-boolean(done-initial-teleport?, 1, self);
                        }
                        wait-one-frame();
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    set-bound-frame(boat-locator, get-object-locator(boat), self);
                }
            }
        }
        block end {
            track main {
                lambda {
                    set-symbol(teleport-group, none, self);
                }
            }
        }
    }
    state boat-paused {
        block start {
            track main {
                lambda {
                    set-bound-frame(boat-locator, get-object-locator(boat), self);
                }
                lambda {
                    enable-collision-gamedriven(boat, 0, 0.00);
                }
            }
        }
        block event_unpause {
            track main {
                lambda {
                    enable-physics(boat, 0, 0.00);
                }
                lambda {
                    set-bound-frame(boat-locator, get-object-locator(boat), self);
                }
                lambda {
                    go(boat-unoccupied, 1);
                }
            }
        }
    }
}
