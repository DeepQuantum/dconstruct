                    } else if (task-active?(mgallant, vert-slice-market-infected)) {
                        spawn-npc-group(vert-market-infected);
                    } else {
                        spawn-npc-group(vert-market-first-wave);
                    }
                }
                lambda {
                    go(first-wave, 1);
                }
            }
        }
    }
    state first-wave {
        block event_npc-died {
            track main {
                lambda {
                    if (npc-group-alive-count(all-enemy-npcs) < 2) {
                        go(second-wave, 1);
                    }
                }
            }
        }
