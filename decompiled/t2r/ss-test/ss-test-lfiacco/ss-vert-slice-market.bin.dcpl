            track main {
                lambda {
                    if (is-combat-or-search?()) {
                        set-boolean(combat-started, 1, self);
                    }
                }
            }
        }
    }
    state second-wave {
        block start {
            track main {
                lambda {
                    if (task-active?(mgallant, vert-slice-market-sledgehammer-plus-3)) {}
 else if (task-active?(mgallant, vert-slice-market-infected)) {}
 else if (player-in-region?(rgn-second-wave-1, 2)) {
                        spawn-npc(npc-second-wave-1-1, 0, 0);
                        spawn-npc(npc-second-wave-1-2, 0, 0);
                    } else {
