                        spawn-npc(npc-second-wave-2-2, 0, 0);
                    }
                }
                lambda {
                    wait-frames(3);
                }
                lambda {
                    if (npc-group-alive-count(vert-market-second-wave) > 0) {
                        script-caption(get-closest-in-group(vert-market-second-wave, player, 0, 0, 1, 0), "Reinforcements!", 3.00, 0, 0);
                        if (get-boolean(combat-started, self) && !tension-mode-is?(3)) {
                            npc-start-search(npc-get-faction-id(group-random(all-enemy-npcs)));
                        }
                    }
                }
                lambda {
                    if (npc-group-alive-count(all-enemy-npcs) == 0) {
                        go(encounter-complete, 1);
                    }
                }
            }
        }
        block event_npc-died {
            track main {
                lambda {
                    if (npc-group-alive-count(all-enemy-npcs) == 0) {
                        go(encounter-complete, 1);
                    }
                }
            }
        }
    }
    state encounter-complete {
