statescript {
    options {
        player
        lf-com-high-cover
    }
    state task-check {
        block start {
            track main {
                lambda {
                    if (task-active?(lfiacco, combat-high-cover) && task-active?(vert-slice, combat-high-cover)) {
                        go(spawn-enemies, 1);
                    }
                }
            }
        }
    }
    state spawn-enemies {
        block start {
            track main {
                lambda {
                    spawn-npc-group(lf-high-cover-npcs);
                }
                lambda {
                    npc-make-aware-of(group-random(lf-high-cover-npcs), player, 2, 0);
                }
            }
        }
        block event_npc-died {
            track main {
                lambda {
                    if (npc-group-alive-count(lf-high-cover-npcs) == 0) {
                        go(combat-end, 1);
                    }
                }
            }
        }
    }
    state combat-end {
        block start {
            track main {
                lambda {
                    wait(3.00);
                }
                lambda {
                    request-dialog(player-callout-combat-end, player, 0, 0, 0, 0, 0);
                }
            }
        }
    }
}
