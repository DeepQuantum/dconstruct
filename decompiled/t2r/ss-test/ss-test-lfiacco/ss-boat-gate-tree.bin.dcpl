statescript {
    options {
        player
        lf-trav-boat-gates
    }
    state initial {
        block start {
            track main {
                lambda {
                    go(out-of-boat, 1);
                }
            }
        }
    }
    state in-boat {
        block start {
            track main {
                lambda {
                    disable-collision(self, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (!(player-in-state?(BoatDriving))) {
                        go(out-of-boat, 1);
                    }
                }
            }
        }
    }
    state out-of-boat {
        block start {
            track main {
                lambda {
                    enable-collision(self, 1, 0, 0.00);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (player-in-state?(BoatDriving)) {
                        go(in-boat, 1);
                    }
                }
            }
        }
    }
}
