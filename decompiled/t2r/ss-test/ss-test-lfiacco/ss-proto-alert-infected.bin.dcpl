statescript {
    options {
        player
        lf-trav-boat-gates
    }
    declarations {
    }
    state initial {
        block start {
            track main {
                lambda {
                    go(ready, 1);
                }
            }
        }
    }
    state ready {
        block start {
            track main {
                lambda {
                    while (1) {
                        if (player-in-state?(BoatDriving) && player-in-region?(tag-symbol(this-region, self), 2)) {
                            go(alert, 1);
                        }
                        wait(0.30);
                    }
                }
            }
        }
    }
    state alert {
        block start {
            track main {
                lambda {
                    audio-gameplay-event(screamer, get-object-position(player), player);
                }
                lambda {
                    npc-make-aware-of(tag-symbol(alerted-npc, self), player, 2, 0);
                }
                lambda {
                    script-caption(player, "too much noise!", -1.00, 0, 0);
                }
                lambda {
                    wait(3.00);
                }
                lambda {
                    go(ready, 1);
                }
            }
        }
    }
}
