statescript {
    options {
        player
        sp-all
    }
    declarations {
        symbol meatshield-npc = #0000000000000000
    }
    state wait-for-meatshield {
        block update {
            track main {
                lambda {
                    if (player-in-state?(Melee) || player-in-state?(GrappleNpc) && 0 && player-in-meatshield-sequence?(1)) {
                        foreach (u16 var_5 : all-enemy-npcs) {
                            if (npc-in-meatshield?(var_5)) {
                                set-symbol(meatshield-npc, var_5, self);
                                go(alert-pair, 1);
                            }
                        }
                    }
                }
            }
        }
    }
    state alert-pair {
        block update {
            track main {
                lambda {
                    if (!player-in-meatshield-sequence?(1) && !npc-alive?(get-symbol(meatshield-npc, self))) {
                        go(wait-for-meatshield, 1);
                    }
                }
            }
        }
    }
}
