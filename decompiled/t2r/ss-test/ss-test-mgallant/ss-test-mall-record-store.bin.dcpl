statescript {
    options {
        player
        mal-col-return-upper-col
    }
    state wave-1 {
        block start {
            track main {
                lambda {
                    spawn-npc-group(mall-wave-1);
                }
            }
        }
        block event_npc-died {
            track main {
                lambda {
                    if (npc-group-alive-count(mall-wave-1) < 2) {
                        go(wave-2, 1);
                    }
                }
            }
        }
    }
    state wave-2 {
        block start {
            track main {
                lambda {
                    wait(4.00);
                }
                lambda {
                    spawn-npc-group(mall-wave-2);
                }
                lambda {
                    wait-frames(3);
                }
                lambda {
                    script-caption(get-closest-in-group(mall-wave-2, player, 0, 0, 1, 0), "Reinforcements!", 3.00, 0, 0);
                }
            }
        }
        block event_npc-died {
            track main {
                lambda {
                    if (npc-group-alive-count(all-enemy-npcs) == 0) {
                        go(combat-end, 1);
                    }
                }
            }
        }
    }
    state combat-end {
        block start {
            track main {
                lambda {
                    wait(4.00);
                }
                lambda {
                    request-dialog(player-callout-combat-end, player, 0, 0, 0, 0, 0);
                }
                lambda {
                    go(done, 1);
                }
            }
        }
    }
}
