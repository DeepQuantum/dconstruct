}

u64? npc-switch-to-melee?(i64 arg_0) {
    u64? var_2 = npc-group-alive-count(hybrid-npcs);
    return can-switch-states?(arg_0) || darray-count(hybrid-npcs-gun) > darray-count(hybrid-npcs-melee) && !(var_2 == 1) && get-closest-living-npc-in-group(hybrid-npcs, player, 0) == arg_0 && !(var_2 == 1) || get-closest-living-npc-in-group(hybrid-npcs-gun, player, 0) == arg_0 && distance-between-objects-less-than?(arg_0, player, 8.00);
}

u64? can-switch-states?(u64? arg_0) {
    return get-state-time(self) > 2.00 && deterministic-nth-frame?(30) && npc-alive?(arg_0);
}

