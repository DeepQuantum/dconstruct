                    } else if (get-state-time(self) > 4.00 && get-player-melee-target() != get-self-id() && var_0 > get-disengage-range(1.00) || npc-group-alive-count(all-proto-stalkers) > 1 && npc-get-archetype-id(self) != infected-stalker) {
                        start-timer(disengage-timer, random-float-min-max(6.00, 8.00, 0), self, 1);
                        var_2 = go(find-new-post, 1);
                    } else if (darray-count(stalkers-charging) == 1 && npc-get-archetype-id(self) == infected-stalker && !(timer-running?(dead-stalker-timer, self))) {
                        var_2 = none();
                    } else if (tag-boolean(disengage-on-hit, self) && timer-running?(attack-timer, self) || var_0 > tag-float(min-hit-disengage-range, self) && timer-running?(dead-stalker-timer, self) || get-state-time(self) > 10.00 || npc-offscreen?(get-self-id()) || player-in-state?(Prone) && get-player-melee-target() != get-self-id()) {
                        start-timer(disengage-timer, random-float-min-max(6.00, 8.00, 0), self, 1);
                        var_2 = go(find-new-post, 1);
                    }
                }
                lambda {
                    if (timer-running?(exit-charge-timer, self) && npc-get-awareness(self, player) == 2) {
                        stop-timer(exit-charge-timer, self);
                    }
                }
                lambda {
                    stalker-show-debug-state();
                }
            }
        }
        block event_exit-charge-timer {
            track main {
                lambda {
                    go(find-new-post, 1);
                }
            }
        }
        block event_player-attacked {
            track main {
                lambda {
                    if (event-attack-source?(get-self-id())) {
                        start-timer(attack-timer, 10.00, self, 1);
                        set-float(last-charge, get-current-time(0), self);
                    }
                }
            }
        }
        block event_force-disengage {
            track main {
                lambda {
                    go(find-new-post, 1);
                }
            }
        }
        block event_npc-died {
            track main {
                lambda {
                    if (event-arg-symbol(0) == get-self-id()) {
                        go(dead, 1);
                    }
                }
            }
        }
        block end {
            track main {
                lambda {
                    if (npc-alive?(self)) {
                        set-overlay-set(self, anim-overlay-infected-stalker-level-no-change);
                    }
                }
                lambda {
                    darray-find-remove(stalkers-charging, boxed_symbol(get-self-id()), 0);
                }
            }
        }
    }
    state charge-buddy {
        block start {
            track main {
                lambda {
                    stalker-assign-group(get-self-id(), stalkers-vs-buddy);
                }
                lambda {
                    npc-set-targeting-params(self, always-target-buddies);
                }
                lambda {
                    npc-set-script-low-priority(self);
                }
                lambda {
                    npc-clear-request-movement(self);
                }
                lambda {
                    npc-clear-look-at(self);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (npc-get-limb-state(self) == 1) {
                        go(legless, 1);
                    } else if (npc-is-on-fire?(self)) {
                        go(find-post, 1);
                    } else if (characters-in-melee?(self, npc-get-target(self), 1) && get-current-melee-action-name(self) == infected-runner-grab-struggle) {
                        none();
                    } else if (npc-target-lost?(self, player)) {
                        go(find-new-post, 1);
                    } else if (get-state-time(self) > 15.00) {
                        start-timer(disengage-timer, 1.00, self, 1);
                        go(find-new-post, 1);
                    } else if (player-in-overwhelm-region?()) {
                        start-timer(disengage-timer, 1.00, self, 1);
                        go(find-new-post, 1);
                    } else if (darray-count(stalkers-charging) == 0) {
                        start-timer(disengage-timer, 1.00, self, 1);
                        go(find-new-post, 1);
                    } else if (deterministic-nth-frame?(darray-count(all-proto-stalkers)) && darray-count(stalkers-charging) < tag-int32(max-charge-player, self) && get-self-id() == get-closest-object-in-group(all-proto-stalkers, player, stalkers-charging)) {
                        start-timer(disengage-timer, 1.00, self, 1);
                        go(find-new-post, 1);
                    } else if (deterministic-nth-frame?(darray-count(all-proto-stalkers)) && darray-count(stalkers-vs-buddy) > darray-count(all-buddy-npcs) && get-self-id() == get-closest-object-in-group(stalkers-vs-buddy, player, 0)) {
                        start-timer(disengage-timer, 1.00, self, 1);
                        go(find-new-post, 1);
                    }
                }
                lambda {
                    stalker-show-debug-state();
                }
            }
        }
        block event_Attack {
            track main {
                lambda {
                    if (npc-alive?(self) && event-attack-source?(player)) {
                        go(charge-player, 1);
                    }
                }
            }
        }
        block event_npc-died {
            track main {
                lambda {
                    if (event-arg-symbol(0) == get-self-id()) {
                        go(dead, 1);
                    }
                }
            }
        }
        block event_force-disengage {
            track main {
                lambda {
                    go(find-new-post, 1);
                }
            }
        }
        block end {
            track main {
                lambda {
                    if (npc-alive?(self)) {
                        npc-set-targeting-params(self, always-target-player);
                        darray-find-remove(stalkers-vs-buddy, boxed_symbol(get-self-id()), 0);
                    }
                }
            }
        }
    }
    state legless {
        block start {
            track main {
                lambda {
                    stalker-assign-group(get-self-id(), 0);
                }
                lambda {
                    darray-find-remove(all-proto-stalkers, boxed_symbol(get-self-id()), 0);
                }
                lambda {
                    npc-set-script-low-priority(self);
                }
                lambda {
                    npc-clear-request-movement(self);
                }
                lambda {
                    npc-clear-look-at(self);
                }
            }
        }
        block update {
            track main {
                lambda {
                    stalker-show-debug-state();
                }
            }
        }
        block event_npc-died {
            track main {
                lambda {
                    if (event-arg-symbol(0) == get-self-id()) {
                        go(dead, 1);
                    }
                }
            }
        }
    }
    state on-fire {
        block start {
            track main {
                lambda {
                    u64? var_1 = ai-get-post(get-int32(post-id, self));
                    sid var_7;
                    if (is-point-on-nav-mesh?(get-locator-position(get-animation-entry(get-self-id(), stlkr-hr-put-out-fire-vault-cover, ai-post-get-locator(var_1), 0, 0.00, apReference)), 2.00, 5.00, 0)) {
                        var_7 = stlkr-hr-put-out-fire-vault-cover;
                    } else {
                        var_7 = stlkr-hr-put-out-fire-around-cover;
                    }
                    set-bound-frame(fire-ap-ref, ai-post-get-locator(var_1), self);
                    set-symbol(fire-anim, var_7, self);
                }
                lambda {
                    debug-draw-locator(get-bound-frame(fire-ap-ref, self), 0.30, 10.00, 1, 2.00, 0);
                }
                lambda {
                    print-symbol(get-symbol(fire-anim, self), self);
                }
                lambda {
                    wait-npc-move-to(
                        get-self-id(),
                        get-animation-entry(get-self-id(), get-symbol(fire-anim, self), get-bound-frame(fire-ap-ref, self), 0, 0.00, apReference),
                        2,
                        2,
                        fire,
                        0,
                        0,
                        0
                    );
                }
                lambda {
                    u64? var_2 = #%alloc-array(single-frame, 16, 1, 1);
                    *(i32 *)*(*var_2 + (0 * 8)) = 10;
                    *(u64 *)(*(*var_2 + (0 * 8)) + 8) = 0;
                    *(u64 *)(*(*var_2 + (0 * 8)) + 8) = get-bound-frame(fire-ap-ref, self);
                    wait-animate_(get-self-id(), get-symbol(fire-anim, self), var_2);
                }
                lambda {
                    npc-put-out-fire(get-self-id());
                }
                lambda {
                    go(find-post, 1);
                }
            }
        }
    }
    state dead {
        block start {
            track main {
                lambda {
                    darray-find-remove(stalkers-moving, boxed_symbol(get-self-id()), 0);
                }
                lambda {
                    darray-find-remove(stalkers-charging, boxed_symbol(get-self-id()), 0);
                }
                lambda {
                    darray-find-remove(stalkers-vs-buddy, boxed_symbol(get-self-id()), 0);
                }
                lambda {
                    darray-find-remove(all-proto-stalkers, boxed_symbol(get-self-id()), 0);
                }
            }
        }
    }
}
