            }
        }
        block event player-upgrade-enabled {
            track main {
                lambda {
                    upgrade-stun-to-smoke-bomb();
                }
            }
        }
        block event player-upgrade-removed {
            track main {
                lambda {
                    downgrade-smoke-to-stun-bomb();
                }
            }
        }
    }
    state abby-upgrades {
        block start {
            track main {
                lambda {
                    while (!player-upgrade-system-initialized?()) {
                        wait-one-frame();
                    }
                }
                lambda {
                    initialize-task-preset-upgrades();
                }
            }
        }
    }
    state  {
    }
    state --all-- {
        block event player-upgrade-enabled {
            track main {
                lambda {
                    wait-one-frame();
                }
                lambda {
                    hud2-mark-health-ammo-dirty(0);
                }
