statescript {
    options {
        player
        sp-all
    }
    declarations {
    }
    state follow {
        block start {
            track main {
                lambda {
                    while (!npc-alive?(tag-symbol(follow-npc, self))) {
                        wait-one-frame();
                    }
                }
                lambda {
                    npc-request-explore(self, tag-symbol(follow-npc, self), 0, *buddy-post-selector-set*, 12.00, 0, *default-ai-explore-follow-settings*, 0);
                }
            }
        }
    }
}
