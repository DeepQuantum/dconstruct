bool player-in-activate-radius?() {
    return get-locator-distance(get-object-locator(player), get-spawner-locator(tag-symbol(interact, self), 1)) < interactable-get-activation-radius(tag-symbol(interact, self));
}

u64? can-play-triangle-sound?() {
    return is-traversal-audio-cues?() || player-in-state?(Script) || player-in-state?(ScriptMove) || player-in-state?(Death) && !0 && object-spawned?(tag-symbol(interact, self)) && interactable-enabled?(tag-symbol(interact, self)) || !get-boolean(is-door, self) && !is-door-open?(tag-symbol(interact, self));
}

