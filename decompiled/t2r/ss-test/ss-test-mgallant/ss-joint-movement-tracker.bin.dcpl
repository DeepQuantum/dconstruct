u64? get-tracked-joint-loc() {
    return get-joint-locator(player, tag-symbol(joint-to-track, self));
}

statescript {
    options {
        player
    }
    declarations {
        bound-frame prev-frame-joint = nullptr
    }
    state print {
        block start {
            track main {
                lambda {
                    set-bound-frame(prev-frame-joint, get-tracked-joint-loc(), self);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (get-object-anim(player, 1) == tag-symbol(anim-to-track, self)) {
                        print-float(get-locator-distance(get-tracked-joint-loc(), get-bound-frame(prev-frame-joint, self)), self);
                    }
                }
                lambda {
                    set-bound-frame(prev-frame-joint, get-tracked-joint-loc(), self);
                }
            }
        }
    }
}
