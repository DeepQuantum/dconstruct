statescript {
    options {
        player
        sp-all
    }
    declarations {
    }
    state wait-for-pickup {
        block update {
            track main {
                lambda {
                    if (get-player-health() >= (i32)get-object-max-health(player)) {
                        interactable-disable(self);
                    } else {
                        interactable-enable(self);
                    }
                }
                lambda {
                    if (get-player-health() < (i32)get-object-max-health(player) && distance-between-objects-less-than?(player, self, 3.00)) {
                        gui2-show-attachable-widget/f(canvas.hudRoot, "hud-interactable/pickup-energy-bar-hack", self, 0, alloc-vector(0.00, 0.15, 0.00, 1.00, 0), -1, 0.00, 0);
                    }
                }
            }
        }
        block event_player-requested-interact {
            track main {
                lambda {
                    if (get-self-id() == event-arg-symbol(0)) {
                        go(pickup, 1);
                    }
                }
            }
        }
    }
    state pickup {
        block start {
            track main {
                lambda {
                    interactable-disable(self);
                }
                lambda {
                    play-sound-at-position(sfx-weapon-pistol-basic-ammo-pickup, get-object-position(self), 0, 0);
                }
                lambda {
                    i32 var_3;
                    if ((get-player-health() + tag-int32(health-amount, self)) < (i32)get-object-max-health(player)) {
                        var_3 = get-player-health() + tag-int32(health-amount, self);
                    } else {
                        var_3 = (i32)get-object-max-health(player);
                    }
                    set-player-health(var_3);
                }
                lambda {
                    kill-entity(self);
                }
            }
        }
    }
}
