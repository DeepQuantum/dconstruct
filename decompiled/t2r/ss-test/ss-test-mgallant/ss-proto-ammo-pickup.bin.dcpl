statescript {
    options {
        player
        sp-all
    }
    declarations {
        symbol weapon-name = pistol-basic
        i32 ammo-count = 1
    }
    state active {
        block event_player-requested-interact {
            track main {
                lambda {
                    if (get-self-id() == event-arg-symbol(0)) {
                        go(pickup, 1);
                    }
                }
            }
        }
    }
    state pickup {
        block start {
            track main {
                lambda {
                    play-sound-at-position(sfx-weapon-pistol-basic-ammo-pickup, get-object-position(self), 0, 0);
                }
                lambda {
                    if (player-has-weapon?(get-symbol(weapon-name, self))) {
                        debug-draw-string(
                            get-object-position(self),
                            dc:format("+%d ammo", get-int32(ammo-count, self)),
                            7,
                            1.50,
                            1,
                            1.50,
                            1,
                            0
                        );
                        give-player-weapon(get-symbol(weapon-name, self), get-int32(ammo-count, self), 0);
                    } else {
                        debug-draw-string(
                            get-object-position(self),
                            dc:format("%s", string-debug(get-symbol(weapon-name, self))),
                            7,
                            1.50,
                            1,
                            1.50,
                            1,
                            0
                        );
                        inventory-item-add-quantity(pistol-basic, 1);
                    }
                }
                lambda {
                    kill-entity(self);
                }
            }
        }
    }
}
