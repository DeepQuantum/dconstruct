        var_5 = 0.50;
    }
    return parent-bound-frame(rotate-locator-lookat(
        offset-locator(get-joint-locator(tag-symbol(horse, self), saddle_seat), alloc-vector(0.00, -0.60, 0.00, 1.00, 0)),
        get-object-locator(player),
        var_5,
        0
