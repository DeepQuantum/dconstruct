}

u64? npc-can-shoot-player?() {
    return get-int32(raycast, self) >= 0 && wait-raycast-hit-nothing?(get-int32(raycast, self)) && get-vulnerability(player) != 18 && !object-anim-playing?(player, ellie-crouch^hr-arrow-fw, 0) && !object-anim-playing?(player, idle-hr-fw, 0) && facing-point?(get-object-locator(npc-get-weapon-process-id(self)), get-joint-locator(player, pelvis), 90.00);
}

sid get-rider-aim-gesture() {
    return match (get-weapon-anim-type(self)) {
        2    -> npc-m-rifle-aggr-idle-aim-gesture,
