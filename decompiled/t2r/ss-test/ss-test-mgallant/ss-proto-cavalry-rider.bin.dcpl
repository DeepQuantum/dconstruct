sid get-rider-aim-anim() {
    return match (get-weapon-anim-type(self)) {
        2    -> npc-m-lg-tilt-mm-aggr-idle,
        8   , 1    -> npc-m-p-mm-aggr-idle,
        else -> npc-m-p-mm-aggr-idle
    };
}

