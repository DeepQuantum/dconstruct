statescript {
    options {
        player
    }
    declarations {
    }
    state wait-for-death {
        block event_npc-died {
            track main {
                lambda {
                    if (get-self-id() == event-arg-symbol(0)) {
                        go(revive, 1);
                    }
                }
            }
        }
    }
    state revive {
        block start {
            track main {
                lambda {
                    wait(tag-float(respawn-delay, self));
                }
                lambda {
                    spawn-entity(get-self-id(), 0, 0);
                }
                lambda {
                    kill-entity(get-self-id());
                }
            }
        }
    }
}
