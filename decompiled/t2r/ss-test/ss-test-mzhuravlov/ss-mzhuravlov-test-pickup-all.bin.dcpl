                        set-symbol(cur_pickup, event-arg-symbol(0), self);
                        if (item-pickup-get-item-id(get-symbol(cur_pickup, self)) != ammo-arrow) {
                            inventory-item-consume(item-pickup-get-item-id(get-symbol(cur_pickup, self)), get-inventory-item-quantity(item-pickup-get-item-id(get-symbol(cur_pickup, self))));
                        }
                        if (get-inventory-item-quantity(ammo-arrow) > 3) {
                            inventory-item-consume(ammo-arrow, 4);
                        }
                        darray-append(get-symbol(picked-up-items-array, self), boxed_symbol(get-symbol(cur_pickup, self)), 0);
                        darray-append(get-symbol(picked-up-id-array, self), boxed_symbol(item-pickup-get-item-id(get-symbol(cur_pickup, self))), 0);
                        start-timer-if-not-running(cooldown, get-float(pickup-respawn-timer, self), self);
                        debug-draw-string-2d(
                            alloc-point(600.00, 610.00, -4.00, 0),
                            dc:format("ID :   %s", string-debug(item-pickup-get-item-id(get-symbol(cur_pickup, self)))),
                            3,
                            2.50,
                            0.80,
                            0,
                            0,
                            0,
                            1.00
                        );
                        debug-draw-string-2d(
                            alloc-point(600.00, 630.00, -4.00, 0),
                            dc:format("ART:   %s", string-debug(get-art-group(get-symbol(cur_pickup, self)))),
                            3,
                            2.50,
                            0.80,
                            0,
                            0,
                            0,
                            1.00
                        );
                        if (get-boolean(use-move-to, self)) {
                            go(go-to-pickup-test, 1);
                        }
                    }
                }
            }
        }
    }
    state go-to-pickup-test {
        block start {
            track main {
                lambda {
                    if (get-joypad-stick-intensity(move, 0.20, 1.00) > 0.10) {
                        go(main, 1);
                    }
                }
                lambda {
                    set-bound-frame(path-goal, alloc-bound-frame(
                        alloc-point(
                            *(f32 *)get-joint-position(get-symbol(cur_pickup, self), root),
                            *(f32 *)(get-object-position(player) + 4),
                            *(f32 *)(get-joint-position(get-symbol(cur_pickup, self), root) + 8),
                            0
                        ),
                        alloc-quat(0.00, 0.00, 0.00, 1.00, 0),
                        0,
                        0,
                        0
                    ), self);
                }
                lambda {
                    set-bound-frame(path-goal, rotate-locator-lookat-object(get-bound-frame(path-goal, self), player, 1.00, 0), self);
                }
                lambda {
                    set-bound-frame(path-goal, offset-locator(get-bound-frame(path-goal, self), alloc-vector(0.00, 0.00, 0.70, 1.00, 0)), self);
                }
                lambda {
                    set-bound-frame(path-goal, set-locator-rotation(get-bound-frame(path-goal, self), get-object-rotation(player)), self);
                }
                lambda {
                    player-scripted-move-new(get-bound-frame(path-goal, self), 1, *ellie-move-to-scripted-fast-small-step-relaxed*, 7, 0, 0);
                }
                lambda {
                    debug-draw-locator(get-bound-frame(path-goal, self), 0.50, 2.00, 1, 2.00, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (distance-between-locators-xz(get-object-locator(player), get-bound-frame(path-goal, self)) <= 0.20) {
                        go(main, 1);
                    }
                }
                lambda {
                    if (get-joypad-stick-intensity(move, 0.20, 1.00) > 0.10) {
                        player-scripted-move-new(get-object-locator(player), 0, 0, 7, 0, 0);
                        go(main, 1);
                    }
                }
            }
        }
    }
}
