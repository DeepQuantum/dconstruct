statescript {
    options {
        player
    }
    declarations {
        f32 console-y-start = 0.00
        bool draw-help? = nullptr
        i32 i = 1
        f32 frame-count = 0.00
        bool carry-plank? = nullptr
        bool pickup-plank? = nullptr
        bool in-region = nullptr
        f32 gesture-target-vec = 0.00
        f32 gesture-target-dist = 0.00
        f32 gesture-target-weight = 0.00
        bound-frame pickup-plank-goal-end = nullptr
        bound-frame pickup-plank-goal = nullptr
        bound-frame pickup-plank-ap = nullptr
        symbol anim-list = nullptr
        symbol apRefName = nullptr
        symbol pickup-anim = nullptr
        symbol pickup-anim-pair = nullptr
        f32 pickup-anim-pair-weight = 0.00
        bool pickup-anim-is-horizontal? = nullptr
        bool pickup-anim-is-mirrored? = nullptr
    }
    state initial {
        block start {
            track main {
                lambda {
                    kill-entity(plank-pickup-1);
                }
                lambda {
                    enable-entity-respawn(plank-pickup-1);
                }
                lambda {
                    spawn-entity(plank-pickup-1, 0, 0);
                }
                lambda {
                    set-float(frame-count, 0.00, self);
                }
                lambda {
                    set-spawner-locator(plank-pickup-1, get-object-locator(plank-default-locator-1));
                }
            }
        }
        block update {
            track main {
                lambda {
                    draw-help();
                }
                lambda {
                    set-tension-mode(1);
                }
                lambda {
                    joypad-disable-commands(listen-hold, listen-press, aim, aim-press, aim-hold-long, aim-hold);
