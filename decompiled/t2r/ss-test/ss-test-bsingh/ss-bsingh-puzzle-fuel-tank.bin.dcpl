statescript {
    options {
        player
    }
    declarations {
    }
    state idle {
        block start {
            track main {
                lambda {
                    interactable-disable(tag-symbol(interactable, self));
                }
                lambda {
                    disable-collision(tag-symbol(interactable, self), 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (interactable-enabled?(tag-symbol(interactable, self)) || !player-in-state?(Move) || fact-symbol(player, player-interactable, 0, 0) == 0 || !get-boolean(fuel-source, fact-symbol(player, player-interactable, 0, 0)) && get-boolean(fueled, tag-symbol(target-object, self))) {
                        interactable-disable(tag-symbol(interactable, self));
                    }
                }
                lambda {
                    if (!interactable-enabled?(tag-symbol(interactable, self)) && player-in-state?(Move) && fact-symbol(player, player-interactable, 0, 0) != 0 && get-boolean(fuel-source, fact-symbol(player, player-interactable, 0, 0)) && !get-boolean(fueled, tag-symbol(target-object, self))) {
                        interactable-enable(tag-symbol(interactable, self));
                    }
                }
            }
        }
        block event_player-requested-interact {
            track main {
                lambda {
                    if (event-arg-symbol(0) == tag-symbol(interactable, self)) {
                        go(add-fuel, 1);
                    }
                }
            }
        }
    }
    state add-fuel {
        block start {
            track main {
                lambda {
                    wait-one-frame();
                }
                lambda {
                    interactable-disable(tag-symbol(interactable, self));
                }
                lambda {
                    debug-draw-string(
                        get-object-position(tag-symbol(interactable, self)),
                        "FUEL ADDED",
                        1,
                        2.00,
                        1,
                        1.50,
                        1,
                        0
                    );
                }
                lambda {
                    set-boolean(fueled, 1, tag-symbol(target-object, self));
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    go(idle, 1);
                }
            }
        }
    }
