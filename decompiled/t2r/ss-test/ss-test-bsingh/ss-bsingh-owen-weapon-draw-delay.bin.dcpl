statescript {
    options {
        player
    }
    declarations {
        f32 WEAPON-DRAW-INPUT-DELAY = 0.30
        bool weapon-fire-queued = nullptr
    }
    state weapon-down {
        block update {
            track main {
                lambda {
                    if (player-in-state?(GunMove)) {
                        go(raising-weapon, 1);
                    }
                }
            }
        }
    }
    state raising-weapon {
        block start {
            track main {
                lambda {
                    set-boolean(weapon-fire-queued, 0, self);
                }
                lambda {
                    wait(get-float(WEAPON-DRAW-INPUT-DELAY, self));
                }
                lambda {
                    go(weapon-up, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (!player-in-state?(GunMove)) {
                        go(weapon-down, 1);
                    }
                }
                lambda {
                    if (joypad-command-active?(fire-press, 6)) {
                        set-boolean(weapon-fire-queued, 1, self);
                    }
                }
                lambda {
                    joypad-disable-commands(fire-press);
                }
            }
        }
    }
    state weapon-up {
        block start {
            track main {
                lambda {
                    if (get-boolean(weapon-fire-queued, self)) {
                        player-fire-weapon-at-reticle();
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (!player-in-state?(GunMove)) {
                        go(weapon-down, 1);
                    }
                }
            }
        }
    }
}
