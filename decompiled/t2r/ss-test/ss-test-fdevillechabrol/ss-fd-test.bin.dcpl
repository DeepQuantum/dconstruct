            1.00
        );
        debug-draw-string-2d(
            alloc-point(170.00, 260.00, 0.00, 0),
            "down : previous page",
            7,
            0.00,
            0.60,
            0,
            0,
            0,
            1.00
        );
    }
    u16 var_3;
    if (arg_0 == 2) {
        debug-draw-string-2d(
            alloc-point(170.00, 250.00, 0.00, 0),
            "x   : play dialogue",
