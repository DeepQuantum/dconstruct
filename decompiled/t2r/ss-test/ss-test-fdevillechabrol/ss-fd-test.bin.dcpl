            0.00,
            0.60,
            0,
            0,
            0,
            1.00
        );
        var_3 = debug-draw-string-2d(
            alloc-point(170.00, 260.00, 0.00, 0),
            "o   : back",
            7,
            0.00,
            0.60,
            0,
            0,
            0,
            1.00
        );
    } else {
        var_3 = 0;
    }
    return var_3;
}

