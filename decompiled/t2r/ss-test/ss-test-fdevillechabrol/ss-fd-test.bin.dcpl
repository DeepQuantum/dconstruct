u16 print-dialogues-list(u16 arg_0, u16 arg_1) {
    u64 i = 0;
    while (i < 50) {
        if (i == arg_0) {
            if (arg_1 == 1) {
                debug-draw-string-2d(
                    alloc-point(730.00, (f32)(20 + (i * 10)), 0.00, 0),
                    "=>",
                    7,
                    0.00,
                    0.60,
                    0,
                    0,
                    0,
                    1.00
                );
            }
        }
        debug-draw-string-2d(
            alloc-point(750.00, (f32)(20 + (i * 10)), 0.00, 0),
            dc:format("%s", get-dialogue(get-symbol(dialogueProcess, self), i)),
            7,
            0.00,
            0.60,
            0,
            0,
            0,
            1.00
        );
        i = i + 1;
    }
    return i;
}

u16 print-languages-list(u16 arg_0) {
    u64? var_0 = get-languages-count();
    debug-draw-string-2d(
        alloc-point(400.00, 20.00, 0.00, 0),
        dc:format("languages count: %d", var_0),
        7,
        0.00,
        0.60,
        0,
        0,
        0,
        1.00
    );
    for (u64 i = 0; i < var_0; i++) {
        if (i == arg_0) {
            debug-draw-string-2d(
                alloc-point(380.00, (f32)(30 + (i * 10)), 0.00, 0),
                "=>",
                7,
                0.00,
                0.60,
                0,
                0,
                0,
                1.00
            );
        }
        debug-draw-string-2d(
            alloc-point(400.00, (f32)(30 + (i * 10)), 0.00, 0),
            dc:format("%s", get-language-name(i)),
            7,
            0.00,
            0.60,
            0,
            0,
            0,
            1.00
        );
    }
    return i + 1;
}

u64? button-pressed?(u64? arg_0) {
    return debug-joypad-command-active?(arg_0, 0);
}

