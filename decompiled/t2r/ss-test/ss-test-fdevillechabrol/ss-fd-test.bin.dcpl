statescript {
    options {
        player
    }
    declarations {
        i32 currentLanguageIndex = nullptr
        i32 currentDialogueIndex = nullptr
        string rawJson = nullptr
        symbol dialogueProcess = nullptr
        i32 mode = nullptr
        i32 pageCount = nullptr
        i32 currentPage = nullptr
    }
    state init {
        block start {
            track main {
                lambda {
                    set-int32(currentLanguageIndex, 0, self);
                }
                lambda {
                    set-int32(currentDialogueIndex, 0, self);
                }
                lambda {
                    set-int32(mode, 0, self);
                }
                lambda {
                    set-symbol(dialogueProcess, spawn-object(
                        invisible-cube,
                        DialogueReviewer,
                        0,
                        0,
                        1,
                        0,
                        0,
                        0,
                        0
                    ), self);
                }
                lambda {
                    set-int32(pageCount, 0, self);
                }
                lambda {
                    set-int32(currentPage, 1, self);
                }
            }
        }
        block update {
            track main {
                lambda {
                    print-help(get-int32(mode, self));
                }
                lambda {
                    if (button-pressed?(debug-script-press-up)) {
                        if (get-int32(mode, self) == 0) {
                            set-int32(currentLanguageIndex, get-int32(currentLanguageIndex, self) - 1, self);
                        }
                        if (get-int32(mode, self) == 2) {
                            set-int32(currentDialogueIndex, get-int32(currentDialogueIndex, self) - 1, self);
                        }
                        if (get-int32(mode, self) == 1) {
                            set-int32(currentPage, get-int32(currentPage, self) + 1, self);
                        }
                    }
                }
                lambda {
                    if (button-pressed?(debug-script-press-left)) {
                        if (get-int32(mode, self) == 0) {
                            set-int32(currentLanguageIndex, get-int32(currentLanguageIndex, self) - 5, self);
                        }
                        if (get-int32(mode, self) == 2) {
                            set-int32(currentDialogueIndex, get-int32(currentDialogueIndex, self) - 5, self);
                        }
                        if (get-int32(mode, self) == 1) {
                            set-int32(currentPage, get-int32(currentPage, self) - 5, self);
                        }
                    }
                }
                lambda {
                    if (button-pressed?(debug-script-press-down)) {
                        if (get-int32(mode, self) == 0) {
                            set-int32(currentLanguageIndex, get-int32(currentLanguageIndex, self) + 1, self);
                        }
                        if (get-int32(mode, self) == 2) {
                            set-int32(currentDialogueIndex, get-int32(currentDialogueIndex, self) + 1, self);
                        }
                        if (get-int32(mode, self) == 1) {
                            set-int32(currentPage, get-int32(currentPage, self) - 1, self);
                        }
                    }
                }
                lambda {
                    if (button-pressed?(debug-script-press-right)) {
                        if (get-int32(mode, self) == 0) {
                            set-int32(currentLanguageIndex, get-int32(currentLanguageIndex, self) + 5, self);
                        }
                        if (get-int32(mode, self) == 2) {
                            set-int32(currentDialogueIndex, get-int32(currentDialogueIndex, self) + 5, self);
                        }
                        if (get-int32(mode, self) == 1) {
                            set-int32(currentPage, get-int32(currentPage, self) + 5, self);
                        }
                    }
                }
                lambda {
                    if (button-pressed?(debug-script-press-x)) {
                        if (get-int32(mode, self) == 2) {
                            play-dialogue(get-symbol(dialogueProcess, self), get-int32(currentDialogueIndex, self));
                        }
                        if (get-int32(mode, self) == 1) {
                            send-event(
                                refresh-dialogues-list,
                                get-symbol(dialogueProcess, self),
                                boxed_i32(get-int32(currentLanguageIndex, self)),
                                boxed_i32((get-int32(currentPage, self) - 1) * 50),
                                boxed_i32(50)
                            );
                            set-int32(mode, 2, self);
                        }
                        if (get-int32(mode, self) == 0) {
                            set-int32(pageCount, (get-dialogue-count(get-int32(currentLanguageIndex, self)) / 50) + 1, self);
                            set-active-language(get-int32(currentLanguageIndex, self));
                            set-int32(mode, 1, self);
                        }
                    }
                }
                lambda {
                    if (button-pressed?(debug-script-press-circle)) {
                        if (get-int32(mode, self) == 1) {
                            set-int32(mode, 0, self);
                        }
                        if (get-int32(mode, self) == 2) {
                            set-int32(mode, 1, self);
                        }
                    }
                }
                lambda {
                    print-languages-list(get-int32(currentLanguageIndex, self));
                }
                lambda {
                    if (get-int32(mode, self) == 1) {
                        print-pages(get-int32(pageCount, self), get-int32(currentPage, self), 1);
                    } else {
                        print-pages(get-int32(pageCount, self), get-int32(currentPage, self), 0);
                    }
                }
                lambda {
                    if (get-int32(mode, self) == 2) {
                        print-dialogues-list(get-int32(currentDialogueIndex, self), 1);
                    } else {
                        print-dialogues-list(get-int32(currentDialogueIndex, self), 0);
                    }
                }
            }
        }
    }
}
