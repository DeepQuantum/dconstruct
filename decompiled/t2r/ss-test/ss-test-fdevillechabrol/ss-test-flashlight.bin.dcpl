        0.60,
        0,
        0,
        0,
        1.00
    );
    debug-draw-string-2d(
        alloc-point(170.00, 260.00, 0.00, 0),
        "triangle : kill flashlight",
        7,
        0.00,
        0.60,
        0,
        0,
        0,
        1.00
    );
    debug-draw-string-2d(
        alloc-point(170.00, 270.00, 0.00, 0),
        "x        : turn on",
        7,
        0.00,
        0.60,
        0,
        0,
        0,
        1.00
    );
    debug-draw-string-2d(
        alloc-point(170.00, 280.00, 0.00, 0),
        "o        : turn off",
        7,
        0.00,
        0.60,
        0,
        0,
        0,
        1.00
    );
    debug-draw-string-2d(
        alloc-point(170.00, 290.00, 0.00, 0),
        "L2       : unholster",
        7,
        0.00,
        0.60,
        0,
        0,
        0,
        1.00
    );
    return debug-draw-string-2d(
        alloc-point(170.00, 300.00, 0.00, 0),
        "R2       : holster",
        7,
        0.00,
        0.60,
        0,
        0,
        0,
        1.00
    );
}

statescript {
    options {
        player
    }
    state init {
        block start {
            track main {
                lambda {
                    npc-unholster-weapon(npc, 0, -1.00, 0);
                }
            }
        }
        block update {
            track main {
                lambda {
                    print-help();
                }
                lambda {
                    if (button-pressed?(debug-script-press-x)) {
                        turn-on-flashlight(npc, 0);
                        turn-on-flashlight(manny, 0);
                    }
                }
                lambda {
                    if (button-pressed?(debug-script-press-circle)) {
                        turn-off-flashlight(npc, 0);
                        turn-off-flashlight(manny, 0);
                    }
                }
                lambda {
                    if (button-pressed?(debug-script-press-square)) {
                        send-event(spawn-flashlight, npc, boxed_symbol(*test-flashlight-on-weapon*));
                    }
                }
                lambda {
                    if (button-pressed?(debug-script-press-triangle)) {
                        kill-flashlight(npc);
                    }
                }
                lambda {
                    if (button-pressed?(debug-script-press-l2)) {
                        npc-unholster-weapon(npc, 0, -1.00, 0);
                    }
                }
                lambda {
                    if (button-pressed?(debug-script-press-r2)) {
                        npc-holster-weapon(npc, 0, 1, -1.00, 0);
                    }
                }
            }
        }
    }
}
