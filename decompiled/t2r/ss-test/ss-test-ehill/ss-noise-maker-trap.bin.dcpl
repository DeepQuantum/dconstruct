statescript {
    options {
        player
    }
    state wait-event {
        block event_Attack {
            track main {
                lambda {
                    go(activate, 1);
                }
            }
        }
    }
    state activate {
        block start {
            track main {
                lambda {
                    audio-gameplay-event(weapon-fire, get-object-position(self), self);
                }
                lambda {
                    script-caption(self, "DING!", -1.00, 0, 0);
                }
                lambda {
                    wait(2.00);
                }
                lambda {
                    go(wait-event, 1);
                }
            }
        }
    }
}
