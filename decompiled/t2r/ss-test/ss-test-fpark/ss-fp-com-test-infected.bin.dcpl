statescript {
    options {
        player
        fp-com-test-infected
        fp-com-test-infected-gameplay
    }
    state task-check {
        block start {
            track main {
                lambda {
                    if (task-active?(infected, combat-high-cover-infected)) {
                        go(spawn-enemies, 1);
                    }
                }
            }
        }
    }
    state spawn-enemies {
        block start {
            track main {
                lambda {
                    spawn-npc-group(fp-test-infected-npcs);
                }
            }
        }
        block event_npc-died {
            track main {
                lambda {
                    if (npc-group-alive-count(fp-test-infected-npcs) == 0) {
                        go(combat-end, 1);
                    }
                }
            }
        }
    }
    state combat-end {
        block start {
            track main {
                lambda {
                    wait(3.00);
                }
                lambda {
                    request-dialog(player-callout-combat-end, player, 0, 0, 0, 0, 0);
                }
            }
        }
    }
}
