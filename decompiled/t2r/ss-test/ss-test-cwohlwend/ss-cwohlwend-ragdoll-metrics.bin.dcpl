statescript {
    options {
        player
    }
    declarations {
        bool r3-pressed = nullptr
        bound-frame teleport-locator = nullptr
        timer debug-draw-box = nullptr
    }
    state initial {
        block start {
            track main {
                lambda {
                    start-timer(debug-draw-box, 5.00, self, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    set-bound-frame(teleport-locator, rotate-locator-angle(offset-locator(get-player-locator-in-camera-dir(), alloc-vector(0.00, 0.00, 2.00, 1.00, 0)), 1, 180.00), self);
                }
                lambda {
                    debug-draw-locator(get-bound-frame(teleport-locator, self), 0.30, 0.00, 0, 2.00, 0);
                }
                lambda {
                    if (get-timer-value(debug-draw-box, self) > 0.00) {
                        debug-draw-text-box-2D(
                            "Click r3 to teleport brute to locator",
                            60,
                            850.00,
                            500.00,
                            0.50,
                            1,
                            0,
                            1,
                            0.00
                        );
                    }
                }
                lambda {
                    if (joypad-command-active?(debug-script-press-r3, 6)) {
                        set-boolean(r3-pressed, 1, self);
                    }
                }
                lambda {
                    if (joypad-command-active?(debug-script-release-r3, 6) && get-boolean(r3-pressed, self)) {
                        set-boolean(r3-pressed, 0, self);
                        npc-teleport-to(npc-ragdoll-brute-1, get-bound-frame(teleport-locator, self));
                    }
                }
            }
        }
    }
}
