statescript {
    options {
        player
    }
    declarations {
        symbol superheavy-weapon-id = nullptr
    }
    state wait-superheavy-equip {
        block update {
            track main {
                lambda {
                    if (player-2h-superheavy?()) {
                        go(superheavy-equipped, 1);
                    }
                }
            }
        }
    }
    state superheavy-equipped {
        block start {
            track main {
                lambda {
                    set-symbol(superheavy-weapon-id, get-player-weapon-id(), self);
                }
            }
        }
        block update {
            track main {
                lambda {
                    set-move-mode(superheavy-walk);
                }
                lambda {
                    set-sprint-type(superheavy-run);
                }
                lambda {
                    disable-player-melee-moveset();
                }
                lambda {
                    if (player-upgrade-active?(more-stamina)) {
                        player-set-sprint-settings-combat(*player-upgraded-superheavy-sprint-settings*);
                        player-set-sprint-settings-relaxed(*player-upgraded-superheavy-sprint-settings*);
                    } else {
                        player-set-sprint-settings-combat(*player-superheavy-sprint-settings*);
                        player-set-sprint-settings-relaxed(*player-superheavy-sprint-settings*);
                    }
                }
                lambda {
                    if (player-in-state?(Jump) && player-in-state?(Ladder)) {
                        player-drop-weapon(get-player-weapon-id());
                    }
                }
                lambda {
                    if (!(player-2h-superheavy?())) {
                        go(wait-superheavy-equip, 1);
                    }
                }
            }
        }
        block end {
            track main {
                lambda {
                    player-drop-weapon(get-symbol(superheavy-weapon-id, self));
                }
            }
        }
    }
