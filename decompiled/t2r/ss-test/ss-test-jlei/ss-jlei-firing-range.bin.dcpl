    state run {
        block start {
            track main {
                lambda {
                    if (npc-alive?(self)) {
                        wait-npc-move-to(self, get-spawner-locator(pos-2, 1), 1, 0, 0, 0, 0, 0);
                        wait(0.20);
                    }
                    if (npc-alive?(self)) {
                        wait-npc-move-to(self, get-spawner-locator(pos-1, 1), 1, 0, 0, 0, 0, 0);
                        wait(0.20);
                    }
                    wait-one-frame();
                    if (!get-boolean(do-run-behavior, self)) {
                        go(initial, 1);
                    }
                    while (1) {
                        if (npc-alive?(self)) {
                            wait-npc-move-to(self, get-spawner-locator(pos-2, 1), 1, 0, 0, 0, 0, 0);
                            wait(0.20);
                        }
                        if (npc-alive?(self)) {
                            wait-npc-move-to(self, get-spawner-locator(pos-1, 1), 1, 0, 0, 0, 0, 0);
                            wait(0.20);
                        }
                        wait-one-frame();
                        if (!get-boolean(do-run-behavior, self)) {
                            go(initial, 1);
                        }
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (!get-boolean(do-run-behavior, self)) {
                        go(initial, 1);
                    }
                }
            }
        }
        block event_update-run-behavior {
            track main {
                lambda {
                    set-boolean(do-run-behavior, event-arg-boolean(0), self);
                }
            }
        }
    }
}
