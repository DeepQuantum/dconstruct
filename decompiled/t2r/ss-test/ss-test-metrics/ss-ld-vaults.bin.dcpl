                    wait-stub-object-lerp-locator(obj-vaults-1, get-spawner-locator(obj-vaults-1, 1), 2.00, 2, 1.00);
                }
                lambda {
                    go(check-button-interacts, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    u64? var_4 = rotate-locator-lookat(
                        get-spawner-locator(get-symbol(player-spawner, self), 1),
                        get-spawner-locator(get-symbol(edge-spawner, self), 1),
                        1.00,
                        0
                    );
                    if (get-boolean(moving?, self)) {
                        player-force-move-stick-dir(get-z-vec-from-bound-frame(var_4));
                    }
                    camera-look-at-dir(rotate-locator-angle(var_4, 0, 10.00), 5.00, 5.00);
                }
                lambda {
                    if (get-boolean(sprinting?, self)) {
                        joypad-force-command(sprint-hold);
                    }
                }
                lambda {
                    debug-draw-locator(offset-locator-world-space(get-object-locator(player), vector-scale(0.20, get-object-linear-velocity(player))), 0.15, 0.00, 0, 2.00, 0);
                }
                lambda {
                    if (!spawner-within-distance-to-object-xz?(get-symbol(player-spawner, self), player, 0.50, 1) && joypad-command-active?(debug-script-press-circle, 6)) {
                        go(check-button-interacts, 1);
                    }
                }
            }
        }
    }
}
