u64? draw-radio-option(u64? arg_0, u64? arg_1, u64? arg_2, u64? arg_3, u64? arg_4) {
    if (!string-eq?(arg_3, "")) {
        debug-draw-string-2d(
            alloc-point(640.00 + arg_2, 340.00 + arg_4, 0.00, 0),
            arg_3,
            1,
            0.00,
            get-float(size, ss-ae-proto-conversation-system),
            1,
            0,
            0,
            1.00
        );
    }
    return debug-draw-string-2d(
        alloc-point(640.00 + arg_2, 360.00 + arg_4, 0.00, 0),
        arg_0,
        arg_1,
        0.00,
        get-float(size, ss-ae-proto-conversation-system),
        1,
        0,
        0,
        1.00
    );
}

statescript {
    options {
        player
        sp-all
    }
    declarations {
        string branch = null
        bool radio-prompt = nullptr
        string radio-option-1 = null
        string radio-option-2 = null
        string radio-option-3 = null
        f32 size = 1.00
        f32 left-offset = -450.00
        f32 right-offset = -120.00
        f32 centre-offset = -270.00
        f32 centre-y-offset = -100.00
        bool active-conversation = nullptr
        bool radio = true
    }
    state hud {
        block update {
            track main {
                lambda {
                    if (get-boolean(active-conversation, self)) {
                        joypad-disable-commands(menu-up, menu-down, menu-right, menu-left);
                    }
                }
                lambda {
                    if (joypad-command-active?(radio-down, 6) && get-boolean(radio, self)) {
                        set-boolean(active-conversation, 0, self);
                        end-radio-conversation();
                    }
                }
                lambda {
                    if (!(get-boolean(radio-prompt, self) == 0)) {
                        draw-radio-option(wrap-string("press D-Pad Up to use radio", 35), 1, get-float(centre-offset, self), "", 0.00);
                    }
                }
                lambda {
                    if (get-boolean(active-conversation, self) && get-boolean(radio, self)) {
                        draw-radio-option(
                            wrap-string("Put Radio Away", 35),
                            3,
                            get-float(centre-offset, self),
                            "[D-Pad Down] ",
                            get-float(centre-y-offset, self) + 200.00
                        );
                    }
                }
                lambda {
                    if (!string-eq?(get-string(radio-option-1, self), "null")) {
                        draw-radio-option(
                            wrap-string(get-string(radio-option-1, self), 35),
                            7,
                            get-float(left-offset, self),
                            "[D-Pad Left] ",
                            0.00
                        );
                    }
                }
                lambda {
                    if (!string-eq?(get-string(radio-option-2, self), "null")) {
                        draw-radio-option(
                            wrap-string(get-string(radio-option-2, self), 35),
                            9,
                            get-float(centre-offset, self),
                            "[D-Pad Up] ",
                            get-float(centre-y-offset, self)
                        );
                    }
                }
                lambda {
                    if (!string-eq?(get-string(radio-option-3, self), "null")) {
                        draw-radio-option(
                            wrap-string(get-string(radio-option-3, self), 35),
                            2,
                            get-float(right-offset, self),
                            "[D-Pad Right] ",
                            0.00
                        );
                    }
                }
            }
        }
    }
