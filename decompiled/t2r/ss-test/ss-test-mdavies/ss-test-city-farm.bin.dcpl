        despawn-offscreen-npcs-in-group(darray-count(middle-area-group), all-enemy-npcs, 100.00);
        wait-spawn-npc-group-async(middle-area-group, 0, 0);
        foreach (u16 var_4 : middle-area-group) {
            if (npc-alive?(var_4)) {
                npc-set-zone-region-if-alive(var_4, rgn-zone-mid-1);
            }
        }
        npc-set-zone-region-if-alive(npc-424, rgn-zone-mid-large-1);
        npc-set-zone-region-if-alive(npc-425, rgn-zone-mid-large-1);
    }
    return set-boolean(spawned-mid-group?, 1, self);
}

