}

u64? spawn-lower-group() {
    wait-spawn-npc-group-async(lower-parking-lot-group, 0, 0);
    foreach (u16 var_2 : lower-parking-lot-group) {
        if (npc-alive?(var_2)) {
            if (npc-get-weapon(var_2) != shotgun-basic) {
