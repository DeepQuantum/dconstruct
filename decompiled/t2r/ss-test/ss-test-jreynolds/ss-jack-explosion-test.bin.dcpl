statescript {
    options {
        player
    }
    state start {
        block update {
            track main {
                lambda {
                    debug-draw-locator(get-joint-locator(player, spinec), 0.30, 0.00, 0, 2.00, 0);
                }
                lambda {
                    if (joypad-command-active?(flashlight-toggle, 6)) {
                        go(explode, 1);
                    }
                }
            }
        }
    }
    state explode {
        block start {
            track main {
                lambda {
                    spawn-explosion(
                        get-joint-position(player, spinec),
                        *impact-debris-explosion*,
                        0,
                        0,
                        -1.00,
                        0,
                        0,
                        0.00,
                        0
                    );
                }
                lambda {
                    get-y-vec-from-bound-frame(get-joint-locator(player, spinec));
                }
                lambda {
                    wait(2.00);
                }
                lambda {
                    go(start, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    debug-draw-locator(get-joint-locator(player, spinec), 0.30, 0.00, 0, 2.00, 0);
                }
            }
        }
    }
