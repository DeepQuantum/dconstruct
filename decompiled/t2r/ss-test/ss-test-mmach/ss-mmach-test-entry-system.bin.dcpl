        block event_change-weapon-hold {
            track main {
                lambda {
                    if (entity-exists?(get-symbol(active-npc, self))) {
                        if (get-boolean(weapon-up?, self)) {
                            npc-weapon-down(get-symbol(active-npc, self));
                            set-boolean(weapon-up?, 0, self);
                        } else {
                            npc-weapon-up(get-symbol(active-npc, self));
                            set-boolean(weapon-up?, 1, self);
                        }
                    } else {
                        debug-draw-text-box-2D(
