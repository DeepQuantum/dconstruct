statescript {
    options {
        player
    }
    state general-handling {
        block start {
            track main {
                lambda {
                    if (task-active?(nlance, owen-reef-sniper)) {
                        spawn-entity(npc-owen-enemy-4, 0, 0);
                        while (!entity-exists?(npc-owen-enemy-4)) {
                            wait-one-frame();
                        }
                        set-health-parameters(npc-owen-enemy-4, 0.00, 0.00, 400, 400);
                        npc-set-zone-region(npc-owen-enemy-4, rgn-zn-owen-sniper-1);
                        npc-make-aware-of(npc-owen-enemy-4, player, 2, 0);
                    }
                }
                lambda {
                    spawn-flashlight(player);
                }
                lambda {
                    while (1) {
                        if (joypad-command-active?(debug-script-press-r3, 6)) {
                            if (player-flashlight-on?()) {
                                turn-off-flashlight(player, 0);
                            } else {
                                turn-on-flashlight(player, 0);
                            }
                            wait(0.10);
                        }
                        wait-one-frame();
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (player-is-crouched?()) {
                        player-infinite-breath();
                    }
                }
            }
        }
    }
}
