statescript {
    options {
        player
    }
    declarations {
        i32 menu-index = 0
        i32 move-list-min = 0
        i32 move-list-max = 7
        i32 move-list-display-count = 8
        f32 debug-screen-space-x = 40.00
        f32 debug-screen-space-y = 420.00
        bool toggle-help-menu = nullptr
        bool toggle-move-menu = nullptr
        bool toggle-killable = nullptr
        symbol current-menu = nullptr
        symbol current-submenu = nullptr
        symbol root-menu = nullptr
        symbol sub-menu = nullptr
        symbol menu-header-symbol = Categories
        symbol scar-menu-symbol = Scar
        symbol infected-menu-symbol = Infected
        symbol militia-menu-symbol = Militia
        symbol animal-menu-symbol = Animal
        symbol santabarbara-menu-symbol = SantaBarbara
        symbol gore-menu-symbol = Gore
        symbol finisher-menu-symbol = Finisher
        symbol wetness-menu-symbol = Wetness
        symbol locked-symbol = Locked:Toggle-With-L1+R1
        symbol unlocked-symbol = Unlocked:Toggle-With-L1+R1
        symbol current-look-group-symbol = no-active-group
        symbol root-to-submenu-ddict = nullptr
        timer frame-delay-on-listen = nullptr
        bool toggle-listen-timer = true
        bool need-npc-spawn = nullptr
        bool need-npc-group-spawn = nullptr
        bool need-gore-on-npcs = nullptr
        bool need-finisher-on-npcs = nullptr
        bool need-wetness-on-npcs = nullptr
        symbol active-gore-pieces = nullptr
        symbol active-gore-limbs = nullptr
        symbol gorepiece-to-spawn = nullptr
        symbol finisher-to-perform = nullptr
        symbol wetness-option = nullptr
        i32 menu-height = 16
        f32 npc-spacing = 2.00
    }
    state --all-- {
        block update {
            track main {
                lambda {
                    if (joypad-command-active?(listen-hold, 6) && get-boolean(toggle-listen-timer, self)) {
                        set-boolean(toggle-listen-timer, 0, self);
                        start-timer(frame-delay-on-listen, frames-to-sec(4), self, 1);
                    }
                }
                lambda {
                    if (timer-done?(frame-delay-on-listen, self) && joypad-command-active?(listen-hold, 6)) {}
 else {
                        joypad-disable-commands(listen-hold);
                        player-disable-listen-crouch();
                        if (timer-done?(frame-delay-on-listen, self)) {
                            set-boolean(toggle-listen-timer, 1, self);
                            stop-timer(frame-delay-on-listen, self);
                        }
                    }
                }
                lambda {
                    u64? var_4;
                    if (joypad-button-lockout()) {
                        string var_7;
                        if (get-boolean(toggle-killable, self)) {
                            var_7 = " | Killable:Toggle-With-R2";
                        } else {
                            var_7 = " | UnKillable:Toggle-With-R2";
                        }
                        var_4 = string-debug(symbol-concat-string(get-symbol(unlocked-symbol, self), var_7));
                    } else {
                        string var_12;
                        if (get-boolean(toggle-killable, self)) {
                            var_12 = " | Killable:Toggle-With-R2";
                        } else {
                            var_12 = " | UnKillable:Toggle-With-R2";
                        }
                        var_4 = string-debug(symbol-concat-string(get-symbol(locked-symbol, self), var_12));
                    }
                    u16 var_16;
                    if (joypad-button-lockout()) {
                        var_16 = 3;
                    } else {
                        var_16 = 2;
                    }
                    debug-draw-string-2d(
                        alloc-point(get-float(debug-screen-space-x, self), get-float(debug-screen-space-y, self) - 100.00, 0.00, 0),
                        var_4,
                        var_16,
                        0.00,
                        0.50,
                        0,
                        alloc-vector(255.00, 200.00, 0.00, 1.00, 0),
                        0,
                        1.00
                    );
                }
                lambda {
                    debug-draw-string-2d(
                        alloc-point(
                            get-float(debug-screen-space-x, self),
                            get-float(debug-screen-space-y, self) - (f32)((get-int32(move-list-display-count, self) + 1) * 10),
                            0.00,
                            0
                        ),
                        dc:format("Options:  %s", string-debug(get-symbol(menu-header-symbol, self))),
                        10,
                        0.00,
                        0.50,
                        0,
                        alloc-vector(255.00, 200.00, 0.00, 1.00, 0),
                        0,
                        1.00
                    );
                }
                lambda {
                    u64 i = 0;
                    while (i < ((get-int32(move-list-max, self) - get-int32(move-list-min, self)) + 1)) {
                        string var_9;
                        if ((i + get-int32(move-list-min, self)) == get-int32(menu-index, self)) {
                            var_9 = "->";
                        } else {
                            var_9 = "  ";
                        }
                        u16 var_21;
                        if (darray-contains?(get-symbol(active-gore-pieces, self), boxed_symbol(get-container-at(get-symbol(current-menu, self), i + get-int32(move-list-min, self))))) {
                            var_21 = 5;
                        } else {
                            var_21 = 1;
                        }
                        debug-draw-string-2d(
                            alloc-point(
                                get-float(debug-screen-space-x, self),
                                (get-float(debug-screen-space-y, self) - (f32)((get-int32(move-list-display-count, self) + 1) * 10)) + (f32)((i * 10) + 10),
                                0.00,
                                0
                            ),
                            dc:format("%s %s", var_9, string-debug(get-container-at(get-symbol(current-menu, self), i + get-int32(move-list-min, self)))),
                            var_21,
                            0.00,
                            0.50,
                            0,
                            0,
                            0,
                            1.00
                        );
                        i = i + 1;
                    }
                }
                lambda {
                    if (joypad-command-active?(debug-script-release-l3, 6)) {
                        if (get-boolean(toggle-help-menu, self)) {
                            set-boolean(toggle-help-menu, 0, self);
                        } else {
                            set-boolean(toggle-help-menu, 1, self);
                        }
                    }
                }
                lambda {
                    if (get-boolean(toggle-help-menu, self)) {
                        debug-draw-string-2d(
                            alloc-point(
                                get-float(debug-screen-space-x, self),
                                get-float(debug-screen-space-y, self) + (f32)(get-int32(menu-height, self) + 20),
                                0.00,
                                0
                            ),
                            "HOLD L1 AND R1 TO UNLOCK MENU CONTROLS Navigate Menus with dpad, X and Square for selection and return Set spawn position with circle while holding l1 and r1 Clear respawning npcs with triangle while holding l1 and r1 Press R3 to toggle menu move mode. In menu move mode, use the left stick to place the debug menu",
                            9,
                            0.00,
                            0.50,
                            0,
                            0,
                            0,
                            1.00
                        );
                    }
                }
                lambda {
                    if (joypad-button-lockout()) {
                        player-set-narrative-mode/f(1, 0, *default-narrative-mode-settings*);
                        if (get-boolean(toggle-move-menu, self)) {
                            set-float(debug-screen-space-x, get-float(debug-screen-space-x, self) + ((((get-joypad-stick-intensity(move, 0.20, 1.00) * get-joypad-stick-x(move, 0.20, 1.00)) * get-delta-time()) * 30.00) * 15.00), self);
                            set-float(debug-screen-space-y, get-float(debug-screen-space-y, self) + ((((get-joypad-stick-intensity(move, 0.20, 1.00) * get-joypad-stick-y(move, 0.20, 1.00)) * get-delta-time()) * 30.00) * 15.00), self);
                        }
                        if (joypad-command-active?(debug-script-press-left, 6)) {
                            move-window-respawner(-4);
                        }
                        if (joypad-command-active?(debug-script-press-right, 6)) {
                            move-window-respawner(4);
                        }
                        if (joypad-command-active?(debug-script-press-up, 6)) {
                            move-window-respawner(-1);
                        }
                        if (joypad-command-active?(debug-script-press-down, 6)) {
                            move-window-respawner(1);
                        }
                        if (joypad-command-active?(debug-script-release-r3, 6)) {
                            if (get-boolean(toggle-move-menu, self)) {
                                set-boolean(toggle-move-menu, 0, self);
                            } else {
                                set-boolean(toggle-move-menu, 1, self);
                            }
                        }
                        if (joypad-command-active?(debug-script-release-r2, 6)) {
                            if (get-boolean(toggle-killable, self)) {
                                set-boolean(toggle-killable, 0, self);
                            } else {
                                set-boolean(toggle-killable, 1, self);
                            }
                        }
                        if (joypad-command-active?(debug-script-release-triangle, 6)) {
                            clear-level();
                        }
                        if (joypad-command-active?(debug-script-release-x, 6)) {
                            if (get-symbol(current-menu, self) == get-symbol(sub-menu, self)) {
                                if (!is-final-build?()) {
                                    display(dc:format("at sub"), 19);
                                }
                                if (get-symbol(menu-header-symbol, self) == symbol-concat-string(get-symbol(gore-menu-symbol, self), "-Looks")) {
                                    if (!is-final-build?()) {
                                        display(dc:format("gore menu"), 19);
                                    }
                                    set-symbol(gorepiece-to-spawn, get-container-at(get-symbol(current-menu, self), get-int32(menu-index, self)), self);
                                    set-boolean(need-gore-on-npcs, 1, self);
                                } else if (get-symbol(menu-header-symbol, self) == symbol-concat-string(get-symbol(finisher-menu-symbol, self), "-Looks")) {
                                    if (!is-final-build?()) {
                                        display(dc:format("finisher menu"), 19);
                                    }
                                    set-symbol(finisher-to-perform, get-container-at(get-symbol(current-menu, self), get-int32(menu-index, self)), self);
                                    set-boolean(need-finisher-on-npcs, 1, self);
                                } else if (get-symbol(menu-header-symbol, self) == symbol-concat-string(get-symbol(wetness-menu-symbol, self), "-Looks")) {
                                    if (!is-final-build?()) {
                                        display(dc:format("wetness menu"), 19);
                                    }
                                    set-symbol(wetness-option, get-container-at(get-symbol(current-menu, self), get-int32(menu-index, self)), self);
                                    set-boolean(need-wetness-on-npcs, 1, self);
                                } else {
                                    if (!is-final-build?()) {
                                        display(dc:format("spawn menu"), 19);
                                    }
                                    set-symbol(current-submenu, get-container-at(get-symbol(current-menu, self), get-int32(menu-index, self)), self);
                                    set-boolean(need-npc-spawn, 1, self);
                                }
                            } else if (get-symbol(current-menu, self) == get-symbol(root-menu, self)) {
                                if (!is-final-build?()) {
                                    display(dc:format("at root"), 19);
                                }
                                populate-sub-menu();
                                set-symbol(menu-header-symbol, string-to-symbol(dc:format("%s-Looks", string-debug(get-container-at(get-symbol(current-menu, self), get-int32(menu-index, self))))), self);
                                set-symbol(current-menu, get-symbol(sub-menu, self), self);
                                move-window-to-zero-respawner();
                            }
                        }
                        if (joypad-command-active?(debug-script-release-square, 6)) {
                            if (get-symbol(current-menu, self) == get-symbol(root-menu, self)) {}
 else if (get-symbol(current-menu, self) == get-symbol(sub-menu, self)) {
                                set-symbol(current-menu, get-symbol(root-menu, self), self);
                                set-symbol(menu-header-symbol, string-to-symbol("Categories"), self);
                            }
                            move-window-to-zero-respawner();
                        }
                    }
                }
            }
        }
    }
    state initial {
        block start {
            track main {
                lambda {
                    create-container(root-menu);
                }
                lambda {
                    create-container(sub-menu);
                }
                lambda {
                    initialize-root-menu();
                }
                lambda {
                    create-container(active-gore-pieces);
                }
                lambda {
                    create-container(active-gore-limbs);
                }
                lambda {
                    set-symbol(root-to-submenu-ddict, ddict-create(self, -1, 0), self);
                }
                lambda {
                    set-symbol(current-menu, get-symbol(root-menu, self), self);
                }
                lambda {
                    set-symbol(menu-header-symbol, string-to-symbol("Categories"), self);
                }
                lambda {
                    move-window-to-zero-respawner();
                }
                lambda {
                    go(main, 1);
                }
            }
        }
    }
    state main {
        block start {
            track spawn-new-npc {
                lambda {
                    while (1) {
                        wait-boolean(need-npc-spawn, 1, self);
                        spawn-selected-npcs();
                        set-boolean(need-npc-spawn, 0, self);
                    }
                }
            }
            track add-gore-on-npcs {
                lambda {
                    while (1) {
                        wait-boolean(need-gore-on-npcs, 1, self);
                        add-gore-for-all-npcs(get-symbol(gorepiece-to-spawn, self));
                        set-boolean(need-gore-on-npcs, 0, self);
                    }
                }
            }
            track animate-finisher-on-npcs {
                lambda {
                    while (1) {
                        wait-boolean(need-finisher-on-npcs, 1, self);
                        animate-finisher-for-all-npcs(get-symbol(finisher-to-perform, self));
                        set-boolean(need-finisher-on-npcs, 0, self);
                    }
                }
            }
            track apply-wetness-on-npcs {
                lambda {
                    while (1) {
                        wait-boolean(need-wetness-on-npcs, 1, self);
                        apply-wetness-for-all-npcs(get-symbol(wetness-option, self));
                        set-boolean(need-wetness-on-npcs, 0, self);
                    }
                }
            }
        }
    }
}
