statescript {
    options {
        player
    }
    state initial {
        block start {
            track main {
                lambda {
                    foreach (u16 var_2 : jm-all-pickups) {
                        spawn-entity(var_2, 0, 0);
                    }
                }
            }
        }
        block event_player-pickup {
            track main {
                lambda {
                    spawn-entity(event-arg-symbol(3), 0, 0);
                }
                lambda {
                    player-inventory-consume-item(event-arg-symbol(1), 3);
                }
                lambda {
                    if (!is-final-build?()) {
                        display(dc:format(
                            "................... process-id = %s, item-id = %s, count = %d, spawner = %s",
                            string-debug(event-arg-symbol(0)),
                            string-debug(event-arg-symbol(1)),
                            event-arg-int32(2),
                            string-debug(event-arg-symbol(3))
                        ), 19);
                    }
                }
            }
        }
    }
}
