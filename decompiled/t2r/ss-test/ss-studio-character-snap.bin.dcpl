u64? advance-anim-one-frame(u64? arg_0, u64? arg_1) {
    u64? var_1 = get-animation-frame(arg_0, 2, 0);
    u64? var_2 = get-animation-duration(arg_0, get-object-anim(arg_0, 1));
    u64? var_3;
    if (arg_1) {
        var_3 = set-animation-phase(
            arg_0,
            (var_1 - 1.00) / (var_2 * 30.00),
            2,
            0
        );
    } else {
        var_3 = set-animation-phase(
            arg_0,
            (var_1 + 1.00) / (var_2 * 30.00),
            2,
            0
        );
    }
    return var_3;
}

