    state wave-1 {
        block start {
            track main {
                lambda {
                    if (get-boolean(continue-task?, self)) {
                        npc-set-script-high-priority(npc-underpass-scar-rifle-1);
                        npc-set-script-high-priority(npc-underpass-scar-melee-1);
                        npc-set-script-high-priority(npc-underpass-scar-pistol-melee-1);
                        npc-set-script-high-priority(npc-underpass-1);
                        npc-set-script-high-priority(yara);
                    } else {
                        spawn-npc-group(underpass-group-1);
                    }
                }
                lambda {
                    npc-make-aware-of-at(npc-underpass-1, player, get-spawner-position(position-huf-player-spoof-1, 1), 2, 0, 0);
                }
                lambda {
                    npc-set-hard-point(npc-underpass-scar-melee-1, hard-point-underpass-melee-1);
                }
                lambda {
                    npc-set-hard-point(npc-underpass-scar-rifle-1, hard-point-underpass-street-1);
                }
                lambda {
                    npc-set-hard-point(npc-underpass-scar-pistol-melee-1, hard-point-underpass-street-1);
                }
                lambda {
                    start-timer(zone-timer, 30.00, self, 1);
                }
                lambda {
                    npc-set-ignore(yara, 1);
                }
                lambda {
                    npc-request-explore-close(yara, 0, 0, 0);
                }
            }
        }
        block event npc-died {
            track main {
                lambda {
                    if (npc-group-alive-count(all-enemy-npcs) < 2 && get-boolean(wave-time-complete, self)) {
                        task-complete!(t1x, t1x-hun-underpass-fight);
                        go(wave-2, 1);
                    }
                }
                lambda {
                    npc-group-clear-hardpoints(underpass-group-1);
                }
            }
        }
        block event zone-timer {
            track main {
                lambda {
                    npc-group-clear-hardpoints(underpass-group-1);
                }
                lambda {
                    set-boolean(no-hardpoint, 1, self);
                }
                lambda {
                    set-boolean(wave-time-complete, 1, self);
                }
                lambda {
                    send-event(npc-died, self);
                }
            }
        }
        block event player-in-alley {
            track main {
                lambda {
                    if (!get-boolean(no-hardpoint, self)) {
                        npc-set-hard-point(npc-underpass-scar-rifle-1, hard-point-underpass-store-1);
                        npc-set-hard-point(npc-underpass-scar-pistol-melee-1, hard-point-underpass-store-1);
                        set-boolean(no-hardpoint, 1, self);
                    }
                }
            }
        }
        block event player-in-street {
            track main {
                lambda {
                    npc-group-clear-hardpoints(underpass-group-1);
                }
                lambda {
                    set-boolean(no-hardpoint, 1, self);
                }
            }
        }
    }
    state wave-2 {
        block start {
            track main {
                lambda {
                    spawn-npc-group(underpass-group-2);
                }
                lambda {
                    set-boolean(reinf-spawned, 1, self);
                }
                lambda {
                    npc-set-ignore(yara, 1);
                }
                lambda {
                    npc-request-explore-close(yara, 0, 0, 0);
                }
                lambda {
                    if (get-tension-mode() != 3) {
                        wait(0.25);
                        npc-search-move-to-spawner(npc-underpass-scar-shotgun-1, pos-search-store-1, 1, 2, 0, 0);
                        npc-search-move-to-spawner(npc-underpass-scar-melee-2, pos-search-office-1, 1, 2, 0, 0);
                        npc-search-move-to-spawner(npc-underpass-scar-pistol-2, pos-search-alley-1, 1, 2, 0, 0);
                    }
                }
            }
        }
        block event npc-died {
            track main {
                lambda {
                    if (get-boolean(reinf-spawned, self) && npc-group-alive-count(all-enemy-npcs) == 0) {
                        go(combat-end, 1);
                    }
                }
            }
        }
    }
    state combat-end {
        block start {
            track main {
                lambda {
                    task-complete!(t1x, t1x-hun-underpass-fight-mid);
                }
                lambda {
                    wait(4.00);
                }
                lambda {
                    set-tension-mode(1);
                }
                lambda {
                    request-dialog(player-callout-combat-end, player, 0, 0, 0, 0, 0);
                }
                lambda {
                    go(done, 1);
                }
            }
        }
    }
}
