statescript {
    options {
        player
    }
    state wait-move {
        block update {
            track main {
                lambda {
                    if (vector-magnitude(get-object-velocity(get-parent(get-self-id(), 0))) > 0.00 && !player-in-state?(PushPull)) {
                        go(wait-hit, 1);
                    }
                }
            }
        }
    }
    state wait-hit {
        block update {
            track main {
                lambda {
                    if (!(vector-magnitude(get-object-velocity(get-parent(get-self-id(), 0))) > 0.00)) {
                        go(wait-move, 1);
                    }
                }
            }
        }
        block event_enter {
            track main {
                lambda {
                    send-event(hit-by-push-object, event-arg-symbol(0), boxed_symbol(get-parent(get-self-id(), 0)));
                }
            }
        }
    }
}
