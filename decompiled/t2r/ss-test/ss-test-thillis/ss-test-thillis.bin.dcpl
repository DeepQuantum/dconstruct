statescript {
    options {
        player
        thillis-test-level
    }
    declarations {
        i32 wave-counter = 1
    }
    state tdog {
        block start {
            track main {
                lambda {
                    if (get-int32(wave-counter, self) == 1) {
                        spawn-npc-group(wave-one);
                    }
                }
                lambda {
                    if (get-int32(wave-counter, self) == 2) {
                        spawn-npc-group(wave-two);
                    }
                }
                lambda {
                    go(wave-start, 1);
                }
            }
        }
    }
    state wave-start {
        block event_npc-died {
            track main {
                lambda {
                    if (get-int32(wave-counter, self) == 1) {
                        if (npc-group-alive-count(wave-one) <= 0) {
                            go(wait-kill-wave, 1);
                        }
                    }
                }
                lambda {
                    if (get-int32(wave-counter, self) == 2) {
                        if (npc-group-alive-count(wave-two) <= 0) {
                            go(wait-kill-wave, 1);
                        }
                    }
                }
            }
        }
    }
    state wait-kill-wave {
        block start {
            track main {
                lambda {
                    ++(wave-counter, self);
                }
                lambda {
                    wait(5.00);
                }
                lambda {
                    go(tdog, 1);
                }
            }
        }
    }
}
