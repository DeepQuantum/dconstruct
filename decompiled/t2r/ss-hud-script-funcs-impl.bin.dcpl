string net-get-squadmate-color(u16 arg_0) {
    return match (arg_0) {
        0    -> lookup-hud-color(net-squadmate-0-color),
        1    -> lookup-hud-color(net-squadmate-1-color),
        2    -> lookup-hud-color(net-squadmate-2-color),
        3    -> lookup-hud-color(net-squadmate-3-color),
        else -> ""
    };
}

u64? lookup-hud-color-vector(u64? arg_0) {
    return color-to-vector(lookup-hud-color(arg_0));
}

