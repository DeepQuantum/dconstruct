                lambda {
                    if (entity-exists?(npc-enemy-ellie-pistol-1)) {
                        set-character-wet-mask-value(npc-enemy-ellie-pistol-1, 0.00);
                    }
                }
                lambda {
                    set-character-wet-mask-value(player, get-float(wet-mask-val, self));
                }
                lambda {
                    set-character-wet-mask-value(lev, get-float(wet-mask-val, self));
                }
            }
        }
    }
}
