        0,
        0,
        0
    ));
}

u64? mm-tool-get-target-camera-position() {
    return offset-position(get-object-position(get-symbol(active-npc, self)), alloc-vector(
        -5.00 * *(f32*)get-local-z(get-locator-rotation(get-bound-frame(initial-npc-locator, self))),
