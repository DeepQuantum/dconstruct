statescript {
    declarations {
        bool use-animated-cam? = nullptr
        i32 cam-mode = 0
        i32 cam-position = 0
        i32 selected-actor-index = 0
        bool grid-enabled? = nullptr
        i32 avp-actors-anim-finished-count = 0
        bool widget-active? = nullptr
        symbol root-widget = nullptr
        f32 frame-box-left = 0.00
        f32 frame-box-right = 0.00
        f32 frame-box-top = 0.00
        f32 frame-box-bottom = 0.00
        f32 frame-box-width = 0.00
        symbol anim-actor-ddict = nullptr
        i32 anim-actor-bundle-index = nullptr
        i32 anim-actor-anim-index = nullptr
        i32 bundle-count = nullptr
        bool spawn-mode? = nullptr
        bound-frame starting-ap-ref = nullptr
        bound-frame spawn-bound-frame = nullptr
        bool anim-actor-mode? = nullptr
    }
    state --all-- {
        block event_clear-actor-viewer {
            track main {
                lambda {
                    gui2-kill-widget(gui2-build-widget-path(
                        get-symbol(root-widget, self),
                        "avp",
                        0,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0
                    ));
                }
                lambda {
                    kill-entity(get-self-id());
                }
            }
        }
    }
    state initial {
        block event_actor-initialized {
            track main {
                lambda {
                    darray-append(avp-actors, boxed_symbol(event-arg-symbol(0)), 0);
                }
                lambda {
                    set-boolean(use-animated-cam?, event-arg-boolean(1), self);
                }
                lambda {
                    if (get-boolean(use-animated-cam?, self)) {
                        set-int32(cam-mode, 2, self);
                    } else {
                        set-int32(cam-mode, 0, self);
                    }
                }
                lambda {
                    set-bound-frame(starting-ap-ref, event-arg-bound-frame(2), self);
                }
            }
        }
        block event_setup-prop-actor {
            track main {
                lambda {
                    darray-append(avp-actors, boxed_symbol(event-arg-symbol(0)), 0);
                }
            }
        }
        block event_start-anim {
            track main {
                lambda {
                    go(animating, 1);
                }
            }
        }
        block event_reset-actor-viewer {
            track main {
                lambda {
                    reset-avp-script();
                }
            }
        }
    }
    state animating {
        block start {
            track main {
                lambda {
                    if (!get-boolean(anim-actor-mode?, self)) {
                        set-boolean(widget-active?, 0, self);
                        if (gui2-widget-exists?(canvas.hudRoot)) {
                            set-symbol(root-widget, canvas.hudRoot, self);
                        } else {
                            set-symbol(root-widget, canvas.menuRoot, self);
                        }
