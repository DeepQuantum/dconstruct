    state struggling {
        block start {
            track main {
                lambda {
                    while (player-in-state?(GrappleNpc) || player-in-state?(GunMoveGrappleNpc) && !((get-current-time(0) - get-current-time(0)) > 3.00)) {
                        wait-one-frame();
