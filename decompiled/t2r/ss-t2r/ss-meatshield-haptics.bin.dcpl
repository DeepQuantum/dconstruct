                lambda {
                    while (player-in-meatshield-sequence?(1) || player-in-state?(GrappleNpc) && player-in-state?(GunMoveGrappleNpc)) {
                        if (get-int32(struggle-haptic, self) < 0) {
                            set-int32(struggle-haptic, play-hfx-id(meatshield-struggle-haptic, 0, 2), self);
                        }
                        hfx-continue(get-int32(struggle-haptic, self));
                        hfx-set-gain-scale(get-int32(struggle-haptic, self), lerp-scale(0.00, 1.00, 0.20, 2.00, get-meatshield-struggle-percentage()));
                        wait-one-frame();
                    }
