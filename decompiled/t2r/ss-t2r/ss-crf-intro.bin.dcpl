statescript {
    options {
        player
    }
    declarations {
        symbol intro-movie-id = nullptr
        symbol end-event-reciever = nullptr
        bool skip-enabled? = nullptr
        timer skip-timeout = nullptr
    }
    state task-check {
        block start {
            track main {
                lambda {
                    if (task-active?(t2r-jackson-party, t2r-efj-wandering-jackson-intro)) {
                        set-symbol(intro-movie-id, cin-crf-intro-jackson-party, self);
                        set-symbol(end-event-reciever, ss-t2r-efj-igc-ellie-drinking-1, self);
                        go(intro, 1);
                    } else if (task-active?(t2r-boar-hunt, t2r-far-boar-hunting-intro)) {
                        set-symbol(intro-movie-id, cin-crf-intro-the-hunt, self);
                        set-symbol(end-event-reciever, ss-boar-hunt-igc-track-blood-1, self);
                        go(intro, 1);
                    } else if (task-active?(t2r-sewers, t2r-nor-stalker-intro-ambush)) {
                        set-symbol(intro-movie-id, cin-crf-intro-seattle-sewers, self);
                        set-symbol(end-event-reciever, ss-t2r-nor-stalker-igc-office-barricade-1, self);
                        go(intro, 1);
                    } else {
                        go(done, 1);
                    }
                }
            }
        }
    }
    state intro {
        block start {
            track main {
                lambda {
                    if (is-crf-intro-vid-enabled?()) {
                        set-boolean(intro-video-playing?, 1, ss-vox-t2r-far-boar-hunting-intro-1);
                        go(play-movie, 1);
                    } else {
                        speak-text-to-speech-formatted(boxed_symbol(MENU_CUTTING_ROOM_FLOOR_DISCLAIMER), 1, 0, 1);
                        speak-text-to-speech-formatted(boxed_symbol(MENU_PROMPT_CONTINUE_BUTTON), 1, 0, 1);
                        wait-gui2-show-pause-card(*cut-levels-disclaimer*, 2, 2, 2);
                        send-event(crf-intro-done, get-symbol(end-event-reciever, self));
                        go(done, 1);
                    }
                }
            }
        }
    }
    state play-movie {
        block start {
            track movie {
                lambda {
                    set-boolean(skip-enabled?, 0, self);
                }
                lambda {
                    wait-play-movie(get-symbol(intro-movie-id, self), 1, 0.00, 0, 0.00);
                }
                lambda {
                    send-event(crf-intro-done, get-symbol(end-event-reciever, self));
                }
                lambda {
                    go(done, 1);
                }
            }
            track skip-enabler {
                lambda {
                    while (!movie-playing?(get-symbol(intro-movie-id, self))) {
                        wait-one-frame();
                    }
                }
                lambda {
                    wait(5.00);
                }
                lambda {
                    set-boolean(skip-enabled?, 1, self);
                }
            }
            track black-fade {
                lambda {
                    set-black-fade(1.00, 1, 0, 1);
                    wait-one-frame();
                    while (!(movie-get-current-frame(get-symbol(intro-movie-id, self)) > 0.00)) {
                        set-black-fade(1.00, 1, 0, 1);
                        wait-one-frame();
                    }
                }
                lambda {
                    set-black-fade(0.00, 1, 0, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    disable-pause-menu/f();
                }
                lambda {
                    joypad-disable-all-commands-except(menu-back, pause);
                }
                lambda {
                    if (get-boolean(skip-enabled?, self) && !timer-running?(skip-timeout, self) || joypad-command-active?(menu-back, 6) && joypad-command-active?(pause, 6)) {
                        set-boolean(skip-enabled?, 0, self);
                        menu2-push-message-box(ingame, "menu/message-box-yes-no_ingame", MENU_SKIPMOVIE, MENU_SKIP_CINEMATIC_CONFIRM, 0, skip-intro, 2, 1);
                    }
                }
            }
        }
        block event_messageBoxOk {
            track main {
                lambda {
                    stop-movie(get-symbol(intro-movie-id, self));
                }
            }
        }
        block event_messageBoxCancel {
            track main {
                lambda {
                    set-boolean(skip-enabled?, 1, self);
                }
                lambda {
                    start-timer(skip-timeout, 0.70, self, 1);
                }
            }
        }
        block event_popped {
            track main {
                lambda {
                    set-boolean(skip-enabled?, 1, self);
                }
                lambda {
                    start-timer(skip-timeout, 0.70, self, 1);
                }
            }
        }
    }
    state done {
        block start {
            track main {
                lambda {
                    set-boolean(intro-video-playing?, 0, ss-vox-t2r-far-boar-hunting-intro-1);
                }
            }
        }
    }
}
