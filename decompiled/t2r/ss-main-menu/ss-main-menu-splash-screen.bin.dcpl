statescript {
    state waiting {
        block update {
            track main {
                lambda {
                    set-per-frame-mixer-override(mix-main-menu-boot-sequence);
                }
            }
        }
        block event_splash-screen-entered {
            track main {
                lambda {
                    go(run-sequence, 1);
                }
            }
        }
        block event_splash-screen-skipped {
            track main {
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state run-sequence {
        block start {
            track title-cards {
                lambda {
                    if (task-is-os-notice-screen-skip-flag-enabled?() && !menu2-always-show-splash?) {
                        set-boolean(waiting-for-splash-screen?, 0, ss-main-menu-boat-1);
                        notify-splash-screen-done();
                        go(complete, 1);
                    } else {
                        menu2-page-stack-enable-sounds(main, 1);
                        wait(3.00);
                        menu2-push-page(main, "menu/splash/sony", 0);
                        wait(5.00);
                        menu2-pop-page(main, menu/splash/sony);
                        wait(2.00);
                        set-movie-alpha(1.00);
                        wait-play-movie(cin-ps-studios-t2r, 0, 0.00, 0, 0.00);
                        wait(1.00);
                        set-boolean(waiting-for-splash-screen?, 0, ss-main-menu-boat-1);
                        play-sound-at-bound-frame(sfx-amb-intro, get-object-locator(cam-main-menu-1), 0, 0);
                        wait(5.00);
                        menu2-push-page(main, "menu/splash/naughty-dog", 0);
                        wait(7.00);
                        menu2-pop-page(main, menu/splash/naughty-dog);
                        wait(2.00);
                        menu2-push-page(main, "pc/menu/splash/nixxes", 0);
                        wait(7.00);
                        menu2-pop-page(main, pc/menu/splash/nixxes);
                        wait(2.00);
                        notify-splash-screen-done();
                        go(complete, 1);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (get-boolean(waiting-for-splash-screen?, ss-main-menu-boat-1) && movie-get-current-frame(0) < 0.00) {
                        set-per-frame-mixer-override(mix-main-menu-boot-sequence);
                    }
                }
                lambda {
                    if (joypad-command-active?(any-joypad-button-press, 6) && menu2-may-skip-splash?()) {
                        go(skip, 1);
                    }
                }
            }
        }
    }
    state skip {
        block start {
            track title-cards {
                lambda {
                    menu2-pop-page(main, menu/splash/sony);
                }
                lambda {
                    stop-movie(cin-ps-studios-t2r);
                }
                lambda {
                    menu2-pop-page(main, menu/splash/naughty-dog);
                }
                lambda {
                    menu2-pop-page(main, pc/menu/splash/nixxes);
                }
                lambda {
                    wait(0.10);
                }
                lambda {
                    notify-splash-screen-done();
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
