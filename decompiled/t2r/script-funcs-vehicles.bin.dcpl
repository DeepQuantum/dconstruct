u64? rail-backwards-spline(u64? arg_0, u64? arg_1, u64? arg_2) {
    rail-set-speed-mps(arg_0, 0.00, 0);
    while (!(rail-get-speed-mps(arg_0) < 0.05)) {
        wait-one-frame();
    }
    rail-go-backwards(arg_0, arg_2);
    transfer-to-spline(arg_0, arg_1, 2);
    return rail-set-speed-mps(arg_0, rail-get-target-speed-mps(arg_0), 0);
}

u64? rail-wait-distance-along-spline(u64? arg_0, u64? arg_1, i64 arg_2) {
    while (!(rail-get-spline(arg_0) == arg_2)) {
        wait-one-frame();
    }
    return rail-wait-distance(arg_0, arg_1);
}

u64? rail-wait-distance-from-end(u64? arg_0, u64? arg_1) {
    return wait-spline-distance(arg_0, get-spline-length(rail-get-spline(arg_0)) - arg_1);
}

u64? rail-wait-distance-from-end-of-spline(u64? arg_0, u64? arg_1, i64 arg_2) {
    while (!(rail-get-spline(arg_0) == arg_2)) {
        wait-one-frame();
    }
    return rail-wait-distance-from-end(arg_0, arg_1);
}

u64? rail-wait-distance(u64? arg_0, u64? arg_1) {
    return wait-spline-distance(arg_0, arg_1);
}

