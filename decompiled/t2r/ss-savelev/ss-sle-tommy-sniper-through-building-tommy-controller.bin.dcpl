                    u64? var_0 = npc-on-screen-and-visible?(npc-tommy-fight-1, -1, 0);
                    u64? var_1 = get-joint-position(npc-tommy-fight-1, headb);
                    u64? var_2 = task-range-active?(save-lev, sle-tommy-sniper-through-building, save-lev, sle-tommy-sniper-elevator-escape);
                    u64? var_3 = is-centered-on-reticle?(var_1, 100.00);
                    u64? var_4 = player-is-aiming?();
                    while (var_0 && var_2 || is-centered-on-reticle? != null || EXPRESSION_ERROR_PLACEHOLDER && var_3 && !var_4) {
                        wait-one-frame();
                    }
                }
                lambda {
                    if (fact-get-time-since-safe(npc-tommy-fight-1, tommy-fired) > 1.00) {
                        go(shoot-aiming-player, 1);
                    } else {
                        go(duck, 1);
                    }
                }
            }
        }
        block event_npc-fired-weapon {
            track main {
                lambda {
                    if (event-arg-symbol(0) == npc-tommy-fight-1) {
                        set-boolean(tommy-fired-upper-floor-2, 1, self);
                        fact-set-time-safe(npc-tommy-fight-1, tommy-fired);
                    }
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-complete?(save-lev, sle-tommy-sniper-through-building-infected)) {
                        set-boolean(swap-to-boss-loadout, 1, self);
                    }
                }
            }
        }
    }
    state reposition {
        block start {
            track main {
                lambda {
                    sid var_1;
                    if (task-active?(save-lev, sle-tommy-sniper-through-building)) {
                        var_1 = tommy-random-reposition-positions-lower-floor;
                    } else {
                        var_1 = tommy-random-reposition-positions-upper-floor;
                    }
                    wait-npc-teleport-into-closest-cover(npc-tommy-fight-1, get-spawner-locator(get-farthest-spawner-in-group-to-locator(var_1, get-object-locator(npc-tommy-fight-1)), 1));
                }
                lambda {
                    set-boolean(tommy-just-repositioned?, 1, self);
                }
                lambda {
                    go(waiting-for-los, 1);
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-complete?(save-lev, sle-tommy-sniper-through-building-infected)) {
                        set-boolean(swap-to-boss-loadout, 1, self);
                    }
                }
            }
        }
    }
    state clean-up {
        block start {
            track main {
                lambda {
                    sle-tommy-set-weapon-loadout(*(u64 *)(get-difficulty-detail-player() + 152), self, 1);
                }
                lambda {
                    npc-cancel-fire-command(npc-tommy-fight-1);
                }
                lambda {
                    npc-use-closest-cover(
                        npc-tommy-fight-1,
                        get-spawner-locator(pos-tommy-over-bridge-cover-right-1, 1),
                        2,
                        0,
                        0,
                        1,
                        0,
                        0,
                        0,
                        0,
                        0
                    );
                }
                lambda {
                    set-effect-alpha(get-uint64(lens-flare-effect, self), 0.00);
                }
                lambda {
                    set-effect-alpha(get-uint64(offscreen-effect, self), 0.00);
                }
                lambda {
                    kill-particles(get-uint64(lens-flare-effect, self), 0);
                }
                lambda {
                    kill-particles(get-uint64(offscreen-effect, self), 0);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
