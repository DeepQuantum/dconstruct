                    npc-fire-at-object(npc-tommy-fight-1, player, 1, 2, 3, 0);
                }
                lambda {
                    wait-until-cin-maya-frame(683.00, 0);
                }
                lambda {
                    start-rumble(hard-land-rumble-settings, 0);
                }
                lambda {
                    npc-fire-at-object(npc-tommy-fight-1, player, 1, 2, 3, 0);
                }
                lambda {
                    wait-until-cin-maya-frame(920.00, 0);
                }
                lambda {
                    npc-clear-look-aim-at(npc-tommy-fight-1);
                }
            }
            track boats {
                lambda {
                    wait-until-cin-frame(160.00, 0);
                }
                lambda {
                    foreach (u16 var_2 : sle-manny-tackle-cine-boats) {
                        if (!entity-exists?(var_2)) {
                            wait-spawn-entity(var_2, 0);
                            enable-physics(var_2, 0, 0.00);
                        }
                    }
                }
                lambda {
                    wait-until-cin-frame(640.00, 0);
                }
                lambda {
                    foreach (u16 var_2 : sle-manny-tackle-cine-boats) {
                        if (entity-exists?(var_2)) {
                            kill-entity(var_2);
                        }
                    }
                }
            }
            track lens-flare {
                lambda {
                    wait-for(animate-manny);
                }
                lambda {
                    while (!get-boolean(player-on-ground, ss-sle-tommy-sniper-approach-tommy-controller-1)) {
                        if (npc-on-screen?(npc-tommy-fight-1, 0.00)) {
                            set-effect-alpha(get-uint64(lens-flare-effect, ss-sle-tommy-sniper-approach-tommy-controller-1), 1.00);
                        } else {
                            set-effect-alpha(get-uint64(lens-flare-effect, ss-sle-tommy-sniper-approach-tommy-controller-1), 0.00);
                        }
                        wait-one-frame();
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    suppress-spot-player-stinger();
                }
                lambda {
                    npc-suppress-threat-audio(npc-tommy-fight-1);
                }
                lambda {
                    npc-suppress-threat-indicator(npc-tommy-fight-1);
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    send-event(disable, sle-squeeze-through-enter-street-1);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
