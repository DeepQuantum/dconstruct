                    wait-boolean(RGN-turn-off-firing, 0, self);
                }
                lambda {
                    go(not-noticed-player, 1);
                }
            }
            track progression {
                lambda {
                    while (!task-complete?(save-lev, sle-tommy-sniper-into-building-gate-lift)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    go(clean-up, 1);
                }
            }
            track lens-flare {
                lambda {
                    set-effect-alpha(get-uint64(lens-flare-effect, self), 0.00);
                }
                lambda {
                    set-effect-alpha(get-uint64(offscreen-effect, self), 0.00);
                }
            }
        }
        block update {
            track main {
                lambda {
                    suppress-spot-player-stinger();
                }
                lambda {
                    npc-suppress-threat-audio(npc-tommy-fight-1);
                }
            }
        }
    }
    state clean-up {
        block start {
            track main {
                lambda {
                    set-effect-alpha(get-uint64(lens-flare-effect, self), 0.00);
                }
                lambda {
                    set-effect-alpha(get-uint64(offscreen-effect, self), 0.00);
                }
                lambda {
                    kill-particles(get-uint64(lens-flare-effect, self), 0);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
