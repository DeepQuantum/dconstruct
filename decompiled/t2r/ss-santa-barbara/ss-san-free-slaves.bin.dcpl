                        play-hfx-id(generic-pull-release-soft-haptic, 0, 2);
                        wait-until-cin-frame(692.00, 0);
                        play-hfx-id(clip-drop-haptic, 0, 2);
                        wait-until-cin-frame(1947.00, 0);
                        play-hfx-id(touch-soft, 0, 2);
                        wait-until-cin-frame(2231.00, 0);
                        play-hfx-id(door-open-haptic, 0, 2);
                    }
                }
            }
            track high-contrasat-mode {
                lambda {
                    wait-for(anim-start);
                }
                lambda {
                    if (!get-boolean(from-task-in?, self)) {
                        foreach (u16 var_3 : san-prisoners) {
                            set-high-contrast-mode-type(var_3, 5);
                        }
                    }
                }
                lambda {
                    door-disable-systemic-high-contrast-mode-update(san-resort-beach-cafe-a-door-san-resort-conference-a-r-1, 1);
                }
                lambda {
                    door-disable-systemic-high-contrast-mode-update(san-resort-beach-cafe-a-door-san-resort-conference-a-l-1, 1);
                }
            }
            track big-bad-weapon {
                lambda {
                    wait-until-cin-maya-frame(199.50, 0);
                }
                lambda {
                    interactable-disable(int-dist-remap-38);
                }
                lambda {
                    player-inv-selection-replace-item(weapon-slot-to-player-inv-selection-slot(0), rifle-mpx5);
                }
                lambda {
                    set-visible(get-weapon-id(player, 0), 1);
                }
                lambda {
                    set-visible(get-weapon-id(player, 1), 0);
                }
            }
            track melee {
                lambda {
                    wait-for(anim-start);
                }
                lambda {
                    wait-until-cin-frame(1981.00, 0);
                }
                lambda {
                    if (!(get-player-best-melee-weapon-id() == switchblade)) {
                        inventory-item-consume(get-player-best-melee-weapon(), 1);
                    }
                }
                lambda {
                    if (!(switchblade == player-get-weapon-name(4))) {
                        player-inv-selection-replace-item(weapon-slot-to-player-inv-selection-slot(4), switchblade);
                    }
                }
            }
            track hair {
                lambda {
                    wait-for(anim-start);
                }
                lambda {
                    wait-until-cin-maya-frame(113.00, 0);
                }
                lambda {
                    send-event(mess-hair, player, boxed_f32(0.00));
                }
            }
            track material-params {
                lambda {
                    set-table-shader-material-values-param(*ellie-blood-pants-free*, 0.00);
                }
                lambda {
                    wait-until-cin-maya-frame(268.00, 0);
                }
                lambda {
                    while (!(cinematic-get-current-maya-frame(0) >= 800.00)) {
                        lerped-set-table-shader-material-values-param(*ellie-blood-pants-free*, 268.00, 800.00, 0.00, 1.00, cinematic-get-current-maya-frame(0), 1);
                        wait-one-frame();
                    }
                }
                lambda {
                    set-table-shader-material-values-param(*ellie-blood-pants-free*, 1.00);
                }
            }
        }
    }
    state cleanup {
        block start {
            track main {
                lambda {
                    interactable-disable(int-dist-remap-38);
                }
                lambda {
                    if (!get-boolean(from-task-in?, self)) {
                        group-kill-entity(san-prisoners, 0);
                    }
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
