                lambda {
                    if (joypad-has-haptics?(2)) {
                        wait-until-cin-frame(718.00, 0);
                        play-hfx-id(bil-snare-zip-haptic-short, 0, 2);
                        wait-until-cin-frame(736.00, 0);
                        play-hfx-id(hard-land-rumble-settings, 0, 2);
                        wait-until-cin-frame(852.00, 0);
                        play-hfx-id(touch-soft-left, 0, 2);
                        wait-until-cin-frame(888.00, 0);
                        play-hfx-id(human-grab-normal-left-haptic, 0, 2);
                        wait-until-cin-frame(910.00, 0);
                        play-hfx-id(human-grab-normal-left-haptic, 0, 2);
                        wait-until-cin-frame(925.00, 0);
                        play-hfx-id(human-grab-normal-left-haptic, 0, 2);
                        wait-until-cin-frame(1096.00, 0);
                        play-hfx-id(human-grab-normal-left-haptic, 0, 2);
                        wait-until-cin-frame(2087.00, 0);
                        play-hfx-id(human-grab-normal-right-haptic, 0, 2);
                        wait-until-cin-frame(2121.00, 0);
                        play-hfx-id(human-grab-normal-right-haptic, 0, 2);
                        wait-until-cin-frame(2185.00, 0);
                        play-hfx-id(human-grab-normal-right-haptic, 0, 2);
                        wait-until-cin-frame(2208.00, 0);
                        play-hfx-id(human-grab-normal-right-haptic, 0, 2);
                        wait-until-cin-frame(2223.00, 0);
                        u64? var_1 = play-hfx-id(human-struggle-baseline-haptic, 0, 2);
                        while (!(cinematic-get-current-frame(0) >= 2397.00)) {
                            hfx-continue(var_1);
                            hfx-set-gain-scale(var_1, 3.00);
                            wait-one-frame();
                        }
                        play-hfx-id(generic-pull-release-haptic, 0, 2);
                        wait-until-cin-frame(2441.00, 0);
                        play-hfx-id(melee-standing-hit-reaction-rumble-settings, 0, 2);
                        wait-until-cin-frame(2560.00, 0);
                        play-hfx-id(*assault-rifle-haptic-settings*, 0, 2);
                        play-hfx-id(*assault-rifle-haptic-settings*, 0, 2);
                        play-hfx-id(*assault-rifle-haptic-settings*, 0, 2);
                        wait-until-cin-frame(2588.00, 0);
                        play-hfx-id(generic-pull-release-haptic, 0, 2);
                        wait-until-cin-frame(4960.00, 0);
                        play-hfx-id(*assault-rifle-haptic-settings*, 0, 2);
                        wait-until-cin-frame(5162.00, 0);
                        play-hfx-id(touch-soft-right, 0, 2);
                    }
                }
            }
            track blood {
                lambda {
                    while (!object-spawned?(player)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    set-table-shader-material-values-param(*ellie-snared-blood-upsidedown*, 1.00);
                }
            }
            track bite {
                lambda {
                    while (!object-spawned?(player)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    wait-until-cin-maya-frame(2338.00, 0);
                }
                lambda {
                    set-table-shader-material-values-param(*ellie-snared-blood-clickerbite*, 1.00);
                }
            }
            track shooting {
                lambda {
                    while (!object-spawned?(player)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    wait-until-cin-maya-frame(2460.00, 0);
                }
                lambda {
                    set-table-shader-material-values-param(*ellie-snared-blood-splatter*, 1.00);
                }
            }
            track ellie-hair {
                lambda {
                    wait-for(anim-start);
                }
                lambda {
                    wait-until-cin-maya-frame(750.00, 0);
                }
                lambda {
                    player-swap-look-id(ellie-santabarbara-no-backpack, 0, 1);
                }
            }
            track ellie-holster {
                lambda {
                    wait-for(anim-start);
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    set-mesh-visible(player, remap-leg-holster-look(ellie-leg-holster-r), 0);
                }
            }
            track matthew-material-swaps {
                lambda {
                    while (!object-spawned?(cinematic-alias(male, cin-san-snared-escape))) {
                        wait-one-frame();
                    }
                }
                lambda {
                    set-table-shader-material-values-param(*slaver-matthew-arrow-gore1*, 0.00);
                }
                lambda {
                    set-table-shader-material-values-param(*slaver-matthew-arrow-gore2*, 0.00);
                }
                lambda {
                    set-table-shader-material-values-param(*slaver-matthew-death*, 0.00);
                }
            }
            track clicker-gore {
                lambda {
                    wait-for(anim-start);
                }
                lambda {
                    wait-until-cin-maya-frame(2426.00, 0);
                }
                lambda {
                    spawn-gore-piece(clicker-female-san-snared-gun-l, npc-san-snared-clicker-2, 0, 0, 1, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    set-mesh-invisible/f(player, ellie-santa-barbara-backpack);
                }
            }
        }
    }
}
