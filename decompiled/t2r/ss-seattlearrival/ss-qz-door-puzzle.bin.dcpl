                }
                lambda {
                    npc-request-hold(dina, 10.00);
                }
                lambda {
                    npc-request-hold(horse, 10.00);
                }
                lambda {
                    signal(dina-horse, 0);
                }
            }
            track horse-idle {
                lambda {
                    if (get-boolean(playing-horse-idle, self)) {
                        while (npc-on-screen-and-visible?(horse, -1, 0)) {
                            wait-one-frame();
                        }
                        if (!get-boolean(dina-on-horse, self)) {
                            u64? var_3 = #%alloc-array(single-frame, 16, 4, 1);
                            *(i32*)*var_3[0] = 10;
                            *(u64*)(*var_3[0] + 8) = 0;
                            *(u64*)(*var_3[0] + 8) = get-spawner-locator(ap-sea-horse-gate-open-3, 1);
                            *(i32*)*var_3[1] = 28;
                            *(u64*)(*var_3[1] + 8) = 0;
                            *(f32*)(*var_3[1] + 8) = 0.00;
                            *(i32*)*var_3[2] = 30;
                            *(u64*)(*var_3[2] + 8) = 0;
                            *(f32*)(*var_3[2] + 8) = 0.50;
                            *(i32*)*var_3[3] = 13;
                            *(u64*)(*var_3[3] + 8) = 0;
                            *(i32*)(*var_3[3] + 8) = 2;
                            animate_(player-horse, sea-qz-door-open-gates-idle--horse, var_3);
                        }
                    }
                }
            }
            track task-complete {
                lambda {
                    wait-for-event(
                        leaving-gate,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0,
                        0
                    );
                }
                lambda {
                    task-complete!(seattle-arrival, sea-qz-door-puzzle-complete);
                }
                lambda {
                    wait-for(dina-horse);
                }
                lambda {
                    go(complete, 1);
                }
            }
            track path-to-horse {
                lambda {
                    set-accessibility-pathfind-goal-horse(horse);
                }
            }
            track fake-rope {
                lambda {
                    if (!has-collected-treasure?(collectible-sea-hub-map, 0)) {
                        interactable-camera-remap-default(collect-sea-hub-sea-map-1);
                    }
                }
                lambda {
                    interactable-camera-remap-default(int-sea-qz-puz-generator-1);
                }
                lambda {
                    while (1) {
                        while (!player-on-horse?(horse, 1, 1, 1)) {
                            wait-one-frame();
                        }
                        set-boolean(suspend-idles, 0, ss-horse-rider-idle-controller);
                        spawn-entity(obj-sea-qz-fake-rope-1, 0, 0);
                        wait-one-frame();
                        while (player-on-horse?(horse, 1, 1, 1)) {
                            wait-one-frame();
                        }
                        kill-entity(obj-sea-qz-fake-rope-1);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (!player-on-horse?(horse, 1, 1, 1)) {
                        horse-force-regular-idle/f(player-horse);
                    }
                }
            }
        }
    }
    state puzzle-skipped {
        block start {
            track main {
                lambda {
                    collect-treasure(collectible-seattle-map);
                }
                lambda {
                    collect-treasure(collectible-sea-qz-generator-note);
                }
                lambda {
                    task-skip-to!(seattle-arrival, sea-qz-door-puzzle-complete, 0, 0, 0);
                }
            }
        }
    }
