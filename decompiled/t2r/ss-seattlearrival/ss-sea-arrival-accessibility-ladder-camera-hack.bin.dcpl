statescript {
    options {
        player
        sea-arrival-accessibility
    }
    declarations {
    }
    state wait-for-ladder-mount {
        block event_player-changed-state {
            track main {
                lambda {
                    if (event-arg-symbol(0) == Ladder && event-arg-symbol(1) == Move && player-in-region?(self, 2)) {
                        go(adjust-camera, 1);
                    }
                }
            }
        }
    }
    state adjust-camera {
        block start {
            track main {
                lambda {
                    if (is-auto-traversal-accessibility?()) {
                        camera-look-at-locator(get-spawner-locator(tag-symbol(camera-look-at, self), 1), 1.00, 5.00);
                    }
                }
                lambda {
                    while (!!player-in-state?(Ladder)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    go(wait-for-ladder-mount, 1);
                }
            }
        }
    }
}
