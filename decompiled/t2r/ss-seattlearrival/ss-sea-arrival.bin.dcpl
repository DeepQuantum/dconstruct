                    wait-for-player-respawn(ellie-skel);
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    sea-arrival-ammo-adjustments();
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state first-state {
        block start {
            track dina {
                lambda {
                    wait(1.00);
                }
                lambda {
                    while (!(get-player-speed() > 0.10)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    wait-script-caption(dina, "What are these woods? Are we lost?", -1.00, 0, 0);
                }
                lambda {
                    wait(0.50);
                }
                lambda {
                    signal(wheel-tut, 0);
                }
                lambda {
                    set-int32(player-choice, wait-spoke-n-dialog(
                        3,
                        "Lost",
                        "Almost there",
                        "Better idea?",
                        ".",
                        ".",
                        ".",
                        ".",
                        ".",
                        -1.00
                    ), self);
                }
                lambda {
                    u64? var_0 = get-int32(player-choice, self);
                    if (var_0 == 1) {
                        var_1 = wait-script-caption(player, "Yeah, we are supposed to have seen a 40 ft wall by now...", -1.00, 0, 0);
                    } else {
                        u16 var_3;
                        if (var_0 == 2) {
                            var_3 = wait-script-caption(player, "We are almost there, just on the other side of this forest.", -1.00, 0, 0);
                        } else {
                            u16 var_5;
                            if (var_0 == 3) {
                                var_5 = wait-script-caption(player, "You wanna take the reins?", -1.00, 0, 0);
                            } else if (var_0 == 0) {
                                var_5 = wait-script-caption(dina, "Yeah, we are definitely lost...", -1.00, 0, 0);
                            } else {
                                var_5 = 0;
                            }
                            var_3 = var_5;
                        }
                        var_1 = var_3;
                    }
                }
                lambda {
                    go(complete, 1);
                }
            }
            track tutorial {
                lambda {
                    wait-for(wheel-tut);
                }
                lambda {
                    wait(0.50);
                }
                lambda {
                    hud-play-tutorial(HUD_DIALOG_TUTORIAL_1, 12.00, 2, none, 0.50, 0, 0, 0);
                }
                lambda {
                    while (!(get-joypad-touch-count() > 0)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    wait(5.00);
                }
                lambda {
                    while (!(get-joypad-touch-count() == 0)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    hud-clear-tutorials(0);
                }
            }
        }
    }
}
