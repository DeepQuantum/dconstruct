                }
                lambda {
                    if (*(u8 *)(*mburro-test* + 1)) {
                        foreach (u16 var_2 : sea-horse-map-X-layers) {
                            set-table-shader-material-values-param(var_2, 0.25);
                        }
                    } else {
                        foreach (u16 var_6 : sea-horse-map-X-layers) {
                            f32 var_10;
                            if (get-svar-bit(sea-horse-poi-check, darray-find(sea-horse-map-X-layers, boxed_symbol(var_6), 0))) {
                                var_10 = 0.25;
                            } else {
                                var_10 = 0.00;
                            }
                            set-table-shader-material-values-param(var_6, var_10);
                        }
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (!player-in-state?(Investigate)) {
                        set-single-shader-instance-param(get-symbol(my-map, self), blendOffset2, -1.00);
                        go(cross-off, 1);
                    }
                }
                lambda {
                    update-sea-hub-map-chevron(pos-sea-hub-map-top-1, pos-sea-hub-map-bot-1);
                }
                lambda {
                    if (get-state-time(self) > 0.65) {
                        camera-override-near-clip/f(0.01);
                    }
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
