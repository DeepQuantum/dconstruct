                    animate-done(obj-sea-horse-mil-jacket-door-1, sea-hub-hotel-lobby-door--door, ap-sea-horse-tommys-jacket-1, 0, 0, 2);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
