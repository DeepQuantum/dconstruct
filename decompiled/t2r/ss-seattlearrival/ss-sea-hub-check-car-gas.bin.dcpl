statescript {
    options {
        player
        sea-hub-explore-script
    }
    state task-check {
        block start {
            track main {
                lambda {
                    if (task-complete?(seattle-arrival, sea-hub-explore)) {
                        go(already-complete, 1);
                    }
                }
                lambda {
                    if (task-active?(seattle-arrival, sea-hub-explore)) {
                        if (get-svar-as-boolean(sea-horse-library-open)) {
                            go(already-complete, 1);
                        }
                        go(wait-interact, 1);
                    }
                }
                lambda {
                    if (task-active?(seattle-arrival, sea-hub-explore-intro)) {
                        foreach (u16 var_3 : sea-horse-gas-tanks) {
                            interactable-disable(var_3);
                        }
                    }
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-active?(seattle-arrival, sea-hub-explore)) {
                        foreach (u16 var_3 : sea-horse-gas-tanks) {
                            interactable-enable(var_3);
                        }
                        go(wait-interact, 1);
                    }
                }
                lambda {
                    if (task-active?(seattle-arrival, sea-hub-explore-intro)) {
                        foreach (u16 var_3 : sea-horse-gas-tanks) {
                            interactable-disable(var_3);
                        }
                    }
                }
            }
        }
    }
    state wait-interact {
        block event_player-requested-interact {
            track main {
                lambda {
                    go(that-no-work, 1);
                }
            }
        }
    }
    state that-no-work {
        block start {
            track main {
                lambda {
                    foreach (u16 var_2 : sea-horse-gas-tanks) {
                        interactable-disable(var_2);
                    }
                }
                lambda {
                    set-svar(sea-horse-library-open, 1);
                }
                lambda {
                    auto-save-game();
                }
                lambda {
                    wait-script-caption(player, "Completely empty.", -1.00, 0, 0);
                }
                lambda {
                    wait-script-caption(dina, "Looks like someone already hit all these cars long ago", -1.00, 0, 0);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    foreach (u16 var_2 : sea-horse-gas-tanks) {
                        interactable-disable(var_2);
                    }
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
