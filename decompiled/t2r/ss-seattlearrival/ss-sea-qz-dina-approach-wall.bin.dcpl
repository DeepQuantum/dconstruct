                    if (!get-boolean(lead-to-roof?, self)) {
                        if (distance-between-objects-greater-than?(player, dina, 10.00, 1)) {
                            wait-say(player, vox-igc-ell-gam-sea-qz-wall-gate-continued-sp-011, 2, 0);
                        } else {
                            wait-say(player, vox-igc-ell-gam-sea-qz-wall-gate-continued-sp-010, 2, 0);
                        }
                        wait(0.30);
                        if (distance-between-objects-greater-than?(player, dina, 10.00, 1)) {
                            wait-say(dina, vox-igc-din-gam-sea-qz-wall-gate-continued-spj-010, 2, 0);
                        } else {
                            wait-say(dina, vox-igc-din-gam-sea-qz-wall-gate-continued-sp-009, 2, 0);
                        }
                    }
                }
            }
        }
        block event end-roof-dina {
            track main {
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
