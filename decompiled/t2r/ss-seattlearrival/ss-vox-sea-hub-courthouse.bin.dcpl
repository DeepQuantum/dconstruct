                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    suppress-all-hints/f();
                }
            }
        }
    }
    state jump-on-elevator-rope {
        block start {
            track main {
                lambda {
                    while (!player-in-state?(RopeClimb)) {
                        wait(0.10);
                    }
                }
                lambda {
                    set-svar(vox-sea-hub-courthouse-elevator-rope, 1);
                }
                lambda {
                    wait(0.50);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gam-sea-horse-approach-forest-continued-sp-006, 2, 0);
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
    }
}
