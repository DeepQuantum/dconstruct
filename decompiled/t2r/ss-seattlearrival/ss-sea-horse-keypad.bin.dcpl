                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 3, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-spawner-locator(pos-sea-horse-keypad-2, 1);
                    *(i32*)*var_0[1] = 28;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 0.30;
                    *(i32*)*var_0[2] = 30;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.50;
                    animate_(obj-sea-horse-keypad-1, sea-hub-keypad-succeed--keypad, var_0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 5, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-spawner-locator(pos-sea-horse-keypad-2, 1);
                    *(i32*)*var_0[1] = 28;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 0.30;
                    *(i32*)*var_0[2] = 61;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(i32*)(*var_0[2] + 8) = 25;
                    *(i32*)*var_0[3] = 60;
                    *(u64*)(*var_0[3] + 8) = 0;
                    *(f32*)(*var_0[3] + 8) = 0.50;
                    *(i32*)*var_0[4] = 30;
                    *(u64*)(*var_0[4] + 8) = 0;
                    *(f32*)(*var_0[4] + 8) = 0.50;
                    wait-animate_(player, sea-hub-keypad-exit--ellie, var_0);
                }
                lambda {
                    camera-fade-out-animated(2.00, 0);
                }
                lambda {
                    broadcast-event(keypad-exited, boxed_symbol(get-self-id()));
                }
                lambda {
                    if (get-svar(sea-horse-finding-gas) < 7) {
                        interactable-set-unavailable(int-sea-horse-keypad-1, 1);
                        override-interact-def(int-sea-horse-keypad-1, interact-needs-power-npc-blockable);
                        interactable-enable(int-sea-horse-keypad-1);
                    } else {
                        interactable-enable(int-sea-horse-keypad-1);
                    }
                }
                lambda {
                    if (get-boolean(exit-to-look-at-col, self)) {
                        wait(0.10);
                        menu2-push-player-menu(2);
                    }
                }
                lambda {
                    go(wait-interact, 1);
                }
            }
        }
        block update {
            track main {
                lambda {
                    menu2-set-desired-player-menu-tab/f(2);
                }
                lambda {
                    camera-shake(camera-mocap-idle-small, 1.00, 1.00, 1);
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    interactable-disable(int-sea-horse-keypad-1);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
    state complete {
        block start {
            track main {
                lambda {
                    if (!(get-symbol(w-button-prompt-stack, self) == 0)) {
                        hud2-hide-lock-minigame(get-symbol(w-button-prompt-stack, self), 1);
                        set-symbol(w-button-prompt-stack, 0, self);
                    }
                }
            }
        }
    }
}
