statescript {
    options {
        player
    }
    declarations {
        timer poi-check-timer = nullptr
    }
    state task-check {
        block start {
            track main {
                lambda {
                    if (task-complete?(seattle-arrival, sea-hub-explore)) {
                        go(already-complete, 1);
                    }
                }
                lambda {
                    if (task-active?(seattle-arrival, sea-hub-explore)) {
                        go(poi-check, 1);
                    }
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    if (task-active?(seattle-arrival, sea-hub-explore)) {
                        go(poi-check, 1);
                    }
                }
            }
        }
    }
    state poi-check {
        block event_check-enter {
            track main {
                lambda {
                    start-timer(poi-check-timer, 5.00, self, 1);
                }
            }
        }
        block event_check-exit {
            track main {
                lambda {
                    if (!timer-running?(poi-check-timer, self)) {
                        if (get-svar-bit(sea-horse-poi-check, event-arg-int32(0))) {
                            script-caption(dina, "Mark that location off the map!", -1.00, 0, 0);
                        } else {
                            script-caption(dina, "That place was interesting, we should come back", -1.00, 0, 0);
                        }
                    }
                }
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
