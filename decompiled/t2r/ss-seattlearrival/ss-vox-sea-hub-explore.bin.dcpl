    state next-location-hint {
        block start {
            track vox {
                lambda {
                    send-event(leave-convo, ss-vox-sea-hub-interruptible-conversations-1);
                }
                lambda {
                    no-hub-conversations();
                }
                lambda {
                    while (!!(task-continue-active?(seattle-arrival, sea-hub-explore, courthouse-fight))) {
                        wait(0.10);
                    }
                }
                lambda {
                    while (!player-in-state?(Move)) {
                        wait(0.10);
                    }
                }
                lambda {
                    if (!(get-svar-as-boolean(vox-sea-hub-dome-stash))) {
                        no-hub-conversations();
                        if (mid-convo?(get-symbol(cur-convo, ss-conversation-manager-1))) {
                            stop-conversation-for-interrupt();
                        }
                        stop-speaking(player);
                        signal(interruption-1, 0);
                        wait-say(player, vox-igc-ell-gam-sea-hub-explore-cache-clear-sp-002, 2, 0);
                        wait(0.30);
                        wait-say(dina, vox-igc-din-gam-sea-hub-explore-cache-clear-sp-002, 2, 0);
                        wait(0.50);
                        wait-say(dina, vox-igc-din-gam-sea-hub-explore-cache-clear-sp-007, 2, 0);
                    } else if (!(get-svar-as-boolean(vox-sea-hub-courthouse-stash))) {
                        no-hub-conversations();
                        if (mid-convo?(get-symbol(cur-convo, ss-conversation-manager-1))) {
                            stop-conversation-for-interrupt();
                        }
                        stop-speaking(player);
                        signal(interruption-1, 0);
                        send-event(complete-poi, ss-sea-horse-map-writing-1, boxed_i32(2), boxed_f32(1.00));
                        wait-say(player, vox-igc-ell-gam-sea-hub-explore-cache-clear-sp-001, 2, 0);
                        wait(0.30);
                        wait-say(dina, vox-igc-din-gam-sea-hub-explore-cache-clear-sp-001, 2, 0);
                        wait(0.50);
                        wait-say(dina, vox-igc-din-gam-sea-hub-explore-cache-clear-sp-007, 2, 0);
                    } else {
                        no-hub-conversations();
                        if (mid-convo?(get-symbol(cur-convo, ss-conversation-manager-1))) {
                            stop-conversation-for-interrupt();
                        }
                        stop-speaking(player);
                        signal(interruption-2, 0);
                        if (get-svar(sea-horse-finding-gas) == 6) {
                            send-event(complete-poi, ss-sea-horse-map-writing-1, boxed_i32(2), boxed_f32(0.20));
                        }
                        wait(1.00);
                        wait-say(player, vox-igc-ell-gam-sea-hub-explore-return-to-gate-sp-004, 2, 0);
                        wait(1.00);
                        if (!get-svar-as-boolean(sea-horse-petstore-open)) {
                            wait-say(dina, vox-igc-din-gam-sea-hub-explore-cache-clear-sp-006, 2, 0);
                            wait(0.30);
                            wait-say(dina, vox-igc-din-gam-sea-hub-explore-cache-clear-sp-007, 2, 0);
                            wait(0.30);
                            wait-say(player, vox-igc-ell-gam-sea-hub-explore-cache-clear-sp-004, 2, 0);
                        }
                        hub-conversations-ok();
                        while (!npc-on-horse?(dina, horse, 1, 1, 1)) {
                            wait(0.10);
                        }
                        wait(2.00);
                        wait-say(dina, vox-igc-din-gam-sea-hub-explore-cache-clear-sp-009, 2, 0);
                    }
                }
                lambda {
                    hub-conversations-ok();
                }
                lambda {
                    wait(3.00);
                }
                lambda {
                    while (player-in-state?(RideHorse) && !npc-on-horse?(dina, horse, 1, 1, 1)) {
                        wait(0.10);
                    }
                }
                lambda {
                    if (!(get-svar-as-boolean(vox-sea-hub-dome-stash)) && !(get-svar-as-boolean(vox-sea-hub-courthouse-stash))) {
                        send-event(first-location-done-a, ss-vox-sea-hub-interruptible-conversations-1);
                    } else {
                        send-event(both-locations-done-a, ss-vox-sea-hub-interruptible-conversations-1);
                    }
                }
                lambda {
                    hub-conversations-ok();
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
            track interruption-1 {
                lambda {
                    wait-for(interruption);
                }
                lambda {
                    conversation-stop(player);
                }
            }
            track interruption-2 {
                lambda {
                    wait-for(interruption);
                }
                lambda {
                    conversation-stop(dina);
                }
            }
        }
        block update {
            track main {
                lambda {
                    player-disable-dialog-look-gestures(0.00);
                }
            }
        }
        block event_enter {
            track main {
                lambda {
                    if (get-svar-as-boolean(vox-sea-hub-dome-stash) && get-svar-as-boolean(vox-sea-hub-courthouse-stash)) {
                        if (!!(convo-paused?())) {
                            if (!get-svar-as-boolean(vox-sea-hub-leaving-hub)) {
                                set-svar(vox-sea-hub-leaving-hub, 1);
                                go(has-gas-towards-gate, 1);
                            }
                        }
                    }
                }
            }
        }
        block event_on-set-active-continue {
            track main {
                lambda {
                    if (get-svar-as-boolean(vox-sea-hub-dome-stash) && get-svar-as-boolean(vox-sea-hub-courthouse-stash) || task-continue-active?(seattle-arrival, sea-hub-explore, hotel-gate)) {
                        if (task-continue-active?(seattle-arrival, sea-hub-explore, hotel-gate-with-gas)) {
                            go(done, 1);
                        }
                    }
                }
            }
        }
    }
