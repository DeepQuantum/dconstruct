                lambda {
                    set-svar(vox-sea-hub-see-hotel, 1);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gam-sea-sea-hub-explore-freeway-bridge-001, 2, 0);
                }
                lambda {
                    wait-say(player, vox-igc-ell-gam-sea-sea-hub-explore-freeway-bridge-001, 2, 0);
                }
                lambda {
                    wait-say(dina, vox-igc-din-gam-sea-sea-hub-explore-freeway-bridge-002, 2, 0);
                }
