                            if (!(get-boolean(vox-heard-hint?, self)) || task-continue-active?(seattle-arrival, sea-hub-explore, default) || task-continue-active?(seattle-arrival, sea-hub-explore, freeway-south) || task-continue-active?(seattle-arrival, sea-hub-explore, freeway-underpass) || task-continue-active?(seattle-arrival, sea-hub-explore, collapse-building-hill) || task-continue-active?(seattle-arrival, sea-hub-explore, library) || task-continue-active?(seattle-arrival, sea-hub-explore, courthouse-steps) || task-continue-active?(seattle-arrival, sea-hub-explore, courthouse-side) || task-continue-active?(seattle-arrival, sea-hub-explore, checkpoint) && task-continue-active?(seattle-arrival, sea-hub-explore, old-city-hall)) {
                                set-boolean(vox-heard-hint?, 1, self);
                                set-boolean(vox-hearing-hints?, 1, self);
                                while (!!(is-any-major-character-speaking?())) {
                                    wait(0.10);
                                }
                                wait-say(dina, vox-igc-din-gam-sea-hub-explore-goal-reminders-sp-011, 2, 0);
                                wait(0.30);
                                wait-say(player, vox-igc-ell-gam-sea-hub-explore-goal-reminders-sp-005, 2, 0);
                                set-boolean(vox-hearing-hints?, 0, self);
                            }
                        }
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    if (mid-convo?(get-symbol(cur-convo, ss-conversation-manager-1)) && get-convo-state(current-convo(), 2) && !(get-boolean(vox-no-conversations?, self)) && !(get-boolean(vox-no-region-conversation?, self)) && player-in-state?(RideHorse) && npc-on-horse?(dina, horse, 1, 1, 1)) {
                        go(restart-convo, 1);
                    }
                }
                lambda {
                    if (!(get-boolean(vox-can-play-convos?, self)) && !(mid-convo?(get-symbol(cur-convo, ss-conversation-manager-1))) && !(get-boolean(vox-no-conversations?, self)) && !(get-boolean(vox-no-region-conversation?, self)) && player-in-state?(RideHorse) && npc-on-horse?(dina, horse, 1, 1, 1)) {
                        set-boolean(vox-can-play-convos?, 1, self);
                    }
                }
            }
        }
        block event_on-set-active-continue {
            track main {
                lambda {
                    if (get-svar-as-boolean(vox-sea-hub-dome-stash) && get-svar-as-boolean(vox-sea-hub-courthouse-stash) || task-continue-active?(seattle-arrival, sea-hub-explore, hotel-gate)) {
                        if (task-continue-active?(seattle-arrival, sea-hub-explore, hotel-gate-with-gas)) {
                            go(done, 1);
                        }
                    }
                }
            }
        }
        block event_find-dome-empty {
            track main {
                lambda {
                    go(empty-gas-cans-dome, 1);
                }
            }
        }
        block event_find-courthouse-empty {
            track main {
                lambda {
                    go(empty-gas-cans-courthouse, 1);
                }
            }
        }
        block event_courthouse-stash {
            track main {
                lambda {
                    if (!(get-svar-as-boolean(vox-sea-hub-courthouse-stash))) {
                        set-svar(vox-sea-hub-courthouse-stash, 1);
                        go(next-location-hint, 1);
                    }
                }
            }
        }
        block event_next-location-hint {
            track main {
                lambda {
                    go(next-location-hint, 1);
                }
            }
        }
        block event_complete-area {
            track main {
                lambda {
                    go(complete-area, 1);
                }
            }
        }
        block event_enter {
            track main {
                lambda {
                    if (get-svar-as-boolean(vox-sea-hub-dome-stash) && get-svar-as-boolean(vox-sea-hub-courthouse-stash)) {
                        if (!get-boolean(vox-no-conversations?, ss-vox-sea-hub-explore-1)) {
                            if (!get-svar-as-boolean(vox-sea-hub-leaving-hub)) {
                                set-svar(vox-sea-hub-leaving-hub, 1);
                                go(has-gas-towards-gate, 1);
                            }
                        }
                    }
                }
            }
        }
    }
    state complete-area {
        block start {
            track main {
                lambda {
                    say(player, vox-igc-ell-gam-sea-qz-transition-to-hub-pickups-sp-015, 2, 0);
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
    }
    state restart-convo {
        block start {
            track main {
                lambda {
                    wait(2.00);
                }
                lambda {
                    if (mid-convo?(get-symbol(cur-convo, ss-conversation-manager-1)) && get-convo-state(current-convo(), 2) && !(get-boolean(vox-no-conversations?, self)) && !(get-boolean(vox-no-region-conversation?, self))) {
                        set-boolean(vox-can-play-convos?, 0, ss-vox-sea-hub-explore-1);
                        convo-restart?();
                    }
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
    }
    state see-hotel {
        block start {
