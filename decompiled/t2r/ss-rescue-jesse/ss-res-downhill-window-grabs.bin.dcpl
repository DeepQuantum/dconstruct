            track rumble {
                lambda {
                    wait-until-frame(26);
                }
                lambda {
                    start-rumble(melee-standing-finisher-strong-rumble-settings, 0);
                }
                lambda {
                    camera-animation-enable(melee-camera-shake, camera-shake-melee-hit-b, 0.00, 1.50, 0.10, 1, 1.00);
                }
            }
            track haptics {
                lambda {
                    while (!object-anim-reached-frame?(player, res-downhill-jesse-grab-melee--ellie, 140.00, 2)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    play-hfx-id(sub-sniper-intro-haptic-car, 0, 2);
                }
            }
            track lighting {
                lambda {
                    wait-until-frame(105);
                }
                lambda {
                    turn-off-light(rt-stabbing-1Shape-1, 0);
                }
            }
            track vox {
                lambda {
                    say(player, vox-igc-ell-igc-res-downhill-jesse-grab-melee-001, 2, 0);
                }
                lambda {
                    say(jesse, vox-igc-jes-igc-res-downhill-jesse-grab-melee-001, 2, 0);
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    set-boolean(vox-jesse-grab-done, 1, ss-vox-res-downhill-pre-roll-controller-1);
                }
                lambda {
                    wait-until-anim-phase(player, res-downhill-jesse-grab-melee--ellie, 0.24, 2);
                }
                lambda {
                    say(npc-res-downhill-grab-jesse-1, vox-eff-gen-death-melee-sharp-stab, 2, 0);
                }
            }
            track npcs {
                lambda {
                    send-event(spawn-npcs-reverse, ss-res-downhill-start-npcs-1);
                }
                lambda {
                    send-event(spawn-npcs-reverse, ss-res-downhill-reverse-1);
                }
                lambda {
                    wait-until-frame(112);
                }
                lambda {
                    send-event(run-into-position, ss-res-downhill-reverse-1);
                }
                lambda {
                    wait-until-frame(140);
                }
                lambda {
                    send-event(open-fire, ss-res-downhill-reverse-1);
                }
                lambda {
                    player-instant-draw-weapon-by-name(pistol-beretta, 0.00, 1);
                }
            }
        }
        block end {
            track main {
                lambda {
                    melee-fact-set-bool(jesse, buddy-low-health-state, 0);
                }
            }
        }
    }
    state cleanup {
        block start {
            track main {
                lambda {
                    turn-off-light(rt-stabbing-1Shape-1, 0);
                }
                lambda {
                    melee-fact-set-bool(jesse, buddy-low-health-state, 0);
                }
                lambda {
                    npc-die-if-alive(npc-res-downhill-grab-jesse-1);
                }
                lambda {
                    task-complete!(rescue-jesse, res-downhill-jesse-grab);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
