                        wait-frames(6);
                        rumble-curve(0.40, 0.40, 0.20, 1, 0);
                        wait-frames(6);
                        rumble-curve(0.40, 0.10, 0.40, 1, 0);
                        wait-frames(107);
                        rumble-curve(0.10, 0.30, 1.83, 4, 0);
                        wait-frames(55);
                        rumble-curve(0.30, 0.30, 1.00, 1, 0);
