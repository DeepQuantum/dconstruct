                    }
                }
                lambda {
                    if (get-int32(starting-arrow-count, self) > 0) {
                        set-visible(obj-res-neighborhood-arrow-3, 0);
                    }
                }
                lambda {
                    if (get-int32(starting-arrow-count, self) > 1) {
                        set-visible(obj-res-neighborhood-arrow-4, 0);
                    }
                }
                lambda {
                    wait-frames(1);
                }
                lambda {
                    kill-entity(obj-res-neighborhood-arrow-1);
                }
                lambda {
                    if (get-difficulty-setting-resources() == 4 && !(get-difficulty-setting-resources() == 5)) {
                        kill-entity(obj-res-neighborhood-arrow-2);
                    }
                }
                lambda {
                    if (get-int32(starting-arrow-count, self) > 0) {
                        kill-entity(obj-res-neighborhood-arrow-3);
                    }
                }
                lambda {
                    if (get-int32(starting-arrow-count, self) > 1) {
                        kill-entity(obj-res-neighborhood-arrow-4);
                    }
                }
                lambda {
                    signal(bow-done, 0);
                }
            }
            track dead-guy-anim {
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 1, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-spawner-locator(ap-res-retail-street-take-bow-1, 1);
