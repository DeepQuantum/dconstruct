                    } else if (get-int32(starting-arrow-count, self) > 2) {
                        var_2 = 4;
                    } else {
                        var_2 = 2 + get-int32(starting-arrow-count, self);
                    }
                    inventory-item-add-quantity(ammo-arrow, var_2);
                }
                lambda {
                    wait-one-frame();
                }
                lambda {
                    set-visible(obj-res-neighborhood-arrow-1, 0);
