        }
    }
    state ellie-jump-in-after {
        block start {
            track main {
                lambda {
                    while (!player-in-state?(Swim)) {
                        wait-one-frame();
                    }
                }
                lambda {
                    if (joypad-has-haptics?(2)) {
                        play-hfx-id(efm-fall-in-water, 0, 2);
                    }
                }
                lambda {
                    go(task-complete, 1);
                }
            }
        }
    }
    state task-complete {
        block start {
            track main {
                lambda {
                    set-overlay-set(player, anim-overlay-player-level-specific-default);
                }
                lambda {
                    task-complete!(ellie-flashback-museum, efm-swim-push-joel-in);
                }
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
