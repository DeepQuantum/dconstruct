                        set-object-locator(get-symbol(current-interactable, ss-optional-conversation-1), offset-locator(flatten-locator(get-joint-locator(player, heada)), alloc-vector(0.00, 0.30, 0.00, 1.00, 0)));
                    }
                }
            }
        }
        block event player-requested-interact {
            track main {
                lambda {
                    if (event-arg-symbol(0) == int-secret-files-optional-conversation-1) {
                        interactable-disable(get-symbol(current-interactable, ss-optional-conversation-1));
                        set-symbol(current-interactable, NONE, ss-optional-conversation-1);
                        go(secret-files-opt-convo, 1);
                    }
                }
            }
        }
    }
