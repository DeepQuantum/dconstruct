    state wait-optional-convo {
        block start {
            track main {
                lambda {
                    interactable-enable(get-symbol(current-interactable, ss-optional-conversation-1));
                }
                lambda {
                    wait(15.00);
                }
                lambda {
                    if (interactable-enabled?(get-symbol(current-interactable, ss-optional-conversation-1))) {
                        interactable-disable(get-symbol(current-interactable, ss-optional-conversation-1));
                        set-symbol(current-interactable, NONE, ss-optional-conversation-1);
                    }
                }
                lambda {
                    go(wait-for-event, 1);
                }
            }
        }
