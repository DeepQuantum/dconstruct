                        set-effect-float(var_1, speedDustSm, 0.50);
                        set-effect-float(var_1, speedDustLg, 0.20);
                        set-effect-float(var_1, speedDirt, 1.00);
                        set-effect-float(var_2, dustOpacitySmall, 0.00);
                        set-effect-float(var_2, dustScaleSmall, 0.80);
                        set-effect-float(var_2, dustOpacityLarge, 0.00);
                        set-effect-float(var_2, dustScaleLarge, 1.50);
                        set-effect-float(var_2, dirtScale, 1.00);
                        set-effect-float(var_2, dustLifespanSmall, 2.20);
