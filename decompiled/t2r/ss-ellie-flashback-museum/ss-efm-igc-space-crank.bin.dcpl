                    *(i32*)*var_0[4] = 61;
                    *(u64*)(*var_0[4] + 8) = 0;
                    *(i32*)(*var_0[4] + 8) = 11;
                    wait-animate_(player, efm-discover-museum-space-crank-exit--ellie, var_0);
                }
                lambda {
                    set-animation-speed(obj-gravity-table-crank-1, 0.00, 2, 0);
                }
                lambda {
                    stop-animating(obj-gravity-table-crank-1, 2, 0.10, efm-discover-museum-space-crank-loop-06-end--crank, 0);
                }
                lambda {
                    go(wait-interact, 1);
                }
            }
        }
    }
