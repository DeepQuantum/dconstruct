                            mars,
                            0,
                            0,
                            root,
                            2,
                            0,
                            2,
                            0
                        );
                        set-effect-float(var_1, dustOpacitySmall, 0.00);
                        set-effect-float(var_1, dustScaleSmall, 0.80);
                        set-effect-float(var_1, dustOpacityLarge, 0.00);
                        set-effect-float(var_1, dustScaleLarge, 1.50);
                        set-effect-float(var_1, dirtScale, 1.00);
