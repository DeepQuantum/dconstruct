            }
            track haptics {
                lambda {
                    if (joypad-has-haptics?(2)) {
                        set-int32(crank-haptic-pid, play-hfx-id(efm-space-crank-haptic, 0, 2), self);
                    }
                }
            }
        }
        block update {
            track main {
                lambda {
                    set-float(light-output, evaluate-point-curve(lookup-symbol(*light-output-curve*, point-curve), get-float(input-speed, self)), self);
                }
                lambda {
                    set-single-shader-instance-param(obj-orrery-1, blendOffset0, get-float(light-output, self));
                }
                lambda {
                    set-light-process-intensity(superPoint-oreyShape-1, get-float(light-output, self));
                }
                lambda {
                    set-light-process-volumetric-intensity(superPoint-oreyShape-1, get-float(light-output, self));
                }
                lambda {
                    set-float(filtered-speed, evaluate-point-curve(lookup-symbol(*orrery-spin*, point-curve), get-float(input-speed, self)), self);
                }
                lambda {
                    if (get-float(input-speed, self) < 0.50 && get-float(filtered-input-ui, self) < 1.00) {
                        set-float(filtered-input-ui, lerp(get-float(filtered-input-ui, self), get-float(input-speed, self), 0.10), self);
                        if (!get-boolean(requested-exit, self)) {
                            hud2-show-interactable-hold(interact-default-hold, get-object-locator(obj-gravity-table-crank-1), get-float(filtered-input-ui, self), 1);
                        }
                    }
                }
                lambda {
                    if (joypad-command-active?(interact-hold, 6)) {
                        if (get-float(input-speed, self) < 1.00) {
                            set-float(input-speed, get-float(input-speed, self) + 0.00, self);
                        }
                    } else {
                        set-float(input-speed, get-float(input-speed, self) - 0.00, self);
                        clamp-var(input-speed, 0.00, 1.00, self);
                        if (get-float(input-speed, self) > 0.30) {}
 else {
                            set-float(filtered-speed, 0.30, self);
                            if (get-float(input-speed, self) < 0.30 && get-animation-phase(player, 2, 0) > 0.95 && !get-boolean(requested-exit, self)) {
                                go(wait-crank, 1);
                            }
                        }
                    }
                }
                lambda {
                    if (joypad-command-active?(menu-back, 6) && joypad-stick-pressed-towards?(move, get-spawner-locator(pos-stick-backward-exit-crank-1, 1), 0, 180.00, 0.00)) {
                        set-boolean(requested-exit, 1, self);
                    }
                }
                lambda {
                    if (!(joypad-command-active?(interact-hold, 6)) && get-float(input-speed, self) > 0.50) {
                        go(end-crank, 1);
                    }
                }
                lambda {
                    set-animation-speed(player, get-float(filtered-speed, self), 2, 0);
                }
                lambda {
                    set-animation-speed(obj-orrery-1, get-float(filtered-speed, self), 2, 0);
                }
                lambda {
                    set-planet-speed(get-float(input-speed, self));
                }
                lambda {
                    set-animation-speed(obj-gravity-table-crank-1, get-float(filtered-speed, self), 2, 0);
                }
                lambda {
                    if (joypad-has-haptics?(2)) {
                        hfx-ramp-internal(
                            get-int32(crank-haptic-pid, self),
                            0,
                            0,
                            alloc-parameter-ramp-internal(
                                0.33 * evaluate-point-curve(lookup-symbol(*orrery-rumble-curve*, point-curve), get-animation-phase(player, 2, 0)),
                                0.00,
                                256.00 / 48000.00,
                                0.00,
                                1,
                                0.00,
                                0
                            ),
                            1
                        );
                        hfx-ramp-internal(
                            get-int32(crank-haptic-pid, self),
                            0,
                            2,
                            alloc-parameter-ramp-internal(
                                evaluate-point-curve(lookup-symbol(*orrery-haptic-pan-curve*, point-curve), get-animation-phase(player, 2, 0)),
                                0.00,
                                256.00 / 48000.00,
                                0.00,
                                1,
                                0.00,
                                0
                            ),
                            1
                        );
                        hfx-continue(get-int32(crank-haptic-pid, self));
                    } else {
                        rumble(0.60 * evaluate-point-curve(lookup-symbol(*orrery-rumble-curve*, point-curve), get-animation-phase(player, 2, 0)));
                    }
                }
            }
        }
    }
    state exit-crank-stopped {
        block start {
            track main {
                lambda {
                    camera-fade-out-animated-stick(2.00);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 5, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-spawner-locator(ap-crank-1, 1);
                    *(i32*)*var_0[1] = 28;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(f32*)(*var_0[1] + 8) = 0.30;
                    *(i32*)*var_0[2] = 30;
                    *(u64*)(*var_0[2] + 8) = 0;
                    *(f32*)(*var_0[2] + 8) = 0.30;
