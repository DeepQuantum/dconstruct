                }
            }
            track crank {
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 2, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-spawner-locator(ap-crank-1, 1);
                    *(i32*)*var_0[1] = 59;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(i32*)(*var_0[1] + 8) = 1;
                    wait-animate_(obj-gravity-table-crank-1, efm-discover-museum-space-crank-loop-06-end--crank, var_0);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 2, 1);
                    *(i32*)*var_0[0] = 10;
                    *(u64*)(*var_0[0] + 8) = 0;
                    *(u64*)(*var_0[0] + 8) = get-spawner-locator(ap-crank-1, 1);
                    *(i32*)*var_0[1] = 31;
                    *(u64*)(*var_0[1] + 8) = 0;
                    *(u8*)(*var_0[1] + 8) = 1;
                    wait-animate_(obj-gravity-table-crank-1, efm-discover-museum-space-crank-loop-06-end--crank, var_0);
