}

u16 flo--stormy-seas-reset-wave-spline(u64? arg_0) {
    u64 i = 0;
    while (i < get-spline-index-count(spl-flo-stormy-seas-wave-path-1)) {
        set-spline-point-locator(spl-flo-stormy-seas-wave-path-1, i, offset-locator-on-axis(arg_0, (f32)i, 2));
        i = i + 1;
    }
    return i;
}

u16 flo--stormy-seas-init-wave-spline(u64? arg_0) {
    u64 i = 0;
    while (i < get-spline-index-count(spl-flo-stormy-seas-wave-path-1)) {
