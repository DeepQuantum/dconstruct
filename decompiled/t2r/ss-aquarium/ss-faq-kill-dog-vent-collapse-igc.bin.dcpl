                        change-object-material(obj-faq-dog-alice-1, objects/characters/npc-normal/animal/dog/dog-fur-thick:default, objects/characters/npc-normal/animal/dog/dog-fur-thick-gore:default, 0);
                        change-object-material(obj-faq-dog-alice-1, objects/characters/npc-normal/animal/dog/dog-fur-thin:default, objects/characters/npc-normal/animal/dog/dog-fur-thin-gore:default, 0);
                        change-object-material(obj-faq-dog-alice-1, objects/characters/npc-normal/animal/dog/dog-teeth-tongue-standard:default, objects/characters/npc-normal/animal/dog/dog-teeth-tongue-standard-gore:default, 0);
                    }
                }
            }
            track vent-and-table {
                lambda {
                    animate-done(obj-faq-vent-1, faq-vent-collapse-success--vent, ap-faq-vent-collapse-1, 0, 0, 2);
                }
                lambda {
                    animate-done(obj-faq-vent-collapse-table-1, faq-vent-collapse-success--table, ap-faq-vent-collapse-1, 0, 0, 2);
                }
            }
        }
    }
}
