    u64? var_0 = get-attach-point-position(player, leftHand);
    set-float(hand-pos-delta, lerp(get-float(hand-pos-delta, self), sqr(100.00 * (vector-magnitude(vector-between-points(get-point(last-hand-pos, self), var_0)) / get-delta-time())), 0.40), self);
