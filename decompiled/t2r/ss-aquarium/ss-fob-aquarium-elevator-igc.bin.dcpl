                    u64? var_0 = #%alloc-array(single-frame, 16, 4, 1);
                    *(i32 *)*(*var_0 + (0 * 8)) = 10;
                    *(u64 *)(*(*var_0 + (0 * 8)) + 8) = 0;
                    *(u64 *)(*(*var_0 + (0 * 8)) + 8) = get-spawner-locator(ap-fob-aquarium-elevator-1, 1);
                    *(i32 *)*(*var_0 + (1 * 8)) = 28;
                    *(u64 *)(*(*var_0 + (1 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (1 * 8)) + 8) = 0.00;
                    *(i32 *)*(*var_0 + (2 * 8)) = 30;
                    *(u64 *)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (2 * 8)) + 8) = 1.00;
                    *(i32 *)*(*var_0 + (3 * 8)) = 56;
                    *(u64 *)(*(*var_0 + (3 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (3 * 8)) + 8) = 1.05;
                    wait-animate_(owen, fob-aquarium-elevator-ladder--owen, var_0);
                }
                lambda {
                    set-boolean(owen-at-ladder-bottom?, 1, self);
                }
                lambda {
                    wait-for(player-anim-done);
                }
                lambda {
                    go(ladder-vertigo, 1);
                }
            }
            track abby {
                lambda {
                    animate-done(obj-fob-aquarium-elevator-door-1, fob-aquarium-elevator-idle--door, ap-fob-aquarium-elevator-1, 0, 0, 2);
                }
                lambda {
                    set-boolean(player-in-systemic-ladder-climb?, 1, self);
                }
                lambda {
                    u64? var_0 = #%alloc-array(single-frame, 16, 6, 1);
                    *(i32 *)*(*var_0 + (0 * 8)) = 10;
                    *(u64 *)(*(*var_0 + (0 * 8)) + 8) = 0;
                    *(u64 *)(*(*var_0 + (0 * 8)) + 8) = get-spawner-locator(ap-fob-aquarium-elevator-1, 1);
                    *(i32 *)*(*var_0 + (1 * 8)) = 28;
                    *(u64 *)(*(*var_0 + (1 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (1 * 8)) + 8) = 0.00;
                    *(i32 *)*(*var_0 + (2 * 8)) = 30;
                    *(u64 *)(*(*var_0 + (2 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (2 * 8)) + 8) = 0.70;
                    *(i32 *)*(*var_0 + (3 * 8)) = 57;
                    *(u64 *)(*(*var_0 + (3 * 8)) + 8) = 0;
                    *(f32 *)(*(*var_0 + (3 * 8)) + 8) = 730.00;
                    *(i32 *)*(*var_0 + (4 * 8)) = 29;
                    *(u64 *)(*(*var_0 + (4 * 8)) + 8) = 0;
                    *(u8 *)(*(*var_0 + (4 * 8)) + 8) = 2;
                    *(i32 *)*(*var_0 + (5 * 8)) = 24;
                    *(u64 *)(*(*var_0 + (5 * 8)) + 8) = 0;
                    *(i32 *)(*(*var_0 + (5 * 8)) + 8) = 35;
                    wait-animate_(player, fob-aquarium-elevator--abby, var_0);
                }
                lambda {
                    signal(player-anim-done, 0);
                }
            }
            track camera-overlay {
                lambda {
                    camera-enable-animated(0.00, -1.00, 1, 1000, 0, 0, 0);
                }
                lambda {
                    wait(1.00);
                }
                lambda {
                    wait-camera-fade-out-animated-to-remap(0.00, *camera-remap-close*, 1.00, 12, 0);
                }
            }
            track vertigo {
                lambda {
                    while (1) {
                        fob-aquarium--apply-ladder-vertigo();
                        wait-one-frame();
                    }
                }
            }
        }
    }
    state already-done {
        block start {
            track main {
                lambda {
                    animate-done(obj-fob-aquarium-elevator-door-1, fob-aquarium-elevator-idle--door, ap-fob-aquarium-elevator-1, 0, 0, 2);
                }
                lambda {
                    go(ladder-vertigo, 1);
                }
            }
        }
    }
    state ladder-vertigo {
        block update {
            track main {
                lambda {
                    if (player-in-state?(Ladder)) {
                        fob-aquarium--apply-ladder-vertigo();
                    }
                }
            }
        }
        block event_task-complete {
            track main {
                lambda {
                    go(complete, 1);
                }
            }
        }
    }
}
