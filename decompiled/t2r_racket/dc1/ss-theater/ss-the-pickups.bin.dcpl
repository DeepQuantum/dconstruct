    state check-pickups {
        block event player-requested-interact {
            track main {
                lambda 
                    (set-svar-bit the-lobby-pickups (darray-find the-pickups (new-boxed-value 7 (event-arg-symbol 0)) 0) 1)
                
            }
        }
    }
    state spawn-pickups {
        block start {
            track main {
                lambda 
                    (kill-entity coll-the-soldier-setlist-3)
                
                lambda 
                    (for ([var_1 res-the-pickups]) 
                        (define var_2)
                        (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 7))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 5))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else 
                            (set! var_2 0)
                        
                        (if (not (get-svar-bit the-lobby-pickups (darray-find res-the-pickups (new-boxed-value 7 var_2) 0)))) 
                            (spawn-entity var_2 0 0)
                        
                    )
                
                lambda 
                    (if (and (get-svar-bit the-lobby-pickups 15) (not (get-svar-bit the-lobby-pickups 16)))) 
                        (spawn-entity ss-player-upgrade-manual-selector-30 0 0)
                    
                
                lambda 
