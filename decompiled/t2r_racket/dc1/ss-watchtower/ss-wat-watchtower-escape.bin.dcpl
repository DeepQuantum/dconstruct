                        (npc-look-at-object npc-wat-watchtower-escape-1-1 npc-wat-watchtower-escape-1-4 headb 10.00)
                        (npc-look-at-object npc-wat-watchtower-escape-1-4 npc-wat-watchtower-escape-1-1 headb 10.00)
                    
                
            }
        }
        block event tension-changed {
            track main {
                lambda 
                    (if (is-combat-or-search?)) 
                        (go in-studio 1)
                    
                
            }
        }
        block event wlf-cut-down-skip {
            track main {
                lambda 
                    (go in-studio 1)
                
            }
        }
        block event player-fired-weapon {
            track main {
                lambda 
                    (set-boolean resources-used-in-intro 1 self)
                
            }
        }
        block event player-threw-projectile {
            track main {
                lambda 
                    (set-boolean resources-used-in-intro 1 self)
                
            }
        }
        block event projectile-thrown {
            track main {
                lambda 
                    (set-boolean resources-used-in-intro 1 self)
                
            }
        }
        block end {
            track main {
                lambda 
                    (if (and (is-combat-or-search?) (not (get-boolean resources-used-in-intro self)))) 
                        (task-set-active-continue! studio 0 0 0 0.00 0 0)
                    
                
                lambda 
                    (npc-clear-look-at npc-wat-watchtower-escape-1-1)
                
                lambda 
                    (for ([var_1 wat-watchtower-escape-npcs]) 
                        (define var_2)
                        (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 7))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 5))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else 
                            (set! var_2 0)
                        
                        (npc-set-script-low-priority var_2)
                    )
                
            }
        }
        block event wlf-cut-down-start {
            track main {
                lambda 
                    (set-boolean cut-down-start? 1 self)
                
            }
        }
        block event wlf-cut-down-turn {
            track main {
                lambda 
                    (set-boolean cut-down-turn? 1 self)
                
            }
        }
        block event wlf-cut-down-end {
            track main {
                lambda 
                    (set-boolean cut-down-end? 1 self)
                
            }
        }
    }
    state setup-studio {
        block start {
            track main {
                lambda 
                    (wait-spawn-npc-group-async wat-watchtower-escape-npcs 0 0)
                
                lambda 
                    (initialize-lobby-patrols)
                
                lambda 
                    (go in-studio 1)
                
            }
        }
    }
    state in-studio {
        block start {
            track main {
                lambda 
                    (wait-boolean reached-lobby? 1 self)
                
                lambda 
                    (set-svar-as-boolean wat-escape-studio-enemies-alive (> (npc-group-alive-count wat-watchtower-escape-npcs) 0))
                
                lambda 
                    (group-clear-zone wat-watchtower-escape-npcs)
                
                lambda 
                    (go in-lobby 1)
                
            }
            track dina {
                lambda 
                    (wait-for-event dina-take-lead 0 0 0 0 0 0 0 0 0)
                
                lambda 
                    (let loop () (when 1 
                        (npc-request-lead-spline dina spl-wat-watchtower-escape-dina-1 player *wat-studio-escape-dina-ai-lead-settings* 0 0)
                        (wait-boolean player-near-exit 1 self)
                        (npc-request-lead-spline dina spl-wat-watchtower-escape-dina-2 player *wat-studio-escape-dina-ai-lead-settings* 0 0)
                        (wait-boolean player-near-exit 0 self)
                     (loop)))
                
            }
            track hard-points {
                lambda 
                    (set-hardpoint-enabled hard-point-wat-watchtower-escape-studio-1)
                
                lambda 
                    (set-hardpoint-enabled hard-point-wat-watchtower-escape-studio-2)
                
                lambda 
                    (set-hardpoint-enabled hard-point-wat-watchtower-escape-studio-3)
                
            }
            track checkpoint {
                lambda 
                    (let loop () (when (not (can-set-combat-checkpoints?)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (set-combat-checkpoint watchtower wat-watchtower-escape studio 0 0)
                
            }
        }
        block event player-downstairs {
            track main {
                lambda 
                    (set-hardpoint-disabled hard-point-wat-watchtower-escape-studio-3)
                
            }
        }
        block event player-upstairs {
            track main {
                lambda 
                    (if (> (npc-group-alive-count wat-watchtower-escape-npcs) 0)) 
                        (set-hardpoint-enabled hard-point-wat-watchtower-escape-studio-3)
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (disallow-normal-tension)
                
            }
        }
    }
    state setup-lobby {
        block start {
            track main {
                lambda 
                    (if (get-svar-as-boolean wat-escape-studio-enemies-alive)) 
                        (set-hardpoint-enabled hard-point-wat-watchtower-escape-studio-1)
                        (set-hardpoint-enabled hard-point-wat-watchtower-escape-studio-2)
                        (set-hardpoint-enabled hard-point-wat-watchtower-escape-studio-3)
                        (wait-spawn-npc-group-async wat-watchtower-escape-npcs 0 0)
                    
                
                lambda 
                    (go in-lobby 1)
                
            }
        }
    }
    state in-lobby {
        block start {
            track npcs {
                lambda 
                    (npc-request-lead-spline dina spl-wat-watchtower-escape-dina-2 player *wat-lobby-escape-dina-ai-lead-settings* 0 0)
                
                lambda 
                    (wait-spawn-npc-group-async wat-watchtower-balcony-npcs 0 0)
                
                lambda 
                    (wait-spawn-npc-group-async wat-watchtower-lobby-npcs 0 0)
                
                lambda 
                    (wait-for-event at-railing 0 0 0 0 0 0 0 0 0)
                
                lambda 
                    (for ([var_1 wat-watchtower-lobby-npcs]) 
                        (define var_2)
                        (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 7))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 5))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else 
                            (set! var_2 0)
                        
                        (if (npc-alive? var_2)) 
                            (send-event at-railing var_2)
                        
                    )
                
                lambda 
                    (send-event vox-lobby-npcs ss-vox-wat-watchtower-escape-1)
                
                lambda 
                    (wait-boolean balcony-spotted? 1 self)
                
                lambda 
                    (play-spot-player-stinger)
                
                lambda 
                    (request-dialog wat-watchtower-escape-find-way-out-001 (npc-group-find-first-alive wat-watchtower-balcony-npcs) 0 0 0 0 1)
                
                lambda 
                    (send-event vox-lobby-npc-cancel ss-vox-wat-watchtower-escape-1)
                
                lambda 
                    (set-boolean vox-escape-start 1 ss-vox-wat-watchtower-escape-1)
                
                lambda 
                    (wait 1.00)
                
                lambda 
                    (npc-clear-request-movement dina)
                
                lambda 
                    (npc-set-script-only-no-perception dina)
                
                lambda 
                    (let loop () (when (and (> (npc-group-alive-count wat-watchtower-balcony-npcs) 0) (< (- (get-current-time 0) (get-current-time 0)) 6.00)) 
                        (npc-fire-at-object dina (npc-group-find-first-alive wat-watchtower-balcony-npcs) 2 0 0 0)
                        (wait (random-float-min-max 0.40 0.90 0))
                     (loop)))
                
                lambda 
                    (npc-cancel-fire-command dina)
                
                lambda 
                    (npc-set-script-high-priority dina)
                
                lambda 
                    (send-event vox-dina-tells-ellie-to-run ss-vox-wat-watchtower-escape-1)
                
                lambda 
                    (npc-request-lead-spline dina spl-wat-watchtower-escape-dina-3 player *wat-lobby-escape-dina-ai-lead-settings* 0 0)
                
            }
            track music {
                lambda 
                    (wait-boolean balcony-spotted? 1 self)
                
                lambda 
                    (play-music-stinger *music-playlist-wat-watchtower-escape-trans-to-chase* 0)
                
                lambda 
                    (wait 1.50)
                
                lambda 
                    (play-music-stinger *music-playlist-wat-watchtower-escape-chase* 0)
                
            }
            track hard-points {
                lambda 
                    (let loop () (when (not (== (npc-group-alive-count wat-watchtower-escape-npcs) 0)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (set-hardpoint-disabled hard-point-wat-watchtower-escape-studio-1)
                
                lambda 
                    (set-hardpoint-disabled hard-point-wat-watchtower-escape-studio-2)
                
                lambda 
                    (set-hardpoint-disabled hard-point-wat-watchtower-escape-studio-3)
                
            }
            track checkpoint {
                lambda 
                    (let loop () (when (not (can-set-combat-checkpoints?)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (if (task-continue-active? watchtower wat-watchtower-escape lobby)) 
                        (set-combat-checkpoint watchtower wat-watchtower-escape lobby 0 0)
                     else 
                        (set-combat-checkpoint watchtower wat-watchtower-escape lobby 0 1)
                    
                
            }
            track progression {
                lambda 
                    (wait-boolean reached-street? 1 self)
                
                lambda 
                    (npc-cancel-fire-command dina)
                
                lambda 
                    (task-complete! watchtower wat-watchtower-escape-find-way-out)
                
                lambda 
                    (go done 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (disallow-normal-tension)
                
                lambda 
                    (hud2-suppress-reminders/f)
                
                lambda 
                    (player-disable-full-body-hit-reactions 1)
                
                lambda 
                    (if (get-boolean balcony-spotted? self)) 
                        (for ([var_2 wat-watchtower-balcony-npcs]) 
                            (define var_3)
                            (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 7))) 
                                (set! var_3 (deref (cast u64* var_2)))
                             else (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 5))) 
                                (set! var_3 (deref (cast u64* var_2)))
                             else (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 4))) 
                                (set! var_3 (deref (cast u64* var_2)))
                             else 
                                (set! var_3 0)
                            
                            (if (npc-alive? var_3)) 
                                (npc-make-aware-of var_3 player 2 0)
                            
                        )
                        (disallow-invisible-while-prone/f)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-complete? watchtower wat-watchtower-escape-street-enter)) 
                        (go cleanup 1)
                    
                
            }
        }
    }
    state wait-find-exit {
        block start {
            track main {
                lambda 
                    (wait-boolean reached-street? 1 self)
                
                lambda 
                    (task-complete! watchtower wat-watchtower-escape-find-way-out)
                
                lambda 
                    (go done 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (hud2-suppress-reminders/f)
                
                lambda 
                    (player-disable-full-body-hit-reactions 1)
                
                lambda 
                    (disallow-normal-tension)
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-complete? watchtower wat-watchtower-escape-street-enter)) 
                        (go cleanup 1)
                    
                
            }
        }
    }
    state cleanup {
        block start {
            track main {
                lambda 
                    (group-kill-entity wat-watchtower-escape-npcs 0)
                
                lambda 
                    (group-kill-entity wat-watchtower-lobby-npcs 0)
                
                lambda 
                    (group-kill-entity wat-watchtower-balcony-npcs 0)
                
                lambda 
                    (set-hardpoint-disabled hard-point-wat-watchtower-escape-studio-1)
                
                lambda 
                    (set-hardpoint-disabled hard-point-wat-watchtower-escape-studio-2)
                
                lambda 
                    (set-hardpoint-disabled hard-point-wat-watchtower-escape-studio-3)
                
                lambda 
                    (go done 1)
                
            }
        }
    }
}
