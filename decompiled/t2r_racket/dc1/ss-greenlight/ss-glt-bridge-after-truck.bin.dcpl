                    (wait-boolean do-jump-shot? 1 self)
                
                lambda 
                    (npc-fire-at-locator npc-glt-bridge-bow-1 (get-spawner-locator pos-glt-bridge-bow-shoot-ground-1 1) 1 1 1)
                
            }
            track golden-path-hints {
                lambda 
                    (wait-golden-path-move-to-locator "sprint and jump gap" (get-spawner-locator pos-glt-golden-path-bridge-10 1))
                
            }
            track disable-sprint {
                lambda 
                    (let loop () (when (not (>= (get-state-time self) 2.00)) 
                        (joypad-disable-commands sprint-hold sprint-hold-long sprint-press)
                        (wait-one-frame)
                     (loop)))
                
            }
            track force-orient {
                lambda 
                    (wait-boolean player-in-jump-region 1 self)
                
                lambda 
                    (send-event sprint-jump-gap ss-vox-glt-bridge-1)
                
                lambda 
                    (let loop () (when 1 
                        (player-force-sprint)
                        (set-player-jump-spawner pos-jump-target-1 2)
                        (set-player-jump-spawner-angle 180.00)
                        (joypad-show-ui-during-disable-commands 1)
                        (player-force-move-stick-dir (vector-normalize (vector-flatten (vector-between-locators (get-object-locator player) (get-spawner-locator pos-jump-target-1 1)) 1) 0))
                        (joypad-disable-commands move)
                        (wait-one-frame)
                     (loop)))
                
            }
            track force-jump {
                lambda 
                    (wait-boolean at-jump-edge? 1 self)
                
                lambda 
                    (joypad-force-command jump)
                
            }
        }
        block update {
            track main {
                lambda 
                    (character-set-invincibility player 1 0)
                
                lambda 
                    (joypad-disable-all-commands-except move camera sprint-hold sprint-hold-long sprint-press)
                
            }
        }
        block end {
            track main {
                lambda 
                    (golden-path-clear)
                
                lambda 
                    (kill-entity-if-spawned npc-glt-parking-1)
                
                lambda 
                    (kill-entity-if-spawned npc-glt-parking-2)
                
                lambda 
                    (clear-gesture player -1 -1.00 0)
                
            }
        }
    }
    state leading-bow-shot {
        block start {
            track main {
                lambda 
                    (teleport-npc npc-glt-bridge-bow-1 pos-npc-glt-bridge-bow-teleport-2)
                
                lambda 
                    (spawn-npc npc-glt-makeup-meatshield-1 0 0)
                
                lambda 
                    (npc-set-script-only-no-perception npc-glt-makeup-meatshield-1)
                
                lambda 
                    (npc-stop npc-glt-makeup-meatshield-1)
                
                lambda 
                    (let loop () (when (and (player-in-state? GroundLanding) (not (player-in-state? Move))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (camera-shake camera-shake-shouldermount-land-med-01 1.00 1.00 1)
                
                lambda 
                    (npc-fire-at-locator npc-glt-bridge-bow-1 (get-spawner-locator pos-glt-stripmall-fire-arrow-5 1) 1 1 1)
                
                lambda 
                    (go complete 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (joypad-disable-all-commands-except camera)
                
            }
        }
    }
}
