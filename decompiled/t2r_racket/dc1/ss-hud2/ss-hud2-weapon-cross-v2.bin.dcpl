                    (weapon-cross-defragment-vertical-slots)
                
                lambda 
                    (if (and (and (== (event-arg-symbol 0) brick) (== (event-arg-symbol 0) bottle)) (not (== (player-inv-selection-get-slot-index-by-item-id (event-arg-symbol 0) -1) -1)))) 
                        (player-inv-selection-replace-item (player-inv-selection-get-slot-index-by-item-id (event-arg-symbol 0) -1) (event-arg-symbol 0))
                    
                
                lambda 
                    (if (not (== (recipe-id-to-item-id (event-arg-symbol 0)) 0))) 
                        (define var_3 (recipe-id-to-item-id (event-arg-symbol 0)))
                        (define var_4 (player-inv-selection-get-slot-index-by-item-id var_3 -1))
                        (if (or (not (== var_4 -1)) (!= (player-inv-selection-get-slot-item-id var_4) var_3))) 
                            (if (not (is-rogue-mode?))) 
                                (set! var_6 (player-inv-selection-replace-item (player-inv-selection-get-slot-index-by-item-id var_3 -1) var_3))
                            
                        
                    
                
            }
        }
        block event designer-menu-changed {
            track main {
                lambda 
                    (if (and (!= *hud-prototypes* nullptr) (deref (cast u8* (+ *hud-prototypes* 11))))) 
                        (give-player-upgrade-by-id long-gun-second-holster)
                        (give-player-upgrade-by-id short-gun-second-holster)
                    
                
                lambda 
                    (weapon-cross-update-holsters)
                
                lambda 
                    (weapon-cross-update-weapon-visibility 0)
                
            }
        }
        block event player-upgrade-enabled {
            track main {
                lambda 
                    (if (and (== (event-arg-symbol 0) short-gun-second-holster) (== (event-arg-symbol 0) long-gun-second-holster))) 
                        (weapon-cross-update-holsters)
                        (weapon-cross-update-weapon-visibility 0)
                    
                
            }
        }
        block event player-equip-ammo {
            track main {
                lambda 
                    (weapon-cross-update-prompts 0 0 0 -1)
                
            }
        }
        block event player-toggled-silencer {
            track main {
                lambda 
                    (define var_1)
                    (if (event-arg-boolean 0)) 
                        (set! var_1 0)
                     else 
                        (set! var_1 1)
                    
                    (weapon-cross-update-prompts 0 0 0 var_1)
                
            }
        }
    }
    state disabled {
        block start {
            track main {
                lambda 
                    (deactivate-joypad-input-group 1)
                
                lambda 
                    (hud2-set-button-hold-percent (gui2-build-widget-path (get-relevant-button-prompt--weapon-cross 0) "flow" "text-x" "text" "hold-prompt" 0 0 0 0) 0.00 1)
                
                lambda 
                    (hud2-set-button-hold-percent (gui2-build-widget-path (get-relevant-button-prompt--weapon-cross 0) "flow" "text-square" "text" "hold-prompt" 0 0 0 0) 0.00 1)
                
                lambda 
                    (hud2-set-button-hold-percent (gui2-build-widget-path (get-relevant-button-prompt--weapon-cross 0) "flow" "text-triangle" "text" "hold-prompt" 0 0 0 0) 0.00 1)
                
                lambda 
                    (if (and (not (timer-running? animate-timer self)) (get-boolean active? self))) 
                        (gui2-seek-widget-property self fcolor.a 0.00 0.20)
                        (start-timer animate-timer (+ 0.20 (frames-to-sec 1)) self 1)
                    
                
                lambda 
                    (set-boolean active? 0 self)
                
                lambda 
                    (set-boolean ignore-sound? 0 self)
                
                lambda 
                    (set-boolean focus-from-quick-swap? 0 self)
                
                lambda 
                    (set-boolean cine? (cinematic-playing? 0) self)
                
                lambda 
                    (stop-timer fade-timer self)
                
                lambda 
                    (if (get-boolean cine? self)) 
                        (gui2-stop-widget-animation self)
                        (gui2-set-widget-alpha self 0.00)
                        (gui2-set-widget-visible self 0)
                        (menu2-hide-page-stack hudMenuStack 0)
                    
                
            }
        }
        block end {
            track main {
                lambda 
                    (gui2-set-widget-visible self 1)
                
                lambda 
                    (menu2-show-page-stack hudMenuStack)
                
                lambda 
                    (set-boolean cine? 0 self)
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (!= (get-boolean cine? self) (cinematic-playing? 0))) 
                        (set-boolean cine? (cinematic-playing? 0) self)
                        (if (get-boolean cine? self)) 
                            (menu2-hide-page-stack hudMenuStack 0)
                         else 
                            (menu2-show-page-stack hudMenuStack)
                        
                    
                
                lambda 
                    (if (and (weapon-cross-available? 0) (allowed-in-igc?--weapon-cross-internal self))) 
                        (define var_3)
                        (if (timer-running? animate-timer self)) 
                            (set! var_3 visible-setup)
                         else 
                            (set! var_3 no-focus)
                        
                        (go var_3 1)
                    
                
            }
        }
    }
    state dormant {
        block start {
            track main {
                lambda 
                    (deactivate-joypad-input-group 1)
                
                lambda 
                    (set-boolean active? 0 self)
                
                lambda 
                    (set-boolean ignore-sound? 0 self)
                
                lambda 
                    (set-boolean is-toggled-open? 0 self)
                
                lambda 
                    (set-boolean focus-from-quick-swap? 0 self)
                
                lambda 
                    (set-accessed-via-quick-swap 0)
                
                lambda 
                    (gui2-stop-widget-animation self)
                
                lambda 
                    (gui2-set-widget-alpha self 0.00)
                
                lambda 
                    (gui2-set-widget-visible self 0)
                
                lambda 
                    (stop-timer fade-timer self)
                
            }
        }
        block end {
            track main {
                lambda 
                    (gui2-set-widget-visible self 1)
                
            }
        }
        block event page-focus-gained {
            track main {
                lambda 
                    (go no-focus 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (nth-frame? 30 0)) 
                        (if (== (menu2-get-top-page-in-stack hudMenuStack 0) (get-symbol page-widget self))) 
                            (go no-focus 1)
                        
                    
                
            }
        }
    }
}
