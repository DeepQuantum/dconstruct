                            (define i 0)
                            (let loop () (when (< i (get-int32 total-numbers self)) 
                                (gui2-go-widget-state (get-number-slot-child-type--lock-minigame (- (- (get-int32 total-numbers self) 1) i) 0) error 0 0 0)
                                (set! i (+ i 1))
                             (loop)))
                            (let loop () (when (gui2-widget-is-animating? (get-number-slot-child-type--lock-minigame 0 0)) 
                                (wait-one-frame)
                             (loop)))
                            (wait 0.40)
                            (define i 0)
                            (let loop () (when (< i (get-int32 total-numbers self)) 
                                (gui2-set-widget-state (get-number-slot-child-type--lock-minigame (- (- (get-int32 total-numbers self) 1) i) 0) off 0 0 0)
                                (set! i (+ i 1))
                             (loop)))
                            (set! var_2 i)
                        
                    
                
            }
        }
        block event hud-reset {
            track main {
                lambda 
                    (set-int32 curr-number-index 0 self)
                
                lambda 
                    (if (not (get-boolean hack-prompt-stack? self))) 
                        (update-code-text--lock-minigame 0)
                        (update-digits-selected--lock-minigame 1)
                    
                
                lambda 
                    (go input-code 1)
                
            }
        }
    }
    state investigate {
        block start {
            track main {
                lambda 
                    (gui2-set-widget-state self off 0 0 0)
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (not (player-in-state? Investigate))) 
                        (go input-code 1)
                    
                
            }
        }
        block event investigate-begin-exit {
            track main {
                lambda 
                    (go input-code 1)
                
            }
        }
        block end {
            track main {
                lambda 
                    (gui2-set-widget-state self active 0 0 0)
                
            }
        }
    }
    state --all-- {
        block update {
            track main {
                lambda 
                    (hud2-hide-health-ammo/f 0 0)
                
            }
        }
        block event show-spinner-timer {
            track main {
                lambda 
                    (if (get-svar-as-boolean safe-tutorial-once)) 
                        (if (script-in-state? self input-code)) 
                            (show-spinner--lock-minigame)
                         else 
                            (set-boolean show-spinner-queued? 1 self)
                        
                    
                
            }
        }
        block event kill-hud {
            track main {
                lambda 
                    (if (not (script-in-state? success self))) 
                        (gui2-set-widget-state self off 0 1 0)
                    
                
            }
        }
        block event hud-disable-prompt {
            track main {
                lambda 
                    (if (not (== (get-symbol w-button-stack self) 0))) 
                        (define var_1 (event-arg-int32 0))
                        (if (== var_1 0)) 
                            (set! var_2 (hud2-set-button-in-prompt-stack-disabled (get-symbol w-button-stack self) HUD_LOCK_MINIGAME_RESET (event-arg-boolean 1)))
                         else (if (== var_1 1)) 
                            (set! var_2 (hud2-set-button-in-prompt-stack-disabled (get-symbol w-button-stack self) HUD_LOCK_MINIGAME_CONFIRM (event-arg-boolean 1)))
                        
                        (set-int32 queued-disable -1 self)
                     else (if (event-arg-boolean 1)) 
                        (set-int32 queued-disable (event-arg-int32 0) self)
                    
                
            }
        }
    }
}
