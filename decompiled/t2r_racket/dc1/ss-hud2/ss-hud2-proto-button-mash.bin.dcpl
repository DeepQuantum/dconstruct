                    (set-symbol w-pulse-parent (gui2-find-widget-path "pulses" self) self)
                    (if (gui2-widget-exists? (get-symbol w-prompt self))) 
                        (gui2-set-widget-image (gui2-find-widget-path "icon" (get-symbol w-prompt self)) (dc:format "%s@large" (deref (cast i64* (+ var_4 208)))))
                    
                    (if (gui2-widget-exists? (get-symbol w-prompt-square self))) 
                        (gui2-set-widget-image (gui2-find-widget-path "icon" (get-symbol w-prompt-square self)) (dc:format "%s@large" (deref (cast i64* (+ var_4 208)))))
                    
                    (set-symbol joypad-command (deref (cast u64* (+ var_4 240))) self)
                
            }
        }
        block update {
            track main {
                lambda 
                    (update-player-setting-hud--proto-button-mash)
                
            }
        }
    }
    state --script-- {
        block end {
            track main {
                lambda 
                    (set-symbol w-button-hold 0 ss-hud2-1)
                
            }
        }
    }
}
