                    (hud2-show-interactable-hold interact-default-hold (get-object-locator item-pickup-weapon-optional-9) (get-float anim-complete-percent self) 1)
                
                lambda 
                    (if (joypad-command-active? interact-hold 6)) 
                        (stop-sound (get-int32 snd-pull-reverse self))
                        (go struggle-forward 1)
                    
                
                lambda 
                    (if (and (< (get-animation-frame player 2 med-infected-crit-optional-flamethrower-pull--abby) 15.00) (< (get-animation-speed player 2 med-infected-crit-optional-flamethrower-pull--abby) -0.10))) 
                        (if (task-continue-active? medicine med-infected-building-descent floor-3-cleared)) 
                            (stop-sound (get-int32 snd-pull-reverse self))
                            (go idle-no-enemies 1)
                         else 
                            (stop-sound (get-int32 snd-pull-reverse self))
                            (go idle-stealth 1)
                        
                    
                
            }
        }
    }
    state success {
        block start {
            track hide-weapon {
