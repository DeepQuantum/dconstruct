statescript {
    options {
        player
        lev
        med-flooded-street-script
    }
    state task-check {
        block start {
            track main {
                lambda 
                    (if (task-active? medicine med-flooded-street-swim)) 
                        (go street-swim 1)
                     else (if (task-active? medicine med-flooded-street-building)) 
                        (go building-interior 1)
                     else (if (task-active? medicine med-flooded-street-building-roof)) 
                        (go building-roof 1)
                     else (if (task-active? medicine med-flooded-street-highway)) 
                        (go highway 1)
                     else (if (task-active? medicine med-flooded-street-infected-apartment)) 
                        (go apartment 1)
                     else (if (task-complete? medicine med-flooded-street-infected-apartment)) 
                        (go complete 1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-active? medicine med-flooded-street-swim)) 
                        (go street-swim 1)
                    
                
            }
        }
    }
    state street-swim {
        block event player-reached-flooded-building {
            track main {
                lambda 
                    (task-complete! medicine med-flooded-street-swim)
                
                lambda 
                    (go building-interior 1)
                
            }
        }
    }
    state building-interior {
        block event player-reached-roof {
            track main {
                lambda 
                    (task-complete! medicine med-flooded-street-building)
                
                lambda 
                    (go building-roof 1)
                
            }
        }
    }
    state building-roof {
        block event player-reached-highway {
            track main {
                lambda 
                    (task-complete! medicine med-flooded-street-building-roof)
                
                lambda 
                    (go highway 1)
                
            }
        }
    }
    state highway {
        block event player-reached-apartment {
            track main {
                lambda 
                    (task-complete! medicine med-flooded-street-highway)
                
                lambda 
                    (go apartment 1)
                
            }
        }
    }
    state apartment {
        block start {
            track main {
                lambda 
                    (let loop () (when (not (player-in-region? rgn-med-player-reached-apartment-roof-1 2)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (update-all-spec-cubemaps)
                
                lambda 
                    (task-complete! medicine med-flooded-street-infected-apartment)
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
