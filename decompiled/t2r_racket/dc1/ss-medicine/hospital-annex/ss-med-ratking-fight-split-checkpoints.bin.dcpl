statescript {
    options {
        player
    }
    declarations {
        i32 index = 0
        bool checkpoint-restored? = nullptr
    }
    state init {
        block start {
            track main {
                lambda 
                    (set-int32 index (get-svar med-ratking-current-checkpoint-index) self)
                
                lambda 
                    (set-boolean checkpoint-restored? 1 self)
                
            }
        }
        block event enter {
            track main {
                lambda 
                    (rk-split-set-spawn-index (event-arg-symbol 1))
                
            }
        }
        block event set-split-default-checkpoint {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "setting checkpoint default") 19)
                    
                
                lambda 
                    (set-svar med-ratking-current-checkpoint-index (get-int32 index self))
                
                lambda 
                    (task-set-active-continue! default 0 1 0 0.00 (rk-split-get-abby-checkpoint) (rk-split-get-camera-checkpoint))
                
            }
        }
        block event set-split-stalker-fled-checkpoint {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "setting checkpoint fled") 19)
                    
                
                lambda 
                    (if (deref (cast u8* (+ (get-difficulty-detail-player) 168)))) 
                        (set-svar med-ratking-current-checkpoint-index (get-int32 index self))
                        (task-set-active-continue! stalker-fled 0 1 0 0.00 (rk-split-get-abby-checkpoint) (rk-split-get-camera-checkpoint))
                    
                
            }
        }
        block event set-dead-checkpoint {
            track main {
                lambda 
                    (set-svar med-ratking-current-checkpoint-index (get-int32 index self))
                
                lambda 
                    (task-set-active-continue! default 1 1 0 0.00 0 0)
                
            }
        }
    }
}
