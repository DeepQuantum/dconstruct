                lambda 
                    (if (> (get-int32 num-shots-fired-since-reload self) 0)) 
                        (set-boolean out-of-ammo? 0 self)
                        (-- num-shots-fired-since-reload self)
                    
                
            }
        }
        block event npc-fired-weapon {
            track main {
                lambda 
