                                (broadcast-event vox-aef-ellie-stunned-by-bottle-brick)
                            
                            (if (and (and (or (or (script-in-state? self ellie-debug-combat) (script-in-state? self ellie-debug-combat-phase-3)) (npc-is-stunned? npc-enemy-ellie-pistol-1)) (not (< (- (current-time 1) (get-float dodge-timestamp self)) 2.00))) (== (npc-get-target-entity-awareness npc-enemy-ellie-pistol-1) 3))) 
