                        (wait-rumble-curve 0.06 0.00 0.10 2 0)
                        (wait-until-frame 107)
                        (wait-rumble-curve 0.09 0.17 0.10 2 0)
                        (wait-rumble-curve 0.17 0.15 0.10 2 0)
                        (wait-rumble-curve 0.15 0.05 0.10 2 0)
                        (wait-rumble-curve 0.05 0.00 0.10 2 0)
                        (wait-until-frame 334)
                        (start-rumble hard-land-rumble-settings 0)
                    
                
            }
            track haptics {
                lambda 
                    (if (joypad-has-haptics? 2)) 
                        (wait-for anim-start)
                        (wait-until-anim-frame player efm-joel-boost-ellie-into-building--ellie 69.00 2)
                        (play-hfx-id boost-lift-haptic 0 2)
                        (wait-until-anim-frame player efm-joel-boost-ellie-into-building--ellie 97.00 2)
                        (play-hfx-id boost-lift-haptic-short 0 2)
                        (wait-until-anim-frame player efm-joel-boost-ellie-into-building--ellie 189.00 2)
                        (play-hfx-id clamber-foot-medium-haptic 0 2)
                        (wait-until-anim-frame player efm-joel-boost-ellie-into-building--ellie 203.00 2)
                        (play-hfx-id clamber-foot-light-haptic 0 2)
                        (wait-until-anim-frame player efm-joel-boost-ellie-into-building--ellie 237.00 2)
                        (play-hfx-id clamber-foot-light-haptic 0 2)
                        (wait-until-anim-frame player efm-joel-boost-ellie-into-building--ellie 334.00 2)
                        (play-hfx-id hard-land-rumble-settings 0 2)
                    
                
            }
            track vox {
                lambda 
                    (wait-for anim-start)
                
                lambda 
                    (say player vox-igc-ell-igc-efm-joel-boost-ellie-into-building-001 2 0)
                
                lambda 
                    (say joel vox-igc-joe-igc-efm-joel-boost-ellie-into-building-001 2 0)
                
            }
            track signal-new-move-mode {
                lambda 
                    (wait-for anim-start)
                
                lambda 
                    (wait 1.00)
                
                lambda 
                    (send-event go-fake-combat ss-efm-player-movement-1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (npc-look-at-object joel player headb 10.00)
                
            }
        }
    }
    state ellie-inside {
        block start {
            track main {
                lambda 
                    (wait 0.50)
                
                lambda 
                    (wait-say player vox-igc-ell-gam-nor-museum-flashback-nat-history-001 2 0)
                
                lambda 
                    (wait-say joel vox-igc-jol-gam-nor-museum-flashback-nat-history-001 2 0)
                
                lambda 
                    (wait-say player vox-igc-ell-gam-nor-museum-flashback-nat-history-002 2 0)
                
                lambda 
                    (wait 1.00)
                
                lambda 
                    (listen-mode-visible joel 0 1 -1.00)
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
