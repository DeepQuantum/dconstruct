(define (*give-player-long-gun-holster* arg_0) 
    (define var_1)
    (if (and arg_0 (> (get-animation-phase player 0 0) 0.85))) 
        (define var_3)
        (if (is-player-ellie? player)) 
            (set! var_3 "ellie-long-gun-holster")
         else 
            (set! var_3 "abby-long-gun-holster")
        
        (log-event "found-long-gun-holster" 0 var_3 (get-object-locator self) 0)
        (give-player-upgrade-by-id long-gun-second-holster)
        (hud2-request-new-item-notification long-gun-holster 0.00 0)
        (set! var_1 1)
     else 
        (set! var_1 0)
    
    var_1
)

