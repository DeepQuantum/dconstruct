                lambda 
                    (wait 0.30)
                
                lambda 
                    (wait-say player vox-igc-abb-gam-amp-yara-walk-ramp-alice-sp-007 2 0)
                
                lambda 
                    (wait 0.30)
                
                lambda 
                    (wait-say player vox-igc-abb-gam-amp-yara-walk-ramp-alice-sp-008 2 0)
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
        block event player-equip-item {
            track main {
                lambda 
                    (go player-pickup-toy 1)
                
            }
        }
    }
    state player-pickup-toy {
        block start {
            track main {
                lambda 
                    (++ vox-pickup-count self)
                
                lambda 
                    (let loop () (when (not (! (is-any-major-character-speaking?))) 
                        (wait 0.10)
                     (loop)))
                
                lambda 
                    (define var_0 (get-int32 vox-pickup-count self))
                    (if (== var_0 1)) 
                        (wait-say player vox-igc-abb-gam-amp-yara-walk-ramp-alice-sp-011 2 0)
                        (wait 0.30)
                        (wait-for-event player-threw-projectile 0 0 0 0 0 0 0 0 0)
                        (wait 1.00)
                        (set! var_1 (wait-say player vox-igc-abb-gam-amp-yara-walk-ramp-alice-sp-012 2 0))
                     else (if (== var_0 2)) 
                        (wait 0.30)
                        (wait-say player vox-igc-abb-gam-amp-yara-walk-ramp-alice-sp-015 2 0)
                        (wait-for-event player-threw-projectile 0 0 0 0 0 0 0 0 0)
                        (let loop () (when (not (> (get-object-speed alice) 5.00)) 
                            (wait 0.10)
                         (loop)))
                        (set! var_1 (wait-say player vox-igc-abb-gam-amp-yara-walk-alice-fetch-sp-005 2 0))
                    
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
