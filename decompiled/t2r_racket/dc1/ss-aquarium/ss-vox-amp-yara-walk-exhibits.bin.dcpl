    state see-alice {
        block start {
            track main {
                lambda 
                    (wait 0.50)
                
                lambda 
                    (play-sound-at-joint sfx-igc-amp-yara-walk-alice-scare-yara alice jaw 0 0)
                
                lambda 
                    (stop-speaking yara)
                
                lambda 
                    (wait-say yara vox-igc-yar-gam-amp-yara-walk-ramp-alice-slf-003 2 0)
                
                lambda 
                    (wait 0.30)
                
                lambda 
                    (stop-speaking player)
                
