                    (set! (deref (cast u8* (+ var_0 32))) 1)
                    (gesture_ yara npc-talk-hang-head-gesture var_0)
                
            }
        }
        block update {
            track main {
                lambda 
                    (fact-set/f global is-important-conversation (new-boxed-value 1 1))
                
                lambda 
                    (suspend-idle-gestures/f player)
                
                lambda 
                    (suspend-idle-gestures/f yara)
                
                lambda 
                    (if (get-boolean disable-auto-gestures self)) 
                        (npc-disable-dialog-look-gestures yara 0.00)
                    
                
                lambda 
                    (if (get-boolean disable-auto-gestures-player self)) 
                        (player-disable-dialog-look-gestures 0.00)
                    
                
            }
        }
        block end {
            track main {
                lambda 
                    (npc-clear-look-at yara)
                
            }
        }
        block event hear-something {
            track main {
                lambda 
                    (if (not (get-boolean vox-hear-something? self))) 
                        (set-boolean vox-hear-something? 1 self)
                        (go hear-alice 1)
                    
                
            }
        }
    }
    state hear-alice {
        block start {
            track main {
                lambda 
                    (play-sound-at-position sfx-igc-amp-yara-walk-alice-disturbance (get-spawner-position pos-snd-amp-alice-1 1) 0 0)
                
                lambda 
                    (wait 1.50)
                
                lambda 
                    (stop-speaking yara)
                
                lambda 
                    (say yara vox-igc-yar-gam-amp-yara-walk-ramp-alice-sp-001 2 0)
                
                lambda 
                    (if (is-speaking? player)) 
                        (wait 0.25)
                        (stop-speaking player)
                    
                
                lambda 
                    (let loop () (when (not (! (is-any-major-character-speaking?))) 
                        (wait 0.10)
                     (loop)))
                
                lambda 
                    (wait 0.30)
                
                lambda 
                    (wait-say yara vox-igc-yar-gam-amp-yara-walk-ramp-alice-spj-002 2 0)
                
                lambda 
                    (wait-until-anim-frame yara amp-shark-room-squeeze-through-start--yara 0.00 2)
                
                lambda 
