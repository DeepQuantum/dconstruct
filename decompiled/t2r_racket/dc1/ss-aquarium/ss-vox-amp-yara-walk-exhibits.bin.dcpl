                    (set! (deref (cast u8* (+ var_0 33))) 1)
                    (set! (deref (cast u8* (+ var_0 32))) 1)
                    (gesture_ yara npc-m-nw-ambi-disagree-a-head-gesture var_0)
                
            }
        }
