                lambda 
                    (wait-say player vox-igc-abb-gam-amp-yara-walk-ramp-alice-sp-003 2 0)
                
                lambda 
                    (wait 0.30)
                
                lambda 
                    (define var_0 (alloc-gesture-play-params))
