statescript {
    options {
        player
    }
    state task-check {
        block start {
            track main {
                lambda 
                    (if (task-complete? amputation amp-yara-walk-atrium)) 
                        (go complete 1)
                    
                
                lambda 
                    (go wait-for-events 1)
                
            }
        }
    }
    state wait-for-events {
        block event enter {
            track main {
                lambda 
                    (if (get-boolean lev-fight-vox-done? ss-amp-yara-walk-vox-1)) 
                        (if (not (! (script-in-state? ss-amp-yara-walk-vox-1 lev-fight-vox)))) 
                            (npc-request-hold (tag-symbol apply-to self) 1.00)
                        
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-complete? amputation amp-yara-walk-atrium)) 
                        (go complete 1)
                    
                
            }
        }
    }
}
