                    (if (< (get-locator-distance (get-object-locator alice) (get-animation-entry alice (get-symbol pick-up-toy-anim self) (get-object-locator alice) 0 0.00 apReference)) 3.00)) 
                        (set! var_6 1)
                     else 
                        (set! var_6 2)
                    
                    (wait-npc-use-cinematic-action-pack alice (get-symbol pick-up-toy-cap self) var_6 0 0)
                
                lambda 
                    (if (== (get-symbol dog-toy-holder self) alice)) 
                        (debug-draw-string-centered "Alice using CAP pickup" 300.00 5 10.00 1.00 0 0)
                        (go setup-alice-toy-carry 1)
                    
                
                lambda 
                    (debug-draw-string-centered "Alice using IGC pickup" 300.00 6 10.00 1.00 0 0)
                
                lambda 
                    (set-symbol pick-up-toy-entry-table dog-ambi-entry-table self)
                
                lambda 
                    (set-symbol pick-up-toy-anim cap-alice-fetch-pickup-idle-loop self)
                
                lambda 
                    (set-symbol pick-up-toy-exit cap-alice-fetch-pickup-idle-exit self)
                
                lambda 
                    (define var_7)
                    (if (< (get-locator-distance (get-object-locator alice) (get-animation-entry alice (get-symbol pick-up-toy-anim self) (get-object-locator alice) 0 0.00 apReference)) 3.00)) 
                        (set! var_7 1)
                     else 
                        (set! var_7 2)
                    
                    (wait-npc-move-to-entry-frame alice (get-symbol pick-up-toy-anim self) (get-bound-frame pick-up-toy-ap self) var_7 0 0 0 0.00 apReference (get-symbol pick-up-toy-entry-table self))
                
                lambda 
                    (signal alice-entered-pickup-anim 0)
                
                lambda 
                    (define var_1 (#%alloc-array single-frame 16 4 1))
                    (set! (deref (cast i32* (deref (+ (deref var_1) (* 0 8))))) 10)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 0 8))) 8))) 0)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 0 8))) 8))) (get-bound-frame pick-up-toy-ap self))
                    (set! (deref (cast i32* (deref (+ (deref var_1) (* 1 8))))) 13)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 1 8))) 8))) 0)
                    (set! (deref (cast i32* (+ (deref (+ (deref var_1) (* 1 8))) 8))) 2)
                    (set! (deref (cast i32* (deref (+ (deref var_1) (* 2 8))))) 28)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 2 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_1) (* 2 8))) 8))) 0.70)
                    (set! (deref (cast i32* (deref (+ (deref var_1) (* 3 8))))) 30)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 3 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_1) (* 3 8))) 8))) 0.15)
                    (wait-animate_ alice (get-symbol pick-up-toy-anim self) var_1)
                
                lambda 
                    (define var_1 (#%alloc-array single-frame 16 5 1))
                    (set! (deref (cast i32* (deref (+ (deref var_1) (* 0 8))))) 10)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 0 8))) 8))) 0)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 0 8))) 8))) (get-bound-frame pick-up-toy-ap self))
                    (set! (deref (cast i32* (deref (+ (deref var_1) (* 1 8))))) 13)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 1 8))) 8))) 0)
                    (set! (deref (cast i32* (+ (deref (+ (deref var_1) (* 1 8))) 8))) 2)
                    (set! (deref (cast i32* (deref (+ (deref var_1) (* 2 8))))) 28)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 2 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_1) (* 2 8))) 8))) 0.15)
                    (set! (deref (cast i32* (deref (+ (deref var_1) (* 3 8))))) 30)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 3 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_1) (* 3 8))) 8))) 1.00)
                    (set! (deref (cast i32* (deref (+ (deref var_1) (* 4 8))))) 24)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 4 8))) 8))) 0)
                    (set! (deref (cast i32* (+ (deref (+ (deref var_1) (* 4 8))) 8))) 2)
                    (wait-animate_ alice (get-symbol pick-up-toy-exit self) var_1)
                
                lambda 
                    (go setup-alice-toy-carry 1)
                
            }
        }
        block event toy-pickup {
            track main {
                lambda 
                    (enable-collision-gamedriven (get-symbol dog-toy-id self) 0 0.00)
                
                lambda 
                    (amp--attach-dog-toy (get-symbol dog-toy-id self) alice 0.40)
                
                lambda 
                    (broadcast-event alice-picked-up-toy (new-boxed-value 7 (get-symbol dog-toy-id self)))
                
                lambda 
                    (amp-alice-murmer-controller--go-to-state alice-holding-toy)
                
            }
        }
        block event cap-exited {
            track main {
                lambda 
                    (if (not (== (get-parent-attach-object (get-symbol dog-toy-id self)) alice))) 
                        (enable-collision-gamedriven (get-symbol dog-toy-id self) 0 0.00)
                        (amp--attach-dog-toy (get-symbol dog-toy-id self) alice 0.40)
                        (broadcast-event alice-picked-up-toy (new-boxed-value 7 (get-symbol dog-toy-id self)))
                        (amp-alice-murmer-controller--go-to-state alice-holding-toy)
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (set-heart-rate alice 0.50)
                
            }
        }
        block end {
            track main {
                lambda 
                    (set-boolean mirror-pick-up-anim? 0 self)
                
                lambda 
                    (set-boolean use-tight-space-pickup-anim? 0 self)
                
                lambda 
                    (set-symbol pick-up-toy-anim fob-alice-fetch-pick-up--alice self)
                
            }
        }
    }
    state alice-done-playing-fetch {
        block start {
            track anims {
                lambda 
                    (send-event yara-at-alice-final ss-amp-yara-walk-alice-fetch-1)
                
                lambda 
                    (wait-for-event yara-pet-alice-done 0 0 0 0 0 0 0 0 0)
                
                lambda 
                    (set-bound-frame alice-move-to-goal-loc (amp--find-dog-safe-point-on-navmesh (get-object-locator alice) 0.70 2.00 5.00) self)
                
                lambda 
                    (if (not (locator-equals-locator? (get-object-locator alice) (get-bound-frame alice-move-to-goal-loc self) 0.10 30.00))) 
                        (wait-npc-move-to alice (get-bound-frame alice-move-to-goal-loc self) 0 1 0 0 0 0)
                    
                
                lambda 
                    (define var_6)
                    (if (is-left? (get-object-locator alice) (offset-locator-on-axis (get-object-locator (get-symbol dog-toy-id self)) 1.00 1) 180.00)) 
                        (set! var_6 dog-ambi-lie-down-chew-toy-enter--toy)
                     else 
                        (set! var_6 dog-ambi-lie-down-chew-toy-enter-flipped--toy)
                    
                    (define var_7 (#%alloc-array single-frame 16 3 1))
                    (set! (deref (cast i32* (deref (+ (deref var_7) (* 0 8))))) 40)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_7) (* 0 8))) 8))) 0)
                    (set! (deref (cast i32* (+ (deref (+ (deref var_7) (* 0 8))) 8))) 1)
                    (set! (deref (cast i32* (deref (+ (deref var_7) (* 1 8))))) 28)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_7) (* 1 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_7) (* 1 8))) 8))) 0.50)
                    (set! (deref (cast i32* (deref (+ (deref var_7) (* 2 8))))) 30)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_7) (* 2 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_7) (* 2 8))) 8))) 0.00)
                    (animate_ (get-symbol dog-toy-id self) var_6 var_7)
                    (define var_8 (#%alloc-array single-frame 16 2 1))
                    (set! (deref (cast i32* (deref (+ (deref var_8) (* 0 8))))) 28)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_8) (* 0 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_8) (* 0 8))) 8))) 0.50)
                    (set! (deref (cast i32* (deref (+ (deref var_8) (* 1 8))))) 30)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_8) (* 1 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_8) (* 1 8))) 8))) 0.00)
                    (wait-animate_ alice dog-ambi-lie-down-chew-toy-enter var_8)
                    (amp-alice-murmer-controller--go-to-state alice-sitting-chewing-on-toy)
                    (define var_9 (#%alloc-array single-frame 16 2 1))
                    (set! (deref (cast i32* (deref (+ (deref var_9) (* 0 8))))) 28)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_9) (* 0 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_9) (* 0 8))) 8))) 0.50)
                    (set! (deref (cast i32* (deref (+ (deref var_9) (* 1 8))))) 30)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_9) (* 1 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_9) (* 1 8))) 8))) 0.00)
                    (animate_ alice dog-ambi-lie-down-chew-toy-loop var_9)
                
            }
        }
        block update {
            track main {
                lambda 
                    (set-heart-rate alice 0.10)
                
                lambda 
                    (suppress-heart-rate-gestures/f alice)
                
            }
        }
    }
    state end-fetch {
        block start {
            track main {
                lambda 
                    (fact-set global disable-scent-trail (new-boxed-value 1 0))
                
                lambda 
                    (detach (get-symbol dog-toy-id self))
                
                lambda 
                    (kill-entity-if-spawned (get-symbol dog-toy-id self))
                
                lambda 
                    (let loop () (when (npc-on-screen-and-visible? alice -1 0) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (kill-entity-if-spawned alice)
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
