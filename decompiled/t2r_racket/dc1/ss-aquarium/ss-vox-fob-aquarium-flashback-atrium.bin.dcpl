                    (wait-say owen vox-igc-own-gam-fob-aquarium-flashback-atrium-stairs-sp-003 2 0)
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
    }
    state owen-calls-out {
        block start {
            track main {
                lambda 
                    (wait-say owen vox-igc-own-gam-fob-aquarium-flashback-atrium-owen-sees-mural-spj-003 2 0)
                
                lambda 
                    (wait 0.70)
                
                lambda 
                    (wait-say owen vox-igc-own-gam-fob-aquarium-flashback-atrium-owen-sees-mural-spj-004 2 0)
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
    }
    state player-look-around {
        block start {
            track main {
                lambda 
                    (wait 0.75)
                
                lambda 
                    (if (> (get-joypad-stick-intensity move 0.20 1.00) 0.00)) 
                        (set-boolean vox-player-look-around-done 1 self)
                        (wait-say player vox-igc-abb-gam-fob-aquarium-flashback-enter-glass-tunnels-sp-002 2 0)
                    
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
    }
    state owen-photobooth {
        block start {
            track main {
                lambda 
                    (if (distance-between-objects-greater-than? player owen 8.00 1)) 
                        (say vox-fob-aqu-atrium-owen-fake-3 vox-igc-own-gam-fob-aquarium-flashback-atrium-wandering-slf-004 2 0)
                     else 
                        (say owen vox-igc-own-gam-fob-aquarium-flashback-atrium-wandering-slf-004 2 0)
                    
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
    }
    state owen-floor-tank {
        block start {
            track main {
                lambda 
                    (say owen vox-igc-own-gam-fob-aquarium-flashback-atrium-wandering-slf-001 2 0)
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
    }
    state photo {
        block start {
            track main {
                lambda 
                    (wait-for-event entered-into-investigate 0 0 0 0 0 0 0 0 0)
                
                lambda 
                    (wait 1.50)
                
                lambda 
                    (set-boolean vox-photo-done 1 self)
                
                lambda 
                    (wait-say player vox-igc-abb-gen-cya-plyr-laugh-reactns-sp-005 2 0)
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
        block event exiting-investigate {
            track main {
                lambda 
                    (if (not (get-boolean vox-photo-done self))) 
                        (go wait-for-event 1)
                    
                
            }
        }
    }
}
