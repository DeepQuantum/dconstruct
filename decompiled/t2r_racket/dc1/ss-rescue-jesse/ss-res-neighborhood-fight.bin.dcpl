                        (if (tension-mode-is? 3)) 
                            (play-music-stinger *music-playlist-res-neighborhood-fight-houses-combat-end-alt* 0)
                         else (if (tension-mode-is? 4)) 
                            (play-music-stinger *music-playlist-res-neighborhood-fight-houses-search-end-alt* 0)
                         else (if (tension-mode-is? 2)) 
                            (play-music-stinger *music-playlist-res-neighborhood-fight-houses-unaware-end-alt* 0)
                        
                    
                
                lambda 
                    (go done 1)
                
            }
        }
    }
}
