                        (set-boolean start-fresh? 0 self)
                        (if (<= (get-character-health (get-self-id)) 40)) 
                            (print-string "enabling headshots due to health threshhold" self)
                            (npc-enable-head-shots (get-self-id) 1)
                        
                        (if (> (get-character-health (get-self-id)) 0)) 
                            (go hit-reaction 1)
                        
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-complete? rescue-jesse res-downhill-drive-shooting-b)) 
                        (go aim 1)
                    
                
            }
        }
    }
    state unholster {
        block start {
            track main {
                lambda 
                    (wait-animate-npc-in-humvee (get-self-id) (get-unholster-anim) 0.00 0 0.00 0.00 0)
                
                lambda 
                    (go aim 1)
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (go death 1)
                
            }
        }
        block event npc-attacked {
            track main {
                lambda 
                    (if (not (task-active? rescue-jesse res-downhill-drive-transition))) 
                        (set-hit-location-by-locator (deref (+ (event::get-attack-info (get-event)) 64)))
                        (set-boolean start-fresh? 0 self)
                        (if (<= (get-character-health (get-self-id)) 40)) 
                            (print-string "enabling headshots due to health threshhold" self)
                            (npc-enable-head-shots (get-self-id) 1)
                        
                        (if (> (get-character-health (get-self-id)) 0)) 
                            (go hit-reaction 1)
                        
                    
                
            }
        }
        block event next-anim {
            track main {
                lambda 
                    (if (task-active? rescue-jesse res-downhill-drive-transition)) 
                        (set-boolean start-fresh? 1 self)
                        (set-boolean allow-no-blend? 0 self)
                        (go aim 1)
                    
                
            }
        }
    }
    state death {
        block start {
            track main {
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (character-allow-dead-ragdoll-snap-back-to-animation (get-self-id) 1)
                
                lambda 
                    (set-svar (ss-svar this-character-dead? self) 1)
                
                lambda 
                    (set-boolean is-dead? 1 self)
                
                lambda 
                    (wait-animate-npc-in-humvee (get-self-id) (get-death-anim) 0.00 0 0.50 0.00 0)
                
                lambda 
                    (go death-idle 1)
                
            }
        }
    }
    state death-idle {
        block start {
            track main {
                lambda 
                    (character-allow-dead-ragdoll-snap-back-to-animation (get-self-id) 1)
                
                lambda 
                    (wait-animate-npc-in-humvee (get-self-id) (get-death-idle-anim) 0.00 0 0.00 0.00 0)
                
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
