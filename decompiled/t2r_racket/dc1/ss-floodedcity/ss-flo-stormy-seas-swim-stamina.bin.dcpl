(define (player-use-breath--ski arg_0) 
    (swim-set-breath-meter (- (swim-get-breath-meter) arg_0))
)

statescript {
    declarations {
        f32 SWIM-DURATION = 23.00
        f32 FLOAT-DURATION = 30.00
        f32 STAMINA-COST = 35.00
        f32 TOTAL-STAMINA = 80.00
        bool in-safe-zone? = nullptr
    }
    state initial {
        block start {
            track main {
                lambda 
                    (if (task-range-active? flooded-city flo-stormy-seas-start find-aquarium faq-arrival)) 
                        (go stamina-think 1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-range-active? flooded-city flo-stormy-seas-start find-aquarium faq-arrival)) 
                        (go stamina-think 1)
                    
                
            }
        }
    }
    state stamina-think {
        block update {
            track main {
                lambda 
                    (if (character-is-swimming? player)) 
                        (player-use-breath--ski (* (/ 1.00 (get-float SWIM-DURATION self)) (get-delta-time)))
                        (if (not (get-boolean in-safe-zone? self))) 
                            (if (<= (swim-get-breath-meter) 0.01)) 
                                (kill-player)
                            
                        
                    
                
            }
        }
    }
}
