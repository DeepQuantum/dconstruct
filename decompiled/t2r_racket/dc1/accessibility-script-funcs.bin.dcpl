    (interactable-set-accessibility-sound-active-sweetener arg_0 0)
    (interactable-set-accessibility-sound-interact arg_0 0)
    (interactable-set-accessibility-sound-interact-sweetener arg_0 0)
    (interactable-set-accessibility-sound-interact-error-sweetener arg_0 0)
)

(define (clear-accessibility-pathfind-goal arg_0) 
    (define var_1)
    (if (and (== arg_0 0) (== (get-symbol goal ss-accessibility-pathfind) arg_0))) 
        (set! var_1 (set-accessibility-pathfind-goal 0))
     else 
        (set! var_1 0)
    
    var_1
)

(define (set-accessibility-pathfind-goal-horse arg_0) 
    (send-event set-goal-horse ss-accessibility-pathfind (new-boxed-value 7 arg_0))
)

(define (play-accessibility-circle-sound-at-position arg_0) 
    (define var_3)
    (if (and (and (is-traversal-audio-cues?) (enough-time-since-player-fact? accessibility-cue 0.50)) (enough-time-since-player-fact? accessibility-circle-cue 2.00))) 
        (play-accessibility-sound-at-position sfx-ui-acc-prompt-circle-button arg_0 0)
        (debug-draw-string-centered "ACCESSIBILITY AUDIO CUE - CROUCH PRESS" 600.00 2 2.00 2.00 0 0)
        (set-player-fact-time accessibility-cue)
        (set! var_3 (set-player-fact-time accessibility-circle-cue))
     else 
        (set! var_3 0)
    
    var_3
)

(define (play-accessibility-control-lost-control-sound) 
    (define var_1)
    (if (is-traversal-audio-cues?)) 
        (play-sound sfx-ui-acc-player-control-lost 0)
        (set! var_1 (debug-draw-string-centered "ACCESSIBILITY AUDIO CUE - CONTROL LOST" 600.00 9 2.00 2.00 0 0))
     else 
        (set! var_1 0)
    
    var_1
)

