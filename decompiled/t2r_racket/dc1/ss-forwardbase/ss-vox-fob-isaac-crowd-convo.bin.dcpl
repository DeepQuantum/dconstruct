statescript {
    options {
        player
        fob-forward-base-script
    }
    declarations {
        symbol convo-id = #0000000000000000
    }
    state task-check {
        block start {
            track main {
                lambda 
                    (if (task-complete? forward-base fob-forward-base-nora-treating-mel)) 
                        (go done 1)
                    
                
                lambda 
                    (if (task-range-active? forward-base fob-forward-base-explore forward-base fob-forward-base-nora-treating-mel)) 
                        (go waiting 1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-range-active? forward-base fob-forward-base-explore forward-base fob-forward-base-nora-treating-mel)) 
                        (go waiting 1)
                    
                
            }
        }
    }
    state waiting {
        block event inside {
            track main {
                lambda 
                    (go conversation 1)
                
            }
        }
        block event trigger-convo-from-script {
            track main {
                lambda 
                    (go conversation 1)
                
            }
        }
    }
    state conversation {
        block start {
            track main {
                lambda 
                    (wait-play-fob-isaac-convo (tag-symbol convo-id self))
                
                lambda 
                    (go done 1)
                
            }
        }
    }
    state done-wait {
        block start {
            track main {
                lambda 
                    (wait 10.00)
                
                lambda 
                    (go waiting 1)
                
            }
        }
    }
}
