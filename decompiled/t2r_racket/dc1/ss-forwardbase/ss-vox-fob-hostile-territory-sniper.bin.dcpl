                         else (if (and (and (and (get-boolean vox-bookstore-convo-played? self) (! (get-boolean vox-interior-convo-started? self))) (get-boolean vox-exterior-convo-played? self)) (get-boolean vox-can-play-interior-convo? self))) 
                            (set-boolean vox-interior-convo-started? 1 self)
                            (request-dialog fob-hostile-territory-sniper-convo-interior-001 npc-fob-scar-4 npc-fob-scar-3 0 0 0 0)
                        
                     else (if (and (and (and (and (and (== (event-arg-symbol 0) npc-fob-scar-5) (== (event-arg-symbol 1) npc-fob-scar-6)) (== (event-arg-symbol 2) ss-patrol-poi-group-17)) (! (faction-investigating? 4))) (tension-mode-is? 2)) (get-boolean vox-hear-exterior-convo? self))) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "arrived at exterior poi") 19)
                        
                        (if (! (get-boolean vox-exterior-convo-started? self))) 
                            (set-boolean vox-exterior-convo-started? 1 self)
                            (request-dialog fob-hostile-territory-sniper-convo-boba-001 npc-fob-scar-6 npc-fob-scar-5 0 0 0 0)
                         else (if (and (and (get-boolean vox-exterior-convo-played? self) (! (get-boolean vox-interior-convo-played? self))) (get-boolean vox-can-play-interior-convo? self))) 
                            (set-boolean vox-interior-convo-started? 1 self)
                            (request-dialog fob-hostile-territory-sniper-convo-interior-001 npc-fob-scar-5 npc-fob-scar-6 0 0 0 0)
                        
                     else (if (and (and (and (and (and (== (event-arg-symbol 0) npc-fob-scar-6) (== (event-arg-symbol 1) npc-fob-scar-5)) (== (event-arg-symbol 2) ss-patrol-poi-group-17)) (! (faction-investigating? 4))) (tension-mode-is? 2)) (get-boolean vox-hear-exterior-convo? self))) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "arrived at exterior poi") 19)
                        
                        (if (! (get-boolean vox-exterior-convo-started? self))) 
                            (set-boolean vox-exterior-convo-started? 1 self)
                            (request-dialog fob-hostile-territory-sniper-convo-boba-001 npc-fob-scar-6 npc-fob-scar-5 0 0 0 0)
                         else (if (and (and (get-boolean vox-exterior-convo-played? self) (! (get-boolean vox-interior-convo-played? self))) (get-boolean vox-can-play-interior-convo? self))) 
                            (set-boolean vox-interior-convo-started? 1 self)
                            (request-dialog fob-hostile-territory-sniper-convo-interior-001 npc-fob-scar-5 npc-fob-scar-6 0 0 0 0)
                        
                     else (if (and (and (and (and (and (== (event-arg-symbol 0) npc-fob-scar-3) (== (event-arg-symbol 1) npc-fob-scar-4)) (== (event-arg-symbol 2) ss-patrol-poi-group-17)) (! (faction-investigating? 4))) (tension-mode-is? 2)) (get-boolean vox-hear-exterior-convo? self))) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "arrived at exterior poi") 19)
                        
                        (if (! (get-boolean vox-exterior-convo-started? self))) 
                            (set-boolean vox-exterior-convo-started? 1 self)
                            (request-dialog fob-hostile-territory-sniper-convo-boba-001 npc-fob-scar-3 npc-fob-scar-4 0 0 0 0)
                         else (if (and (and (get-boolean vox-exterior-convo-played? self) (! (get-boolean vox-interior-convo-played? self))) (get-boolean vox-can-play-interior-convo? self))) 
                            (set-boolean vox-interior-convo-started? 1 self)
                            (request-dialog fob-hostile-territory-sniper-convo-interior-001 npc-fob-scar-4 npc-fob-scar-3 0 0 0 0)
                        
                     else (if (and (and (and (and (and (== (event-arg-symbol 0) npc-fob-scar-4) (== (event-arg-symbol 1) npc-fob-scar-3)) (== (event-arg-symbol 2) ss-patrol-poi-group-17)) (! (faction-investigating? 4))) (tension-mode-is? 2)) (get-boolean vox-hear-exterior-convo? self))) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "arrived at exterior poi") 19)
                        
                        (if (! (get-boolean vox-exterior-convo-started? self))) 
                            (set-boolean vox-exterior-convo-started? 1 self)
                            (request-dialog fob-hostile-territory-sniper-convo-boba-001 npc-fob-scar-3 npc-fob-scar-4 0 0 0 0)
                         else (if (and (and (get-boolean vox-exterior-convo-played? self) (! (get-boolean vox-interior-convo-played? self))) (get-boolean vox-can-play-interior-convo? self))) 
                            (set-boolean vox-interior-convo-started? 1 self)
                            (request-dialog fob-hostile-territory-sniper-convo-interior-001 npc-fob-scar-4 npc-fob-scar-3 0 0 0 0)
                        
                    
                
            }
        }
    }
    state combat-over {
        block start {
            track main {
                lambda 
                    (wait-until-non-combat-tension 2.00 4.00)
                
                lambda 
                    (let loop () (when (and (player-in-region? rgn-vox-fob-hostile-territory-sniper-building-1 2) (not (is-centered-on-screen? (get-object-position ic-vox-look-at-sniper-building-1) 300.00))) 
                        (wait 0.10)
                     (loop)))
                
                lambda 
                    (if (player-in-region? rgn-vox-fob-hostile-territory-sniper-building-1 2)) 
                        (wait-say player vox-igc-abb-gam-fob-hostile-territory-sniper-combat-done-slf-028 2 0)
                        (wait 0.30)
                        (wait-say player vox-igc-abb-gam-fob-hostile-territory-sniper-combat-done-slf-029 2 0)
                     else 
                        (wait-say player vox-igc-abb-gam-fob-hostile-territory-sniper-combat-done-slf-023 2 0)
                        (wait 0.30)
                        (wait-say player vox-igc-abb-gam-fob-hostile-territory-sniper-combat-done-slf-024 2 0)
                    
                
                lambda 
                    (if (is-encounter-select?)) 
                        (wait 1.50)
                        (select-mode-mark-complete 0.00)
                    
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
    }
    state spawned-reinforcements {
        block start {
            track main {
                lambda 
                    (wait-say player vox-igc-abb-gam-fob-hostile-territory-sniper-wh-008 2 0)
                
                lambda 
                    (wait 0.60)
                
                lambda 
                    (wait-say player vox-igc-abb-gam-fob-hostile-territory-sniper-wh-014 2 0)
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
    }
    state see-books {
        block start {
            track main {
                lambda 
                    (wait-say player vox-igc-abb-gam-fob-hostile-territory-sniper-combat-done-slf-001 2 0)
                
                lambda 
                    (wait 0.30)
                
                lambda 
                    (wait-say player vox-igc-abb-gam-fob-hostile-territory-sniper-combat-done-slf-002 2 0)
                
                lambda 
                    (wait 0.50)
                
                lambda 
                    (wait-say player vox-igc-abb-gam-fob-hostile-territory-sniper-combat-done-slf-003 2 0)
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
    }
    state office-stairs {
        block start {
            track main {
                lambda 
                    (wait-say player vox-igc-abb-gam-fob-hostile-territory-sniper-combat-done-slf-021 2 0)
                
                lambda 
                    (wait 0.30)
                
                lambda 
                    (wait-say player vox-igc-abb-gam-fob-hostile-territory-sniper-combat-done-slf-022 2 0)
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
    }
    state found-climb-up {
        block start {
            track main {
                lambda 
                    (if (is-encounter-select?)) 
                        (wait 1.50)
                        (select-mode-mark-complete 0.00)
                    
                
                lambda 
                    (let loop () (when (not (is-centered-on-screen? (get-object-position ic-vox-look-at-climb-up-1) 200.00)) 
                        (wait 0.10)
                     (loop)))
                
                lambda 
                    (wait-say player vox-igc-abb-gen-cya-plyr-hint-gnrc-solo-slf-010 2 0)
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
        block event exit {
            track main {
                lambda 
                    (go wait-for-event 1)
                
            }
        }
    }
