                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 0 8))))) 28)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_0) (* 0 8))) 8))) 0.50)
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 1 8))))) 30)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 1 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_0) (* 1 8))) 8))) 0.30)
                    (wait-animate_ npc-fob-stadium-bear-1 dog-ambi-sit-enter var_0)
                
                lambda 
                    (define var_0 (#%alloc-array single-frame 16 1 1))
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 0 8))))) 28)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_0) (* 0 8))) 8))) 0.30)
                    (animate_ npc-fob-stadium-bear-1 dog-ambi-sit-idle var_0)
                
            }
            track wait-for-ball-return {
                lambda 
                    (wait-for bear-stopped)
                
                lambda 
                    (let loop () (when (and (entity-exists? (get-symbol ball-id self)) (not (locator-in-region? (get-object-locator (get-symbol ball-id self)) rgn-fob-play-fetch-bounds-return-1 player))) 
                        (wait 0.10)
                     (loop)))
                
                lambda 
                    (go ball-returned 1)
                
            }
            track ball-gone {
                lambda 
                    (wait-for bear-stopped)
                
                lambda 
                    (wait-say player vox-igc-abb-gam-fob-stadium-play-fetch-sp-012 2 0)
                
            }
        }
        block update {
            track main {
                lambda 
                    (send-event suppress-become-interactable (get-symbol ball-id self))
                
                lambda 
                    (suppress-heart-rate-gestures/f npc-fob-stadium-bear-1)
                
                lambda 
                    (player-disable-auto-holster)
                
            }
        }
        block event player-threw-projectile {
            track main {
                lambda 
                    (set-symbol ball-id (event-arg-symbol 0) self)
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-active? forward-base fob-stadium-gun-range)) 
                        (go complete 1)
                    
                
            }
        }
    }
    state end-fetch {
        block start {
            track main {
                lambda 
                    (set-boolean override-heart-rate-state? 0 self)
                
                lambda 
                    (send-event evt-disable-pets ss-fob-stadium-field-pet-bear-1)
                
                lambda 
                    (go complete 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (not (== (get-symbol ball-id self) 0))) 
                        (send-event suppress-become-interactable (get-symbol ball-id self))
                    
                
            }
        }
    }
    state ball-returned {
        block start {
            track main {
                lambda 
                    (define var_0 (#%alloc-array single-frame 16 2 1))
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 0 8))))) 28)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_0) (* 0 8))) 8))) 0.30)
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 1 8))))) 30)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 1 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_0) (* 1 8))) 8))) 0.50)
                    (wait-animate_ npc-fob-stadium-bear-1 dog-ambi-sit-exit var_0)
                
                lambda 
                    (set-boolean fetch-finished 1 self)
                
                lambda 
                    (set-boolean vox-dropped-ball? 1 self)
                
                lambda 
                    (go bear-recover-untaken-ball 1)
                
            }
        }
    }
}
