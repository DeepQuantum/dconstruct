                    (wait-camera-fade-out-animated-to-remap 1.50 *camera-remap-close* 7.00 12 0)
                
                lambda 
                    (go wait-near-squeeze-through 1)
                
            }
            track vox {
                lambda 
                    (say player vox-igc-abb-igc-fob-explore-squeeze-through-attack-success-exit-001 2 0)
                
            }
        }
        block update {
            track main {
                lambda 
                    (accessibility-suppress-control-sounds/f)
                
            }
        }
    }
}
