                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 2 8))))) 30)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 2 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_0) (* 2 8))) 8))) 0.30)
                    (animate_ obj-fob-stadium-exit-gun-range-target-2 fob-stadium-replay-shooting-range-start--sled var_0)
                
                lambda 
                    (camera-fade-out-animated 2.00 0)
                
                lambda 
                    (go not-shooting 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (not (get-boolean allow-auto-reload? self))) 
                        (player-no-auto-reload)
                    
                
                lambda 
                    (if (not (signal-raised? allow-stick 0))) 
                        (player-disable-move-stick)
                    
                
            }
        }
    }
}
