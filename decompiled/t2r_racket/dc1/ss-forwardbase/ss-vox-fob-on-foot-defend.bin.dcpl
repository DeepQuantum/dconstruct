                    (define var_0 (darray-create self -1 0))
                    (group-copy fob-defend-humvee-militia var_0)
                    (darray-find-remove var_0 (new-boxed-value 7 npc-wlf-humvee-2-driver-fb-1) 0)
                    (let loop () (when (> (darray-count var_0) 0) 
                        (wait-random 0.20 0.50)
                        (define var_4 (group-random var_0))
                        (darray-find-remove var_0 (new-boxed-value 7 var_4) 0)
                        (set! var_3 (send-event fob-defend-victory var_4))
                     (loop)))
                
            }
        }
        block event disable-look-at {
            track main {
                lambda 
                    (interactable-disable int-fob-defend-look-at-humvee-1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (look-at-object manny npc-wlf-humvee-1-driver-f-1 headb 10.00)
                
            }
        }
        block end {
            track main {
                lambda 
                    (clear-look-at manny)
                
                lambda 
                    (clear-look-at mel)
                
            }
        }
    }
}
