                    (wait-for arrived-at-goal)
                
                lambda 
                    (npc-look-at-object mel obj-fob-nursery-exit-view-target-1 0 10.00)
                
                lambda 
                    (point-to-point mel (get-spawner-position obj-fob-nursery-exit-view-target-1 1) 11 0)
                
            }
            track vox {
                lambda 
                    (wait-for arrived-at-goal)
                
                lambda 
                    (send-event player-requested-hint ss-vox-fob-on-foot-store-nursery-1)
                
            }
        }
        block event suggested-exit-hinted {
            track main {
                lambda 
                    (go nursery-explore-near-exit 1)
                
            }
        }
        block event search-parking-lot {
            track main {
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
