                    (define var_0 (get-animation-frame obj-far-barn-doors-1 2 far-barn-door-close-short--doors))
                    (if (>= var_0 29.00)) 
                        (change-render-setting-value-float *far-rs-farm-barn-eve-ptsd-inside* lighting:bg-dual-lightmap-blend (lerp-scale 30.00 39.00 0.30 1.00 var_0))
                    
                    (if (>= var_0 32.50)) 
                        (override-render-settings *far-rs-far-farm-barn-dark* 0.17 -1.00 0 32767 0 1 0 1.00)
                    
                    (if (>= var_0 39.00)) 
                        (set! var_2 (set-black-fade 1.00 0 0 1))
                    
                
            }
        }
    }
    state darkness {
        block start {
            track anim {
                lambda 
                    (set-accessibility-pathfind-unavailable)
                
                lambda 
                    (send-event hide-baby-wrap ss-far-controller-player-meshes-1)
                
                lambda 
                    (send-event amb-ptsd-darkness ss-snd-far-amb-script-barn-ptsd-1)
                
                lambda 
                    (clear-accessibility-pathfind-goal 0)
                
                lambda 
                    (task-complete! farm far-herding-baby-sheep-escape)
                
                lambda 
                    (stop-animating player 2 0.00 0 0)
                
                lambda 
                    (animate-start player far-abandoned-house-ellie-staircase--ellie ap-far-abandoned-player-intro-1 0)
                
                lambda 
                    (kill-entity-if-spawned obj-far-explore-baby-1)
                
                lambda 
                    (go complete 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (override-render-settings *far-rs-far-farm-barn-dark* 0.00 -1.00 0 32767 0 1 0 1.00)
                
                lambda 
                    (set-black-fade 1.00 0 0 1)
                
                lambda 
                    (joypad-disable-all-commands)
                
            }
        }
    }
}
