            track vox {
                lambda 
                    (wait-for anim-ready)
                
                lambda 
                    (say dina vox-igc-din-igc-joe-school-interrogation-fail-001 2 0)
                
                lambda 
                    (say obj-joe-school-jordan-1 vox-igc-jor-igc-joe-school-interrogation-fail-001 2 0)
                
            }
            track music {
                lambda 
                    (play-music-stinger *music-playlist-joe-school-interrogation-dina-death* 0)
                
            }
        }
        block update {
            track main {
                lambda 
                    (hud2-simulate-player-death/f)
                
                lambda 
                    (joypad-disable-all-commands)
                
            }
        }
    }
    state complete {
        block start {
            track main {
                lambda 
                    (interactable-camera-remap-default int-joe-school-fake-remap-1)
                
                lambda 
                    (hud2-hide-health-ammo/f 0 0)
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (task-active? jordan-escape joe-school-interrogation-kill-jordan)) 
                        (hud2-hide-health-ammo/f 0 0)
                    
                
            }
        }
    }
}
