                lambda 
                    (if (player-in-region? rgn-joe-apt-dina-go-doorway-1 2)) 
                        (go lead-to-exit 1)
                     else (if (player-in-region? rgn-joe-apt-dina-go-hallway-1 2)) 
                        (go lead-to-apt 1)
                     else 
                        (go in-last-apt 1)
                    
                
