    state lead-to-exit {
        block start {
            track main {
                lambda 
                    (wait-npc-use-cinematic-action-pack dina cap-joe-dina-doorway-2 1 0 0)
                
                lambda 
                    (wait-npc-use-positional-action-pack dina pap-joe-dina-doorway-wait-1 0 1 0 0.50 0.50 0 0 0)
                
