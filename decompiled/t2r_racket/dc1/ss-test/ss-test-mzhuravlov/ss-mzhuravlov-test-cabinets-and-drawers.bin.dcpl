                            (set-symbol pickup-ik-solver (joint-ik-characters player (get-symbol invis-proxy-ik-second self) 1 root 0 (- (* (get-animation-duration player (get-symbol scav-pickup-animation self)) (get-float scav-pickup-object-phase self)) 0.10) 0) self)
                        
                        (set-boolean pickup-ik-in-use? 1 self)
                    
                
                lambda 
                    (if (and (>= (get-animation-phase player 2 (get-symbol scav-pickup-animation self)) (get-float scav-pickup-object-phase self)) (get-boolean pickup-ik-in-use? self))) 
                        (stop-joint-ik (get-symbol pickup-ik-solver self) (- (* (get-animation-duration player (get-symbol scav-pickup-animation self)) (get-float scav-pickup-object-stowe-phase self)) (* (get-animation-duration player (get-symbol scav-pickup-animation self)) (get-float scav-pickup-object-phase self))))
                        (set-boolean pickup-ik-in-use? 0 self)
                    
                
                lambda 
                    (if (and (> (get-joypad-stick-intensity move 0.20 1.00) 0.10) (>= (get-animation-phase player 2 (get-symbol scav-pickup-animation self)) (get-float scav-pickup-object-phase self)))) 
                        (set-boolean is-early-exit 1 self)
                        (go scavenge-exit 1)
                    
                
                lambda 
                    (if (>= (get-animation-phase player 2 (get-symbol scav-pickup-animation self)) (get-float scav-pickup-animation-exit-phase self))) 
                        (go scavenge-exit 1)
                    
                
            }
        }
    }
    state scavenge-exit {
        block start {
            track main {
                lambda 
                    (if (get-boolean is-early-exit self)) 
                        (define var_3)
                        (if (object-anim-playing? player (get-symbol scav-exit-animation self) 0)) 
                            (set! var_3 (get-symbol scav-exit-animation self))
                         else 
                            (set! var_3 (get-symbol scav-pickup-animation self))
                        
                        (stop-animating (get-symbol current-interactable-scav self) 2 0.20 0 0)
                        (stop-animating player 0 0.60 (get-symbol scav-pickup-animation self) 0)
                        (define var_11)
                        (if (object-anim-playing? player (get-symbol scav-exit-animation self) 0)) 
                            (set! var_11 (get-symbol scav-exit-animation self))
                         else 
                            (set! var_11 (get-symbol scav-pickup-animation self))
                        
                        (define var_14 (#%alloc-array single-frame 16 6 1))
                        (set! (deref (cast i32* (deref (+ (deref var_14) (* 0 8))))) 57)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_14) (* 0 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_14) (* 0 8))) 8))) (get-animation-frame player 2 var_3))
                        (set! (deref (cast i32* (deref (+ (deref var_14) (* 1 8))))) 28)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_14) (* 1 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_14) (* 1 8))) 8))) 0.20)
                        (set! (deref (cast i32* (deref (+ (deref var_14) (* 2 8))))) 40)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_14) (* 2 8))) 8))) 0)
                        (set! (deref (cast i32* (+ (deref (+ (deref var_14) (* 2 8))) 8))) 1)
                        (set! (deref (cast i32* (deref (+ (deref var_14) (* 3 8))))) 75)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_14) (* 3 8))) 8))) 0)
                        (define var_16)
                        (if (get-boolean mirror? self)) 
                            (set! var_16 *scav-drawer-exit-l-hand*)
                         else 
                            (set! var_16 *scav-drawer-exit-r-hand*)
                        
                        (set! (deref (cast u64* (+ (deref (+ (deref var_14) (* 3 8))) 8))) var_16)
                        (set! (deref (cast i32* (deref (+ (deref var_14) (* 4 8))))) 30)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_14) (* 4 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_14) (* 4 8))) 8))) 0.40)
                        (set! (deref (cast i32* (deref (+ (deref var_14) (* 5 8))))) 44)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_14) (* 5 8))) 8))) 0)
                        (set! (deref (cast u8* (+ (deref (+ (deref var_14) (* 5 8))) 8))) (get-boolean mirror? self))
                        (animate_ player var_11 var_14)
                     else 
                        (define var_23 (#%alloc-array single-frame 16 2 1))
                        (set! (deref (cast i32* (deref (+ (deref var_23) (* 0 8))))) 28)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_23) (* 0 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_23) (* 0 8))) 8))) 0.40)
                        (set! (deref (cast i32* (deref (+ (deref var_23) (* 1 8))))) 27)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_23) (* 1 8))) 8))) 0)
                        (set! (deref (cast u8* (+ (deref (+ (deref var_23) (* 1 8))) 8))) 2)
                        (animate_ (get-symbol current-interactable-scav self) (symbol-concat-string (get-symbol scav-exit-animation self) (get-string cab-anim-suffix self)) var_23)
                        (define var_25 (#%alloc-array single-frame 16 9 1))
                        (set! (deref (cast i32* (deref (+ (deref var_25) (* 0 8))))) 28)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_25) (* 0 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_25) (* 0 8))) 8))) 0.40)
                        (set! (deref (cast i32* (deref (+ (deref var_25) (* 1 8))))) 27)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_25) (* 1 8))) 8))) 0)
                        (set! (deref (cast u8* (+ (deref (+ (deref var_25) (* 1 8))) 8))) 2)
                        (set! (deref (cast i32* (deref (+ (deref var_25) (* 2 8))))) 45)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_25) (* 2 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_25) (* 2 8))) 8))) 0.40)
                        (set! (deref (cast i32* (deref (+ (deref var_25) (* 3 8))))) 30)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_25) (* 3 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_25) (* 3 8))) 8))) 0.40)
                        (set! (deref (cast i32* (deref (+ (deref var_25) (* 4 8))))) 29)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_25) (* 4 8))) 8))) 0)
                        (set! (deref (cast u8* (+ (deref (+ (deref var_25) (* 4 8))) 8))) 2)
                        (set! (deref (cast i32* (deref (+ (deref var_25) (* 5 8))))) 14)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_25) (* 5 8))) 8))) 0)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_25) (* 5 8))) 8))) apReference-straight)
                        (set! (deref (cast i32* (deref (+ (deref var_25) (* 6 8))))) 10)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_25) (* 6 8))) 8))) 0)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_25) (* 6 8))) 8))) (get-bound-frame goal self))
                        (set! (deref (cast i32* (deref (+ (deref var_25) (* 7 8))))) 44)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_25) (* 7 8))) 8))) 0)
                        (set! (deref (cast u8* (+ (deref (+ (deref var_25) (* 7 8))) 8))) (get-boolean mirror? self))
                        (set! (deref (cast i32* (deref (+ (deref var_25) (* 8 8))))) 24)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_25) (* 8 8))) 8))) 0)
                        (define var_29)
                        (if (get-boolean is-crouch? self)) 
                            (set! var_29 18)
                         else 
                            (set! var_29 1)
                        
                        (set! (deref (cast i32* (+ (deref (+ (deref var_25) (* 8 8))) 8))) var_29)
                        (animate_ player (get-symbol scav-exit-animation self) var_25)
                        (stop-animating (get-symbol current-interactable-scav self) 2 0.20 0 0)
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (draw-help)
                
                lambda 
                    (ss-drawer-attachment (symbol-concat-string (get-symbol scav-exit-animation self) (get-string cab-anim-suffix self)))
                
                lambda 
                    (if (and (> (get-joypad-stick-intensity move 0.20 1.00) 0.10) (not (get-boolean is-early-exit self)))) 
                        (set-boolean is-early-exit 1 self)
                        (go scavenge-exit 1)
                    
                
                lambda 
                    (if (and (and (get-boolean is-early-exit self) (not (object-anim-playing? player (get-symbol scav-exit-animation self) 0))) (not (object-anim-playing? player (get-symbol scav-pickup-animation self) 0)))) 
                        (if (object-spawned? (get-symbol r-ik-solver self))) 
                            (stop-joint-ik (get-symbol r-ik-solver self) 0.20)
                        
                        (if (object-spawned? (get-symbol l-ik-solver self))) 
                            (stop-joint-ik (get-symbol l-ik-solver self) 0.20)
                        
                        (if (object-spawned? (get-symbol pickup-ik-solver self))) 
                            (stop-joint-ik (get-symbol pickup-ik-solver self) 0.20)
                        
                        (set-boolean main-ik-in-use? 0 self)
                    
                
                lambda 
                    (if (and (>= (get-animation-frame player 2 (get-symbol scav-exit-animation self)) (get-float l-ik-off-frame self)) (get-boolean main-ik-in-use? self))) 
                        (if (get-boolean mirror? self)) 
                            (stop-joint-ik (get-symbol r-ik-solver self) 0.40)
                         else 
                            (stop-joint-ik (get-symbol l-ik-solver self) 0.40)
                        
                        (set-boolean main-ik-in-use? 0 self)
                    
                
                lambda 
                    (if (and (not (object-anim-playing? player (get-symbol scav-exit-animation self) 0)) (not (object-anim-playing? player (get-symbol scav-pickup-animation self) 0)))) 
                        (go initial 1)
                    
                
            }
        }
    }
}
