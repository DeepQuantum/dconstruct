        block event selection-active {
            track main {
                lambda 
                    (define var_4 (kick-raycast (camera-locator 1) (offset-locator (camera-locator 1) (alloc-vector 0.00 0.00 35.00 1.00 0)) 0 4097))
                    (wait-one-frame)
                    (if (wait-raycast-hit-nothing? var_4)) 
                     else 
                        (set-bound-frame active-region-locator (wait-raycast var_4) self)
                        (debug-draw-sphere (get-locator-position (get-bound-frame active-region-locator self)) 0.25 3 0.00 0 0)
                        (define var_11 (select-points (get-bound-frame active-region-locator self)))
                        (if (not (== var_11 0))) 
                            (set! var_12 (set-symbol activity var_11 self))
                        
                    
                
            }
        }
        block event change-demeanor {
            track main {
                lambda 
                    (if (== (event-arg-int32 0) 1)) 
                        (++ demeanor-pointer self)
                     else 
                        (-- demeanor-pointer self)
                    
                
                lambda 
                    (if (> (get-int32 demeanor-pointer self) 3)) 
                        (set-int32 demeanor-pointer 1 self)
                     else (if (< (get-int32 demeanor-pointer self) 1)) 
                        (set-int32 demeanor-pointer 3 self)
                    
                
                lambda 
                    (update-npc-demeanor)
                
            }
        }
        block event change-speed {
            track main {
                lambda 
                    (if (== (event-arg-int32 0) 1)) 
                        (++ speed-pointer self)
                     else 
                        (-- speed-pointer self)
                    
                
                lambda 
                    (if (> (get-int32 speed-pointer self) 2)) 
                        (set-int32 speed-pointer 1 self)
                     else (if (< (get-int32 speed-pointer self) 1)) 
                        (set-int32 speed-pointer 2 self)
                    
                
                lambda 
                    (if (== (get-int32 speed-pointer self) 1)) 
                        (set-int32 speed-enum 0 self)
                     else (if (== (get-int32 speed-pointer self) 2)) 
                        (set-int32 speed-enum 1 self)
                    
                
            }
        }
        block event move {
            track main {
                lambda 
                    (npc-stop npc-main-01)
                
                lambda 
                    (update-npc-demeanor)
                
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (if (get-boolean is-door-right? self)) 
                        (define var_1 (#%alloc-array single-frame 16 2 1))
                        (set! (deref (cast i32* (deref (+ (deref var_1) (* 0 8))))) 28)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 0 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_1) (* 0 8))) 8))) 0.00)
                        (set! (deref (cast i32* (deref (+ (deref var_1) (* 1 8))))) 58)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_1) (* 1 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_1) (* 1 8))) 8))) 1.00)
                        (animate_ door-right-1 ellie-door-stand-right-close-push-quick-door var_1)
                     else 
                        (define var_2 (#%alloc-array single-frame 16 2 1))
                        (set! (deref (cast i32* (deref (+ (deref var_2) (* 0 8))))) 28)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_2) (* 0 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_2) (* 0 8))) 8))) 0.00)
                        (set! (deref (cast i32* (deref (+ (deref var_2) (* 1 8))))) 58)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_2) (* 1 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_2) (* 1 8))) 8))) 1.00)
                        (animate_ door-left-1 ellie-door-stand-left-close-push-quick-door var_2)
                    
                
                lambda 
                    (if (get-boolean reverse-path self)) 
                        (set-symbol goal-temp (get-symbol goal-1 self) self)
                        (set-symbol goal-1 (get-symbol goal-2 self) self)
                        (set-symbol goal-2 (get-symbol goal-temp self) self)
                        (set-boolean reverse-path 0 self)
                    
                
                lambda 
                    (npc-teleport-to (get-symbol active-npc self) (get-object-locator (get-symbol goal-1 self)))
                
                lambda 
                    (wait 0.20)
                
                lambda 
                    (npc-move-to (get-symbol active-npc self) (get-object-locator (get-symbol goal-2 self)) (get-int32 speed-enum self) 0 0 0 0 0)
                
            }
        }
        block event swap-npc-player {
            track main {
                lambda 
                    (if (get-boolean swap-for-player self)) 
                        (npc-teleport-to (get-symbol active-npc self) (get-object-locator obj-ellie-1))
                        (teleport-character player obj-right-2)
                        (player-remove-weapons)
                        (set-boolean swap-for-player 0 self)
                     else 
                        (teleport-character player obj-ellie-1)
                        (npc-teleport-to (get-symbol active-npc self) (get-object-locator obj-right-2))
                        (player-remove-weapons)
                        (set-boolean swap-for-player 1 self)
                    
                
            }
        }
        block event spawn-npc {
            track main {
                lambda 
                    (spawn-test-npc)
                
            }
        }
        block event spawn-infected {
            track main {
                lambda 
                    (spawn-test-infected)
                
            }
        }
    }
}
