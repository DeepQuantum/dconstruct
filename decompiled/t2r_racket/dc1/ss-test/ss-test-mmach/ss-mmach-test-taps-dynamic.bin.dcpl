                lambda 
                    (if (debug-joypad-command-active? fire-hold 0)) 
                        (send-event selection-active self)
                        (set-symbol active-npc-selection (hud-debug-group-menu character-group (get-symbol active-npc-selection self) (alloc-point (get-float top-menu-x-start self) (get-float top-menu-y-start self) 0.00 0) (alloc-vector -14.00 6.00 0.00 1.00 0) npc-group-menu-confirmed npc-debug-group-menu-updated 0.60 "triangle" 8.00) self)
                    
                
                lambda 
                    (if (and (debug-joypad-command-active? jump 0) (not (debug-joypad-command-active? fire-hold 0)))) 
                        (if (debug-joypad-command-active? aim 0)) 
                            (send-event move self (new-boxed-value 1 1))
                         else 
                            (send-event move self (new-boxed-value 1 0))
                        
                    
                
                lambda 
                    (if (and (or (and (and (and (not (debug-joypad-command-active? fire-hold 0)) (not (debug-joypad-command-active? interact-hold 0))) (debug-joypad-command-active? aim 0)) (not (== (get-symbol current-object self) 0))) (== (get-symbol current-object self) (get-symbol platform-start self))) (== (get-symbol current-object self) (get-symbol platform-end self)))) 
