        vector jump-offset = (0.00, -1.00, 0.00, 1.00)
        f32 height-increment = 0.10
    }
    state initial {
        block  {
        }
        block update {
            track main {
                lambda 
                    (player-disable-grab-melee-moves)
                
                lambda 
                    (draw-demeanor-caption)
                
                lambda 
                    (draw-speed-caption)
                
                lambda 
                    (draw-weapon-hold-caption)
                
                lambda 
                    (draw-strafe-caption)
                
                lambda 
                    (draw-mt-caption)
                
                lambda 
                    (draw-tap-help)
                
                lambda 
