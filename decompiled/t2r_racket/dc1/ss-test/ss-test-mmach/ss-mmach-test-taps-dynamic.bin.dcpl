                                    (set-vector vault-start-platform-offset (vector-add (get-vector vault-start-platform-offset self) (alloc-vector 0.00 (get-float height-increment self) 0.00 1.00 0)) self)
                                 else 
                                    (set-vector vault-end-platform-offset (vector-add (get-vector vault-end-platform-offset self) (alloc-vector 0.00 (get-float height-increment self) 0.00 1.00 0)) self)
                                
                                (update-vault-tap-params (get-vector vault-start-platform-offset self) (get-vector vault-end-platform-offset self) vault-offset wall-height 1.00)
