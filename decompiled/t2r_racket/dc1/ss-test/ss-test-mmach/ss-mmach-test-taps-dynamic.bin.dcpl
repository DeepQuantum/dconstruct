        block event move {
            track main {
                lambda 
                    (if (not (get-boolean player? self))) 
                        (npc-stop (get-symbol active-npc self))
                        (update-npc-demeanor)
                        (wait-one-frame)
                    
                
                lambda 
                    (if (get-boolean sync-move? self)) 
                        (if (event-arg-boolean 0)) 
                            (issue-teleport (get-object-locator-remove-binding (get-symbol goal-2 self)))
                            (wait 0.40)
                            (dog-request-door-open (get-symbol active-npc self) (get-locator-position (get-object-locator-remove-binding (get-symbol goal-1 self))))
                         else 
                            (issue-teleport (get-object-locator-remove-binding (get-symbol goal-1 self)))
                            (wait 0.40)
                            (dog-request-door-open (get-symbol active-npc self) (get-locator-position (get-object-locator-remove-binding (get-symbol goal-2 self))))
                        
                     else (if (event-arg-boolean 0)) 
                        (if (and (get-boolean strafe? self) (not (get-boolean player? self)))) 
                            (npc-look-aim-at-locator (get-symbol active-npc self) (offset-locator (get-object-locator-remove-binding (get-symbol goal-2 self)) (alloc-vector 0.00 0.00 500.00 1.00 0)) -1.00 1)
                        
                        (issue-teleport (get-object-locator-remove-binding (get-symbol goal-2 self)))
                        (wait 0.40)
                        (issue-move 0 (get-object-locator-remove-binding (get-symbol goal-1 self)) 1)
                     else 
                        (if (and (get-boolean strafe? self) (not (get-boolean player? self)))) 
                            (npc-look-aim-at-locator (get-symbol active-npc self) (offset-locator (get-object-locator-remove-binding (get-symbol goal-1 self)) (alloc-vector 0.00 0.00 500.00 1.00 0)) -1.00 1)
                        
                        (issue-teleport (get-object-locator-remove-binding (get-symbol goal-1 self)))
                        (wait 0.40)
                        (issue-move 0 (get-object-locator-remove-binding (get-symbol goal-2 self)) 1)
                    
                
            }
        }
        block event selection-active {
            track main {
                lambda 
                    (define var_4 (kick-raycast (camera-locator 1) (offset-locator (camera-locator 1) (alloc-vector 0.00 0.00 35.00 1.00 0)) 0 4099))
                    (wait-one-frame)
                    (if (wait-raycast-hit-nothing? var_4)) 
                     else 
                        (set-bound-frame active-region-locator (wait-raycast var_4) self)
                        (debug-draw-sphere (get-locator-position (get-bound-frame active-region-locator self)) 0.25 3 0.00 0 1)
                        (define var_12 (select-activity (get-bound-frame active-region-locator self) (wait-raycast-get-object var_4)))
                        (if (not (== var_12 0))) 
                            (set! var_13 (set-symbol activity var_12 self))
                        
                    
                
            }
        }
        block event change-demeanor {
            track main {
                lambda 
                    (if (entity-exists? (get-symbol active-npc self))) 
                        (if (== (event-arg-int32 0) 1)) 
                            (++ demeanor-pointer self)
                         else 
                            (-- demeanor-pointer self)
                        
                        (if (> (get-int32 demeanor-pointer self) 6)) 
                            (set-int32 demeanor-pointer 0 self)
                         else (if (< (get-int32 demeanor-pointer self) 0)) 
                            (set-int32 demeanor-pointer 6 self)
                        
                        (update-npc-demeanor)
                     else 
                        (debug-draw-text-box-2D "Spawn npc first!" 60 340.00 60.00 1.00 1 0 1 1.00)
                    
                
            }
        }
        block event change-speed {
            track main {
                lambda 
                    (if (== (event-arg-int32 0) 1)) 
                        (++ speed-pointer self)
                     else 
                        (-- speed-pointer self)
                    
                
                lambda 
                    (if (> (get-int32 speed-pointer self) 3)) 
                        (set-int32 speed-pointer 0 self)
                     else (if (< (get-int32 speed-pointer self) 0)) 
                        (set-int32 speed-pointer 3 self)
                    
                
                lambda 
                    (if (== (get-int32 speed-pointer self) 0)) 
                        (set-int32 speed-enum 0 self)
                        (set-int32 player-speed-enum 0 self)
                     else (if (== (get-int32 speed-pointer self) 1)) 
                        (set-int32 speed-enum 1 self)
                        (set-int32 player-speed-enum 1 self)
                     else (if (== (get-int32 speed-pointer self) 2)) 
                        (set-int32 speed-enum 2 self)
                        (set-int32 player-speed-enum 2 self)
                     else (if (== (get-int32 speed-pointer self) 3)) 
                        (set-int32 speed-enum 3 self)
                        (set-int32 player-speed-enum 3 self)
                    
                
            }
        }
        block event change-mt {
            track main {
                lambda 
                    (if (== (event-arg-int32 0) 1)) 
                        (++ mt-pointer self)
                     else 
                        (-- mt-pointer self)
                    
                
                lambda 
                    (if (> (get-int32 mt-pointer self) 6)) 
                        (set-int32 mt-pointer 0 self)
                     else (if (< (get-int32 mt-pointer self) 0)) 
                        (set-int32 mt-pointer 6 self)
                    
                
                lambda 
                    (if (== (get-int32 mt-pointer self) 0)) 
                        (set-symbol mt-value 0 self)
                     else (if (== (get-int32 mt-pointer self) 1)) 
                        (set-symbol mt-value panic self)
                     else (if (== (get-int32 mt-pointer self) 2)) 
                        (set-symbol mt-value approach self)
                     else (if (== (get-int32 mt-pointer self) 3)) 
                        (set-symbol mt-value injured self)
                     else (if (== (get-int32 mt-pointer self) 4)) 
                        (set-symbol mt-value grass self)
                     else (if (== (get-int32 mt-pointer self) 5)) 
                        (set-symbol mt-value melee-outer self)
                     else (if (== (get-int32 mt-pointer self) 6)) 
                        (set-symbol mt-value door-kick self)
                    
                
            }
        }
        block event change-weapon-hold {
            track main {
                lambda 
                    (if (entity-exists? (get-symbol active-npc self))) 
                        (if (get-boolean weapon-up? self)) 
                            (npc-weapon-down (get-symbol active-npc self))
                            (set-boolean weapon-up? 0 self)
                         else 
                            (npc-weapon-up (get-symbol active-npc self))
                            (set-boolean weapon-up? 1 self)
                        
                     else 
                        (debug-draw-text-box-2D "Spawn npc first!" 60 340.00 60.00 1.00 1 0 1 1.00)
                    
                
            }
        }
        block event set-facing-point {
            track main {
                lambda 
                    (define var_4 (kick-raycast (camera-locator 1) (offset-locator (camera-locator 1) (alloc-vector 0.00 0.00 35.00 1.00 0)) 0 4099))
                    (wait-one-frame)
                    (if (wait-raycast-hit-nothing? var_4)) 
                     else 
                        (set-bound-frame facing-point (wait-raycast var_4) self)
                        (wait-raycast-get-object var_4)
                        (debug-draw-sphere (get-locator-position (get-bound-frame facing-point self)) 0.25 7 0.00 0 1)
                        (if (not (== active-npc 0))) 
                            (set-boolean active-facing-point 1 self)
                            (npc-look-aim-at-locator (get-symbol active-npc self) (get-bound-frame facing-point self) -1.00 1)
                            (npc-face-point (get-symbol active-npc self) (get-locator-position (get-bound-frame facing-point self)))
                            (debug-draw-string (get-object-position (get-symbol active-npc self)) "Facing set" 7 0.50 0 1.00 0 0)
                        
                    
                
            }
        }
        block event npc-group-menu-confirmed {
            track main {
                lambda 
                    (if (not (== (get-symbol active-npc-selection self) select-npc-to-spawn))) 
                        (spawn-test-npc (get-symbol active-npc-selection self))
                    
                
            }
        }
        block event mouse-click {
            track main {
                lambda 
                    (define var_16 (kick-raycast (camera-locator 1) (offset-locator (rotate-locator-angle (rotate-locator-angle (camera-locator 1) 1 (* (* (camera-get-fov-degrees) 0.50) (- 1.00 (/ (deref (cast f32* (debug-mouse-pos 1))) (* (deref (cast f32* (get-screen-size 1))) 0.50))))) 0 (/ (* (* (camera-get-fov-degrees) 0.50) (- (/ (deref (cast f32* (+ (debug-mouse-pos 1) 4))) (* (deref (cast f32* (+ (get-screen-size 1) 4))) 0.50)) 1.00)) (/ (deref (cast f32* (get-screen-size 1))) (deref (cast f32* (+ (get-screen-size 1) 4)))))) (alloc-vector 0.00 0.00 35.00 1.00 0)) 0 4099))
                    (wait-one-frame)
                    (if (wait-raycast-hit-nothing? var_16)) 
                     else 
                        (set-bound-frame facing-point (wait-raycast var_16) self)
                        (if (valid-bound-frame? (get-bound-frame facing-point self))) 
                            (wait-raycast-get-object var_16)
                            (debug-draw-sphere (get-locator-position (get-bound-frame facing-point self)) 0.10 7 2.00 0 1)
                            (if (not (== active-npc 0))) 
                                (set-boolean active-facing-point 1 self)
                                (npc-look-aim-at-locator (get-symbol active-npc self) (get-bound-frame facing-point self) -1.00 1)
                                (npc-face-point (get-symbol active-npc self) (get-locator-position (get-bound-frame facing-point self)))
                                (debug-draw-string (get-object-position (get-symbol active-npc self)) "Facing set" 7 0.50 0 1.00 0 0)
                                (debug-draw-line (get-object-position (get-symbol active-npc self)) (get-locator-position (offset-locator (rotate-locator-lookat (get-object-locator (get-symbol active-npc self)) (get-bound-frame facing-point self) 1.00 0) (alloc-vector 0.00 0.00 2.00 1.00 0))) 7 7 0.50 0 3.00 0 0 0)
                            
                        
                    
                
            }
        }
        block event reset-facing-point {
            track main {
                lambda 
                    (debug-draw-text-box-2D "Facing point disabled!" 60 340.00 60.00 1.00 1 0 1 1.00)
                
                lambda 
                    (set-bound-frame facing-point 0 self)
                
                lambda 
                    (set-boolean active-facing-point 0 self)
                
                lambda 
                    (npc-clear-aim-at (get-symbol active-npc self))
                
                lambda 
                    (npc-clear-look-at (get-symbol active-npc self))
                
            }
        }
        block event change-strafe {
            track main {
                lambda 
                    (if (entity-exists? (get-symbol active-npc self))) 
                        (if (get-boolean strafe? self)) 
                            (set-boolean strafe? 0 self)
                         else 
                            (set-boolean strafe? 1 self)
                        
                     else 
                        (debug-draw-text-box-2D "Spawn npc first!" 60 340.00 60.00 1.00 1 0 1 1.00)
                    
                
            }
        }
        block event help-toggle {
            track main {
                lambda 
                    (if (get-boolean draw-help? self)) 
                        (set-boolean draw-help? 0 self)
                     else 
                        (set-boolean draw-help? 1 self)
                    
                
            }
        }
        block event button-repeat-timer {
            track main {
                lambda 
                    (set-boolean button-delay-active 0 self)
                
            }
        }
    }
}
