                        (if (> (get-int32 demeanor-pointer self) 6)) 
                            (set-int32 demeanor-pointer 0 self)
                         else (if (< (get-int32 demeanor-pointer self) 0)) 
                            (set-int32 demeanor-pointer 6 self)
                        
                        (refresh-npc-demeanor (get-symbol active-demeanor-selection self))
