(define (draw-tap-help) 
    (define var_1)
    (if (get-boolean draw-help? self)) 
        (set-float console-y-start 500.00 self)
        (debug-draw-string-2d (alloc-point 1000.00 (+ (get-float console-y-start self) 60.00) -4.00 0) "Activity (arrow) selection: R2(hold) + X" 7 0.00 0.50 0 0 0 1.00)
        (debug-draw-string-2d (alloc-point 1000.00 (+ (get-float console-y-start self) 70.00) -4.00 0) "Move: X" 7 0.00 0.50 0 0 0 1.00)
        (debug-draw-string-2d (alloc-point 1000.00 (+ (get-float console-y-start self) 80.00) -4.00 0) "Move reverse: L2(hold) + X" 7 0.00 0.50 0 0 0 1.00)
        (debug-draw-string-2d (alloc-point 1000.00 (+ (get-float console-y-start self) 90.00) -4.00 0) "-------------------------------------" 7 0.00 0.50 0 0 0 1.00)
        (debug-draw-string-2d (alloc-point 1000.00 (+ (get-float console-y-start self) 100.00) -4.00 0) "Rotate Selected Arrow: R2(hold) + Dpad L/R" 7 0.00 0.50 0 0 0 1.00)
        (debug-draw-string-2d (alloc-point 1000.00 (+ (get-float console-y-start self) 110.00) -4.00 0) "Move Selected Arrow : L2(hold) + Dpad Up/Down/L/R" 7 0.00 0.50 0 0 0 1.00)
        (debug-draw-string-2d (alloc-point 1000.00 (+ (get-float console-y-start self) 120.00) -4.00 0) "Speed Change: L2(hold) + R2(hold) + Dpad Up/Down" 7 0.00 0.50 0 0 0 1.00)
        (debug-draw-string-2d (alloc-point 1000.00 (+ (get-float console-y-start self) 130.00) -4.00 0) "Demeanor Change: L2(hold) + R2(hold) + Dpad L/R" 7 0.00 0.50 0 0 0 1.00)
        (debug-draw-string-2d (alloc-point 1000.00 (+ (get-float console-y-start self) 140.00) -4.00 0) "Weapon Up/Down: Triangle" 7 0.00 0.50 0 0 0 1.00)
        (debug-draw-string-2d (alloc-point 1000.00 (+ (get-float console-y-start self) 150.00) -4.00 0) "Strafe ON/OFF: Circle" 7 0.00 0.50 0 0 0 1.00)
        (debug-draw-string-2d (alloc-point 1000.00 (+ (get-float console-y-start self) 160.00) -4.00 0) "Motion Type: R2(hold) + L1/R1" 7 0.00 0.50 0 0 0 1.00)
        (debug-draw-string-2d (alloc-point 1000.00 (+ (get-float console-y-start self) 170.00) -4.00 0) "Set facing point: R3 or mouse click" 7 0.00 0.50 0 0 0 1.00)
        (debug-draw-string-2d (alloc-point 1000.00 (+ (get-float console-y-start self) 180.00) -4.00 0) "Reset facing point: shake controller" 7 0.00 0.50 0 0 0 1.00)
        (set! var_1 (debug-draw-string-2d (alloc-point 1000.00 (+ (get-float console-y-start self) 190.00) -4.00 0) "Hide Help: Square" 7 0.00 0.50 0 0 0 1.00))
