                        (issue-teleport (find-closest-point-on-nav-mesh (get-object-locator-remove-binding (get-symbol goal-2 self)) 2.00 5.00 0.00 0 0))
                        (wait 0.40)
                        (issue-move 0 (find-closest-point-on-nav-mesh (get-object-locator-remove-binding (get-symbol goal-1 self)) 2.00 5.00 0.00 0 0) 1)
                     else 
                        (if (and (get-boolean strafe? self) (not (get-boolean player? self)))) 
