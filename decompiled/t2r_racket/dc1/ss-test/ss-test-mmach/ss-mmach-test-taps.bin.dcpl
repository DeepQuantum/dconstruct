        (set! var_1 (debug-draw-string-2d (alloc-point 1000.00 (+ (get-float console-y-start self) 60.00) -4.00 0) "Display Help: Square" 7 0.00 0.50 0 0 0 1.00))
    
    var_1
)

(define (issue-teleport arg_0) 
    (if (get-boolean player? self)) 
        (send-event teleport-player player (new-boxed-value 18 arg_0))
    
    (if (not (get-boolean player? self))) 
        (npc-clear-request-movement (get-symbol active-npc self))
        (npc-stop (get-symbol active-npc self))
        (npc-teleport-to (get-symbol active-npc self) arg_0)
        (npc-holster-weapon (get-symbol active-npc self) 4 0 -1.00 0)
        (set-object-locator (get-symbol active-npc self) arg_0)
    
    (define var_9)
    (if (get-boolean sync-move? self)) 
        (npc-clear-request-movement (get-symbol active-slave-npc self))
        (npc-stop (get-symbol active-slave-npc self))
        (npc-teleport-to (get-symbol active-slave-npc self) (offset-locator arg_0 (alloc-vector -1.00 0.00 0.30 1.00 0)))
        (set! var_9 (set-object-locator (get-symbol active-slave-npc self) arg_0))
     else 
        (set! var_9 0)
    
    var_9
)

(define (issue-move-speed arg_0 arg_1 arg_2 arg_3) 
    (if (get-boolean active-facing-point self)) 
        (npc-face-point (get-symbol active-npc self) (get-locator-position (get-bound-frame facing-point self)))
    
    (define var_5)
    (if (get-boolean player? self)) 
        (if arg_0) 
            (set! var_5 0)
         else 
            (set! var_5 0)
        
     else (if arg_0) 
        (define var_8)
        (if arg_2) 
            (set! var_8 1)
         else 
            (set! var_8 2)
        
        (set! var_5 (wait-npc-move-to (get-symbol active-npc self) arg_1 (get-movement-speed-enum arg_3 0) var_8 (get-symbol mt-value self) 0 (get-boolean strafe? self) 0))
     else 
        (define var_14)
        (if arg_2) 
            (set! var_14 1)
         else 
            (set! var_14 2)
        
        (set! var_5 (npc-move-to (get-symbol active-npc self) arg_1 (get-movement-speed-enum arg_3 0) var_14 (get-symbol mt-value self) 0 (get-boolean strafe? self) 0))
    
    var_5
)

(define (get-movement-speed-enum arg_0 arg_1) 
