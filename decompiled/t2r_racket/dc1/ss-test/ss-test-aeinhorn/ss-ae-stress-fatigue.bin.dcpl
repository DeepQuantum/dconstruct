                    (if (joypad-command-active? melee-attack 6)) 
                        (set! var_1 1)
                     else 
                        (set! var_1 0)
                    
                    (if var_1) 
                        (+=f fatigue 10.00 self)
                    
                
                lambda 
                    (clamp-var fatigue 0.00 500.00 self)
                
                lambda 
                    (debug-draw-string-2d (alloc-point 10.00 10.00 0.00 0) (dc:format "fatigue: %f stress: %f" (get-float fatigue self) (get-float stress self)) 1 0.00 1.00 0 0 0 1.00)
                
            }
        }
        block start {
            track reset {
                lambda 
                    (let loop () (when (not (not (tension-mode-is? 3))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (go post-combat 1)
                
            }
            track evade {
                lambda 
                    (let loop () (when 1 
                        (let loop () (when (and (or (or (joypad-command-active? evade-start 6) 1) 0) (not 0)) 
                            (wait-one-frame)
                         (loop)))
                        (wait 0.20)
                        (define var_2)
                        (if (joypad-command-active? sprint-hold-long 6)) 
                            (set! var_2 1)
                         else 
                            (set! var_2 0)
                        
                        (if (not var_2)) 
                            (+=f fatigue 5.00 self)
                        
                        (wait-one-frame)
                     (loop)))
                
            }
        }
        block event Attack {
            track main {
                lambda 
                    (+=f stress (cast f32 (deref (cast i32* (+ (event::get-attack-info (get-event)) 24)))) self)
                
                lambda 
                    (clamp-var stress 0.00 500.00 self)
                
            }
        }
    }
    state post-combat {
        block update {
            track main {
                lambda 
                    (if (not (deref (cast u8* (+ *player-prototypes* 43))))) 
                        (go inactive 1)
                    
                
                lambda 
