                lambda 
                    (define var_1)
                    (if (joypad-command-active? sprint-hold-long 6)) 
                        (set! var_1 1)
                     else 
                        (set! var_1 0)
                    
                    (if var_1) 
                        (+=f fatigue (get-delta-time) self)
                    
                
                lambda 
