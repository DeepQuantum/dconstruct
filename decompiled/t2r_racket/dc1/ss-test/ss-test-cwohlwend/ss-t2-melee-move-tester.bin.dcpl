                         else (if (== (deref (cast i32* (+ (deref (+ (get-current-melee-attack player) 296)) 200))) 3)) 
                            (set! var_6 (get-spawner-locator pos-melee-tester-collab-buddy-on-right-1 1))
                         else 
                            (set! var_6 (get-spawner-locator pos-atk2-tester-spawn-1 1))
                        
                        (set-bound-frame attacker2-init-locator var_6 self)
                    
                
                lambda 
                    (wait 1.00)
                
                lambda 
                    (go wait-melee-done 1)
                
            }
            track awareness {
                lambda 
                    (wait-for characters-reset)
                
                lambda 
                    (let loop () (when 1 
                        (if (is-npc? (get-symbol attacker self))) 
                            (if (!= (get-symbol defender self) none)) 
                                (npc-make-aware-of (get-symbol attacker self) (get-symbol defender self) 2 0)
                            
                            (if (!= (get-symbol attacker2 self) none)) 
                                (npc-make-aware-of (get-symbol attacker self) (get-symbol attacker2 self) 2 0)
                            
                        
                        (if (is-npc? (get-symbol defender self))) 
                            (if (!= (get-symbol attacker self) none)) 
                                (npc-make-aware-of (get-symbol defender self) (get-symbol attacker self) 2 0)
                            
                            (if (!= (get-symbol attacker2 self) none)) 
                                (npc-make-aware-of (get-symbol defender self) (get-symbol attacker2 self) 2 0)
                            
                        
                        (if (and (!= (get-symbol attacker2 self) none) (is-npc? (get-symbol attacker2 self)))) 
                            (if (!= (get-symbol attacker self) none)) 
                                (npc-make-aware-of (get-symbol attacker2 self) (get-symbol attacker self) 2 0)
                            
                            (if (!= (get-symbol defender self) none)) 
                                (npc-make-aware-of (get-symbol attacker2 self) (get-symbol defender self) 2 0)
                            
                        
                        (wait-one-frame)
                     (loop)))
                
            }
        }
    }
    state wait-melee-done {
        block start {
            track main {
                lambda 
                    (let loop () (when (and (character-in-melee-attack-as-attacker? (get-symbol attacker self)) (character-in-melee-attack-as-defender? (get-symbol defender self))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (if (and (is-npc? (get-symbol attacker self)) (== (get-symbol group-symbol self) finishers))) 
                        (let loop () (when (< (- (current-time 1) (current-time 1)) 1.00) 
                            (fade-to-black 0.00 (frames-to-sec 1) 0.00 1)
                            (wait-one-frame)
                         (loop)))
                        (wait 1.00)
                    
                
                lambda 
                    (wait 1.00)
                
                lambda 
                    (go melee-state 1)
                
            }
        }
    }
    state instant-change {
        block start {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "1") 19)
                    
                
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (if (!= (get-symbol attacker self) none)) 
                        (stop-animating (get-symbol attacker self) 2 0.00 0 0)
                    
                
                lambda 
                    (if (!= (get-symbol attacker2 self) none)) 
                        (stop-animating (get-symbol attacker2 self) 2 0.00 0 0)
                    
                
                lambda 
                    (if (!= (get-symbol defender self) none)) 
                        (stop-animating (get-symbol defender self) 2 0.00 0 0)
                    
                
                lambda 
                    (move-tester-remove-weapons (get-symbol attacker self))
                
                lambda 
                    (reset-character (get-symbol attacker self))
                
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "2") 19)
                    
                
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (reset-character (get-symbol attacker2 self))
                
                lambda 
                    (move-tester-remove-weapons (get-symbol defender self))
                
                lambda 
                    (reset-character (get-symbol defender self))
                
                lambda 
                    (go melee-state 1)
                
            }
        }
    }
}
