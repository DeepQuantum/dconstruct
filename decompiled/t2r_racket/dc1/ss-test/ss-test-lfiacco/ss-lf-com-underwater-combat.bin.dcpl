statescript {
    options {
        player
        lf-com-underwater-loops
    }
    state task-check {
        block start {
            track main {
                lambda 
                    (if (task-active? lfiacco combat-underwater-loops)) 
                        (go setup-human 1)
                     else (if (task-active? infected swimming-runners)) 
                        (go setup-infected 1)
                    
                
            }
        }
    }
    state setup-human {
        block start {
            track main {
                lambda 
                    (wait-spawn-npc-group-async lf-com-loops-npcs 0 0)
                
                lambda 
                    (go first-stealth 1)
                
            }
        }
    }
    state setup-infected {
        block start {
            track main {
                lambda 
                    (wait-spawn-npc-group-async swim-infected-npcs 0 0)
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (if (== (npc-group-alive-count swim-infected-npcs) 0)) 
                        (go done 1)
                    
                
            }
        }
    }
    state first-stealth {
        block start {
            track enemy {
                lambda 
                    (let loop () (when (not (! (npc-alive? npc-1027))) 
                        (wait 1.00)
                     (loop)))
                
                lambda 
                    (go combat 1)
                
            }
            track description {
                lambda 
                    (let loop () (when (not (player-swimming-underwater?)) 
                        (debug-draw-text-box-2D "DEFEAT ENEMIES IN EACH ROOM" 60 340.00 60.00 1.00 1 0 1 0.00)
                        (wait-one-frame)
                     (loop)))
                
            }
        }
        block event past-enemy {
            track main {
                lambda 
                    (if (npc-alive? npc-1027)) 
                        (npc-kill npc-1027)
                    
                
            }
        }
    }
    state combat {
        block start {
            track main {
                lambda 
                    (let loop () (when (not (> 1 (npc-group-alive-count main-combat))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (go done 1)
                
            }
        }
    }
    state done {
        block update {
            track main {
                lambda 
                    (debug-draw-text-box-2D "COMPLETED" 60 340.00 60.00 1.00 1 0 1 0.00)
                
            }
        }
    }
}
