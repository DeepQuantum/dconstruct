statescript {
    options {
        player
    }
    state initial {
        block start {
            track main {
                lambda 
                    (go out-of-boat 1)
                
            }
        }
    }
    state out-of-boat {
        block update {
            track main {
                lambda 
                    (if (player-in-state? BoatDriving)) 
                        (go in-boat 1)
                    
                
            }
        }
    }
    state in-boat {
        block update {
            track main {
                lambda 
                    (if (< (get-object-speed boat) 3.00)) 
                        (script-caption-no-stack player "vroom" 0.10 0)
                    
                
                lambda 
                    (if (>= (get-object-speed boat) 3.00)) 
                        (script-caption-no-stack player "VROOM" 0.10 0)
                        (audio-gameplay-event weapon-fire (get-object-position boat) boat)
                    
                
                lambda 
                    (if (! (player-in-state? BoatDriving))) 
                        (go out-of-boat 1)
                    
                
            }
        }
    }
}
