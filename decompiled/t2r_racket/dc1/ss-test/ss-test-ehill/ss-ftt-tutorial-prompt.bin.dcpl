statescript {
    options {
        player
    }
    state wait-event {
        block start {
            track main {
                lambda 
                    (let loop () (when (not (player-in-region? self 2)) 
                        (wait 0.10)
                     (loop)))
                
                lambda 
                    (go display-prompt 1)
                
            }
        }
    }
    state display-prompt {
        block start {
            track main {
                lambda 
                    (if (and (tag-exists? cypher-name self) (tag-exists? command self))) 
                        (hud-clear-tutorials 0)
                        (print-float (tag-float display-time self) self)
                        (define var_5)
                        (if (tag-exists? display-time self)) 
                            (set! var_5 (tag-float display-time self))
                         else 
                            (set! var_5 10.00)
                        
                        (hud-play-tutorial (tag-symbol cypher-name self) var_5 2 (tag-symbol command self) 0.50 0 0 0)
                     else (if (and (tag-exists? cypher-name self) (! (tag-exists? command self)))) 
                        (hud-clear-tutorials 0)
                        (define var_13)
                        (if (tag-exists? display-time self)) 
                            (set! var_13 (tag-float display-time self))
                         else 
                            (set! var_13 5.00)
                        
                        (hud-play-tutorial (tag-symbol cypher-name self) var_13 2 none 0.50 0 0 0)
                    
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
