statescript {
    options {
        player
    }
    state player-on-horse {
        block start {
            track main {
                lambda 
                    (set-player-ride-horse player-horse 0 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (player-on-horse? horse 1 1 1)) 
                        (camera-set-overlay *camera-remap-efg-joel-opening*)
                        (set-player-horse-move-settings/f *horse-move-settings-slow-walk*)
                        (set-follow-camera-constraints 130.00 60.00 15.00 (get-object-locator player))
                    
                
            }
        }
        block event horse-done {
            track main {
                lambda 
                    (go player-walking 1)
                
            }
        }
    }
    state player-walking {
        block update {
            track main {
                lambda 
                    (player-set-narrative-mode/f 1 0 *default-narrative-mode-settings*)
                
            }
        }
    }
}
