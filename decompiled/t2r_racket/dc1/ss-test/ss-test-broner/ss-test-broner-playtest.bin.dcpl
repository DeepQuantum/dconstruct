                        (send-event update-position (get-symbol rb-playtest-base-obj-id self))
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (get-boolean is-active? self)) 
                        (if (joypad-command-active? debug-script-hold-r2 6)) 
                            (if (joypad-command-active? debug-script-press-down 6)) 
                                (set-float input-mult (rb-playtest-mult-dec (get-float input-mult self)) self)
                            
                            (if (joypad-command-active? debug-script-press-up 6)) 
                                (set-float input-mult (rb-playtest-mult-inc (get-float input-mult self)) self)
                            
                        
                        (if (! (joypad-command-active? debug-script-hold-r2 6))) 
                            (if (joypad-command-active? debug-script-press-up 6)) 
                                (set-boolean bump-change 1 self)
                                (set-float bump-height (+ (get-float bump-height self) (* 0.10 (get-float input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-down 6)) 
                                (set-boolean bump-change 1 self)
                                (set-float bump-height (- (get-float bump-height self) (* 0.10 (get-float input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-left 6)) 
                                (set-boolean bump-change 1 self)
                                (set-float bump-width (- (get-float bump-width self) (* 0.50 (get-float input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-right 6)) 
                                (set-boolean bump-change 1 self)
                                (set-float bump-width (+ (get-float bump-width self) (* 0.50 (get-float input-mult self))) self)
                            
                        
                        (send-event update-position (get-symbol rb-playtest-base-obj-id self))
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 0.00)) 0.00 0) (dc:format "Debug mesh params") 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 2.00)) 0.00 0) (dc:format "[R2 + U/D] Multiplier:      %.3f" (get-float input-mult self)) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 3.00)) 0.00 0) (dc:format "[     L/R] Bump Width L/R:  %.3f" (get-float bump-width self)) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 4.00)) 0.00 0) (dc:format "[     U/D] Bump Height F/B:  %.3f" (get-float bump-height self)) 1 0.00 1.00 1 0 0 1.00)
                    
                
                lambda 
                    (if (joypad-command-active? debug-script-hold-triangle 6)) 
                        (set-float rb-triangle-hold-timer (+ (get-delta-time) (get-float rb-triangle-hold-timer self)) self)
                        (if (> (get-float rb-triangle-hold-timer self) (tag-float rb-triangle-hold-time self))) 
                            (go control 1)
                        
                    
                
                lambda 
                    (if (not (joypad-command-active? debug-script-hold-triangle 6))) 
                        (set-float rb-triangle-hold-timer 0.00 self)
                    
                
                lambda 
                    (if (get-boolean is-active? self)) 
                        (if (joypad-command-active? debug-script-hold-r2 6)) 
                            (if (joypad-command-active? debug-script-press-down 6)) 
                                (set-float input-mult (rb-playtest-mult-dec (get-float input-mult self)) self)
                            
                            (if (joypad-command-active? debug-script-press-up 6)) 
                                (set-float input-mult (rb-playtest-mult-inc (get-float input-mult self)) self)
                            
                        
                        (if (and (! (joypad-command-active? debug-script-hold-circle 6)) (! (joypad-command-active? debug-script-hold-r2 6)))) 
                            (if (joypad-command-active? debug-script-press-r1 6)) 
                                (set-float current-height (+ (get-float current-height self) (* 0.10 (get-float input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-l1 6)) 
                                (set-float current-height (- (get-float current-height self) (* 0.10 (get-float input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-right 6)) 
                                (set-float current-width (+ (get-float current-width self) (* 0.10 (get-float input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-left 6)) 
                                (set-float current-width (- (get-float current-width self) (* 0.10 (get-float input-mult self))) self)
                            
                        
                        (if (and (joypad-command-active? debug-script-hold-circle 6) (! (joypad-command-active? debug-script-hold-r2 6)))) 
                            (if (joypad-command-active? debug-script-press-right 6)) 
                                (set-float current-rot (+ (get-float current-rot self) (* 5.00 (get-float input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-left 6)) 
                                (set-float current-rot (- (get-float current-rot self) (* 5.00 (get-float input-mult self))) self)
                            
                        
                        (send-event update-position (get-symbol rb-playtest-base-obj-id self))
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 0.00)) 0.00 0) (dc:format "Prone Corner") 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 2.00)) 0.00 0) (dc:format "[R2 + U/D  ] Multiplier:      %.3f" (get-float input-mult self)) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 3.00)) 0.00 0) (dc:format "[     L1/R1] Wall Height      %.3f" (get-float current-height self)) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 4.00)) 0.00 0) (dc:format "[     L/R  ] Wall Width       %.3f" (get-float current-width self)) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 5.00)) 0.00 0) (dc:format "[ O + L/R  ] Corner Rot       %.3f" (get-float current-rot self)) 1 0.00 1.00 1 0 0 1.00)
                    
                
                lambda 
                    (if (get-boolean is-active? self)) 
                        (if (joypad-command-active? debug-script-hold-r2 6)) 
                            (if (joypad-command-active? debug-script-press-down 6)) 
                                (set-float obj-input-mult (rb-playtest-mult-dec (get-float obj-input-mult self)) self)
                            
                            (if (joypad-command-active? debug-script-press-up 6)) 
                                (set-float obj-input-mult (rb-playtest-mult-inc (get-float obj-input-mult self)) self)
                            
                        
                        (if (and (joypad-command-active? debug-script-hold-circle 6) (! (joypad-command-active? debug-script-hold-r2 6)))) 
                            (if (joypad-command-active? debug-script-press-up 6)) 
                                (set-float obj-rot-x (- (get-float obj-rot-x self) (* (tag-float rb-default-rot self) (get-float obj-input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-down 6)) 
                                (set-float obj-rot-x (+ (get-float obj-rot-x self) (* (tag-float rb-default-rot self) (get-float obj-input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-left 6)) 
                                (set-float obj-rot-z (+ (get-float obj-rot-z self) (* (tag-float rb-default-rot self) (get-float obj-input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-right 6)) 
                                (set-float obj-rot-z (- (get-float obj-rot-z self) (* (tag-float rb-default-rot self) (get-float obj-input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-l1 6)) 
                                (set-float obj-rot-y (+ (get-float obj-rot-y self) (* (tag-float rb-default-rot self) (get-float obj-input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-r1 6)) 
                                (set-float obj-rot-y (- (get-float obj-rot-y self) (* (tag-float rb-default-rot self) (get-float obj-input-mult self))) self)
                            
                        
                        (if (and (! (joypad-command-active? debug-script-hold-circle 6)) (! (joypad-command-active? debug-script-hold-r2 6)))) 
                            (if (joypad-command-active? debug-script-press-down 6)) 
                                (set-float obj-move-z (+ (get-float obj-move-z self) (* (tag-float rb-default-move self) (get-float obj-input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-up 6)) 
                                (set-float obj-move-z (- (get-float obj-move-z self) (* (tag-float rb-default-move self) (get-float obj-input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-right 6)) 
                                (set-float obj-move-x (+ (get-float obj-move-x self) (* (tag-float rb-default-move self) (get-float obj-input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-left 6)) 
                                (set-float obj-move-x (- (get-float obj-move-x self) (* (tag-float rb-default-move self) (get-float obj-input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-r1 6)) 
                                (set-float obj-move-y (+ (get-float obj-move-y self) (* (tag-float rb-default-move self) (get-float obj-input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-l1 6)) 
                                (set-float obj-move-y (- (get-float obj-move-y self) (* (tag-float rb-default-move self) (get-float obj-input-mult self))) self)
                            
                        
                        (send-event update-position (get-symbol rb-playtest-base-obj-id self))
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 0.00)) 0.00 0) (dc:format "Script: %s" (string-debug (get-self-id))) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 2.00)) 0.00 0) (dc:format "[R2 + U/D  ] Multiplier:             %.3f" (get-float obj-input-mult self)) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 3.00)) 0.00 0) (dc:format "[     L/R  ] Object Move Left/Right: %.3f" (get-float obj-move-x self)) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 4.00)) 0.00 0) (dc:format "[     U/D  ] Object Move Fwd/Back:   %.3f" (get-float obj-move-z self)) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 5.00)) 0.00 0) (dc:format "[     L1/R1] Object Move Up/Down:    %.3f" (get-float obj-move-y self)) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 6.00)) 0.00 0) (dc:format "[ O + L/R  ] Object Rot SideL/R:     %.3f" (get-float obj-rot-z self)) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 7.00)) 0.00 0) (dc:format "[ O + U/D  ] Object Rot Fwd/Back:    %.3f" (get-float obj-rot-x self)) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 8.00)) 0.00 0) (dc:format "[ O + L1/R1] Object Rot Twist:       %.3f" (get-float obj-rot-y self)) 1 0.00 1.00 1 0 0 1.00)
                    
                
            }
        }
    }
    state control {
        block  {
        }
        block update {
            track main {
                lambda 
                    (if (and (not (player-in-region? (tag-symbol playtest-region self) 2)) (not (joypad-command-active? debug-script-hold-triangle 6)))) 
                        (go inactive 1)
                    
                
                lambda 
                    (joypad-disable-all-commands-except)
                
                lambda 
                    (if (joypad-command-active? debug-script-hold-r2 6)) 
                        (if (joypad-command-active? debug-script-press-left 6)) 
                            (set-int32 rb-playtest-active-script (- (get-int32 rb-playtest-active-script self) 1) self)
                            (if (< (get-int32 rb-playtest-active-script self) 0)) 
                                (set-int32 rb-playtest-active-script (+ (get-int32 rb-playtest-active-script self) (get-int32 rb-playtest-max-scripts self)) self)
                            
                        
                        (if (joypad-command-active? debug-script-press-right 6)) 
                            (set-int32 rb-playtest-active-script (+ (get-int32 rb-playtest-active-script self) 1) self)
                            (if (>= (get-int32 rb-playtest-active-script self) (get-int32 rb-playtest-max-scripts self))) 
                                (set-int32 rb-playtest-active-script (- (get-int32 rb-playtest-active-script self) (get-int32 rb-playtest-max-scripts self)) self)
                            
                        
                    
                
                lambda 
                    (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 1.00)) 0.00 0) (dc:format "[R2 + L/R] Script: (%d/%d)" (+ 1 (get-int32 rb-playtest-active-script self)) (get-int32 rb-playtest-max-scripts self)) 1 0.00 1.00 1 0 0 1.00)
                
                lambda 
                    (send-event set-active (tag-symbol rb-playtest-script-1 self) (new-boxed-value 1 (== (get-int32 rb-playtest-active-script self) 1)))
                
                lambda 
                    (send-event set-active (tag-symbol rb-playtest-script-2 self) (new-boxed-value 1 (== (get-int32 rb-playtest-active-script self) 2)))
                
                lambda 
                    (send-event set-active (tag-symbol rb-playtest-script-3 self) (new-boxed-value 1 (== (get-int32 rb-playtest-active-script self) 3)))
                
                lambda 
                    (send-event set-active (tag-symbol rb-playtest-script-4 self) (new-boxed-value 1 (== (get-int32 rb-playtest-active-script self) 4)))
                
                lambda 
                    (send-event set-active (tag-symbol rb-playtest-script-5 self) (new-boxed-value 1 (== (get-int32 rb-playtest-active-script self) 5)))
                
                lambda 
                    (send-event set-active (tag-symbol rb-playtest-script-6 self) (new-boxed-value 1 (== (get-int32 rb-playtest-active-script self) 6)))
                
                lambda 
                    (if (== (get-int32 rb-playtest-active-script self) 0)) 
                        (if (joypad-command-active? debug-script-hold-r2 6)) 
                            (if (joypad-command-active? debug-script-press-down 6)) 
                                (set-float input-mult (rb-playtest-mult-dec (get-float input-mult self)) self)
                            
                            (if (joypad-command-active? debug-script-press-up 6)) 
                                (set-float input-mult (rb-playtest-mult-inc (get-float input-mult self)) self)
                            
                        
                        (if (and (joypad-command-active? debug-script-hold-circle 6) (! (joypad-command-active? debug-script-hold-r2 6)))) 
                            (if (joypad-command-active? debug-script-press-up 6)) 
                                (set-float ground-rot-x (- (get-float ground-rot-x self) (* 5.00 (get-float input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-down 6)) 
                                (set-float ground-rot-x (+ (get-float ground-rot-x self) (* 5.00 (get-float input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-left 6)) 
                                (set-float ground-rot-z (+ (get-float ground-rot-z self) (* 5.00 (get-float input-mult self))) self)
                            
                            (if (joypad-command-active? debug-script-press-right 6)) 
                                (set-float ground-rot-z (- (get-float ground-rot-z self) (* 5.00 (get-float input-mult self))) self)
                            
                        
                        (send-event update-position (get-self-id))
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 0.00)) 0.00 0) (dc:format "%s (%s)" (get-string rb-playtest-script-name self) (string-debug (get-self-id))) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 2.00)) 0.00 0) (dc:format "[R2 + U/D] Multiplier:      %.3f" (get-float input-mult self)) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 3.00)) 0.00 0) (dc:format "[ O + L/R] Ground Rot L/R:  %.3f" (get-float ground-rot-z self)) 1 0.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 440.00 (+ 250.00 (* 20.00 4.00)) 0.00 0) (dc:format "[ O + U/D] Ground Rot F/B:  %.3f" (get-float ground-rot-x self)) 1 0.00 1.00 1 0 0 1.00)
                    
                
            }
        }
    }
