statescript {
    options {
        player
    }
    state wait-for-landing {
        block start {
            track main {
                lambda 
                    (attach-light-to-object self root *underwater-flare-light* (dc:format "%s-light" (get-self-name)))
                
                lambda 
                    (wait-frames 3)
                
                lambda 
                    (let loop () (when (not (< (get-object-speed self) 0.10)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (go make-noise 1)
                
                lambda 
                    (npc-make-aware-of npc-arrow-lure-1 player 2 0)
                
                lambda 
                    (npc-remove-traversal-skill npc-arrow-lure-1 12)
                
                lambda 
                    (npc-override-post-selector-set-id npc-arrow-lure-1 *no-perch-selector-set*)
                
                lambda 
                    (go wait-for-arrow 1)
                
            }
        }
    }
    state make-noise {
        block start {
            track main {
                lambda 
                    (script-caption self "BANG" 1.00 0 0)
                
                lambda 
                    (play-sound-at-position sfx-brick-impact (get-object-position self) 0 0)
                
                lambda 
                    (audio-gameplay-event distraction (get-object-position self) self)
                
                lambda 
                    (wait 3.00)
                
                lambda 
                    (go cleanup 1)
                
                lambda 
                    (if (and (npc-target-lost? npc-arrow-lure-1 player) (npc-target-missing? npc-arrow-lure-1 player))) 
                        (npc-make-aware-of npc-arrow-lure-1 player 2 0)
                    
                
            }
        }
        block event arrow-fired {
            track main {
                lambda 
                    (if (!= (event-arg-symbol 0) player)) 
                        (spawn-script-multiple "ss-proto-arrow-lure" (event-arg-symbol 1) 0)
                    
                
            }
        }
    }
    state cleanup {
        block start {
            track main {
                lambda 
                    (define var_1 (symbol-concat-string (get-self-id) "-light"))
                    (send-event turn-off var_1)
                    (kill-entity-if-spawned var_1)
                
            }
        }
    }
}
