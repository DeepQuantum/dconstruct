statescript {
    options {
        player
        sp-all
    }
    declarations {
        symbol default-saved-task = cp-ftt-inventory-1
        symbol default-saved-subnode = cc-ftt-inventory-1
        symbol task-store = focus-test-tutorial
        symbol subnode-store = ftt-inventory
        symbol ellie-loadout-replace-1 = *ellie-seattle-arrival-weapons*
        symbol abby-loadout-replace-1 = *abby-fob-stadium-gun-range*
        symbol ellie-loadout-replace-2 = *ellie-watchtower-capitol-hill-weapons*
        symbol abby-loadout-replace-2 = *abby-forward-base-weapons*
        symbol ellie-loadout-replace-3 = *ellie-watchtower-weapons*
        symbol abby-loadout-replace-3 = *abby-saving-kids-escape-weapons*
        symbol ellie-loadout-replace-4 = *ellie-find-nora-weapons*
        symbol abby-loadout-replace-4 = *abby-saving-kids-coastal-explore-weapons*
        symbol ellie-loadout-replace-5 = *ellie-find-aquarium-weapons*
        symbol abby-loadout-replace-5 = *abby-medicine-weapons-start*
    }
    state player-select {
        block start {
            track main {
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (if (e3?)) 
                        (go disabled 1)
                     else (if (is-player-abby? player)) 
                        (go abby-upgrades 1)
                     else 
                        (go ellie-upgrades 1)
                    
                
            }
        }
    }
    state ellie-upgrades {
        block start {
            track main {
                lambda 
                    (let loop () (when (not (player-upgrade-system-initialized?)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (initialize-task-preset-upgrades)
                
                lambda 
                    (check-stun-vs-smoke-bomb)
                
            }
        }
        block event player-upgrade-enabled {
            track main {
                lambda 
                    (upgrade-stun-to-smoke-bomb)
                
            }
        }
        block event player-upgrade-removed {
            track main {
                lambda 
                    (downgrade-smoke-to-stun-bomb)
                
            }
        }
    }
    state abby-upgrades {
        block start {
            track main {
                lambda 
                    (let loop () (when (not (player-upgrade-system-initialized?)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (initialize-task-preset-upgrades)
                
            }
        }
    }
    state  {
    }
    state --all-- {
        block event player-upgrade-enabled {
            track main {
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (hud2-mark-health-ammo-dirty 0)
                
            }
        }
        block event designer-menu-changed {
            track main {
                lambda 
                    (if (and (!= *player-prototypes* nullptr) (deref (cast u8* (+ *player-prototypes* 51))))) 
                        (if (and (== (get-saved-task) (task-get-current-node-id)) (== (get-saved-subnode) (task-get-current-subnode-id)))) 
                            (replace-with-alternate-loadout)
                         else (if (== (get-saved-task) (task-get-current-node-id))) 
                            (if (not (== (get-saved-subnode) (task-get-current-subnode-id)))) 
                                (check-and-restore-loadout)
                                (save-currrent-task-details)
                                (replace-current-task-loadout)
                            
                        
                        (task-play-debug! (task-get-current-node-id) (task-get-current-subnode-id) (task-get-active-continue))
                        (set! (deref (cast u8* (+ *player-prototypes* 51))) 0)
                    
                
            }
        }
    }
}
