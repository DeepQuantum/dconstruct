statescript {
    options {
        hun-camp-street-col
    }
    declarations {
        f32 spline-distance = 0.00
        bound-frame aim-goal = nullptr
    }
    state follow-spline {
        block update {
            track main {
                lambda 
                    (if (tension-mode-is? 3)) 
                        (go track-player 1)
                    
                
                lambda 
                    (if (>= (get-float spline-distance self) (get-spline-length (tag-symbol track-spline self)))) 
                        (set-float spline-distance 0.00 self)
                    
                
                lambda 
                    (set-bound-frame aim-goal (spline-locator-at-distance (tag-symbol track-spline self) (get-float spline-distance self)) self)
                
                lambda 
                    (debug-draw-locator (get-bound-frame aim-goal self) 0.30 0.00 0 2.00 0)
                
                lambda 
                    (set-object-locator self (rotate-locator-lookat (get-spawner-locator self 1) (get-bound-frame aim-goal self) 1.00 1))
                
                lambda 
                    (+=f spline-distance (get-delta-time) self)
                
            }
        }
    }
    state track-player {
        block update {
            track main {
                lambda 
                    (if (not (tension-mode-is? 3))) 
                        (go follow-spline 1)
                    
                
                lambda 
                    (set-object-locator self (rotate-locator-lookat (get-spawner-locator self 1) (get-object-locator player) 1.00 1))
                
            }
        }
    }
}
