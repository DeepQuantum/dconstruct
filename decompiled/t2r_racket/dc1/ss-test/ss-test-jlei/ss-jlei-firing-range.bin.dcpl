                                (set! (deref (cast i32* (deref (+ (deref var_55) (* 2 8))))) 10)
                                (set! (deref (cast u64* (+ (deref (+ (deref var_55) (* 2 8))) 8))) 0)
                                (set! (deref (cast u64* (+ (deref (+ (deref var_55) (* 2 8))) 8))) (alloc-bound-frame (get-locator-position (get-bound-frame temp-loc self)) (get-object-rotation self) 0 0 0))
                                (set! var_15 (wait-animate_ self npc-m-nw-idle-wall-bump-hr-fw-chest var_55))
                             else (if (get-boolean enable-react-into-run self)) 
                                (set! var_15 (hitReactIntoRunMaster self npc-m-nw-idle^run-bw-hr-fw-chest-rt "" 0.00))
                            
                        
                    
                
            }
        }
    }
    state run {
        block start {
            track main {
                lambda 
                    (if (npc-alive? self)) 
                        (wait-npc-move-to self (get-spawner-locator pos-2 1) 1 0 0 0 0 0)
                        (wait 0.20)
                    
                    (if (npc-alive? self)) 
                        (wait-npc-move-to self (get-spawner-locator pos-1 1) 1 0 0 0 0 0)
                        (wait 0.20)
                    
                    (wait-one-frame)
                    (if (not (get-boolean do-run-behavior self))) 
                        (go initial 1)
                    
                    (let loop () (when 1 
                        (if (npc-alive? self)) 
                            (wait-npc-move-to self (get-spawner-locator pos-2 1) 1 0 0 0 0 0)
                            (wait 0.20)
                        
                        (if (npc-alive? self)) 
                            (wait-npc-move-to self (get-spawner-locator pos-1 1) 1 0 0 0 0 0)
                            (wait 0.20)
                        
                        (wait-one-frame)
                        (if (not (get-boolean do-run-behavior self))) 
                            (go initial 1)
                        
                     (loop)))
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (not (get-boolean do-run-behavior self))) 
                        (go initial 1)
                    
                
            }
        }
        block event update-run-behavior {
            track main {
                lambda 
                    (set-boolean do-run-behavior (event-arg-boolean 0) self)
                
            }
        }
    }
}
