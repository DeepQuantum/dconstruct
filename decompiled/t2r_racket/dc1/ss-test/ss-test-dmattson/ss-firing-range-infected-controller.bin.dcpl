                            (set! var_2 (deref (cast u64* var_1)))
                         else 
                            (set! var_2 0)
                        
                        (npc-make-aware-of var_2 player 0 0)
                    )
                
            }
        }
        block event respawner-spawned {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "respawner event %s %s " (string-debug (event-arg-symbol 0)) (string-debug (event-arg-symbol 1))) 19)
                    
                
                lambda 
                    (if (ddict-contains-key? firing-range-spawners-to-npcs (event-arg-symbol 0))) 
                        (ddict-set firing-range-spawners-to-npcs (event-arg-symbol 0) (new-boxed-value 7 (event-arg-symbol 1)))
                        (define var_6 (ddict-get firing-range-spawners-to-npcs (event-arg-symbol 0)))
                        (define var_7)
                        (if (and var_6 (== (deref (cast u16* (+ var_6 12))) 7))) 
                            (set! var_7 (deref (cast u64* var_6)))
                         else (if (and var_6 (== (deref (cast u16* (+ var_6 12))) 5))) 
                            (set! var_7 (deref (cast u64* var_6)))
                         else (if (and var_6 (== (deref (cast u16* (+ var_6 12))) 4))) 
                            (set! var_7 (deref (cast u64* var_6)))
                         else 
                            (set! var_7 0)
                        
                        (npc-set-script-only-no-perception var_7)
                    
                
            }
        }
    }
}
