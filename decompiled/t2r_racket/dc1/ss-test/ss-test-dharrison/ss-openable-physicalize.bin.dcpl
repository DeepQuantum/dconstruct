statescript {
    options {
        player
    }
    state wait-interact {
        block start {
            track main {
                lambda 
                    (enable-physics (get-self-id) door 0.00)
                
                lambda 
                    (wait 0.20)
                
                lambda 
                    (enable-collision-gamedriven (get-self-id) door 0.00)
                
