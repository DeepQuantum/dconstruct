    state interact {
        block start {
            track main {
                lambda 
                    (let loop () (when (not (> (get-animation-phase (get-self-id) 2 open) 0.95)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (set-collision-layer (get-self-id) small door)
                
                lambda 
                    (enable-physics (get-self-id) door 0.00)
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
