                            (set! var_4 (deref (cast u64* var_3)))
                         else (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 4))) 
                            (set! var_4 (deref (cast u64* var_3)))
                         else 
                            (set! var_4 0)
                        
                        (if (not (is-final-build?))) 
                            (display (dc:format "Alive: %s" (string-debug var_4)) 19)
                        
                        (send-event buddy-mark-npc player (new-boxed-value 7 var_4))
                    )
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (get-boolean do-tension-override self)) 
                        (disallow-normal-tension)
                    
                
                lambda 
                    (show-siege-safe-attachable 0)
                
                lambda 
                    (if (entity-exists? (get-symbol siege-safe-name self))) 
                        (if (and (any-enemy-aware-of-player?) (! (get-boolean siege-loot-allowed? self)))) 
                            (interactable-set-unavailable (get-symbol siege-safe-name self) 1)
                            (set-high-contrast-mode-type (get-symbol siege-safe-name self) 1)
                         else 
                            (interactable-set-unavailable (get-symbol siege-safe-name self) 0)
                            (set-high-contrast-mode-type (get-symbol siege-safe-name self) 2)
                        
                        (if (and (and (and (and (and (and (patch? 1) (is-text-to-speech-enabled?)) (! (get-boolean siege-safe-open self))) (get-boolean siege-loot-allowed? self)) (any-enemy-aware-of-player?)) (== (get-timer-value siege-safe-disabled-tts-timer self) 0.00)) (distance-between-objects-less-than? player (get-symbol siege-safe-name self) 1.50))) 
                            (start-timer siege-safe-disabled-tts-timer 12.00 self 1)
                            (speak-text-to-speech-formatted (new-boxed-value 7 HUD_ROGUE_SAFE_DISABLED_COMBAT) 1 0 1)
                        
                    
                
            }
        }
        block end {
            track main {
                lambda 
                    (stop-timer-if-running last-enemy-timer self)
                
            }
        }
    }
    state siege-recovery-phase {
        block start {
            track main {
                lambda 
                    (if (get-boolean siege-loot-allowed? self)) 
                        (interactable-set-unavailable (get-symbol siege-safe-name self) 0)
                        (set-high-contrast-mode-type (get-symbol siege-safe-name self) 2)
                     else 
                        (interactable-set-unavailable (get-symbol siege-safe-name self) 1)
                        (set-high-contrast-mode-type (get-symbol siege-safe-name self) 1)
                    
                
                lambda 
                    (++ siege-stage-tracker self)
                
                lambda 
                    (-- siege-num-waves self)
                
                lambda 
                    (if (<= (get-int32 siege-num-waves self) 0)) 
                        (go enemies-defeated-wait-safe 1)
                    
                
                lambda 
                    (set-int32 siege-recovery-time-countdown (get-int32 siege-recovery-time self) self)
                
                lambda 
                    (set-boolean siege-countdown-active 1 self)
                
                lambda 
                    (hud-siege-fade-out)
                
                lambda 
                    (hud-message-timer-show ROGUE_SIEGE_BEGINS ENCOUNTER_CRAFTING_PERIOD_ALT (cast f32 (get-int32 siege-time-countdown self)) 1 0)
                
                lambda 
                    (speak-text-to-speech-formatted (new-boxed-value 7 HUD_ROGUE_SIEGE_DEFEATED) 1 0 1)
                
                lambda 
                    (let loop () (when (> (get-int32 siege-recovery-time-countdown self) 0) 
                        (if (!= *encounter-tweaks* nullptr)) 
                            (let loop () (when (deref (cast u8* (+ *encounter-tweaks* 51))) 
                                (wait-one-frame)
                             (loop)))
                        
                        (if (get-boolean siege-loot-allowed? self)) 
                            (debug-draw-string-2d (alloc-point 350.00 50.00 0.00 0) "Enemies defeated in time, locate safe code" 3 4.00 1.00 1 0 0 1.00)
                        
                        (if (! (get-boolean siege-loot-allowed? self))) 
                            (debug-draw-string-2d (alloc-point 350.00 50.00 0.00 0) "Safe has locked. Defeat remaining enemies to escape." 2 2.00 1.00 1 0 0 1.00)
                        
                        (debug-draw-string-2d (alloc-point 50.00 30.00 0.00 0) "Capture" 1 1.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 120.00 30.00 0.00 0) (int-to-string (get-int32 current-wave-num self)) 1 1.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 130.00 30.00 0.00 0) "/" 1 1.00 1.00 1 0 0 1.00)
                        (debug-draw-string-2d (alloc-point 145.00 30.00 0.00 0) (int-to-string (get-int32 num-waves ss-wave-manager-1)) 1 1.00 1.00 1 0 0 1.00)
                        (if (and (get-boolean siege-countdown-pause self) (> (get-int32 siege-pause-time self) 0))) 
                            (debug-draw-string-2d (alloc-point 400.00 50.00 0.00 0) "Locate and defeat defenders" 2 5.00 1.00 1 0 0 1.00)
                            (debug-draw-string-2d (alloc-point 575.00 100.00 0.00 0) (int-to-string (get-int32 siege-pause-time self)) 7 0.95 1.00 1 0 0 1.00)
                        
                        (if (and (get-boolean siege-countdown-pause self) (> (get-int32 siege-pause-time self) 0))) 
                            (set-int32 siege-pause-time (- (get-int32 siege-pause-time self) 1) self)
                         else 
                            (set-int32 siege-recovery-time-countdown (- (get-int32 siege-recovery-time-countdown self) 1) self)
                        
                        (wait 1.00)
                     (loop)))
                
                lambda 
                    (set-boolean siege-countdown-active 0 self)
                
                lambda 
                    (wait 2.00)
                
                lambda 
                    (debug-draw-string-2d (alloc-point 400.00 50.00 0.00 0) "New Capture Location!" 2 4.00 2.00 1 0 0 1.00)
                
                lambda 
                    (let loop () (when (not (! (text-to-speech-playing?))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (let loop () (when (not (! (hud-tutorial-active? 0))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (speak-text-to-speech-formatted (new-boxed-value 7 HUD_ROGUE_SIEGE_NEW_LOCATION) 1 0 1)
                
                lambda 
                    (wave-manager-spawn-next-wave! ss-wave-manager-1)
                
                lambda 
                    (wait 1.00)
                
                lambda 
                    (++ current-wave-num self)
                
                lambda 
                    (broadcast-event recovery-done)
                
                lambda 
                    (go siege-wave-active 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (disallow-normal-tension)
                
                lambda 
                    (show-siege-safe-attachable 0)
                
            }
        }
    }
    state enemies-defeated-wait-safe {
        block start {
            track safe-reminder {
                lambda 
                    (wait-for show-safe-reminder)
                
                lambda 
                    (if (not (get-svar-as-boolean tut-rogue-safe-reminder))) 
                        (hud2-play-tutorial HUD_ROGUE_SIEGE_ENEMIES_DEFEATED 7.00 0 0 1 0 0 0)
                        (set-svar-as-boolean tut-rogue-safe-reminder 1)
                    
                
            }
            track main {
                lambda 
                    (if (>= (get-int32 siege-crate-time self) 30)) 
                        (set-boolean force-open 1 self)
                        (set-boolean auto-open-safe? 1 self)
                        (go siege-complete-success 1)
                     else (if (and (not (get-boolean siege-safe-open self)) (!= (get-difficulty-setting-resources) 5))) 
                        (signal show-safe-reminder 0)
                    
                
                lambda 
                    (if (get-boolean siege-loot-allowed? self)) 
                        (interactable-set-unavailable (get-symbol siege-safe-name self) 0)
                        (set-high-contrast-mode-type (get-symbol siege-safe-name self) 2)
                    
                
                lambda 
                    (let loop () (when (get-boolean siege-loot-allowed? self) 
                        (if (get-boolean siege-safe-open self)) 
                            (wait 5.00)
                            (go siege-complete-success 1)
                        
                        (update-time-ticks--siege)
                        (hud-siege-set-safe-time (cast f32 (get-int32 siege-crate-time self)) HUD_ROGUE_SAFE_LOCKS 1 (get-boolean siege-countdown-pause self) (< (get-int32 siege-crate-time self) 10) 0 -1.00 0)
                        (decrement-siege-time-func)
                        (if (<= (get-int32 siege-crate-time self) 0)) 
                            (set-boolean siege-loot-allowed? 0 self)
                        
                        (wait 1.00)
                     (loop)))
                
                lambda 
                    (if (and (and (! (get-boolean siege-loot-allowed? self)) (get-boolean siege-loot-fail-message? self)) (not (get-boolean siege-safe-open self)))) 
                        (hud-siege-set-safe-time 0.00 HUD_ROGUE_SAFE_LOCKED 1 0 1 1 5.00 0)
                        (if (not (get-boolean 0Tick self))) 
                            (play-sound sfx-rl-capture-timer-tick-safe-locked 0)
                            (set-boolean 0Tick 1 self)
                        
                        (interactable-set-unavailable (get-symbol siege-safe-name self) 1)
                        (override-interact-def (get-symbol siege-safe-name self) t2r-interact-safe-locked)
                        (set-high-contrast-mode-type (get-symbol siege-safe-name self) 1)
                        (set-boolean siege-loot-fail-message? 0 self)
                        (wait 3.00)
                    
                
                lambda 
                    (go siege-complete-success 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (set-walk-type walk-tense)
                
                lambda 
                    (set-run-type run-tense)
                
                lambda 
                    (set-sprint-type sprint-tense)
                
                lambda 
                    (show-siege-safe-attachable (&& (timer-running? timer-show-safe-icon self) (distance-between-objects-greater-than? player (get-symbol siege-safe-name self) 10.00 1)))
                
            }
        }
    }
    state siege-complete-success {
        block start {
            track main {
                lambda 
                    (hud-siege-update-enemies 0 0)
                
                lambda 
                    (send-event vox-match-end ss-vox-rl-encounter-controller-1)
                
                lambda 
                    (if (get-boolean siege-loot-allowed? self)) 
                        (interactable-set-unavailable (get-symbol siege-safe-name self) 0)
                        (set-high-contrast-mode-type (get-symbol siege-safe-name self) 2)
                     else 
                        (interactable-set-unavailable (get-symbol siege-safe-name self) 1)
                        (override-interact-def (get-symbol siege-safe-name self) t2r-interact-safe-locked)
                        (set-high-contrast-mode-type (get-symbol siege-safe-name self) 1)
                    
                
                lambda 
                    (broadcast-event encounter-combat-complete)
                
                lambda 
                    (if (and (get-boolean auto-open-safe? self) (not (get-boolean siege-safe-open self)))) 
                        (hud-siege-set-safe-time (cast f32 (get-int32 siege-crate-time self)) HUD_SCORE_SAFE_CAPTURED 1 (get-boolean siege-countdown-pause self) (< (get-int32 siege-crate-time self) 5) 0 3.00 1)
                     else 
                        (hud-siege-destroy)
                    
                
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (log-event "siege-completed" 1 "" 0 0)
                
                lambda 
                    (if (== (darray-count grp-lockbox-spawn-locations-siege-dynamic) 0)) 
                        (group-copy grp-lockbox-spawn-locations-siege grp-lockbox-spawn-locations-siege-dynamic)
                    
                
                lambda 
                    (play-sound sfx-rl-round-end-win 0)
                
                lambda 
                    (wait 0.50)
                
                lambda 
                    (hud-encounter-over-create ENCOUNTER_MISSION_COMPLETE t2-yellow 1)
                
                lambda 
                    (hud-encounter-over-fade-in)
                
                lambda 
                    (wait 5.00)
                
                lambda 
                    (set-int32 siege-wrapup-time (- (get-int32 siege-wrapup-time self) 5) self)
                
                lambda 
                    (hud-encounter-over-fade-out)
                
                lambda 
                    (let loop () (when (not (not (get-boolean moving-to-safe self))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (hud-message-timer-show ENCOUNTER_MISSION_EXIT_ALT_CAPS ENCOUNTER_CRAFTING_PERIOD_ALT (cast f32 (get-int32 siege-wrapup-time self)) 0 0)
                
                lambda 
                    (let loop () (when (> (get-int32 siege-wrapup-time self) 0) 
                        (if (and (and (and (timer-done? acc-time-repeat-timer self) (not (text-to-speech-playing?))) (! (hud-tutorial-active? 0))) (== (mod-int32 (get-int32 siege-wrapup-time self) 5) 0))) 
                            (start-timer acc-time-repeat-timer 5.00 self 1)
                        
                        (if (not (get-boolean moving-to-safe self))) 
                            (wait 1.00)
                            (-- siege-wrapup-time self)
                         else 
                            (wait 0.10)
                        
                     (loop)))
                
                lambda 
                    (broadcast-event workbench-menu-exit)
                
                lambda 
                    (if (and (get-boolean siege-safe-open self) (! (get-boolean siege-loot-allowed? self)))) 
                        (hud-siege-destroy)
                        (broadcast-event encounter-complete)
                     else (if (get-boolean force-open self)) 
                        (let loop () (when (not (not (fact-get-bool-safe player in-workbench))) 
                            (wait-one-frame)
                         (loop)))
                        (hud-siege-destroy)
                        (send-event force-open-safe (get-symbol siege-safe-name self))
                    
                
            }
            track music {
                lambda 
                    (let loop () (when (and (<= (get-int32 siege-wrapup-time self) 2) (not (not (get-boolean moving-to-safe self)))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (play-music-stinger *music-playlist-rogue-encounter-complete* 0)
                
            }
        }
        block event moving-to-safe {
            track main {
                lambda 
                    (define var_0 (get-current-time 0))
                    (let loop () (when (not (>= (- (get-current-time 0) var_0) 0.20)) 
                        (gui2-set-widget-alpha (rogue-ui--get-t2r-timer-path) (lerp-scale 0.00 0.20 1.00 0.00 (- (get-current-time 0) var_0)))
                        (wait-one-frame)
                     (loop)))
                    (gui2-set-widget-alpha (rogue-ui--get-t2r-timer-path) 0.00)
                
                lambda 
                    (set-boolean moving-to-safe 1 self)
                
                lambda 
                    (hud-message-timer-pause 5.00)
                
                lambda 
                    (wait 5.00)
                
                lambda 
                    (set-int32 siege-wrapup-time (+ (get-int32 siege-wrapup-time self) 5) self)
                
                lambda 
                    (set-boolean force-open 0 self)
                
                lambda 
                    (set-boolean moving-to-safe 0 self)
                
                lambda 
                    (hud-message-timer-show ENCOUNTER_MISSION_EXIT_ALT_CAPS ENCOUNTER_CRAFTING_PERIOD_ALT (cast f32 (get-int32 siege-wrapup-time self)) 0 0)
                
                lambda 
                    (define var_0 (get-current-time 0))
                    (let loop () (when (not (>= (- (get-current-time 0) var_0) 0.20)) 
                        (gui2-set-widget-alpha (rogue-ui--get-t2r-timer-path) (lerp-scale 0.00 0.20 0.00 1.00 (- (get-current-time 0) var_0)))
                        (wait-one-frame)
                     (loop)))
                    (gui2-set-widget-alpha (rogue-ui--get-t2r-timer-path) 1.00)
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (get-boolean is-encounter-manager-task? ss-wave-manager-level-set-loader-1)) 
                        (if (get-boolean no-sprint self)) 
                            (joypad-disable-commands sprint)
                        
                        (if (get-boolean no-move self)) 
                            (joypad-disable-all-commands)
                        
                    
                
                lambda 
                    (if (! (get-boolean siege-safe-open self))) 
                        (show-siege-safe-attachable 0)
                        (set-walk-type walk-tense)
                        (set-run-type run-tense)
                        (set-sprint-type sprint-tense)
                    
                
                lambda 
                    (if (< (get-int32 siege-wrapup-time self) 4)) 
                        (interactable-set-unavailable (get-symbol siege-safe-name self) 1)
                    
                
                lambda 
                    (if (< (get-int32 siege-wrapup-time self) 2)) 
                        (set-focusable-ignore/f player)
                    
                
                lambda 
                    (if (entity-exists? ss-chained-infected-manager-1)) 
                        (if (< (closest-distance-to-any-chained-inf) 15.00)) 
                            (set-walk-type walk-tense)
                            (set-run-type run-tense)
                            (set-sprint-type sprint-tense)
                        
                    
                
                lambda 
                    (if (< (get-int32 siege-wrapup-time self) 6)) 
                        (hud2-suppress-reminders/f)
                    
                
                lambda 
                    (if (< (get-int32 siege-wrapup-time self) 3)) 
                        (for ([var_4 (get-symbol group-available-workbenches self)]) 
                            (define var_5)
                            (if (and var_4 (== (deref (cast u16* (+ var_4 12))) 7))) 
                                (set! var_5 (deref (cast u64* var_4)))
                             else (if (and var_4 (== (deref (cast u16* (+ var_4 12))) 5))) 
                                (set! var_5 (deref (cast u64* var_4)))
                             else (if (and var_4 (== (deref (cast u16* (+ var_4 12))) 4))) 
                                (set! var_5 (deref (cast u64* var_4)))
                             else 
                                (set! var_5 0)
                            
                            (interactable-disable var_5)
                        )
                    
                
            }
        }
    }
}
