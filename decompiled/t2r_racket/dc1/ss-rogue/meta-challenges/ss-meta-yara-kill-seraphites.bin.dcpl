statescript {
    options {
        player
    }
    declarations {
        i32 kills-required = 50
    }
    state tracking {
        block event encounter-combat-complete {
            track main {
                lambda 
                    (if (and (== (encounter--get-faction-enum (encounter--get-current-encounter-ddict)) 1) (== (rogue-get-player-character) 6))) 
                        (go completed 1)
                    
                
            }
        }
        block event force-meta-complete {
            track main {
                lambda 
                    (go completed 1)
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (if (print-meta-debug)) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "Yara Kill 50 Seraphites Trial Complete") 19)
                        
                        (debug-draw-string-2d (alloc-point 315.00 400.00 0.00 0) "Challenge Completed" 7 5.00 4.00 1 0 0 1.00)
                    
                
                lambda 
                    (request-meta-complete-notification meta-yara-kill-seraphites)
                
                lambda 
                    (log-event "meta trial complete" 0 "yara kill seraphites" 0 0)
                
                lambda 
                    (broadcast-event meta-challenge-complete-abby)
                
                lambda 
                    (set-svar-as-boolean meta-yara-kill-seraphites 1)
                
                lambda 
                    (set-svar-as-boolean player-skins-yara-player-safehouse 1)
                
                lambda 
                    (increment-svar meta-num-skins-unlocked 1)
                
                lambda 
                    (t2r-meta-trial-updates-add meta-yara-kill-seraphites)
                
                lambda 
                    (kill-entity self)
                
            }
        }
    }
}
