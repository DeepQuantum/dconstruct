statescript {
    options {
        player
    }
    declarations {
        i32 encounter-meta-dodge-count = 0
    }
    state tracking {
        block start {
            track main {
                lambda 
                    (set-int32 encounter-meta-dodge-count 0 self)
                
            }
        }
        block event player-dodge-start {
            track main {
                lambda 
                    (++ encounter-meta-dodge-count self)
                
                lambda 
                    (if (>= (get-int32 encounter-meta-dodge-count self) 15)) 
                        (go completed 1)
                    
                
            }
        }
        block event force-meta-complete {
            track main {
                lambda 
                    (go completed 1)
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (if (print-meta-debug)) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "Abby dodge Trial Complete") 19)
                        
                        (debug-draw-string-2d (alloc-point 315.00 400.00 0.00 0) "Challenge Completed" 7 5.00 4.00 1 0 0 1.00)
                    
                
                lambda 
                    (request-meta-complete-notification meta-abby-dodge)
                
                lambda 
                    (log-event "meta trial complete" 0 "abby dodge" 0 0)
                
                lambda 
                    (set-svar-as-boolean meta-abby-dodge 1)
                
                lambda 
                    (t2r-meta-trial-updates-add meta-abby-dodge)
                
                lambda 
                    (kill-entity self)
                
            }
        }
    }
