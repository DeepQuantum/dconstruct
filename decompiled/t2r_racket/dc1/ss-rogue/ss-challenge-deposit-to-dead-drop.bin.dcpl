statescript {
    options {
        player
    }
    declarations {
        i32 deposit-items-needed = 0
    }
    state tracking {
        block start {
            track main {
                lambda 
                    (set-int32 deposit-items-needed (get-int32 deposit-item-count ss-dead-drop-manager-1) self)
                
                lambda 
                    (hud-challenge-update-progress-count 0 (get-int32 deposit-items-needed self))
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (get-boolean items-deposited ss-dead-drop-manager-1)) 
                        (hud-challenge-update-progress-count (get-int32 deposit-items-needed self) (get-int32 deposit-items-needed self))
                        (go completed 1)
                    
                
            }
        }
    }
    state completed {
        block start {
            track main {
                lambda 
                    (send-event challenge-complete ss-challenges-controller-1)
                
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EC: Challenge complete %s" (string-debug (get-self-id))) 19)
                    
                
            }
        }
    }
}
