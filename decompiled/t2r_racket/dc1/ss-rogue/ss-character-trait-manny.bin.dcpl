statescript {
    options {
        player
    }
    state tracking {
        block update {
            track main {
                lambda 
                    (player-vertigo-scale 0.00)
                
            }
        }
        block event run-complete {
            track main {
                lambda 
                    (if (not (get-svar-as-boolean rogue-cheat-mod-ever-enabled))) 
                        (increment-stat runs-complete-manny 1)
                        (increment-stat meta-runs-complete 1)
                        (set-stat-bit trophy-win-with-all-characters 8)
                    
                
            }
        }
    }
}
