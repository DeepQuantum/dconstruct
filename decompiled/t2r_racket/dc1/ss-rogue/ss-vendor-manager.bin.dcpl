        (if (not (is-final-build?))) 
            (display (dc:format "[DEB-VM] failed to initialize %s, trying other group" (get-item-type-as-string arg_0)) 19)
        
        (if (== arg_0 2)) 
            (define var_37)
            (if (vendor-can-roll-item-type? 3 0)) 
                (set! var_37 (vendor-initialize-by-type 3 0))
             else (if (vendor-can-roll-item-type? 4 0)) 
                (set! var_37 (vendor-initialize-by-type 4 0))
             else 
                (set! var_37 0)
            
            (set! var_6 var_37)
         else (if (== arg_0 3)) 
            (define var_42)
            (if (vendor-can-roll-item-type? 2 0)) 
