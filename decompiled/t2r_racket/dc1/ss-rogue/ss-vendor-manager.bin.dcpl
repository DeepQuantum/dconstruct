             else 
                (set! var_42 0)
            
            (set! var_6 var_42)
         else (if (== arg_0 4)) 
            (define var_47)
            (if (vendor-can-roll-item-type? 2 0)) 
                (set! var_47 (vendor-initialize-by-type 2 0))
             else (if (vendor-can-roll-item-type? 3 0)) 
