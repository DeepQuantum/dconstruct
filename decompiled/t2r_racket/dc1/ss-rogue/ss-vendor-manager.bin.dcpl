(define (vendor-initialize-group-if-possible arg_0) 
    (if (not (is-final-build?))) 
        (display (dc:format "[DEB-VM] ------------------------------") 19)
    
    (if (not (is-final-build?))) 
        (display (dc:format "[DEB-VM] vendor attempting initialize %s" (get-item-type-as-string arg_0)) 19)
    
