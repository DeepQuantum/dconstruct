        (set! var_52 (vendor-initialize-by-type 10 0))
     else 
        (set! var_52 0)
    
    var_52
)

statescript {
    declarations {
        i32 page-selection-index = 0
        i32 item-available-index = 0
        i32 item-real-index = 0
        bool is-buying? = true
        bool update-tts? = nullptr
        i32 enable-pistol-glock = 0
        i32 enable-pistol-glock-upgraded = 0
        i32 enable-pistol-xcaliber = 0
        i32 enable-pistol-xcaliber-upgraded = 0
        i32 enable-shotgun-baserri-over-under = 0
        i32 enable-shotgun-baserri-over-under-upgraded = 0
        i32 enable-crossbow = 0
        i32 enable-crossbow-upgraded = 0
        i32 enable-rifle-vepr = 0
        i32 enable-rifle-vepr-upgraded = 0
        i32 enable-flamethrower = 0
        i32 enable-pistol-beretta = 0
        i32 enable-pistol-revolver-taurus = 0
        i32 enable-shotgun-remington-pump = 0
        i32 enable-bow-ellie = 0
        i32 enable-rifle-remington-bolt = 0
        i32 enable-rifle-mpx5 = 0
        i32 enable-pistol-glock-ammo-x10 = 0
        i32 enable-pistol-xcaliber-ammo-x6 = 0
        i32 enable-shotgun-baserri-over-under-ammo-x3 = 0
        i32 enable-crossbow-ammo-x3 = 0
        i32 enable-rifle-vepr-ammo-x5 = 0
        i32 enable-flamethrower-ammo-x10 = 0
        i32 enable-pistol-beretta-ammo-x10 = 0
        i32 enable-pistol-revolver-taurus-ammo-x6 = 0
        i32 enable-shotgun-remington-pump-ammo-x3 = 0
        i32 enable-bow-ellie-ammo-x3 = 0
        i32 enable-explosive-arrow = 0
        i32 enable-dragons-breath-ammo-x3 = 0
        i32 enable-rifle-remington-bolt-ammo-x5 = 0
        i32 enable-rifle-mpx5-ammo-x10 = 0
        i32 enable-health-kit = 0
        i32 enable-pipe-bomb = 0
        i32 enable-molotov = 0
        i32 enable-stun-bomb = 0
        i32 enable-smoke-bomb = 0
        i32 enable-trap-bomb = 0
        i32 enable-recipe-health-kit = 0
        i32 enable-recipe-pipe-bomb = 0
        i32 enable-recipe-silencer = 0
        i32 enable-recipe-xcaliber-ammo = 0
        i32 enable-recipe-ammo-shotgun-dragons-breath = 0
        i32 enable-recipe-melee-upgrade = 0
        i32 enable-recipe-molotov = 0
        i32 enable-recipe-arrow = 0
        i32 enable-recipe-arrow-explosive = 0
        i32 enable-recipe-shiv = 0
        i32 enable-recipe-stun-bomb = 0
        i32 enable-recipe-trap-bomb = 0
        i32 enable-weapon-parts-x20 = 0
        i32 enable-supplements-x20 = 0
        i32 enable-upgrade-manual-health-1 = 0
        i32 enable-upgrade-manual-crafting-3 = 0
        i32 enable-upgrade-manual-stealth-3 = 0
        i32 enable-long-gun-holster = 0
        i32 enable-short-gun-holster = 0
        i32 enable-machete = 0
        i32 enable-lead-pipe = 0
        i32 enable-vendor-reroll = 0
        i32 enable-vendor-reroll-once = 0
        i32 enable-vendor-buddy = 0
        symbol menu-widget = nullptr
        symbol vendor-available-group-save = nullptr
        bool vendor-init-flag-1 = nullptr
        bool vendor-init-flag-2 = nullptr
    }
    state --all-- {
        block event designer-menu-changed {
            track main {
                lambda 
                    (if (and (and (!= *encounter-tweaks* nullptr) (deref (cast u8* (+ *encounter-tweaks* 112)))) (> (deref (cast i32* (+ *encounter-tweaks* 116))) 0))) 
                        (set-svar vendor-currency (deref (cast i32* (+ *encounter-tweaks* 116))))
                        (set! (deref (cast u8* (+ *encounter-tweaks* 112))) 0)
                        (broadcast-event vendor-changed)
                    
                
                lambda 
                    (if (and (!= *encounter-tweaks* nullptr) (deref (cast u8* (+ *encounter-tweaks* 120))))) 
                        (set! (deref (cast u8* (+ *encounter-tweaks* 120))) 0)
                        (roll-vendor)
                    
                
            }
        }
        block event roll-vendor {
            track main {
                lambda 
                    (roll-vendor)
                
            }
        }
        block event close-vendor {
            track main {
                lambda 
                    (broadcast-event vendor-exit)
                
                lambda 
                    (rogue-save)
                
                lambda 
                    (go wait-for-event 1)
                
            }
        }
        block event purchase {
            track main {
                lambda 
                    (broadcast-event vendor-purchase (new-boxed-value 2 (event-arg-int32 1)) (new-boxed-value 2 (event-arg-int32 0)))
                
                lambda 
                    (vendor-item-transaction (event-arg-int32 0) (event-arg-int32 1) 1)
                
                lambda 
                    (rogue-save)
                
            }
        }
        block event player-craft-item {
            track main {
                lambda 
                    (rogue-save)
                
            }
        }
        block event weapon-given {
            track main {
                lambda 
                    (let loop () (when (not (not (== task-subnode-get-active-continue 0))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (rogue-save)
                
            }
        }
        block event player-pickup {
            track main {
                lambda 
                    (let loop () (when (not (not (== task-subnode-get-active-continue 0))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (rogue-save)
                
            }
        }
        block event give-weapon-upgrade-bundle {
            track main {
                lambda 
                    (let loop () (when (not (not (== task-subnode-get-active-continue 0))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (rogue-save)
                
            }
        }
        block event player-upgrade-enabled {
            track main {
                lambda 
                    (if (== (event-arg-symbol 0) vendor-infinite-reroll)) 
                        (vendor-initialize-by-type 9 0)
                        (broadcast-event vendor-changed)
                    
                
                lambda 
                    (let loop () (when (not (not (== task-subnode-get-active-continue 0))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (rogue-save)
                
            }
        }
        block event player-loadout-initialized {
            track main {
                lambda 
                    (set-boolean vendor-init-flag-2 1 self)
                
                lambda 
                    (if (not (rogue-get-is-resumed-run))) 
                        (try-init-vendor)
                    
                
            }
        }
    }
    state initialize {
        block start {
            track main {
                lambda 
                    (if (not (rogue-get-is-resumed-run))) 
                        (set-symbol vendor-available-group-save (darray-create self -1 1) self)
                        (rogue-set-vendor-darray (get-symbol vendor-available-group-save self))
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (and (object-spawned? player) (encounter--generated-run?))) 
                        (set-boolean vendor-init-flag-1 1 self)
                        (if (not (rogue-get-is-resumed-run))) 
                            (try-init-vendor)
                        
                        (go wait-for-event 1)
                    
                
            }
        }
        block event rogue-run-loaded {
            track main {
                lambda 
                    (load-vendor-from-save)
                
                lambda 
                    (set-boolean vendor-init-flag-1 1 self)
                
                lambda 
                    (set-boolean vendor-init-flag-2 1 self)
                
            }
        }
    }
    state wait-for-event {
        block event rogue-run-loaded {
            track main {
                lambda 
                    (load-vendor-from-save)
                
            }
        }
        block event rogue-encounter-complete {
            track main {
                lambda 
                    (set-svar-as-boolean reroll-used 0)
                
                lambda 
                    (roll-vendor)
                
            }
        }
        block event display-vendor {
            track main {
                lambda 
                    (set-int32 page-selection-index 0 self)
                
                lambda 
                    (set-int32 item-available-index 0 self)
                
                lambda 
                    (set-int32 item-real-index 0 self)
                
                lambda 
                    (set-boolean is-buying? 1 self)
                
                lambda 
                    (go vendor-screen 1)
                
            }
        }
        block event player-upgrade-enabled {
            track main {
                lambda 
                    (if (darray-contains? (get-symbol vendor-available-group-save self) (new-boxed-value 7 enable-stun-bomb))) 
                        (darray-find-remove (get-symbol vendor-available-group-save self) (new-boxed-value 7 enable-stun-bomb) 0)
                        (darray-append (get-symbol vendor-available-group-save self) (new-boxed-value 7 enable-smoke-bomb) 0)
                        (set-int32 enable-smoke-bomb 1 self)
                        (set-int32 enable-stun-bomb 0 self)
                    
                
                lambda 
                    (if (darray-contains? (get-symbol vendor-available-group-save self) (new-boxed-value 7 enable-stun-bomb-recipe))) 
                        (darray-find-remove (get-symbol vendor-available-group-save self) (new-boxed-value 7 enable-stun-bomb-recipe) 0)
                        (set-int32 enable-stun-bomb-recipe 0 self)
                    
                
                lambda 
                    (if (not (== task-subnode-get-active-continue 0))) 
                        (rogue-save)
                    
                
            }
        }
    }
    state vendor-screen {
        block start {
            track main {
                lambda 
                    (broadcast-event vendor-enter)
                
                lambda 
                    (log-event "vendor-open" (get-svar vendor-currency) "" 0 0)
                
                lambda 
                    (debug-draw-clear-all)
                
                lambda 
                    (set-symbol menu-widget (menu2-push-page hudMenuStack "pc/t2r-vendor/vendor-menu-pc" 0) self)
                
            }
        }
        block end {
            track main {
                lambda 
                    (menu2-pop-page-and-all-above hudMenuStack (symbol-concat-string 0 "pc/t2r-vendor/vendor-menu-pc"))
                
            }
        }
    }
    state transaction-screen {
        block start {
            track main {
                lambda 
                    (wait 1.00)
                
                lambda 
                    (go vendor-screen 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (display-transaction-screen (get-int32 page-selection-index self) (get-int32 item-real-index self) (get-boolean is-buying? self))
                
            }
        }
    }
}
