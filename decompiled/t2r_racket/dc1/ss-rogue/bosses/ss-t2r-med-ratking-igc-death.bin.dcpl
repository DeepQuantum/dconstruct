                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 0 8))))) 10)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) 0)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 0 8))) 8))) (get-bound-frame bloater-ap self))
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 1 8))))) 28)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 1 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_0) (* 1 8))) 8))) 0.00)
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 2 8))))) 58)
