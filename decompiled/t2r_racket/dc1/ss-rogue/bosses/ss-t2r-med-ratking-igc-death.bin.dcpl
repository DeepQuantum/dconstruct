                    (set! (deref (cast f32* (+ (deref (+ (deref var_0) (* 2 8))) 8))) 1.00)
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 3 8))))) 56)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 3 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_0) (* 3 8))) 8))) 0.00)
                    (set! (deref (cast i32* (deref (+ (deref var_0) (* 4 8))))) 86)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_0) (* 4 8))) 8))) 0)
                    (set! (deref (cast u8* (+ (deref (+ (deref var_0) (* 4 8))) 8))) 1)
                    (animate_ npc-ratking-bloater-1 ratking-death--ratking var_0)
                
                lambda 
