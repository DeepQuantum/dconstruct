                        (if (not (is-final-build?))) 
                            (display (dc:format "DEB-BO: Guard post npc died, disabling their hard point...") 19)
                        
                        (set-hardpoint-disabled guard-post-hard-point-1)
                    
                
                lambda 
                    (if (== (event-arg-symbol 0) npc-super-slaver-1)) 
                        (hud-boss-fade-out)
                    
                
