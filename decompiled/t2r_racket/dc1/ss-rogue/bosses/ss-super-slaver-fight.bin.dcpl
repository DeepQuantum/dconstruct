                lambda 
                    (wait 2.00)
                
                lambda 
                    (wait-say npc-super-slaver-1 vox-event-ai-gen-enmy-srch-check-in-gnrc-frustrated-unwr-call-spj 2 0)
                
                lambda 
                    (wait 0.50)
                
                lambda 
                    (wait-say (get-closest-in-group-on-screen vox-grp-farm-human-npcs player 0 0 1) vox-event-ai-gen-enmy-srch-check-in-rattler-captain-spj 2 0)
                
                lambda 
                    (wait 0.50)
                
                lambda 
                    (wait-say npc-super-slaver-1 vox-event-ai-gen-enmy-srch-strt-frustrated-spj 2 0)
                
                lambda 
                    (wait 0.25)
                
                lambda 
                    (send-event vox-match-start ss-vox-rl-encounter-controller-1)
                
            }
        }
        block event tension-changed {
            track main {
                lambda 
                    (if (tension-mode-is? 3)) 
                        (if (get-animation-playing? npc-super-slaver-1 npc-m-nw-perch-rail-investigate-idle 2)) 
                            (stop-animating npc-super-slaver-1 2 0.00 0 0)
                        
                        (go combat-start 1)
                    
                
            }
        }
        block end {
            track main {
                lambda 
                    (if (not (get-boolean boss-health-ready self))) 
                        (hud-boss-create)
                        (hud-boss-add-new-bar super-slaver-health-bar 1 HUD_ROGUE_BOSS_SUPER_SLAVER "hud/rogue/t2r-boss-rattler-captain.png")
                        (hud-boss-fade-in)
                        (set-boolean boss-health-ready 1 self)
                    
                
            }
        }
    }
    state combat-start {
        block start {
            track timers {
                lambda 
                    (start-timer reinforcement-timeout (get-float reinforcement-timeout-seconds self) self 1)
                
            }
            track hard-points {
                lambda 
                    (for ([var_1 grp-combat-hard-points-super-slaver]) 
                        (define var_2)
                        (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 7))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 5))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else 
                            (set! var_2 0)
                        
                        (set-hardpoint-enabled var_2)
                    )
                
            }
            track npcs {
                lambda 
                    (for ([var_1 grp-main-reinforcement-npcs]) 
                        (define var_2)
                        (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 7))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 5))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else 
                            (set! var_2 0)
                        
                        (npc-clear-hard-point var_2)
                        (npc-clear-zone-if-alive var_2)
                    )
                
            }
            track main {
                lambda 
                    (melee-fact-set-bool npc-super-slaver-1 is-boss 1)
                
                lambda 
                    (npc-force-target npc-super-slaver-1 player)
                
                lambda 
                    (go combat 1)
                
            }
        }
    }
    state combat {
        block start {
            track close-loadout-activated {
                lambda 
                    (start-timer boss-close-loadout-timeout (get-float boss-close-loadout-timeout-seconds self) self 1)
                
                lambda 
                    (wait-boolean player-activated-close-loadout? 1 self)
                
                lambda 
                    (if (npc-alive? npc-super-slaver-1)) 
                        (npc-clear-zone npc-super-slaver-1)
                        (npc-clear-hard-point npc-super-slaver-1)
                        (if (and (npc-on-screen-and-visible? npc-super-slaver-1 -1 0) (<= (distance-between-locators-xz (get-object-locator player) (get-object-locator npc-super-slaver-1)) 10.00))) 
                            (if (npc-can-see? npc-super-slaver-1 player)) 
                                (npc-set-weapon-loadout npc-super-slaver-1 slaver-super-rifle-semi-auto-tomahawk-phase-1-transition)
                                (npc-request-throw-grenade-at-player npc-super-slaver-1 0)
                            
                            (if (not (npc-in-cover? npc-super-slaver-1))) 
                                (define var_8)
                                (let loop () (when (not (npc-get-ideal-post npc-super-slaver-1 13)) 
                                    (wait-one-frame)
                                    (set! var_8 (npc-get-ideal-post npc-super-slaver-1 13))
                                 (loop)))
                                (wait-npc-move-to-post npc-super-slaver-1 var_8 2 0 0 0 1 0 *zero-vector* 0)
                            
                            (wait-npc-holster-weapon npc-super-slaver-1 0 1 -1.00 0)
                        
                        (npc-set-combat-params npc-super-slaver-1 *t2r-super-slaver-shotgun-combat-params*)
                        (npc-set-weapon-loadout npc-super-slaver-1 slaver-super-rifle-semi-auto-tomahawk-phase-3)
                        (wait-npc-unholster-weapon npc-super-slaver-1 2 -1.00 0)
                    
                
            }
        }
        block event boss-close-loadout-timeout-seconds {
            track main {
                lambda 
                    (set-boolean player-activated-close-loadout? 1 self)
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (define var_0 (human-npc-alive-count))
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-BO: [npc-died (%s)] remaining-npc-count = %i" (string-debug (event-arg-symbol 0)) var_0) 19)
                    
                    (if (<= var_0 (get-int32 boss-unzone-enemies-left self))) 
                        (if (and (npc-alive? npc-super-slaver-1) (npc-has-zone? npc-super-slaver-1))) 
                            (if (not (is-final-build?))) 
                                (display (dc:format "DEB-BO: Unzoning super slaver!") 19)
                            
                            (npc-clear-hard-point npc-super-slaver-1)
                            (npc-clear-zone npc-super-slaver-1)
                            (set-hardpoint-disabled super-slaver-hard-point-1)
                            (if (not (get-boolean player-activated-close-loadout? self))) 
                                (npc-set-combat-params npc-super-slaver-1 *t2r-super-slaver-close-rifle-combat-params*)
                            
                        
                    
                    (if (<= var_0 (get-int32 boss-close-loadout-enemies-threshold self))) 
                        (if (npc-alive? npc-super-slaver-1)) 
                            (if (not (is-final-build?))) 
                                (display (dc:format "DEB-BO: Forcing phase change on super slaver") 19)
                            
                            (stop-timer-if-running boss-close-loadout-timeout self)
                            (set-boolean player-activated-close-loadout? 1 self)
                        
                    
                    (if (and (or (<= var_0 (get-int32 reinforcement-enemies-threshold self)) (not (get-boolean field-reinforcements-activated? self))) (not (get-boolean pools-reinforcements-activated? self)))) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "DEB-BO: Forcing reinforcements to spawn") 19)
                        
                        (stop-timer-if-running reinforcement-timeout self)
                        (set! var_18 (broadcast-event reinforcement-timeout))
                    
                
            }
        }
        block event reinforcement-timeout {
            track main {
                lambda 
                    (if (timer-running? reinforcement-cooldown self)) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "DEB-BO: Attempted to spawn reinforcements but cooldown is running...") 19)
                        
                        (let loop () (when (not (not (timer-running? reinforcement-cooldown self))) 
                            (wait-one-frame)
                         (loop)))
                    
                
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-BO: Spawning reinforcements!") 19)
                    
                
                lambda 
                    (request-reinforcement-spawn)
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (and (< (get-player-to-object-distance npc-super-slaver-1) 12.00) (not (get-boolean player-activated-close-loadout? self)))) 
                        (stop-timer-if-running boss-close-loadout-timeout self)
                        (set-boolean player-activated-close-loadout? 1 self)
                    
                
            }
        }
    }
    state cleanup {
        block start {
            track main {
                lambda 
                    (go done 1)
                
            }
        }
    }
    state done {
        block start {
            track main {
                lambda 
                    (hud-boss-destroy)
                
            }
        }
    }
}
