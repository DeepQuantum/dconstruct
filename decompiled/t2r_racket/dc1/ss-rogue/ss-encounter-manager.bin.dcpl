                lambda 
                    (go encounter 1)
                
            }
        }
    }
    state encounter-success {
        block start {
            track main {
                lambda 
                    (if (player-in-state? Death)) 
                        (go encounter-fail 1)
                    
                
                lambda 
                    (log-success-status-focus-test)
                
                lambda 
                    (set-svar skulls-completed (+ (get-svar skulls-completed) (get-int32 active-skulls ss-modifiers-manager-1)))
                
                lambda 
                    (set-svar encounter-depth (+ (get-svar encounter-depth) 1))
                
                lambda 
                    (set-svar-bit completed-encounters (get-svar encounter-index) 1)
                
                lambda 
                    (set-boolean encounter-success 1 self)
                
                lambda 
                    (broadcast-event encounter-cleanup)
                
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (rogue-force-remember-checkpoint)
                
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EM: (get-svar 'encounter-index) %i" (get-svar encounter-index)) 19)
                    
                
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EM: (get-svar 'encounter-depth) %i" (get-svar encounter-depth)) 19)
                    
                
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EM: (get-int32 'run-length) %i" (get-int32 run-length self)) 19)
                    
                
                lambda 
                    (if (>= (get-svar encounter-depth) (get-int32 run-length self))) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "DEB-EM: run finished, starting reset...") 19)
                        
                        (reset-tutorials-for-focus-test!)
                        (go encounter-success-reset 1)
                    
                
                lambda 
                    (if (< (get-svar encounter-depth) (get-int32 run-length self))) 
                        (if (not (is-final-build?))) 
                            (display (dc:format "DEB-EM: run continuing, setting up next encounter and sending player to hub...") 19)
                        
                        (go encounter-success-continue 1)
                    
                
            }
        }
    }
    state encounter-success-continue {
        block start {
            track main {
                lambda 
                    (broadcast-event rogue-encounter-complete)
                
                lambda 
                    (go wait-for-post-flow-encounter-complete 1)
                
            }
        }
    }
    state encounter-success-reset {
        block start {
            track main {
                lambda 
                    (if (and (rogue-is-daily-run) (not (get-svar-as-boolean rogue-cheat-mod-ever-enabled)))) 
                        (increment-stat trophy-complete-daily-run 1)
                        (if (== (get-difficulty) 5)) 
                            (increment-stat trophy-complete-grounded-daily-run 1)
                        
                    
                
                lambda 
                    (log-run-progression-focus-test-debug-only! 2)
                
                lambda 
                    (set-svar num-runs-played (+ 1 (get-svar num-runs-played)))
                
                lambda 
                    (log-event "run-complete" (get-svar num-runs-played-since-last-complete) (dc:format "failed-attemps: %d, rogue-seed: %u" (get-svar num-runs-played-since-last-complete) (rogue-get-primary-seed)) 0 0)
                
                lambda 
                    (set-svar num-runs-played-since-last-complete 0)
                
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EM: 	resetting run values...") 19)
                    
                
                lambda 
                    (set-boolean generated-run? 0 self)
                
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EM: 	sending player back to hub...") 19)
                    
                
                lambda 
                    (rogue-set-run-active 0)
                
                lambda 
                    (broadcast-event rogue-run-complete)
                
                lambda 
                    (go wait-for-post-flow-run-complete 1)
                
            }
        }
    }
    state encounter-fail {
        block start {
            track main {
                lambda 
                    (request-suppress-moths)
                
                lambda 
                    (if (get-boolean run-abandoned self)) 
                        (set-boolean run-abandoned 0 self)
                        (send-event game-over-displayed self)
                    
                
            }
        }
        block event game-over-displayed {
            track main {
                lambda 
                    (log-run-progression-focus-test-debug-only! 1)
                
                lambda 
                    (set-svar num-runs-played (+ 1 (get-svar num-runs-played)))
                
                lambda 
                    (set-svar num-runs-played-since-last-complete (+ 1 (get-svar num-runs-played-since-last-complete)))
                
                lambda 
                    (log-event "run-failed" (get-svar num-runs-played-since-last-complete) (dc:format "failed-attemps: %d, rogue-seed: %u" (get-svar num-runs-played-since-last-complete) (rogue-get-primary-seed)) 0 0)
                
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EM: 	resetting run values...") 19)
                    
                
                lambda 
                    (set-boolean generated-run? 0 self)
                
                lambda 
                    (set-boolean encounter-success 0 self)
                
                lambda 
                    (broadcast-event rogue-run-failed)
                
                lambda 
                    (go wait-for-post-flow-run-complete 1)
                
            }
        }
    }
    state encounter-fail-debug {
        block start {
            track main {
                lambda 
                    (speak-text-to-speech-formatted (new-boxed-value 7 ENCOUNTER_MISSION_FAILED) 1 0 1)
                
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EM: 	resetting run values...") 19)
                    
                
                lambda 
                    (set-boolean generated-run? 0 self)
                
                lambda 
                    (set-boolean encounter-success 0 self)
                
                lambda 
                    (broadcast-event rogue-run-failed)
                
                lambda 
                    (go wait-for-post-flow-run-complete 1)
                
            }
        }
    }
    state wait-for-post-flow-run-complete {
        block start {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EM: 	Waiting for post flow") 19)
                    
                
            }
        }
        block event post-flow-complete {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EM: 	Post flow complete") 19)
                    
                
                lambda 
                    (go back-to-character-select 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (hud2-hide-health-ammo/f 0 0)
                
            }
        }
    }
    state wait-for-post-flow-encounter-complete {
        block start {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EM: 	Waiting for post flow respite") 19)
                    
                
            }
        }
        block event post-flow-complete {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EM: 	Respite post flow complete") 19)
                    
                
                lambda 
                    (encounter--on-end (get-boolean encounter-success self))
                
                lambda 
                    (task-play-rogue (rogue-get-hub-node) (rogue-get-hub-subnode) 1 0 0.00)
                
                lambda 
                    (go respite 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (hud2-hide-health-ammo/f 0 0)
                
            }
        }
    }
    state back-to-character-select {
        block start {
            track main {
                lambda 
                    (if (not (is-final-build?))) 
                        (display (dc:format "DEB-EM: 	sending player back to character select...") 19)
                    
                
                lambda 
                    (log-event "run-duration" (cast i32 (time-elapsed (get-float run-start-time self))) "" 0 0)
                
                lambda 
                    (encounter--on-end (get-boolean encounter-success self))
                
                lambda 
                    (rogue-run-complete (get-boolean encounter-success self))
                
                lambda 
                    (play-music-stinger *music-playlist-t2r-rogue-hub-silence* 0)
                
                lambda 
                    (task-play-rogue main-menu menu 0 0 0.00)
                
                lambda 
                    (go generate-run 1)
                
            }
        }
    }
}
