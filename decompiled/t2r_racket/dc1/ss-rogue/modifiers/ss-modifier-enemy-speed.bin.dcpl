(define (ss-enemy-speed--restore-enemy-speed arg_0 arg_1) 
    (if (not (is-final-build?))) 
        (display (dc:format "DEB-SK: [%s] restoring movement speed scale..." (string-debug arg_1)) 19)
    
    (npc-set-movement-speed-scale arg_1 1.00)
    (darray-find-remove arg_0 (new-boxed-value 7 arg_1) 0)
)

(define (ss-enemy-speed--modify-enemy-speed arg_0 arg_1 arg_2) 
    (if (not (is-final-build?))) 
        (display (dc:format "DEB-SK: [%s] modifying movement speed scale..." (string-debug arg_1)) 19)
    
    (if (not (is-final-build?))) 
        (display (dc:format "DEB-SK: 	Movement speed changed to %f." arg_2) 19)
    
    (npc-set-movement-speed-scale arg_1 arg_2)
    (darray-append arg_0 (new-boxed-value 7 arg_1) 1)
)

