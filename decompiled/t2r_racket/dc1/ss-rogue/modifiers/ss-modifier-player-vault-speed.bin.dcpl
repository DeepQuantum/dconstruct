(define (debug-dump-progress-bar arg_0) 
    (define var_1)
    (for ([ i (in-range 50)]) 
        (define var_2)
        (if (<= i (cast i32 (floor-float (* 50.00 arg_0))))) 
            (set! var_2 "+")
         else 
            (set! var_2 " ")
        
        (set! var_1 (dc:format "%s%s" "DEB-SK: [" var_2))
    )
    (define var_6)
    (if (not (is-final-build?))) 
        (set! var_6 (display (dc:format (dc:format "%s%s" var_1 "]")) 19))
     else 
        (set! var_6 0)
    
    var_6
)

statescript {
    options {
        player
    }
    declarations {
        bool boost-speed? = nullptr
        f32 crouch-speed-increase-multiplier = 1.40
        f32 run-speed-increase-multiplier = 1.15
        f32 sprint-speed-increase-multiplier = 1.10
        f32 speed-bonus-time = 8.00
        f32 skull-active-time = -1.00
    }
    state off {
        block event turn-on {
            track main {
                lambda 
                    (go on 1)
                
            }
        }
    }
    state on {
        block event player-vault-start {
            track main {
                lambda 
                    (wait 0.25)
                
                lambda 
                    (set-float skull-active-time (get-current-time 0) self)
                
                lambda 
                    (broadcast-event skull-activate (new-boxed-value 7 player-vault-speed))
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (>= (get-float skull-active-time self) 0.00)) 
                        (if (< (time-elapsed (get-float skull-active-time self)) (get-float speed-bonus-time self))) 
                            (player-set-motion-match-crouch-speed-multiplier/f (get-float crouch-speed-increase-multiplier self))
                            (player-set-motion-match-run-speed-multiplier/f (get-float run-speed-increase-multiplier self))
                            (player-set-motion-match-sprint-speed-multiplier/f (get-float sprint-speed-increase-multiplier self))
                            (if (player-is-sprinting? 1)) 
                                (override-render-settings *zgame-player-modifier-speed-boost* 0.80 0.80 0 32767 0 1 0 1.00)
                            
                            (hud-skulls-set-percent player-vault-speed (- 1.00 (/ (time-elapsed (get-float skull-active-time self)) (get-float speed-bonus-time self))) 0)
                         else 
                            (broadcast-event skull-deactivate (new-boxed-value 7 player-vault-speed))
                            (hud-skulls-set-percent player-vault-speed 0.00 0)
                            (set-float skull-active-time -1.00 self)
                        
                    
                
            }
        }
    }
}
