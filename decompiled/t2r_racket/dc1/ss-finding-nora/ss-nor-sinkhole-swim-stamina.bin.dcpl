(define (player-use-breath--ski arg_0) 
    (swim-set-breath-meter (- (swim-get-breath-meter) arg_0))
)

statescript {
    declarations {
        f32 SWIM-DURATION = 12.00
        f32 FLOAT-DURATION = 30.00
        f32 STAMINA-COST = 35.00
        f32 TOTAL-STAMINA = 80.00
    }
    state initial {
        block start {
            track main {
                lambda 
                    (if (task-range-active? find-nora nor-sewers-choppy-water find-nora nor-sewers-bash-door-exit)) 
                        (go stamina-think 1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-range-active? find-nora nor-sewers-choppy-water find-nora nor-sewers-bash-door-exit)) 
                        (go stamina-think 1)
                    
                
            }
        }
    }
    state stamina-think {
        block update {
            track main {
                lambda 
                    (if (character-is-swimming? player)) 
                        (if (> (get-joypad-stick-intensity move 0.20 1.00) 0.30)) 
                            (player-use-breath--ski (* (/ (/ (get-float STAMINA-COST self) (get-float TOTAL-STAMINA self)) (get-float SWIM-DURATION self)) (get-delta-time)))
                         else 
                            (player-use-breath--ski (* (/ (/ (get-float STAMINA-COST self) (get-float TOTAL-STAMINA self)) (get-float FLOAT-DURATION self)) (get-delta-time)))
                        
                    
                
            }
        }
    }
}
