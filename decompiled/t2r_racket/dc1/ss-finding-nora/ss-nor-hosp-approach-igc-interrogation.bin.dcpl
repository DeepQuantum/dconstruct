                lambda 
                    (listen-mode-visible npc-nor-hosp-approach-igc-interrogation-1 0 1 -1.00)
                
                lambda 
                    (animate-done npc-nor-hosp-approach-igc-interrogation-1 female=cin-nor-hospital-approach-interrogation=010 cin-nor-hospital-approach-interrogation-1 0 0 2)
                
                lambda 
                    (stop-animating npc-nor-hosp-approach-igc-interrogation-1 2 0.50 0 0)
                
                lambda 
                    (npc-die npc-nor-hosp-approach-igc-interrogation-1 0 0 0 1)
                
                lambda 
                    (animate-done obj-nor-hosp-approach-interrogation-psp-1 sony-ps-vita=cin-nor-hospital-approach-interrogation=010 cin-nor-hospital-approach-interrogation-1 0 0 2)
                
                lambda 
                    (let loop () (when (not (object-spawned? obj-nor-hosp-approach-interrogation-psp-1)) 
                        (wait 0.10)
                     (loop)))
                
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (set-collision-layer obj-nor-hosp-approach-interrogation-psp-1 small 0)
                
                lambda 
                    (set-uint64 psvita-texture (spawn-particles-at-joint hotline-game-screen obj-nor-hosp-approach-interrogation-psp-1 screen 0 16 root 2 (alloc-vector 0.00 0.00 0.00 1.00 0) 2 (alloc-vector 0.00 0.00 0.00 1.00 0)) self)
                
                lambda 
                    (set-effect-float (get-uint64 psvita-texture self) gameOver 1.00)
                
                lambda 
                    (wait 1.00)
                
                lambda 
                    (listen-mode-visible obj-nor-hosp-approach-interrogation-psp-1 1 1 -1.00)
                
                lambda 
                    (listen-mode-add-reveal obj-nor-hosp-approach-interrogation-psp-1 obj-nor-hosp-approach-interrogation-psp-1 (get-object-locator obj-nor-hosp-approach-interrogation-psp-1) 10.00 100000.00 0.00 0.50 0 0 0 0)
                
            }
            track lerp {
                lambda 
                    (define var_0 (get-current-time 0))
                    (let loop () (when (not (>= (- (get-current-time 0) var_0) 10.00)) 
                        (set-table-shader-material-values-param *whitney-desaturate* (curve-scale 0.00 10.00 0.00 1.00 (- (get-current-time 0) var_0) 2))
                        (wait-one-frame)
                     (loop)))
                    (set-table-shader-material-values-param *whitney-desaturate* 1.00)
                
            }
        }
        block update {
            track main {
                lambda 
                    (camera-set-overlay *camera-remap-close*)
                
                lambda 
                    (set-walk-type walk-uneasy)
                
                lambda 
                    (set-run-type run-uneasy)
                
            }
        }
    }
    state task-complete {
        block start {
            track main {
                lambda 
                    (animate-done npc-nor-hosp-approach-igc-interrogation-1 female=cin-nor-hospital-approach-interrogation=010 cin-nor-hospital-approach-interrogation-1 0 0 2)
                
                lambda 
                    (stop-animating npc-nor-hosp-approach-igc-interrogation-1 2 0.50 0 0)
                
                lambda 
