                    (let loop () (when (not (>= (- (get-current-time 0) var_0) 10.00)) 
                        (set-table-shader-material-values-param *whitney-desaturate* (curve-scale 0.00 10.00 0.00 1.00 (- (get-current-time 0) var_0) 2))
                        (wait-one-frame)
                     (loop)))
                    (set-table-shader-material-values-param *whitney-desaturate* 1.00)
                
