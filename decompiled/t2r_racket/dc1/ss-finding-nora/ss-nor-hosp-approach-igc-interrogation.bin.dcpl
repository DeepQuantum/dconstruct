                        (set-int32 struggle-haptic-pid (play-hfx-id human-struggle-baseline-haptic 0 2) self)
                        (let loop () (when (not (>= (cinematic-get-current-frame 0) 775.00)) 
                            (hfx-set-gain-scale (get-int32 struggle-haptic-pid self) 2.00)
                            (hfx-continue (get-int32 struggle-haptic-pid self))
                            (wait-one-frame)
                         (loop)))
                        (wait-until-cin-frame 780.00 0)
                        (play-hfx-id stab-generic 0 2)
                        (wait-until-cin-frame 863.00 0)
                        (play-hfx-id res-find-bow-grab-right 0 2)
                        (wait-until-cin-frame 1046.00 0)
                        (play-hfx-id touch-soft-right 0 2)
                        (wait-until-cin-frame 1059.00 0)
                        (play-hfx-id touch-soft-right 0 2)
                        (wait-until-cin-frame 1070.00 0)
                        (play-hfx-id touch-soft-right 0 2)
                    
                
            }
            track uw-fix {
                lambda 
                    (if (and (is-ultrawide?) (uw-mode-is-minimal?))) 
                        (wait-until-cin-frame 720.00 0)
                        (set-effect-alpha (get-uint64 psvita-texture self) 0.00)
                        (wait-until-cin-frame 1050.00 0)
                        (set-effect-alpha (get-uint64 psvita-texture self) 1.00)
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (set-tension-mode 1)
                
                lambda 
                    (set-walk-type walk-uneasy)
                
                lambda 
                    (set-run-type run-uneasy)
                
                lambda 
                    (camera-set-overlay *camera-remap-close*)
                
                lambda 
                    (disable-follow-camera-collision)
                
                lambda 
                    (if (> (cinematic-get-current-frame cin-nor-hospital-approach-interrogation) 781.00)) 
                        (set-single-shader-instance-param (get-player-weapon-process-id-from-weapon-id switchblade) blendOffset1 1.00)
                        (set-melee-weapon-blood-blend (get-player-weapon-process-id-from-weapon-id switchblade) 1.00)
                        (set-shader-instance-blend-offset (get-player-weapon-process-id-from-weapon-id switchblade) 1.00 1)
                    
                
            }
        }
        block end {
            track main {
                lambda 
                    (set-visible (player-get-weapon-instance 2) 1)
                
            }
        }
    }
    state anim-done {
        block start {
            track main {
                lambda 
                    (if (not (entity-exists? npc-nor-hosp-approach-igc-interrogation-1))) 
                        (spawn-entity npc-nor-hosp-approach-igc-interrogation-1 0 0)
                        (npc-set-script-only-no-perception npc-nor-hosp-approach-igc-interrogation-1)
                    
                
                lambda 
