                        (set! var_2 0)
                    
                    (detach-without-physicalizing var_2 0.00)
                
                lambda 
                    (define var_1 (ddict-get spawned-weapons-by-id (get-symbol currently-animating-weapon self)))
                    (define var_2)
                    (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 7))) 
                        (set! var_2 (deref (cast u64* var_1)))
                     else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 5))) 
                        (set! var_2 (deref (cast u64* var_1)))
                     else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                        (set! var_2 (deref (cast u64* var_1)))
                     else 
                        (set! var_2 0)
                    
                    (set-visible var_2 0)
                
                lambda 
                    (ss-workbench-fake--clear-all-spawned-weapons)
                
                lambda 
                    (ddict-clear spawned-weapons-by-id)
                
            }
        }
    }
}
