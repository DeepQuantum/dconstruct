            track main {
                lambda 
                    (if (object-anim-playing? npc-nor-scar-brute-1 nor-scar-forest-brute-reveal-enter--brute 0)) 
                        (stop-animating npc-nor-scar-brute-1 2 0.00 nor-scar-forest-brute-reveal-enter--brute 0)
                    
                
            }
        }
        block event unzone-back-room {
            track main {
                lambda 
                    (if (npc-alive? npc-nor-scar-intro-1)) 
                        (npc-clear-hard-point npc-nor-scar-intro-1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-complete? find-nora nor-scar-forest-combat)) 
                        (go cleanup 1)
                    
                
            }
        }
    }
    state combat-done {
        block start {
            track main {
                lambda 
                    (set-svar-as-boolean nor-forest-brute-intro-started 1)
                
                lambda 
                    (set-svar-as-boolean nor-forest-brute-intro-done 1)
                
                lambda 
                    (set-hardpoint-disabled hard-point-glt-stripmall-1)
                
                lambda 
                    (let loop () (when (not (can-set-combat-checkpoints?)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (set-combat-checkpoint find-nora nor-scar-forest-combat brute-combat-done 0 0)
                
                lambda 
                    (enable-combat-checkpoints find-nora nor-scar-forest-combat)
                
                lambda 
                    (disable-nav-blocker-object nav-blocker-rect-nor-scar-brute-door-1)
                
                lambda 
                    (task-set-active-continue! brute-combat-done 1 0 0 0.00 0 0)
                
                lambda 
                    (play-music-stinger *music-playlist-nor-scar-forest-combat-brute-end* 0)
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-complete? find-nora nor-scar-forest-combat)) 
                        (go cleanup 1)
                    
                
            }
        }
    }
    state cleanup {
        block start {
            track main {
                lambda 
                    (kill-entity-if-spawned npc-nor-scar-brute-1)
                
                lambda 
                    (kill-entity-if-spawned npc-nor-scar-intro-1)
                
                lambda 
                    (kill-entity-if-spawned npc-nor-scar-intro-2)
                
                lambda 
                    (set-hardpoint-disabled hard-point-glt-stripmall-1)
                
                lambda 
                    (go done 1)
                
            }
        }
    }
}
