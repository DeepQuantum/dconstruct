                        (nor-squeeze-past-infected-through-with-stick (get-animation-frame player 2 nor-sewers-pass-infected-struggle-1--ellie))
                        (set-animation-speed player (get-float anim-speed self) 0 0)
                        (set-animation-speed obj-dummy-camera-ptsd-1 (get-float anim-speed self) 0 0)
                        (if (get-boolean one-frame-happened? self)) 
                            (if (== (get-float target-speed self) 1.00)) 
                                (set-float hud-timer (get-current-time 0) self)
                                (set-character-ik-mode-override player 1 1.00)
                             else 
                                (player-force-enable-breathing)
                                (set-character-ik-mode-override player 2 1.00)
                                (if (time-passed-limit? (get-float hud-timer self) (get-float show-hud-time self) 0)) 
                                    (draw-joypad-command move (offset-locator (camera-locator 0) (alloc-vector -0.10 -0.04 1.00 1.00 0)) 0)
                                
                            
                        
                    
                
                lambda 
