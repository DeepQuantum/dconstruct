                        (set-float target-speed 1.00 self)
                        (var-approach-target-per-second anim-speed (get-float target-speed self) 0.90 0.00 1.00)
                        (set-animation-speed player (get-float anim-speed self) 0 0)
                        (set-animation-speed obj-dummy-camera-ptsd-1 (get-float anim-speed self) 0 0)
                    
                
