                            (go end-idle 1)
                         else 
                            (go post-spline-animations 1)
                        
                    
                
            }
            track check-speed-increase {
                lambda 
                    (if (and (tag-boolean is-simple-npc? self) (tag-specified? run-overlay self))) 
                        (let loop () (when (and (get-boolean activated-with-weapon? self) (not (object-within-distance-to-object? player (get-self-id) (tag-float run-dist self) 1))) 
                            (if (!= 0.00 0.10)) 
                                (wait 0.10)
                             else 
                                (wait-one-frame)
                            
                         (loop)))
                        (simple-npc-set-anim-overlay (get-self-id) (tag-string run-overlay self 0 0) "locomotion" 1 0)
                    
                
                lambda 
                    (if (and (tag-boolean is-simple-npc? self) (tag-specified? sprint-overlay self))) 
                        (let loop () (when (and (get-boolean activated-with-weapon? self) (not (object-within-distance-to-object? player (get-self-id) (tag-float sprint-dist self) 1))) 
                            (if (!= 0.00 0.10)) 
                                (wait 0.10)
                             else 
                                (wait-one-frame)
                            
                         (loop)))
                        (simple-npc-set-anim-overlay (get-self-id) (tag-string sprint-overlay self 0 0) "locomotion" 1 0)
                    
                
            }
        }
        block event reached-spline-end {
            track main {
                lambda 
                    (if (tag-specified? end-idle self)) 
                        (go end-idle 1)
                     else (if (tag-boolean kill-at-end? self)) 
                        (go kill-self 1)
                     else 
                        (go complete 1)
                    
                
            }
        }
        block event simple-npc-reached-goal {
            track main {
                lambda 
                    (if (tag-specified? end-idle self)) 
                        (go end-idle 1)
                     else (if (tag-boolean kill-at-end? self)) 
                        (go kill-self 1)
                     else 
                        (go complete 1)
                    
                
            }
        }
        block event player-fired-weapon {
            track main {
                lambda 
                    (if (and (not (get-boolean activated-with-weapon? self)) (object-within-distance-to-object? player (get-self-id) (tag-float activate-when-firing-radius self) 1))) 
                        (set-boolean activated-with-weapon? 1 self)
                    
                
            }
        }
        block event npc-fired-weapon {
            track main {
                lambda 
                    (if (and (not (get-boolean activated-with-weapon? self)) (object-within-distance-to-object? (get-self-id) (event-arg-symbol 0) (tag-float activate-when-firing-radius self) 1))) 
                        (set-boolean activated-with-weapon? 1 self)
                    
                
            }
        }
        block event grenade-exploded {
            track main {
                lambda 
                    (if (and (not (get-boolean activated-with-weapon? self)) (locator-within-distance-to-object? (event-arg-bound-frame 0) (get-self-id) (* (tag-float activate-if-bullet-hits-within-radius self) 2.00) 1))) 
                        (set-boolean activated-with-weapon? 1 self)
                    
                
            }
        }
        block event bullet-hit-position {
            track main {
                lambda 
                    (if (and (not (get-boolean activated-with-weapon? self)) (locator-within-distance-to-object? (event-arg-bound-frame 0) (get-self-id) (tag-float activate-if-bullet-hits-within-radius self) 1))) 
                        (set-boolean activated-with-weapon? 1 self)
                    
                
            }
        }
    }
    state post-spline-animations {
        block start {
            track main {
                lambda 
                    (if (tag-specified? end-idle self)) 
                        (go end-idle 1)
                     else (if (tag-boolean kill-at-end? self)) 
                        (go kill-self 1)
                     else 
                        (go complete 1)
                    
                
            }
        }
    }
    state end-idle {
        block start {
            track main {
                lambda 
                    (if (== (get-symbol post-spline-animations self) 0)) 
                        (define var_4)
                        (if (tag-specified? custom-ap-ref-spawner-end-idle self)) 
                            (set! var_4 (get-object-or-spawner-locator (tag-symbol custom-ap-ref-spawner-end-idle self)))
                         else 
                            (set! var_4 (get-object-locator (get-self-id)))
                        
                        (wait-simple-npc-move-to-entry-frame (get-self-id) (tag-symbol end-idle self) var_4 2 1 -1.00 0)
                    
                
                lambda 
                    (define var_2 (#%alloc-array single-frame 16 2 1))
                    (set! (deref (cast i32* (deref (+ (deref var_2) (* 0 8))))) 10)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_2) (* 0 8))) 8))) 0)
                    (define var_4)
                    (if (tag-specified? custom-ap-ref-spawner-end-idle self)) 
                        (set! var_4 (get-object-or-spawner-locator (tag-symbol custom-ap-ref-spawner-end-idle self)))
                     else 
                        (set! var_4 (get-object-locator (get-self-id)))
                    
                    (set! (deref (cast u64* (+ (deref (+ (deref var_2) (* 0 8))) 8))) var_4)
                    (set! (deref (cast i32* (deref (+ (deref var_2) (* 1 8))))) 28)
                    (set! (deref (cast u64* (+ (deref (+ (deref var_2) (* 1 8))) 8))) 0)
                    (set! (deref (cast f32* (+ (deref (+ (deref var_2) (* 1 8))) 8))) 0.20)
                    (animate_ (get-self-id) (tag-symbol end-idle self) var_2)
                
                lambda 
                    (if (tag-boolean kill-at-end? self)) 
                        (go kill-self 1)
                     else 
                        (go complete 1)
                    
                
            }
        }
    }
    state kill-self {
        block start {
            track main {
                lambda 
                    (kill-entity (get-self-id))
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
