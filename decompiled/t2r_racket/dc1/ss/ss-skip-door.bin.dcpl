statescript {
    options {
        player
    }
    declarations {
        bool allow-skip = nullptr
    }
    state initial {
        block start {
            track main {
                lambda 
                    (if (and (== (tag-symbol door-to-bypass self) 0) (== (tag-symbol pos-to-telepor self) 0))) 
                        (define var_2 (dc:format "Door and/or Teleport position not specified"))
                        (display var_2 8)
                        (display-error var_2)
                    
                
            }
        }
        block event player-requested-interact {
            track main {
                lambda 
                    (set-boolean allow-skip 1 self)
                
            }
        }
        block event door-opened {
            track main {
                lambda 
                    (set-boolean allow-skip 0 self)
                
            }
        }
        block event puzzle-skipped {
            track main {
                lambda 
                    (teleport-character player (tag-symbol pos-to-teleport self))
                
            }
        }
        block event inside {
            track main {
                lambda 
                    (if (get-boolean allow-skip self)) 
                        (notify-skippable-puzzle (get-self-id) 1)
                    
                
            }
        }
    }
}
