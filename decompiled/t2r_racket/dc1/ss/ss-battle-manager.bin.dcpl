                                    (set! var_12 (darray-append (get-symbol schema-group self) (new-boxed-value 7 (tag-symbol var_10 self)) 1))
                                
                                (set! i (+ i 1))
                             (loop)))
                        
                        (if (not (>= (get-int32 min-spawn self) 0))) 
                            (net-set-int32 min-spawn (tag-int32 min-spawn self) self)
                        
                        (if (not (>= (get-int32 max-spawn self) 0))) 
                            (net-set-int32 max-spawn (tag-int32 max-spawn self) self)
                        
                        (if (not (>= (get-float min-inter-wave-spawn-delay self) 0.00))) 
                            (net-set-float min-inter-wave-spawn-delay (tag-float min-inter-wave-spawn-delay self) self)
                        
                        (if (not (>= (get-float max-inter-wave-spawn-delay self) 0.00))) 
                            (net-set-float max-inter-wave-spawn-delay (tag-float max-inter-wave-spawn-delay self) self)
                        
                        (net-set-int32 alive-count (darray-count (get-symbol npc-group self)) self)
                        (net-set-int32 spawn-count (darray-count (get-symbol npc-group self)) self)
                        (if (not (>= (get-int32 to-spawn-count self) 0))) 
                            (net-set-int32 to-spawn-count (tag-int32 to-spawn-count self) self)
                        
                        (if (not (>= (get-float min-init-spawn-delay self) 0.00))) 
                            (net-set-float min-init-spawn-delay (tag-float min-init-spawn-delay self) self)
                        
                        (if (not (>= (get-float max-init-spawn-delay self) 0.00))) 
                            (net-set-float max-init-spawn-delay (tag-float max-init-spawn-delay self) self)
                        
                        (net-set-boolean active 1 self)
                        (if (tag-exists? ini-group self)) 
                            (set-symbol var-ini-group (tag-symbol ini-group self) self)
                        
                        (if (not (== (get-symbol var-ini-group self) 0))) 
                            (net-set-boolean ini-group-done 0 self)
                            (for ([var_41 (get-symbol var-ini-group self)]) 
                                (define var_42)
                                (if (and var_41 (== (deref (cast u16* (+ var_41 12))) 7))) 
                                    (set! var_42 (deref (cast u64* var_41)))
                                 else (if (and var_41 (== (deref (cast u16* (+ var_41 12))) 5))) 
                                    (set! var_42 (deref (cast u64* var_41)))
                                 else (if (and var_41 (== (deref (cast u16* (+ var_41 12))) 4))) 
                                    (set! var_42 (deref (cast u64* var_41)))
                                 else 
                                    (set! var_42 0)
                                
                                (define var_43 (spawn-npc var_42 0 0))
                                (setup-bm-npc var_43 0)
                                (if (not (== (get-symbol ini-group-zone-override self) 0))) 
                                    (npc-set-zone-region var_43 (get-symbol ini-group-zone-override self))
                                    (if (== (tag-int32 use-zone-locking self) 1)) 
                                        (npc-lock-to-zone var_43)
                                    
                                
                                (if (== (tag-int32 tutorial self) 1)) 
                                    (update-npc-awareness)
                                
                                (++ ini-group-total self)
                            )
                            (net-set-boolean ini-group-done 1 self)
                        
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (net-is-host?)) 
                        (if (get-boolean ini-group-done self)) 
                            (if (and (>= (get-int32 spawn-count self) (get-int32 to-spawn-count self)) (not (== (get-int32 to-spawn-count self) -1)))) 
                                (net-go done)
                             else (if (should-spawn?)) 
                                (go spawn 1)
                            
                        
                    
                
            }
        }
    }
    state spawn {
        block start {
            track main {
                lambda 
                    (if (and (not (== (get-float min-init-spawn-delay self) 0.00)) (not (get-boolean first-spawn? self)))) 
                        (set-boolean first-spawn? 1 self)
                        (wait (random-float-min-max (get-float min-init-spawn-delay self) (get-float max-init-spawn-delay self) 0))
                     else 
                        (wait (random-float-min-max (get-float min-inter-wave-spawn-delay self) (get-float max-inter-wave-spawn-delay self) 0))
                    
                
                lambda 
                    (define i 0)
                    (let loop () (when (< i (random-int32-min-max (get-int32 min-spawn self) (get-int32 max-spawn self) 0)) 
                        (if (and (should-spawn?) (net-is-host?))) 
                            (define var_7)
                            (if (> (darray-count (get-symbol schema-group self)) 0)) 
                                (set! var_7 (get-best-schema-spawner))
                             else 
                                (set! var_7 (select-best-schema-spawner self (get-int32 schema-count self)))
                            
                            (if (not var_7)) 
                                (define var_14 (dc:format "battle-manager '%s' couldn't select schema spawner " (string-debug (get-object-id self))))
                                (display var_14 8)
                                (display-error var_14)
                                (go error 1)
                             else 
                                (define var_17)
                                (if (not (== (get-symbol npc-group-leader self) 0))) 
                                    (set! var_17 (get-spawner-near-leader (get-symbol spawner-group self) -1.00))
                                 else (if (net-is-gametype? 6)) 
                                    (if (== (get-self-id) bm-team0-1)) 
                                        (set! var_17 (get-closest-spawner-in-group-to-locator (get-symbol spawner-group self) (net-calculate-best-respawn-point-for-team 0)))
                                     else (if (== (get-self-id) bm-team1-1)) 
                                        (set! var_17 (get-closest-spawner-in-group-to-locator (get-symbol spawner-group self) (net-calculate-best-respawn-point-for-team 1)))
                                     else 
                                        (define var_32)
                                        (if (not (== (tag-symbol axis-spline self) 0))) 
                                            (set! var_32 (tag-symbol axis-spline self))
                                         else 
                                            (set! var_32 0)
                                        
                                        (set! var_17 (battle-select-best-spawner-from-group var_7 (get-symbol spawner-group self) (tag-float spawn-distance self) var_32 (tag-int32 spawn-out-of-frustum self)))
                                    
                                 else 
                                    (define var_39)
                                    (if (not (== (tag-symbol axis-spline self) 0))) 
                                        (set! var_39 (tag-symbol axis-spline self))
                                     else 
                                        (set! var_39 0)
                                    
                                    (set! var_17 (battle-select-best-spawner-from-group var_7 (get-symbol spawner-group self) (tag-float spawn-distance self) var_39 (tag-int32 spawn-out-of-frustum self)))
                                
                                (setup-bm-npc (spawn-npc (entity-name var_7) var_17 0) var_17)
                            
                            (if (== (get-int32 alive-count self) (get-int32 min-keep-alive-count self))) 
                                (set-boolean fill 1 self)
                             else (if (== (get-int32 alive-count self) (get-int32 max-keep-alive-count self))) 
                                (set-boolean fill 0 self)
                            
                            (if (and (>= (get-int32 spawn-count self) (get-int32 to-spawn-count self)) (not (== (get-int32 to-spawn-count self) -1)))) 
                                (net-go done)
                            
                        
                        (wait (random-float-min-max (tag-float min-inter-spawn-delay self) (tag-float max-inter-spawn-delay self) 0))
                        (set! i (+ i 1))
                     (loop)))
                
                lambda 
                    (if (== (tag-int32 tutorial self) 1)) 
                        (update-npc-awareness)
                    
                
                lambda 
                    (go pause 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (update-leader-zoning)
                
            }
        }
    }
    state pause {
        block start {
            track main {
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (if (should-spawn?)) 
                        (go spawn 1)
                     else 
                        (net-go wait)
                    
                
            }
        }
    }
    state freeze {
        block  {
        }
        block event unfreeze-bm {
            track main {
                lambda 
                    (go pause 1)
                
            }
        }
    }
    state wait {
        block update {
            track main {
                lambda 
                    (update-leader-zoning)
                
                lambda 
                    (if (should-spawn?)) 
                        (go spawn 1)
                     else (if (and (>= (get-int32 spawn-count self) (get-int32 to-spawn-count self)) (not (== (get-int32 to-spawn-count self) -1)))) 
                        (net-go done)
                    
                
            }
        }
    }
    state error {
        block event is-active? {
            track main {
                lambda 
                    (event-return-boolean 0)
                
            }
        }
    }
    state done {
        block start {
            track main {
                lambda 
                    (if (net-is-host?)) 
                        (if (tag-boolean go-to-pending-after-all-dead self)) 
                            (let loop () (when (not (<= (get-int32 alive-count self) 0)) 
                                (wait-one-frame)
                             (loop)))
                            (if (not (== (tag-symbol completion-reward self) none))) 
                                (net-spawn-entity-at (tag-symbol completion-reward self) (get-object-locator (get-symbol last-dead-npc self)) 0 0 0 0)
                            
                            (broadcast-event battle-manager-finished (new-boxed-value 7 (get-self-id)))
                            (wait 3.00)
                            (net-go pending-activation)
                         else 
                            (net-go pending-activation)
                        
                    
                
            }
        }
        block event is-active? {
            track main {
                lambda 
                    (event-return-boolean (> (get-int32 alive-count self) 0))
                
            }
        }
    }
}
