                        (wait-one-frame)
                    )
                
                lambda 
                    (send-event wave-4 ss-vox-efp-motel-lobby-fight-1)
                
                lambda 
                    (wait-one-frame)
                
                lambda 
                    (go wave-4 1)
                
            }
        }
    }
    state wave-4 {
        block start {
            track main {
                lambda 
                    (set-accessibility-pathfind-unavailable)
                
            }
            track sound {
                lambda 
