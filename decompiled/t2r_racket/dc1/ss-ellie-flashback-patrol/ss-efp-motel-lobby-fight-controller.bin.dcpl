                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else 
                            (set! var_2 0)
                        
                        (if (npc-alive? var_2)) 
                            (npc-make-aware-of var_2 player 2 0)
                            (npc-make-aware-of var_2 joel 2 0)
                        
                    )
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (if (<= (npc-group-alive-count lobby-fight-all-infected) 1)) 
                        (go spawn-wave-4 1)
                    
                
            }
        }
    }
