                                (set! var_6 (deref (cast u64* var_5)))
                             else 
                                (set! var_6 0)
                            
                            (if (! (object-on-screen-and-visible? var_6 -1 0))) 
                                (define var_10)
                                (if (and var_9 (== (deref (cast u16* (+ var_9 12))) 7))) 
                                    (set! var_10 (deref (cast u64* var_9)))
                                 else (if (and var_9 (== (deref (cast u16* (+ var_9 12))) 5))) 
                                    (set! var_10 (deref (cast u64* var_9)))
                                 else (if (and var_9 (== (deref (cast u16* (+ var_9 12))) 4))) 
                                    (set! var_10 (deref (cast u64* var_9)))
                                 else 
                                    (set! var_10 0)
                                
                                (spawn-entity-at var_2 (get-spawner-locator var_10 1) 0)
                             else 
