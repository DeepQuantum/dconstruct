                        (if (<= (get-difficulty-setting-enemies) 1)) 
                            (group-copy sle-tommy-fight-infected-reinforcements-final-easy sle-tommy-fight-infected-reinforcements-final)
                         else 
                            (group-copy sle-tommy-fight-infected-reinforcements-final-normal sle-tommy-fight-infected-reinforcements-final)
                        
                        (wait-spawn-npc-group-async sle-tommy-fight-infected-reinforcements-final 0 0)
                        (for ([var_3 sle-tommy-fight-infected-reinforcements-final]) 
                            (define var_4)
                            (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 7))) 
                                (set! var_4 (deref (cast u64* var_3)))
                             else (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 5))) 
                                (set! var_4 (deref (cast u64* var_3)))
                             else (if (and var_3 (== (deref (cast u16* (+ var_3 12))) 4))) 
                                (set! var_4 (deref (cast u64* var_3)))
                             else 
                                (set! var_4 0)
                            
                            (if (npc-alive? var_4)) 
                                (npc-make-aware-of var_4 player 2 0)
                                (say var_4 vox-eff-gen-inf-surprise-lrg 2 0)
                            
                        )
                    
                
                lambda 
                    (let loop () (when (not (== (npc-group-alive-count all-infected-npcs) 0)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (set-focusable-ignore npc-tommy-fight-1 0)
                
                lambda 
                    (go clean-up 1)
                
            }
            track progression {
                lambda 
                    (wait-boolean early-elevator-activation 1 self)
                
                lambda 
                    (go clean-up 1)
                
            }
            track ignore-tommy {
                lambda 
                    (sle-garage--manage-rules-of-engagement)
                
            }
        }
        block update {
            track main {
                lambda 
                    (disallow-invisible-while-prone/f)
                
                lambda 
                    (suppress-spot-player-stinger)
                
                lambda 
                    (for ([var_1 all-infected-npcs]) 
                        (define var_2)
                        (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 7))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 5))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else 
                            (set! var_2 0)
                        
                        (if (npc-alive? var_2)) 
                            (npc-suppress-threat-audio var_2)
                        
                    )
                
                lambda 
                    (disallow-normal-tension)
                
            }
        }
    }
    state clean-up {
        block start {
            track main {
                lambda 
                    (set-focusable-ignore npc-tommy-fight-1 0)
                
                lambda 
                    (task-complete! save-lev sle-tommy-sniper-through-building-infected)
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
