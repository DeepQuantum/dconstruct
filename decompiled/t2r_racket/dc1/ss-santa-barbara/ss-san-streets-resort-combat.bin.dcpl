                            (npc-set-script-low-priority var_2)
                        
                    )
                
            }
            track reinf {
                lambda 
                    (if (task-played-from-dev-menu?)) 
                        (set-svar-as-boolean san-streets-resort-lobby-reinf-spawned 0)
                        (set-svar-as-boolean san-streets-resort-lobby-reinf-disabled 0)
                    
                
                lambda 
                    (if (get-svar-as-boolean san-streets-resort-lobby-reinf-spawned)) 
                        (set-boolean spawn-lobby-reinf 1 self)
                    
                
                lambda 
                    (wait-boolean spawn-lobby-reinf 1 self)
                
                lambda 
                    (wait-spawn-npc-group-async san-resort-lobby-reinf 0 0)
                
                lambda 
                    (set-svar-as-boolean san-streets-resort-lobby-reinf-spawned 1)
                
                lambda 
                    (set-hardpoint-max-npcs hard-point-san-resort-lobby-2 2)
                
                lambda 
                    (set-hardpoint-max-npcs hard-point-san-resort-lobby-4 2)
                
                lambda 
                    (npc-clear-zone-if-alive npc-san-resort-lobby-front-3)
                
                lambda 
                    (npc-clear-zone-if-alive npc-san-resort-lobby-front-4)
                
                lambda 
                    (npc-set-zone-region-if-alive npc-san-resort-lobby-3 rgn-lobby-combat-back-zone-3)
                
                lambda 
                    (npc-set-zone-region-if-alive npc-san-resort-lobby-4 rgn-lobby-combat-back-zone-3)
                
                lambda 
                    (npc-set-zone-region-if-alive npc-san-resort-lobby-5 rgn-lobby-combat-back-zone-3)
                
                lambda 
                    (npc-set-zone-region-if-alive npc-san-resort-lobby-6 rgn-lobby-combat-back-zone-3)
                
            }
            track checkpoint {
                lambda 
                    (let loop () (when (not (can-set-combat-checkpoints?)) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (set-combat-checkpoint santa-barbara san-streets-resort resort-lobby 0 0)
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (if (darray-contains? san-resort-lobby-npcs (new-boxed-value 7 (event-arg-symbol 0)))) 
                        (if (and (and (is-combat-or-search?) (< (npc-group-alive-count san-resort-lobby-npcs) 7)) (not (get-svar-as-boolean san-streets-resort-lobby-reinf-disabled)))) 
                            (set-boolean spawn-lobby-reinf 1 self)
                        
                        (if (and (not (npc-alive? npc-san-resort-lobby-front-1)) (not (npc-alive? npc-san-resort-lobby-front-2)))) 
                            (npc-clear-zone-if-alive npc-san-resort-lobby-front-3)
                            (npc-clear-zone-if-alive npc-san-resort-lobby-front-4)
                        
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-complete? santa-barbara san-streets-resort)) 
                        (for ([var_2 san-resort-lobby-hard-points]) 
                            (define var_3)
                            (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 7))) 
                                (set! var_3 (deref (cast u64* var_2)))
                             else (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 5))) 
                                (set! var_3 (deref (cast u64* var_2)))
                             else (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 4))) 
                                (set! var_3 (deref (cast u64* var_2)))
                             else 
                                (set! var_3 0)
                            
                            (set-hardpoint-disabled var_3)
                        )
                        (go cleanup 1)
                    
                
            }
        }
        block event disallow-lobby-reinf {
            track main {
                lambda 
                    (set-svar-as-boolean san-streets-resort-lobby-reinf-disabled 1)
                
            }
        }
        block event enter {
            track main {
                lambda 
                    (set-boolean lobby-start 1 self)
                
            }
        }
    }
    state cleanup {
        block start {
            track main {
                lambda 
                    (group-kill-entity all-enemy-npcs 0)
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
