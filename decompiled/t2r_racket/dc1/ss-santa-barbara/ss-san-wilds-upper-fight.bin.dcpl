        block end {
            track main {
                lambda 
                    (interactable-enable workbench-64)
                
                lambda 
                    (interactable-set-unavailable workbench-64 0)
                
            }
        }
    }
    state mansion-done {
        block start {
            track spawn {
                lambda 
                    (if (and (task-continue-active? santa-barbara san-infected-wilds-upper-fight overlook) (not (task-continue-active? santa-barbara san-infected-wilds-upper-fight overlook-fight)))) 
                        (send-event turn-on hint-waypoint-san-upper-wilds-mansion-exit-1)
                    
                
                lambda 
                    (for ([var_1 san-wilds-upper-npcs]) 
                        (define var_2)
                        (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 7))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 5))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else 
                            (set! var_2 0)
                        
                        (if (npc-alive? var_2)) 
                            (if (npc-has-awareness? var_2 player 2)) 
                                (teleport-npc var_2 pos-upper-fight-infected-teleport-1)
                                (npc-make-aware-of var_2 player 2 0)
                             else 
                                (kill-entity var_2)
                            
                        
                    )
                
            }
            track checkpoint {
                lambda 
                    (if (and (task-continue-active? santa-barbara san-infected-wilds-upper-fight overlook) (not (task-continue-active? santa-barbara san-infected-wilds-upper-fight overlook-fight)))) 
                        (let loop () (when (not (can-set-combat-checkpoints?)) 
                            (wait-one-frame)
                         (loop)))
                        (set-combat-checkpoint santa-barbara san-infected-wilds-upper-fight mansion-done 0 0)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (go cleanup 1)
                
            }
        }
        block event hint-displayed {
            track main {
                lambda 
                    (camera-look-at-locator (get-spawner-locator hint-waypoint-san-upper-wilds-mansion-exit-1 1) 1.00 1.00)
                
            }
        }
    }
    state cleanup {
        block start {
            track main {
                lambda 
                    (send-event turn-off hint-waypoint-san-upper-wilds-mansion-exit-1)
                
                lambda 
                    (send-event turn-off hint-waypoint-enter-mansion-1)
                
                lambda 
                    (group-kill-entity san-wilds-upper-npcs 0)
                
                lambda 
                    (group-kill-entity san-wilds-mansion-npcs 0)
                
                lambda 
                    (go done 1)
                
            }
        }
    }
}
