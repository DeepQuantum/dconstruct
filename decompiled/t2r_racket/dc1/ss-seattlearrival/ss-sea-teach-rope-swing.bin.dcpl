    state do-tutorial {
        block start {
            track main {
                lambda 
                    (if (not (get-boolean tutorial-once self))) 
                        (let loop () (when (not (player-in-state? RopeClimb)) 
                            (wait-one-frame)
                         (loop)))
                        (set-boolean tutorial-once 1 self)
                        (mark-tutorial-unlocked-by-cipher-id MENU_TUTORIAL_ROPE_SWING 1)
                        (signal tts-tutorial 0)
                        (if (is-text-to-speech-enabled?)) 
                            (if (not (is-traversal-audio-cues?))) 
                                (hud2-play-tutorial HUD_FTT_TUTORIAL_ROPE3_PC 10.00 rope-swing 0 2 0 0 0)
                            
                        
                        (let loop () (when (and (joypad-command-active-and-enabled? rope-swing 2) (not (not (player-in-state? RopeClimb)))) 
                            (wait-one-frame)
                         (loop)))
                        (wait 1.00)
                        (hud2-play-tutorial HUD_FTT_TUTORIAL_ROPE4 10.00 jump 0 2 0 0 0)
                    
                
            }
            track tts {
                lambda 
