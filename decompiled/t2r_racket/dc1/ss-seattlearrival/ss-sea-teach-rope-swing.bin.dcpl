                        (wait-for tts-tutorial)
                    
                
                lambda 
                    (if (and (is-text-to-speech-enabled?) (is-traversal-audio-cues?))) 
                        (hud2-play-tutorial TIP_ACCESS_ROPE_SWING -1.00 none 0 2 0 0 0)
                        (let loop () (when (player-in-state? RopeClimb) 
                            (wait-one-frame)
                         (loop)))
                        (hud-clear-tutorials 0)
                    
                
            }
        }
        block update {
