                        (go disable 1)
                    
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (if (task-active? seattle-arrival sea-arrival-intro)) 
                        (go disable 1)
                    
                
            }
        }
    }
    state disable {
        block update {
            track main {
                lambda 
                    (if (player-on-horse? horse 1 1 1)) 
                        (joypad-disable-commands weapon-cross)
                        (joypad-disable-commands fire-press fire-hold fire-release reload reload-hold)
                        (player-allow-no-weapon-aim)
                    
                
            }
        }
    }
