                        (say dina vox-igc-din-igc-sea-hub-ration-stairwell-barricade-combat-success-001 2 0)
                     else (if (and (tension-mode-is? 2) (tension-mode-is? 4))) 
                        (say dina vox-igc-din-igc-sea-hub-ration-stairwell-barricade-stealth-success-001 2 0)
                        (say player vox-igc-ell-igc-sea-hub-ration-stairwell-barricade-stealth-success-001 2 0)
                     else 
                        (say dina vox-igc-din-igc-sea-hub-ration-stairwell-barricade-success-001 2 0)
                        (say player vox-igc-ell-igc-sea-hub-ration-stairwell-barricade-success-001 2 0)
                    
                
                lambda 
                    (send-event courthouse-infected-clear ss-vox-sea-hub-explore-1)
                
                lambda 
                    (send-event got-out ss-vox-sea-hub-courthouse-1)
                
            }
            track hud {
                lambda 
                    (hud2-signal-interactable-hold-success)
                
            }
            track infected {
                lambda 
                    (for ([var_1 ration-center-nmes]) 
                        (define var_2)
                        (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 7))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 5))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else (if (and var_1 (== (deref (cast u16* (+ var_1 12))) 4))) 
                            (set! var_2 (deref (cast u64* var_1)))
                         else 
                            (set! var_2 0)
                        
                        (if (npc-alive? var_2)) 
                            (npc-set-script-only-no-perception var_2)
                            (npc-move-to-spawner var_2 var_2 1 0 0 0 0 0 0)
                        
                    )
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (not (get-boolean kill-render self))) 
                        (override-render-settings *sea-rs-sea-hub-igc-into-courthouse-stairwell* 1.00 1.00 0 32767 0 1 0 1.00)
                    
                
                lambda 
                    (set-tension-mode 1)
                
            }
        }
    }
    state already-complete {
        block start {
            track main {
                lambda 
                    (animate-done sea-hub-court-double-door-1 sea-hub-ration-stairwell-barricade-success--door ap-sea-horse-ration-barricade-1 0 0 2)
                
                lambda 
                    (animate-done obj-sea-horse-court-barrel-1 sea-hub-ration-stairwell-barricade-success--bookshelf ap-sea-horse-ration-barricade-1 0 0 2)
                
            }
        }
    }
}
