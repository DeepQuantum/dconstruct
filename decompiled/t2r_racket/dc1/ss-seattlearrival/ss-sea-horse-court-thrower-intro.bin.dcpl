                    (animate-done obj-sea-horse-court-elevator-door-4 sea-hub-court-fight-intro-exit--elevator pos-sea-horse-court-thrower-intro-1 0 0 2)
                
                lambda 
                    (go complete 1)
                
            }
        }
    }
}
