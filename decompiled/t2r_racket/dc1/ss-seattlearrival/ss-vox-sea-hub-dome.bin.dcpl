    state wait-dome-combat-done {
        block start {
            track main {
                lambda 
                    (if (not (get-boolean vox-stay-low-hint? self))) 
                        (set-boolean vox-stay-low-hint? 1 self)
                        (let loop () (when (not (! (is-any-major-character-speaking?))) 
                            (wait 0.10)
                         (loop)))
                        (say player vox-igc-ell-gam-sea-hub-leave-horse-wh-004 2 0)
                    
                
            }
        }
        block event npc-died {
            track main {
                lambda 
                    (if (and (get-boolean spawn-back ss-sea-horse-stealth-grass-infected-1) (no-npcs-in-group-alive? all-enemy-npcs))) 
                        (go synagogue-fight-over 1)
                     else (if (no-npcs-in-group-alive? all-enemy-npcs)) 
