    state synagogue-fight-over {
        block start {
            track main {
                lambda 
                    (if (tension-mode-is? 2)) 
                        (set-boolean vox-synagogue-stealth? 1 self)
                    
                
                lambda 
                    (wait-until-non-combat-tension 2.00 4.00)
                
                lambda 
                    (if (< (get-int32 dome-spawn-count self) 2)) 
                        (if (get-boolean vox-synagogue-stealth? self)) 
                            (wait-say dina vox-igc-din-gam-sea-hub-explore-sanctuary-infected-sp-001 2 0)
                         else 
                            (wait-say dina vox-igc-din-gam-sea-hub-explore-sanctuary-infected-sp-002 2 0)
                            (wait 0.30)
                            (wait-say player vox-igc-ell-gam-sea-hub-explore-sanctuary-infected-sp-001 2 0)
                        
                        (set-boolean vox-synagogue-stealth? 0 self)
                        (go wait-dome-combat-done 1)
                     else (if (== (get-int32 dome-spawn-count self) 2)) 
                        (if (get-boolean vox-synagogue-stealth? self)) 
                            (wait-say player vox-igc-ell-gam-sea-hub-explore-sanctuary-infected-sp-011 2 0)
                            (wait-say player vox-igc-ell-gam-sea-hub-explore-sanctuary-infected-sp-012 2 0)
