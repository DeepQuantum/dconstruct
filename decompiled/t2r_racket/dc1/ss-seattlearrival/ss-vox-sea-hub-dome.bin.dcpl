                        (go gate-squeeze-through 1)
                    
                
            }
        }
        block event enter-sanctuary {
            track main {
                lambda 
                    (if (! (get-svar-as-boolean vox-sea-hub-enter-sanctuary))) 
                        (if (tension-mode-is? 2)) 
                            (set-boolean vox-synagogue-stealth? 1 self)
                        
                        (set-svar vox-sea-hub-enter-sanctuary 1)
                        (go enter-sanctuary 1)
                    
                
            }
        }
        block event enter {
            track main {
                lambda 
