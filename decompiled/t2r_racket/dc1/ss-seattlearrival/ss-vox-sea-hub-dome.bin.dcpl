                            (wait-say dina vox-igc-din-gam-sea-hub-explore-sanctuary-infected-sp-012 2 0)
                            (wait-say player vox-igc-ell-gam-sea-hub-explore-sanctuary-infected-sp-014 2 0)
                            (wait-say player vox-igc-ell-gam-sea-hub-explore-sanctuary-infected-sp-015 2 0)
                         else 
                            (wait-say dina vox-igc-din-gam-sea-hub-explore-sanctuary-infected-sp-008 2 0)
                            (wait-say player vox-igc-ell-gam-sea-hub-explore-sanctuary-infected-sp-007 2 0)
                            (wait-say player vox-igc-ell-gam-sea-hub-explore-sanctuary-infected-sp-008 2 0)
                            (wait-say dina vox-igc-din-gam-sea-hub-explore-sanctuary-infected-sp-010 2 0)
                            (wait-say player vox-igc-ell-gam-sea-hub-explore-sanctuary-infected-sp-009 2 0)
