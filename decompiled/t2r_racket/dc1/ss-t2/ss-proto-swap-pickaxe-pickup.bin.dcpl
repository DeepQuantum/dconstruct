statescript {
    options {
        player
        sp-all
    }
    declarations {
        i32 weapon-health = 1
    }
    state swap-pickaxe {
        block event player-requested-interact {
            track main {
                lambda 
                    (if (and (entity-exists? (event-arg-symbol 0)) (== (item-pickup-get-item-id (event-arg-symbol 0)) pickaxe-scar))) 
                        (set-int32 weapon-health (get-weapon-process-health (event-arg-symbol 0)) self)
                    
                
            }
        }
        block event item-given {
            track main {
                lambda 
                    (inventory-item-consume pickaxe-scar 1)
                
                lambda 
                    (give-player-weapon pickaxe-player 0 0)
                
                lambda 
                    (set-weapon-process-health (get-player-best-melee-weapon-id) (get-int32 weapon-health self))
                
                lambda 
                    (player-instant-draw-weapon-by-name pickaxe-player 0.00 1)
                
            }
        }
    }
}
