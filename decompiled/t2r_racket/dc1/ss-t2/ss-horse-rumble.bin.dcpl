statescript {
    options {
        player
    }
    declarations {
        f32 accel-y = 0.00
        f32 g-mag = 0.00
        f32 min-g-thresh = 4.00
        f32 max-g-thresh = 10.00
        f32 min-rumble = 0.00
        f32 max-rumble = 0.50
        bool show-graph = nullptr
    }
    state not-riding {
        block update {
            track main {
                lambda 
                    (if (player-on-any-horse? 0 1 1)) 
                        (go riding 1)
                    
                
            }
        }
    }
    state riding {
        block update {
            track main {
                lambda 
                    (if (not (player-on-any-horse? 0 1 1))) 
                        (go not-riding 1)
                    
                
                lambda 
                    (if (not (joypad-has-haptics? 2))) 
                        (define var_1 (horse-get-g-meter))
                        (set-float accel-y (abs (deref (cast f32* (+ var_1 4)))) self)
                        (set-float g-mag (abs (vector-magnitude var_1)) self)
                        (if (get-boolean show-graph self)) 
                            (plot-internal "Horse Gs" 775 310 400 400 (get-float g-mag self) "")
                        
                        (define var_6 (get-float g-mag self))
                        (if (> var_6 (get-float min-g-thresh self))) 
                            (set! var_8 (rumble (lerp-scale (get-float min-g-thresh self) (get-float max-g-thresh self) (get-float min-rumble self) (get-float max-rumble self) var_6)))
                        
                    
                
            }
        }
    }
}
