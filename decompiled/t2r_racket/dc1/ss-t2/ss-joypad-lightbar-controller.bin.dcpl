    state christmas-mode {
        block start {
            track main {
                lambda 
                    (start-timer change-light 2.00 self 1)
                
            }
        }
        block event change-light {
            track main {
                lambda 
                    (set-boolean is-red (not (get-boolean is-red self)) self)
                
                lambda 
                    (start-timer change-light 2.00 self 1)
                
            }
        }
        block event designer-menu-changed {
            track main {
                lambda 
                    (if (not (holiday-cheer-enabled?))) 
                        (if (lightbar-char-select-enabled?)) 
                            (go lightbar-character-select 1)
                         else 
                            (go character-select 1)
                        
                    
                
            }
        }
        block update {
            track main {
                lambda 
                    (if (get-boolean is-red self)) 
                        (set-joypad-light-bar 0 255 0 1.00)
                     else 
                        (set-joypad-light-bar 255 0 0 1.00)
                    
                
            }
        }
    }
}
