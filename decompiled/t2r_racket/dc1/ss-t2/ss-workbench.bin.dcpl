                            (set! var_7 (interactable-set-exclude-from-pickup-scan self (interactable-is-excluded-from-pickup-scan? (get-self-id))))
                        
                    
                
                lambda 
                    (if (or (or (and (and (and (nth-frame? 15 0) (interactable-enabled? self)) (not (interactable-scripted-unavailable? self))) (tension-mode-is? 3)) (ss-workbench--any-enemy-aware-of-player?)) (not (== (get-player-carry-object-id) 0)))) 
                        (if (and (is-rogue-mode?) (distance-between-objects-less-than? self (get-closest-living-npc-in-group all-enemy-npcs self 0) 7.00))) 
                            (go unavailable 1)
                        
                    
                
                lambda 
                    (if (and (and (and (and (and (nth-frame? 5 0) (> (tag-int32 save-data-index self) -1)) (! (get-svar-bit workbenches-found (tag-int32 save-data-index self)))) (interactable-enabled? self)) (interactable-is-interactive? self)) (! (timer-running? player-found-workbench-timer self)))) 
                        (start-timer player-found-workbench-timer (get-float time-to-find-workbench self) self 1)
                    
                
                lambda 
                    (if (and (and (timer-running? player-found-workbench-timer self) (! (interactable-enabled? self))) (! (interactable-is-interactive? self)))) 
                        (stop-timer player-found-workbench-timer self)
                    
                
                lambda 
                    (ss-workbench--flicker-oil-lamp 2.00 (tag-float light-lantern-off-multiplier self))
                
            }
        }
        block event player-found-workbench-timer {
            track main {
                lambda 
                    (set-svar-bit workbenches-found (tag-int32 save-data-index self) 1)
                
                lambda 
                    (increment-stat trophy-num-workbenches 1)
                
                lambda 
                    (collectible-stat-objective-completed workbenches-found (tag-int32 save-data-index self))
                
            }
        }
        block event workbench-trap-mode-enable {
            track main {
                lambda 
                    (set-boolean trap-mode-enabled 1 self)
                
            }
        }
        block event workbench-trap-mode-disable {
            track main {
                lambda 
                    (set-boolean trap-mode-enabled 0 self)
                
            }
        }
        block event player-requested-interact {
            track main {
                lambda 
                    (if (interactable-enabled? self)) 
                        (interactable-disable self)
                    
                
                lambda 
                    (if (get-boolean trap-mode-enabled self)) 
                        (go trap-mode 1)
                     else 
                        (go workbench-enter 1)
                    
                
            }
        }
        block event turn-on-light {
            track main {
                lambda 
                    (if (> (darray-count (get-symbol lights-darray self)) 0)) 
                        (ss-workbench--turn-on-lights 1)
                     else 
                        (display-error (dc:format "Event: turn-on-light FAILED! Workbench: %s does not have any lights to turn on." (get-self-name)))
                    
                
            }
        }
        block event turn-off-light {
            track main {
                lambda 
                    (if (> (darray-count (get-symbol lights-darray self)) 0)) 
                        (ss-workbench--turn-off-lights 1)
                     else 
                        (display-error (dc:format "Event: turn-off-light FAILED! Workbench: %s does not have any lights to turn off." (get-self-name)))
                    
                
            }
        }
    }
    state unavailable {
