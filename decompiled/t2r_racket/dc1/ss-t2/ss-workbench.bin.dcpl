                            (set! var_1 (deref (cast f32* (+ (deref *curr-workbench-state*) 80))))
                         else 
                            (set! var_1 (deref (cast f32* (+ (ss-workbench--get-workbench-weapon-def-based-on-current-weapon (get-symbol currently-animating-weapon self)) 144))))
                        
                        (wait-until-anim-phase player (deref (cast u64* (deref (deref *curr-workbench-state*)))) var_1 2)
                        (define var_5)
                        (if (>= (deref (cast f32* (+ (deref *curr-workbench-state*) 76))) 0.00)) 
                            (set! var_5 (deref (cast f32* (+ (deref *curr-workbench-state*) 76))))
                         else 
                            (set! var_5 1.00)
                        
                        (wait-player-fade-flashlight-on var_5 1)
                        (set-boolean flashlight-on 0 self)
                    
                
            }
            track show-backpack-weapons {
                lambda 
                    (wait-for curr-state-updated)
                
                lambda 
                    (if (deref (+ (deref *curr-workbench-state*) 32))) 
                        (wait-until-anim-phase player (deref (cast u64* (deref (deref *curr-workbench-state*)))) (deref (cast f32* (+ (deref (+ (deref *curr-workbench-state*) 32)) 32))) 2)
                    
                
                lambda 
                    (ss-workbench--set-visible-all-backpack-weapons 1)
                
            }
            track set-weapon-overlay {
                lambda 
                    (wait-for curr-state-updated)
                
                lambda 
                    (if (deref (+ (deref *curr-workbench-state*) 16))) 
                        (wait-until-anim-phase player (deref (cast u64* (deref (deref *curr-workbench-state*)))) (deref (cast f32* (+ (deref (+ (deref *curr-workbench-state*) 16)) 32))) 2)
                        (player-instant-draw-weapon-by-name (get-symbol queued-weapon self) 0.00 1)
                        (set-visible (get-player-weapon-process-id-from-weapon-id (get-symbol queued-weapon self)) 0)
                    
                
            }
            track script-lambda {
                lambda 
                    (wait-for curr-state-updated)
                
                lambda 
                    (if (deref (+ (deref *curr-workbench-state*) 56))) 
                        (let loop () (when (not (script-eval-condition (deref (+ (deref *curr-workbench-state*) 56)) 0 0 0 0 0 0 0 0)) 
                            (wait-one-frame)
                         (loop)))
                    
                
            }
            track ammo {
                lambda 
                    (wait-for curr-state-updated)
                
                lambda 
                    (for ([var_1 spawned-weapons-by-id]) 
                        (if (not (== var_1 (get-symbol currently-animating-weapon self)))) 
                            (set-player-weapon-clip-ammo (get-total-ammo var_1) var_1)
                        
                    )
                
            }
        }
        block update {
            track main {
                lambda 
                    (disable-interactable-system)
                
                lambda 
                    (if (get-boolean backpack-swapped? self)) 
                        (set-player-global-boolean (+ 0 332) anim-backpack-parenting 0)
                        (set-player-global-boolean (+ 0 335) player-disable-backpack-sounds 1)
                    
                
                lambda 
                    (ss-workbench--prioritize-texture-streaming)
                
                lambda 
                    (camera-shake camera-mocap-idle-small 1.00 1.00 1)
                
                lambda 
                    (accessibility-suppress-control-sounds/f)
                
                lambda 
                    (gui2-disable-categories/f 16777216)
                
                lambda 
                    (ss-workbench--override-render-settings)
                
                lambda 
                    (set-player-global-boolean (+ 0 319) allow-bolt-animate 1)
                
                lambda 
                    (pause-all-hints)
                
                lambda 
                    (joypad-disable-commands flashlight-toggle aim camera)
                
            }
        }
        block end {
            track main {
                lambda 
                    (clear-low-health-screen-effect-fade-request 1.00)
                
                lambda 
                    (player-swap-to-cloth-backpack 0)
                
                lambda 
                    (set-boolean backpack-swapped? 0 self)
                
                lambda 
                    (if (get-boolean flashlight-on self)) 
                        (turn-on-flashlight player 0)
                        (set-boolean flashlight-on 0 self)
                    
                
                lambda 
                    (set-symbol queued-weapon 0 self)
                
            }
        }
    }
    state --all-- {
        block event enter-upgrade-menu {
            track main {
                lambda 
                    (if (and (and (or (script-in-state? self workbench-idle) (== (get-symbol currently-animating-weapon self) (get-symbol currently-selected-weapon (get-symbol menu-widget self)))) (script-in-state? self workbench-idle-weapon-on-table)) (!= (get-int32 anim-queue-state self) 1))) 
                        (if (not (not (&& (|| (|| (script-in-state? self workbench-enter) (script-in-state? self workbench-idle-hand-in-bag)) (script-in-state? self workbench-put-previous-weapon-in-bag)) (script-in-state? self workbench-pullout-weapon-from-bag))))) 
                            (set-int32 anim-queue-state 2 self)
                        
                    
                
            }
        }
        block event apply-upgrade-event {
            track main {
                lambda 
                    (darray-append upgrade-queue (new-boxed-value 7 (event-arg-symbol 0)) 0)
                
                lambda 
                    (darray-append weapon-queue (new-boxed-value 7 (event-arg-symbol 1)) 0)
                
            }
        }
        block event changed-currently-selected-weapon {
            track main {
                lambda 
                    (set-float time-weapon-changed (get-current-time 0) self)
                
            }
        }
        block event inspect-weapon {
            track main {
                lambda 
                    (if (not (script-in-state? self inspect-weapon))) 
                        (if (get-boolean go-to-inspect-weapon self)) 
                            (set-boolean go-to-inspect-weapon 0 self)
                         else 
                            (set-boolean go-to-inspect-weapon 1 self)
                        
                    
                
            }
        }
        block event workbench-menu-exit-inspect {
            track main {
                lambda 
                    (set-boolean go-to-inspect-weapon 0 self)
                
            }
        }
    }
    state --script-- {
        block end {
            track main {
                lambda 
                    (if (not (== (get-symbol tools-obj self) 0))) 
                        (kill-entity-if-spawned (get-symbol tools-obj self))
                        (set-symbol tools-obj 0 self)
                    
                
            }
        }
    }
}
