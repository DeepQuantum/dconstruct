statescript {
    options {
        player
    }
    declarations {
        bound-frame approach-point-loc = nullptr
        symbol currently-animating-weapon = nullptr
        symbol queued-weapon = nullptr
        i32 anim-queue-state = 0
        f32 time-weapon-changed = 0.00
        bool weapon-is-in-hands = nullptr
        bool is-first-weapon = nullptr
        bool exit-queued = nullptr
        bool flashlight-on = nullptr
        symbol dummy-camera-object = nullptr
        symbol menu-widget = nullptr
        bool player-applied-upgrade = nullptr
        i32 num-upgrades-per-visit = 0
        bool go-to-inspect-weapon = nullptr
        bool trap-mode-enabled = nullptr
        f32 animation-frame = 0.00
        f32 goal-distance = 100.00
        bool use-inverse-phase = nullptr
        i32 abort-range-index = -1
        f32 abort-blend-time = 0.00
        symbol tools-obj = nullptr
        bool bg-art-version? = nullptr
        bool interactable-overridden? = nullptr
        bool light-on? = nullptr
        bool light-render-settings-enabled? = nullptr
        symbol lights-darray = lights-default
        bool lights-on-at-start? = nullptr
        bool partial-on-approach-playing = nullptr
        bool enter-playing = nullptr
        bool exiting-inspect? = nullptr
        bool player-draw-weapon-done? = nullptr
        bool weapon-will-lose-bullets? = nullptr
        bool use-long-blend-to-investigate = nullptr
        bool silencer-toggled? = nullptr
        symbol weapon-to-reset-silencer-on = nullptr
        bool disabled-by-self? = nullptr
        u64 light-particle = nullptr
        timer player-found-workbench-timer = nullptr
        f32 time-to-find-workbench = 0.50
        bool backpack-swapped? = nullptr
        bool drawing-weapon? = nullptr
        i32 light-sound = 0
        bool snd-bullet-hidden = nullptr
        bool force-default-weapon? = nullptr
        bool swap-to-upgradeable-weapon? = nullptr
    }
    state initialize {
        block start {
            track main {
                lambda 
                    (if (not (== (tag-symbol lights-parent self) none))) 
                        (let loop () (when (not (entity-exists? (tag-symbol lights-parent self))) 
                            (wait-one-frame)
                         (loop)))
                    
                
                lambda 
                    (let loop () (when (not (is-level-set-loaded? t2-workbench-shared)) 
                        (wait 0.16)
                     (loop)))
                
                lambda 
                    (set-boolean bg-art-version? (== (tag-symbol interactable-def self) interact-workbench) self)
                
                lambda 
                    (set-bound-frame approach-point-loc (get-spawner-locator self 1) self)
                
                lambda 
                    (if (not (== (tag-symbol light-type self) 0))) 
                        (set-symbol lights-darray (tag-symbol light-type self) self)
                    
                
                lambda 
                    (ss-workbench--turn-off-lights 1)
                
                lambda 
                    (if (not (== (tag-symbol lights-parent self) none))) 
                        (if (not (> 0.10 (distance-between-objects self (tag-symbol lights-parent self))))) 
                            (set-object-locator (tag-symbol lights-parent self) (get-object-locator self))
                        
                    
                
                lambda 
                    (ss-workbench--spawn-tools)
                
                lambda 
                    (ss-workbench--update-list-of-weapons)
                
                lambda 
                    (if (<= (darray-count all-weapons-acquired) 0)) 
                        (go unavailable 1)
                    
                
                lambda 
                    (if (get-boolean lights-on-at-start? self)) 
                        (set-boolean lights-on-at-start? 0 self)
                        (ss-workbench--turn-on-lights 0)
                    
                
                lambda 
                    (if (get-boolean disabled-by-self? self)) 
                        (set-boolean disabled-by-self? 0 self)
                        (interactable-enable self)
                    
                
                lambda 
                    (if (get-svar-bit accessibility-workbenches-found (tag-int32 save-data-index self))) 
                        (interactable-set-exclude-from-pickup-scan self 1)
                    
                
                lambda 
                    (go wait-for-player 1)
                
            }
        }
        block event turn-on-light {
            track main {
                lambda 
                    (if (> (darray-count (get-symbol lights-darray self)) 0)) 
                        (set-boolean lights-on-at-start? 1 self)
                     else 
                        (display-error (dc:format "Event: turn-on-light FAILED! Workbench: %s does not have any lights to turn on." (get-self-name)))
                    
                
            }
        }
    }
    state wait-for-player {
        block start {
            track main {
                lambda 
                    (set-int32 num-upgrades-per-visit 0 self)
                
                lambda 
                    (set-boolean player-applied-upgrade 0 self)
                
                lambda 
                    (override-interact-def self (tag-symbol interactable-def self))
                    (interactable-set-exclude-from-pickup-scan (get-self-id) (interactable-is-excluded-from-pickup-scan? (get-self-id)))
                
                lambda 
                    (set-boolean interactable-overridden? 0 self)
                
            }
        }
        block event item-removed {
            track main {
                lambda 
                    (ss-workbench--update-list-of-weapons)
                
                lambda 
                    (if (<= (darray-count all-weapons-acquired) 0)) 
                        (go unavailable 1)
                    
                
            }
        }
        block event item-given {
            track main {
                lambda 
                    (ss-workbench--update-list-of-weapons)
                
