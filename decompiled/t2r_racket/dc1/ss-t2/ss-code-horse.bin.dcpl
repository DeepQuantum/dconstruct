(define (get-horse-passenger-ap-ref) 
    (parent-bound-frame (get-object-locator self) root 0)
)

statescript {
    options {
        player
        sp-all
    }
    state idle {
        block event mounted {
            track main {
                lambda 
                    (go mounted 1)
                
            }
        }
    }
    state mounted {
        block  {
        }
        block update {
            track main {
                lambda 
                    (if (> (get-object-speed player) 2.00)) 
                        (audio-gameplay-event footstep-sprint (get-object-position player) player)
                    
                
            }
        }
        block event dismount {
            track main {
                lambda 
                    (go idle 1)
                
            }
        }
    }
}
