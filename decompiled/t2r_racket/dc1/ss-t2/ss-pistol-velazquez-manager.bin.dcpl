statescript {
    options {
        player
    }
    state initial {
        block start {
            track main {
                lambda 
                    (if (not (is-player-abby? player))) 
                        (go die 1)
                    
                
                lambda 
                    (if (player-has-weapon? pistol-xcaliber)) 
                        (go active 1)
                    
                
            }
        }
        block event item-given {
            track main {
                lambda 
                    (go active 1)
                
            }
        }
    }
    state active {
        block start {
            track main {
                lambda 
                    (set-weapon-extra-joint-mods (get-player-weapon-process-id-from-weapon-id pistol-xcaliber) pistol-xcaliber-addt-joint-mods)
                
            }
        }
        block event hide-pistol-scope {
            track main {
                lambda 
                    (darray-append pistol-xcaliber-addt-joint-mods (new-boxed-value 7 scope) 0)
                
            }
        }
        block event show-pistol-scope {
            track main {
                lambda 
                    (darray-clear pistol-xcaliber-addt-joint-mods)
                
            }
        }
    }
    state die {
        block start {
            track main {
                lambda 
                    (end-script)
                
            }
        }
    }
}
