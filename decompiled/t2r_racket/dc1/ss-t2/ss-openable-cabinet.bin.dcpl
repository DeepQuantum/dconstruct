    state scavenge-early-exit {
        block start {
            track main {
                lambda 
                    (stop-player-script-ik 0.80)
                
                lambda 
                    (player-set-capsule-size 0.10)
                
                lambda 
                    (if (or (not (== (get-symbol scav-enter-animation self) 0)) (== (get-object-anim player 1) (get-symbol scav-enter-animation self)))) 
                        (if (or (not (== (get-symbol scav-exit-animation self) 0)) (== (get-object-anim player 1) (get-symbol scav-exit-animation self)))) 
                            (if (not (== (get-symbol scav-pickup-animation self) 0))) 
                                (if (not (== (get-object-anim player 1) (get-symbol scav-pickup-animation self)))) 
                                    (go complete 1)
                                
                            
                        
                    
                
                lambda 
                    (define var_2)
                    (if (object-anim-playing? player (get-symbol scav-exit-animation self) 0)) 
                        (set! var_2 (get-symbol scav-exit-animation self))
                     else 
                        (set! var_2 (get-symbol scav-pickup-animation self))
                    
                    (stop-animating player 2 0.80 0 0)
                    (if (and (object-anim-playing? player (get-symbol scav-pickup-animation self) 0) (get-boolean obj-picked-up? self))) 
                        (define var_10 (#%alloc-array single-frame 16 7 1))
                        (set! (deref (cast i32* (deref (+ (deref var_10) (* 0 8))))) 57)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_10) (* 0 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_10) (* 0 8))) 8))) (get-animation-frame player 2 var_2))
                        (set! (deref (cast i32* (deref (+ (deref var_10) (* 1 8))))) 28)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_10) (* 1 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_10) (* 1 8))) 8))) 0.20)
                        (set! (deref (cast i32* (deref (+ (deref var_10) (* 2 8))))) 40)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_10) (* 2 8))) 8))) 0)
                        (set! (deref (cast i32* (+ (deref (+ (deref var_10) (* 2 8))) 8))) 1)
                        (set! (deref (cast i32* (deref (+ (deref var_10) (* 3 8))))) 75)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_10) (* 3 8))) 8))) 0)
                        (define var_12)
                        (if (get-boolean mirror? self)) 
                            (set! var_12 *scav-drawer-exit-l-hand*)
                         else 
                            (set! var_12 *scav-drawer-exit-r-hand*)
                        
                        (set! (deref (cast u64* (+ (deref (+ (deref var_10) (* 3 8))) 8))) var_12)
                        (set! (deref (cast i32* (deref (+ (deref var_10) (* 4 8))))) 30)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_10) (* 4 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_10) (* 4 8))) 8))) 0.40)
                        (set! (deref (cast i32* (deref (+ (deref var_10) (* 5 8))))) 44)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_10) (* 5 8))) 8))) 0)
                        (set! (deref (cast u8* (+ (deref (+ (deref var_10) (* 5 8))) 8))) (get-boolean mirror? self))
                        (set! (deref (cast i32* (deref (+ (deref var_10) (* 6 8))))) 5)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_10) (* 6 8))) 8))) 0)
                        (set! (deref (cast u8* (+ (deref (+ (deref var_10) (* 6 8))) 8))) 1)
                        (animate_ player (get-symbol scav-pickup-animation self) var_10)
                    
                    (wait 0.50)
                    (if (not (get-boolean door-is-motored self))) 
                        (let-cabinet-door-go-wide-open 1.00)
                    
                    (let loop () (when (and (and (not (object-anim-playing? player (get-symbol scav-enter-animation self) 1)) (not (object-anim-playing? player (get-symbol scav-exit-animation self) 1))) (not (not (object-anim-playing? player (get-symbol scav-pickup-animation self) 1)))) 
                        (wait-one-frame)
                     (loop)))
                    (if (object-spawned? (get-symbol invis-proxy-ik-main self))) 
                        (kill-entity (get-symbol invis-proxy-ik-main self))
                    
                    (if (object-spawned? (get-symbol invis-proxy-ik-second self))) 
                        (kill-entity (get-symbol invis-proxy-ik-second self))
                    
                    (go complete 1)
                
            }
