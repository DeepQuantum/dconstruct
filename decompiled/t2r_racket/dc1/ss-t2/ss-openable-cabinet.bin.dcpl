                            (if (or (not (== (get-symbol scav-exit-animation self) 0)) (== (get-object-anim player 1) (get-symbol scav-exit-animation self)))) 
                                (if (and (not (== (get-symbol scav-pickup-animation self) 0)) (== (get-object-anim player 1) (get-symbol scav-pickup-animation self)))) 
