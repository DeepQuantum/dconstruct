        block event player-attacked {
            track main {
                lambda 
                    (set-boolean is-early-exit 1 self)
                
                lambda 
                    (go melee-abort 1)
                
            }
        }
        block update {
            track main {
                lambda 
                    (set-player-no-igc-kill-grenade)
                
                lambda 
                    (ss-cabinet-attachment (symbol-concat-string (get-symbol scav-exit-animation self) (get-string cab-anim-suffix self)))
                
                lambda 
                    (if (get-boolean obj-picked-up? self)) 
                        (disable-interactable-interaction)
                        (print-string "DISABLED ITERACTS" self)
                    
                
                lambda 
                    (if (and (and (get-boolean is-early-exit self) (not (object-anim-playing? player (get-symbol scav-exit-animation self) 0))) (not (object-anim-playing? player (get-symbol scav-pickup-animation self) 0)))) 
                        (if (object-spawned? (get-symbol r-ik-solver self))) 
                            (stop-joint-ik (get-symbol r-ik-solver self) 0.40)
                        
                        (if (object-spawned? (get-symbol l-ik-solver self))) 
                            (stop-joint-ik (get-symbol l-ik-solver self) 0.40)
                        
                        (if (object-spawned? (get-symbol pickup-ik-solver self))) 
                            (stop-joint-ik (get-symbol pickup-ik-solver self) 0.40)
                        
                        (set-boolean main-ik-in-use? 0 self)
                    
                
            }
        }
    }
    state melee-abort {
        block start {
            track main {
                lambda 
                    (stop-player-script-ik 0.00)
                
                lambda 
                    (stop-animating player 2 0.00 0 0)
                
                lambda 
                    (if (object-spawned? (get-symbol r-ik-solver self))) 
                        (stop-joint-ik (get-symbol r-ik-solver self) 0.00)
                    
                
                lambda 
                    (if (object-spawned? (get-symbol l-ik-solver self))) 
                        (stop-joint-ik (get-symbol l-ik-solver self) 0.00)
                    
                
                lambda 
                    (if (object-spawned? (get-symbol pickup-ik-solver self))) 
                        (stop-joint-ik (get-symbol pickup-ik-solver self) 0.00)
                    
                
                lambda 
                    (if (and (get-boolean obj-picked-up? self) (get-boolean pickup-exists? self))) 
                        (send-event suppress-pickup-sound (get-symbol current-pickup-obj self))
                        (player-apply-pickup (get-symbol current-pickup-obj self))
                        (set-boolean obj-picked-up? 0 self)
                        (set-boolean pickup-exists? 0 self)
                    
                
                lambda 
                    (if (not (get-boolean has-been-contact? self))) 
                        (cancel-player-move-to)
                        (interactable-enable (get-symbol current-interactable-scav self))
                        (define var_3 (#%alloc-array single-frame 16 1 1))
                        (set! (deref (cast i32* (deref (+ (deref var_3) (* 0 8))))) 28)
                        (set! (deref (cast u64* (+ (deref (+ (deref var_3) (* 0 8))) 8))) 0)
                        (set! (deref (cast f32* (+ (deref (+ (deref var_3) (* 0 8))) 8))) 0.10)
                        (animate_ (get-symbol current-interactable-scav self) idle var_3)
                        (send-event contact-cancelled (get-self-id))
                        (go wait-interact 1)
                     else 
                        (if (not (get-boolean door-is-motored self))) 
                            (let-cabinet-door-go-wide-open 2.00)
                        
                        (go complete 1)
                    
                
            }
        }
    }
    state complete {
        block start {
            track main {
                lambda 
                    (let loop () (when (and (not (player-is-picking-up?)) (not (> (- (get-current-time 0) (get-current-time 0)) 2.00))) 
                        (wait-one-frame)
                     (loop)))
                
                lambda 
                    (fact-set-bool-safe player scav-anim-active 0)
                
            }
        }
    }
}
