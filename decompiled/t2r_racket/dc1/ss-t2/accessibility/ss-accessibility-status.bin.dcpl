                                (set! var_3 (deref (cast u8* var_2)))
                             else (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 2))) 
                                (set! var_3 (deref (cast i32* var_2)))
                             else (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 3))) 
                                (set! var_3 (deref (cast u32* var_2)))
                             else (if (and var_2 (== (deref (cast u16* (+ var_2 12))) 4))) 
