                        (set! (deref (cast u64* (+ (deref var_18) (* 1 8)))) (new-boxed-value 2 (% (cast i32 (/ var_1 10.00)) 10)))
                        (set! (deref (cast u64* (+ (deref var_18) (* 2 8)))) (new-boxed-value 2 (% (cast i32 var_1) 10)))
                        (set! var_4 (darray-append tts-status-frames (new-boxed-value 5 (speak-text-to-speech-formatted (new-boxed-value 21 var_18) 1 0 1)) 0))
                     else 
