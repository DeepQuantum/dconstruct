            track main {
                lambda 
                    (log-event "accessibility-status" 1 "safe" 0 0)
                
                lambda 
                    (set-int32 use-count-stat (+ 1 (get-int32 use-count-stat self)) self)
                
                lambda 
                    (define var_1 (get-float my-code (get-symbol custom-object self)))
                    (define var_3 (get-int32 code-length (get-symbol custom-object self)))
                    (if (== var_3 4)) 
                        (define var_5 (#%alloc-array single-frame 1 5 0))
                        (set! (deref (cast u64* (+ (deref var_5) (* 0 8)))) (new-boxed-value 7 ACCESSIBILITY_STATUS_SAFE_4))
