(define (perform-task-check) 
    (if (horse-idles-blacklisted-tasks?)) 
        (go disabled 1)
    
    (if (horse-idles-tense-tasks?)) 
        (go tense 1)
    
    (go systemic 1)
)

(define (horse-idles-tense-tasks?) 
    (task-range-active? patrol pat-supermarket-return patrol pat-grow-building-hang)
)

(define (horse-idles-blacklisted-tasks?) 
    (&& (|| (task-range-active? patrol pat-tower-exterior-igc patrol pat-tower-untie-horses) (task-range-active? patrol pat-supermarket-approach patrol pat-supermarket-return)) (task-range-active? seattle-arrival sea-qz-wall-gate-top seattle-arrival sea-qz-door-open-gate))
)

statescript {
    options {
        player
    }
    declarations {
    }
    state  {
    }
    state tense {
        block update {
            track main {
                lambda 
                    (horse-force-idle-mood/f 1 (get-self-id))
                
            }
        }
    }
    state disabled {
        block update {
            track main {
                lambda 
                    (horse-force-regular-idle/f (get-self-id))
                
            }
        }
    }
    state --script-- {
        block start {
            track main {
                lambda 
                    (perform-task-check)
                
            }
        }
        block event task-complete {
            track main {
                lambda 
                    (perform-task-check)
                
            }
        }
    }
}
